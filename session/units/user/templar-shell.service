[Unit]
Description=TemplarOS shell (Home Surface, panel, launcher, window shelf) — restartable
Documentation=https://templaros.org/docs/shell
PartOf=templaros-session.target
After=templar-comp.service templar-sessiond.service
Requisite=templar-comp.service

[Service]
Type=simple
# Ordinary applications inherit WAYLAND_DISPLAY=wayland-0 from templar-session.  The shell alone
# connects to the compositor's second socket, which is what grants its private protocol access.
# That second name is deliberately *not* `wayland-0-something`: snapd's wayland interface allows
# `wayland-[0-9]*`, which a suffixed name would match, and the trusted-shell socket is the one
# socket no confined application may ever reach.
Environment=WAYLAND_DISPLAY=templaros-shell-wayland-0
ExecStart=/usr/bin/templar-shell --surface
# Everything decorative restarts without terminating applications.
Restart=always
RestartSec=500ms
Slice=session.slice
MemoryLow=64M
CPUWeight=500
OOMScoreAdjust=-600
# systemd-oomd must look elsewhere first (ADR-0014): even where it is armed on a slice this unit
# is visible in — a distribution default, a future slice reorganisation, someone's own drop-in —
# this is the unit a session cannot lose.
ManagedOOMPreference=avoid
