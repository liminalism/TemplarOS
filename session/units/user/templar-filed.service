[Unit]
Description=TemplarOS file service (browsing, previews, mounts, transactions, recents, search)
Documentation=https://templaros.org/docs/files
PartOf=templaros-session.target
After=templar-sessiond.service

[Service]
# Type=dbus, not simple: readiness *is* the bus name appearing, and BusName= is only honoured
# under this type. The service resumes journalled operations before claiming the name, so a
# client that sees org.templaros.Files is talking to a service that has already recovered.
Type=dbus
BusName=org.templaros.Files
ExecStart=/usr/libexec/templar-filed
Restart=on-failure
RestartSec=1
Slice=session.slice
# Heavy I/O lives here on purpose: a stuck mount must not stall policy daemons.
CPUWeight=200
IOWeight=300
# A stalled file service is a file manager, a file-chooser portal and the Home surface's file
# object all failing to answer at once, so it gets the same modest reserve the shell does — and
# unlike the shell it is doing I/O under exactly the pressure that makes reclaim expensive.
MemoryLow=64M
OOMScoreAdjust=-500
# systemd-oomd must look elsewhere first (ADR-0014): even where it is armed on a slice this unit
# is visible in — a distribution default, a future slice reorganisation, someone's own drop-in —
# this is the unit a session cannot lose.
ManagedOOMPreference=avoid
StateDirectory=templaros
# The shared file index's derived cache database: $XDG_CACHE_HOME/templaros/file-index-v1.sqlite3.
# It is disposable — a deleted cache costs a rescan, never user data — so it lives outside
# StateDirectory.
CacheDirectory=templaros
