[Unit]
Description=LegeOS file service (browsing, previews, mounts, transactions, recents, search)
Documentation=https://legeos.org/docs/files
PartOf=legeos-session.target
After=lege-sessiond.service

[Service]
# Type=dbus, not simple: readiness *is* the bus name appearing, and BusName= is only honoured
# under this type. The service resumes journalled operations before claiming the name, so a
# client that sees org.legeos.Files is talking to a service that has already recovered.
Type=dbus
BusName=org.legeos.Files
ExecStart=/usr/libexec/lege-filed
Restart=on-failure
RestartSec=1
Slice=session.slice
# Heavy I/O lives here on purpose: a stuck mount must not stall policy daemons.
CPUWeight=200
IOWeight=300
OOMScoreAdjust=-500
StateDirectory=legeos
