[Unit]
Description=TemplarOS xdg-desktop-portal backend (FileChooser, AppChooser, Settings, Background)
Documentation=https://templaros.org/docs/portals
PartOf=templaros-session.target
After=templar-sessiond.service templar-filed.service

[Service]
# Type=dbus, and genuinely activation-driven: xdg-desktop-portal starts this backend the first
# time a client asks for one of the four interfaces `templaros.portal` claims, and nothing in the
# session eagerly wants it. Started by systemd rather than by dbus-daemon's own `Exec=` so that
# it inherits the user manager's environment — WAYLAND_DISPLAY above all, without which every
# dialog would decline instead of appearing.
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.templaros
ExecStart=/usr/libexec/xdg-desktop-portal-templar
# A panic prints its backtrace; error values do not capture one each (`templar doctor freeze`).
# Without it the 2026-10-01 winit "EventLoop can't be recreated" panic left only its message.
Environment=RUST_BACKTRACE=1 RUST_LIB_BACKTRACE=0
Restart=on-failure
RestartSec=1
Slice=session.slice
