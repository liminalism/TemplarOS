[Unit]
Description=LegeOS shell (Home Surface, panel, launcher, window shelf) — restartable
Documentation=https://legeos.org/docs/shell
PartOf=legeos-session.target
After=lege-comp.service lege-sessiond.service
Requisite=lege-comp.service

[Service]
Type=simple
# Ordinary applications inherit WAYLAND_DISPLAY=legeos-0 from lege-session.  The shell alone
# connects to the compositor's second socket, which is what grants its private protocol access.
Environment=WAYLAND_DISPLAY=legeos-0-shell
ExecStart=/usr/bin/lege-shell --surface
# Everything decorative restarts without terminating applications.
Restart=always
RestartSec=500ms
Slice=session.slice
MemoryLow=64M
CPUWeight=500
OOMScoreAdjust=-600
