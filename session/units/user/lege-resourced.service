[Unit]
Description=LegeOS resource governor (cgroup v2 + PSI, observe-only until enabled)
Documentation=https://legeos.org/docs/resources
PartOf=legeos-session.target
After=lege-sessiond.service

[Service]
# Deliberately *not* Type=dbus: the governor's whole point is that it keeps deciding when
# everything else is stalled, including the bus. It claims org.legeos.Resources for enrichment
# and observation, but it must start, tick and contain a runaway application without one
# (ADR-0002), so its readiness must not be defined as "the name appeared".
Type=simple
ExecStart=/usr/libexec/lege-resourced
Restart=always
RestartSec=200ms
Slice=session.slice
# The governor must keep ticking while everything else thrashes (ADR-0002).
MemoryLow=96M
CPUWeight=1000
IOWeight=1000
OOMScoreAdjust=-1000
LimitMEMLOCK=96M
Nice=-10
NoNewPrivileges=yes
ProtectSystem=strict
# Read-only, not hidden: resourced reads $XDG_CONFIG_HOME/legeos/resourced.toml (calibrated
# thresholds) and needs the rest of $HOME visible for that lookup to work at all. StateDirectory
# below still grants read-write access to its one write target regardless of this setting.
ProtectHome=read-only
# $XDG_STATE_HOME/legeos: the containment-stage setting (stage.toml) and the bounded trace ring
# (traces.jsonl) — see docs/protocols and crate docs for `lege-resourced`. Shared with
# lege-sessiond/lege-filed's StateDirectory=legeos; each daemon only touches its own files there.
StateDirectory=legeos
# cgroup control files of the user's own units (including compositor/shell/audio protection
# writes under session.slice) are writable through the delegated subtree; ProtectSystem=strict
# does not restrict /sys/fs/cgroup (that would be ProtectControlGroups=, deliberately unset).
