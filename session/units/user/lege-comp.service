[Unit]
Description=LegeOS compositor core (single scene, conservative, protected)
Documentation=https://legeos.org/docs/compositor
PartOf=legeos-session.target
Before=lege-shell.service
# A compositor crash disconnects every client, so it is the one thing that must not restart
# casually: there is nothing left to restart *into*. Ending the session is the honest outcome,
# and the greeter is what the user comes back to.
#
# (This previously read OnFailure=lege-shell.service, which was backwards: lege-shell.service
# carries Requisite=lege-comp.service, so starting the shell after the compositor died would
# have failed immediately and told the user nothing.)

[Service]
Type=notify
# A display-manager session is always the hardware compositor.  Never infer this from the user
# manager's inherited DISPLAY/WAYLAND_DISPLAY: that manager can survive logout and retain the
# previous desktop's environment.  The stable socket name is also the contract used by
# lege-session (ordinary clients) and lege-shell.service (the private trusted-shell connection).
#
# The name is `wayland-0`, not something of ours, because confined applications are allowed to
# reach exactly that shape and no other: snapd's wayland interface grants
# `owner /run/user/[0-9]*/wayland-[0-9]* rw,` and nothing else, so a socket called `legeos-0` is
# a socket every snap is denied — which is how Chromium and Firefox came to report "Failed to
# connect to Wayland display: Permission denied" on a working desktop.
ExecStart=/usr/bin/lege-comp --backend udev --socket-name wayland-0
Restart=no
# A compositor that cannot finish DRM/input/event-loop initialization must give control back to
# the display manager instead of holding the VT on a black frame forever.
TimeoutStartSec=15s
Slice=session.slice
# Session-critical protection (planning doc 01 §5): the user must always be able to move the
# pointer, switch windows, reach the recovery overlay and a terminal.
MemoryLow=256M
CPUWeight=1000
IOWeight=1000
OOMScoreAdjust=-900
# systemd-oomd must look elsewhere first (ADR-0014): even where it is armed on a slice this unit
# is visible in — a distribution default, a future slice reorganisation, someone's own drop-in —
# this is the unit a session cannot lose.
ManagedOOMPreference=avoid
