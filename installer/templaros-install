#!/bin/sh
# `templaros-install` — the provisioner, as installed by templaros-cli. Same script, same flags:
# it plans by default and writes nothing without --apply. See installer/README.md in the source
# tree, or /usr/share/doc/templaros-cli/provision.md on an installed system.
exec /usr/libexec/templaros/provision "$@"
