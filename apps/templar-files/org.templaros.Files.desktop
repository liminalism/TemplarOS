[Desktop Entry]
Type=Application
Name=Files
Comment=Browse files and drives
Exec=templar-files %f
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=templar-files
Actions=Home;

[Desktop Action Home]
Name=Home
Exec=templar-files
