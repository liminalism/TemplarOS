#!/usr/bin/make -f
# Cargo workspace built offline from vendored crates (ADR-0009). Stage 1 uses `cargo deb` per binary;
# this rules file is the Stage-2 archive path.
export CARGO_HOME = $(CURDIR)/debian/cargo_home
export CARGO_TARGET_DIR = $(CURDIR)/target
export RUSTFLAGS = -Cdebuginfo=1

%:
	dh $@

override_dh_auto_configure:
	# One version authority (@templaros.decision.build-set-id-is-the-version-authority): the source
	# package must ship the same version string `cargo deb --deb-version` stamps on every binary
	# package. Generate debian/changelog with `cargo xtask archive changelog --epoch`
	# from the prepared closure; ci/source-build.sh uses one epoch for both xtask calls.
	# An unnamed or mismatched source build must not ship the retained placeholder version.
	@test -n "$$TEMPLAROS_BUILD_SET_ID" || { echo "source packaging requires an authoritative TEMPLAROS_BUILD_SET_ID" >&2; exit 1; }
	@changelog_version=$$(dpkg-parsechangelog -S Version); \
		if [ "$$changelog_version" != "$$TEMPLAROS_BUILD_SET_ID" ]; then \
			echo "debian/changelog says $$changelog_version but the build set is $$TEMPLAROS_BUILD_SET_ID;" >&2; \
			echo "generate the changelog from the pinned closure with the same --epoch as build-set --print-id" >&2; \
			exit 1; \
		fi; \
		echo "changelog and build set agree: $$changelog_version"
	mkdir -p $(CARGO_HOME)
	# The prepared complete closure supplies the full registry/Git source config
	# in .cargo/config.toml; do not replace it with a crates.io-only vendor guess.
	test -f ../../source-provenance.json
	test -f .cargo/config.toml

	@content=$$(python3 -c 'import json; print(json.load(open("../../source-provenance.json"))["bundle_content_sha256"])'); \
		case "$$TEMPLAROS_BUILD_SET_ID" in *+s"$$content") ;; \
		*) echo "build-set origin does not match closed-source content $$content" >&2; exit 1;; esac

override_dh_auto_build:
	scripts/build-preview-codecs.sh
	cargo build --release --frozen --offline --workspace --features templar-wallpaper/decode
	# --workspace builds templar-appd's native templar-app-exec binary as well as
	# the feature-selected decoder; both are assets of templaros-sessiond.
	test -x target/release/templar-app-exec
	test -x target/release/templar-wallpaper-decode

override_dh_auto_test:
	scripts/test-nonzero.sh --release --frozen --offline --workspace

override_dh_auto_install:
	# dh_install handles unchanged basenames; stage the executable/document renames here.
	install -Dm0755 installer/account-maintenance.py debian/templaros-hostd/usr/libexec/templaros-account-maintenance
	install -Dm0755 installer/deployment-layout.py debian/templaros-hostd/usr/libexec/templaros-deployment-layout
	install -Dm0755 installer/account-login-gate.py debian/templaros-hostd/usr/libexec/templaros-account-login-gate
	install -Dm0755 installer/provision.sh debian/templaros-cli/usr/libexec/templaros/provision
	install -Dm0644 installer/README.md debian/templaros-cli/usr/share/doc/templaros-cli/provision.md

override_dh_installdeb:
	# Cargo-deb and native Debian packaging share the same reviewed maintainer hooks.
	install -m0755 packaging/templaros-hostd/postinst debian/templaros-hostd.postinst
	install -m0755 packaging/templaros-hostd/prerm debian/templaros-hostd.prerm
	dh_installdeb

override_dh_auto_clean:
	rm -rf $(CARGO_HOME)
