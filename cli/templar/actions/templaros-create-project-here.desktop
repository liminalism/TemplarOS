# A DES-EMA custom action, read by libfm-qt (pcmanfm-qt) from
# /usr/share/file-manager/actions/. The project id and name are derived from the folder, because
# a file manager's context menu has nowhere to type them.
[Desktop Entry]
Type=Action
Name=Create project here
Tooltip=Make this folder a TemplarOS project
Icon=folder-open
Profiles=folder

[X-Action-Profile folder]
Name=Create project here
MimeTypes=inode/directory;
SelectionCount=1
Exec=templar project create-here %f
