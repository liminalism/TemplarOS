<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Session. Path: /org/templaros/Session/HomeGarden.
     The activity ledger behind Home's grown places (docs/architecture/homegarden.md,
     @templaros.decision.homegarden-activity-grown-places). Observation is fire-and-forget;
     tending is explicit and happens only at tending moments (Home reveal, session start,
     `garden.tend`); every change to the field goes through HomeField1 as one batch, so it is
     undoable there and appears in History1. Time is Garden time: sessions counted and
     unlocked-session runtime accumulated at Lifecycle1's session edges, never wall-clock.
     Tend also reads one bounded page of the shared index's change log (Files.Index1
     ChangesSince) from a persisted cursor, so an earned place can say what arrived in it;
     nothing subscribes to the index, and content can never grow a place.
     Implemented in services/templar-sessiond/src/apis/homegarden.rs. -->
<node>
  <interface name="org.templaros.HomeGarden1">
    <!-- Record one human-significant act on `path`. `kind` is one of placed-on-home,
         project-entered, launched-here, terminal-entered, directory-opened, file-opened,
         created-or-renamed, file-saved; `app_id` and `role` may be empty. Build/cache/hidden
         paths grow no Place. A terminal-entered from a verified brokered peer still updates
         that instance's exact working directory, even for those ignored paths. -->
    <method name="Observe">
      <arg name="kind" type="s" direction="in"/>
      <arg name="path" type="s" direction="in"/>
      <arg name="app_id" type="s" direction="in"/>
      <arg name="role" type="s" direction="in"/>
    </method>
    <!-- Recompute every context's stage and bring `output`'s field in line: one HomeField1
         batch of Place/Resize/Remove ops, never a Move. Pin/Keep/hand placement prevents
         recession but only manual resize freezes size. Returns the tending report as JSON
         ({"changed": n, "ops": [{"op": label, "reason": sentence}]}); "changed" is 0 when the
         field was already in line. -->
    <method name="Tend">
      <arg name="output" type="s" direction="in"/>
      <arg name="report_json" type="s" direction="out"/>
    </method>
    <!-- Every context with its effective relevance now, stage, sessions seen, roles, tree and
         flags, as a JSON array. -->
    <method name="Contexts">
      <arg name="contexts_json" type="s" direction="out"/>
    </method>
    <!-- Exact per-instance terminal cwd, including directories ignored for activity.
         JSON object from verified instance UUID strings to absolute native paths:
         UTF-8 strings unchanged, otherwise {"path_b64":"canonical base64 of Unix bytes"}. -->
    <method name="WorkingDirectories">
      <arg name="directories_json" type="s" direction="out"/>
    </method>
    <!-- Versioned project-work presentation. JSON {version:1,projects:[{root,name,template,
         secondary_templates,template_override,activity,attention,state_line,instances,sessions,
         recent_files,apps}],source_errors:[string]}. Activity active/resting/fading is neutral;
         attention none/needs-you/failed alone selects accents. Session rows contain id,
         instance_id,kind,program,subject,state,updated_ms,exit_status,commands,cwd,resume.
         Path fields use the same native codec as WorkingDirectories; display names are separate.
         recent_files.app_id may be null when the owning Recents1 source has no application identity.
         Commands are approved program/verb only, never raw argv/prompts. Owner Recents1 data
         supports existing Places only; neither recents nor sessions creates ledger weight. -->
    <method name="PresentationV1">
      <arg name="presentation_json" type="s" direction="out"/>
    </method>
    <!-- Display-only schema_version=1 adapter hook. Genuine bus sender uid/PID and a
         broker/current-systemd registered cgroup required; a self-describing name is insufficient.
         JSON bounded, adapter/event/session_id/cwd only. Cwd uses the native JSON path codec.
         Unknown fields or adapters rejected. This can refine existing containment only;
         it never creates a Place or ledger weight. -->
    <method name="ObserveSessionV1">
      <arg name="observation_json" type="s" direction="in"/>
    </method>
    <method name="SessionsV1">
      <arg name="sessions_json" type="s" direction="out"/>
    </method>
    <!-- Collect verified processes and private command journals on activation, without
         moving/resizing/tending a card. Public agent CLI inventory runs at Tend only. -->
    <method name="ActivateInstanceV1">
      <arg name="instance_id" type="s" direction="in"/>
    </method>
    <!-- Persist coding/video/images/documents/plain override; empty restores inference. -->
    <method name="ShowAsV1">
      <arg name="path" type="s" direction="in"/>
      <arg name="template" type="s" direction="in"/>
    </method>
    <!-- Catalogue row and existing project validated server-side. Fixed adapter argv only;
         Launcher1 terminal provider starts a new managed instance with the row's exact cwd,
         carried as a native local-file URI, never lossy directory argv or compositor commands. -->
    <method name="ResumeSessionV1">
      <arg name="path" type="s" direction="in"/>
      <arg name="session_id" type="s" direction="in"/>
      <arg name="instance_id" type="s" direction="out"/>
    </method>
    <!-- Relaunch an installed app inside an existing project using Launcher1's actual
         service WorkingDirectory. No client/raw command arguments reach this API. -->
    <method name="LaunchAppInPlaceV1">
      <arg name="path" type="s" direction="in"/>
      <arg name="app_id" type="s" direction="in"/>
      <arg name="instance_id" type="s" direction="out"/>
    </method>
    <!-- One context by root, with the reason for its last stage change: what `garden.why`
         shows. An empty string when the path is no context. -->
    <method name="Describe">
      <arg name="path" type="s" direction="in"/>
      <arg name="context_json" type="s" direction="out"/>
    </method>
    <!-- A pinned context never recedes and is never removed; it may still grow. Pinning,
         Keeping or placement by hand does not freeze size. Only manual resizing does. -->
    <method name="Pin">
      <arg name="path" type="s" direction="in"/>
      <arg name="pinned" type="b" direction="in"/>
    </method>
    <!-- Keep the project on Home against recession, without freezing its activity-driven size. -->
    <method name="Keep">
      <arg name="path" type="s" direction="in"/>
    </method>
    <!-- A hidden context's tile leaves every Home it is on (one undoable HomeField1 change per
         output) and never grows while hidden; the record is kept so it can be unhidden. Hiding
         outranks a pin. -->
    <method name="Hide">
      <arg name="path" type="s" direction="in"/>
      <arg name="hidden" type="b" direction="in"/>
    </method>
    <!-- Drop one context's record and take its tile off every Home it is on (undoable there);
         fresh activity may grow it again. -->
    <method name="Forget">
      <arg name="path" type="s" direction="in"/>
    </method>
    <!-- Drop every context except the pinned ones. -->
    <method name="ForgetAll"/>
    <!-- Say outright that a running window belongs to this place: the window's instance joins the
         place's `instances`, so it appears in that place's "N windows active" line and in the
         overview that line opens. The third strong association, beside launched-here and the
         brokered open of a file under the place — the difference is that the user made this one.
         An association only: it changes no stage, no score and no bucket, because saying where a
         window belongs is not the same act as working there. `path` must already be a place;
         `instance_id` is `ShellToplevel.instance_id`, which only a brokered launch has. -->
    <method name="AdoptWindow">
      <arg name="path" type="s" direction="in"/>
      <arg name="instance_id" type="s" direction="in"/>
    </method>
    <!-- The Garden Clock now: {"session": n, "active_ms": n, "active": bool}. -->
    <method name="Clock">
      <arg name="moment_json" type="s" direction="out"/>
    </method>
    <!-- A tending moment changed `output`'s field; HomeField1.Changed follows for the document. -->
    <signal name="Tended">
      <arg name="output" type="s"/>
      <arg name="changed" type="u"/>
    </signal>
    <!-- Verified prompt peer identity. Re-read WorkingDirectories and Contexts; the exact cwd
         map is separate from Place attribution and survives sessiond/shell restart. -->
    <signal name="ContextChanged">
      <arg name="instance_id" type="s"/>
      <arg name="path" type="s"/>
    </signal>
  </interface>
</node>
