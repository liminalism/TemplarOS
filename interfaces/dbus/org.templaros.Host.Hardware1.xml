<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Host. Path: /org/templaros/Host. Detected hardware profile and the one
     declarative GPU-mode setting. polkit: org.templaros.host.hardware (SetGpuMode only;
     GraphicsProfile/GpuMode are unauthenticated reads). -->
<node>
  <interface name="org.templaros.Host.Hardware1">
    <!-- GraphicsProfile JSON (crates/templar-hwdetect) -->
    <method name="GraphicsProfile"><arg name="profile_json" type="s" direction="out"/></method>
    <!-- Declared GPU mode ("hybrid"/"integrated"/"discrete"), or "" if unset. -->
    <method name="GpuMode"><arg name="mode" type="s" direction="out"/></method>
    <!-- Set the GPU mode; rejected if unsupported by the detected hardware. -->
    <method name="SetGpuMode"><arg name="mode" type="s" direction="in"/></method>
  </interface>
</node>
