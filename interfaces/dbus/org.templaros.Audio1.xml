<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Session. Path: /org/templaros/Session/Audio. The default sink's volume.

     Three small interfaces rather than one Status1, because volume, backlight and battery are
     three different machines' worth of facts: each has its own backend, its own reason to be
     absent, and only one of them is read-only. A single interface would make every caller carry
     the union of three availability stories.

     Backed by `wpctl` (WirePlumber), run as a subprocess, rather than by libpipewire. The native
     route means a C dependency, a build-time header requirement and unsafe FFI in a workspace
     that forbids it; `wpctl` ships with WirePlumber on every PipeWire desktop, works with no
     display and no session bus of its own, and costs one process per adjustment — which is
     nothing beside a volume key that a person presses a few times a minute. See
     services/templar-sessiond/src/apis/audio.rs.

     Indicators display state and never decide it (`templaros.constraint.services-not-indicators`):
     the widget asks this interface, and this interface is the only thing that knows what a
     volume is. -->
<node>
  <interface name="org.templaros.Audio1">

    <!-- The default sink as JSON: { present, volume_percent, muted, unavailable_reason? }.

         `present: false` means the default volume could not be read: no native server/default
         sink, a failed helper, an unreadable response, or the helper deadline. The optional
         unavailable_reason explains the failure; zero does not stand for a working silent sink.
         Get reports this state rather than raising the native observation failure. -->
    <method name="Get">
      <arg name="state_json" type="s" direction="out"/>
    </method>

    <!-- Current native input/output inventory, defaults and saved stable preferences as JSON.
         Native inventory observation failures are raised, never returned as an empty inventory. -->
    <method name="Inventory">
      <arg name="inventory_json" type="s" direction="out"/>
    </method>
    <!-- Select a currently present input/output by stable node name. The preference is durable
         only after native default readback confirms application; missing/wrong-direction nodes
         and failed native observations do not replace the saved preference. -->
    <method name="SelectDevice">
      <arg name="direction" type="s" direction="in"/>
      <arg name="name" type="s" direction="in"/>
    </method>

    <!-- Set the default sink's volume, as a percentage, clamped to 0..=100. -->
    <method name="SetVolume">
      <arg name="percent" type="u" direction="in"/>
    </method>

    <!-- Move the volume by `delta` percentage points and return where it landed.

         One call rather than Get-then-Set: two clients on the same volume key would otherwise
         read the same value and each write its own idea of "one step up", and the second would
         undo the first. -->
    <method name="AdjustVolume">
      <arg name="delta" type="i" direction="in"/>
      <arg name="percent" type="u" direction="out"/>
    </method>

    <method name="SetMuted">
      <arg name="muted" type="b" direction="in"/>
    </method>

    <!-- Flip mute and report the new state, for the same reason AdjustVolume exists. -->
    <method name="ToggleMuted">
      <arg name="muted" type="b" direction="out"/>
    </method>

    <!-- Current devices/defaults/volume/mute changed. Includes external PipeWire events and one
         notification on monitor disconnect, so consumers re-read availability on server loss.
         The pw-dump monitor reconnects after disconnect; repeated failures are one transition.
         Helpers have a 3-second deadline: wpctl output is bounded to 65536 bytes, pw-dump inventory
         and monitor frames to 8 MiB. Call Get and Inventory for applied state.
         Saved node names survive object-ID changes and are restored when the node reappears. -->
    <signal name="Changed"/>
  </interface>
</node>
