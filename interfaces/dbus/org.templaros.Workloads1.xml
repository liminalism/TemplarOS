<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Session bus org.templaros.Session /org/templaros/Session/Workloads.
     Explicit scopes, not application grants. RegisterChild accepts only the actual sender's
     same-UID direct child and returns only after kernel cgroup membership is observed.
     Caller must hold its child at an execution gate until admission succeeds. -->
<node>
  <interface name="org.templaros.Workloads1">
    <method name="RegisterChild">
      <arg name="child_pid" type="u" direction="in"/>
      <arg name="class" type="s" direction="in"/>
      <arg name="command_summary" type="s" direction="in"/>
      <arg name="record_json" type="s" direction="out"/>
    </method>
    <method name="Resolve">
      <arg name="pid" type="u" direction="in"/>
      <arg name="record_json" type="s" direction="out"/>
    </method>
    <method name="List">
      <arg name="records_json" type="s" direction="out"/>
    </method>
    <signal name="Changed"/>
  </interface>
</node>
