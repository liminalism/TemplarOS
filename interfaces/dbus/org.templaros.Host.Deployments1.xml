<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Host. Path: /org/templaros/Host. Boot deployments and rollback (ADR-0004).
     polkit: org.templaros.host.deploy -->
<node>
  <interface name="org.templaros.Host.Deployments1">
    <method name="Backend"><arg name="name" type="s" direction="out"/></method>
    <method name="List"><arg name="deployments_json" type="s" direction="out"/></method>
    <method name="Stage">
      <arg name="id" type="s" direction="in"/>
      <arg name="tries" type="y" direction="in"/>
    </method>
    <method name="MarkGood"/>
    <method name="Rollback"><arg name="id" type="s" direction="in"/></method>
  </interface>
</node>
