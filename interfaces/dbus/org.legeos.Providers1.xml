<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.legeos.Session. Path: /org/legeos/Session/Providers.
     One selected provider per exclusive role (network-status-ui, notification-server, file-chooser,
     file-manager, lock-screen, association-broker, clipboard-manager, power-manager,
     screenshot-service, input-method, portal-backend, greeter).
     Implemented in services/lege-sessiond/src/apis/providers.rs. -->
<node>
  <interface name="org.legeos.Providers1">
    <!-- (role, resolution-json) -->
    <method name="Report">
      <arg name="report" type="a(ss)" direction="out"/>
    </method>
    <method name="Select">
      <arg name="role" type="s" direction="in"/>
      <arg name="app_id" type="s" direction="in"/>
    </method>
    <!-- An application (or its manifest/autostart-entry import) declares it can fill a role.
         priority: distribution defaults use 100, third parties 50. -->
    <method name="Declare">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="role" type="s" direction="in"/>
      <arg name="priority" type="u" direction="in"/>
    </method>
    <!-- Remove every role declaration `app_id` made (uninstalled, or withdrawing). -->
    <method name="Undeclare">
      <arg name="app_id" type="s" direction="in"/>
    </method>
    <!-- A role's resolution may have changed; re-call Report for the current state. -->
    <signal name="Changed">
      <arg name="role" type="s"/>
    </signal>
  </interface>
</node>
