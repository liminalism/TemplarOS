<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Session. Path: /org/templaros/Session/Providers.
     One selected provider per exclusive role (network-status-ui, notification-server, file-chooser,
     file-manager, lock-screen, association-broker, clipboard-manager, power-manager,
     screenshot-service, input-method, portal-backend, greeter, terminal,
     file-search).
     Implemented in services/templar-sessiond/src/apis/providers.rs. -->
<node>
  <interface name="org.templaros.Providers1">
    <!-- (role, resolution-json) -->
    <method name="Report">
      <arg name="report" type="a(ss)" direction="out"/>
    </method>
    <!-- Every application that declares `role`, best first — the same order Report's
         DefaultedByPriority resolution picks its winner from, so the head of this list is the
         default. (app_id, priority). A chooser needs this: Report names the winner and, only
         when nothing is explicitly selected, its losers, so from Report alone a client cannot
         offer the alternatives to a role that *has* a selection. -->
    <method name="Candidates">
      <arg name="role" type="s" direction="in"/>
      <arg name="candidates" type="a(su)" direction="out"/>
    </method>
    <!-- Pin `role` to `app_id`. Recorded in History1 with an Undo action, like every other
         reversible decision the session makes on a person's behalf. -->
    <method name="Select">
      <arg name="role" type="s" direction="in"/>
      <arg name="app_id" type="s" direction="in"/>
    </method>
    <!-- Drop the explicit selection and let priority decide again. Deliberately not the same as
         selecting whichever application priority currently favours: that would pin today's
         winner, and a higher-priority provider installed later would never take over. Also
         recorded with an Undo action. -->
    <method name="Deselect">
      <arg name="role" type="s" direction="in"/>
    </method>
    <!-- An application (or its manifest/autostart-entry import) declares it can fill a role.
         priority: distribution defaults use 100, third parties 50.
         `app_id` names a *variant*, and a caller may only declare for itself: the peer's PID is
         resolved through its cgroup exactly as ResolveWindow does, and a mismatch is refused. A
         variant whose provenance is a user-owned file (trust tier User) may not take an exclusive
         role at all — a .desktop file dropped into ~/.local/share/applications must not become the
         session's notification server. Refusals are recorded in History1 so the person can see
         what asked and why it was turned down. -->
    <method name="Declare">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="role" type="s" direction="in"/>
      <arg name="priority" type="u" direction="in"/>
    </method>
    <!-- Remove every role declaration `app_id` made (uninstalled, or withdrawing). -->
    <method name="Undeclare">
      <arg name="app_id" type="s" direction="in"/>
    </method>
    <!-- A role's resolution may have changed; re-call Report for the current state. -->
    <signal name="Changed">
      <arg name="role" type="s"/>
    </signal>
  </interface>
</node>
