<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Host. Path: /org/templaros/Host. One driver authority.
     polkit: org.templaros.host.driver (Repair only; Plan/Violations are unauthenticated reads). -->
<node>
  <interface name="org.templaros.Host.Drivers1">
    <!-- DriverPlan JSON: metapackage, default_mode, violations -->
    <method name="Plan"><arg name="plan_json" type="s" direction="out"/></method>
    <!-- Just the violations, as JSON (Vec<SupportViolation>). -->
    <method name="Violations"><arg name="violations_json" type="s" direction="out"/></method>
    <!-- Accept the currently-installed NVIDIA versions as the new locked baseline; returns the
         written VersionLock as JSON. -->
    <method name="Repair"><arg name="version_lock_json" type="s" direction="out"/></method>
  </interface>
</node>
