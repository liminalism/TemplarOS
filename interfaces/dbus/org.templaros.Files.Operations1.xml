<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Files (session bus, templar-filed). Path: /org/templaros/Files.

     File operations as transactions. The service, not the GUI that asked for it, owns the
     journal — so a long copy survives the crash of the file manager, and an interrupted move
     leaves either the original or the copy, never neither. Undo covers rename, move and trash;
     a permanent delete has no undo and says so before it runs. -->
<node>
  <interface name="org.templaros.Files.Operations1">

    <!-- kind_json is an OperationKind: copy | move | rename | trash | restore-from-trash |
         delete. Absolute paths, one-component rename names, non-root removal and
         copy/move-not-into-self are validated by the service before journalling.
         options_json is an Options (conflict: fail|skip|replace|keep-both,
         verify: size|checksum, override_reserve); an empty string means the defaults.
         Returns immediately with the operation ID; watch Progress and Finished. -->
    <method name="Start">
      <arg name="kind_json" type="s" direction="in"/>
      <arg name="options_json" type="s" direction="in"/>
      <arg name="app_id" type="s" direction="in"/>
      <arg name="op_id" type="s" direction="out"/>
    </method>

    <!-- Stop at the next step boundary. Anything already exposed stays exposed. -->
    <method name="Cancel">
      <arg name="op_id" type="s" direction="in"/>
    </method>

    <!-- The full journalled record, including every step and the resume cursor. -->
    <method name="Get">
      <arg name="op_id" type="s" direction="in"/>
      <arg name="operation_json" type="s" direction="out"/>
    </method>

    <!-- Newest first: the Operations drawer. -->
    <method name="Recent">
      <arg name="limit" type="u" direction="in"/>
      <arg name="operations_json" type="s" direction="out"/>
    </method>

    <!-- Whether an undo is still possible, and if not, the reason to show. -->
    <method name="CanUndo">
      <arg name="op_id" type="s" direction="in"/>
      <arg name="can_undo" type="b" direction="out"/>
      <arg name="reason" type="s" direction="out"/>
    </method>

    <!-- Reverse a committed operation; returns the ID of the operation that does it. -->
    <method name="Undo">
      <arg name="op_id" type="s" direction="in"/>
      <arg name="undo_op_id" type="s" direction="out"/>
    </method>

    <signal name="Progress">
      <arg name="op_id" type="s"/>
      <arg name="state" type="s"/>
      <arg name="done_bytes" type="t"/>
      <arg name="total_bytes" type="t"/>
      <arg name="done_items" type="t"/>
      <arg name="total_items" type="t"/>
    </signal>

    <!-- state is committed | failed | cancelled | undone; error is empty unless it failed. -->
    <signal name="Finished">
      <arg name="op_id" type="s"/>
      <arg name="state" type="s"/>
      <arg name="error" type="s"/>
    </signal>
  </interface>
</node>
