<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Resources (session bus, templar-resourced). Path: /org/templaros/Resources.

     The governor never needs this interface to act: launch units are self-describing
     (`app-templaros-<AppId>@<InstanceId>.service`), so cgroup -> instance comes from
     /sys/fs/cgroup alone and emergency containment works with no D-Bus round-trip at all
     (ADR-0002). What arrives here is *enrichment* — who is on screen, what must never be a
     victim — and observation for the shell, Settings and `templar res`.

     Enrichment senders:
       * templar-comp (through templar-comp-integration) -> SetInstanceState, on focus/visibility change.
       * templar-sessiond                             -> SetInstanceHints, on manifest load, project
                                                      open/close and checkpoint replies.
     Consumers of PressureAction: templar-sessiond (relays the checkpoint protocol to applications
     and records history) and templar-shell (the protected pressure overlay). -->
<node>
  <interface name="org.templaros.Resources1">

    <!-- Current pressure level (normal|elevated|severe|critical) and whether the governor is
         still observe-only. -->
    <method name="Status">
      <arg name="level" type="s" direction="out"/>
      <arg name="observe_only" type="b" direction="out"/>
    </method>

    <!-- Full status as JSON: level, stage, uptime, MemAvailable, global PSI, per-instance
         samples with their victim scores and score breakdowns. -->
    <method name="Report">
      <arg name="report_json" type="s" direction="out"/>
    </method>

    <!-- Why this instance would (or would not) be chosen next, in words and in numbers. -->
    <method name="ExplainInstance">
      <arg name="instance_id" type="s" direction="in"/>
      <arg name="explanation_json" type="s" direction="out"/>
    </method>

    <!-- Containment stage: observe-only | trim | throttle | checkpoint | terminate.
         Each stage enables everything below it (planning doc 02 §8: enable recovery actions
         in stages, only after recorded traces show sensible choices). -->
    <method name="Stage">
      <arg name="stage" type="s" direction="out"/>
    </method>
    <method name="SetStage">
      <arg name="stage" type="s" direction="in"/>
    </method>

    <!-- Compositor enrichment: which instance the user is actually looking at. -->
    <method name="SetInstanceState">
      <arg name="instance_id" type="s" direction="in"/>
      <arg name="foreground" type="b" direction="in"/>
      <arg name="visible" type="b" direction="in"/>
    </method>

    <!-- Session-daemon enrichment: protection, disposability, checkpoint support and whether
         the application currently holds unsaved work. -->
    <method name="SetInstanceHints">
      <arg name="instance_id" type="s" direction="in"/>
      <arg name="protected" type="b" direction="in"/>
      <arg name="disposable" type="b" direction="in"/>
      <arg name="supports_checkpoint" type="b" direction="in"/>
      <arg name="has_unsaved_work" type="b" direction="in"/>
    </method>

    <!-- Unsaved work and checkpoint freshness, with the times they were true.
         Separate from SetInstanceHints on purpose. SetInstanceHints sets four facts at once, so
         every caller has to supply a value for all of them — and the callers that know about
         protection and disposability know nothing about unsaved work, so they pass `false` and
         silently erase a claim another caller made. Splitting it also gives the claim a
         timestamp, which is what lets it expire: "this application has unsaved work" and "this
         application said so six hours ago" are different statements, and the governor was making
         the second while sounding like the first.

         as_of_ms is when the claim became true (milliseconds since the Unix epoch, 0 = now).
         checkpoint_ok says the instance has a usable checkpoint, and checkpoint_at_ms when it was
         taken — an application that can be restored from a recent checkpoint is a very different
         proposition to one that can only be killed. -->
    <method name="SetInstanceWork">
      <arg name="instance_id" type="s" direction="in"/>
      <arg name="has_unsaved_work" type="b" direction="in"/>
      <arg name="as_of_ms" type="x" direction="in"/>
      <arg name="checkpoint_ok" type="b" direction="in"/>
      <arg name="checkpoint_at_ms" type="x" direction="in"/>
    </method>

    <!-- Attention and intent: when the user last touched this instance, whether they asked for
         it to be kept, and whether it belongs to a project they marked important.

         Senders: templar-comp on focus change (last_interaction_ms), templar-sessiond on pin and
         project changes. An instance nobody reports is scored exactly as it was before any of
         this existed — "nobody said" is not "a long time ago", and the governor must not read it
         as one.

         last_interaction_ms is milliseconds since the Unix epoch (0 = never reported).
         user_pinned is a strong protective weight and deliberately *not* an exclusion: only
         `protected` excludes, so a pinned application that starts consuming the machine can
         still be contained. A pin that could not be overridden would make asking for something
         reasonable the way to render a desktop unrecoverable. -->
    <method name="SetInstanceActivity">
      <arg name="instance_id" type="s" direction="in"/>
      <arg name="last_interaction_ms" type="x" direction="in"/>
      <arg name="user_pinned" type="b" direction="in"/>
      <arg name="project_important" type="b" direction="in"/>
    </method>

    <!-- An instance ended; drop its record and any temporary limits. -->
    <method name="ForgetInstance">
      <arg name="instance_id" type="s" direction="in"/>
    </method>

    <!-- Recorded traces, newest first, as JSON lines: every tick at elevated-or-worse pressure,
         and every decision at any level -- the evidence reviewed before raising the stage past
         observe-only, not only what happened while it was observe-only. -->
    <method name="RecentTraces">
      <arg name="limit" type="u" direction="in"/>
      <arg name="traces_json" type="s" direction="out"/>
    </method>

    <!-- Pressure level changed. -->
    <signal name="PressureChanged">
      <arg name="level" type="s"/>
      <arg name="report_json" type="s"/>
    </signal>

    <!-- One decided action. `kind` is trim-caches | set-memory-high | reclaim |
         request-checkpoint | kill-cgroup | restore-limits; `applied` is false in observe-only
         mode and at stages below the action. `reason` is the sentence the history event and the
         pressure overlay show the user. -->
    <signal name="PressureAction">
      <arg name="kind" type="s"/>
      <arg name="instance_id" type="s"/>
      <arg name="applied" type="b"/>
      <arg name="reason" type="s"/>
      <arg name="detail_json" type="s"/>
    </signal>

    <!-- A stall the memory governor does not own: storage | gpu-reset | kernel-lockup |
         hardware. Each needs a different recovery path and a different message
         (planning doc 01 §5). -->
    <signal name="NonMemoryStall">
      <arg name="kind" type="s"/>
      <arg name="detail_json" type="s"/>
    </signal>
  </interface>
</node>
