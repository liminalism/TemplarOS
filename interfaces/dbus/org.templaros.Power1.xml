<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Session. Path: /org/templaros/Session/Power.
     Stored profiles are not effect confirmation. A single sessiond policy owner schedules
     from compositor-owned idle elapsed/real activity serials and performs native SetIdleTimeout,
     Backlight1 dim/conditional restore, Lifecycle1 LockRequested and authorized logind effects.
     UPower properties supply actual source/lid state; unsupported/missing owners remain explicit.
     Automatic sleep requires fresh native current-generation protected-output coverage, not a
     saved Locked signal. The existing sole PrepareForSleep watcher feeds shared SessionEdges;
     its live registration witness gates sleep capability/delay ownership and loss releases them.
     Scoped handle-lid-switch ownership exists only while handling is available; external sleep
     delay is finite and cannot guarantee cancellation after logind's InhibitDelayMaxUSec.
     Awake closed-panel choices are additive serde-defaulted profile fields; sleep never disables
     outputs to manufacture a coverage acknowledgment. Compositor owns validated panel reopen.
     https://www.freedesktop.org/software/systemd/man/org.freedesktop.login1.html
     https://upower.freedesktop.org/docs/UPower.html -->
<node>
  <interface name="org.templaros.Power1">
    <!-- source: battery or mains. Stored override or distribution default, not applied state. -->
    <method name="GetProfile">
      <arg name="source" type="s" direction="in"/>
      <arg name="profile_json" type="s" direction="out"/>
    </method>
    <!-- Store this source. Selected policy reconciles owners; failures can leave a stored
         but unapplied/partially supported policy, which Inspect distinguishes per field. -->
    <method name="SetProfile">
      <arg name="source" type="s" direction="in"/>
      <arg name="profile_json" type="s" direction="in"/>
    </method>
    <method name="ResetProfile"><arg name="source" type="s" direction="in"/></method>
    <!-- PowerObservation JSON: stored battery/mains, actual selected source/profile,
         observed native timeout/coverage/activity, per-field capability/armed/error,
         actual lid/topology, scoped inhibitor ownership and pending-not-completed sleep. -->
    <method name="Inspect"><arg name="observation_json" type="s" direction="out"/></method>
    <signal name="Changed"><arg name="revision_json" type="s"/></signal>
  </interface>
</node>
