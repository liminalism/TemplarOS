<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.legeos.Host. Path: /org/legeos/Host. The session -> hostd health report: the only
     writer of /run/legeos/{compositor-active,session-healthy}, which lege-boot-health reads
     (services/lege-boot-health/src/main.rs) to decide whether a candidate kernel/driver
     deployment on trial gets blessed or rolled back.

     NOT polkit-gated: this is a report, not an administrative action, and lege-sessiond runs
     unprivileged (no auth_admin to grant, and a password prompt on every boot is a non-starter).
     Authorization is by caller identity instead — hostd resolves the caller's PID over the bus
     (org.freedesktop.DBus.GetConnectionUnixProcessID) and checks its cgroup names
     lege-sessiond.service, so an unprivileged peer cannot forge a healthy-session report by
     simply calling these methods. See crates/lege-hostd/src/session_report.rs. -->
<node>
  <interface name="org.legeos.Host.Session1">
    <!-- The compositor's Wayland socket is accepting connections. -->
    <method name="ReportCompositorActive"/>
    <!-- The session's own startup sequence finished and a client frame was observed. -->
    <method name="ReportSessionHealthy"/>
  </interface>
</node>
