<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Files (session bus, templar-filed). Path: /org/templaros/Files.

     The versioned, lossless-path, generation-aware index query surface
     (docs/planning/shared-incremental-file-index.md). Additive to Search1, which keeps its
     exact six signatures and delegates to the same core this interface exposes directly.

     Every JSON payload carries native path bytes as base64 in a "path_b64"/"bytes_b64" field
     beside a lossy "display" string, and — wherever it lists rows — the generation it was
     produced at and the freshness of every root in scope. Nothing here converts a path to
     lossy UTF-8 on the storage or IPC path; Search1's plain-string API is the documented
     compatibility exception, not the model. -->
<node>
  <interface name="org.templaros.Files.Index1">
    <!-- Every registered root's RootStatus plus the core's own Diagnostics. -->
    <method name="Roots">
      <arg name="roots_json" type="s" direction="out"/>
    </method>

    <!-- One JSON argument (a Query) so filters/sort/field-mask can grow without a signature
         change. Returns a server-side cursor id, the generation it was produced at, and the
         first page as JSON. -->
    <method name="Search">
      <arg name="query_json" type="s" direction="in"/>
      <arg name="cursor" type="s" direction="out"/>
      <arg name="generation" type="t" direction="out"/>
      <arg name="page_json" type="s" direction="out"/>
    </method>

    <!-- Random access inside a pinned result set: the cursor's own generation, never a newer
         one. Raises Index1.Error.SnapshotRequired when the cursor is unknown, expired, evicted
         or lost to a restart. -->
    <method name="FetchPage">
      <arg name="cursor" type="s" direction="in"/>
      <arg name="offset" type="u" direction="in"/>
      <arg name="count" type="u" direction="in"/>
      <arg name="page_json" type="s" direction="out"/>
    </method>

    <!-- Best effort; a client that vanishes is covered by idle expiry regardless. -->
    <method name="CloseCursor">
      <arg name="cursor" type="s" direction="in"/>
    </method>

    <!-- A sealed TEMPLARIDX1 bulk snapshot: a consistent, streamed picture of selected roots,
         consumable without SQLite. The manifest's `snapshot_seq` is the change-log position the
         snapshot is consistent with: pass it to ChangesSince to continue without a gap. -->
    <method name="OpenSnapshot">
      <arg name="request_json" type="s" direction="in"/>
      <arg name="snapshot" type="h" direction="out"/>
      <arg name="manifest_json" type="s" direction="out"/>
    </method>

    <!-- A bounded page of the change log after seq. Raises Index1.Error.SnapshotRequired below
         the retained floor: the service never invents continuity it cannot prove. -->
    <method name="ChangesSince">
      <arg name="seq" type="t" direction="in"/>
      <arg name="limit" type="u" direction="in"/>
      <arg name="batch_json" type="s" direction="out"/>
    </method>

    <!-- Schedules a background repair of the given roots (a JSON array of root ids; empty means
         every registered root) and returns immediately with an opaque request id. Progress is
         observed through Roots and the signals below, not through this id. Replaces the old
         Search1.IndexRoot behaviour of walking synchronously on the calling thread. -->
    <method name="Reconcile">
      <arg name="roots_json" type="s" direction="in"/>
      <arg name="request_id" type="s" direction="out"/>
    </method>

    <!-- A generation committed: a live client's changes_since/cached Search results are now
         behind it. -->
    <signal name="GenerationAdvanced">
      <arg name="generation" type="t"/>
      <arg name="change_count" type="u"/>
    </signal>

    <!-- A root's freshness state changed. -->
    <signal name="RootStateChanged">
      <arg name="root_id" type="x"/>
      <arg name="state" type="s"/>
      <arg name="reason" type="s"/>
    </signal>
  </interface>
</node>
