<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Host. Path: /org/templaros/Host. Storage reserve policy.
     polkit: org.templaros.host.storage (Enforce only; TrimOrder/Usage are unauthenticated reads). -->
<node>
  <interface name="org.templaros.Host.Storage1">
    <method name="TrimOrder"><arg name="targets" type="as" direction="out"/></method>
    <!-- VolumeUsage JSON (total/free/reserved bytes) for the volume mounted at mount_point. -->
    <method name="Usage">
      <arg name="mount_point" type="s" direction="in"/>
      <arg name="usage_json" type="s" direction="out"/>
    </method>
    <!-- Run the trim order against mount_point until healthy or exhausted; returns what ran,
         as JSON (Vec<TrimReport>). -->
    <method name="Enforce">
      <arg name="mount_point" type="s" direction="in"/>
      <arg name="report_json" type="s" direction="out"/>
    </method>
  </interface>
</node>
