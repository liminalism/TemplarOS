<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.templaros.Session. Path: /org/templaros/Session/History.
     System-wide change history; each item is an Event JSON document (crates/templar-session-core/src/history.rs).
     Implemented in services/templar-sessiond/src/apis/history.rs. -->
<node>
  <interface name="org.templaros.History1">
    <method name="Recent">
      <arg name="limit" type="u" direction="in"/>
      <arg name="events_json" type="as" direction="out"/>
    </method>
    <method name="Search">
      <arg name="query" type="s" direction="in"/>
      <arg name="limit" type="u" direction="in"/>
      <arg name="events_json" type="as" direction="out"/>
    </method>
    <!-- Record an event from outside sessiond's own domains (e.g. templar-filed, first-party apps).
         app_id/instance_id/cause may be empty for "not applicable". actions_json is a JSON array
         of {"label":.., "command":..}. -->
    <method name="Append">
      <arg name="kind" type="s" direction="in"/>
      <arg name="app_id" type="s" direction="in"/>
      <arg name="instance_id" type="s" direction="in"/>
      <arg name="message" type="s" direction="in"/>
      <arg name="cause" type="s" direction="in"/>
      <arg name="actions_json" type="s" direction="in"/>
      <arg name="reversible" type="b" direction="in"/>
      <arg name="event_id" type="s" direction="out"/>
    </method>
    <!-- Dispatch by the event's undo action to the originating domain (association default,
         setting, provider selection, ...). Returns whether anything was actually undone. -->
    <method name="Undo">
      <arg name="event_id" type="s" direction="in"/>
      <arg name="undone" type="b" direction="out"/>
    </method>
    <!-- A new event was appended, or one was undone; re-call Recent/Search for current state. -->
    <signal name="Changed">
    </signal>
  </interface>
</node>
