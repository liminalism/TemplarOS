<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Bus: org.legeos.Resources (session bus, separate protected process lege-resourced).
     Path: /org/legeos/Resources. -->
<node>
  <interface name="org.legeos.Resources1">
    <!-- level: normal | elevated | severe | critical -->
    <method name="Status">
      <arg name="level" type="s" direction="out"/>
      <arg name="observe_only" type="b" direction="out"/>
    </method>
  </interface>
</node>
