<?xml version="1.0" encoding="UTF-8"?>
<!-- Compositor-core owned recovery surfaces (Layer::Recovery). Used by the resource overlay
     to identify the likely offender and offer "save / terminate / open terminal" without relying
     on the ordinary shell. Draft.

     Not modelled as protocol here because no client (not even the trusted shell) needs to ask
     for them over the wire — the compositor core binds them directly to fixed key combinations
     and calls straight into `templar_window::WindowService`, so they work with no client connected
     at all (`docs/architecture/accessibility.md`):
       * the "show every window" scatter (`WindowService::handle_command(ShowAllWindows, ...)` /
         `geometry::scatter_layout`) — `templar_shell_manager_v1.show_all_windows` in
         `templar-shell-v1.xml` exists only so the *shell's own UI* can also trigger it;
       * the fullscreen/modal escape route (`WindowService::escape`) — likewise mirrored as
         `templar_shell_manager_v1.escape_fullscreen_or_modal` for the shell's UI;
       * the minimal fallback window switcher (`WindowService::cycle_focus`);
       * the per-window recovery tab the compositor paints over client-side-decorated and
         borderless windows (`WindowService::recovery_affordance`) — pure compositor-side
         rendering, no client is even aware of it. -->
<protocol name="templar_recovery_v1">
  <copyright>Copyright 2026 TemplarOS contributors. AGPL-3.0-only.</copyright>
  <interface name="templar_recovery_manager_v1" version="1">
    <description summary="emergency overlay">
      Only templar-resourced (via sessiond) may request the pressure overlay; the compositor draws it
      itself so it works when the shell is dead.
    </description>
    <request name="show_pressure_overlay">
      <arg name="offender_app_id" type="string" allow-null="true"/>
      <arg name="offender_instance_id" type="string" allow-null="true"/>
      <arg name="message" type="string"/>
    </request>
    <request name="hide_pressure_overlay"/>
    <event name="user_choice">
      <arg name="choice" type="uint" enum="choice"/>
    </event>
    <enum name="choice">
      <entry name="wait" value="0"/>
      <entry name="checkpoint_and_terminate" value="1"/>
      <entry name="terminate" value="2"/>
      <entry name="open_terminal" value="3"/>
    </enum>
  </interface>
</protocol>
