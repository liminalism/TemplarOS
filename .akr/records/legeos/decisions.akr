    author "dk"
}

record legeos.decision.compositor-on-smithay/1 : decision {
    title "D12/ADR-0012 — lege-comp is built directly on Smithay, not forked from cosmic-comp; GPL-3.0-only is the one licence exception"
    state proposed
    scope [ path "compositor/**", path "distro/forks/**" ]
    decision """
        The compositor is written directly against Smithay 0.7 (MIT), with cosmic-comp read freely as a reference but no COSMIC crate in the dependency graph. It lives at compositor/lege-comp as a member of this workspace and is licensed GPL-3.0-only — the single licence exception in an otherwise MPL-2.0 repository, because cosmic-comp was read while writing it. cosmic-comp and cosmic-greeter are removed from distro/forks/manifest.toml; the greeter becomes lege-greeter over greetd's JSON IPC. The lock screen stays compositor-owned ext-session-lock-v1, which Smithay provides.
        """
    context """
        Planning doc 01 §3 recommended forking cosmic-comp and deleting its window manager, judging that path "more likely to produce a usable system". That judgement predates crates/lege-window. Six measurements reversed it. (1) The layer a fork would keep is saturated with libcosmic: shell/element/ is 8,446 lines of which 7,304 (86%) import cosmic::/iced, so "keep element/, drop libcosmic" is not a cut that exists. (2) shell/focus/ is literally split-out `impl Shell` and `impl Common` blocks and cannot be kept while the thing it is an impl of is deleted. (3) grabs/moving.rs calls straight into the code a fork would delete. (4) Of 92 commits in the last 12 months touching the delete-paths, 52 (57%) touched a keep-path in the same commit, so the fork boundary would not insulate us. (5) input/'s keybinding model is an external COSMIC type. (6) cosmic-comp is GPL-3.0-only with no or-later clause. Meanwhile the largest part of any compositor — cosmic-comp/src/shell/'s 32,636 lines of window-management policy — already exists as crates/lege-window: 2,730 lines with no async runtime and no D-Bus. Smithay 0.7 already implements server-side every protocol LegeOS's documents name, including ext-session-lock-v1 and ext-foreign-toplevel-list-v1, plus a complete XWayland window-manager role.
        """
    consequences """
        One licence exception to track: debian/copyright carries a Files: compositor/lege-comp/* stanza and deny.toml allows GPL-3.0-only. Not in Smithay and ours to write: wlr-output-management, real screencopy capture, config, D-Bus glue and our two private protocols. Smithay is pinned to a git rev rather than a release, shared with cosmic-comp, which is a useful signal it works on this hardware. The winit backend is the crate's testable path where there is no display hardware, which makes it load-bearing rather than a debug aid: the protocol set is therefore constructed in one place (LegeCompState::new) so both backends provably advertise the same thing.
        """
    source {
        kind internal
        role origin
        path "docs/adr/0012-compositor-on-smithay.md"
        use """
            The full decision record with all six measurements and the amendments it makes to ADRs 0005, 0008 and 0010.
            """
    }
}

record legeos.decision.debian-packaging/1 : decision {
    title "D9/ADR-0009 — Packaging: cargo-deb per binary now; one vendored source package (root debian/) for the archive; keyring + pins as legeos-archive-keyring"
    state active
    scope [
        path "debian/**",
        path "distro/apt/**",
        path "distro/metapackages/**",
        path "packaging/**"
    ]
    decision """
        Stage 1: every binary crate carries [package.metadata.deb]; `cargo deb -p <crate>` feeds a local aptly repo (never /usr/local). Stage 2: one source package `legeos` with debian/ at the repo root, vendor/ shipped in the orig tarball, dh_auto_build overridden with `cargo build --release --frozen --offline --workspace`; metapackages in legeos-meta; legeos-archive-keyring ships the archive key, deb822 legeos.sources and preferences.d pins rejecting third-party driver repositories. dh-cargo is not used.
        """
    context """
        dh-cargo expects Debian-packaged crates — impractical for zbus 5 / tokio 1.5x / smithay; vendoring is what COSMIC's own packaging does.
        """
    consequences """
        Packages from day one; the archive path is ready when the repository exists.
        """
    implements [ @legeos.constraint.packaging-and-render-thread ]
    supported_by [ @legeos.evidence.m0-deb-builds ]
}

record legeos.decision.decorative-client-claim-icons-20261005/1 : decision {
    title "Unverified application claims are decorative icon keys only"
    state superseded
    scope [
        path "compositor/templar-comp/src/protocols_shell.rs",
        path "interfaces/wayland/templaros-shell-v1.xml",
        path "shell/templar-shell/**"
    ]
    topic decorative-client-claim-icons
    decision "Expose a bounded decorative claimed_app_id separately from canonical AppIdentity. The shell may resolve it only as an icon key and must mark the resulting icon unverified. It must not use the claim for grouping unknown windows, grants, launching, MRU or Homegarden verified-instance identity. Unknown windows remain keyed independently by their WindowId."
    context "Unregistered clients can still supply a useful icon key, but the accepted identity/launch safety boundary forbids upgrading a self-declared application ID into canonical authority."
    consequences "Unknown clients gain recognizable display-only icons without claiming another application's rights or trusted task membership. Verified identity continues to take precedence."
    implements [ @legeos.constraint.identity-and-launch-safety ]
    author "dk"
}

