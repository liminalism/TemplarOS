record legeos.decision.independent-storage-roles/1 : decision {
    title "Provisioning declares independent storage roles and per-partition preservation policy"
    state superseded
    scope [
        path "distro/deploy/**",
        path "installer/**",
        path "services/lege-filed/**",
        path "services/lege-sessiond/**"
    ]
    topic developer-edition-storage-layout
    decision """
        One versioned layout contract describes device and filesystem identity, mount and subvolume roles, per-partition create/reuse/format policy, boot and deployment identity, recovery ownership, search visibility, acquisition coverage and accounting policy. Discovery and preparation are separate from deployment but use the same backend operation model. Dry-run and apply consume the same reviewed operation sequence, and apply revalidates topology, identity and mounted state immediately before mutation.
        """
    context """
        The current existing-partition mode preserves the partition table but rewrites GPT type codes and formats both ESP and root. It is not preservation. The current root=LABEL=legeos-root boot contract also makes identity migration a coordinated provisioner, fstab, boot-entry and rollback change.
        """
    consequences """
        Keep image, erase-disk, free-tail and existing-partition modes, adding explicit preservation semantics. No type-code rewrite or formatting occurs in preservation mode unless selected. A second data filesystem is optional and never assumed expendable. Preserve current OS subvolumes; stage optional @build and independent project/data/media/archive roles. Search, acquisition and accounting scopes are distinct; checkpoint activation remains opt-in and per filesystem.
        """
    derived_from [ @legeos.milestone.developer-edition-0-1/1 ]
    supported_by [
        @legeos.evidence.provisioning-plan-and-uuid-identity-20260907,
        @legeos.observation.the-provisioner-wrote-no-fstab-at-all
    ]
    source {
        kind external
        role origin
        document "legacy-filesystem-design"
        start_byte 0
        end_byte 9080
        start_line 1
        end_line 390
        excerpt_hash "sha256:2b0601ef86ceea0adac33267c9853a3d52ba789ffbe48153edd3928b285ae413"
        use """
            Adopts independent OS/data roles, explicit layout, preparation/deployment separation and reviewed destructive operations.
            """
    }
    source {
        kind external
        role origin
        document "legacy-filesystem-design"
        start_byte 10029
        end_byte 16246
        start_line 438
        end_line 671
        excerpt_hash "sha256:7cc1bb7ead4402d3b9b909ca51980507adbaaefeafef65e9665a6febedd71048"
        use """
            Adopts filesystem identity and search/accounting boundaries while deferring unmeasured optimization.
            """
    }
}

