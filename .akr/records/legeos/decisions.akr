akr 0.1
project legeos

record legeos.decision.agplv3-own-code/1 : decision {
    title "D13/ADR-0013 — own code is AGPL-3.0-only; lege-comp stays GPL-3.0-only (§13 combination); Silvaview-rs relicensed identically"
    state active
    scope [
        path "Cargo.toml",
        path "LICENSE",
        path "debian/copyright",
        path "deny.toml",
        path "docs/adr/0013-agplv3.md",
        path "interfaces/wayland/**"
    ]
    decision """
        Every first-party crate, interface, document and asset is AGPL-3.0-only (repository-wide LICENSE, workspace license field, deny.toml allow-list, Wayland <copyright> lines, cargo xtask copyright default, full text in DEP-5 debian/copyright because Ubuntu's common-licenses has no AGPL-3). compositor/lege-comp stays GPL-3.0-only for ADR-0012's reason; GPLv3 §13 and AGPLv3 §13 permit the combination with each part keeping its licence. Forks keep upstream licences. Silvaview-rs (the author's SequoiaView port, previously unlicensed) is relicensed AGPL-3.0-only so its pure squarify/colour/cushion modules can be lifted into crates/lege-treemap.
        """
    context """
        The Home Field work lifts code from Silvaview-rs; the author chose to put both projects under AGPL-3.0 rather than keep LegeOS on MPL-2.0 (ADR-0008) and relicense only the lifted modules. One strong copyleft also removes ADR-0012's asymmetry of one crate under a stronger licence than the crates it links.
        """
    consequences """
        cargo deny allows AGPL-3.0 for own code and MPL-2.0 for dependencies only; contributions accepted under AGPL-3.0-only, no CLA; network use must offer source (§13).
        """
    depends_on [ @legeos.decision.compositor-on-smithay ]
    implements [ @legeos.constraint.packaging-and-render-thread ]
    supersedes [ @legeos.decision.toolchain-licence-namespace ]
}

record legeos.decision.appearance-is-a-working-field-with-two-themes/1 : decision {
    title "Appearance: Home is a working field, not wallpaper; two themes (monotone, Temple) share one thin geometry; TempleOS is borrowed as a premise, not a palette"
    state proposed
    scope [
        path "apps/lege-settings/**",
        path "crates/lege-session-core/src/settings.rs",
        path "shell/lege-shell/src/surface/**"
    ]
    topic appearance
    decision """
        The shell offers two themes selected by a shell.appearance.theme setting, both built on the same structure: a light (or dark) ground that exists to carry information, wallpaper off by default; one-pixel rules and hairline borders instead of shadows, glass and cards, with padding measured in text lines; the information row as a single compact status line (clock, then only conditions that are true) in a semi-monospace face; typography (headings, rules, indentation) as the grouping device, borders reserved for containers (folders, trays, projects, window groups); objects useful where they are, the representation ladder reading as one document growing rather than a card opening a window. Monotone: a single accent hue and grey rules. Temple: a saturated cyan and a royal blue for structural lines, focus and links, with red, green, yellow and magenta only for semantic state; never the 16-colour VGA palette across the whole shell. Mechanically, surface/design.rs's constants become one of two token sets, including the window-group accent palette; the visual baseline renders once per theme. What LegeOS takes from TempleOS is the premise that the home screen is itself a working information environment rather than a backdrop for shortcuts, which is what the Home Field already is.
        """
    context """
        The user on 2026-09-03 said they lean towards a monotone theme as one option and a TempleOS theme as another, and shared an analysis of TempleOS's visual grammar (white working field, thin blue/cyan geometry, text as structure, embedded live objects, commands and GUI as peers, density without crudeness) with the recommendation to adopt it as a design language for the Home Field rather than as a skin. Renaming (labels and the product's name) is a separate later step.
        """
    consequences """
        Not implemented this pass. The window-group outline and tile edge use an accent that will be per-theme. Any new surface drawn now (group tiles, the search panel, the Files context menu) uses hairline edges and no shadows so it needs no redesign when the themes land. A work record follows when implementation is scheduled.
        """
    derived_from [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
}

record legeos.decision.base-ubuntu-2604-kernel-70/1 : decision {
    title "D1/ADR-0007 — Base is Ubuntu 26.04 LTS 'resolute' with Ubuntu's linux-generic 7.0; mainline 7.2 only as a transaction candidate"
    state active
    scope [ path "distro/**" ]
    decision """
        The base is Ubuntu 26.04 LTS ('resolute') declared once in distro/base.toml; the kernel is Ubuntu's linux-generic (7.0 GA, HWE later), version-locked with Canonical-signed prebuilt NVIDIA LRM modules (linux-modules-nvidia-<branch>-generic) and firmware by the legeos-kernel / legeos-nvidia-{open,proprietary} metapackages. Mainline 7.2 is never hand-installed; it is a candidate for lege-hostd's kernel/NVIDIA transaction path.
        """
    context """
        Ubuntu 26.04 = resolute, kernel 7.0 (renumbered 6.20). The planning docs advise against placing upstream 7.2 on a hybrid Intel/NVIDIA laptop that already saw driver conflicts; reproducible driver validation and rollback matter more than kernel recency.
        """
    consequences """
        One declarative base; NVIDIA via Ubuntu LRM (no DKMS, no .run installer); newer kernels only through the transactional path with the hardware matrix green.
        """
    implements [ @legeos.constraint.first-release-scope ]
}

record legeos.decision.boot-deploy-secure-boot/1 : decision {
    title "D5/ADR-0004 — Kernel/NVIDIA transactions on btrfs deployments with boot assessment and a system-scope health probe; bare metal boots through Canonical-signed shim + GRUB"
    state active
    scope [
        path "distro/deploy/**",
        path "distro/image/**",
        path "services/lege-boot-health/**",
        path "services/lege-hostd/src/deploy.rs"
    ]
    decision """
        Root is btrfs subvolumes from the first mkosi repart layout; a deployment is a read-only snapshot plus a hostd-owned ESP directory (/EFI/legeos/<id>/) holding kernel, initrd and entry, so kernel + NVIDIA modules + userspace roll back together and Ubuntu's initramfs hooks cannot rewrite the previous entry. Kernels stay Ubuntu-signed Type #1 entries (no self-built UKI). A candidate boots with a boot-assessment counter; lege-boot-health (SYSTEM scope, before boot-complete.target, TimeoutStartSec + FailureAction=reboot-force) gates promotion. A BootManager trait has two backends: systemd-boot (bless-boot) and grub (GRUB_DEFAULT=saved + grub-reboot + hostd counter). RESOLVED 2026-09-03: the production bare-metal Secure Boot path for Developer Edition 0.1 is option (b), Canonical-signed shim → Canonical-signed GRUB → Ubuntu-signed kernel → Canonical-signed matching NVIDIA LRM, with hostd generating GRUB entries that carry legeos.deployment=<id> for the candidate and the known-good deployment. Dev/VM mkosi images keep systemd-boot with Secure Boot off. A LegeOS MOK (option a) is deferred until a self-built kernel exists; snapshot vs A/B for Stage 4 remains open.
        """
    context """
        Ubuntu 26.04 ships systemd-boot but no Canonical-signed variant, so shim will not chain to it under Secure Boot without a MOK; a boot entry alone does not roll back NVIDIA userspace on a shared root. Option (b) gives real Secure Boot with no LegeOS signing infrastructure, which matches the first-release scope constraint and the Developer Edition 0.1 campaign's scope locks (docs/distroagentmidplan.md §2.3).
        """
    consequences """
        The docs' watchdog sequence reuses systemd primitives; the deployment layout is fixed early; GRUB entry generation with the deployment id is implementation work under @legeos.work.reference-machine-provisioning and closes @legeos.question.grub-entries-must-carry-the-deployment-id; the mkosi image and the provisioned laptop use different boot managers by design.
        """
    implements [
        @legeos.constraint.first-release-scope,
        @legeos.constraint.identity-and-launch-safety
    ]
}

record legeos.decision.btrfs-delta-is-an-opt-in-catch-up-backend-not-the-default/1 : decision {
    title "The Btrfs metadata delta is the default catch-up for a downtime repair where the root is on btrfs and a checkpoint survives"
    state active
    scope [
        path "crates/lege-file-index/src/btrfs_delta.rs",
        path "distro/policy/polkit/org.legeos.host.policy",
        path "interfaces/dbus/org.legeos.Host.IndexCheckpoint1.xml",
        path "services/lege-filed/src/delta_catchup.rs",
        path "services/lege-hostd/src/index_checkpoint.rs"
    ]
    topic index-catch-up-backend
    decision """
        `btrfs send --no-data` between two read-only `@home` checkpoints is the catch-up source for a **downtime repair** when the root's mount is btrfs and lege-filed still holds the checkpoint it left behind. Every other trigger — overflow, rename ambiguity, a policy change, a mount returning — reconciles as before: those are about what the index *believes*, not about a window of missed time, and replaying a difference does not fix them.

        The three things the earlier revision held the default back for have landed. (1) Transport: `org.legeos.Host.IndexCheckpoint1.DeltaOpen(request_json s) -> (stream h, delta_json s)` — hostd writes the stream, opens it and unlinks it before returning, so the bytes reach exactly one caller and no path survives the call. Additive, so the frozen-signature rule is satisfied by re-freezing `interfaces/baseline.json`; the pattern is the one `Files.Index1.OpenSnapshot` already uses, and only the bus is new. (2) Disk cost: `Checkpoint.exclusive_bytes` from `btrfs filesystem du -s --raw`, serde-defaulted so the List JSON grows without a signature change, and `scripts/btrfs-index-fixture.sh measure` prints it with `filesystem usage` either side of the discard. (3) Cap: `DELTA_CAP_BYTES = 16 MiB` (`LEGE_FILED_DELTA_CAP_BYTES`), about 40,000 paths at the measured ~420 B/path — past which the measurements stop favouring the delta anyway, and the newer checkpoint is retained as the next baseline because the reconcile that follows brings the index current.

        Polkit `org.legeos.host.index-checkpoint` moves to `allow_active=yes`, and it is the only action here that does: the caller is a daemon in the user's own session with no polkit agent, so nothing would ever answer a prompt and the repair would silently never happen. What is authorised is bounded to match — a read-only snapshot of the user's own `@home`, a metadata-only send, and a discard by an id that must be one safe path segment.

        Every precondition that can fail is a `None` and a reconcile: not btrfs, no baseline yet, the baseline gone, the daemon unreachable, the stream over the cap, the decode or the apply failed. The recursive path is never removed, only skipped. On the ext4 development host every call returns `None` at the first check.
        """
    context """
        The measurements were never the thing holding this back — `btrfs send --no-data` is flat within 4 ms across a hundredfold tree and about 24 µs per changed path, against a no-op reconcile of a 153,327-entry tree at 3.24 s that scales with the tree (@legeos.observation.delta-catch-up-cost-tracks-the-change-and-beats-a-crawl-except-on-bulk-creation, @legeos.observation.reconciliation-cost-tracks-tree-size-not-change-size), and the correctness gate passes field for field (@legeos.evidence.btrfs-delta-correctness-gate-passes). What held it back was three missing mechanisms, now built and unit-tested without needing btrfs, root or a system bus (@legeos.evidence.btrfs-delta-transport-and-backend-20260907).

        What has still never happened is a run on a real Btrfs root, a real `@home`, or across a reboot: everything measured so far is a loopback image on an ext4 host, up to 153k entries. That is why this revision is the default *for one trigger* rather than a general adoption, why every doubt falls back, and why the fixture gate stays a user gate in `RUNBOOK-L3.md`.

        One case is deliberately not taken: a directory that arrives from outside the indexed region is a single `Upsert`, because the stream names the directory and not the children that came with it. Rather than apply the delta and leave the subtree missing while the root claims to be current, that repair walks — which is also the one scenario the measurements liked least (the build-shaped burst, where a crawl won outright).
        """
    consequences """
        A downtime repair on a btrfs `@home` costs what the change costs rather than what the tree costs, which on the reference machine's home is the difference between seconds and tens of seconds every time the daemon restarts. In exchange the system holds one read-only snapshot per subvolume between repairs, and a read-only snapshot pins every extent it references — user-visible as space that is not returned while the index is dormant. `Checkpoint.exclusive_bytes` is how much, and `Discard` is when it comes back; the number itself is NOT EXECUTED until the fixture is run.

        `lege-filed` gains a dependency on `lege-client` and reaches the system bus through `Handle::block_on` from the watcher's own thread — the route `lege_client::SyncSnapshotSource` already takes, so zbus's blocking API stays off. The ext4 development host and every nested session take the unchanged reconcile branch, so nothing about day-to-day work changes.
        """
    supported_by [
        @legeos.evidence.btrfs-delta-correctness-gate-passes,
        @legeos.evidence.btrfs-delta-transport-and-backend-20260907,
        @legeos.observation.btrfs-send-needs-privilege-but-snapshotting-does-not,
        @legeos.observation.delta-catch-up-cost-tracks-the-change-and-beats-a-crawl-except-on-bulk-creation,
        @legeos.observation.reconciliation-cost-tracks-tree-size-not-change-size
    ]
}

record legeos.decision.build-set-id-is-the-version-authority/1 : decision {
    title "The BuildSetId is the one version authority; debian/changelog is generated from it"
    state active
    scope [
        path "crates/lege-build/**",
        path "debian/**",
        path "distro/apt/**",
        path "tools/xtask/**"
    ]
    topic package-version-authority
    decision """
        The BuildSetId (<workspace version>~dev<epoch>+g<sha7>[.dirty], computed by cargo xtask build-set from Cargo.toml and git) is the single version authority for every shipped LegeOS package. cargo-deb receives it as --deb-version, and the debian/changelog head entry consumed by the source build is generated from the same value at build time rather than maintained by hand. os-release, distro/base.toml and the mkosi ImageVersion carry the product version (0.1) and are not package versions.
        """
    context """
        The dev lane stamped packages with the BuildSetId while debian/changelog carried an independent hand-written 0.1.0~dev1, so a source build and a cargo-deb build could disagree (@legeos.question.package-version-authority-across-lanes). Chosen by the user on 2026-09-03 for the Developer Edition 0.1 campaign.
        """
    consequences """
        One value flows to build-set identity, archive manifests, runtime stamps and the source package. A public release archive later needs a release grammar without the ~dev suffix; that is a revision of this decision, not a second authority.
        """
    derived_from [ @legeos.decision.debian-packaging ]
    implements [ @legeos.constraint.packaging-and-render-thread ]
    resolves [ @legeos.question.package-version-authority-across-lanes ]
}

record legeos.decision.compositor-on-smithay/1 : decision {
    title "D12/ADR-0012 — lege-comp is built directly on Smithay, not forked from cosmic-comp; GPL-3.0-only is the one licence exception"
    state proposed
    scope [ path "compositor/**", path "distro/forks/**" ]
    decision """
        The compositor is written directly against Smithay 0.7 (MIT), with cosmic-comp read freely as a reference but no COSMIC crate in the dependency graph. It lives at compositor/lege-comp as a member of this workspace and is licensed GPL-3.0-only — the single licence exception in an otherwise MPL-2.0 repository, because cosmic-comp was read while writing it. cosmic-comp and cosmic-greeter are removed from distro/forks/manifest.toml; the greeter becomes lege-greeter over greetd's JSON IPC. The lock screen stays compositor-owned ext-session-lock-v1, which Smithay provides.
        """
    context """
        Planning doc 01 §3 recommended forking cosmic-comp and deleting its window manager, judging that path "more likely to produce a usable system". That judgement predates crates/lege-window. Six measurements reversed it. (1) The layer a fork would keep is saturated with libcosmic: shell/element/ is 8,446 lines of which 7,304 (86%) import cosmic::/iced, so "keep element/, drop libcosmic" is not a cut that exists. (2) shell/focus/ is literally split-out `impl Shell` and `impl Common` blocks and cannot be kept while the thing it is an impl of is deleted. (3) grabs/moving.rs calls straight into the code a fork would delete. (4) Of 92 commits in the last 12 months touching the delete-paths, 52 (57%) touched a keep-path in the same commit, so the fork boundary would not insulate us. (5) input/'s keybinding model is an external COSMIC type. (6) cosmic-comp is GPL-3.0-only with no or-later clause. Meanwhile the largest part of any compositor — cosmic-comp/src/shell/'s 32,636 lines of window-management policy — already exists as crates/lege-window: 2,730 lines with no async runtime and no D-Bus. Smithay 0.7 already implements server-side every protocol LegeOS's documents name, including ext-session-lock-v1 and ext-foreign-toplevel-list-v1, plus a complete XWayland window-manager role.
        """
    consequences """
        One licence exception to track: debian/copyright carries a Files: compositor/lege-comp/* stanza and deny.toml allows GPL-3.0-only. Not in Smithay and ours to write: wlr-output-management, real screencopy capture, config, D-Bus glue and our two private protocols. Smithay is pinned to a git rev rather than a release, shared with cosmic-comp, which is a useful signal it works on this hardware. The winit backend is the crate's testable path where there is no display hardware, which makes it load-bearing rather than a debug aid: the protocol set is therefore constructed in one place (LegeCompState::new) so both backends provably advertise the same thing.
        """
    source {
        kind internal
        role origin
        path "docs/adr/0012-compositor-on-smithay.md"
        use """
            The full decision record with all six measurements and the amendments it makes to ADRs 0005, 0008 and 0010.
            """
    }
}

record legeos.decision.debian-packaging/1 : decision {
    title "D9/ADR-0009 — Packaging: cargo-deb per binary now; one vendored source package (root debian/) for the archive; keyring + pins as legeos-archive-keyring"
    state active
    scope [
        path "debian/**",
        path "distro/apt/**",
        path "distro/metapackages/**",
        path "packaging/**"
    ]
    decision """
        Stage 1: every binary crate carries [package.metadata.deb]; `cargo deb -p <crate>` feeds a local aptly repo (never /usr/local). Stage 2: one source package `legeos` with debian/ at the repo root, vendor/ shipped in the orig tarball, dh_auto_build overridden with `cargo build --release --frozen --offline --workspace`; metapackages in legeos-meta; legeos-archive-keyring ships the archive key, deb822 legeos.sources and preferences.d pins rejecting third-party driver repositories. dh-cargo is not used.
        """
    context """
        dh-cargo expects Debian-packaged crates — impractical for zbus 5 / tokio 1.5x / smithay; vendoring is what COSMIC's own packaging does.
        """
    consequences """
        Packages from day one; the archive path is ready when the repository exists.
        """
    implements [ @legeos.constraint.packaging-and-render-thread ]
    supported_by [ @legeos.evidence.m0-deb-builds ]
}

record legeos.decision.event-driven-service-authorities/1 : decision {
    title "Local state has one authoritative owner with recoverable state-and-event delivery"
    state active
    scope [ path "crates/**", path "distro/**", path "interfaces/**", path "services/**" ]
    topic service-observation-and-activation
    decision """
        Each local state domain has one authoritative owner. Consumers read typed state, synchronize a subscription without a read/subscribe race, and recover missed history by sequence or by taking a fresh snapshot. A generation identifies a committed view; an event sequence identifies change-log position. SnapshotRequired means continuity is unavailable and the consumer must resnapshot. Consumers never read an owner's private SQLite representation. Services use event or threshold wakeups and socket/D-Bus activation where practical; timers remain explicit for temporal conditions, backoff, bounded active episodes and reconciliation.
        """
    context """
        Files.Index1 already provides sealed snapshots, ChangesSince(sequence), SnapshotRequired and freshness signals, and the filed watcher blocks with an explicit waker. resourced still samples and sleeps, so its conversion requires policy-preserving investigation rather than a blanket timer removal.
        """
    consequences """
        Keep explicit browsing and narrowly documented service-unavailable fallbacks. Do not introduce a universal event daemon, RAM-only index, competing background crawlers, or a rule that every service must exit when idle. Each persistent daemon and polling exception records its authority, lifetime, activation, recovery, deadline and justification.
        """
    supported_by [
        @legeos.evidence.service-inventory-and-pressure-wakeups-20260907,
        @legeos.observation.a-snapshot-did-not-say-which-change-position-it-was-consistent-with,
        @legeos.observation.lege-client-links-rusqlite-through-the-shared-index-types
    ]
    source {
        kind external
        role origin
        document "legacy-polling-services-design"
        start_byte 0
        end_byte 5464
        start_line 1
        end_line 209
        excerpt_hash "sha256:8ab3e8e61899cf6d46312a0fce8f2bce7ab4b666368cdcd706247b0927916371"
        use """
            Adopts domain ownership, typed consumer APIs and recoverable state plus events.
            """
    }
    source {
        kind external
        role origin
        document "legacy-polling-services-design"
        start_byte 5465
        end_byte 13221
        start_line 211
        end_line 630
        excerpt_hash "sha256:d252c4840e230bf05e755974dab4b08dbd259792f2e12a009cc17b0d4ad8cb5f"
        use """
            Adopts event-first activation and bounded polling exceptions while rejecting a universal daemon.
            """
    }
    source {
        kind external
        role origin
        document "legacy-polling-services-design"
        start_byte 13221
        end_byte 19332
        start_line 631
        end_line 808
        excerpt_hash "sha256:3bd5e48f86c3ffb33a98384e4c97db1f90fed26ad1a2b3f3c0ffcc441e0ea21a"
        use """
            Adopts audit metadata and one-owner policy with explicit exceptions.
            """
    }
}

record legeos.decision.flatpak-and-crash-handling/1 : decision {
    title "D11/ADR-0011 — Flatpak for sandboxed apps (no snapd in the seeds); telemetry-free crash handling via systemd-coredump ingested into history"
    state active
    scope [ path "distro/policy/coredump/**", path "distro/seeds/**" ]
    decision """
        Sandboxed applications come as Flatpak (the alias model carries Flatpak IDs); snapd is excluded from the seeds and legeos-desktop conflicts with it. Crash handling: systemd-coredump on, apport/whoopsie out; lege-sessiond ingests coredump journal entries (PID -> cgroup -> instance) into the event history so a crash is one explainable, restorable event.
        """
    context """
        Ubuntu forces the snap decision (Firefox/Thunderbird are snaps); the docs forbid 'a complete alternative application store' — Flatpak/Flathub is not that; the docs want notifications and system decisions as searchable history.
        """
    consequences """
        One sandbox format in the identity model; crashes are attributed to instances without any upload.
        """
    implements [
        @legeos.constraint.first-release-scope,
        @legeos.constraint.services-not-indicators
    ]
}

record legeos.decision.forks-by-manifest/1 : decision {
    title "D6/ADR-0005 — Upstream forks (cosmic-comp, cosmic-files, cosmic portal, cosmic-greeter, cosmic-applets) are pinned by distro/forks/manifest.toml, not git submodules"
    state superseded
    scope [ path "apps/lege-files/**", path "compositor/**", path "distro/forks/**" ]
    decision """
        Each fork lives in its own repository with an 'upstream' tracking branch and a 'legeos' patch branch; distro/forks/manifest.toml pins URL/branch/commit; `just forks-fetch` clones into the gitignored forks/ directory. compositor/lege-comp-integration is a path crate the compositor fork depends on; the files fork depends on lege-client. Patches are limited to the items enumerated in compositor/FORK.md and apps/lege-files/FORK.md.
        """
    context """
        The user's four separately maintained COSMIC submodules already caused rebase and detached-HEAD problems; Stage 2 wants proper downstream repos with automated rebase checks.
        """
    consequences """
        No submodule state in this repository; reproducible builds from the manifest; monthly rebase cadence.
        """
    implements [
        @legeos.constraint.first-release-scope,
        @legeos.constraint.packaging-and-render-thread
    ]
}

record legeos.decision.forks-by-manifest/2 : decision {
    title "D6/ADR-0005 — Upstream forks (cosmic-files, cosmic portal, cosmic-applets) are pinned by distro/forks/manifest.toml, not git submodules"
    state superseded
    scope [ path "apps/lege-files/**", path "distro/forks/**" ]
    decision """
        Each fork lives in its own repository with an 'upstream' tracking branch and a 'legeos' patch branch; distro/forks/manifest.toml pins URL/branch/commit; `just forks-fetch` clones into the gitignored forks/ directory. The files fork depends on lege-client. Patches are limited to the items enumerated in apps/lege-files/FORK.md.
        """
    context """
        The user's four separately maintained COSMIC submodules already caused rebase and detached-HEAD problems; Stage 2 wants proper downstream repos with automated rebase checks. The manifest model itself is unchanged by ADR-0012 — what changed is its membership: cosmic-comp and cosmic-greeter are no longer forks at all, so compositor/** leaves this record's scope. One of the six measurements behind that decision was specifically about this model's limits: of 92 cosmic-comp commits in the last 12 months touching the paths a fork would delete, 52 touched a kept path in the same commit, so the fork boundary would not have insulated us and the monthly rebase cadence below would have landed in deleted code constantly.
        """
    consequences """
        No submodule state in this repository; reproducible builds from the manifest; monthly rebase cadence for the forks that remain. The compositor is now first-party (compositor/lege-comp) and carries no rebase burden; compositor/lege-comp-integration is an ordinary workspace crate rather than a path crate a fork depends on.
        """
    depends_on [ @legeos.decision.compositor-on-smithay ]
    implements [
        @legeos.constraint.first-release-scope,
        @legeos.constraint.packaging-and-render-thread
    ]
    supersedes [ @legeos.decision.forks-by-manifest/1 ]
}

record legeos.decision.forks-by-manifest/3 : decision {
    title "D6/ADR-0005 — External compatibility components are pinned forks; lege-files is a first-party service client"
    state active
    scope [ path "apps/lege-files/**", path "distro/forks/**" ]
    decision """
        Each remaining external fork lives in its own repository with an 'upstream' tracking branch and a 'legeos' patch branch; distro/forks/manifest.toml pins URL/branch/commit and `just forks-fetch` clones it into the gitignored forks/ directory. The standalone `lege-files` manager is instead a first-party Pixelkit application in this workspace: it depends on lege-client, owns no filesystem policy, and delegates browse, volume, operation, recents, search, path-action, association and launch decisions to the corresponding LegeOS services. This correction is required because the declared legeos/cosmic-files fork was never materialized and its configured remote does not exist; keeping the client local also makes the installable manager and its exact service contracts testable in the main workspace.
        """
    context """
        The user's four separately maintained COSMIC submodules already caused rebase and detached-HEAD problems; Stage 2 wants proper downstream repos with automated rebase checks. The manifest model itself is unchanged by ADR-0012 — what changed is its membership: cosmic-comp and cosmic-greeter are no longer forks at all, so compositor/** leaves this record's scope. One of the six measurements behind that decision was specifically about this model's limits: of 92 cosmic-comp commits in the last 12 months touching the paths a fork would delete, 52 touched a kept path in the same commit, so the fork boundary would not have insulated us and the monthly rebase cadence below would have landed in deleted code constantly.
        """
    consequences """
        No submodule state in this repository; reproducible builds from the manifest; monthly rebase cadence for the forks that remain. The compositor is now first-party (compositor/lege-comp) and carries no rebase burden; compositor/lege-comp-integration is an ordinary workspace crate rather than a path crate a fork depends on.
        """
    depends_on [ @legeos.decision.compositor-on-smithay ]
    implements [
        @legeos.constraint.first-release-scope,
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    supersedes [ @legeos.decision.forks-by-manifest/2 ]
    acknowledged true
}

record legeos.decision.home-field-default-leaves-slack/1 : decision {
    title "The Home Field's default leaves slack: floors below preferred sizes, and a drawer block bounded by a share of the width"
    state proposed
    scope [ path "crates/lege-field/**", path "shell/lege-shell/**" ]
    topic density
    decision """
        The default Home Field leaves slack rather than packing every tile at its floor. Drawer tiles take a 1x1 floor beneath their 2x2 preferred size and system tiles a 2x1 floor beneath their 3x2, so a resize has neighbours that can yield. The drawer block's shape is derived from the field's height instead of being fixed at two columns, and falls back to 1x1 shortcuts when a 2x2 block would claim more than a third of the field's width. All eight drawers stay on the field: the slack comes from lower floors, not from a shorter list.
        """
    context """
        Asked as @legeos.question.home-field-default-density and left to the user: with floor and preferred both at 2x2 every neighbour of a resize was already at minimum, the clamp-rather-than-evict rule reduced every grow request to nothing, and the widget foundations' headline gesture did nothing visible on the default layout.

        Adding notifications as a third system widget settled it by making the old density unsatisfiable. Three system tiles at the 3x2 class floor plus eight drawers at 2x2 leave a 1200x800 field with no arrangement that both places the launcher and keeps every open window visible, and the project treats each of those as a defect: a window that is not on Home cannot be reached, and the launcher is the only route to an application with no window yet.
        """
    consequences """
        The resize gesture does something visible on a field nobody has rearranged yet. A busy field degrades by compacting its furniture instead of failing to place it, so the launcher is always present even when every cell is spoken for. A roomy field looks as it did: 2x2 drawers still fit the width share at 1080p and above, and only a short or narrow field sees the 1x1 rail.

        The cost is that the default field is less information-dense than the drawers-at-2x2 arrangement on small screens, and that tile sizes now vary with the field's shape, which makes the layout harder to describe in a fixed diagram. The levers are DRAWER_WIDTH_SHARE and the two SpanRange floors in shell/lege-shell/src/field_model.rs.
        """
    derived_from [ @legeos.work.home-widget-foundations ]
    resolves [ @legeos.question.home-field-default-density ]
    supported_by [ @legeos.evidence.home-field-density-and-composition-20260830 ]
}

record legeos.decision.home-field-stable-bounded-semantic-grammar/1 : decision {
    title "Home uses stable bounded rectangles, local reflow and explicit reversible semantics"
    state proposed
    scope [ path "apps/lege-files/**", path "crates/lege-field/**", path "shell/lege-shell/**" ]
    topic home-field-layout-and-interaction-grammar
    decision """
        Home is a bounded field of stable rectangular objects. Moving or resizing one object triggers deterministic local reflow around the user's chosen anchor; content changes never move tiles, global repacking never destroys spatial memory, proximity never creates hidden relations, and Home does not become an infinite canvas or a set of disguised virtual desktops. A shape-and-area representation ladder controls information density while identity remains visible. Treemap layout belongs inside storage views, not across Home.
        """
    context """
        The explicit semantic grammar is type-directed: file and folder references enter containers without moving the underlying item; app-on-app creates an explicit app group; project, window and widget relations are created only by named operations. Throwing, previews and richer widget execution remain staged features.
        """
    consequences """
        Every destructive-looking gesture previews the outcome and offers undo or a keyboard-accessible equivalent. Preserve non-destructive references, containment, minimum usable sizes, stable type identity and bounded resource use. Reject arbitrary miniature full applications, ballistic deletion, content-driven reflow and proximity semantics. 'Content-driven' means index and content events (a folder gaining files, a drive gaining space, a widget refreshing): those never move, size, add or remove a tile. The user's own aggregated actions on a path (opening it, launching into it, editing under it, returning to it) are not content: under @legeos.decision.homegarden-activity-grown-places they may add, grow, shrink or remove a garden-owned Folder tile at a tending moment, never move one, and never touch a tile the user placed, moved, resized or pinned. (Revised 2026-09-08.)
        """
    derived_from [
        @legeos.decision.home-is-momentary-and-placeable-objects-are-containers/1,
        @legeos.decision.representation-ladder-is-the-organizing-principle/1
    ]
    source {
        kind external
        role origin
        document "legacy-homefield-design"
        start_byte 0
        end_byte 23844
        start_line 1
        end_line 435
        excerpt_hash "sha256:bd9b38bbb6a9c8c0a12d208b9ae09c6e2206c068326ad39d5fbd7ac6a0025460"
        use """
            Consolidates Home's working-memory model, representation ladder, geometry, semantic drops, non-destructive operations and guardrails.
            """
    }
}

record legeos.decision.home-is-momentary-and-placeable-objects-are-containers/1 : decision {
    title "Home is momentary chrome; folders, shortcut panes and widgets are placeable, loose files are not"
    state active
    scope [
        path "apps/lege-files/**",
        path "compositor/lege-comp/**",
        path "crates/lege-field/**",
        path "shell/lege-shell/**"
    ]
    decision """
        Home remains a taskbar-free surface rather than persistent desktop chrome. A short bare-Super press toggles or latches Home; pressing Super reveals Home immediately, holding it keeps Home visible, and releasing after a hold returns to the prior application view. Super chords remain accelerators and must not accidentally latch Home. Configurable Home panels, rails or docks exist only on Home and reserve no work area while an application is visible, so one application can occupy the entire output with nothing else shown.

        The directly placeable Home objects are folders, composite shortcut panes/trays, widgets, projects and live/parked application sessions. An individual file is never a loose Home tile. Files remain immediately visible, selectable, previewable and actionable inside a folder or shortcut pane. A shortcut pane may reference files and folders from several directory locations without moving them; adding a file to such a pane adds a reference. The user's Desktop directory is represented by a default folder/shortcut pane on the larger Home surface rather than recreated as scattered desktop icons.

        Object kind remains encoded inside a stable rectangular tile. Light colour, tint and optional material texture (for example glass-, stone- or paper-like treatments) may distinguish folders, shortcut panes, widgets and sessions, but geometry and interaction do not depend on decoration and themes own the exact material palette. Existing serialized loose-file tile data must migrate or remain readable, while new UI paths stop creating it.
        """
    derived_from [
        @legeos.assessment.home-field-usability-gaps-20260831,
        @legeos.work.home-field
    ]
    implements [ @legeos.constraint.services-not-indicators ]
}

record legeos.decision.home-projects-and-tool-actions/1 : decision {
    title "Home stores project intent; the FileManager provider opens folders; the taskbar selects running windows"
    state active
    scope [
        path "apps/lege-files/**",
        path "crates/lege-field/**",
        path "interfaces/dbus/org.legeos.Projects1.xml",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    topic home-project-and-window-responsibilities
    decision """
        Home is bounded persistent working memory for stable folders, collections, projects, widgets and explicit project/session relationships. Opening a folder launches whichever application holds the FileManager provider role at that folder (pcmanfm-qt by default since 2026-09-07, @legeos.decision.pcmanfm-qt-is-the-file-manager). The persistent bottom bar owns ordinary automatic per-window selection; automatic parked-window shelves migrate without losing explicit group, park or restoration relationships. Enter Project selects context and launches nothing, Launch Tool opens a provider-resolved role at the real project root, and Restore Workspace restores remembered applications and supported checkpoints.
        """
    context """
        The filed service boundary (Browse1, Operations1, Trash1, Actions1) remains authoritative for LegeOS's own surfaces; direct mutation that bypasses LegeOS operation semantics from Home is rejected. The original 2026-09-07 draft named native lege-files as the folder window and rejected PCManFM-Qt; the user reversed that the same day on the installed session ("Files is too rudimentary to be used for now"), so the folder-window sentence now names the provider role rather than an application. Apps remains the remembered session application set; Terminal, FileManager and CodeEditor are derived provider roles rather than copied paths in every manifest.
        """
    consequences """
        Projects1.Create receives the selected directory's real root; creation and pinning to Home stay distinct. Keep Apps launcher search separate from scoped Files search. Status updates never move tiles. Repository discovery never runs commands or hooks; build, test, run and repository status remain opt-in service work.
        """
    derived_from [
        @legeos.decision.forks-by-manifest/3,
        @legeos.decision.home-is-momentary-and-placeable-objects-are-containers/1,
        @legeos.decision.one-persistent-bottom-bar-tags-not-bands/1
    ]
    supported_by [
        @legeos.evidence.campaign2-merged-gate-20260907/1,
        @legeos.evidence.pcmanfm-qt-under-lege-comp-20260907/1
    ]
    source {
        kind external
        role origin
        document "legacy-files-design"
        start_byte 6138
        end_byte 12841
        start_line 230
        end_line 569
        excerpt_hash "sha256:8166a9bd403dbc1804e5954cf8eaeab83d401db8866f8ae594642801caf6a5aa"
        use """
            Adopts the Home, taskbar, Files and project-action responsibility split while rejecting the proposed default-client replacement.
            """
    }
    source {
        kind external
        role origin
        document "legacy-homefield-design"
        start_byte 0
        end_byte 24693
        start_line 1
        end_line 460
        excerpt_hash "sha256:895c5836e81e64d1ba1b59f65c46832a7847762b52c549f01964a57465176220"
        use """
            Retains bounded stable geometry, local reflow, representation ladders, non-destructive references and reversible operations.
            """
    }
}

record legeos.decision.home-surface-visible-unless-covered/1 : decision {
    title "The Home surface is visible unless a fullscreen or maximized window covers its output"
    state active
    scope [ path "compositor/**", path "crates/lege-window/**" ]
    topic home-visibility
    decision """
        `Layer::HomeSurface` is the bottom layer and is visible by default. `WindowService::is_visible` hides it only when a visible, unshelved client window (`Layer::Normal`/`Layer::AppOnTop`) that is `fullscreen` or `maximized` resolves to the same output as Home (`WindowService::home_is_covered`, using `geometry::choose_target_output` on both rectangles, because a `WindowRecord` carries no output); a `reveal_home` reveal shows Home regardless and keeps hiding client windows exactly as before.
        """
    context """
        On 2026-09-07 the installed session logged in to a black screen: `is_visible` returned `home_revealed` for `Layer::HomeSurface`, a fresh login has no reveal, so `space_sync` unmapped the Home surface from `Space` and the user had to press Super to see a desktop at all. The user's rule, verbatim: "i only want it to hide when there is a full screen window".
        """
    consequences """
        A translucent client window now blends with the Home Field rather than with the clear colour — the previous rule existed for that reason and this decision overrides it. Home is mapped in `Space` whenever nothing covers it, so it takes pointer input on the empty desktop; it is the bottom of `stacking_order`, so a click over any window still reaches that window. A maximized window on a second output no longer blanks the first output's Home. No compositor code changed: `sync_after_change` already runs on every map, maximize, fullscreen, shelve, destroy and output-topology route.
        """
    supported_by [
        @legeos.evidence.campaign2-merged-gate-20260907/1,
        @legeos.evidence.nested-home-visibility-and-screenshot/1
    ]
}

record legeos.decision.homegarden-activity-grown-places/1 : decision {
    title "Homegarden: Home is a field of Places grown from the user's own actions, aged in session time, positioned by memory"
    state active
    scope [
        path "crates/lege-field/**",
        path "crates/lege-session-core/**",
        path "interfaces/dbus/org.legeos.HomeGarden1.xml",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    topic homegarden
    decision """
        Home deals with the user's stuff; the bar deals with the machine. Directories appear on Home as Folder tiles (Places) because the user opened, launched into, edited under or returned to them; they grow when activity concentrates there, hold their place while used, shrink and finally leave when neglected, and regrow where they were. A tile may change size, appear or disappear because of the user's aggregated actions on its path; it may never change position because of them; and it may never move, shrink or displace a tile the user placed, moved, resized or pinned. Tending happens only at tending moments (Home reveal, session start, an explicit garden.tend) and never while the user is looking. The tender emits Place, Resize and Remove only, every op with a reason, applied as one undoable batch. Time is Garden time: sessions counted and unlocked-session runtime accumulated at session start/unlock/lock/sleep/logout edges, never wall-clock; a machine that is off ages nothing. Relevance is evidence x recency-in-garden-time x breadth: a place used across several sessions with several roles outranks one burst of saves; machine churn (build output, caches, hidden dirs) never counts. Content changes may alter what an already-earned Place shows but never create one. Every visual variable has one job: shape = mode, material = identity, colour = state, size = relevance, position = memory. No context is ever turned into a Project by the system; no group is ever inferred.
        """
    context """
        docs/garden/garden.md (the user's correction: no assumed main project, no fabricated first boot, no widgets that could be menus, closer integration with the file system, an organic system that notices where you work and tends it), docs/garden/homegarden-activity-grown-home.md (the model), docs/garden/garden2.md (session time instead of days, growth forms, branches vs blooms). @legeos.assessment.home-vision-review-20260905 left the mostly-empty cold Home unresolved; this is the answer: the emptiness is read, not filled.
        """
    consequences """
        Revises the consequences of @legeos.decision.home-field-stable-bounded-semantic-grammar: 'content-driven' means index/content events; user-action-driven size change at tending moments is admitted. Supersedes the 'repack on activity' clause of @legeos.work.home-developer-setup-preview with 'resize in place at tending moments'. Phases 0-3 (ledger, Garden Clock, planner, tending at reveal, rung-aware Folder tile with roles row and branch body) are built first; growth forms/facets, blooms, material identity, sibling groups and a Wide-vs-Tall geometry axis are deferred until Phase 4 (a day's hands-on) judges the model. Wall-clock never appears in the garden's ageing; the Garden Clock needs session edges from Lifecycle1.
        """
    derived_from [
        @legeos.decision.home-field-stable-bounded-semantic-grammar,
        @legeos.decision.home-is-momentary-and-placeable-objects-are-containers,
        @legeos.decision.representation-ladder-is-the-organizing-principle
    ]
    implements [ @legeos.constraint.services-not-indicators ]
    supported_by [ @legeos.evidence.homegarden-phases-0-3-tests-20260908/1 ]
    source {
        kind external
        role origin
        document "garden-design-conversation-20260907"
        use """
            the philosophy: activity earns space, roles not applications, zero-polling decay, spatial persistence, three visibility states
            """
    }
    source {
        kind external
        role rationale
        document "garden2-growth-forms-and-session-time-20260907"
        use """
            session time replaces days; shape/material/colour/size/position each have one job; branches vs blooms
            """
    }
    source {
        kind internal
        role origin
        document "homegarden-plan-20260907"
        use """
            the model, the ledger, the planner rules and the phases
            """
    }
}

record legeos.decision.independent-storage-roles/1 : decision {
    title "Provisioning declares independent storage roles and per-partition preservation policy"
    state active
    scope [
        path "distro/deploy/**",
        path "installer/**",
        path "services/lege-filed/**",
        path "services/lege-sessiond/**"
    ]
    topic developer-edition-storage-layout
    decision """
        One versioned layout contract describes device and filesystem identity, mount and subvolume roles, per-partition create/reuse/format policy, boot and deployment identity, recovery ownership, search visibility, acquisition coverage and accounting policy. Discovery and preparation are separate from deployment but use the same backend operation model. Dry-run and apply consume the same reviewed operation sequence, and apply revalidates topology, identity and mounted state immediately before mutation.
        """
    context """
        The current existing-partition mode preserves the partition table but rewrites GPT type codes and formats both ESP and root. It is not preservation. The current root=LABEL=legeos-root boot contract also makes identity migration a coordinated provisioner, fstab, boot-entry and rollback change.
        """
    consequences """
        Keep image, erase-disk, free-tail and existing-partition modes, adding explicit preservation semantics. No type-code rewrite or formatting occurs in preservation mode unless selected. A second data filesystem is optional and never assumed expendable. Preserve current OS subvolumes; stage optional @build and independent project/data/media/archive roles. Search, acquisition and accounting scopes are distinct; checkpoint activation remains opt-in and per filesystem.
        """
    derived_from [ @legeos.milestone.developer-edition-0-1/1 ]
    supported_by [
        @legeos.evidence.provisioning-plan-and-uuid-identity-20260907,
        @legeos.observation.the-provisioner-wrote-no-fstab-at-all
    ]
    source {
        kind external
        role origin
        document "legacy-filesystem-design"
        start_byte 0
        end_byte 9080
        start_line 1
        end_line 390
        excerpt_hash "sha256:2b0601ef86ceea0adac33267c9853a3d52ba789ffbe48153edd3928b285ae413"
        use """
            Adopts independent OS/data roles, explicit layout, preparation/deployment separation and reviewed destructive operations.
            """
    }
    source {
        kind external
        role origin
        document "legacy-filesystem-design"
        start_byte 10029
        end_byte 16246
        start_line 438
        end_line 671
        excerpt_hash "sha256:7cc1bb7ead4402d3b9b909ca51980507adbaaefeafef65e9665a6febedd71048"
        use """
            Adopts filesystem identity and search/accounting boundaries while deferring unmeasured optimization.
            """
    }
}

record legeos.decision.inotify-remains-the-index-event-backend/1 : decision {
    title "inotify stays the index's event backend; fanotify ships behind EventSource as a measured, unadopted alternative"
    state proposed
    scope [
        path "crates/lege-fanotify/**",
        path "crates/lege-file-index/src/watch.rs",
        path "services/lege-filed/**"
    ]
    topic index-event-backend
    decision """
        InotifySource remains the default and only wired event backend for the file index. crates/lege-fanotify ships a FanotifySource behind lege_file_index::watch::EventSource so the comparison can be re-run, but nothing in lege-filed constructs it and no service links it. The privileged FAN_MARK_FILESYSTEM route through lege-hostd is not built: no org.legeos.Host.* fd-passing surface is added, and lege-filed acquires no capability.
        """
    context """
        Recursive inotify cannot cover the reference machine — 189,089 directories after the index's skip policy against a 125,037 WatchBudget — so fanotify's FAN_MARK_FILESYSTEM, one mark per filesystem, was the obvious candidate. Two variants were measured against InotifySource on arm time, kernel and userspace memory, throughput, event fidelity, rename correctness, merging and queue overflow (@legeos.observation.unprivileged-fanotify-costs-more-per-directory-than-inotify), and the Btrfs question was answered from the kernel source with the neighbouring branch reproduced on this host (@legeos.observation.fanotify-cannot-span-btrfs-subvolumes). The unprivileged variant is one mark per directory for 6.4% more headroom, 2.5x the arm time and about twice the memory; the privileged variant returns EXDEV on every subvolume in distro/deploy/layout.toml, and a single group cannot even hold inode marks on two subvolumes.
        """
    consequences """
        The watch-count problem is not solved by changing backend. It is solved by watching fewer directories (coverage tiers) and by treating a dormant, unwatched root as an honest state rather than a failure, which is where the effort belongs. The open question about routing a privileged fd to the per-user daemon stays open for the Btrfs-delta backend but is moot for fanotify: a passed fd carries the events without the privilege to interpret them — open_by_handle_at is EPERM for lege-filed, so the receiving daemon still needs a per-directory handle-to-path map — and it would hand a per-user daemon a view of every file on the filesystem that polkit cannot narrow after the fact. If the kernel ever grants FAN_MARK_FILESYSTEM on a Btrfs subvolume, or LegeOS abandons subvolumes, revisit from docs/measurements/fanotify-2026-09-04.md rather than from scratch.
        """
    depends_on [ @legeos.observation.home-tree-exceeds-the-inotify-watch-budget ]
    supported_by [
        @legeos.evidence.fanotify-against-inotify-20260904,
        @legeos.observation.fanotify-cannot-span-btrfs-subvolumes,
        @legeos.observation.unprivileged-fanotify-costs-more-per-directory-than-inotify
    ]
}

record legeos.decision.live-iso-runs-the-provisioner/1 : decision {
    title "The installation medium is a LegeOS live ISO that runs the provisioner; mkosi stays the VM image"
    state proposed
    scope [ path "distro/iso/**", path "distro/seeds/**", path "installer/**" ]
    topic installation-medium
    decision """
        Developer Edition 0.1 installs from a UEFI-only live ISO built by distro/iso/build.sh: mmdebstrap from the seeds plus one build set, casper, Canonical's signed shim and removable-media GRUB copied out of the rootfs, xorriso. The live session is the LegeOS session; installing is running `legeos-install` (installer/provision.sh, shipped by legeos-cli) with --free-space or --esp/--root from a terminal, reading the plan, and adding --apply. The medium carries the build set at /legeos/devrepo, so installing needs no LegeOS network archive. mkosi remains the dev/VM disk image (ADR-0006) and is not the medium; live-build and ubuntu-image are not used because each would be a second package list.
        """
    context """
        The reference laptop has no disk to zap, a 100 MiB ESP and a 55.9 GiB free tail; a provisioner that runs from a working Linux userspace needs a medium that is not Lubuntu before Lubuntu can go. The seeds, the layout declaration and the provisioner already existed; only a way to boot them did not.
        """
    consequences """
        One package list drives the image, the metapackages and the medium. The live-only autologin and passwordless sudo exist only in distro/iso/live/customize.sh and are never packaged. A graphical installer remains a product decision for a release with users who did not build it. The Secure-Boot chain of the medium is proven by tests/integration/iso-qemu.sh under OVMF before any USB stick reaches the laptop.
        """
    depends_on [ @legeos.decision.boot-deploy-secure-boot, @legeos.decision.mkosi-images ]
    derived_from [
        @legeos.observation.this-machines-partition-table-cannot-hold-legeos-as-it-stands
    ]
}

record legeos.decision.mkosi-images/1 : decision {
    title "D7/ADR-0006 — mkosi builds the dev/CI/VM disk image (ESP + btrfs subvolumes); the installer ISO is a later stage"
    state active
    scope [ path "distro/image/**", path "distro/iso/**", path "distro/seeds/**" ]
    decision """
        distro/image/mkosi.conf: Distribution=ubuntu Release=resolute Repositories=main,universe,restricted Format=disk Bootable=yes Bootloader=systemd-boot UnifiedKernelImages=no ToolsTree=default, mkosi.repart/ with ESP + btrfs subvolumes, packages composed from distro/seeds/*.seed by compose.sh. mkosi has no ISO output; the installer ISO comes later via ubuntu-image classic or live-build from the same seeds.
        """
    context """
        Native Ubuntu support, UKI/signed systemd-boot options and systemd-repart give a straight path to snapshot/A-B deployments; the host currently lacks mkosi (apt install mkosi on 26.04).
        """
    consequences """
        One declarative image definition, `mkosi vm` for tests; image build itself is out of scope for M0.
        """
    implements [
        @legeos.constraint.first-release-scope,
        @legeos.constraint.packaging-and-render-thread
    ]
}

record legeos.decision.one-persistent-bottom-bar-tags-not-bands/1 : decision {
    title "One persistent shell-drawn bottom bar is the taskbar and holds the maximized window's controls; sized windows carry bottom tags, not a title band"
    state superseded
    scope [
        path "compositor/lege-comp/**",
        path "crates/lege-window/**",
        path "interfaces/wayland/**",
        path "shell/lege-shell/**"
    ]
    topic bottom-bar
    decision """
        A single shell-drawn bottom bar is always visible, over application windows and on Home, and reserves an Edge::Bottom exclusive zone. Bottom-left: network and clock indicators only. Middle: the taskbar, LegeOS window groups first (one entry each in the group accent), then one icon per open application (a single-window application is that window); hovering an entry after a dwell opens a second row above the bar listing its windows, a grace period closes it, a click activates. Bottom-right: minimize, maximize and close for the activated window when it is maximized. The compositor-drawn title band above every window is retired: a non-maximized window carries compositor-drawn tags on its bottom edge, a name tag bottom-left (title, group accent stripe; the grab-to-move and group-drop affordance) and contiguous control tags bottom-right; a maximized window on an output with a bottom exclusive zone draws no tags, and draws them again whenever no such zone is claimed, so controls never vanish when the shell is dead. The corner resize grip is removed; resize is the margin ring outside every edge and corner. None of this is configurable.
        """
    context """
        The user's hands-on runs showed a disconnect between Home and open windows: a mouse-only user had no persistent route between windows because Home is momentary and Alt+Tab is keyboard, and a window's controls sat at the top while the user's attention and the proposed taskbar sit at the bottom. The user first proposed moving the band to the bottom with a Windows 3.1 style window-list box, then replaced that with the shared bar: 'every open window shares the bar and the bar does double duty as a taskbar'. The hover-row behaviour is ported from cosmic-app-list (GPL-3, libcosmic); behaviour only, no code copied into this AGPL-3 repository.
        """
    consequences """
        Supersedes the clause of @legeos.decision.home-is-momentary-and-placeable-objects-are-containers that Home panels 'reserve no work area while an application is visible'; the rest of that decision (momentary Home, placeable containers, no loose files) stands. @legeos.work.home-panel-and-dock-layouts' check home-only-no-exclusive-zone is historical. Output::usable's refusal of a zone that leaves less than 96x32 remains the safety clause. compositor/COMPOSITOR.md's band sections are rewritten for tags. The exclusive zone is a floor on the surface's thickness so the hover row can grow the bar surface without reflowing windows (prose-only change to lege-shell-v1.xml).
        """
    derived_from [
        @legeos.decision.home-is-momentary-and-placeable-objects-are-containers,
        @legeos.decision.window-groups-are-explicit-and-compositor-owned
    ]
    implements [ @legeos.constraint.services-not-indicators ]
}

record legeos.decision.one-persistent-bottom-bar-tags-not-bands/2 : decision {
    title "One persistent shell-drawn bottom bar is the taskbar and holds the maximized window's controls; sized windows carry bottom tags, not a title band"
    state superseded
    scope [
        path "compositor/lege-comp/**",
        path "crates/lege-window/**",
        path "interfaces/wayland/**",
        path "shell/lege-shell/**"
    ]
    topic bottom-bar
    decision """
        A single shell-drawn bottom bar is always visible, over application windows and on Home, and reserves an Edge::Bottom exclusive zone. It is the output's full width: Home chip at the left (a pointer route to the Home Field, so a bare Super tap is not the only one), then the taskbar, then the machine cluster at the right end. Taskbar: LegeOS window groups first (one entry each in the group accent), then one entry per open application (a single-window application is that window), parked windows included and dimmed — Home places no tile for a running or parked window, so the bar is the only place one exists, and a click on a parked entry unshelves it before activating it. Hovering an entry after a dwell opens a second row above the bar listing its windows, a grace period closes it, a click activates. Machine cluster, right to left: an account chip, the clock, the network indicator and one readings chip (charge, and Muted when the machine is muted). The account chip opens a popover inside the bar surface holding Settings, the volume and brightness controls and the session actions (lock, suspend, log out, restart, shut down; the three that end the session take a second click), which is the only pointer route to them now that Home carries no Session or Settings widget. Bottom-right of all of it: park, maximize and close for the activated window when it is maximized. The compositor-drawn title band above every window is retired: a non-maximized window carries compositor-drawn tags on its bottom edge, a name tag bottom-left (title, group accent stripe; the grab-to-move and group-drop affordance) and contiguous control tags bottom-right; a maximized window on an output with a bottom exclusive zone draws no tags, and draws them again whenever no such zone is claimed, so controls never vanish when the shell is dead. The corner resize grip is removed; resize is the margin ring outside every edge and corner. A fullscreen window fills the whole output — Output::logical, over the bar's zone — and the compositor stacks it above the bar (WindowService::stacking_order's one exception to the fixed layer order: above ShellOverlay and Notification, never above SystemModal, Recovery or SecureLock); the bar surface stays mapped and keeps its zone, and a dwell on the output's bottom edge suspends the exception so the bar is drawn over the fullscreen window for as long as the pointer stays on the reserved strip. None of this is configurable.
        """
    context """
        The user's hands-on runs showed a disconnect between Home and open windows: a mouse-only user had no persistent route between windows because Home is momentary and Alt+Tab is keyboard, and a window's controls sat at the top while the user's attention and the proposed taskbar sit at the bottom. The user first proposed moving the band to the bottom with a Windows 3.1 style window-list box, then replaced that with the shared bar: 'every open window shares the bar and the bar does double duty as a taskbar'. The hover-row behaviour is ported from cosmic-app-list (GPL-3, libcosmic); behaviour only, no code copied into this AGPL-3 repository. The 2026-09-08 run added the rest: docs/garden/garden.md's division of labour — Home deals with your things, the bar deals with the machine — made the scattered Session/Settings/sound/battery widgets one cluster; 'full screen mode should be genuinely full screen with taskbar mouseover' and 'doing away with the Super button as only way to get to home screen' are the fullscreen, peek and Home-chip clauses.
        """
    consequences """
        Supersedes the clause of @legeos.decision.home-is-momentary-and-placeable-objects-are-containers that Home panels 'reserve no work area while an application is visible'; the rest of that decision (momentary Home, placeable containers, no loose files) stands. @legeos.work.home-panel-and-dock-layouts' check home-only-no-exclusive-zone is historical. Output::usable's refusal of a zone that leaves less than 96x32 remains the safety clause. compositor/COMPOSITOR.md's band sections are rewritten for tags, and its set_fullscreen row and its Home-visibility section carry the stacking exception and the peek. The exclusive zone is a floor on the surface's thickness so the hover row and the account popover can grow the bar surface without reflowing windows (prose-only change to lege-shell-v1.xml). Two earlier behaviours are retired: the bar no longer shrinks to its chips (a right-aligned cluster on a left-anchored surface is at the right of nothing), and the shell no longer destroys its own bar while a window is fullscreen (that released the zone and reflowed every maximized window on the output, twice). WindowRecord gains a fullscreen_restore slot of its own so maximize-then-fullscreen restores both; on_outputs_changed re-derives a fullscreen window's geometry and never repairs it, because is_recoverable measures a tag strip against usable() and a fullscreen window has no strip.
        """
    derived_from [
        @legeos.decision.home-is-momentary-and-placeable-objects-are-containers,
        @legeos.decision.window-groups-are-explicit-and-compositor-owned
    ]
    implements [ @legeos.constraint.services-not-indicators ]
    supersedes [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands/1 ]
}

record legeos.decision.one-persistent-bottom-bar-tags-not-bands/3 : decision {
    title "Window tags and shell controls; fullscreen hides the bar and window management is explicitly summoned"
    state superseded
    scope [
        path "compositor/lege-comp/**",
        path "crates/lege-window/**",
        path "interfaces/wayland/**",
        path "shell/lege-shell/**"
    ]
    topic bottom-bar
    decision """
        Outside a fullscreen presentation, a single shell-drawn bottom bar is visible over application windows and on Home, and reserves an Edge::Bottom exclusive zone. It is the output's full width: Home chip at the left (a pointer route to the Home Field, so a bare Super tap is not the only one), then the taskbar, then the machine cluster at the right end. Taskbar: LegeOS window groups first (one entry each in the group accent), then one entry per open application (a single-window application is that window), parked windows included and dimmed — Home places no tile for a running or parked window, so the bar is the only place one exists, and a click on a parked entry unshelves it before activating it. Hovering an entry after a dwell opens a second row above the bar listing its windows, a grace period closes it, a click activates. Machine cluster, right to left: an account chip, the clock, the network indicator and one readings chip (charge, and Muted when the machine is muted). The account chip opens a popover inside the bar surface holding Settings, the volume and brightness controls and the session actions (lock, suspend, log out, restart, shut down; the three that end the session take a second click), which is the only pointer route to them now that Home carries no Session or Settings widget. Bottom-right of all of it: park, maximize and close for the activated window when it is maximized. The compositor-drawn title band above every window is retired: a non-maximized window carries compositor-drawn tags on its bottom edge, a name tag bottom-left (title, group accent stripe; the grab-to-move and group-drop affordance) and contiguous control tags bottom-right; a maximized window on an output with a bottom exclusive zone draws no tags, and draws them again whenever no such zone is claimed, so controls never vanish when the shell is dead. The corner resize grip is removed; resize is the margin ring outside every edge and corner. The user's planning direction on 2026-09-08 replaces the fullscreen peek clause: while a fullscreen application is being presented on an output, the taskbar is not shown, including on hover, edge dwell, or pointer contact. It must not remain visibly composited underneath a translucent fullscreen client. Fullscreen occupies the complete logical output and preserves the preceding geometry and mode for restoration. Window management is to be an explicitly summoned popup using adapted cosmic-applets code; opening that manager does not reveal the bar. Ordinary window tags and their compact functional design language are retained. The detailed popup behavior, invocation defaults, non-fullscreen edge composition, and gradual redundancy removals are proposals under @legeos.work.window-manager-popup-and-functional-edge-tabs; this revision does not adopt those recommendations wholesale or authorize implementation.
        """
    context """
        The user's hands-on runs showed a disconnect between Home and open windows: a mouse-only user had no persistent route between windows because Home is momentary and Alt+Tab is keyboard, and a window's controls sat at the top while the user's attention and the proposed taskbar sit at the bottom. The user first proposed moving the band to the bottom with a Windows 3.1 style window-list box, then replaced that with the shared bar: 'every open window shares the bar and the bar does double duty as a taskbar'. The hover-row behaviour is ported from cosmic-app-list (GPL-3, libcosmic); behaviour only, no code copied into this AGPL-3 repository. The 2026-09-08 run added the rest: docs/garden/garden.md's division of labour — Home deals with your things, the bar deals with the machine — made the scattered Session/Settings/sound/battery widgets one cluster; 'full screen mode should be genuinely full screen with taskbar mouseover' and 'doing away with the Super button as only way to get to home screen' are the fullscreen, peek and Home-chip clauses.
        """
    consequences """
        Planning-only revision from the user's explicit request. The current implementation still contains bottom-edge peek and must not be represented as satisfying this new behavior. The old peek-on-hardware acceptance is retired by the successor work. Fullscreen visibility and popup stacking need distinct policies so invoking the manager cannot raise the machine cluster or other ordinary shell chrome.
        """
    derived_from [
        @legeos.decision.home-is-momentary-and-placeable-objects-are-containers,
        @legeos.decision.window-groups-are-explicit-and-compositor-owned
    ]
    implements [ @legeos.constraint.services-not-indicators ]
    supersedes [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands/2 ]
}

record legeos.decision.one-persistent-bottom-bar-tags-not-bands/4 : decision {
    title "Window tags and shell controls; fullscreen hides the bar and window management is explicitly summoned"
    state active
    scope [
        path "compositor/lege-comp/**",
        path "crates/lege-window/**",
        path "interfaces/wayland/**",
        path "shell/lege-shell/**"
    ]
    topic bottom-bar
    decision """
        Outside a fullscreen presentation, a single shell-drawn bottom bar is visible over application windows and on Home, and reserves an Edge::Bottom exclusive zone. It is the output's full width: Home chip at the left (a pointer route to the Home Field, so a bare Super tap is not the only one), then the taskbar, then the machine cluster at the right end. Taskbar: LegeOS window groups first (one entry each in the group accent), then one entry per open application (a single-window application is that window), parked windows included and dimmed — Home places no tile for a running or parked window, so the bar is the only place one exists, and a click on a parked entry unshelves it before activating it. Hovering an entry after a dwell opens a second row above the bar listing its windows, a grace period closes it, a click activates. Machine cluster, right to left: an account chip wearing the account's own name, the clock, the network indicator and a Settings chip. Every one of the four does one named thing on one click — the account chip opens its popover; the clock opens the installed calendar (`clock.open-calendar`); the network indicator opens whichever application fills the `network-status-ui` provider role, with `--popup`; the Settings chip opens Settings — and a chip whose thing is not installed is drawn dimmed and takes no click rather than looking live and doing nothing. There is no separate readings chip: charge, volume and backlight are the first line of the account popover, which also holds the volume and brightness controls and the session actions (lock, suspend, log out, restart, shut down; the three that end the session wear an ellipsis, take a second click, and read "Click again to log out" while armed). That popover is the only pointer route to the session and machine actions now that Home carries no Session widget; Settings has left it for a chip of its own, because an action offered in two places is one a person has to look for twice. Bottom-right of all of it: park, maximize and close for the activated window when it is maximized. The compositor-drawn title band above every window is retired: a non-maximized window carries compositor-drawn tags on its bottom edge, a name tag bottom-left (title, group accent stripe; the grab-to-move and group-drop affordance) and contiguous control tags bottom-right; a maximized window on an output with a bottom exclusive zone draws no tags, and draws them again whenever no such zone is claimed, so controls never vanish when the shell is dead. The corner resize grip is removed; resize is the margin ring outside every edge and corner. The user's planning direction on 2026-09-08 replaces the fullscreen peek clause: while a fullscreen application is being presented on an output, the taskbar is not shown, including on hover, edge dwell, or pointer contact. It must not remain visibly composited underneath a translucent fullscreen client. Fullscreen occupies the complete logical output and preserves the preceding geometry and mode for restoration. Window management is to be an explicitly summoned popup using adapted cosmic-applets code; opening that manager does not reveal the bar. Ordinary window tags and their compact functional design language are retained. The detailed popup behavior, invocation defaults, non-fullscreen edge composition, and gradual redundancy removals are proposals under @legeos.work.window-manager-popup-and-functional-edge-tabs; this revision does not adopt those recommendations wholesale or authorize implementation.
        """
    context """
        The user's hands-on runs showed a disconnect between Home and open windows: a mouse-only user had no persistent route between windows because Home is momentary and Alt+Tab is keyboard, and a window's controls sat at the top while the user's attention and the proposed taskbar sit at the bottom. The user first proposed moving the band to the bottom with a Windows 3.1 style window-list box, then replaced that with the shared bar: 'every open window shares the bar and the bar does double duty as a taskbar'. The hover-row behaviour is ported from cosmic-app-list (GPL-3, libcosmic); behaviour only, no code copied into this AGPL-3 repository. The 2026-09-08 run added the rest: docs/garden/garden.md's division of labour — Home deals with your things, the bar deals with the machine — made the scattered Session/Settings/sound/battery widgets one cluster; 'full screen mode should be genuinely full screen with taskbar mouseover' and 'doing away with the Super button as only way to get to home screen' are the fullscreen, peek and Home-chip clauses. The cluster composition changed again the same day, from the user's report on the installed session: 'the bottom right buttons arent clickable. network should open nm-tray-2. there should be no separate power/battery bar. need that space for a full OS settings button that opens into all settings areas. similarly date/time should open. and i dont know what the furthest bottom right button does and i dont want to click it in case it will log me out.' Two of the four chips had no click handler at all, the readings chip was a number nobody could go anywhere from, and the account chip was an unlabelled mark.
        """
    consequences """
        Planning-only revision from the user's explicit request. The current implementation still contains bottom-edge peek and must not be represented as satisfying this new behavior. The old peek-on-hardware acceptance is retired by the successor work. Fullscreen visibility and popup stacking need distinct policies so invoking the manager cannot raise the machine cluster or other ordinary shell chrome. The cluster clause is implemented by @legeos.work.bar-cluster-clickable-20260908. Its rule that a chip with nothing behind it is dimmed rather than inert-looking has a cost the composition has to carry: `gsimplecal` and `legeos-nm-tray` are now part of the desktop set, and on a machine without them two of the four chips are visibly unavailable. That is the intended failure mode, not a regression.
        """
    derived_from [
        @legeos.decision.home-is-momentary-and-placeable-objects-are-containers,
        @legeos.decision.window-groups-are-explicit-and-compositor-owned
    ]
    implements [ @legeos.constraint.services-not-indicators ]
    supersedes [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands/3 ]
}

record legeos.decision.one-privileged-host-daemon/1 : decision {
    title "D4/ADR-0003 — One privileged host daemon (lege-hostd): updates, deployments, driver authority, storage reserve, hardware profile; timezone policy stays in sessiond"
    state active
    scope [
        path "distro/policy/dbus/**",
        path "distro/policy/polkit/**",
        path "services/lege-hostd/**"
    ]
    decision """
        lege-hostd (system bus org.legeos.Host, one polkit policy org.legeos.host.*, AppArmor profile) hosts Updates, Deployments (BootManager trait), Drivers/GPU mode, Storage reserve and Hardware profile. It keeps an on-disk transaction journal and runs apt as a child transient unit. Timezone/location policy is NOT in hostd: it is network-facing and lives in lege-sessiond, setting the zone via polkit-gated org.freedesktop.timedate1.
        """
    context """
        The docs' updated, 'one driver authority', storage reserve and locationd are all root policy over apt/systemd; each as its own root daemon multiplies privileged surfaces; untrusted geolocation JSON must not be parsed as root.
        """
    consequences """
        Fewer privileged surfaces; one place for lege update, doctor support-violation checks and the hardware profile.
        """
    implements [
        @legeos.constraint.first-release-scope,
        @legeos.constraint.services-not-indicators
    ]
}

record legeos.decision.one-session-policy-daemon/1 : decision {
    title "D2/ADR-0001 — One user session policy daemon (lege-sessiond) hosting appd, associationd, providers, history, notifications, settings, projects, power, location as library crates"
    state active
    scope [
        path "crates/lege-appd/**",
        path "crates/lege-associationd/**",
        path "crates/lege-session-core/**",
        path "crates/lege-state/**",
        path "services/lege-sessiond/**"
    ]
    decision """
        lege-sessiond is the single user policy daemon (bus name org.legeos.Session). Application identity + launching (appd), the association broker (associationd), provider/autostart arbitration, history, notifications (org.freedesktop.Notifications when selected), typed settings, project sessions, power and timezone/location policy are separate library crates wired by a thin daemon over one SQLite state store (lege-state). Interfaces are domain-scoped and versioned (org.legeos.AppIdentity1, org.legeos.Associations1, ...) at separate object paths so a later split only relocates a bus name. Type=notify, Restart=on-failure, WatchdogSec; instances persisted and re-derived from systemd unit patterns after restart; history writes are non-fatal.
        """
    context """
        The planning docs propose several services and note associationd 'probably as part of appd'; the user's Lubuntu install suffers from many daemons/applets with private state and no shared identity key; cross-daemon D-Bus adds the launch-registration and governor-blocking races the docs flag.
        """
    consequences """
        One crash/restart unit and one place to explain decisions; cross-domain updates are transactions. filed and resourced remain separate processes. Crate boundaries keep the split reversible.
        """
    implements [
        @legeos.constraint.identity-and-launch-safety,
        @legeos.constraint.one-provider-per-role,
        @legeos.constraint.services-not-indicators
    ]
    supported_by [ @legeos.evidence.m0-check-interfaces, @legeos.evidence.m0-smoke ]
}

record legeos.decision.pcmanfm-qt-is-the-file-manager/1 : decision {
    title "pcmanfm-qt is the session's file manager; lege-files leaves the composition"
    state active
    scope [
        path "apps/lege-files/**",
        path "crates/lege-session-core/src/providers.rs",
        path "distro/app-manifests/**",
        path "distro/seeds/selection.toml",
        path "docs/architecture/files.md",
        path "shell/lege-shell/src/surface/app.rs"
    ]
    decision """
        The `file-manager` provider role and the desktop composition default to `pcmanfm-qt` (libfm-qt, Qt 6). `lege-files` stays a workspace member and a buildable `.deb` — it is the one real UI exercising `Browse1`, `Operations1`, `Previews1` and `Actions1` — but leaves `distro/seeds/selection.toml`, `legeos-desktop`, and the curated app manifests. `ProviderRole::FileManager` is derived from `Categories=FileManager` at priority 100 for the executable `pcmanfm-qt` and 50 otherwise, exactly as `Terminal` is derived from `TerminalEmulator` with kitty at 100; no shell code names an application any more. pcmanfm-qt must never be started with `--desktop`: Home is the desktop.
        """
    context """
        The user, on the installed session, verbatim: "i want to integrate pcman, not use the Files app. pcman can talk to Filed where at all possible. Files is too rudimentary to be used for now." `legeos.work.standalone-file-manager/3` built `lege-files` and completed; what it produced is a working service client, not a file manager somebody can live in. Shipping a rudimentary one as the session default is a worse answer than shipping a complete third-party one and integrating it.
        """
    consequences """
        Integration is limited to what libfm-qt offers from outside — there is no plugin API. Three routes exist and are taken: DES-EMA custom actions in `/usr/share/file-manager/actions/` shipped by `legeos-cli` ("Add to Home" over `HomeField1.PlaceFolder`, "Create project here" over `Projects1.Create`); a one-way bookmarks export from filed to `$XDG_CONFIG_HOME/gtk-3.0/bookmarks`, the file libfm-qt's Places sidebar reads, with filed the authority and no import; and Trash, which needs nothing — filed's `Trash1` already implements the freedesktop Trash specification on the same directories libfm-qt uses. Two routes do not exist and are recorded as such: pcmanfm-qt's recents (`recently-used.xbel`) are not read by `Files.Recents1`, and pcmanfm-qt's Find cannot ask `Files.Search1`. Qt 6 selects the Wayland platform plugin on its own from `WAYLAND_DISPLAY` with `qt6-wayland` installed, so the session sets no `QT_QPA_PLATFORM`; the compositor forces server-side xdg-decoration, so a pcmanfm-qt window wears LegeOS chrome.
        """
    derived_from [
        @legeos.decision.home-projects-and-tool-actions,
        @legeos.work.standalone-file-manager
    ]
    supported_by [
        @legeos.evidence.bar-ground-and-pcmanfm-role-20260907/1,
        @legeos.evidence.pcmanfm-qt-under-lege-comp-20260907/1
    ]
}

record legeos.decision.perimeter-resize-selects-two-axes-by-side-half/1 : decision {
    title "Perimeter resize selects one horizontal and one vertical edge from the contacted side half"
    state active
    scope [ path "compositor/lege-comp/**", path "crates/lege-window/**" ]
    topic window-perimeter-resize
    decision """
        Compositor-owned pointer resize uses the eight-logical-pixel exterior perimeter. Pressing either half of any side selects the adjacent corner's horizontal and vertical edge, with exact midpoints assigned to right or bottom. The selected pair and origin geometry latch at press; motion resizes from that origin, anchors the opposite edges, applies the existing minimum size, and never inverts the rectangle. Hover and the active gesture show the matching diagonal cursor, including on DRM, then restore client cursor ownership. Client-requested xdg resize edges retain their protocol meaning and bypass side-half reinterpretation.
        """
    context """
        The current implementation already removed the visible corner grip and owns an outside resize margin, but middle portions of a side still select one axis and DRM maps every named cursor to the arrow.
        """
    consequences """
        Remove RESIZE_CORNER only after its selection role is replaced. Preserve bottom tags, stacking precedence, maximized/fullscreen exclusions, keyboard/recovery paths and current size minima. Defer dead zones and motion-selected secondary edges until the fixed mapping is evaluated.

        As implemented: the halves are measured from the frame's own origin (frame.y + frame.height / 2, and the same on x), so a window at a negative coordinate splits at its own middle rather than at zero. RESIZE_CORNER is deleted; it had no consumer outside geometry.rs. The edges-to-cursor mapping is ResizeEdges::cursor, a method returning the cursor-spec name rather than a typed icon, because lege-window must stay free of cursor-icon (xtask deps-check) and the compositor parses the name back at the boundary. Single-axis resize remains reachable exactly where the protocol asks for it: xdg_toplevel.resize and the XWayland equivalent do not route through resize_edges_at. The DRM half of the cursor requirement is written but has never been seen on screen; that observation needs a logout and is a user gate.
        """
    derived_from [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands/1 ]
    supported_by [
        @legeos.evidence.perimeter-resize-latched-edges-20260907,
        @legeos.evidence.perimeter-two-axis-resize-geometry-20260907
    ]
    source {
        kind external
        role origin
        document "full-side-two-axis-window-resizing-first-draft"
        start_byte 2255
        end_byte 8357
        start_line 120
        end_line 380
        excerpt_hash "sha256:27664c9b1e98e16e29cea0649cbd0c8d6fbe7a36b6a5dbed52f0c5c67e053fb2"
        use """
            Adopts the deterministic side-half mapping, press-time latching and origin-relative resize invariants.
            """
    }
    source {
        kind external
        role constraint
        document "full-side-two-axis-window-resizing-first-draft"
        start_byte 19703
        end_byte 20514
        start_line 1020
        end_line 1081
        excerpt_hash "sha256:0d0b53428cc68c27fda25132296e370a662de64ae2f9f82a46f6909e7d1d6d08"
        use """
            Preserves the distinction between compositor pointer hit testing and client-requested resize edges.
            """
    }
}

record legeos.decision.representation-ladder-is-the-organizing-principle/1 : decision {
    title "One object, one canonical route, many sizes of representation — the ladder organizes the whole shell"
    state proposed
    scope [ path "apps/lege-files/**", path "crates/lege-field/**", path "shell/lege-shell/**" ]
    topic shell-design-language
    decision """
        The representation ladder (Micro → Small → Wide → Large → Full) is the organizing principle of the LegeOS interface, governed by three rules. One object, one canonical route, many sizes of representation: a semantic object is never simultaneously represented by proxies of itself (no Projects drawer beside project tiles, no auto App tile beside a session tile, no launcher tile beside the search field), and enlarging an object yields a bigger surface of the same object with location, selection and navigation state preserved — never a different UI. Minimize useless space, not empty space: permanent chrome, permanent destination tiles and duplicate search fields are useless space to be recovered; a margin of empty field is a drop/throw target and stays. Objects reveal capability as physical area becomes available: representation selection considers shape (cols, rows), not just cell count; Micro/Small representations are information-first with manipulation revealed on hover/focus, Wide and above carry a conventional heading. Visually, LegeOS uses calm rectangular instruments: neutral substrate, restrained boundaries, typography-led hierarchy, with accent colour communicating state rather than application branding, rich texture living inside objects, and expansion spatially continuous — a tile grows from its place and collapses back into it.
        """
    context """
        An external design review (2026-09-01) found the Home Field model substantially better than the visible interface and prescribed subtraction and consolidation rather than a new home-screen concept. Exploration verified its factual claims: eight default drawer tiles, a triple-nested expanded-drawer chrome (field breadcrumb → HomeSurfaceScreen rail+search → FileBrowserScreen sidebar+toolbar), cell-count-only representation selection, an unconditional 34px grab band, duplicated app/session tiles, and two search fields.
        """
    consequences """
        The default Home reduces to Work (projects, sessions, trays), one adaptive Files object, and a minimal set of system surfaces; the application catalogue lives behind the omnibox. HomeSurfaceScreen and the launcher tile are retired. Every expandable surface gets a persistent state model consumed by all rungs. Existing saved layouts migrate through add-only merge-time rewrites, never a version refusal.
        """
    derived_from [ @legeos.assessment.home-field-usability-gaps-20260831 ]
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    source {
        kind external
        role origin
        document "design-review-home-and-platform-20260901"
        use """
            The three governing rules, the redundancy inventory, and the calm-rectangular-instruments visual direction were adopted from the review after in-tree verification of its factual claims.
            """
    }
}

record legeos.decision.resourced-separate-process/1 : decision {
    title "D3/ADR-0002 — The resource governor (lege-resourced) is a separate, tiny, protected process that needs no D-Bus for emergency actions"
    state active
    scope [ path "crates/lege-types/src/unit.rs", path "services/lege-resourced/**" ]
    decision """
        lege-resourced runs as its own user process (org.legeos.Resources) with mlockall, MemoryLow, OOMScoreAdjust=-1000, high CPU/IO weight and no SQLite. Launch units are self-describing (app-legeos-<AppId>@<InstanceId>.service) so cgroup->instance identity is derived from /sys/fs/cgroup alone; foreground/visibility arrive as compositor signals; sessiond only enriches. Policy is a pure engine separated from cgroup writes and runs observe-only until recorded traces show sensible choices; then cache trim, throttling (memory.high + reclaim), checkpoint requests and whole-cgroup termination are enabled in stages.
        """
    context """
        The governor must keep ticking under exactly the conditions that stall a daemon doing SQLite/fsync/D-Bus/desktop-file imports (full disk in the storage-reserve case, a panic in an unrelated domain).
        """
    consequences """
        Two user daemons for policy instead of one; the governor is testable in isolation and survives sessiond restarts; lege doctor verifies its protection values.
        """
    implements [ @legeos.constraint.identity-and-launch-safety ]
    supported_by [ @legeos.evidence.m0-smoke, @legeos.evidence.m0-workspace-builds-and-tests ]
}

record legeos.decision.session-greeter-lock/1 : decision {
    title "D10/ADR-0010 — systemd-managed session (legeos-session.target), sessiond-arbitrated autostart, greetd + cosmic-greeter, compositor-owned lock screen"
    state superseded
    scope [ path "session/**" ]
    decision """
        The session is legeos-session.target plus user units with explicit protection values, started by the lege-session entry from wayland-sessions/legeos.desktop; xdg-desktop-autostart.target is masked and lege-sessiond launches approved autostart entries with identity and cgroups (one provider per exclusive role). Greeter: greetd + the cosmic-greeter fork (reuses the compositor). Lock screen: compositor-core ext-session-lock-v1.
        """
    context """
        A full distribution needs a display manager and a session manager; reusing the compositor for the greeter avoids a second toolkit stack; the docs demand permissioned autostart and one provider per role.
        """
    consequences """
        One session stack; lege doctor checks the units and their protection values.
        """
    implements [
        @legeos.constraint.one-provider-per-role,
        @legeos.constraint.services-not-indicators
    ]
    supported_by [ @legeos.evidence.m0-smoke ]
}

record legeos.decision.session-greeter-lock/2 : decision {
    title "D10/ADR-0010 — systemd-managed session (legeos-session.target), sessiond-arbitrated autostart, greetd + lege-greeter, compositor-owned lock screen"
    state active
    scope [ path "session/**" ]
    decision """
        The session is legeos-session.target plus user units with explicit protection values, started by the lege-session entry from wayland-sessions/legeos.desktop; xdg-desktop-autostart.target is masked and lege-sessiond launches approved autostart entries with identity and cgroups (one provider per exclusive role). Greeter: greetd + lege-greeter, our own, speaking greetd's JSON IPC over its socket so that greetd owns PAM and the greeter links no authentication code. Lock screen: compositor-core ext-session-lock-v1.
        """
    context """
        A full distribution needs a display manager and a session manager; the docs demand permissioned autostart and one provider per role. Revision 1 chose the cosmic-greeter fork on the reasoning that reusing the compositor avoids a second toolkit stack. ADR-0012 removed the compositor fork, which removed that reasoning with it: cosmic-greeter would have dragged libcosmic back into the dependency graph for the login screen alone, and the way to avoid a second toolkit stack is now for the greeter to use the same toolkit as the shell.
        """
    consequences """
        One session stack; lege doctor checks the units and their protection values, and now also that every unit's ExecStart binary is actually installed. The greeter is ours to maintain, but it links no PAM, no shadow and nothing setuid — authentication stays entirely inside greetd.
        """
    depends_on [ @legeos.decision.compositor-on-smithay ]
    implements [
        @legeos.constraint.one-provider-per-role,
        @legeos.constraint.services-not-indicators
    ]
    supersedes [ @legeos.decision.session-greeter-lock/1 ]
    supported_by [ @legeos.evidence.m0-smoke ]
}

record legeos.decision.the-home-field-is-a-launcher-not-a-search/1 : decision {
    title "The Home search is an application launcher over AppIdentity1: applications only, ranked like a launcher; file search belongs to the Files object and to FSearch"
    state proposed
    scope [
        path "crates/lege-session-core/**",
        path "crates/lege-types/src/action.rs",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    topic home-search
    decision """
        The field at the top of bare Home is the application launcher and answers with applications only; it never asks the file service and never says it is searching files. Its one registry is AppIdentity1 — the same inventory that launches, groups variants and carries updates and shortcuts — so an application originates in exactly one place, and a launcher is a view over that inventory rather than a second scanner of .desktop files. It ranks like a launcher: exact name, then name prefix, then a later word of the name, then a substring, then the name as an abbreviation (the query's letters in order, starting a word, gap-penalised), then keywords, then categories, then the identifier as a last resort; within a tier the application launched most recently comes first, from the shell's own recents list, and a boost never lifts a row across a tier. A row's second line is the .desktop name it is installed under, never the shell's internal id. Typing a letter on bare Home opens the search and goes into it; Enter opens the one highlighted row and Escape empties the field. A path typed into it (/etc, ~/src) is an instruction rather than a result and opens that folder in the file manager. A file search belongs to the Files object, scoped to the location it shows (folders before files, capped per source). Projects are tiles and actions have the context menu and cheat sheet, so neither is a search result. Deep search over everything indexed is the job of a real search tool: fsearch is the default candidate of the exclusive ProviderRole::FileSearch, launched with --search <query> from the Files object's last row and a context-menu verb; lege-filed keeps its index for the scoped in-place search, and a later step feeds fsearch's include list from Files.Search1.Roots.
        """
    context """
        The user asked for 'an app search, like the cosmic-launcher app search, or that code can be used wholesale in fact if our app search is limited somehow', while keeping the LegeOS convention of unifying application origination for updates and shortcuts. Both were read at 2026-09-08. cosmic-launcher is a libcosmic/iced application (winit, multi-window, xdg-portal, single-instance) — a second toolkit and a second window system inside a pixelkit shell. pop-launcher, the ranking behind it, is a JSON-over-stdio daemon with its own desktop-entry plugin: adopting it would put a second application registry beside AppIdentity1, which is precisely the unification the user asked to keep. The part worth having is about 45 lines (service/src/lib.rs::calculate_weight and service/src/priority.rs): a word-prefix or Exec-prefix scoring 1.0, otherwise strsim::jaro_winkler over name, Exec and keywords, then score + 0.06*recent^3 + 0.03*freq^3 with Exec length as the tiebreak. LegeOS's own MatchKind ladder was already finer than that on everything pop-launcher scores 1.0 and was missing only a typo/abbreviation-tolerant tail and the recency boost.
        """
    consequences """
        Neither cosmic-launcher nor pop-launcher is vendored, forked or run: the ranking is written in shell/lege-shell/src/app_search.rs with no new dependency (a gap-penalised subsequence in place of strsim's Jaro-Winkler, which needs no crate and expresses the abbreviation case directly). The recency boost reads shell/lege-shell/src/recents.rs and nothing else — no new Settings1 key, and no frequency count, because that list records order and not counts. AppIdentity1 stays the single place an application is known, so a launcher improvement never has to be repeated in a second scanner.
        """
    contradicts [ @legeos.work.adaptive-files-and-omnibox ]
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    acknowledged true
}

record legeos.decision.three-package-tiers/1 : decision {
    title "Every package on a LegeOS medium is native, rebuilt or inherited, and a rebuild needs a stated reason"
    state proposed
    scope [ path "distro/**", path "tools/xtask/src/seeds.rs" ]
    topic package-tiers
    decision """
        LegeOS is a source-integrated Ubuntu derivative with three package tiers. Native: built by this repository (the workspace packages, the metapackages, the pinned forks). Rebuilt: Ubuntu source plus a LegeOS patch queue, versioned with a +legeos<n> suffix, entered only with a recorded one-line answer to "what changes because LegeOS builds this?" — the tier is empty today on purpose. Inherited: Ubuntu 26.04 binaries as they are, which is everything else, including the kernel, the NVIDIA LRM and CUDA for this edition so Secure Boot works with Canonical's chain and no LegeOS key. The closure report tags every direct package with its tier and asks apt only about inherited names; the medium carries a TIERS.manifest naming the tier of every installed package.
        """
    context """
        Outside advice compared a pure binary derivative with a full source rebuild and recommended the middle: own composition first, a cheap rebuild pipeline second, rebuilds only where a patch, trim or optimisation is measured. The first closure against resolute found three names that needed changing and sixteen native names that had been making the simulation empty.
        """
    consequences """
        No Ubuntu Desktop underneath: composition is the seeds. The rebuild pipeline (source import, build in a clean chroot, publish) is built after LegeOS self-hosts, not before, and its first exercise is a zero-patch rebuild to prove the shape. Moving a package to Rebuilt is a ledger event, not a build detail.
        """
    depends_on [
        @legeos.constraint.first-release-scope,
        @legeos.decision.base-ubuntu-2604-kernel-70
    ]
}

record legeos.decision.toolchain-licence-namespace/1 : decision {
    title "D8/ADR-0008 — Rust 2024 edition, dev toolchain 1.97.1, MSRV 1.93 (Ubuntu 26.04 rustc), MPL-2.0 for own code, org.legeos namespace"
    state superseded
    scope [
        path "Cargo.toml",
        path "LICENSE",
        path "crates/lege-types/src/dbus.rs",
        path "deny.toml",
        path "rust-toolchain.toml"
    ]
    decision """
        Edition 2024, resolver 3; rust-toolchain.toml pins 1.97.1 for development; workspace rust-version = "1.93" (Ubuntu 26.04's rustc) with an MSRV CI job. Own code is MPL-2.0 (repository-wide LICENSE); forks keep upstream GPL-3.0; deny.toml holds the licence allow-list; DEP-5 debian/copyright is regenerated by cargo xtask copyright. Reverse-DNS namespace org.legeos for D-Bus names, app IDs and first-party apps (org.legeos.Session/.Resources/.Files/.Host; org.legeos.Files, org.legeos.Viewer); polkit org.legeos.host.*; env LEGEOS_APP_ID / LEGEOS_INSTANCE_ID.
        """
    context """
        The planning workspace used edition 2024 + MPL-2.0 and org.example placeholders; the archive build must work with the distribution's own rustc.
        """
    consequences """
        One namespace everywhere; archive-buildable without a newer toolchain.
        """
    implements [ @legeos.constraint.packaging-and-render-thread ]
    supported_by [ @legeos.evidence.m0-workspace-builds-and-tests ]
}

record legeos.decision.toolchain-licence-namespace/2 : decision {
    title "D8/ADR-0008 — Rust 2024 edition, dev toolchain 1.97.1, MSRV 1.97, AGPL-3.0 own code, org.legeos namespace"
    state superseded
    scope [
        path "Cargo.toml",
        path "LICENSE",
        path "crates/lege-types/src/dbus.rs",
        path "deny.toml",
        path "rust-toolchain.toml"
    ]
    decision """
        Edition 2024, resolver 3; rust-toolchain.toml pins 1.97.1 for development; workspace rust-version = "1.97" with an MSRV CI job. Rust 1.97 is the honest floor of the resolved workspace because the first-party preview dependency graph already requires it; LegeOS does not claim a lower archive baseline that Cargo cannot resolve. Own code is AGPL-3.0-only (repository-wide LICENSE), with lege-comp retaining its GPL-3.0-only exception; forks keep upstream licences; deny.toml holds the licence allow-list; DEP-5 debian/copyright is regenerated by cargo xtask copyright. Reverse-DNS namespace org.legeos for D-Bus names, app IDs and first-party apps (org.legeos.Session/.Resources/.Files/.Host; org.legeos.Files, org.legeos.Viewer); polkit org.legeos.host.*; env LEGEOS_APP_ID / LEGEOS_INSTANCE_ID.
        """
    context """
        The planning workspace used edition 2024 + MPL-2.0 and org.example placeholders; the archive build must work with the distribution's own rustc.
        """
    consequences """
        One namespace everywhere; archive-buildable without a newer toolchain.
        """
    implements [ @legeos.constraint.packaging-and-render-thread ]
    supersedes [ @legeos.decision.toolchain-licence-namespace/1 ]
    supported_by [ @legeos.evidence.m0-workspace-builds-and-tests ]
}

