    author "dk"
}

record legeos.decision.session-greeter-lock/1 : decision {
    title "D10/ADR-0010 — systemd-managed session (legeos-session.target), sessiond-arbitrated autostart, greetd + cosmic-greeter, compositor-owned lock screen"
    state superseded
    scope [ path "session/**" ]
    decision """
        The session is legeos-session.target plus user units with explicit protection values, started by the lege-session entry from wayland-sessions/legeos.desktop; xdg-desktop-autostart.target is masked and lege-sessiond launches approved autostart entries with identity and cgroups (one provider per exclusive role). Greeter: greetd + the cosmic-greeter fork (reuses the compositor). Lock screen: compositor-core ext-session-lock-v1.
        """
    context """
        A full distribution needs a display manager and a session manager; reusing the compositor for the greeter avoids a second toolkit stack; the docs demand permissioned autostart and one provider per role.
        """
    consequences """
        One session stack; lege doctor checks the units and their protection values.
        """
    implements [
        @legeos.constraint.one-provider-per-role,
        @legeos.constraint.services-not-indicators
    ]
    supported_by [ @legeos.evidence.m0-smoke ]
}

record legeos.decision.session-greeter-lock/2 : decision {
    title "D10/ADR-0010 — systemd-managed session (legeos-session.target), sessiond-arbitrated autostart, greetd + lege-greeter, compositor-owned lock screen"
    state active
    scope [ path "session/**" ]
    decision """
        The session is legeos-session.target plus user units with explicit protection values, started by the lege-session entry from wayland-sessions/legeos.desktop; xdg-desktop-autostart.target is masked and lege-sessiond launches approved autostart entries with identity and cgroups (one provider per exclusive role). Greeter: greetd + lege-greeter, our own, speaking greetd's JSON IPC over its socket so that greetd owns PAM and the greeter links no authentication code. Lock screen: compositor-core ext-session-lock-v1.
        """
    context """
        A full distribution needs a display manager and a session manager; the docs demand permissioned autostart and one provider per role. Revision 1 chose the cosmic-greeter fork on the reasoning that reusing the compositor avoids a second toolkit stack. ADR-0012 removed the compositor fork, which removed that reasoning with it: cosmic-greeter would have dragged libcosmic back into the dependency graph for the login screen alone, and the way to avoid a second toolkit stack is now for the greeter to use the same toolkit as the shell.
        """
    consequences """
        One session stack; lege doctor checks the units and their protection values, and now also that every unit's ExecStart binary is actually installed. The greeter is ours to maintain, but it links no PAM, no shadow and nothing setuid — authentication stays entirely inside greetd.
        """
    depends_on [ @legeos.decision.compositor-on-smithay ]
    implements [
        @legeos.constraint.one-provider-per-role,
        @legeos.constraint.services-not-indicators
    ]
    supersedes [ @legeos.decision.session-greeter-lock/1 ]
    supported_by [ @legeos.evidence.m0-smoke ]
}

record legeos.decision.task-system-four-scales-one-model/1 : decision {
    title "Window management has four scales over one task model: Home is a place, the island shows what runs, Taskfield is a compositor view of every window, the launcher starts; Alt+Tab walks every open window, Peek is the pointer's way out of fullscreen"
    state proposed
    scope [
        path "compositor/templar-comp/**",
        path "crates/templar-types/src/action.rs",
        path "crates/templar-window/**",
        path "interfaces/wayland/**",
        path "shell/templar-shell/**"
    ]
    topic task-system
    decision """
        Four scales, each answering one question and none duplicating another. HomeGarden asks what am I working on (a persistent place; it shows counts of running windows, never live previews, and never lists windows). The Task Island (the bar) asks what is running: one chip per task unit (an explicit group, or an application with its loose windows), never a title on the bar, a count for more than one window, a fan of at most four preview cards on dwell, and a hand-over to Taskfield above four; chip order is first-seen and never reorders on activation. A chip is the application's icon (a group wears its most recently activated member's), the name is a hover tooltip, and an initial is only the fallback when no icon resolves. Taskfield asks where are all my windows: a presentation mode of the compositor itself, entered by Super+Tab, the bottom-left corner dwell (Peek), the island's overflow, the launcher's arrow, or a place's 'N windows active' line. It is a VIEW, not a place: the compositor draws every client surface scaled at a presentation rectangle without sending a configure, laid out per output into sections by task unit (explicit groups first) with equal cards that never exceed the window's real size; selection highlights, it never moves geometry; the layout exists only while the mode is up and nothing about it is ever stored. The launcher (the Apps bar on bare Home) asks what can I start; Super+Space reveals Home with it focused. Alt+Tab walks every open application window (WindowService::alt_tab_order: mapped, parked ones included), most recently activated first, across every unit and output, frozen at the first press; Tab moves the HUD's selection and releasing the modifier activates it (unparking a parked window), while Escape, a click or another chord cancels; a window that closes or unmaps mid-walk leaves the list. Alt+` is the same walk within the current unit (the group when grouped, the application otherwise), parked members included. One model: templar_window::task::units, a pure function over the shell toplevels both the compositor and the shell hold, is the only grouping and ordering of windows; activation recency (mru_rank) is the only recency. One presentation state: WindowService::Presentation {Normal, HomeReveal, Taskfield}; a fullscreen window covers passive chrome only while Normal, and explicit navigation yields to nothing. Under a screen-filling window the bottom-left corner carries a two-pixel affordance; a dwell there is Peek (the island rises), a second dwell or motion past the island is Taskfield. Home's corner dwell moves to the top-left. Shell death inside Taskfield changes the labels, not the mode.
        """
    context """
        Extrapolated from the external review 'TemplarOS does need a taskbar, but the taskbar should not be responsible for making every window discoverable' and the reviewer's follow-up drawing the line HomeGarden is a place, Taskfield is a view (source task-system-taskfield-island-peek-20260909). The reviewer's warning: if Taskfield positions acquire permanent meaning it becomes Desktop 2. Scoped on 2026-09-09 by three lanes against the tree at 01445f5: 852fb55 had already landed activation recency and the MRU switcher, the bar already had its Hint/Revealed presences with an edge dwell under fullscreen, and Smithay already renders a surface tree at any origin and scale in the screencopy path, so the doc's weighted packer, zoom ladder, frozen-generation machinery, TaskModel struct, and preview re-send on shell reconnect (screencopy is client-pull; the compositor holds no pixels) were not built. The user chose: full scope, Peek at the bottom-left corner displacing the Home corner, the volume and brightness sliders in the account popover, a -60 dB volume cutoff and a 10% backlight floor. Revised 2026-10-04 on the user's request that 'the alt-tab system properly reflect the open windows': the seven-window cap (RECENT_MAX) hid the eighth window and every parked one while the island listed them, and per-step activation would have unparked every parked window walked past, so the cap went and the walk commits on release.
        """
    consequences """
        Revises @legeos.decision.window-groups-are-explicit-and-compositor-owned: Super+Tab no longer cycles groups (subsumed by Taskfield's unit sections, groups first) and Alt+` is the within-unit chord; there is still no Ctrl+Tab. Adds a route to @legeos.decision.the-home-field-is-a-launcher-not-a-search: Super+Space, Enter on a running application activates its most recent window, Ctrl+Enter launches another, the arrow opens Taskfield filtered to it. Fulfils home-taskbar-migration from @legeos.decision.home-projects-and-tool-actions: parked windows are on the island (dimmed) and in Taskfield's shelf band, on Home only when parked into a place. Layer::Presentation (wire 8) sits between SystemModal and ShellOverlay and holds the shell's Taskfield chrome, mapped only inside the mode. templar_shell_manager_v1 v8 adds open_taskfield, taskfield_state and launcher_focus; the Wayland XML is now gated by xtask check-wayland-versions. The window overview is named 'Windows' to a person; Taskfield is the internal name. Alt+Tab and the island now agree on which windows are open; the compositor's switcher HUD lists them by title (falling back to the application's short name), dims parked rows and scrolls a window of rows around the selection when they do not fit; it draws no icons, because the compositor loads none. Work: @legeos.work.task-system, @legeos.work.alt-tab-and-task-rail-icons-20261004.
        """
    derived_from [
        @legeos.decision.home-is-momentary-and-placeable-objects-are-containers,
        @legeos.decision.window-groups-are-explicit-and-compositor-owned
    ]
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    source {
        kind internal
        role origin
        document "task-system-taskfield-island-peek-20260909"
        path "docs/task-system-taskfield-island-peek.md"
        use """
            The four scales, the one model, Taskfield as a compositor presentation mode, Peek, and the place-versus-view rule of the appendix.
            """
    }
}

record legeos.decision.the-home-field-is-a-launcher-not-a-search/1 : decision {
    title "The Home search is an application launcher over AppIdentity1: applications only, ranked like a launcher; file search belongs to the Files object and to FSearch"
    state proposed
    scope [
        path "crates/templar-session-core/**",
        path "crates/templar-types/src/action.rs",
        path "services/templar-sessiond/**",
        path "shell/templar-shell/**"
    ]
    topic home-search
    decision """
        The field at the top of bare Home is the application launcher and answers with applications only; it never asks the file service and never says it is searching files. Its one registry is AppIdentity1 — the same inventory that launches, groups variants and carries updates and shortcuts — so an application originates in exactly one place, and a launcher is a view over that inventory rather than a second scanner of .desktop files. It ranks like a launcher: exact name, then name prefix, then a later word of the name, then a substring, then the name as an abbreviation (the query's letters in order, starting a word, gap-penalised), then keywords, then categories, then the identifier as a last resort; within a tier the application launched most recently comes first, from the shell's own recents list, and a boost never lifts a row across a tier. A row's second line is the .desktop name it is installed under, never the shell's internal id. Typing a letter on bare Home opens the search and goes into it; Enter opens the one highlighted row and Escape empties the field. A path typed into it (/etc, ~/src) is an instruction rather than a result and opens that folder in the file manager. A file search belongs to the Files object, scoped to the location it shows (folders before files, capped per source). Projects are tiles and actions have the context menu and cheat sheet, so neither is a search result. Deep search over everything indexed is the job of a real search tool: fsearch is the default candidate of the exclusive ProviderRole::FileSearch, launched with --search <query> from the Files object's last row and a context-menu verb; templar-filed keeps its index for the scoped in-place search.

        Added 2026-09-09 by @legeos.decision.task-system-four-scales-one-model, without adding a second launcher: Super+Space reveals Home with this field focused and armed (launcher_focus over templar_shell_v1 v8), so the keyboard route from a fullscreen window to starting something is Super+Space, type, Enter, and the fullscreen window is not disturbed. A result that is already running shows its count ('Firefox · 8 running', from templar_window::task::units); Enter on it activates the application's most recent window (launcher.activate-recent), Ctrl+Enter launches another instance (launcher.launch-new), and the right arrow or Tab opens Taskfield filtered to that application. The launcher still never switches windows as a list: activating is the one exception, and the list of windows is Taskfield's.
        """
    context """
        The user asked for 'an app search, like the cosmic-launcher app search, or that code can be used wholesale in fact if our app search is limited somehow', while keeping the convention of unifying application origination for updates and shortcuts. Both were read at 2026-09-08. cosmic-launcher is a libcosmic/iced application — a second toolkit and a second window system inside a pixelkit shell. pop-launcher, the ranking behind it, is a JSON-over-stdio daemon with its own desktop-entry plugin: adopting it would put a second application registry beside AppIdentity1. The part worth having is about 45 lines of scoring; the shell's own MatchKind ladder was already finer on everything pop-launcher scores 1.0 and was missing only a typo-tolerant tail and the recency boost.
        """
    consequences """
        Neither cosmic-launcher nor pop-launcher is vendored, forked or run: the ranking is written in shell/templar-shell/src/app_search.rs with no new dependency. The recency boost reads shell/templar-shell/src/recents.rs and nothing else. AppIdentity1 stays the single place an application is known. The running count and the three keys read the same task::units the island reads, so the launcher and the island cannot disagree about what is running.
        """
    contradicts [ @legeos.work.adaptive-files-and-omnibox ]
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    acknowledged true
}

record legeos.decision.three-ownership-tiers/1 : decision {
    title "TemplarOS has three ownership tiers — System, Applications and workloads, Work — and each crossing between them is declared, owned and checked"
    state proposed
    scope [
        path "cli/templar/**",
        path "crates/templar-appd/**",
        path "crates/templar-types/**",
        path "distro/**",
        path "docs/architecture/**",
        path "installer/**",
        path "services/**",
        path "session/**"
    ]
    topic ownership-tiers
    decision """
        Three tiers, each with one owner and one way in.
        SYSTEM — the versioned Templar deployment: the root subvolume a deployment boots, with the package database that describes it, kernel, initramfs and boot entry. Owner: templar-hostd. Way in: a hostd transaction that snapshots into @deployments/<id>, runs apt into the candidate, seals it and stages it; boot-health promotes or rolls back. The booted deployment is mounted read-only once that path is complete; until then every route that runs apt against the live root is a named, temporary exception. Persistent machine state (logs, hostd's registry, network and machine configuration that must survive a rollback) lives in @var, and what moves with a deployment versus what persists across deployments is declared path by path.
        APPLICATIONS AND WORKLOADS — what runs. Owner: templar-sessiond (appd identity, Launcher1) for identity and launch, templar-resourced for pressure policy. An application's record is the authority from installation through execution: identity, executable, icon, associations, resource class, update owner, sandbox. Applications the owner adds come from Flatpak (@legeos.decision.flatpak-and-crash-handling) or are Templar-built packages that enter through the System tier; an application never writes the deployment. A workload is work an application starts that is not the application (a build from a terminal): it gets its own unit and an identity that names the application that spawned it, so the governor never has to guess.
        WORK — the owner's projects, documents and application state: @home and the optional /data role. Owner: the person; filed and Homegarden observe it. No System-tier operation writes it; a system service that reads or snapshots it does so through a declared exception (hostd's index checkpoint of @home is the one today).
        UBUNTU AND TEMPLAR — Ubuntu is the upstream source and compatibility base and owns core userspace, libraries, hardware enablement, firmware, kernel and security maintenance (the inherited tier of @legeos.decision.three-package-tiers). Templar owns the session, compositor, shell, application identity, file services, resource policy, the update and recovery path, and the interaction model. apt is a System-tier tool used by hostd on a candidate, not a way for the person or an application to change the running system.
        """
    context """
        The owner asked (2026-10-02) to begin enforcing boundaries between OS levels, after an advisor's reading of Nitrux: take the separation principle (OS as chassis, applications outside it, persistent state separate), not Nitrux's implementation (NX Overlayroot, XFS/F2FS layout, no package manager, OpenRC, Hyprland). Today the tiers exist as subvolumes and services but leak: @legeos.observation.hostd-stages-candidates-outside-the-declared-deployments-subvolume, @legeos.observation.the-system-root-is-mutable-in-place-and-its-package-database-lives-in-var, @legeos.observation.terminal-workloads-inherit-the-terminal-identity. Open for the owner before this leaves proposed: (a) whether the person may still apt-install into the system at all once the deployment is read-only, or only through a hostd transaction (a 'templar install <deb>' that stages a candidate); (b) where dpkg state lives: with the deployment (inside the root subvolume) or in @var with a per-deployment copy; (c) the workload route: a per-command scope from the shell hook, a terminal-integrated launcher, or opt-in only; (d) which everyday applications beyond the browser (already a Flathub ref per ADR-0011, distro/seeds/selection.toml layer browser) leave the System tier for Flatpak, and which stay Templar-shipped packages, decided per application.
        """
    consequences """
        systemd stays (cgroups are what the Applications tier stands on), APT/Debian packaging stays (@legeos.constraint.first-release-scope), Btrfs subvolumes stay as the mechanism. ADR-0004's open 'snapshot deployments vs A/B images' is answered as snapshot deployments under @deployments. templar dev deploy, the provisioner's chroot and scripts/update-templaros.sh each become either a hostd transaction or a declared exception. resourced's discovery widens beyond app-templaros-* units to workload and Flatpak scopes.
        """
    depends_on [
        @legeos.constraint.identity-and-launch-safety,
        @legeos.decision.boot-deploy-secure-boot,
        @legeos.decision.three-package-tiers
    ]
    supported_by [
        @legeos.observation.hostd-stages-candidates-outside-the-declared-deployments-subvolume,
        @legeos.observation.terminal-workloads-inherit-the-terminal-identity,
        @legeos.observation.the-system-root-is-mutable-in-place-and-its-package-database-lives-in-var
    ]
    source {
        kind external
        role rationale
        document "nitrux-ownership-tiers-advice-20261001"
        use """
            The three-layer ownership model, the Ubuntu-owns/Templar-owns boundary, deciding where apt sits, workload identity, the application record as the authority; and what not to copy (overlayroot, XFS layout, removing systemd, Hyprland).
            """
    }
    source {
        kind external
        role example
        url "https://nxos.org/documentation/core-concepts/system-architecture/immutable-architecture/"
        use """
            Reference architecture for the separation principle only.
            """
    }
}

record legeos.decision.three-package-tiers/1 : decision {
    title "Every package on a LegeOS medium is native, rebuilt or inherited, and a rebuild needs a stated reason"
    state proposed
    scope [ path "distro/**", path "tools/xtask/src/seeds.rs" ]
    topic package-tiers
    decision """
        LegeOS is a source-integrated Ubuntu derivative with three package tiers. Native: built by this repository (the workspace packages, the metapackages, the pinned forks). Rebuilt: Ubuntu source plus a LegeOS patch queue, versioned with a +legeos<n> suffix, entered only with a recorded one-line answer to "what changes because LegeOS builds this?" — the tier is empty today on purpose. Inherited: Ubuntu 26.04 binaries as they are, which is everything else, including the kernel, the NVIDIA LRM and CUDA for this edition so Secure Boot works with Canonical's chain and no LegeOS key. The closure report tags every direct package with its tier and asks apt only about inherited names; the medium carries a TIERS.manifest naming the tier of every installed package.
        """
    context """
        Outside advice compared a pure binary derivative with a full source rebuild and recommended the middle: own composition first, a cheap rebuild pipeline second, rebuilds only where a patch, trim or optimisation is measured. The first closure against resolute found three names that needed changing and sixteen native names that had been making the simulation empty.
        """
    consequences """
        No Ubuntu Desktop underneath: composition is the seeds. The rebuild pipeline (source import, build in a clean chroot, publish) is built after LegeOS self-hosts, not before, and its first exercise is a zero-patch rebuild to prove the shape. Moving a package to Rebuilt is a ledger event, not a build detail.
        """
    depends_on [
        @legeos.constraint.first-release-scope,
        @legeos.decision.base-ubuntu-2604-kernel-70
    ]
}

record legeos.decision.toolchain-licence-namespace/1 : decision {
    title "D8/ADR-0008 — Rust 2024 edition, dev toolchain 1.97.1, MSRV 1.93 (Ubuntu 26.04 rustc), MPL-2.0 for own code, org.legeos namespace"
    state superseded
    scope [
        path "Cargo.toml",
        path "LICENSE",
        path "crates/lege-types/src/dbus.rs",
        path "deny.toml",
        path "rust-toolchain.toml"
    ]
    decision """
        Edition 2024, resolver 3; rust-toolchain.toml pins 1.97.1 for development; workspace rust-version = "1.93" (Ubuntu 26.04's rustc) with an MSRV CI job. Own code is MPL-2.0 (repository-wide LICENSE); forks keep upstream GPL-3.0; deny.toml holds the licence allow-list; DEP-5 debian/copyright is regenerated by cargo xtask copyright. Reverse-DNS namespace org.legeos for D-Bus names, app IDs and first-party apps (org.legeos.Session/.Resources/.Files/.Host; org.legeos.Files, org.legeos.Viewer); polkit org.legeos.host.*; env LEGEOS_APP_ID / LEGEOS_INSTANCE_ID.
        """
    context """
        The planning workspace used edition 2024 + MPL-2.0 and org.example placeholders; the archive build must work with the distribution's own rustc.
        """
    consequences """
        One namespace everywhere; archive-buildable without a newer toolchain.
        """
    implements [ @legeos.constraint.packaging-and-render-thread ]
    supported_by [ @legeos.evidence.m0-workspace-builds-and-tests ]
}

record legeos.decision.toolchain-licence-namespace/2 : decision {
    title "D8/ADR-0008 — Rust 2024 edition, dev toolchain 1.97.1, MSRV 1.97, AGPL-3.0 own code, org.legeos namespace"
    state superseded
    scope [
        path "Cargo.toml",
        path "LICENSE",
        path "crates/lege-types/src/dbus.rs",
        path "deny.toml",
        path "rust-toolchain.toml"
    ]
    decision """
        Edition 2024, resolver 3; rust-toolchain.toml pins 1.97.1 for development; workspace rust-version = "1.97" with an MSRV CI job. Rust 1.97 is the honest floor of the resolved workspace because the first-party preview dependency graph already requires it; LegeOS does not claim a lower archive baseline that Cargo cannot resolve. Own code is AGPL-3.0-only (repository-wide LICENSE), with lege-comp retaining its GPL-3.0-only exception; forks keep upstream licences; deny.toml holds the licence allow-list; DEP-5 debian/copyright is regenerated by cargo xtask copyright. Reverse-DNS namespace org.legeos for D-Bus names, app IDs and first-party apps (org.legeos.Session/.Resources/.Files/.Host; org.legeos.Files, org.legeos.Viewer); polkit org.legeos.host.*; env LEGEOS_APP_ID / LEGEOS_INSTANCE_ID.
        """
    context """
        The planning workspace used edition 2024 + MPL-2.0 and org.example placeholders; the archive build must work with the distribution's own rustc.
        """
    consequences """
        One namespace everywhere; archive-buildable without a newer toolchain.
        """
    implements [ @legeos.constraint.packaging-and-render-thread ]
    supersedes [ @legeos.decision.toolchain-licence-namespace/1 ]
    supported_by [ @legeos.evidence.m0-workspace-builds-and-tests ]
}

