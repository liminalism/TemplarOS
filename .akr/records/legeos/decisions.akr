akr 0.1
project legeos

record legeos.decision.base-ubuntu-2604-kernel-70/1 : decision {
    title "D1/ADR-0007 — Base is Ubuntu 26.04 LTS 'resolute' with Ubuntu's linux-generic 7.0; mainline 7.2 only as a transaction candidate"
    state proposed
    scope [ path "distro/**" ]
    topic base-and-kernel
    decision """
        The base is Ubuntu 26.04 LTS ('resolute') declared once in distro/base.toml; the kernel is Ubuntu's linux-generic (7.0 GA, HWE later), version-locked with Canonical-signed prebuilt NVIDIA LRM modules (linux-modules-nvidia-<branch>-generic) and firmware by the legeos-kernel / legeos-nvidia-{open,proprietary} metapackages. Mainline 7.2 is never hand-installed; it is a candidate for lege-hostd's kernel/NVIDIA transaction path.
        """
    context """
        Ubuntu 26.04 = resolute, kernel 7.0 (renumbered 6.20). The planning docs advise against placing upstream 7.2 on a hybrid Intel/NVIDIA laptop that already saw driver conflicts; reproducible driver validation and rollback matter more than kernel recency.
        """
    consequences """
        One declarative base; NVIDIA via Ubuntu LRM (no DKMS, no .run installer); newer kernels only through the transactional path with the hardware matrix green.
        """
    source {
        kind external
        role rationale
        document "planning-initial-shape"
        use """
            Section 'First: Linux 7.2 and your Lubuntu installation' and section 4 'Native NVIDIA handling'.
            """
    }
}

record legeos.decision.boot-deploy-secure-boot/1 : decision {
    title "D5/ADR-0004 — Kernel/NVIDIA transactions on btrfs deployments with systemd boot assessment and a system-scope health probe; Secure-Boot posture open until Stage 3"
    state proposed
    scope [
        path "distro/deploy/**",
        path "distro/image/**",
        path "services/lege-boot-health/**",
        path "services/lege-hostd/src/deploy.rs"
    ]
    topic boot-deployments
    decision """
        Root is btrfs subvolumes from the first mkosi repart layout; a deployment is a read-only snapshot plus a hostd-owned ESP directory (/EFI/legeos/<id>/) holding kernel, initrd and entry, so kernel + NVIDIA modules + userspace roll back together and Ubuntu's initramfs hooks cannot rewrite the previous entry. Kernels stay Ubuntu-signed Type #1 entries (no self-built UKI). A candidate boots with a boot-assessment counter; lege-boot-health (SYSTEM scope, before boot-complete.target, TimeoutStartSec + FailureAction=reboot-force) gates systemd-bless-boot. A BootManager trait has two backends: systemd-boot (bless-boot) and grub (GRUB_DEFAULT=saved + grub-reboot + hostd counter). Dev/VM images use systemd-boot with Secure Boot off. OPEN before Stage 3 on real hardware: (a) LegeOS-signed systemd-boot + MOK enrolment at install, (b) Canonical-signed GRUB + hostd counter, (c) SB off dev-only; and snapshot vs A/B for Stage 4.
        """
    context """
        Ubuntu 26.04 ships systemd-boot but no Canonical-signed variant, so shim will not chain to it under Secure Boot without a MOK; a boot entry alone does not roll back NVIDIA userspace on a shared root.
        """
    consequences """
        The docs' 8-step watchdog sequence reuses systemd primitives; the deployment layout is fixed early (cheap now, expensive later); the Secure-Boot choice is explicit, not accidental.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            Section 4 'Treat a kernel/driver update as one transaction' and 'Stage 4: transactional OS deployment'.
            """
    }
}

record legeos.decision.debian-packaging/1 : decision {
    title "D9/ADR-0009 — Packaging: cargo-deb per binary now; one vendored source package (root debian/) for the archive; keyring + pins as legeos-archive-keyring"
    state proposed
    scope [
        path "debian/**",
        path "distro/apt/**",
        path "distro/metapackages/**",
        path "packaging/**"
    ]
    topic debian-packaging
    decision """
        Stage 1: every binary crate carries [package.metadata.deb]; `cargo deb -p <crate>` feeds a local aptly repo (never /usr/local). Stage 2: one source package `legeos` with debian/ at the repo root, vendor/ shipped in the orig tarball, dh_auto_build overridden with `cargo build --release --frozen --offline --workspace`; metapackages in legeos-meta; legeos-archive-keyring ships the archive key, deb822 legeos.sources and preferences.d pins rejecting third-party driver repositories. dh-cargo is not used.
        """
    context """
        dh-cargo expects Debian-packaged crates — impractical for zbus 5 / tokio 1.5x / smithay; vendoring is what COSMIC's own packaging does.
        """
    consequences """
        Packages from day one; the archive path is ready when the repository exists.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            'Stage 1: package every component as a Debian package rather than installing binaries manually under /usr/local'.
            """
    }
}

record legeos.decision.flatpak-and-crash-handling/1 : decision {
    title "D11/ADR-0011 — Flatpak for sandboxed apps (no snapd in the seeds); telemetry-free crash handling via systemd-coredump ingested into history"
    state proposed
    scope [ path "distro/policy/coredump/**", path "distro/seeds/**" ]
    topic app-distribution-and-crashes
    decision """
        Sandboxed applications come as Flatpak (the alias model carries Flatpak IDs); snapd is excluded from the seeds and legeos-desktop conflicts with it. Crash handling: systemd-coredump on, apport/whoopsie out; lege-sessiond ingests coredump journal entries (PID -> cgroup -> instance) into the event history so a crash is one explainable, restorable event.
        """
    context """
        Ubuntu forces the snap decision (Firefox/Thunderbird are snaps); the docs forbid 'a complete alternative application store' — Flatpak/Flathub is not that; the docs want notifications and system decisions as searchable history.
        """
    consequences """
        One sandbox format in the identity model; crashes are attributed to instances without any upload.
        """
    source {
        kind external
        role rationale
        document "planning-initial-shape"
        use """
            'What the first release should not attempt' and 'System-wide change history'.
            """
    }
}

record legeos.decision.forks-by-manifest/1 : decision {
    title "D6/ADR-0005 — Upstream forks (cosmic-comp, cosmic-files, cosmic portal, cosmic-greeter, cosmic-applets) are pinned by distro/forks/manifest.toml, not git submodules"
    state proposed
    scope [ path "apps/lege-files/**", path "compositor/**", path "distro/forks/**" ]
    topic upstream-forks
    decision """
        Each fork lives in its own repository with an 'upstream' tracking branch and a 'legeos' patch branch; distro/forks/manifest.toml pins URL/branch/commit; `just forks-fetch` clones into the gitignored forks/ directory. compositor/lege-comp-integration is a path crate the compositor fork depends on; the files fork depends on lege-client. Patches are limited to the items enumerated in compositor/FORK.md and apps/lege-files/FORK.md.
        """
    context """
        The user's four separately maintained COSMIC submodules already caused rebase and detached-HEAD problems; Stage 2 wants proper downstream repos with automated rebase checks.
        """
    consequences """
        No submodule state in this repository; reproducible builds from the manifest; monthly rebase cadence.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            'You are already partway toward a distribution' (submodule pain) and 'Stage 2: own package repository and reproducible image'.
            """
    }
}

record legeos.decision.mkosi-images/1 : decision {
    title "D7/ADR-0006 — mkosi builds the dev/CI/VM disk image (ESP + btrfs subvolumes); the installer ISO is a later stage"
    state proposed
    scope [ path "distro/image/**", path "distro/iso/**", path "distro/seeds/**" ]
    topic image-build
    decision """
        distro/image/mkosi.conf: Distribution=ubuntu Release=resolute Repositories=main,universe,restricted Format=disk Bootable=yes Bootloader=systemd-boot UnifiedKernelImages=no ToolsTree=default, mkosi.repart/ with ESP + btrfs subvolumes, packages composed from distro/seeds/*.seed by compose.sh. mkosi has no ISO output; the installer ISO comes later via ubuntu-image classic or live-build from the same seeds.
        """
    context """
        Native Ubuntu support, UKI/signed systemd-boot options and systemd-repart give a straight path to snapshot/A-B deployments; the host currently lacks mkosi (apt install mkosi on 26.04).
        """
    consequences """
        One declarative image definition, `mkosi vm` for tests; image build itself is out of scope for M0.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            'Stage 2: own package repository and reproducible image'.
            """
    }
}

record legeos.decision.one-privileged-host-daemon/1 : decision {
    title "D4/ADR-0003 — One privileged host daemon (lege-hostd): updates, deployments, driver authority, storage reserve, hardware profile; timezone policy stays in sessiond"
    state proposed
    scope [
        path "distro/policy/dbus/**",
        path "distro/policy/polkit/**",
        path "services/lege-hostd/**"
    ]
    topic privileged-host-daemon
    decision """
        lege-hostd (system bus org.legeos.Host, one polkit policy org.legeos.host.*, AppArmor profile) hosts Updates, Deployments (BootManager trait), Drivers/GPU mode, Storage reserve and Hardware profile. It keeps an on-disk transaction journal and runs apt as a child transient unit. Timezone/location policy is NOT in hostd: it is network-facing and lives in lege-sessiond, setting the zone via polkit-gated org.freedesktop.timedate1.
        """
    context """
        The docs' updated, 'one driver authority', storage reserve and locationd are all root policy over apt/systemd; each as its own root daemon multiplies privileged surfaces; untrusted geolocation JSON must not be parsed as root.
        """
    consequences """
        Fewer privileged surfaces; one place for lege update, doctor support-violation checks and the hardware profile.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            Section 4 (driver authority, update transaction), section 2 (storage reserve), section 7 'Services should be separate from indicators' (timezone service).
            """
    }
}

record legeos.decision.one-session-policy-daemon/1 : decision {
    title "D2/ADR-0001 — One user session policy daemon (lege-sessiond) hosting appd, associationd, providers, history, notifications, settings, projects, power, location as library crates"
    state proposed
    scope [
        path "crates/lege-appd/**",
        path "crates/lege-associationd/**",
        path "crates/lege-session-core/**",
        path "crates/lege-state/**",
        path "services/lege-sessiond/**"
    ]
    topic session-policy-daemon
    decision """
        lege-sessiond is the single user policy daemon (bus name org.legeos.Session). Application identity + launching (appd), the association broker (associationd), provider/autostart arbitration, history, notifications (org.freedesktop.Notifications when selected), typed settings, project sessions, power and timezone/location policy are separate library crates wired by a thin daemon over one SQLite state store (lege-state). Interfaces are domain-scoped and versioned (org.legeos.AppIdentity1, org.legeos.Associations1, ...) at separate object paths so a later split only relocates a bus name. Type=notify, Restart=on-failure, WatchdogSec; instances persisted and re-derived from systemd unit patterns after restart; history writes are non-fatal.
        """
    context """
        The planning docs propose several services and note associationd 'probably as part of appd'; the user's Lubuntu install suffers from many daemons/applets with private state and no shared identity key; cross-daemon D-Bus adds the launch-registration and governor-blocking races the docs flag.
        """
    consequences """
        One crash/restart unit and one place to explain decisions; cross-domain updates are transactions. filed and resourced remain separate processes. Crate boundaries keep the split reversible.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            Sections 'The central innovation: one application contract' and 6 'Centralized file-association handling' ('probably as part of appd').
            """
    }
    source {
        kind external
        role origin
        document "planning-subsequent-shape"
        use """
            Sections 3-4: appd identity registry, launcher, associationd engine, D-Bus APIs.
            """
    }
}

record legeos.decision.resourced-separate-process/1 : decision {
    title "D3/ADR-0002 — The resource governor (lege-resourced) is a separate, tiny, protected process that needs no D-Bus for emergency actions"
    state proposed
    scope [ path "crates/lege-types/src/unit.rs", path "services/lege-resourced/**" ]
    topic resource-governor-process
    decision """
        lege-resourced runs as its own user process (org.legeos.Resources) with mlockall, MemoryLow, OOMScoreAdjust=-1000, high CPU/IO weight and no SQLite. Launch units are self-describing (app-legeos-<AppId>@<InstanceId>.service) so cgroup->instance identity is derived from /sys/fs/cgroup alone; foreground/visibility arrive as compositor signals; sessiond only enriches. Policy is a pure engine separated from cgroup writes and runs observe-only until recorded traces show sensible choices; then cache trim, throttling (memory.high + reclaim), checkpoint requests and whole-cgroup termination are enabled in stages.
        """
    context """
        The governor must keep ticking under exactly the conditions that stall a daemon doing SQLite/fsync/D-Bus/desktop-file imports (full disk in the storage-reserve case, a panic in an unrelated domain).
        """
    consequences """
        Two user daemons for policy instead of one; the governor is testable in isolation and survives sessiond restarts; lege doctor verifies its protection values.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            Section 5 'Resource management and prevention of whole-system hangs'.
            """
    }
    source {
        kind external
        role origin
        document "planning-subsequent-shape"
        use """
            Section 5 'Resource-governing service' (observe-only first; policy separate from cgroup writes).
            """
    }
}

record legeos.decision.session-greeter-lock/1 : decision {
    title "D10/ADR-0010 — systemd-managed session (legeos-session.target), sessiond-arbitrated autostart, greetd + cosmic-greeter, compositor-owned lock screen"
    state proposed
    scope [ path "session/**" ]
    topic session-assembly
    decision """
        The session is legeos-session.target plus user units with explicit protection values, started by the lege-session entry from wayland-sessions/legeos.desktop; xdg-desktop-autostart.target is masked and lege-sessiond launches approved autostart entries with identity and cgroups (one provider per exclusive role). Greeter: greetd + the cosmic-greeter fork (reuses the compositor). Lock screen: compositor-core ext-session-lock-v1.
        """
    context """
        A full distribution needs a display manager and a session manager; reusing the compositor for the greeter avoids a second toolkit stack; the docs demand permissioned autostart and one provider per role.
        """
    consequences """
        One session stack; lege doctor checks the units and their protection values.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            Section 7 'Background-activity permissions' and 'Declarative system-provider selection'; 'Stage 1' session contents.
            """
    }
}

record legeos.decision.toolchain-licence-namespace/1 : decision {
    title "D8/ADR-0008 — Rust 2024 edition, dev toolchain 1.97.1, MSRV 1.93 (Ubuntu 26.04 rustc), MPL-2.0 for own code, org.legeos namespace"
    state proposed
    scope [
        path "Cargo.toml",
        path "LICENSE",
        path "crates/lege-types/src/dbus.rs",
        path "deny.toml",
        path "rust-toolchain.toml"
    ]
    topic toolchain-licence-namespace
    decision """
        Edition 2024, resolver 3; rust-toolchain.toml pins 1.97.1 for development; workspace rust-version = "1.93" (Ubuntu 26.04's rustc) with an MSRV CI job. Own code is MPL-2.0 (repository-wide LICENSE); forks keep upstream GPL-3.0; deny.toml holds the licence allow-list; DEP-5 debian/copyright is regenerated by cargo xtask copyright. Reverse-DNS namespace org.legeos for D-Bus names, app IDs and first-party apps (org.legeos.Session/.Resources/.Files/.Host; org.legeos.Files, org.legeos.Viewer); polkit org.legeos.host.*; env LEGEOS_APP_ID / LEGEOS_INSTANCE_ID.
        """
    context """
        The planning workspace used edition 2024 + MPL-2.0 and org.example placeholders; the archive build must work with the distribution's own rustc.
        """
    consequences """
        One namespace everywhere; archive-buildable without a newer toolchain.
        """
    source {
        kind external
        role origin
        document "planning-subsequent-shape"
        use """
            Section 1 'Workspace layout' (edition 2024, MPL-2.0, resolver 3).
            """
    }
}
