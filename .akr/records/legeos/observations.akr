record legeos.observation.the-image-drop-in-for-a-named-build-set-already-exists/1 : observation {
    title "compose.sh already writes the mkosi drop-in that points the image at a named build set"
    state verified
    statement """
        `distro/image/compose.sh:22` writes `distro/image/mkosi.conf.d/40-local-archive.conf` from `$LEGEOS_BUILD_SET`, falling back to the archive's `current` marker and writing no drop-in at all when neither exists — which is the documented mkosi drop-in D2's `image-drop-in` check asks for. It cannot be exercised here: mkosi is not installed on this host, so `just image summary` is NOT EXECUTED (@legeos.evidence.de01-image-summary-mkosi-absent-20260904), and the check's own wording allows exactly that — 'or the drop-in is documented as not exercised because mkosi is absent'.
        """
    observed_at git:eb00239b41cfcb615f01b34bdb2903ed16f4f51f
    method observation
    watches [ "distro/image/compose.sh", "distro/image/mkosi.conf.d/**" ]
    derived_from [ @legeos.decision.build-set-id-is-the-version-authority ]
}

record legeos.observation.the-nvidia-lrm-cannot-be-installed-in-an-unshared-bootstrap-chroot/1 : observation {
    title "nvidia-kernel-common's postinst fails inside an unshared bootstrap chroot, so the live medium carries no NVIDIA driver"
    state superseded
    scope [ path "distro/iso/build.sh", path "installer/provision.sh" ]
    statement """
        Bootstrapping the medium with legeos-nvidia-open in the include list fails the whole apt transaction: nvidia-kernel-common-580's postinst runs update-initramfs before initramfs-tools has been configured, and with no kernel version of its own it falls back to `uname -r` — the BUILD HOST's 6.17.0-41-generic — producing "/usr/sbin/mkinitramfs: .: cannot open /etc/initramfs-tools/initramfs.conf" and taking eleven NVIDIA packages down with it. distro/iso/build.sh therefore no longer includes legeos-nvidia-open: the live session runs on whatever KMS driver the kernel binds (the Intel iGPU on the reference laptop), and the NVIDIA LRM is installed into the target by installer/provision.sh, where there is a real /boot and a configured initramfs. The same failure mode is a risk for the provisioner's own `apt-get install legeos-kernel legeos-nvidia-open` in its chroot; P3.3 in QEMU is where that gets tested.
        """
    observed_at git:ed81cb99ed494cf979d7435d6671596e1888a818
    method observation
    watches [ "distro/iso/build.sh", "installer/provision.sh" ]
    derived_from [ @legeos.decision.live-iso-runs-the-provisioner ]
}

