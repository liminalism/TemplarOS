akr 0.1
project legeos

record legeos.observation.agent-smoke-test-emptied-a-real-volume-trash/1 : observation {
    title "A Trash1 smoke test run against the real session bus emptied the user's actual volume trash"
    state verified
    scope [ path "cli/lege/**", path "services/lege-filed/**" ]
    statement """
        While smoke-testing `lege trash empty --yes` end to end, the implementing agent constructed TrashApi with TrashMounts::System instead of TrashMounts::Fixed, so the sweep read the machine's real mount table, found /media/dk/4668959A68958977/.Trash-1000, and permanently deleted its one entry — a folder named `target` (a Rust build directory, regenerable) trashed on 2026-08-30. Unrecoverable. The code behaved as designed; the harness choice was the fault: TrashMounts::Fixed exists precisely so tests cannot reach real disks, every committed test uses it, and the offending smoke script was removed rather than left as a trap. Standing rule going forward: any end-to-end exercise of destructive file operations must run against fixture mounts (TrashMounts::Fixed, a throwaway HOME and XDG_DATA_HOME) — never the developer host's real mount table.
        """
    observed_at git:d26a90adb035772b2ee2542a5554308987e4cb6f
    method manual
}

record legeos.observation.hands-on-run-20260831-findings/1 : observation {
    title "Hands-on run after logout/login: usable but rough — placement, inert tiling menu, no tile drag, widget sprawl, label noise, no drive route"
    state verified
    scope [
        path "compositor/**",
        path "crates/lege-field/**",
        path "crates/lege-window/**",
        path "shell/**"
    ]
    statement """
        User logged out/in on real hardware at the offline package build (c288246 era) and reports: (1) a terminal opens but appears slightly off-screen and cannot be moved or snapped; (2) none of the tiling buttons in the right-click menu do anything; (3) Home elements cannot be drag-moved or drag-resized though the user expected both; (4) Super-to-reveal-Home works; (5) each settings component (e.g. brightness) is its own widget — the user wants ONE Settings widget that opens into a larger screen with all settings; (6) each file tile carries a big FILE or FOLDER label the user calls redundant; (7) it is unclear how to reach the main drives or a specific folder; (8) no wallpaper is fine but the space must be used effectively — every element must have a purpose, no redundancy, concise labels. Overall verdict: slightly improved, still not usable.
        """
    observed_at git:7bd5eef1dc5c4e8b53174003a943afe8cf68c943
    method manual
    watches [
        "compositor/lege-comp/src/**",
        "shell/lege-shell/src/**",
        "crates/lege-window/src/**"
    ]
    derived_from [ @legeos.work.home-surface-usability-next ]
}

record legeos.observation.hands-on-run-3-findings-20260903/1 : observation {
    title "Third hands-on run at the installed desktop: Files object inert by pointer, band over client content, no window controls, no resize route"
    state verified
    scope [
        path "apps/lege-files/**",
        path "compositor/lege-comp/**",
        path "crates/lege-window/**",
        path "shell/lege-shell/**"
    ]
    statement """
        User logged into the LegeOS desktop at cb57689 (installed packages match HEAD) to test in-place hot-fixing and reports: (1) redundant HOME labels on the left of the file manager; (2) Copy path does nothing and no button in the file manager works; (3) a bare Super press hides windows but not the open file manager; (4) windows have no minimize or close buttons; (5) Kitty's top line is cut off by the window pane; (6) windows move but do not resize. Usability otherwise possible but poor. Diagnosis from the code: the 'file manager' is the shell's expanded Files object on Home (Layer::HomeSurface), so a reveal never hides it and its rail read Home ▸ Home over PLACE Home; single click activated rows, so the selection-gated file verbs stayed inert; spawn_copy_path rendered the text and never put it on a clipboard; the compositor painted its 32 px recovery band OVER the client's top strip (hiding client-side close buttons and a terminal's first line) and offered only a 24 px corner grip for resizing.
        """
    observed_at git:cb57689cbb8350fa913349aa7b313be07ac03164
    method manual
    watches [
        "shell/lege-shell/src/surface/file_browser.rs",
        "shell/lege-shell/src/surface/field_screen.rs",
        "compositor/lege-comp/src/**",
        "crates/lege-window/src/geometry.rs"
    ]
    derived_from [ @legeos.work.home-surface-usability-next ]
}

record legeos.observation.hands-on-run-4-findings-20260903/1 : observation {
    title "Hands-on run 4 (2026-09-03): the deploy stopped at hostd, snap browsers cannot connect, bands render above every window, no screen timeout, the launcher could not find snap applications"
    state verified
    scope [
        path "cli/lege/src/dev/**",
        path "compositor/lege-comp/**",
        path "services/lege-hostd/**",
        path "services/lege-sessiond/src/background/desktop_import.rs",
        path "shell/lege-shell/src/omnibox.rs"
    ]
    statement """
        Running sudo lege dev deploy on build set 0.1.0~dev1788393589+gcbd0efa installed all 13 packages, then failed at hostd: lege-hostd exits with 'Failed to connect to address unix:path=/var/run/dbus/system_bus_socket: Permission denied (os error 13)' (the same crash-loop since 2026-09-01; unit Type=dbus, root, ProtectHome=yes, socket srw-rw-rw- root), and the tool marked every later component 'not attempted'. Snap Chromium prints 'Failed to connect to Wayland display: Permission denied (13)': snapd's AppArmor profile allows only owner /run/user/[0-9]*/wayland-[0-9]* while the compositor listens on $XDG_RUNTIME_DIR/legeos-0. In backend/udev.rs and backend/winit.rs every chrome element (band, grip) is pushed before all space elements, so all bands render above all windows and a lower window's title shows through a translucent upper window at full opacity. Power1 records an idle policy and nothing enforces it; there is no idle source. sessiond's application_dirs() scanned /usr/share/applications, the two flatpak export trees and ~/.local/share/applications only, so snap Firefox (only in /var/lib/snapd/desktop/applications) was absent from the registry (502 entries, no firefox) while Chromium appeared through the apt shim; the Home field federated files, projects and actions with applications, so 'firefox' returned files. Also reported: no right-click menu in the Files object; windows fight for focus; text input is snappier than COSMIC.
        """
    observed_at git:dfa1fda3427e2b34d8043252c4049839f8af1e18
    method manual
    watches [
        "services/lege-hostd/**",
        "cli/lege/src/dev/**",
        "compositor/lege-comp/src/backend/**",
        "compositor/lege-comp/src/state.rs",
        "services/lege-sessiond/src/background/desktop_import.rs",
        "shell/lege-shell/src/omnibox.rs"
    ]
}

