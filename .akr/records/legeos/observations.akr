record legeos.observation.homegarden-half-day-grew-only-the-desktop-tray-20260909/1 : observation {
    title "Phase 4 half-day: Homegarden grew only the Desktop tray, fed by Home's own chrome; the terminal hook never ran and the Garden Clock never accumulated"
    state verified
    statement """
        After a half day in the LegeOS session on the Lubuntu host, the persisted ledger (session.db home_garden) held one context, /home/dk/Desktop, at Expanded (score 24) with buckets only launched-here (file-manager/terminal) and directory-opened; the sessiond journal showed 11 garden observations, all rooted at /home/dk/Desktop, zero terminal-entered, zero file-opened, zero project-entered. Four causes, none host-specific: (1) session/profile.d/60-legeos-garden.sh is read only by login shells and kitty on Linux never starts one (its login wrapper is macOS-only), so terminal-entered has never fired; the CLI test sources the script directly and is a false green. (2) Home's chrome is the only feed: the Desktop tray is the one Folder tile Home creates itself (field_model.rs merge_desktop_folder), its roles row launches kitty/pcmanfm --directory ~/Desktop which returns as launched-here, and every paint of a folder window pushes BrowseFolder which observes directory-opened once per shell process. (3) GardenClock accumulates active_ms only on Locked/Sleeping edges; logout emits none, so the persisted clock read {session 7, active_ms 0}; hours_since is identically 0, both demotion legs can never hold, and once Expanded a place stays Expanded. (4) /mnt/Samsung980_1TB/Rust-projects/.git exists, so attribute_root takes the highest marked ancestor and every repository under it would collapse into one Place. The 'little widget with 3 links' is paint_place at the Wide rung: name, state line, PLACE_ROLES chips, one branch row. Lane reports: .agent/scratch/homegarden-5/{A,B,C}-result.md.
        """
    observed_at git:e6e1b1c3523004f2eef22aa3bfd2dc2abae4a06a
    method observation
    watches [
        "session/profile.d/60-legeos-garden.sh",
        "services/lege-sessiond/src/apis/homegarden.rs",
        "crates/lege-session-core/src/homegarden.rs",
        "shell/lege-shell/src/field_model.rs",
        "shell/lege-shell/src/surface/field_screen.rs"
    ]
    derived_from [
        @legeos.observation.homegarden-produced-no-visible-place-or-bloom-during-an-hour-of-development-20260908,
        @legeos.work.homegarden-phases-0-3
    ]
}

record legeos.observation.homegarden-produced-no-visible-place-or-bloom-during-an-hour-of-development-20260908/1 : observation {
    title "Homegarden produced no visible Place or bloom during an hour of development in LegeOS"
    state superseded
    statement """
        The user worked on this repository for about one hour from a LegeOS terminal and saw no new Homegarden object. Source inspection explains the result: production observes only path-bearing launches plus shell-brokered file opens; terminal cwd/commands, project entry, Add to Home and successful directory navigation are not fully wired. Actual information blooms are explicitly deferred and have no implementation.
        """
    observed_at git:a9cc77b6d8c8149fca1527dd772e4457bac8079d
    method observation
    watches [
        "services/lege-sessiond/src/apis/homegarden.rs",
        "services/lege-sessiond/src/apis/projects.rs",
        "services/lege-sessiond/src/apis/homefield.rs",
        "shell/lege-shell/src/surface/app.rs",
        "cli/lege/src/main.rs",
        "docs/architecture/homegarden.md"
    ]
    derived_from [ @legeos.decision.homegarden-activity-grown-places ]
}

