    scope [
        path "interfaces/dbus/org.legeos.Files.*",
        path "services/lege-filed/**",
        path "shell/lege-shell/**"
    ]
    statement """
        On the 2026-08-24 installed desktop build, the user reached the Home environment and moved the cursor successfully, but the manager remained unusable: folder/file panes did not show actual file contents and could not be used to navigate files.
        """
