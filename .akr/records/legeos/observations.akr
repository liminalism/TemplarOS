record legeos.observation.deployments-subvolume-not-declared-by-repart/1 : observation {
    title "The repart declaration creates @ @home @var @snapshots, but the update engine stages candidates under @deployments/<id>, which nothing declares"
    state superseded
    scope [
        path "distro/image/mkosi.repart/**",
        path "services/lege-hostd/src/deploy.rs",
        path "services/lege-hostd/src/updates.rs"
    ]
    statement """
        distro/image/mkosi.repart/10-root.conf declares Subvolumes=/@ /@home /@var /@snapshots, while services/lege-hostd/src/deploy.rs and updates.rs stage a candidate deployment as a snapshot under @deployments/<id>. No declaration creates @deployments, so a fresh image and the engine disagree about the storage layout. The campaign freezes @deployments/<id> as authoritative and has the layout declaration add it.
        """
    observed_at git:8b284c9147b70b4f03bb7c48ec993647e2e4df31
    method observation
    watches [
        "distro/image/mkosi.repart/**",
        "services/lege-hostd/src/deploy.rs",
        "services/lege-hostd/src/updates.rs",
        "distro/deploy/layout.toml"
    ]
    blocks [ @legeos.work.reference-machine-provisioning ]
}

