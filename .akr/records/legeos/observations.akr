        """
    observed_at git:50af3784cb5c3f0ebe72a1e15f12a88f57e11290
    method command
    watches [ "compositor/templar-comp/src/**", "session/units/user/templar-comp.service" ]
    derived_from [ @legeos.observation.desktop-freezes-20261001-compositor-main-thread-blocked ]
