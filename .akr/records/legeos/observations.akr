    author "dk"
}

record legeos.observation.fresh-store-wal-switch-races-without-a-busy-handler/1 : observation {
    title "Two daemons opening one fresh session.db still raced, at the WAL switch: SQLite skips the busy handler for a journal-mode change while another connection holds a shared lock"
    state superseded
    scope [ path "crates/lege-state/**" ]
    statement """
        lege-state's race test (a_fresh_store_survives_several_daemons_opening_it_at_once) failed 5 of 5 runs on 2026-09-07 with 'switching to WAL: database is locked', having passed in an earlier gate the same day. The earlier fix (a838247) made the migration transaction IMMEDIATE and installed a 5 s busy timeout, but the timeout was set after the journal_mode=WAL pragma, and moving it first did not help either: SQLite returns SQLITE_BUSY at once, without invoking the busy handler, when a connection needs the exclusive lock a journal-mode change takes while another connection holds a shared lock on the same file. lege-state now retries the WAL pragma while the database reports busy or locked, for up to five seconds, and every step of open() carries a context string; the test then passed 10 of 10 runs.
        """
    observed_at git:9855da2f2647f2baa7473b2dda60b20dd702a046
    method command
    watches [ "crates/lege-state/src/lib.rs" ]
    derived_from [
        @legeos.observation.two-daemons-opening-one-fresh-state-db-raced-its-migrations
    ]
}

