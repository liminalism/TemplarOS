akr 0.1
project legeos

record legeos.observation.a-directory-whose-contents-changed-kept-a-stale-modification-time/1 : observation {
    title "The live watcher never refreshed a directory's own metadata when its contents changed, so folders showed modification times from before their contents changed"
    state verified
    scope [
        path "crates/lege-file-index/src/btrfs_delta.rs",
        path "crates/lege-file-index/src/mutation.rs",
        path "crates/lege-file-index/src/watch.rs"
    ]
    statement """
        Three of the four Btrfs correctness-gate failures were bugs in shared index code that the delta merely exercised, and two of those were live on the inotify watcher's own path, where they had gone unnoticed because the watcher's tests compared namespaces and not metadata. (1) A write through one name of a hard link left the index's other names holding stale size and mtime; the watcher reaches this through IN_MODIFY on a linked file. Fixed by mirroring a write to an inode's other names, gated on nlink > 1 so the common case costs one probe on entries_object. (2) A move onto an already-occupied path aborted the batch with UNIQUE constraint failed: entries.root_id, entries.path_bytes; the watcher reaches this through rename(2) over an existing destination, which is what every editor's atomic save does. Fixed by having the move take the occupant's row over. (3) The largest one: a directory whose entries changed never had its own metadata re-read, so its mtime and ctime in the index were from before its contents changed — a folder in a file manager showing a modification time older than the files it contains. inotify names the child; nothing tells the index the parent's own mtime moved. Found by upgrading tests/watch.rs to the same field-for-field metadata comparison the delta harness uses, which failed immediately with exactly one differing row in each nested-rename test: the directory the rename happened in. Fixed by having WatchOwner::pump re-read a directory that gained or lost an entry, one extra lstat per pump, so unpacking 10,000 files into a directory costs one stat rather than 10,000. The same metadata upgrade also caught a retarget_subtree path with a trailing separator from Path::join(""), equal to its sibling for every Path comparison but a different byte string as an index key; six hand-written test streams describing sequences no kernel emits, which had been passing by agreeing with each other rather than with the filesystem; and one unit test that asserted the mtime bug outright. There is now a single metadata-comparison definition (crates/lege-file-index/tests/support/entry_facts.rs) shared by the Btrfs harness, the delta unit tests and the watcher tests, so the asymmetry that hid all of this cannot reopen. The general lesson is that a namespace-only comparison cannot see a whole class of index defect, and the delta lane's value was not confined to the backend it was measuring.
        """
    observed_at git:8d74542b146fa8399817bd377094157b7bd1bb97
    method instrumented
    watches [ "crates/lege-file-index/src/watch.rs", "crates/lege-file-index/tests/watch.rs" ]
}

record legeos.observation.a-pass-that-could-not-read-every-directory-still-commits-current/1 : observation {
    title "Unreadable and unwatchable directories do not make a scan incomplete, so the index claims Current over subtrees it never saw"
    state verified
    scope [
        path "crates/lege-file-index/src/generation.rs",
        path "crates/lege-file-index/src/reconcile.rs"
    ]
    statement """
        ScanSession::commit (crates/lege-file-index/src/generation.rs:291-293) derives completeness as `limited.is_none() && permission_denied == 0 && !cancel.is_cancelled()`. The `unreadable_dirs` counter is incremented by ScanSession::note_unreadable (generation.rs:187) and reported in the outcome (generation.rs:315), but is never consulted by that test. Reconcile's Walk::note_unreadable (reconcile.rs:167-173) sets its own ReconcileReport.complete = false and then calls session.note_unreadable(denied) with denied = false for a directory that could not be armed or read for any non-permission reason. The result is that the ReconcileReport knows the pass was partial while the committed generation does not: the root commits as RootState::Current, and collect_tombstones — which runs only when complete — treats every row it failed to observe as deleted. On the reference laptop this is not hypothetical, because 189,089 home directories against a 125,037 watch budget means arm_recursive refuses watches and stops descending on every single pass. This breaks the invariant the crate states for itself, that nothing enters Current but a complete pass, and acceptance gate 3 of docs/planning/shared-incremental-file-index.md, that overflow, offline and partial states cannot be mistaken for current complete data. The watcher lane added a compensating check in WatchLoop::repair that compares watches_refused across a pass and re-marks the root stale, but the defect is in the core: unreadable_dirs must be folded into commit()'s completeness test, which also changes tombstone collection for every caller.
        """
    observed_at git:be57fadad93f5918c55ebe3c216807fa9e7ff73c
    method instrumented
    watches [
        "crates/lege-file-index/src/generation.rs",
        "crates/lege-file-index/src/reconcile.rs"
    ]
    derived_from [ @legeos.work.adaptive-index-maintenance ]
}

record legeos.observation.a-send-stream-names-paths-relative-to-the-subvolume-not-the-index-root/1 : observation {
    title "The delta decoder joined subvolume-relative paths onto the index root, so almost every change was dropped as vanished"
    state verified
    scope [ path "crates/lege-file-index/src/btrfs_delta.rs" ]
    statement """
        The Btrfs delta correctness gate was run for the first time against a real loopback fixture on 2026-09-04 and failed. btrfs send emits every path relative to the root of the snapshotted subvolume, but btrfs_delta::to_mutations resolved each one with target.root_path.join(relative) (btrfs_delta.rs:924) and FsMetadata lstat'd it under the same index root (btrfs_delta.rs:760). The fixture snapshots @home while indexing @home/bench, so a created file arrived as bench/inbox/new000.txt and was resolved to @home/bench/bench/inbox/new000.txt, which does not exist; the path was then counted as vanished and silently dropped. a_delta_equals_a_fresh_scan failed at the first non-empty scenario with 102 differences, every new path missing from the delta index and the parent directory differing only in mtime because nothing had been applied; the edge-case test failed with 933 differences and a report of 9 planned paths, 1 mutation and 8 vanished. The no-change scenario passed, because an empty delta is the correct answer there, which is why the defect looked like a working backend in unit tests. The existing unit tests could not catch it: they set root_path to /home/dk and supply stream paths implicitly relative to that same directory, assuming the subvolume root and the index root are the same path. That assumption is false in production as well as in the fixture, because @home is the subvolume and mounts at /home, so the index root is /home/<user>, a strict subdirectory; a delta of @home also names other users' paths, which must be skipped rather than applied to this user's root. Two distinct counters are needed, because conflating a path outside the index root with a path that vanished from disk is what hid the bug.
        """
    observed_at git:3afa096e88aa3cae6b90ea002aa1471839716872
    method command
    watches [ "crates/lege-file-index/src/btrfs_delta.rs" ]
    derived_from [ @legeos.work.adaptive-index-maintenance ]
}

record legeos.observation.a-snapshot-did-not-say-which-change-position-it-was-consistent-with/1 : observation {
    title "A consumer had no way to learn the change-log position its snapshot was taken at"
    state verified
    statement """
        `SnapshotManifest` carried no sequence, so a consumer synchronising a subscription had to call `changes_since(0, 1)` after taking the snapshot and read `next_seq` — two calls, with everything committed between them landing in neither the frame nor the stream. That is exactly the read/subscribe race @legeos.decision.event-driven-service-authorities forbids. Worse, the workaround does not survive its own success: once the bounded change log has been pruned, sequence 0 is below the retained floor and `changes_since(0, …)` answers `SnapshotRequired` rather than a position, so a consumer that fell behind could not resnapshot its way back either. Found by writing the contract as one consumer-shaped sequence (`crates/lege-file-index/tests/consumer_contract.rs`) rather than as separate unit tests, each of which passed. Fixed by `SnapshotManifest.snapshot_seq`, read inside `write_snapshot` before the rows and serde-defaulted so no signature changes.
        """
    observed_at git:eb00239b41cfcb615f01b34bdb2903ed16f4f51f
    method command
    watches [
        "crates/lege-file-index/src/snapshot.rs",
        "interfaces/dbus/org.legeos.Files.Index1.xml"
    ]
    derived_from [ @legeos.decision.event-driven-service-authorities ]
}

record legeos.observation.agent-smoke-test-emptied-a-real-volume-trash/1 : observation {
    title "A Trash1 smoke test run against the real session bus emptied the user's actual volume trash"
    state verified
    scope [ path "cli/lege/**", path "services/lege-filed/**" ]
    statement """
        While smoke-testing `lege trash empty --yes` end to end, the implementing agent constructed TrashApi with TrashMounts::System instead of TrashMounts::Fixed, so the sweep read the machine's real mount table, found /media/dk/4668959A68958977/.Trash-1000, and permanently deleted its one entry — a folder named `target` (a Rust build directory, regenerable) trashed on 2026-08-30. Unrecoverable. The code behaved as designed; the harness choice was the fault: TrashMounts::Fixed exists precisely so tests cannot reach real disks, every committed test uses it, and the offending smoke script was removed rather than left as a trap. Standing rule going forward: any end-to-end exercise of destructive file operations must run against fixture mounts (TrashMounts::Fixed, a throwaway HOME and XDG_DATA_HOME) — never the developer host's real mount table.
        """
    observed_at git:d26a90adb035772b2ee2542a5554308987e4cb6f
    method manual
}

record legeos.observation.btrfs-send-needs-privilege-but-snapshotting-does-not/1 : observation {
    title "A user can take the read-only checkpoints but cannot send the delta between them, so the delta backend is split across the privilege boundary"
    state verified
    scope [ path "services/lege-hostd/src/index_checkpoint.rs" ]
    statement """
        Probed on a loopback Btrfs fixture with the declared LegeOS subvolume layout (@, @home, @var, @snapshots, @deployments), kernel 6.17, btrfs-progs 6.16, by running scripts/btrfs-index-fixture.sh probe as root and comparing against the same operations run as uid 1000. As the unprivileged owner of the subvolume: btrfs subvolume snapshot -r succeeds, and a second read-only snapshot succeeds. btrfs send --no-data -p fails, and btrfs subvolume delete fails, the latter despite the filesystem being mounted with user_subvol_rm_allowed. Run as root the same send produced 450 bytes of metadata delta, confirming the operation itself is sound and only the privilege is missing. The consequence for the architecture is that the delta backend cannot live wholly in the per-user lege-filed: taking a checkpoint could, but producing the delta between two of them requires CAP_SYS_ADMIN and must go through lege-hostd, as must discarding a spent checkpoint. That in turn forces the transport question, because the stream lege-hostd writes is mode 0600 and root-owned while the daemon that must read it runs as the user, and a metadata delta names every path under @home so it must not be made world-readable.
        """
    observed_at git:3afa096e88aa3cae6b90ea002aa1471839716872
    method command
    watches [ "services/lege-hostd/src/index_checkpoint.rs", "scripts/btrfs-index-fixture.sh" ]
    derived_from [ @legeos.work.adaptive-index-maintenance ]
}

record legeos.observation.delta-catch-up-cost-tracks-the-change-and-beats-a-crawl-except-on-bulk-creation/1 : observation {
    title "A Btrfs metadata delta beats a crawl by 22x to 53x on renames, deletes and quiet periods, and ties it when the change is as large as the tree"
    state superseded
    scope [ path "crates/lege-file-index/src/btrfs_delta.rs" ]
    statement """
        First real measurement of btrfs send --no-data as an index catch-up source, run as root against a loopback Btrfs fixture on 2026-09-04 after the path-rebasing fix at 8d12f1b. Tree of 1,000 files, 1,540 entries, initial acquisition 122 ms. Delta versus recursive crawl, wall clock, delta cost including the send itself: nothing at all changed, 5.1 ms against 113.5 ms, 22.3x; 100 new files, 35.7 ms against 101.8 ms, 2.8x; an hour of desktop use, 28.1 ms against 121.6 ms, 4.3x; a build-shaped burst of 5,000 files, 2,120.2 ms against 2,051.2 ms, 1.0x; a whole-directory rename, 55.4 ms against 2,945.9 ms, 53.2x; a mass delete, 108.2 ms against 2,379.8 ms, 22.0x; one 1 GiB file added, 51.3 ms against 862.7 ms, 16.8x. The build-shaped burst tying the crawl is the architecture working rather than failing: the delta creates 5,000 entries in a 1,540-entry tree, so the change is larger than the tree and a cost proportional to change must equal a cost proportional to tree. The 1 GiB row is the clearest evidence that --no-data holds: the delta pays 51 ms for a file whose content it never reads. The scaling question is NOT yet answered, because the run panicked on a correctness failure before reaching the larger tree sizes, so every figure here is from the smallest tree and the claim that delta cost stays flat as the tree grows while the crawl grows with it remains unmeasured. Two correctness failures remain at this commit: a hard link's other names keep stale size and mode because the stream names only the path that was written, and applying the edge-case delta violates the entries UNIQUE constraint on (root_id, path_bytes) when a move lands on an occupied path.
        """
    observed_at git:8d12f1bca51525856eb16d47b48f1618818fc322
    method command
    watches [ "crates/lege-file-index/src/btrfs_delta.rs" ]
    derived_from [ @legeos.work.adaptive-index-maintenance ]
}

record legeos.observation.delta-catch-up-cost-tracks-the-change-and-beats-a-crawl-except-on-bulk-creation/2 : observation {
    title "Delta catch-up cost is flat in tree size while a crawl grows with it, reaching 847x on a 153,000-entry tree and reading no file data at all"
    state superseded
    scope [ path "crates/lege-file-index/src/btrfs_delta.rs" ]
    statement """
        The decisive measurement, run as root against a loopback Btrfs fixture on 2026-09-04 at commit 3287462, across three tree sizes and eight scenarios. The architectural requirement was that delta cost track the size of the change rather than the size of the tree, and it is met: for a fixed change the delta is flat while the crawl grows with the tree. 100 new files costs 29.4 ms at 1,540 entries, 28.6 ms at 15,339 and 30.7 ms at 153,327, against a crawl of 77.0, 1,551.8 and 17,101.5 ms, so the speedup rises 2.6x, 54.2x, 557.0x purely because the crawl gets worse. Truncate-chmod-rewrite costs 14.0, 13.9, 12.9 ms against 520.2, 1,396.1 and 10,896.0 ms, reaching 847.3x. A whole-directory rename costs 33.7, 49.7, 37.7 ms against 425.6, 1,875.2, 18,218.6 ms, reaching 483.1x. Adding one 1 GiB file costs 32.2, 40.0, 39.0 ms against 490.2, 1,331.2, 14,466.8 ms: the delta pays a constant for a file whose content it never reads, which is --no-data working as documented. Doing nothing at all costs 3.7, 10.8, 61.7 ms against 82.8, 1,031.1, 14,864.5 ms. Read I/O is the starkest column: the delta reads 0 bytes in every one of the twenty-four rows, while the crawl reads up to 159.0 MiB. Two scenarios are the honest exceptions, both where the change approaches or exceeds the tree. A build-shaped burst of 5,000 files runs 0.4x at 1,540 entries, 1.6x at 15,339 and 15.7x at 153,327: it is slower than a crawl only when the change is several times the tree. A mass delete of 50,003 paths at 153,327 entries costs 5,717.7 ms against 13,266.1, only 2.3x, because 50,003 mutations is genuine work at about 0.095 ms each. Both behave exactly as a cost proportional to change must. This supersedes revision 1, whose figures came from the smallest tree only because the run panicked before reaching the larger ones.
        """
    observed_at git:32874629dcb51fcf1e3a4b1a54ec7ac5e0d4c1a1
    method command
    watches [ "crates/lege-file-index/src/btrfs_delta.rs" ]
    derived_from [ @legeos.work.adaptive-index-maintenance ]
    supersedes [
        @legeos.observation.delta-catch-up-cost-tracks-the-change-and-beats-a-crawl-except-on-bulk-creation/1
    ]
}

record legeos.observation.delta-catch-up-cost-tracks-the-change-and-beats-a-crawl-except-on-bulk-creation/3 : observation {
    title "Delta catch-up cost is flat in tree size while a crawl grows with it, reaching 847x on a 153,000-entry tree and reading no file data at all"
    state superseded
    scope [ path "crates/lege-file-index/src/btrfs_delta.rs" ]
    statement """
        The decisive measurement, run as root against a loopback Btrfs fixture on 2026-09-04 at commit 3287462, across three tree sizes and eight scenarios. The architectural requirement was that delta cost track the size of the change rather than the size of the tree, and it is met: for a fixed change the delta is flat while the crawl grows with the tree. 100 new files costs 29.4 ms at 1,540 entries, 28.6 ms at 15,339 and 30.7 ms at 153,327, against a crawl of 77.0, 1,551.8 and 17,101.5 ms, so the speedup rises 2.6x, 54.2x, 557.0x purely because the crawl gets worse. Truncate-chmod-rewrite costs 14.0, 13.9, 12.9 ms against 520.2, 1,396.1 and 10,896.0 ms, reaching 847.3x. A whole-directory rename costs 33.7, 49.7, 37.7 ms against 425.6, 1,875.2, 18,218.6 ms, reaching 483.1x. Adding one 1 GiB file costs 32.2, 40.0, 39.0 ms against 490.2, 1,331.2, 14,466.8 ms: the delta pays a constant for a file whose content it never reads, which is --no-data working as documented. Doing nothing at all costs 3.7, 10.8, 61.7 ms against 82.8, 1,031.1, 14,864.5 ms. Read I/O is the starkest column: the delta reads 0 bytes in every one of the twenty-four rows, while the crawl reads up to 159.0 MiB. Two scenarios are the honest exceptions, both where the change approaches or exceeds the tree. A build-shaped burst of 5,000 files runs 0.4x at 1,540 entries, 1.6x at 15,339 and 15.7x at 153,327: it is slower than a crawl only when the change is several times the tree. A mass delete of 50,003 paths at 153,327 entries costs 5,717.7 ms against 13,266.1, only 2.3x, because 50,003 mutations is genuine work at about 0.095 ms each. Both behave exactly as a cost proportional to change must. The full table is docs/measurements/btrfs-delta-measured.md, written by the harness itself. This supersedes revision 1, whose figures came from the smallest tree only because the run panicked before reaching the larger ones; it also corrects revision 2, which cited a commit hash whose tail was not the real one.
        """
    observed_at git:3287462fb2127ca035dfb6eb267122aaf27520aa
    method command
    watches [ "crates/lege-file-index/src/btrfs_delta.rs" ]
    derived_from [ @legeos.work.adaptive-index-maintenance ]
    supersedes [
        @legeos.observation.delta-catch-up-cost-tracks-the-change-and-beats-a-crawl-except-on-bulk-creation/2
    ]
}

record legeos.observation.delta-catch-up-cost-tracks-the-change-and-beats-a-crawl-except-on-bulk-creation/4 : observation {
    title "btrfs send --no-data is flat in tree size and proportional to the change, and the delta beats a crawl by up to 647x"
    state verified
    scope [ path "crates/lege-file-index/src/btrfs_delta.rs" ]
    statement """
        The final measurement, run as root against a loopback Btrfs fixture on 2026-09-04 at commit 8d74542, across three tree sizes and eight scenarios, with the correctness gate passing for the first time. The architectural question this lane existed to answer was whether btrfs send itself is proportional to the change rather than to the tree, because a send proportional to the tree reduces the whole idea to a cheaper crawl. It is flat. The same change sent between snapshots of trees two orders of magnitude apart costs: nothing at all, 1.6 / 1.7 / 1.9 ms with a byte-identical 113 B stream; a whole-directory rename (4 paths), 2.4 / 2.4 / 2.8 ms, 481 B; an hour of desktop use (67 paths), 4.1 / 5.5 / 5.9 ms, 13.6 KiB; 100 new files (102 paths), 3.7 / 5.8 / 7.0 ms, 34.0 KiB; a build burst (7,007 paths), 128.7 / 148.7 / 149.3 ms, 2.7 MiB; one 1 GiB file (2 paths), 20.7 / 29.2 / 20.3 ms, 408.4 KiB. Stream size is identical across tree sizes in every row; residual send drift across a hundredfold tree is under 4 ms. Send is proportional to the change instead: at 153,327 entries, 1.9 ms at 0 changed paths, 2.8 at 4, 5.9 at 67, 7.0 at 102, 149.3 at 7,007 and 1,185.4 at 50,003 — roughly 24 microseconds per changed path above a 2 ms floor. End to end at 153,327 entries: an hour of desktop use 30.4 ms against 19,657.6 (647x), 100 new files 37.8 against 19,198.3 (508x), a whole-directory rename 49.4 against 19,577.1 (396x), truncate-chmod-rewrite 46.8 against 16,865.9 (361x), one 1 GiB file 39.1 against 11,329.3 (290x), nothing at all 71.1 against 17,588.2 (248x), a build burst 1,269.1 against 18,636.6 (15x), a mass delete of 50,003 rows 6,095.2 against 14,202.7 (2.3x). The two weak rows are the architecture working, not failing: the build burst is slower than a crawl only on the 1,540-entry tree (0.4x) and barely ahead at 15,339 (1.3x), a crossover of a few thousand entries that no real home reaches, and 2,001 of its paths were excluded by coverage policy before reaching the index; the mass delete's 2.3x is 4,910 of its 6,095 ms spent writing 50,003 tombstones, which the crawl arm pays too. --no-data holds for large files but scales with extents rather than bytes: a 1 GiB file yields 408.4 KiB in 8,200 commands, about one UPDATE_EXTENT per 128 KiB extent, so a dormant window writing 100 GiB costs on the order of 40 MiB of stream and there should be a cap above which the backend gives up and asks for a reconcile. The delta arm reads 0 block-layer bytes in all 24 rows against the crawl's 116-159 MiB, with the caveat that read_bytes is /proc/self/io of the harness process and btrfs send is a child, so the send's own reads are unmeasured; its 5.9 ms wall time bounds them to a few MiB. The full table is docs/measurements/btrfs-delta-measured.md, written by the harness. This supersedes revision 3, whose figures came from the third of five runs, before the last two correctness bugs were fixed.
        """
    observed_at git:8d74542b146fa8399817bd377094157b7bd1bb97
    method instrumented
    watches [
        "crates/lege-file-index/src/btrfs_delta.rs",
        "crates/lege-file-index/tests/btrfs_delta_fixture.rs"
    ]
    derived_from [ @legeos.work.adaptive-index-maintenance ]
    supersedes [
        @legeos.observation.delta-catch-up-cost-tracks-the-change-and-beats-a-crawl-except-on-bulk-creation/3
    ]
}

record legeos.observation.deployments-subvolume-not-declared-by-repart/1 : observation {
    title "The repart declaration creates @ @home @var @snapshots, but the update engine stages candidates under @deployments/<id>, which nothing declares"
    state superseded
    scope [
        path "distro/image/mkosi.repart/**",
        path "services/lege-hostd/src/deploy.rs",
        path "services/lege-hostd/src/updates.rs"
    ]
    statement """
        distro/image/mkosi.repart/10-root.conf declares Subvolumes=/@ /@home /@var /@snapshots, while services/lege-hostd/src/deploy.rs and updates.rs stage a candidate deployment as a snapshot under @deployments/<id>. No declaration creates @deployments, so a fresh image and the engine disagree about the storage layout. The campaign freezes @deployments/<id> as authoritative and has the layout declaration add it.
        """
    observed_at git:8b284c9147b70b4f03bb7c48ec993647e2e4df31
    method observation
    watches [
        "distro/image/mkosi.repart/**",
        "services/lege-hostd/src/deploy.rs",
        "services/lege-hostd/src/updates.rs",
        "distro/deploy/layout.toml"
    ]
    blocks [ @legeos.work.reference-machine-provisioning ]
}

