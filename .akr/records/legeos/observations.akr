record legeos.observation.hostd-hands-a-privileged-fd-through-deltaopen/1 : observation {
    title "legeos.observation.hostd-hands-a-privileged-fd-through-deltaopen"
    state superseded
    statement """
        lege-hostd can now hand a privileged file descriptor to the per-user session daemon, through
        one narrow purpose-built method rather than a general facility.
        org.legeos.Host.IndexCheckpoint1.DeltaOpen returns `stream` as type="h" — the first type="h"
        argument on any org.legeos.Host.* interface, which is precisely what
        @legeos.question.no-route-for-a-privileged-fd-to-reach-the-per-user-daemon recorded as absent.
        The call is polkit-gated on org.legeos.host.index-checkpoint
        (services/lege-hostd/src/api.rs:307 and siblings; distro/policy/polkit/org.legeos.host.policy:71).
        hostd writes the btrfs send stream, opens it, and unlinks it before returning, so the bytes
        reach exactly one caller and no path survives the call: a metadata delta names every path under
        @home, which is why the written file is 0600 root-owned and why the path form of Delta is not
        usable by an unprivileged consumer. The interface's own comment frames this as the pattern
        org.legeos.Files.Index1.OpenSnapshot already used on the session bus, with only the bus being
        new. The receiving daemon never widens its privilege: it gets a read handle to a stream it could
        not have produced, and nothing else. The fanotify half of the same question was not unblocked by
        this route; it was declined on merit by
        @legeos.decision.inotify-remains-the-index-event-backend, which keeps inotify as the index's
        event backend and ships fanotify behind EventSource as a measured, unadopted alternative.
        """
    observed_at git:e6e1b1c3523004f2eef22aa3bfd2dc2abae4a06a
    method manual
    watches [
        "interfaces/dbus/org.legeos.Host.IndexCheckpoint1.xml",
        "services/lege-hostd/src/api.rs"
    ]
    resolves [ @legeos.question.no-route-for-a-privileged-fd-to-reach-the-per-user-daemon/1 ]
}

record legeos.observation.hostd-hands-a-privileged-fd-through-deltaopen/2 : observation {
    title "legeos.observation.hostd-hands-a-privileged-fd-through-deltaopen"
    state verified
    statement """
        lege-hostd can now hand a privileged file descriptor to the per-user session daemon, through
        one narrow purpose-built method rather than a general facility.
        org.legeos.Host.IndexCheckpoint1.DeltaOpen returns `stream` as type="h" — the first type="h"
        argument on any org.legeos.Host.* interface, which is precisely what
        @legeos.question.no-route-for-a-privileged-fd-to-reach-the-per-user-daemon recorded as absent.
        The call is polkit-gated on org.legeos.host.index-checkpoint
        (services/lege-hostd/src/api.rs:307 and siblings; distro/policy/polkit/org.legeos.host.policy:71).
        hostd writes the btrfs send stream, opens it, and unlinks it before returning, so the bytes
        reach exactly one caller and no path survives the call: a metadata delta names every path under
        @home, which is why the written file is 0600 root-owned and why the path form of Delta is not
        usable by an unprivileged consumer. The interface's own comment frames this as the pattern
        org.legeos.Files.Index1.OpenSnapshot already used on the session bus, with only the bus being
        new. The receiving daemon never widens its privilege: it gets a read handle to a stream it could
        not have produced, and nothing else. The fanotify half of the same question was not unblocked by
        this route; it was declined on merit by
        @legeos.decision.inotify-remains-the-index-event-backend, which keeps inotify as the index's
        event backend and ships fanotify behind EventSource as a measured, unadopted alternative.
        """
    observed_at git:e6e1b1c3523004f2eef22aa3bfd2dc2abae4a06a
    method manual
    watches [
        "interfaces/dbus/org.legeos.Host.IndexCheckpoint1.xml",
        "services/lege-hostd/src/api.rs"
    ]
    resolves [ @legeos.question.no-route-for-a-privileged-fd-to-reach-the-per-user-daemon ]
    supersedes [ @legeos.observation.hostd-hands-a-privileged-fd-through-deltaopen/1 ]
}

record legeos.observation.hostd-stages-candidates-outside-the-declared-deployments-subvolume/1 : observation {
    title "hostd stages candidate deployments under /var/lib/templaros/hostd/deployments, not the @deployments/{id} that layout.toml and the provisioner declare"
    state verified
    statement """
        At 50af378. distro/deploy/layout.toml:89 declares subvolume_template = "@deployments/{id}" and installer/provision.sh (fstab block around :1219-1231) mounts @deployments at /.deployments. templar-hostd's real configuration sets deployments_dir: state_dir.join("deployments") with state_dir = root/var/lib/templaros/hostd (services/templar-hostd/src/main.rs:47,65), i.e. inside the shared @var subvolume, and UpdateLedger::candidate_deployment uses candidate_dir(id).display() as the Deployment's subvolume (services/templar-hostd/src/updates.rs:374-378), which the boot-entry writers put into rootflags=subvol=. Only fixture tests use @deployments/{id}. [INFERENCE, not run on hardware] a staged candidate's entry would name subvol=/var/lib/templaros/hostd/deployments/<id>, a path relative to the mounted root rather than to the btrfs top level (where it is @var/lib/...), so the candidate would not boot; and a candidate kept in @var lives in the same subvolume as the persistent state it is supposed to be independent of. Separately, templar dev deploy keeps its own rollback snapshot at /var/lib/templaros/snapshots/root-before-<set> (cli/templar/src/dev/gates.rs:278-284), a second rollback location.
        """
    observed_at git:50af3784cb5c3f0ebe72a1e15f12a88f57e11290
    method observation
    watches [
        "services/templar-hostd/src/main.rs",
        "services/templar-hostd/src/updates.rs",
        "services/templar-hostd/src/deploy.rs",
        "services/templar-hostd/src/boot_entries.rs",
        "distro/deploy/layout.toml",
        "installer/provision.sh",
        "cli/templar/src/dev/gates.rs"
    ]
    author "dk"
}

record legeos.observation.identity-never-resolves-in-a-nested-session/1 : observation {
    title "Identity never resolves in a nested session, so the fan, the chip count, grouping and the launcher's running count can only be seen offscreen or on hardware"
    state verified
    scope [
        path "crates/templar-window/src/task.rs",
        path "shell/templar-shell/src/taskbar.rs"
    ]
    statement """
        Windows launched through `templar app launch` inside the nested session arrive with verified_identity false (identity is the cgroup's, and the nested session has no per-app cgroup), so task::units gives each window its own Unknown unit and never merges two windows of one application. Every island behaviour that depends on a unit with more than one window (the fan, the count badge, within-unit switching, the launcher's 'N running') is therefore invisible nested; it is exercised by the offscreen fan render and by the user's hands-on on hardware, and nothing else.
        """
    observed_at git:5f83fdc6512063394fda3dfbbf08e0c35dc1a4a9
    method manual
    watches [
        "shell/templar-shell/src/taskbar.rs",
        "crates/templar-window/src/task.rs",
        "scripts/nested-session.sh"
    ]
}

record legeos.observation.index-baseline-2026-09-04/1 : observation {
    title "Index baseline measurements (2026-09-04): watch-budget shortfall confirmed, idle-wakeup fix confirmed at 0"
    state verified
    statement """
        Measured on the reference laptop (kernel 6.17, ext4) via `cargo run -q -p xtask -- index-bench`: $HOME holds 189,094 post-skip directories (RootPolicy::default_home), 1.51x WatchBudget::max_watches (125,037) and 0.76x the whole-kernel fs.inotify.max_user_watches allowance (250,074) — confirming a home root cannot stay fully watched under inotify on this machine by construction. The stale 157,283 figure previously in watch.rs's doc comment (recorded 2026-09-03) was simply out of date, not a measurement-methodology difference (find vs RootPolicy and depth-clamping are both ruled out); corrected in commit 6c6a79b. Idle-cost headline number measured as a real before/after pair across commit 6522e10 (an idle index watcher sleeps rather than wakes twice a second): watcher-thread schedstat pcount and voluntary_ctxt_switches over a 60s idle window went from 121/120 (pre-fix, built from worktree at be57fad) to 0/0 (post-fix, HEAD). 100k-entry workload suite: initial index 28,389 entries/s, warm 100-result search p50 0.96ms/p95 1.27ms, snapshot of 90,152 entries in 1.28s (12.2MB). 2,000,000-entry case not run (harness supports it via --allow-two-million --release; left for a follow-up). Full detail: docs/measurements/index-baseline-2026-09-04.md.
        """
    observed_at git:6c6a79b617b1e387f5ae64da9bbee54a021e30a5
    method command
    depends_on [ @legeos.work.adaptive-index-maintenance ]
}

record legeos.observation.index-change-signals-never-fire/1 : observation {
    title "Index1's GenerationAdvanced and RootStateChanged signals are implemented but never wired, so no client can observe the index changing"
    state superseded
    scope [
        path "services/lege-filed/src/index_host.rs",
        path "services/lege-filed/src/main.rs"
    ]
    statement """
        Index1Signals in services/lege-filed/src/index_host.rs implements index_core::ChangeSink and can emit both GenerationAdvanced and RootStateChanged, but nothing calls Index::set_change_sink (crates/lege-file-index/src/lib.rs) in this build; its own doc comment records the gap. Both signals are therefore dead: a client watching the index for changes receives nothing, and every consumer must poll. This blocks the adaptive-observer design, whose CatchingUp/Resuming step depends on telling an arriving consumer that a fresher generation has committed. A second defect is latent in the same type: Index1Signals calls bare tokio::spawn, but ChangeSink is a synchronous trait invoked from the plain std::thread watcher loop (services/lege-filed/src/watcher.rs), and tokio::spawn panics when called outside a runtime context. Wiring the sink without also capturing a tokio::runtime::Handle would therefore panic on the first mutation, unwind the watcher thread, and leave the daemon running but permanently blind — a worse failure than the dead signal it replaces.
        """
    observed_at git:be57fadad93f5918c55ebe3c216807fa9e7ff73c
    method observation
    watches [ "services/lege-filed/src/index_host.rs", "services/lege-filed/src/main.rs" ]
    derived_from [ @legeos.work.file-index-maintenance ]
}

