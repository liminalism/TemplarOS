record legeos.constraint.native-lubuntu-is-the-development-environment/1 : constraint {
    title "LegeOS development and validation run in the native Lubuntu installation, not WSL"
    state active
    scope [ all ]
    topic development-environment
    statement """
        The machine's native Lubuntu installation is the authoritative LegeOS development and validation environment. A Windows-hosted request may use WSL for agent-only helpers such as OptMem, but WSL results must not be treated as LegeOS build, test, packaging, runtime, hardware, or deployment evidence.
        """
    rationale """
        The working LegeOS toolchain, system dependencies, live-session boundary and reference-hardware context belong to the Lubuntu partition. Treating an incidental Windows/WSL request environment as the project host creates false setup work and invalid evidence.
        """
    author "GitHub Uploader"
}

record legeos.constraint.one-provider-per-role/1 : constraint {
    title "Exactly one selected provider per exclusive system role may autostart"
    state superseded
    scope [
        path "crates/lege-session-core/src/autostart.rs",
        path "crates/lege-session-core/src/providers.rs",
        path "crates/lege-types/src/provider.rs"
    ]
    topic one-provider-per-role
    statement """
        For every ProviderRole (network-status-ui, notification-server, file-chooser, file-manager, lock-screen, association-broker, clipboard-manager, power-manager, screenshot-service, input-method, portal-backend, greeter) installing a second provider never silently starts both; the user or distribution policy selects one and only that one autostarts.
        """
    measure """
        ProviderRegistry::may_autostart unit tests; `lege doctor` reports every role's resolution.
        """
    rationale """
        The nm-applet + nm-tray2 duplicate is the archetype; provider selection replaces per-applet XDG overrides.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            'Declarative system-provider selection' and the network-status-ui example.
            """
    }
}

