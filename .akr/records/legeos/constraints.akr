akr 0.1
project legeos

record legeos.constraint.first-release-scope/1 : constraint {
    title "The first release does not attempt a custom kernel, libc, package format/manager, display protocol, object filesystem, universal checkpointing, all NVIDIA generations, an app store, phone/tablet/server editions, or third-party shell extensions"
    state active
    scope [ all ]
    topic first-release-scope
    statement """
        Until the five first-release claims are proven, LegeOS keeps systemd, cgroup v2, APT/Debian packages, standard filesystems, PipeWire, NetworkManager, BlueZ, Mesa and the upstream NVIDIA userspace stack. It does not build: a Linux kernel fork, a new package format or manager, a new libc/basic userland, replacement networking/Bluetooth/audio stacks, a new display protocol, a semantic/object filesystem replacing paths, transparent checkpointing of arbitrary applications, support for every old NVIDIA generation, a complete alternative application store, phone/tablet/server editions, or extensions/third-party shell plugins.
        """
    measure """
        Any proposal touching those areas is rejected at review unless this constraint is superseded.
        """
    rationale """
        Those would consume most of the effort while contributing little to the actual goals; the defining ideas live above the kernel and below applications.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            'What the first release should not attempt'.
            """
    }
}

record legeos.constraint.identity-and-launch-safety/1 : constraint {
    title "Identity comes from the launch cgroup, never from a client's self-declared app_id; Exec= is never run through a shell; the governor is observe-only until traces are reviewed and never selects a victim by memory size alone"
    state superseded
    scope [
        path "crates/lege-appd/**",
        path "crates/lege-window/**",
        path "services/lege-resourced/**"
    ]
    topic identity-launch-governor-safety
    statement """
        (1) A window's application identity is resolved PID -> cgroup -> instance -> canonical AppId; client claims (Wayland app_id, WM_CLASS, sandbox id) can only lower confidence (claim mismatch) or, when unique, yield claim-only confidence — never override a verified launch, and privileged actions require verified-launch. (2) Applications are launched as the registered executable plus an argument vector in a dedicated systemd unit; Exec= lines are parsed, never passed to a shell. (3) lege-resourced ships observe-only; enforcement (memory.high, reclaim, checkpoint, cgroup.kill) is enabled in stages after recorded traces are reviewed; the victim score weighs growth, PSI contribution, foreground/visible state, unsaved work and disposability, never resident size alone; session-critical units are never candidates.
        """
    measure """
        Unit tests in lege-appd (registered_cgroup_beats_claims), lege-resourced (protected_and_foreground_apps_are_not_victims, critical_pressure_kills_only_after_the_delay); the daemon's default mode is ObserveOnly.
        """
    rationale """
        Prevents an application from claiming another's identity; avoids the usual partial-process wreckage and browser-killed-because-biggest failure.
        """
    source {
        kind external
        role origin
        document "planning-subsequent-shape"
        use """
            Section 3 'Identity rule', section 4 (never execute Exec= through a shell), section 5 (observe-only first; victim score).
            """
    }
}

