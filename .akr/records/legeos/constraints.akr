record legeos.constraint.services-not-indicators/1 : constraint {
    title "System behaviour belongs in services; tray icons, panels and applets are views"
    state superseded
    scope [ path "crates/lege-session-core/**", path "services/**", path "shell/**" ]
    topic services-not-indicators
    statement """
        No policy (timezone discovery, power decisions, autostart choices, association defaults, notification storage) is implemented in a shell surface or applet; each lives in a service crate/daemon with a D-Bus interface, and the shell only renders and forwards user choices.
        """
    measure """
        Code review; a shell crate must not contain policy engines (only rendering and proxies from lege-client).
        """
    rationale """
        The automatic-timezone logic living in a custom NetworkManager tray is the exact fragmentation the OS removes.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            Section 7 'Services should be separate from indicators'.
            """
    }
}

