record legeos.constraint.packaging-and-render-thread/1 : constraint {
    title "Every component is a Debian package (nothing under /usr/local or untracked in $HOME); lege-window carries no async runtime or D-Bus dependency"
    state superseded
    scope [ path "crates/lege-window/**", path "debian/**", path "tools/xtask/**" ]
    topic packaging-and-render-thread
    statement """
        All binaries, units, manifests and policy files are installed by Debian packages (cargo-deb now, the vendored source package later); development installs go through a local apt repository. The compositor-side lege-window crate must never depend on tokio, zbus, async-std or smol because it runs on the compositor render thread.
        """
    measure """
        `cargo xtask deps-check` (lege-window dependency graph) and `cargo xtask tree-check`; debian/*.install covers every shipped file.
        """
    rationale """
        Untracked home-directory state and /usr/local installs are what made the user's customisations unmaintainable; a blocked render thread disconnects every Wayland client.
        """
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            'Stage 1: package every component as a Debian package'; section 3 'Separate the stable display core from the shell'.
            """
    }
    source {
        kind external
        role origin
        document "planning-subsequent-shape"
        use """
            Section 6: 'Must not perform blocking D-Bus I/O on the compositor render thread'.
            """
    }
}

