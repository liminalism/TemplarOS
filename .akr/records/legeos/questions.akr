akr 0.1
project legeos

record legeos.question.home-field-default-density/1 : question {
    title "Default field density: every drawer sits at the 2x2 floor, so the resize gesture is inert on first use"
    state superseded
    scope [ path "crates/lege-field/**", path "shell/lege-shell/**" ]
    question """
        The default field packs its drawer block at the 2x2 widget floor, so every neighbour of a resize is already at minimum span and the clamp rule reduces every grow request to nothing: on the default layout the neighbour-yielding resize does nothing visible. This is correct behaviour under the clamp-rather-than-evict rule the user set, but it makes the foundation's headline gesture look broken the first time anyone tries it. Should the default field keep this density (information-first, all eight drawers visible) and accept that resize only becomes useful once the user removes or shrinks something, or should the default leave slack — fewer drawers, a larger starting span for one or two, or deliberate empty cells — so the resize is discoverable on first use? This is the user's call, not an implementation detail.
        """
    derived_from [ @legeos.work.home-widget-foundations ]
    part_of [ @legeos.work.home-widgets ]
}

record legeos.question.home-field-default-density/2 : question {
    title "Default field density: every drawer sits at the 2x2 floor, so the resize gesture is inert on first use"
    state resolved
    scope [ path "crates/lege-field/**", path "shell/lege-shell/**" ]
    question """
        The default field packs its drawer block at the 2x2 widget floor, so every neighbour of a resize is already at minimum span and the clamp rule reduces every grow request to nothing: on the default layout the neighbour-yielding resize does nothing visible. This is correct behaviour under the clamp-rather-than-evict rule the user set, but it makes the foundation's headline gesture look broken the first time anyone tries it. Should the default field keep this density (information-first, all eight drawers visible) and accept that resize only becomes useful once the user removes or shrinks something, or should the default leave slack — fewer drawers, a larger starting span for one or two, or deliberate empty cells — so the resize is discoverable on first use? This is the user's call, not an implementation detail.
        """
    resolution """
        Answered by @legeos.decision.home-field-default-leaves-slack: slack, taken as lower floors rather than fewer drawers, so all eight stay on the field and a roomy one looks unchanged.

        The call was forced rather than chosen. Adding notifications as a third system widget made the old density unsatisfiable — no arrangement of a 1200x800 field seated three 3x2 system tiles and eight 2x2 drawers while both placing the launcher and keeping every open window visible.

        This was flagged as the user's call and was taken during an improvement pass authorised as 'any improvement is on the table', with the build otherwise broken. It is worth confirming: if information-first density is preferred over a discoverable resize, the decision record names the two levers.
        """
    derived_from [ @legeos.work.home-widget-foundations ]
    part_of [ @legeos.work.home-widgets ]
    supersedes [ @legeos.question.home-field-default-density/1 ]
}

record legeos.question.package-version-authority-across-lanes/1 : question {
    title "Which version authority reconciles the dev lane's --deb-version with the archive lane's debian/changelog?"
    state open
    scope [ path "debian/**", path "distro/apt/**", path "tools/xtask/**" ]
    question """
        The dev deployment lane stamps BuildSetIds via cargo-deb --deb-version, bypassing debian/changelog, while the Stage-2 archive lane builds from debian/changelog. Two version authorities cannot coexist into release: either a changelog entry is generated at release time from the build-set machinery, or debian/rules learns to accept LEGEOS_BUILD_SET so both lanes share one source. This must be settled before the archive.legeos.org lane is finished.
        """
    part_of [ @legeos.work.deployment-activation-and-resourced ]
}
