record legeos.papercut.scripts-nested-session-sh-stop-left-lege/1 : papercut {
    title "scripts/nested-session.sh stop left lege-sessiond and lege-filed…"
    state superseded
    statement """
        scripts/nested-session.sh stop left lege-sessiond and lege-filed running twice in this campaign (both times after the compositor had been started by hand into the script's pid/log paths): stop reported "nested session stopped" but the pidfiles for sessiond and filed were gone, so the daemons — pointed at the nested session.db, not the live session — had to be found with pgrep and killed by PID. stop should kill by the recorded PIDs and fall back to matching the nested --state-db argument.
        """
    observed_at git:93a4103a4dcf7625883abbe57f0e569a98d0ed10
    author "claude"
    created_at 2026-09-07
}

