record legeos.papercut.the-minimal-debian-archive-failure-was-traced/1 : papercut {
    title "The minimal Debian archive failure was traced to tar using openat2…"
    state verified
    statement """
        The minimal Debian archive failure was traced to tar using openat2 (syscall437), which PRoot5.5 does not translate; relative paths consequently resolve outside its virtual cwd. Plain tar and native dpkg-deb succeed; the owned helper needs openat2 handling.
        """
    observed_at git:12295f351ab14e649f900573190060cd88a7251e
    author "codex"
    created_at 2026-10-08
}

