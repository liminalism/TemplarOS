record legeos.papercut.every-reported-home-field-failure-slow-lossy/1 : papercut {
    title "Every reported Home Field failure — slow/lossy typing, a dead…"
    state verified
    statement """
        Every reported Home Field failure — slow/lossy typing, a dead shutdown button, no logout — was present in a tree where cargo test, clippy -D warnings and all seven xtask checks passed. The workspace gates cover model and layout arithmetic and cannot see the input thread, the rung a control lands on, or an interface that was never registered. Work that adds a user-facing surface should not be recorded as done on workspace evidence alone; the hands-on check needs to gate the commit, not trail it.
        """
    observed_at git:e19b3524f6dacae9152e4d6b94a6d9891edee4f4
    author "claude"
    created_at 2026-08-26
}

