record legeos.papercut.omp-session-pid-6702-6-parallel-heavy-subagents/1 : papercut {
    title "omp session (pid 6702, 6 parallel heavy subagents) hit EMFILE: shell…"
    state verified
    statement """
        omp session (pid 6702, 6 parallel heavy subagents) hit EMFILE: shell spawn, file reads, auth file and goal store all failed; nothing logged after 23:49:53. Not TemplarOS (stock Ubuntu limits); omp transient fd exhaustion at its self-raised 524288 limit. Avoid 6-wide build fan-out until omp fixes it.
        """
    observed_at git:7c68786687bea7b20dbc382bdacc2804e7284b70
    author "claude"
    created_at 2026-10-05
}

