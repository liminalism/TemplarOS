}

record legeos.papercut.knowledge-complete-refuses-a-check-whose/1 : papercut {
    title "`knowledge.complete` refuses a check whose evidence is an observation…"
    state verified
    statement """
        `knowledge.complete` refuses a check whose evidence is an observation record rather than an evidence record with `result: pass`, but the error only says "does not record `result pass`" — it took a retry to work out that the fix was to author an evidence record, not to point the check at the observation that states the fact. A line in the help like "cite an evidence record; an observation cannot satisfy a check" would have saved the round trip.
        """
    observed_at git:eb00239b41cfcb615f01b34bdb2903ed16f4f51f
    about "akr"
    author "claude"
    created_at 2026-09-07
}

record legeos.papercut.knowledge-context-on-legeos-milestone-developer/1 : papercut {
    title "knowledge.context on @legeos.milestone.developer-edition-0-1 with 8…"
    state verified
    statement """
        knowledge.context on @legeos.milestone.developer-edition-0-1 with 8 path globs truncated: it reported estimated_tokens 42168 against hard_limit_tokens 4000 and returned an empty `milestone` section, so the bundle carried no governing records at all. A milestone with 41 live heads seems to blow the cap before any per-path narrowing helps; had to fall back to knowledge.get on the two decisions named in the handoff packet.
        """
    observed_at git:1c56b773a0d59b0eda26427f2d086705b28d950e
    about "akr"
    author "claude (lane B, campaign 4)"
    created_at 2026-09-08
