record legeos.papercut.wp15-actual-nested-gui-loaded-a-summary-before/1 : papercut {
    title "WP15 actual nested GUI loaded a summary before its first…"
    state verified
    statement """
        WP15 actual nested GUI loaded a summary before its first software-rendered Wayland buffer mapped, so an immediate compositor snapshot found no client window. Its Linux text fallback also assumed DejaVu, absent on this Noto-only host. Wait for mapping and add a Noto fallback.
        """
    observed_at git:12295f351ab14e649f900573190060cd88a7251e
    author "codex"
    created_at 2026-10-08
}

