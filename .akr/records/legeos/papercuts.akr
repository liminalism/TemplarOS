record legeos.papercut.just-check-fails-when-run-from-a-terminal/1 : papercut {
    title "`just check` fails when run from a terminal inside a LegeOS session:…"
    state superseded
    statement """
        `just check` fails when run from a terminal inside a LegeOS session: lege-client's serving_without_a_launch_identity test asserted LEGEOS_APP_ID/LEGEOS_INSTANCE_ID are unset, but a broker-launched terminal's children inherit them. Fixed by skipping there, like the shell's no-service tests; any other test that reads ambient session environment needs the same guard, and the gate has no way of saying "this failure is your environment, not your change".
        """
    observed_at git:bf2df7d9efe8ca884a5df529cdc42280e80e2611
    author "claude"
    created_at 2026-09-02
}

