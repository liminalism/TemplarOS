record legeos.papercut.reconcile-reconcile-unconditionally-called/1 : papercut {
    title "reconcile::reconcile() unconditionally called index.mark_stale() before…"
    state superseded
    statement """
        reconcile::reconcile() unconditionally called index.mark_stale() before a repair pass; for a fresh Empty root (first-ever scan) that's an illegal Empty->Stale transition (Empty may only go to Building/Offline) and failed a real test. Fixed by also excluding RootState::Empty from the pre-repair mark_stale guard in crates/lege-file-index/src/reconcile.rs.
        """
    observed_at git:1ddbd3ff263ebcdcf72944368e0d2e3645340748
    author "claude"
    created_at 2026-09-03
}

