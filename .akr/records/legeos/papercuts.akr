record legeos.papercut.unprivileged-libarchive-dev-extraction-has/1 : papercut {
    title "Unprivileged libarchive-dev extraction has libarchive.so ->…"
    state verified
    statement """
        Unprivileged libarchive-dev extraction has libarchive.so -> libarchive.so.13.8.5; that exact versioned runtime soname must resolve to the installed runtime. A dangling symlink made rust-lld select libarchive.a even with dylib=archive, producing many unrelated-looking codec symbol errors.
        """
    observed_at git:2bc8f741f3c21759c3e7c728d9c211868035aa18
    author "omp"
    created_at 2026-10-03
}

