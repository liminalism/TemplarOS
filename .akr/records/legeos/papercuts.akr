record legeos.papercut.a-prior-continuation-s-the-change-log-is/1 : papercut {
    title "A prior continuation's the_change_log_is_bounded_and_says_so test…"
    state superseded
    statement """
        A prior continuation's the_change_log_is_bounded_and_says_so test asserted changes_since(0, 100) succeeds even after 20 mutations against a max_changes=8 budget had already pruned past seq 0 — contradicting the frozen "seq < floor is always SnapshotRequired" rule. First action on resuming this lane was `cargo test -p lege-file-index`; fixing what fails caught it immediately, so the rule stands as documented, but it's a reminder that a budget-tight fixture test needs to query the actual floor (Index::diagnostics) rather than assume seq 0 stays valid.
        """
    observed_at git:1ddbd3ff263ebcdcf72944368e0d2e3645340748
    author "claude"
    created_at 2026-09-03
}

