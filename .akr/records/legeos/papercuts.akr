        """
    observed_at git:9855da2f2647f2baa7473b2dda60b20dd702a046
    about "cli/lege/src/dev/install.rs"
    supersedes [ @legeos.papercut.deploy-pinned-the-image-metapackages/1 ]
    author "dk"
}

record legeos.papercut.distro-forks-manifest-toml-s-nm-tray-2-note/1 : papercut {
    title "distro/forks/manifest.toml's nm-tray-2 `note` says build-fork-deb.sh…"
    state verified
    statement """
        distro/forks/manifest.toml's nm-tray-2 `note` says build-fork-deb.sh refuses to package because --popup and X-LegeOS-Provides are uncommitted; in fact `scripts/build-fork-deb.sh nm-tray-2 --source ../not-rust-projects/nm-tray-2 --dry-run` passes preflight today (the dirty working tree has both). The note reads as a blocker and is not one — it should say "the pin cannot reproduce this build", not "the script refuses".
        """
    observed_at git:1c56b773a0d59b0eda26427f2d086705b28d950e
    author "claude (lane B, campaign 4)"
    created_at 2026-09-08
}

record legeos.papercut.distro-iso-build-sh-s-customize-hook-runs/1 : papercut {
    title "distro/iso/build.sh's customize hook runs inside mmdebstrap's user…"
    state verified
    statement """
        distro/iso/build.sh's customize hook runs inside mmdebstrap's user namespace, where the calling user's uid is not mapped: the ISO tree it must drop the kernel, initramfs and signed EFI binaries into looked owned by nobody and even the namespace's root could not write to it, failing with a bare "mkdir: Permission denied" 25 minutes into a bootstrap. Fixed by creating the tree's directories up front and chmod 0777 on them.
        """
    observed_at git:0417055634d59fb6c8306840a016ffd44d85f027
    author "claude"
    created_at 2026-09-07
}

record legeos.papercut.distro-metapackages-readme-md-promised-a-distro/1 : papercut {
    title "distro/metapackages/README.md promised a distro/metapackages/build.sh…"
    state verified
    statement """
        distro/metapackages/README.md promised a distro/metapackages/build.sh that never existed, and distro/image/compose.sh silently iterated a hardcoded seed list (minimal session desktop hardware ime a11y), so dev.seed and both nvidia seeds were declared and consumed by nothing. A generator that skips inputs without saying so is worse than no generator; `cargo xtask seeds` now renders every layer and fails on drift.
        """
    observed_at git:8b284c9147b70b4f03bb7c48ec993647e2e4df31
    author "claude"
    created_at 2026-09-03
}

