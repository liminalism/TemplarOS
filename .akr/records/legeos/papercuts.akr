record legeos.papercut.xtask-interface-baseline-prints-froze-170/1 : papercut {
    title "`xtask interface-baseline` prints \"froze 170 member(s)\" and the…"
    state superseded
    statement """
        `xtask interface-baseline` prints "froze 170 member(s)" and the following `check-interface-signatures` also prints 170, but the run before it had said "170 unchanged; 2 new" and the baseline diff added 2 lines. The count in the freeze message appears to be the pre-existing total rather than the new one, which makes it look as though the addition was not frozen.
        """
    observed_at git:392bd0d8a20b8ad0b43311cfde9ad58543c942a6
    author "claude"
    created_at 2026-09-02
}

