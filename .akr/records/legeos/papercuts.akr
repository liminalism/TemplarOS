    state verified
    statement """
        On this NTFS/FUSE workspace, systemd-analyze verify warns that every checked-in user unit is executable/world-writable because the mount presents mode 0777, although git records 0644 and installed units are 0644. Verification output needs that mount caveat to avoid a false packaging diagnosis.
        """
    observed_at git:a185a0043a662c2923503984557948f598ee5220
    author "codex"
    created_at 2026-08-23
}

