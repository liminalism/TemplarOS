record legeos.papercut.scripts-update-templaros-sh-refuses-this/1 : papercut {
    title "scripts/update-templaros.sh refuses this installed TemplarOS (cmdline…"
    state superseded
    statement """
        scripts/update-templaros.sh refuses this installed TemplarOS (cmdline templaros.deployment=install-20260930T034405Z, /etc/templaros/install.toml) because /usr/lib/os-release is Ubuntu's base-files copy (2026-08-24): provision.sh copies the live medium's /usr/lib/os-release, which was not TemplarOS's. Workaround: TEMPLAROS_OS_RELEASE=distro/branding/os-release.
        """
    observed_at git:50af3784cb5c3f0ebe72a1e15f12a88f57e11290
    author "claude"
    created_at 2026-10-01
}

