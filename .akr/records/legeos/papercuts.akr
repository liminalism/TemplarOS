record legeos.papercut.xdg-desktop-portal-templar-panicked-at-01-02-51/1 : papercut {
    title "xdg-desktop-portal-templar panicked at 01:02:51 on 2026-10-01 when…"
    state superseded
    statement """
        xdg-desktop-portal-templar panicked at 01:02:51 on 2026-10-01 when Chromium opened a portal dialog: winit refused an EventLoop off the main thread, then 'EventLoop can't be recreated'; xdg-desktop-portal then killed Chromium for lacking background permission. RUST_BACKTRACE was unset, so only the message survived (now set in the unit).
        """
    observed_at git:50af3784cb5c3f0ebe72a1e15f12a88f57e11290
    author "sonnet-triage"
    created_at 2026-10-01
}

record legeos.papercut.xdg-desktop-portal-templar-panicked-at-01-02-51/2 : papercut {
