    state superseded
    statement """
        Set metapackages pin NVIDIA/kernel with '=' to base.toml's snapshot versions, but the provisioner installed from archive.ubuntu.com; a medium stops installing the day Ubuntu publishes a kernel. Now installs from the snapshot; the installed system therefore tracks the snapshot, not security updates.
        """
    observed_at git:137e1e43db33c886ec5e40a28c766828e44126b5
    author "claude"
    created_at 2026-09-30
}

