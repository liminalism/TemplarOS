record legeos.papercut.knowledge-revise-replaces-the-whole-sources/1 : papercut {
    title "knowledge.revise replaces the whole `sources` block, and re-supplying a…"
    state verified
    statement """
        knowledge.revise replaces the whole `sources` block, and re-supplying a citation with only kind/document/byte-range silently drops its `role`, `use` and `excerpt_hash`. For a source finalized with `--retain cited` (availability cited-only), losing excerpt_hash turns a valid citation into an AKR-S022 error, because retention is keyed on the hash and not on the byte range that is still present and unchanged. Worse, if the record was `proposed` the revise edits that revision in place, so the damage lands on rev 1 and cannot be undone by another revise (base_rev must equal the head, which is now rev 2) — it takes a git restore of the record file. Suggestion: either carry forward a citation's retained-fragment identity when a revise re-supplies the same document and byte range, or refuse the write with the same S022 message rather than accepting it and reporting the error only at the next validate.
        """
    observed_at git:ea6c300016980fc83964d05cae0a9cf0e5417014
    about "akr"
    author "claude-opus-5"
    created_at 2026-09-07
}

