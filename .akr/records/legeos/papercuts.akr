record legeos.papercut.fresh-mandatory-2m-index-workload-cannot-use/1 : papercut {
    title "Fresh mandatory 2M index workload cannot use native /tmp: tmpfs has…"
    state superseded
    statement """
        Fresh mandatory 2M index workload cannot use native /tmp: tmpfs has only1048576 inodes. Used owned home-backed TMPDIR .agent/scratch. Existing drain_watcher claims settled truth but discards pump reconciliation/coverage outputs and silently ignores Index.apply errors; ~4k mutations for10k bursts are not full end-to-end completion evidence.
        """
    observed_at git:7c68786687bea7b20dbc382bdacc2804e7284b70
    author "Main"
    created_at 2026-10-06
}

