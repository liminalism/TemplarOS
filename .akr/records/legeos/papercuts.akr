record legeos.papercut.iso-mmdebstrap-spent-3h-fetching-110-1505-debs/1 : papercut {
    title "ISO mmdebstrap spent 3h fetching ~110/1505 debs: apt had a CLOSE_WAIT…"
    state superseded
    statement """
        ISO mmdebstrap spent 3h fetching ~110/1505 debs: apt had a CLOSE_WAIT IPv6 session to security.ubuntu.com (2620:2d:4000:1::102:80) while snapshot.ubuntu.com is IPv4-only. Acquire::Retries does not unstick that. ForceIPv4 belongs next to Retries in distro/iso/build.sh.
        """
    observed_at git:e7458c3a132ed5ad8cd93f40d808bf2cef9456d4
    author "grok-4.6"
    created_at 2026-09-11
}

