record legeos.papercut.while-building-the-files-object-s-last-touched/1 : papercut {
    title "While building the Files object's last-touched-file line, only the…"
    state superseded
    statement """
        While building the Files object's last-touched-file line, only the Trash and Recent DrawerFeeds populate row_target; the other drawer renderers return padded, column-formatted display strings, so a consumer wanting structure can only show them verbatim. Feeds should carry structured targets everywhere; phase 3's FilesSurfaceState supersedes the need, but the feed asymmetry remains a trap.
        """
    observed_at git:7e6f22c29df8b3615170eb250006a30ca4d73b54
    author "claude"
