record legeos.papercut.lege-dev-deploy-failed-with-apt-unauthenticated/1 : papercut {
    title "`lege dev deploy` failed with apt \"unauthenticated packages\" right…"
    state superseded
    statement """
        `lege dev deploy` failed with apt "unauthenticated packages" right after a fresh `lege dev repo init --install-source` on a machine with a stale cached index. Root cause: every publish regenerates the devrepo Release from scratch, so apt sometimes sees an Origin/Label mismatch vs. its cached copy and silently keeps the stale (mismatched) index instead of refreshing — unlike scripts/reinstall-legeos-desktop.sh, which uses dpkg -i directly and never touches apt's trust cache. Fixed by adding --allow-releaseinfo-change to the scoped apt-get update in refresh_index() (cli/lege/src/dev/install.rs); this repo has exactly one publisher so accepting the metadata change is always correct.
        """
    observed_at git:f5007ef369d0b386fb872a6b726e3f8baaac5944
    author "claude"
    created_at 2026-09-01
}

record legeos.papercut.lege-dev-deploy-failed-with-apt-unauthenticated/2 : papercut {
