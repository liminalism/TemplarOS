record legeos.papercut.a-failed-mmdebstrap-in-distro-iso-build-sh/1 : papercut {
    title "A failed mmdebstrap in distro/iso/build.sh still left a zero-byte…"
    state verified
    statement """
        A failed mmdebstrap in distro/iso/build.sh still left a zero-byte casper/filesystem.squashfs (mksquashfs is the second half of the pipeline), and the next run's "skip the bootstrap if the squashfs exists" check trusted it — so the retry reported "the customize hook left no casper/vmlinuz" instead of rebuilding. Fixed by removing the partial squashfs when the pipeline fails.
        """
    observed_at git:0417055634d59fb6c8306840a016ffd44d85f027
    author "claude"
    created_at 2026-09-07
}

