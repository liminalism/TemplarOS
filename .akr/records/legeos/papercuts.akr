record legeos.papercut.nested-on-an-x11-host-scripts-nested-session-sh/1 : papercut {
    title "Nested on an X11 host: scripts/nested-session.sh dies with…"
    state verified
    statement """
        Nested on an X11 host: scripts/nested-session.sh dies with `WAYLAND_DISPLAY: unbound variable`, and the nested winit compositor window is created at the host's full screen size so its bottom ~64 px (the whole island and cluster row) sit off-screen; WINIT_X11_SCALE_FACTOR=1 and starting templar-comp by hand with `env -u WAYLAND_DISPLAY` work around both.
        """
    observed_at git:37033447950b39b2f9238f5c8ff0bff56ebb23fd
    author "claude"
    created_at 2026-09-10
}

record legeos.papercut.nested-session-on-lubuntu-x11-lxqt-scripts/1 : papercut {
    title "Nested session on Lubuntu (X11, LXQt): scripts/nested-session.sh unsets…"
    state superseded
    statement """
        Nested session on Lubuntu (X11, LXQt): scripts/nested-session.sh unsets DISPLAY for the compositor and nests only into a host Wayland socket, and reads binaries from target/ (which can't link here), so it cannot run on this host. Ran templar-comp --backend winit with DISPLAY=:0 by hand from /tmp/legeos-clippy-target instead; its XWayland first probed display :0 (the host's) before taking :1. A DISPLAY fallback and a bin-dir override in the script would fix it.
        """
    observed_at git:2bc8f741f3c21759c3e7c728d9c211868035aa18
    author "claude"
    created_at 2026-10-04
}

record legeos.papercut.nested-session-on-lubuntu-x11-lxqt-scripts/2 : papercut {
