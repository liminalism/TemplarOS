record legeos.papercut.scripts-nested-session-sh-records-of-a/1 : papercut {
    title "scripts/nested-session.sh records $! of a backgrounded shell FUNCTION…"
    state verified
    statement """
        scripts/nested-session.sh records $! of a backgrounded shell FUNCTION (nested_env ... &), i.e. a subshell pid, so 'stop'/'shell' kill the subshell and leave the real templar-shell/sessiond running; three shells ended up bound to one nested compositor. Use exec inside nested_env or record the child pid.
        """
    observed_at git:e7458c3a132ed5ad8cd93f40d808bf2cef9456d4
    author "claude"
    created_at 2026-09-28
}

record legeos.papercut.scripts-nested-session-sh-refuses-to-start/1 : papercut {
