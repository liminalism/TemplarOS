record legeos.papercut.campaign-5-s-lane-briefs-name-scripts-nested/1 : papercut {
    title "Campaign 5's lane briefs name `scripts/nested-session.sh start` as the…"
    state superseded
    statement """
        Campaign 5's lane briefs name `scripts/nested-session.sh start` as the validation bed, but the script's `refuse_over_live_session` guard refuses whenever `lege-comp.service`/`lege-sessiond.service` are active — which they are the whole time the user is logged into the installed LegeOS session. So no lane can do the nested-session validation its packet asks for. Either the brief should say "only when the user is logged out of LegeOS", or the script needs an opt-in that isolates the bus (its own DBUS_SESSION_BUS_ADDRESS) so it can nest inside a live session the way the rules assume.
        """
    observed_at git:71267e39433d1f0fbe4ff617d54318bbac249480
    author "claude"
    created_at 2026-09-08
}

record legeos.papercut.campaign-5-s-lane-briefs-name-scripts-nested/2 : papercut {
