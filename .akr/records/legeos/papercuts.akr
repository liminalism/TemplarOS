record legeos.papercut.the-first-live-video-preview-failed-only-under/1 : papercut {
    title "The first live video preview failed only under the helper's 2 GiB…"
    state superseded
    statement """
        The first live video preview failed only under the helper's 2 GiB address-space cap because ffmpeg's PNG path auto-created many frame threads. Pinning decoder/filter/encoder thread counts makes the bounded subprocess reliable and avoids excessive virtual-memory reservations.
        """
    observed_at git:a185a0043a662c2923503984557948f598ee5220
    author "codex"
    created_at 2026-08-24
}

