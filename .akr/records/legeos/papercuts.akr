record legeos.papercut.lege-build-s-tests-created-a-scratch-directory/1 : papercut {
    title "lege-build's tests created a scratch directory under /tmp and removed…"
    state superseded
    statement """
        lege-build's tests created a scratch directory under /tmp and removed it at the start of the NEXT run — one run behind — so 287 stale directories had accumulated on the dev machine before anyone noticed. Fixed by moving to tempfile (a full cargo test --workspace now leaves nothing behind, verified by counting), but the pattern is worth watching for in other test code.
        """
    observed_at git:da57d5726d6f47c48c4494f54cf263ed0ed2e020
    author "claude"
    created_at 2026-09-01
}

