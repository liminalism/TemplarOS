record legeos.papercut.systemd-analyze-user-verify-accepted-the/1 : papercut {
    title "systemd-analyze --user verify accepted the session units but warned…"
    state verified
    statement """
        systemd-analyze --user verify accepted the session units but warned every source unit is executable/world-writable because this workspace filesystem presents broad mode bits; package metadata explicitly installs them as 0644, so the warnings do not describe the installed files.
        """
    observed_at git:a185a0043a662c2923503984557948f598ee5220
    about "systemd-analyze"
    author "codex"
    created_at 2026-08-23
}

record legeos.papercut.systemd-coredump-was-not-installed-on-the/1 : papercut {
    title "systemd-coredump was not installed on the laptop although…"
    state superseded
    statement """
        systemd-coredump was not installed on the laptop although distro/policy/coredump and sessiond's crash_ingest assume it, and Debian's systemd ships DefaultLimitCORE=0:infinity for both managers, so templar-comp ran with a soft core limit of 0: a crash or a watchdog abort left nothing. templaros-hostd now Depends on systemd-coredump, whose 20-coredump-debian.conf raises the limit from the next login.
        """
    observed_at git:50af3784cb5c3f0ebe72a1e15f12a88f57e11290
    author "sonnet-triage"
    created_at 2026-10-01
}

record legeos.papercut.systemd-coredump-was-not-installed-on-the/2 : papercut {
    title "systemd-coredump was not installed on the laptop although…"
    state verified
    statement """
        systemd-coredump was not installed on the laptop although distro/policy/coredump and sessiond's crash_ingest assume it, and Debian's systemd ships DefaultLimitCORE=0:infinity for both managers, so templar-comp ran with a soft core limit of 0: a crash or a watchdog abort left nothing. templaros-hostd now Depends on systemd-coredump, whose 20-coredump-debian.conf raises the limit from the next login.
        """
    observed_at git:50af3784cb5c3f0ebe72a1e15f12a88f57e11290
    closed_at 2026-10-06
    supersedes [ @legeos.papercut.systemd-coredump-was-not-installed-on-the/1 ]
    author "sonnet-triage"
    created_at 2026-10-01
}

