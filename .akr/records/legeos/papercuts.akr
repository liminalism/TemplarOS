record legeos.papercut.the-delete-key-means-two-unrelated-things-in/1 : papercut {
    title "The Delete key means two unrelated things in one product: on the Home…"
    state verified
    statement """
        The Delete key means two unrelated things in one product: on the Home Field it stashes the focused tile to the shelf (field_screen.rs:963), in the Files app it moves the selected file to the trash (actions.rs:87). The Files app even labels it "Delete · Trash" in its shortcut hint while the same key one surface away destroys no file at all. Worth a vocabulary decision rather than a blind fix — either the field's verb stops being Delete, or shelving and trashing are named as one reversible "put away".
        """
    observed_at git:464e069b7b2769bc5e0ab34e8191b65f9101e7db
    author "claude"
    created_at 2026-08-31
}

record legeos.papercut.the-desktop-reinstall-failed-opaquely-when/1 : papercut {
    title "The desktop reinstall failed opaquely when mutable sibling path…"
    state superseded
    statement """
        The desktop reinstall failed opaquely when mutable sibling path dependencies made helpers/lege-preview-codecs/Cargo.lock stale, and the error suggested --offline even though reinstall-legeos-desktop.sh did not accept that option. The codec build now refreshes its local dependency graph offline before enforcing --locked, and the wrapper exposes --offline.
        """
    observed_at git:aa2028cf247d6f7c3b7c888f6ea3a3f545dbd45b
