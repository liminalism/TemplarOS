record legeos.papercut.with-private-xdg-data-dirs-installed-xdg/1 : papercut {
    title "With private XDG_DATA_DIRS, installed xdg-desktop-portal aborted…"
    state verified
    statement """
        With private XDG_DATA_DIRS, installed xdg-desktop-portal aborted because GLib found no schemas; a read-only GSETTINGS_SCHEMA_DIR=/usr/share/glib-2.0/schemas and GSETTINGS_BACKEND=memory made the genuine isolated frontend reachable. XDG_DESKTOP_PORTAL_DIR also relocates portals.conf lookup to that owned descriptor directory.
        """
    observed_at git:7c68786687bea7b20dbc382bdacc2804e7284b70
    author "NativePortalLifecycleProof"
    created_at 2026-10-06
}

record legeos.papercut.working-the-portal-lane-the-generated-docs/1 : papercut {
    title "Working the portal lane, the generated docs contradicted themselves…"
    state superseded
    statement """
        Working the portal lane, the generated docs contradicted themselves about the same fact: docs/generated/CURRENT-STATE.md:185 says the OpenURI portal does not exist, while line 857 of the same file lists OpenURI among the interfaces the backend serves. Three source comments (portals/README.md, the crate description, main.rs's module doc) repeated the second claim, so the first thing this lane had to do was prove from the installed xdg-desktop-portal binary which one was true.
        """
    observed_at git:8b284c9147b70b4f03bb7c48ec993647e2e4df31
    author "claude"
    created_at 2026-09-03
}

