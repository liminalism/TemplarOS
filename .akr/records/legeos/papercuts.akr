record legeos.papercut.validation-during-wp12-reported-lock-hash/1 : papercut {
    title "Validation during WP12 reported lock hash errors because the ledger had…"
    state verified
    statement """
        Validation during WP12 reported lock hash errors because the ledger had new evidence/work revisions and akr.lock was stale. Run akr build before the final validate; keeping a tail command after validate also masked its shell exit status, so inspect the logged diagnostic count.
        """
