record legeos.papercut.the-installed-legeos-set-on-the-development/1 : papercut {
    title "The installed LegeOS set on the development machine was mixed-age: ten…"
    state superseded
    statement """
        The installed LegeOS set on the development machine was mixed-age: ten of thirteen packages more than a day older than lege-shell, so an Aug-25 shell was calling Session.Lifecycle1 and current lege_shell_v1 requests against an Aug-22 sessiond and an Aug-23 compositor. Every symptom is silent and reads as an application bug. scripts/reinstall-legeos-desktop.sh apparently did not rebuild everything, or was run with --skip-build; `lege doctor`'s new package-ages check now catches the state, but the script itself should be re-examined.
        """
    observed_at git:e19b3524f6dacae9152e4d6b94a6d9891edee4f4
    author "claude"
    created_at 2026-08-26
}

