record legeos.papercut.correcting-my-earlier-papercut-allow/1 : papercut {
    title "Correcting my earlier papercut: --allow-releaseinfo-change was not the…"
    state superseded
    statement """
        Correcting my earlier papercut: --allow-releaseinfo-change was not the fix (the scoped apt-get update always succeeded cleanly). Real cause: source_stanza() in cli/lege/src/dev/repo.rs wrote `Trusted: no`, which forces every package unauthenticated unconditionally in apt's deb822 semantics -- it does NOT mean "trust only if Signed-By verifies". Fixed by dropping the field entirely so Signed-By alone gates trust (repo.rs source_stanza). Existing /etc/apt/sources.list.d/legeos-dev.sources on a dev machine needs `lege dev repo init --install-source` re-run to pick up the corrected stanza.
        """
    observed_at git:f5007ef369d0b386fb872a6b726e3f8baaac5944
    author "claude"
    created_at 2026-09-01
}

record legeos.papercut.correcting-my-earlier-papercut-allow/2 : papercut {
