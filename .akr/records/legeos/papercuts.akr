record legeos.papercut.wayland-scanner-0-31-panics-on-any-xml-entity/1 : papercut {
    title "wayland-scanner 0.31 panics on any XML entity reference in a protocol…"
    state superseded
    statement """
        wayland-scanner 0.31 panics on any XML entity reference in a protocol file ("Ill-formed protocol file: Ok(GeneralRef(...))") with no line number and no mention of the entity; a `&lt;` in an arg summary took the whole shell's generated bindings down at 56b890a until d3c0cd9 rewrote it. A gate that greps interfaces/wayland/*.xml for `&[a-z]+;` would turn the panic into one sentence.
        """
    observed_at git:37033447950b39b2f9238f5c8ff0bff56ebb23fd
    author "claude"
    created_at 2026-09-10
}

