record legeos.papercut.just-msrv-fails-on-this-machine-at-any-commit/1 : papercut {
    title "just msrv fails on this machine at any commit, including a clean base:…"
    state verified
    statement """
        just msrv fails on this machine at any commit, including a clean base: sibling path deps bpg-bitstream/decode/format/hevc/hevc-decode declare rust-version 1.97, so cargo +1.93 refuses to resolve the workspace before compiling anything. That makes `just check` unable to reach green locally, so its failure carries no signal about the change under test. Pinning the bpg-* siblings as git deps, or excluding the preview graph from the MSRV check the way lege-preview-codecs already is, would restore it.
        """
    observed_at git:464e069b7b2769bc5e0ab34e8191b65f9101e7db
    author "claude"
    created_at 2026-08-31
}

