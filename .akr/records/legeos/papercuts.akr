record legeos.papercut.genuine-private-native-inotify-overflow-exposed/1 : papercut {
    title "Genuine private native inotify overflow exposed a production…"
    state superseded
    statement """
        Genuine private native inotify overflow exposed a production false-Current loss: 12,000 creates became only 3,118 search hits; the bounded handoff fixture returned 2,048 of 10,000. Pump directory Touch updates timestamp metadata ahead of dropped membership events, so reconcile must not take timestamp equality on trust across overflow/downtime/unknown or partial history.
        """
    observed_at git:7c68786687bea7b20dbc382bdacc2804e7284b70
    author "IndexMaintenanceNativeProof"
    created_at 2026-10-06
}

