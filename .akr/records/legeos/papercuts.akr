record legeos.papercut.stage-1-cargo-deb-packages-do-not-ship-most-of/1 : papercut {
    title "Stage-1 cargo-deb packages do not ship most of what debian/*.install…"
    state verified
    statement """
        Stage-1 cargo-deb packages do not ship most of what debian/*.install lists from distro/policy (sysctl.d/60-templaros.conf with the zswap VM tuning, tmpfiles zswap params, coredump.conf.d, environment.d, slice drop-ins), so the installed laptop runs Ubuntu defaults: sysrq=176, no swap at all, core_pattern=core. check-packaging compares package names and depends between the two paths but not their asset lists.
        """
    observed_at git:50af3784cb5c3f0ebe72a1e15f12a88f57e11290
    author "sonnet-triage"
    created_at 2026-10-01
}

