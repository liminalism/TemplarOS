record legeos.papercut.second-separate-bug-found-after-the-apt-trust/1 : papercut {
    title "Second, separate bug found after the apt-trust fix: `lege dev deploy`…"
    state superseded
    statement """
        Second, separate bug found after the apt-trust fix: `lege dev deploy` (root, via sudo) failed to activate lege-resourced.service — "Failed to connect to user scope bus via local transport: DBUS_SESSION_BUS_ADDRESS and XDG_RUNTIME_DIR not defined". Root cause: RealSystemctl/RealBusProbe in cli/lege/src/dev/systemd.rs ran `systemctl --user`/`busctl --user` as root, which has no session bus of its own -- a --user unit lives in the desktop user's manager. Fixed by adding --machine=<user>@.host (resolved from SUDO_USER) whenever scope is User and the process is root; system-scope calls and a target_user of "root"/none are unaffected.
        """
    observed_at git:f5007ef369d0b386fb872a6b726e3f8baaac5944
    author "claude"
    created_at 2026-09-01
}

record legeos.papercut.second-separate-bug-found-after-the-apt-trust/2 : papercut {
