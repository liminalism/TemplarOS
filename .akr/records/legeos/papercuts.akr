record legeos.papercut.homegarden-review-knowledge-context-with-a/1 : papercut {
    title "Homegarden review: knowledge.context with a 14000-token budget returned…"
    state verified
    statement """
        Homegarden review: knowledge.context with a 14000-token budget returned about 41000 tokens across content blocks and expanded many unrelated milestone siblings; narrower paths and targeted record reads are needed to keep the governing plan readable.
        """
