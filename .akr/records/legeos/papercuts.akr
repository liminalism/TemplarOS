record legeos.papercut.the-mechanized-fixture-guard-test-in-services/1 : papercut {
    title "The mechanized fixture guard test in services/lege-filed/src/watcher.rs…"
    state superseded
    statement """
        The mechanized fixture guard test in services/lege-filed/src/watcher.rs scans every src/*.rs file's #[cfg(test)] region for the literal "TrashMounts::System" -- but the guard test's own doc comment and assert message live inside that same #[cfg(test)] mod and both quoted the literal, so the test flagged itself. Fixed by building the needle via string concatenation at runtime and rephrasing the prose to never spell it contiguously. Worth a lint/self-check note for any future source-scanning test in this codebase.
        """
    observed_at git:1ddbd3ff263ebcdcf72944368e0d2e3645340748
    author "claude"
    created_at 2026-09-03
}

