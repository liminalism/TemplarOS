record legeos.papercut.external-desktop-proof-must-not-await-captured/1 : papercut {
    title "External desktop proof must not await captured gio launch…"
    state verified
    statement """
        External desktop proof must not await captured gio launch stdout/stderr: the launched child inherits those pipes and keeps output() blocked until it exits, losing the live kernel peer. status() with owned file/null stdio preserves the actual live process for cgroup/starttime/pidfd proof. compositor integration pid helpers are private; fixture includes their actual source instead of adding a production re-export.
        """
    observed_at git:7c68786687bea7b20dbc382bdacc2804e7284b70
    author "NativePowerIdentityProof"
    created_at 2026-10-06
}

