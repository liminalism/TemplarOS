record legeos.papercut.akr-requires-a-resolves-edge-before-a-question/1 : papercut {
    title "akr requires a resolves edge before a question may move to resolved…"
    state verified
    statement """
        akr requires a resolves edge before a question may move to resolved (AKR-T031), but rejects a resolves edge that names the question by revision once the question is resolved (AKR-L021, 'may not reference .../2, which is resolved'). Proposing the answering observation with resolves [ @legeos.question.x/1 ] therefore succeeds, and then the akr revise that resolves the question fails, with nothing indicating that the revision suffix is the problem. The unversioned form resolves [ @legeos.question.x ] tracks the head and works, which is what the existing records in this ledger use — but propose accepted the pinned form without a word, so the failure surfaces one command later on a different record.
        """
    observed_at git:e6e1b1c3523004f2eef22aa3bfd2dc2abae4a06a
    about "akr"
    author "opus"
    created_at 2026-09-08
}

