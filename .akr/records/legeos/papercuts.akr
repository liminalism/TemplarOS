record legeos.papercut.debian-control-s-build-depends-names-only/1 : papercut {
    title "debian/control's Build-Depends names only libsqlite3-dev, but the built…"
    state verified
    statement """
        debian/control's Build-Depends names only libsqlite3-dev, but the built packages link libdisplay-info, libgbm, libinput, libpixman, libseat, libudev and libxkbcommon, so ci/source-build.sh's chroot would fail at pkg-config; and cargo-deb's $auto on the development host resolved libEGL to libnvidia-gl-580, a dependency no LegeOS package should carry. Both are symptoms of building native packages on a host that is not the target release; scripts/build-in-resolute.sh is the workaround until the source build is the normal route.
        """
    observed_at git:5681cf26fb7f1616cefb5f557d0eb84208923242
    author "claude"
    created_at 2026-09-05
}

record legeos.papercut.deploy-pinned-the-image-metapackages/1 : papercut {
    title "`lege dev deploy` pinned the archive metapackages, so apt refused every set the ISO lane built"
    state superseded
    scope [ path "cli/lege/src/dev/**", path "distro/metapackages/**" ]
    statement """
        Since the ISO lane started building the eight metapackages into the build set, `lege dev deploy` pinned all 21 packages in one apt transaction — including legeos-kernel, legeos-desktop, legeos-dev-*, and both NVIDIA rows, which Conflict with each other. apt refused the whole set on the development host ("Reached two conflicting decisions", plus unmet deps that only resolve inside a LegeOS rootfs), so no deployment could happen at all. Fixed in Installer::plan: pin only the component matrix's packages, which is what verify() already checked afterwards; the metapackages stay published so the image build can resolve against them.
        """
    observed_at git:9855da2f2647f2baa7473b2dda60b20dd702a046
    about "cli/lege/src/dev/install.rs"
}

record legeos.papercut.deploy-pinned-the-image-metapackages/2 : papercut {
