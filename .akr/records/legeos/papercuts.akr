record legeos.papercut.on-this-host-var-lib-legeos-devrepo-has-current/1 : papercut {
    title "On this host /var/lib/legeos/devrepo has current/previous/pool but no…"
    state superseded
    statement """
        On this host /var/lib/legeos/devrepo has current/previous/pool but no sets/ directory at all — it was published by a `lege dev` predating set manifests — so `lege dev repo verify` there reports "…was never published to this archive" for the set `current` names, and D1's new image drop-in correctly writes nothing. It is honest but surprising: a one-line hint in the verify output ("this archive predates set manifests; republish to record one") would save the next person the detour.
        """
    observed_at git:8b284c9147b70b4f03bb7c48ec993647e2e4df31
    author "claude"
    created_at 2026-09-03
}

