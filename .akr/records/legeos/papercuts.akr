record legeos.papercut.live-text-console-boot-looks-hung-after-casper/1 : papercut {
    title "Live text-console boot looks hung after casper-md5check FAILED. Boot…"
    state superseded
    statement """
        Live text-console boot looks hung after casper-md5check FAILED. Boot already reached multi-user.target; the ISO ships no md5sum.txt so the check always fails. Login is on serial-getty@ttyS0 because grub.cfg uses console=ttyS0/tty0, which does not spawn getty@tty1. Laptop then has no prompt. Mask md5check, pin getty@tty1, console=tty1.
        """
    observed_at git:e7458c3a132ed5ad8cd93f40d808bf2cef9456d4
    author "grok"
    created_at 2026-09-11
}

