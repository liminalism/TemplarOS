record legeos.papercut.installer-readme-md-still-shows-free-space-dev/1 : papercut {
    title "installer/README.md still shows `--free-space /dev/nvme1n1` and…"
    state verified
    statement """
        installer/README.md still shows `--free-space /dev/nvme1n1` and `--esp/--root` on nvme1n1p3/p4 as the reference-laptop commands, and still claims --free-space refuses a hole that is not the tail. AKR revised the install target to nvme0n1 (Windows's leading 537 GiB gap) on 2026-09-09; following the README would partition the data drive. Fixing the examples and the stale tail-only sentence as part of this work.
        """
    observed_at git:e7458c3a132ed5ad8cd93f40d808bf2cef9456d4
    author "grok"
    created_at 2026-09-11
}

