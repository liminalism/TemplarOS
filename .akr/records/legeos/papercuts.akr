    statement """
        The native image has cjpeg/jpegtran/djpeg but no /usr/bin/time or libwebp pkg-config metadata. wait4 ru_maxrss also included pre-exec launcher high-water RSS (~37MB); sampled post-exec djpeg smaps_rollup instead, labeling its 2ms peaks as lower bounds.
        """
    observed_at git:7c68786687bea7b20dbc382bdacc2804e7284b70
    author "codex"
    created_at 2026-10-06
}

record legeos.papercut.the-native-sleep-watch-source-fixture-needed/1 : papercut {
