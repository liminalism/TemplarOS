record legeos.papercut.cargo-xtask-check-packaging-reports-three/1 : papercut {
    title "`cargo xtask check-packaging` reports three mismatches on a fresh…"
    state superseded
    statement """
        `cargo xtask check-packaging` reports three mismatches on a fresh checkout because legeos-filed's preview-codec assets (target/preview-codecs/…) do not exist until `just preview-codecs` has run, so the packaging gate cannot be read as clean without first running a 1.97 helper build; a "not built yet" verdict would be more honest than "asset source does not exist".
        """
    observed_at git:a6f8574a54f58a077e0acafc000133da96c09c5b
    author "claude"
    created_at 2026-09-05
}

