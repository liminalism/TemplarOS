record legeos.papercut.third-bug-in-the-same-chain-after-the-machine/1 : papercut {
    title "Third bug in the same chain: after the --machine fix, lege-resourced…"
    state superseded
    statement """
        Third bug in the same chain: after the --machine fix, lege-resourced restarted fine but the activation gate still reported "came back without writing a build stamp". Root cause: RealStamps::read() (cli/lege/src/dev/systemd.rs) called lege_build::read_stamps(), which resolves its directory from the CURRENT process's own $XDG_RUNTIME_DIR -- root's (unset under sudo), not the desktop user's /run/user/<uid>/legeos/build where user-scope units (everything except hostd/boot-health) actually write. Confirmed by hand: /run/legeos/build does not exist at all; /run/user/1000/legeos/build/lege-resourced.json does, freshly written. Fixed by having RealStamps merge /run/legeos/build (system scope) with the target user's resolved /run/user/<uid>/legeos/build (user scope, uid read from /etc/passwd via SUDO_USER) when running as root.
        """
    observed_at git:f5007ef369d0b386fb872a6b726e3f8baaac5944
    author "claude"
    created_at 2026-09-01
}

record legeos.papercut.third-bug-in-the-same-chain-after-the-machine/2 : papercut {
    title "Third bug in the same chain: after the --machine fix, lege-resourced…"
    state verified
    statement """
        Third bug in the same chain: after the --machine fix, lege-resourced restarted fine but the activation gate still reported "came back without writing a build stamp". Root cause: RealStamps::read() (cli/lege/src/dev/systemd.rs) called lege_build::read_stamps(), which resolves its directory from the CURRENT process's own $XDG_RUNTIME_DIR -- root's (unset under sudo), not the desktop user's /run/user/<uid>/legeos/build where user-scope units (everything except hostd/boot-health) actually write. Confirmed by hand: /run/legeos/build does not exist at all; /run/user/1000/legeos/build/lege-resourced.json does, freshly written. Fixed by having RealStamps merge /run/legeos/build (system scope) with the target user's resolved /run/user/<uid>/legeos/build (user scope, uid read from /etc/passwd via SUDO_USER) when running as root.
        """
    observed_at git:f5007ef369d0b386fb872a6b726e3f8baaac5944
    closed_at 2026-10-06
    supersedes [ @legeos.papercut.third-bug-in-the-same-chain-after-the-machine/1 ]
    author "claude"
    created_at 2026-09-01
}

record legeos.papercut.tracing-subscriber-fmt-writes-ansi-colour-codes/1 : papercut {
    title "tracing_subscriber::fmt writes ANSI colour codes into journal MESSAGE…"
    state superseded
    statement """
        tracing_subscriber::fmt writes ANSI colour codes into journal MESSAGE fields of every templar unit (journalctl -o json returns them as byte arrays and they split 'templar_resourced::daemon: tick'), so anything parsing the journal must strip CSI sequences; disabling ANSI when JOURNAL_STREAM is set would avoid it.
        """
    observed_at git:50af3784cb5c3f0ebe72a1e15f12a88f57e11290
    author "sonnet-triage"
    created_at 2026-10-01
}

