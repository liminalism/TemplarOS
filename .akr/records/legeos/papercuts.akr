    state verified
    statement """
        The first WP11 check found that rusqlite 0.40 does not decode COUNT into usize and borrowed ValueRef accessors return FromSqlError. Decode counts as u64 and map borrowed field errors through rusqlite::Error; avoid guessing the regression path (generations.rs).
        """
    observed_at git:12295f351ab14e649f900573190060cd88a7251e
    author "codex"
    created_at 2026-10-08
}

