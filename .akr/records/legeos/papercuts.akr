record legeos.papercut.xtask-interface-baseline-regenerates-interfaces/1 : papercut {
    title "`xtask interface-baseline` regenerates interfaces/baseline.json…"
    state verified
    statement """
        `xtask interface-baseline` regenerates interfaces/baseline.json wholesale, so with two lanes adding D-Bus members concurrently, whichever lane freezes last captures both lanes' additions in one write — the file then cannot be committed with a single lane's path list. A per-member merge, or a check that names which interfaces changed since the last freeze, would let concurrent additions land independently.
        """
    observed_at git:3f796cf218ad2416629d9c5f793b1bf483e91505
    author "claude"
    created_at 2026-09-07
}
