record legeos.papercut.the-index-benchmark-drain-treated-six-empty/1 : papercut {
    title "The index benchmark drain treated six empty mutation polls as complete,…"
    state superseded
    statement """
        The index benchmark drain treated six empty mutation polls as complete, ignored actual overflow repair requests, and silently dropped apply failures; prior 10k bursts applied only 4097/2055/4167/4102/4097 mutations. The idle sampler also inherited live XDG/system bus and could not reap helper grandchildren. Replace with bounded owner-protocol repair and directly owned isolated bus/daemon sampling.
        """
    observed_at git:7c68786687bea7b20dbc382bdacc2804e7284b70
    author "IndexMaintenanceNativeProof"
    created_at 2026-10-06
}

