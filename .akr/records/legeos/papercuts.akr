record legeos.papercut.scripts-nested-session-sh-start-on-the-xorg/1 : papercut {
    title "scripts/nested-session.sh start on the Xorg development host fails with…"
    state superseded
    statement """
        scripts/nested-session.sh start on the Xorg development host fails with "line 94: WAYLAND_DISPLAY: unbound variable" because start_comp assumes a Wayland host to nest into, although lege-comp's winit backend nests into X11 fine when started by hand with DISPLAY=:0 and WAYLAND_DISPLAY unset. The script should accept an X11 host (keep DISPLAY when there is no WAYLAND_DISPLAY) or say so in one line instead of a bash trace.
        """
    observed_at git:243057df8a6c633bf6851c5c935eb0380317438c
    author "claude"
    created_at 2026-09-07
}

