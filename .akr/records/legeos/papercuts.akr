}

record legeos.papercut.session-tooling-initially-advertised-workspace/1 : papercut {
    title "Session tooling initially advertised workspace-write with read-only Git…"
    state verified
    statement """
        Session tooling initially advertised workspace-write with read-only Git and restricted sockets, so necessary commit/native socket/GPU commands repeatedly requested approvals even though the owner expected full access. Owner switched the environment to full access/no approval; resumed without escalation flags. Production shader tests additionally caught incomplete level-zero samplers and leftover instancing divisors, which Rust compilation cannot expose.
        """
    observed_at git:f8b45b799337788c258f373f409886a08e7ee7ef
    author "root"
    created_at 2026-10-09
}

record legeos.papercut.sessiond-fixture-path-libtest-assumed-tempfile/1 : papercut {
    title "Sessiond fixture-path libtest assumed tempfile::tempdir creates…"
    state verified
    statement """
        Sessiond fixture-path libtest assumed tempfile::tempdir creates mode0700; tempfile3.27 documents umask-derived, potentially world-readable directory permissions. Remove incidental-default assertion and explicitly control permissions when testing fixture admission.
        """
    observed_at git:7c68786687bea7b20dbc382bdacc2804e7284b70
    author "omp"
    created_at 2026-10-06
}

record legeos.papercut.set-metapackages-pin-nvidia-kernel-with-to-base/1 : papercut {
