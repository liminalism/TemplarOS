record legeos.papercut.the-app-manifest-schema-and-both-shipped-distro/1 : papercut {
    title "The app-manifest schema and both shipped distro/app-manifests/*.json…"
    state superseded
    statement """
        The app-manifest schema and both shipped distro/app-manifests/*.json declare `provides`, but lege_types::AppManifest has no provides field and no code reads it — a manifest declaring a provider role is silently ignored. Documented contract with no implementation; found during the WS5 pre-gate autostart audit.
        """
    observed_at git:cd6563649c3c85e3c23b92adb22d60de7ce90e44
