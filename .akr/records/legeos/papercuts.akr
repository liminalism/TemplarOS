record legeos.papercut.check-actions-cannot-see-a-chord-the-compositor/1 : papercut {
    title "check-actions cannot see a chord the compositor binds but the manifest…"
    state superseded
    statement """
        check-actions cannot see a chord the compositor binds but the manifest does not declare: it reads the manifest and the surfaces, and the compositor's recovery_action table is only cross-checked in the other direction by a #[cfg(test)] table in keybindings.rs that iterates the actions it already knows. Super+Space was bound with nothing in the manifest at 552ecb1 and no gate noticed until ac0bdff.
        """
    observed_at git:37033447950b39b2f9238f5c8ff0bff56ebb23fd
    author "claude"
    created_at 2026-09-10
}

