record legeos.papercut.batch-lege-to-templar-scope-watch-revisions/1 : papercut {
    title "Batch lege-to-templar scope/watch revisions succeeded for 135 heads.…"
    state superseded
    statement """
        Batch lege-to-templar scope/watch revisions succeeded for 135 heads. Same-key sealed planning revisions with unfinished children fail AKR-R016 despite supplying all CLI carried_forward dispositions: bare part_of resolves to the new parent head, invalidating the old disposition. Pinned child refs are rejected by CLI; no direct ledger edits used.
        """
    observed_at git:2bc8f741f3c21759c3e7c728d9c211868035aa18
    author "codex"
    created_at 2026-10-05
}

record legeos.papercut.batch-lege-to-templar-scope-watch-revisions/2 : papercut {
    title "Batch lege-to-templar scope/watch revisions succeeded for 135 heads.…"
    state superseded
    statement "Batch scope/watch migration initially over-supplied planning dispositions from inbound relations and failed AKR-R016. akr revise carries bare head relations forward automatically: supply only the pinned unfinished children explicitly listed by AKR-R014, not every inbound part_of. After following that rule all rename scope/watch heads migrated through supported CLI revisions."
    observed_at git:2bc8f741f3c21759c3e7c728d9c211868035aa18
    supersedes [ @legeos.papercut.batch-lege-to-templar-scope-watch-revisions/1 ]
    author "codex"
    created_at 2026-10-05
}

