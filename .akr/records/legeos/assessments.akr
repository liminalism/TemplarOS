akr 0.1
project legeos

record legeos.assessment.astra-memory-polling-indexing-review-20260909/1 : assessment {
    title "Astra advisor review of the memory governor, the watcher host and the file-index core — nine ranked findings, four must-fix"
    state superseded
    scope [
        path "crates/lege-file-index/**",
        path "services/lege-filed/src/delta_catchup.rs",
        path "services/lege-filed/src/index_host.rs",
        path "services/lege-filed/src/observer.rs",
        path "services/lege-filed/src/watcher.rs",
        path "services/lege-resourced/**"
    ]
    statement """
        An independent advisor pass (packet ad-9afae8b350d5, result rs-9198dc49c727, filed 2026-09-09 before the parent's notes were revealed) read every in-scope production file in lege-resourced, lege-filed's watcher/observer/index_host/delta_catchup and lege-file-index, ran the scoped tests (359 pass, 9 ignored) and scoped clippy (clean), and ranked nine findings. The parent's four hypotheses held: unbounded handoff channels, un-deduplicated repair queueing, a snapshot that is not one read transaction, and a failed PSI descriptor that degrades to a spin or a 60 s sleep. Astra added three independent priority defects: the governor's fallback wait keeps the 60 s idle heartbeat with no usable trigger and arms session.slice while governed instances live in the sibling app.slice; a complete subtree repair pass upgrades a root to Current/complete and erases an older whole-root overflow, watch-exhaustion or incomplete-namespace reason; and the watcher drops a failed coalesced apply batch with only a warning and can repair before a queued overflow Invalidate has settled, so the later invalidation re-stales a freshly repaired root with no work queued. Two further P2 items (unbounded D-Bus signal backlog and a count-bounded, not byte-bounded, trace ring; a critical-pressure grace delay bound to the episode rather than the victim, so a new victim can be killed on its first selected tick) and two deferred redesigns (btrfs delta baseline/checkpoint atomicity and watch rearming; Index::children decoding the whole descendant range with parent_id not maintained on move) complete the set. All findings are code-path analysis backed by passing tests; no production workload timing, privileged PSI trigger, D-Bus saturation or btrfs fault injection was measured.
        """
    confidence medium
    as_of git:fb992300dcb5fa49f92b44af8761e91d1c281175
    claim btrfs-baseline {
        text """
            delta_catchup.rs returns without a baseline and ensure_baseline has no production caller; plant writes the baseline pointer before decode/apply succeeds; btrfs_delta.rs reads the stream with unbounded read_to_end.
            """
    }
    claim children-scan {
        text """
            lib.rs Index::children decodes the whole descendant range and filters in Rust; take-on-trust reconciliation leaves parent None and place_at does not update parent_id on move.
            """
    }
    claim critical-grace {
        text """
            policy.rs critical_steps keeps one critical_since per pressure episode, not per selected victim.
            """
    }
    claim governor-wake {
        text """
            daemon.rs run_loop arms a PSI trigger on session.slice while scan.rs governs app.slice, and while Normal always waits the 60 s IDLE_HEARTBEAT even when PressureWait has no trigger; Trigger::wait maps POLLERR/HUP/NVAL and non-EINTR errors to Timeout.
            """
    }
    claim resourced-bounds {
        text """
            daemon.rs hands signals to the D-Bus task over an unbounded channel; trace.rs bounds the ring by record count (5000), not bytes.
            """
    }
    claim snapshot-frame {
        text """
            snapshot.rs write_snapshot reads generation, change sequence, roots and each root's entries through separate pooled reads despite documenting one read transaction, and buffers the full payload in RAM.
            """
    }
    claim subtree-upgrade {
        text """
            generation.rs committed_state derives Current/complete from the scoped pass alone; the metadata axis guards subtree upgrades but the namespace axis does not.
            """
    }
    claim unbounded-handoff {
        text """
            watch.rs opens an unbounded mpsc channel from the inotify reader thread and drains it whole per poll; watcher.rs repairs is a LIFO Vec with duplicates.
            """
    }
    claim watcher-ordering {
        text """
            watcher.rs drops a failed coalesced apply batch with a warning and queues no repair; an overflow repair can run before its Invalidate mutation leaves the coalescer.
            """
    }
    depends_on [
        @legeos.decision.event-driven-service-authorities,
        @legeos.decision.resourced-separate-process
    ]
    supported_by [
        @legeos.evidence.idle-index-wakeups-eliminated-20260904,
        @legeos.evidence.service-inventory-and-pressure-wakeups-20260907
    ]
    source {
        kind internal
        role rationale
        path ".agent/handoffs/ad-9afae8b350d5.json"
        use """
            The packet that scoped the review and withheld the parent's hypotheses until after the independent pass.
            """
    }
    source {
        kind internal
        role origin
        path ".agent/handoffs/rs-9198dc49c727.json"
        use """
            The advisor's ranked findings, coverage and commands, verbatim.
            """
    }
}

