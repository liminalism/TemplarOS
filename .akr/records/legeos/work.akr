record legeos.work.visible-notifications-pixelkit-20261007/1 : work {
    title "Visible bottom-right notifications with PixelKit toast cards and real terminal completion producers"
    state proposed
    scope [
        path "apps/templar-settings/**",
        path "cli/templar/**",
        path "crates/templar-client/**",
        path "crates/templar-session-core/**",
        path "crates/templar-window/src/geometry.rs",
        path "docs/planning/homegarden-previews-notifications-window-tabs.md",
        path "interfaces/dbus/**",
        path "services/templar-sessiond/**",
        path "session/profile.d/**",
        path "shell/templar-shell/**"
    ]
    intent """
        Make existing notifications reliably visible in a styled bottom-right shell popup using a host-independent PixelKit toast-card extension. Plan: docs/planning/homegarden-previews-notifications-window-tabs.md section2. Preserve sessiond/freedesktop provider authority/history rather than introduce a second server. Publish all committed creation/replacement/close/expiry/dismiss/action changes on correct paths, preserve replacement-generation expiry guards, and reconcile subscriptions/snapshots/service ownership without polling or highest-ID-only inference. Carry full presentation metadata instead of summary alone.
        Extend sibling ../pixelkit/crates/pixelkit-ui with measured themed card layout, icon/summary/body/actions/dismiss, shared hit geometry, keyboard/accessibility semantics and widget outcomes. Keep D-Bus/history/classification/lifetime policy out of PixelKit; shell hosts a bounded stack and next deadline. Bottom-right placement must clear the nonexclusive bar, machine cluster, gesture/corner controls, remain on chosen output, handle scale/hotplug and never steal focus or enter work cards/MRU. Normal dwell3/4/5s by completion/info/failure-actionable class from first presentation; retain sender server-timeout semantics and history separately. Lock hides content, ordinary fullscreen defers, stale queued messages do not replay. Proposals:3 visible,20 waiting; excess retained in history, not unbounded popup windows.
        Add an actual terminal job-completion producer rather than assume rendering detects jobs: Bash/zsh/fish hook contracts or explicit owned-command completion, preserving exit/pipeline status, prompt/CWD integration and job control. Foreground and background completion are distinct; suppress canceled/short/focused jobs by proposed policy, avoid raw secret-bearing command lines and duplicate terminal-native notifications. Initial long-job threshold10s is a reviewable default, not an existing setting.
        """
    note """
        Sibling PixelKit source is part of implementation even though repository-local scope globs cannot own it. Existing source has top-right6s toast code and an arrival watcher, but Notify/expiry do not emit its Changed signal; isolated service evidence is recorded, not a visual feature pass. Three-to-five seconds is popup dwell, not deletion of history or contradiction of expire_timeout=0; earlier producer close/expiry cancels presentation. No live desktop deploy during agent validation.
        """
    acceptance {
        check arrival-replacement-lifecycle {
            statement """
                Real private-bus producer drives a real shell popup for arrival and same-ID replacement; burst, close, expiry, dismiss and action produce correct once-only lifecycle signals at standard/companion paths. Restart producer/service/shell without losing new events or replaying stale snapshots.
                """
            method observation
        }
        check duration-idle-privacy {
            statement """
                Measure3/4/5-second default class dwell from first presentation with explicit timeout/hover exceptions, separate history retention, bounded burst policy and zero toast redraw/deadline after retirement. Lock exposes no message content and fullscreen deferral cannot replay stale messages.
                """
            method observation
        }
        check pixelkit-bottom-right {
            statement """
                Observe the actual themed PixelKit popup on an owned nested display: bottom-right clear of bar/corners, HiDPI and multi-output/hotplug correct, app/icon/summary/body/action/dismiss usable, no keyboard focus or MRU theft. Only expected input region intercepts clicks.
                """
            method observation
        }
        check terminal-producers {
            statement """
                Run real supported-shell jobs: long success/failure, pipelines, Ctrl-C, background completion and terminal-native duplicate notification. Observe exact completion classification and no changed exit status, prompt/CWD hooks or job control. Record actual Bash/zsh/fish and terminal coverage rather than infer universality.
                """
            method observation
        }
    }
    derived_from [ @legeos.assessment.desktop-preview-notification-tab-scope-20261007 ]
    author "dk"
}

record legeos.work.wallpaper-default-quantization/1 : work {
    title "Default 256-color WuDP after measured load-time tradeoff"
    state completed
    scope [
        path "crates/templar-session-core/src/settings.rs",
        path "crates/templar-types/src/wallpaper.rs",
        path "crates/templar-wallpaper/src/decode.rs",
        path "docs/measurements/wallpaper-quantization-default-20261006.json",
        path "docs/planning/low-memory-wallpaper-switcher.md"
    ]
    intent """
        Make 256-color WuDP the default when measured full-size load overhead is reasonable for infrequent wallpaper changes, as requested by the owner. Preserve explicit null/off configuration rather than overriding persisted user opt-outs. Record actual optimized RGBA/indexed worker timings, texture bytes and visible quality limitations; do not claim unobserved GPU/system savings or completion of the parent's full release gates.
        """
    acceptance {
        check default-and-opt-out {
            statement """
                Actual no-options and empty-options decoding emits Indexed8 with a 256-color palette; explicit null emits RGBA8. A private real sessiond/CLI exposes default 256-color policy, retains explicit off through restart, and reset/history restore the intended default versus explicit off settings.
                """
            method observation
            verified_by [ @legeos.evidence.wallpaper-default-quantization/1 ]
        }
        check measured-overhead {
            statement """
                Three optimized real worker runs per mode on derived 4K photographic wallpapers and a 4K gradient show total indexed decode under one second on this host, with declared 192-MiB worker limit and fourfold logical native source-texture savings. Visual review records banding rather than asserting losslessness.
                """
            method observation
            verified_by [ @legeos.evidence.wallpaper-default-quantization/1 ]
        }
    }
    part_of [ @legeos.work.low-memory-wallpaper-switcher ]
    author "dk"
    source {
        kind internal
        path "docs/planning/low-memory-wallpaper-switcher.md"
        excerpt """
            Owner-approved 256-color default after optimized load measurement; explicit off remains available.
            """
    }
}

