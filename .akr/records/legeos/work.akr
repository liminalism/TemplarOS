            verified_by [ @legeos.evidence.hardware-inventory-closure-rerun-20260907/1 ]
        }
        check iso-builds-and-boots {
            statement """
                distro/iso/build.sh produces an ISO from a resolute-built set, and tests/integration/iso-qemu.sh boots it under Secure-Boot OVMF and reads a passing preflight network line off the serial console.
                """
            method command
            command "distro/iso/build.sh --work /var/tmp/legeos-build/@build --out /var/tmp/legeos-build/@build && tests/integration/iso-qemu.sh"
            verified_by [
                @legeos.evidence.first-iso-built-and-booted-under-secure-boot-20260907/1
            ]
        }
        check laptop-boots-the-medium {
            statement """
                The owner boots the written USB stick on the reference laptop with Secure Boot on, and the preflight report on the live session shows every line passing (or names exactly what did not).
                """
            method manual
        }
        check preflight-is-honest {
            statement """
                The live preflight passes a working machine, fails a machine with no bound driver and no input, calls a radio whose firmware did not load a failure rather than a skip, and skips a machine with no Wi-Fi at all — all against fixture trees, never the host.
                """
            method command
            command "cargo test -p lege preflight"
            verified_by [ @legeos.evidence.preflight-fixture-tests-20260907/1 ]
        }
        check seeds-regenerate {
            statement """
                The hardware layer's additions generate cleanly and name only packages that exist in the declared base.
                """
            method command
            command "cargo run -q -p xtask -- seeds --check && cargo run -q -p xtask -- check-packaging"
            verified_by [ @legeos.evidence.campaign2-merged-gate-20260907/1 ]
        }
    }
    implements [ @legeos.decision.base-ubuntu-2604-kernel-70 ]
    part_of [ @legeos.work.self-hosting-legeos ]
    supersedes [ @legeos.work.iso-hardware-safety/1 ]
}

record legeos.work.launcher-and-one-folder-route-20260908/1 : work {
    title "Lane C — the Home search is an application launcher you can type into, and one route from Home to the file manager"
    state proposed
    scope [
        path "shell/lege-shell/src/app_search.rs",
        path "shell/lege-shell/src/omnibox.rs",
        path "shell/lege-shell/src/recents.rs",
        path "shell/lege-shell/src/surface/app.rs",
        path "shell/lege-shell/src/surface/field_screen.rs",
        path "shell/lege-shell/src/surface/offscreen.rs",
        path "shell/lege-shell/src/surface/omnibox_screen.rs"
    ]
    intent """
        Act on the user's two complaints about the Home search on 2026-09-08 ('it is also hard to use', 'there are some discrepancies between how the various buttons on the home screen open to the file manager'). (C1) Rank like a launcher: an abbreviation tier below the substring tier, a recency boost within a tier read from recents.rs alone, and a second line that names the .desktop the application is installed under instead of the shell's internal id. (C2) Keyboard flow: a printable key on bare Home opens the search and goes into it, Escape empties and leaves it, the pointer moves the one highlight instead of painting a second, and the launcher stops printing 'still searching files…' under an answer it already has. (C3) Decide against importing cosmic-launcher or pop-launcher, recorded in the decision this implements. (C4) One route from Home to a folder: every press arrives at open_in_file_manager, the OpenFolderWindow alias is retired, and the Place menu's open-files row stops resolving the FileManager role a second time.
        """
    target 2026-09-08
    note """
        The other half of 'the search bar doesn't draw focus to what it opens' is the compositor's (Lane A, contract K1: a newly mapped window is activated at map). Nothing in the shell re-takes the keyboard or re-reveals Home after a launch — that was already true at 1c56b77 and is now covered by a test.
        """
    acceptance {
        check actions-gate {
            statement """
                check-actions stays green: the launcher needed no new action id, so every action a surface names is still declared and every chord still has a pointer route.
                """
            method command
            command "cargo run -q -p xtask -- check-actions"
        }
        check one-folder-route {
            statement """
                No press on Home reaches a file manager except through open_in_file_manager, and the Place menu's open-files row and a Folder tile produce the same role and the same argument vector.
                """
            method command
            command "cargo test -p lege-shell -- every_folder_press_on_home_opens_the_file_manager_on_that_folder opening_a_place_in_files_is_not_a_second_route_of_its_own"
        }
        check shell-tests {
            statement """
                cargo test -p lege-shell is green, including the new tiers, the recency boost, the detail line, type-to-search, Escape, the single highlight and the folder routes.
                """
            method command
            command "cargo test -p lege-shell"
        }
        check typed-launch {
            statement """
                In the nested session, typing pcm on bare Home and pressing Enter opens pcmanfm-qt with the keyboard and leaves no results on screen; every folder press opens pcmanfm-qt on that folder.
                """
            method manual
        }
    }
    implements [ @legeos.decision.the-home-field-is-a-launcher-not-a-search ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.logical-app-and-variant-identity/1 : work {
    title "WS5 — logical app + variant identity: provenance, trust tiers, variant-keyed rights"
    state completed
    scope [
        path "crates/lege-appd/**",
        path "crates/lege-associationd/**",
        path "crates/lege-client/**",
        path "crates/lege-state/**",
        path "crates/lege-types/**",
        path "interfaces/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Identity phases 0-4 and 8. Today's AppId is the variant id (pub type AppVariantId = AppId); LogicalAppId is a new newtype sharing the validator; the cgroup/unit name keeps naming the variant. AppProvenance (origin kind, trust tier derived never declared, source path, package ref, version, desktop entry, launch mechanism, executable, sandboxed, update owner, declared privileges and provider claims as inert claims) attaches to every manifest. Import keys candidates on (origin_namespace, desktop_id) — the XDG chain keeps freedesktop shadowing, flatpak exports become their own namespace with ids flatpak.<X-Flatpak id>, fixing the live bug where a flatpak export and a distro package sharing a desktop id collapse and the distro app silently vanishes. Old flatpak ids migrate by resolve-through-alias (app_variant_aliases), never by rewriting stored rows, so rollback stays safe. Logical grouping joins variants only on five explicit rules (declared logical app, shared desktop-entry id across origins, flatpak alias, StartupWMClass+Name, shared executable minus multiplexers); minted logical ids persist. AppIdentity1/Projects1/Launcher1 extended additively (ListLogicalApps, ListVariants, LogicalAppOf, ListInstancesDetailed, LaunchLogical); ResolveWindow unchanged. Phase 4 closes two live security gaps: Providers1.Declare verifies the caller's own variant via peer PID to cgroup; a User-trust variant may not declare an exclusive provider role; and a desktop id whose provenance moves System to User trust has its provider declarations and autostart approvals dropped with a history event. Associationd records logical_app_id beside app_id and substitutes sibling variants with reason variant-substituted.
        """
    note """
        Settled: AppVariantId stays an alias (rename separable); the Declare credential check lands here because it is what makes variant-keyed rights enforceable; migration 0006 is additive with the explicit review step that no column-less INSERT exists anywhere. A wrong logical merge is cosmetic by design because rights key on the variant.
        """
    acceptance {
        check collision-regression {
            statement """
                A distro org.mozilla.firefox.desktop and a flatpak export of the same desktop id import as two distinct variants grouped under one logical app; today's silent disappearance is gone.
                """
            method command
            command "cargo test -p lege-appd"
            verified_by [ @legeos.evidence.ws5-collision-regression-20260901/1 ]
        }
        check migration-fixture {
            statement """
                A database seeded with pre-0006 association, provider and desktop-import rows returns identical values for every pre-existing read after migration 0006 applies.
                """
            method command
            command "cargo test -p lege-state"
            verified_by [ @legeos.evidence.ws5-migration-fixture-20260901/1 ]
        }
        check one-firefox {
            statement """
                With two variants installed the shell search shows one application whose details offer the variant choice, and an association whose stored variant was uninstalled resolves to a sibling with reason variant-substituted.
                """
            method manual
            verified_by [ @legeos.evidence.ws5-one-firefox-20260901/1 ]
        }
        check trust-gates {
            statement """
                A user-writable .desktop cannot take an exclusive provider role; a user entry shadowing a system entry does not inherit its grants; Declare from a caller whose cgroup does not own the declared variant is refused.
                """
            method command
            command "cargo test -p lege-sessiond providers"
            verified_by [ @legeos.evidence.ws5-trust-gates-20260901/1 ]
        }
    }
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.pcmanfm-qt-integration/1 : work {
    title "pcmanfm-qt as the file manager: the role, the composition, and the three routes into filed"
    state active
    scope [
        path "cli/lege/**",
        path "crates/lege-session-core/src/providers.rs",
        path "debian/legeos-cli.install",
        path "distro/app-manifests/**",
        path "distro/deploy/components.toml",
        path "distro/seeds/selection.toml",
        path "docs/architecture/files.md",
        path "services/lege-filed/src/bookmarks.rs",
        path "shell/lege-shell/src/surface/app.rs"
    ]
    intent """
        Make `pcmanfm-qt` the session's file manager and take `lege-files` out of the composition. `ProviderRole::FileManager` becomes a derived capability off `Categories=FileManager` (`lege-session-core/src/providers.rs`), pcmanfm-qt at priority 100; `distro/app-manifests/org.legeos.Files.json` is deleted, so nothing claims the role or `inode/directory` on Files' behalf and no shipped manifest names an uninstalled executable. `FieldAction::OpenInFiles` stops hardcoding `org.legeos.Files` and resolves the role through the providers map (`app.rs::open_in_file_manager`), reusing the "Settings ▸ Providers" sentence every unfilled role uses. Seeds swap `lege-files` for `pcmanfm-qt` plus `qt6-wayland`; the `files` component stays in `distro/deploy/components.toml` because that matrix is the build set, not the image. Integration: two DES-EMA custom actions shipped by `legeos-cli` over two new CLI subcommands (`lege home place`, `lege project create-here`), and a one-way bookmarks export from filed to `$XDG_CONFIG_HOME/gtk-3.0/bookmarks`.
        """
    note """
        Two things the packet asked for turned out not to need doing. `session/lege-session` needs no `QT_QPA_PLATFORM`: pcmanfm-qt was launched against the nested compositor with the variable unset and Qt selected the Wayland plugin itself (`qt.qpa.wayland` in its own log; `lege_comp::xdg_shell toplevel mapped window_id=WindowId(5) layer=Some(Normal)` in the compositor's). And filed's `Trash1` already follows the freedesktop Trash specification on exactly the directories libfm-qt uses, so Home's Trash and pcmanfm-qt's are the same trash with no code written.

        "Search here" is deferred rather than shipped: FSearch has no option to scope a search to a folder (`app.rs::search_everywhere` already says so), and pcmanfm-qt has its own Find. A menu entry that silently searched everywhere would be a lie.

        `legeos.work.standalone-file-manager` is `completed`, not live, so there was nothing to supersede; this record cites it through the decision's `derived_from` instead.
        """
    acceptance {
        check composition {
            statement """
                The seeds and the legeos-desktop metapackage name pcmanfm-qt and qt6-wayland and no longer name lege-files, and every generated file matches the selection.
                """
            method command
            command "cargo run -q -p xtask -- seeds --check && cargo run -q -p xtask -- check-packaging"
            verified_by [ @legeos.evidence.bar-ground-and-pcmanfm-role-20260907/1 ]
        }
        check filed-routes {
            statement """
                The two CLI subcommands the custom actions call exist and are tested, and a bookmark mutation rewrites the GTK bookmarks file libfm-qt reads.
                """
            method command
            command "cargo test -p lege create_here && cargo test -p lege-filed bookmarks"
            verified_by [ @legeos.evidence.bar-ground-and-pcmanfm-role-20260907/1 ]
        }
        check hands-on-confirmation {
            statement """
                At the desktop: opening a folder from Home opens a pcmanfm-qt window with LegeOS chrome; "Add to Home" in its context menu puts that folder on the Home Field as a tile; "Create project here" makes a project named for the folder; a folder bookmarked in Home appears in pcmanfm-qt's Places.
                """
            method manual
        }
        check role-and-launch {
            statement """
                The FileManager role is derived from Categories=FileManager with pcmanfm-qt at priority 100, and nothing in the shell names an application to open a folder.
                """
            method command
            command "cargo test -p lege-session-core providers && cargo test -p lege-shell"
            verified_by [ @legeos.evidence.bar-ground-and-pcmanfm-role-20260907/1 ]
        }
        check runs-under-lege-comp {
            statement """
                pcmanfm-qt opens a folder window on lege-comp with LegeOS chrome and no QT_QPA_PLATFORM in its environment.
                """
            method observation
            verified_by [ @legeos.evidence.pcmanfm-qt-under-lege-comp-20260907/1 ]
        }
    }
    implements [ @legeos.decision.pcmanfm-qt-is-the-file-manager ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.project-semantic-service/1 : work {
    title "WS4 — projects as authoritative semantic objects; priority_boost becomes ProjectImportance"
    state completed
    scope [
        path "cli/lege/**",
        path "crates/lege-client/**",
        path "crates/lege-session-core/**",
        path "interfaces/**",
        path "services/lege-filed/**",
        path "services/lege-sessiond/**"
    ]
    intent """
        Identity phases 5-7. Projects1 is extended additively — no Projects2: Describe(id) returning project_json against interfaces/schemas/project.schema.json, ListDetailed, Update with an explicit key allowlist (unknown key refused, nothing stored), GetCurrent/SetCurrent (stored in settings_values under _internal.projects.current), SetState(active|archived) with archived projects still searchable and openable, AddLogicalApp(logical id + optional preferred variant), and Changed/CurrentChanged signals. The Project struct gains importance, state, created/last-opened/last-active timestamps and references, and loses the inert priority_boost — replaced by ProjectImportance { Normal, Important }; the JSON blob is serde-additive in both directions so no schema migration is needed. Open/close call Files.Recents1.SetProject/ClearProject, waking the dead Suggestion::CurrentProject in lege-filed. ProjectApp gains logical_app and last_variant; opening resolves preferred variant, then the logical default, then warn-and-skip, recording what launched. Importance reaches the governor without touching lege-resourced: an Important open project sets protected=true through the existing Resources1.SetInstanceHints on the instances it launched, restored on close or demotion. HomeField stores only presentation (this project is here, this size); the project service is the record of membership.
        """
    note """
        A graded importance channel is deliberately not built until resourced has a weight to multiply it by — the priority_boost lesson. CLI: lege project show / set --importance --state / current.
        """
    acceptance {
        check blob-compat {
            statement """
                An old project blob still carrying priority_boost loads with the value ignored; a new blob read by the previous binary round-trips without loss; apply_changes refuses an unknown key.
                """
            method command
            command "cargo test -p lege-session-core projects"
            verified_by [ @legeos.evidence.ws4-blob-compat-20260901/1 ]
        }
        check update-roundtrip {
            statement """
                Update followed by Describe round-trips every allowlisted field through the D-Bus API, and SetCurrent reaches lege-filed's recents suggestion.
                """
            method command
            command "cargo test -p lege-sessiond projects"
            verified_by [ @legeos.evidence.ws4-update-roundtrip-20260901/1 ]
        }
        check variant-reopen {
            statement """
                A project whose pinned flatpak variant was uninstalled reopens on the sibling variant and says so in history.
                """
            method manual
            verified_by [ @legeos.evidence.ws4-variant-reopen-20260901/1 ]
        }
    }
    depends_on [ @legeos.work.logical-app-and-variant-identity ]
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.provisioning-storage-plan-and-reuse/1 : work {
    title "Implement reviewed per-partition storage plans, preservation and optional data roles"
    state active
    scope [
        path "distro/deploy/**",
        path "installer/**",
        path "services/lege-filed/**",
        path "services/lege-sessiond/**",
        path "tests/**"
    ]
    intent """
        Extend the canonical layout and narrow Developer Edition provisioner with stable device/filesystem identity, explicit create/reuse/format choices, optional independent data roles, per-filesystem indexing policy and a reviewed operation plan shared by dry-run and apply. Coordinate any label-to-UUID/PARTUUID migration across fstab, boot entries, deployment activation and rollback. Reuse the existing live/recovery image and deployment owner after backend acceptance.
        """
    note """
        Existing --esp/--root mode is destructive formatting, not preservation. GParted and a guided two-drive UI follow backend acceptance. Central build placement, NOCOW and active index checkpoints remain measured opt-ins.

        2026-09-07. Two notes on how this landed.

        This was scoped as a label-to-UUID migration. It was that plus a missing step: `installer/provision.sh` wrote no `/etc/fstab` at all, so a provisioned machine had nothing telling it how to mount its own subvolumes (@legeos.observation.the-provisioner-wrote-no-fstab-at-all).

        The data role needed no new plumbing in lege-filed: `search.rs::ensure_root` already registers an arbitrary root with its own `RootPolicy`. What was missing was a test saying the two stay independent, which is what `two_roots_keep_independent_freshness_and_scoped_search` now is. Wiring a `[data]` root from `install.toml` waits until a machine has one to point at.

        `partition-preservation` and `live-recovery` stay user gates: both need `--apply` as root against loop or real devices, which no agent may run. `tests/integration/provision-plan.sh` reports NOT EXECUTED for those paths rather than passing over them, and `RUNBOOK-L3.md` carries the commands.
        """
    acceptance {
        check boot-deployment-identity {
            statement """
                Provisioner, fstab, boot-entry, activation and rollback agree on stable installation and deployment identities: fstab and /etc/legeos/install.toml are written by UUID, hostd's boot entries read that file and fall back to the label when it is absent, and a duplicate filesystem label is refused before anything is written.
                """
            method command
            command "just provision-test && cargo test -p lege-hostd boot_entries"
            verified_by [ @legeos.evidence.provisioning-plan-and-uuid-identity-20260907 ]
        }
        check data-index-boundaries {
            statement """
                Independent data roots report correct freshness, search visibility, acquisition coverage and accounting scope without treating index checkpoints as user content or backup.
                """
            method command
            command "cargo test -p lege-file-index -p lege-filed"
            verified_by [ @legeos.evidence.provisioning-plan-and-uuid-identity-20260907 ]
        }
        check live-recovery {
            statement """
                The same live medium installs and recovers a disposable installation through the existing deployment owner; hardware and Secure Boot remain user-run gates.
                """
            method manual
        }
        check operation-plan-identity {
            statement """
                Dry-run and apply consume one operation sequence: every command a dry run prints is recorded in plan.json, apply refuses a plan whose observed topology, filesystem identity or mounted state has drifted, and the plan classifies each operation as create, format, reuse, mount, grub or configure.
                """
            method command
            command "just provision-test"
            verified_by [ @legeos.evidence.provisioning-plan-and-uuid-identity-20260907 ]
        }
        check partition-preservation {
            statement """
                Disposable fixtures prove preservation does not rewrite type codes or format ESP/root/data unless requested, while explicit formatting produces the declared layout.
                """
            method observation
        }
    }
    depends_on [
        @legeos.constraint.native-lubuntu-is-the-development-environment/1,
        @legeos.work.reference-machine-provisioning/1
    ]
    implements [ @legeos.decision.independent-storage-roles ]
    part_of [ @legeos.milestone.developer-edition-0-1/1 ]
}

record legeos.work.reference-hardware-qualification/1 : work {
    title "D4 — lege doctor --hardware executes bounded read-only probes and emits one qualification report with four outcomes"
    state proposed
    scope [
        path "cli/lege/src/doctor/hardware.rs",
        path "cli/lege/src/doctor/mod.rs",
        path "crates/lege-hwdetect/**",
        path "distro/hardware/**",
        path "services/lege-boot-health/src/main.rs",
        path "tests/hardware/**"
    ]
    intent """
        Add crates/lege-hwdetect probes (timeout-bounded, read-only: kernel and module versions, module signer, nvidia-smi, vulkaninfo, PRIME offload, CUDA deviceQuery where present, VA-API), have lege-boot-health delegate its existing four probes to them, add a NotExecuted outcome distinct from Skipped, and make `lege doctor --hardware` run the safe subset and print or JSON-emit one qualification report in which manual cases stay NotExecuted with their steps. Send the exact NVIDIA/CUDA package list to the package-selection lane.
        """
    note """
        HEAD reconciliation 2026-09-03: the runner exists and is honest (cases compiled in, all emitted as Skipped) but executes no probes; boot-health already has bounded probes; Outcome has Pass/Fail/Skipped only.

        2026-09-07: the two command checks are satisfied and the record stays open on `manual-matrix-user-run`, which no agent can close. Suspend/resume, output hotplug, GPU-mode transitions and Secure Boot are a person at the reference laptop with `installer/CHECKLIST.md`; the exact commands are in `.agent/scratch/pre-iso/RUNBOOK-L3.md`. Recording them as anything other than not-yet-run would be the failure the four-outcome report exists to prevent.
        """
    acceptance {
        check four-outcome-report {
            statement """
                `lege doctor --hardware --json` on the reference profile emits a report distinguishing pass, fail, skipped and not-executed, with manual cases not-executed.
                """
            method command
            command "cargo test -p lege doctor::hardware"
            verified_by [
                @legeos.evidence.de01-hardware-report-20260904,
                @legeos.evidence.de01-integrated-gate-20260904
            ]
        }
        check manual-matrix-user-run {
            statement """
                Suspend/resume, output hotplug, GPU-mode transitions and Secure Boot checks are executed by the user on the reference laptop and recorded as evidence.
                """
            method manual
        }
        check probes-are-bounded-and-honest {
            statement """
                A hung probe becomes NotExecuted, a missing binary becomes Skipped, and neither is reported as Pass or Fail.
                """
            method command
            command "cargo test -p lege-hwdetect probes"
            verified_by [ @legeos.evidence.de01-integrated-gate-20260904 ]
        }
    }
    implements [
        @legeos.decision.base-ubuntu-2604-kernel-70,
        @legeos.decision.one-privileged-host-daemon
    ]
    part_of [
        @legeos.milestone.developer-edition-0-1,
        @legeos.work.desktop-validation-foundations
    ]
}

record legeos.work.reference-machine-provisioning/1 : work {
    title "D3 — one storage/deployment layout declaration, a narrow target-machine provisioner, and GRUB entries that carry legeos.deployment="
    state active
    scope [
        path "distro/deploy/README.md",
        path "distro/deploy/layout.toml",
        path "distro/image/mkosi.extra/**",
        path "distro/image/mkosi.postinst",
        path "distro/image/mkosi.repart/**",
        path "docs/adr/0004-boot-deploy-secure-boot.md",
        path "installer/**",
        path "services/lege-hostd/src/boot_entries.rs",
        path "services/lege-hostd/src/deploy.rs",
        path "tests/integration/provision-qemu.sh"
    ]
    intent """
        Declare the GPT/UEFI and Btrfs layout once (distro/deploy/layout.toml: @, @home, @var, @snapshots, @deployments, deployment id, the legeos.deployment= command-line key) and have both the mkosi repart configuration and a declarative provisioner (installer/provision.sh, every destructive step parameterised by a disk-image path) consume it. Provision from an Ubuntu 26.04 base: subvolumes, canonical sources plus the local LegeOS archive, the legeos-* metapackages, the Ubuntu-signed kernel with its matching NVIDIA LRM while retaining the previous kernel, OS identity, user, units and `lege doctor --root`. With ADR-0004 resolved to Canonical shim + GRUB, a GRUB entry writer (services/lege-hostd/src/boot_entries.rs, called from the Grub backend) generates entries that carry the deployment id and a known-good entry. Move dev-image credentials to a dev-only drop-in, document the recovery-shell route, and add a QEMU provisioning test that prints not-executed when qemu is absent.
        """
    note """
        HEAD reconciliation 2026-09-03: repart declares @ @home @var @snapshots while the engine stages @deployments/<id>; systemd-boot entries carry the id but the Grub backend writes no entry; installer/ is a README; mkosi.conf sets RootPassword=legeos and Autologin=yes; no QEMU test.

        2026-09-07: `disposable-provisioning` is satisfied by the honest half of it. Steps 1 and 2 of provision-qemu.sh run as an ordinary user and pass; step 3 reports NOT EXECUTED because mkosi is absent so there is no image to boot. An `--apply` and a real QEMU boot are user gates in RUNBOOK-L3.md. `one-layout-declaration` still rests on the mkosi-absent evidence for its `just image summary` half.
        """
    acceptance {
        check disposable-provisioning {
            statement """
                A disposable image file is provisioned and booted under QEMU, or the script reports not-executed because qemu or an image is absent; the real target disk is a user-run gate with a checklist.
                """
            method command
            command "tests/integration/provision-qemu.sh"
            verified_by [ @legeos.evidence.provision-qemu-plan-and-refusals-20260907 ]
        }
        check grub-entries-carry-id {
            statement """
                The GRUB entry writer produces entries whose command line carries legeos.deployment=<id> for the candidate and the known-good deployment, naming the root by the UUID the provisioner recorded and falling back to the label when it did not, and a test proves it.
                """
            method command
            command "cargo test -p lege-hostd boot_entries"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.provisioning-plan-and-uuid-identity-20260907
            ]
        }
        check one-layout-declaration {
            statement """
                The repart configuration and the provisioner both derive from distro/deploy/layout.toml, which declares @deployments alongside the existing subvolumes; `just image summary` still validates.
                """
            method command
            command "cargo test -p lege-hostd layout && just image summary"
            verified_by [
                @legeos.evidence.de01-image-summary-mkosi-absent-20260904,
                @legeos.evidence.de01-integrated-gate-20260904
            ]
        }
    }
    implements [
        @legeos.decision.base-ubuntu-2604-kernel-70,
        @legeos.decision.boot-deploy-secure-boot,
        @legeos.decision.mkosi-images
    ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    resolves [ @legeos.question.grub-entries-must-carry-the-deployment-id ]
}

record legeos.work.representation-chrome-and-continuity/1 : work {
    title "WS3 — Home representation controls and spatially continuous expansion"
    state active
    scope [ path "crates/lege-field/**", path "shell/lege-shell/**" ]
    intent """
        Complete manipulation controls for current Home representations without reviving the retired title band or visible compositor resize grip. Micro and Small tiles keep identity in the body and reveal compact Home manipulation controls on hover or keyboard focus; Wide and larger representations may use a persistent heading when their content contract requires it. Expansion animates from the tile's current rect and collapse recomputes that target each frame, with the representation ladder supplying the content transition and reduced-motion removing intermediate frames.
        """
    note """
        This is shell-tile chrome inside Home. The persistent compositor bottom tags and exterior resize perimeter are governed separately. Re-baseline headless renders only after a coherent representation phase.

        2026-09-07. The gap was as recorded: Expansion and the per-frame collapse target already existed, and the reveal-strip geometry was inline inside paint_tile. It is now FieldScreen::control_rects next to grab_strip, returning the reveal strip, the controls, the title and what is left for the body.

        Extracting it surfaced a real defect the inline version hid: the title line spanned the tile's full width while the revealed controls sat over its right-hand end, so a long name was drawn under the buttons. control_rects now shortens the title to stop where the controls start. Identity is never hidden — a revealed tile shows a shorter name, not a name with three buttons on top of it. Confirmed pixel-neutral for the default field: the offscreen baseline hash was unchanged by this commit (its render has nothing hovered or focused).

        The collapse target became FieldScreen::collapse_target for the same reason — `it follows a moved tile` was previously only observable by looking at pixels.
        """
    acceptance {
        check expansion-interpolation {
            statement """
                Expansion interpolation is monotone, terminates, equals the current tile rect at t=0 and the full area at t=1, collapse follows reflowed tile position, and reduced_motion yields no intermediate frames.
                """
            method command
            command "cargo test -p lege-shell expansion_is_endpoint_exact_monotone_and_terminates reduced_motion_expansion_has_no_intermediate_frames collapse_target_follows_a_moved_tile"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
        check hands-on-chrome {
            statement """
                In a nested session, compact Home tiles reveal usable manipulation controls, larger representations remain calm, and expansion visibly grows from and collapses back to the tile's current place.
                """
            method manual
        }
        check representation-controls {
            statement """
                Every representation keeps identity visible, exposes manipulation to pointer and keyboard without covering required content, and shares painting and hit-testing geometry.
                """
            method command
            command "cargo test -p lege-shell compact_rungs_reveal_controls_only_when_hovered_or_focused_and_never_cover_the_title_line wide_and_up_keep_a_persistent_heading"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
    }
    depends_on [ @legeos.work.adaptive-files-and-omnibox ]
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
    source {
        kind external
        role origin
        document "legacy-homefield-design"
        start_byte 14150
        end_byte 23844
        start_line 238
        end_line 435
        excerpt_hash "sha256:05c597d610ae9e563573244e46865228691b239269a1de137f191fbdc893b099"
        use """
            Retains representation ladders, stable bounded geometry, local reflow and restrained visual identity.
            """
    }
}

record legeos.work.reversible-window-arrangement-presets/1 : work {
    title "One-press reversible arrangements for all open windows"
    state completed
    scope [
        path "compositor/lege-comp/**",
        path "crates/lege-types/src/action.rs",
        path "crates/lege-window/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Add a Home control made of manifest-declared buttons that arranges the eligible open windows on an output into useful shapes: one-window focus/full-output, halves, thirds, quarters/grid, a large-focus-plus-side-stack layout, and a cushion/treemap-style packing inspired by Silvaview. The compositor owns window geometry and recoverability; the shell only requests a named preset and renders its preview/button.

        The first preset request snapshots every affected window's prior geometry and state. Choosing a different preset recomputes directly from that baseline and the current eligible window set, so a person can audition arrangements by pressing buttons without walking an undo history. Restore returns surviving windows exactly to the saved baseline, repaired only when output topology makes an old rectangle unreachable. Closed windows disappear cleanly; newly opened windows join on the next explicit preset press rather than causing surprise background retiling. The feature is user-invoked arrangement, not a permanently enforced tiling window manager.

        Arrangement controls live on Home. An application can still be fullscreen with no Home chrome visible, and the compositor's shell-independent recovery routes remain available.
        """
    acceptance {
        check buttons-and-accelerators {
            statement """
                Every arrangement and Restore has a visible Home button/menu route and may additionally have a Super accelerator declared by the same action manifest.
                """
            method command
            command "cargo run -q -p xtask -- check-actions"
            verified_by [ @legeos.evidence.window-arrangements-20260831/1 ]
        }
        check dynamic-window-set {
            statement """
                Closed windows are ignored, newly opened windows join only on the next explicit arrangement request, and output removal repairs without losing any surviving window.
                """
            method command
            command "cargo test -p lege-comp arrangement"
            verified_by [ @legeos.evidence.window-arrangements-20260831/1 ]
        }
        check fullscreen-remains-clean {
            statement """
                A fullscreen application occupies the output with no Home panel, dock, arrangement control or reserved strip visible.
                """
            method observation
            verified_by [ @legeos.evidence.arrangements-fullscreen-clean-20260831/1 ]
        }
        check preset-geometry {
            statement """
                Every declared preset produces deterministic, bounded, non-overlapping recoverable rectangles for one through a practical upper bound of windows on mixed-scale outputs.
                """
            method command
            command "cargo test -p lege-window arrangement"
            verified_by [ @legeos.evidence.window-arrangements-20260831/1 ]
        }
        check switch-from-baseline {
            statement """
                A→B preset switching is computed from one retained baseline rather than from A's geometry, and Restore returns the exact baseline when the output still permits it.
                """
            method command
            command "cargo test -p lege-window arrangement_presets_are_reversible"
            verified_by [ @legeos.evidence.window-arrangements-20260831/1 ]
        }
    }
    depends_on [ @legeos.work.home-panel-and-dock-layouts ]
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.self-hosting-legeos/1 : work {
    title "Make LegeOS bootable on the reference laptop and able to build itself, so Lubuntu can be deleted"
    state proposed
    scope [
        path "Cargo.toml",
        path "ISO-PLAN.md",
        path "distro/**",
        path "installer/**",
        path "tests/integration/iso-qemu.sh",
        path "tests/integration/provision-qemu.sh"
    ]
    intent """
        Get from the Developer Edition 0.1 lanes to a LegeOS that boots on the reference laptop, joins WiFi through NetworkManager and nm-tray-2, and builds its own source tree — after which Lubuntu is deletable rather than load-bearing. Route (ISO first, then install into the free tail of nvme1n1, then develop from inside): ISO-PLAN.md.
        """
    note """
        Plan of record: ISO-PLAN.md (supersedes docs/planning/self-hosting-legeos.md as the order of work). Done in the tree as of 2026-09-05: closure resolved, metapackages built into the set, provisioner --free-space/--esp --root/--archive, ISO build script and QEMU harness written but not run. SEQUENCING 2026-09-07: this record is the ISO campaign itself and is deliberately the last proposed work item to start — the pre-ISO campaign (plans: construct-a-plan-to-woolly-acorn) closes or defers every other proposed record first; nothing in that campaign changes the route here. Still blocked on: the btrfs build volume (P0.2), a published set with the metapackages, the nm-tray-2 push (P0.5), and P0.4 sibling pins (pixelkit has no remote; bpg-rs and Lege-ecosystem are unpushed).
        """
    acceptance {
        check boots-with-secure-boot {
            statement """
                The target boots with Secure Boot on, with no MOK prompt, and /proc/cmdline carries legeos.deployment=<id> matching a directory on the ESP
                """
            method manual
        }
        check closure-resolved {
            statement """
                cargo xtask seeds closure resolves every inherited name against Ubuntu 26.04 at the pinned snapshot with zero missing
                """
            method command
            command "cargo run -q -p xtask -- seeds closure"
            verified_by [ @legeos.evidence.de01-package-closure-resolved-20260905 ]
        }
        check iso-boots-secure-boot-vm {
            statement """
                The ISO boots under OVMF with Secure Boot enforcing through shim, GRUB and the Ubuntu kernel into the live userspace
                """
            method command
            command "tests/integration/iso-qemu.sh"
        }
        check iso-builds {
            statement """
                just iso produces legeos-<set>.iso with its sha256 and TIERS.manifest from a published set
                """
            method command
            command "just iso"
        }
        check metapackages-built {
            statement """
                The eight metapackages are built and published beside the Rust packages as one coherent build set
                """
            method command
            command "cargo run -p lege -- dev repo verify"
            verified_by [ @legeos.evidence.metapackages-build-with-dpkg-deb-20260905 ]
        }
        check nm-tray-2-packaged {
            statement """
                nm-tray-2 is pinned in distro/forks/manifest.toml at a commit that carries --popup, built as legeos-nm-tray, and named in the session layer with the network-control role
                """
            method command
            command "cargo run -q -p xtask -- seeds --check && cargo run -q -p xtask -- check-packaging && scripts/build-fork-deb.sh nm-tray-2"
        }
        check provisioner-takes-free-space {
            statement """
                provision.sh --free-space plans an ESP and a root in a disk's free tail, names every partition it keeps, and changes nothing without --apply
                """
            method command
            command "tests/integration/provision-qemu.sh"
            verified_by [ @legeos.evidence.provisioner-free-space-plan-20260905 ]
        }
        check reinstall-route-exists {
            statement """
                A LegeOS installation medium exists on a USB stick that does not depend on this disk, so deleting Lubuntu is reversible
                """
            method manual
        }
        check rollback-exercised {
            statement """
                A lege dev deploy has been deliberately rolled back on the target and the machine came back
                """
            method manual
        }
        check self-hosts {
            statement """
                just check, just deb and just iso all run green inside LegeOS from a checkout with no sibling repositories present
                """
            method manual
        }
        check wifi-works {
            statement """
                nmcli connects to WiFi from a TTY, and nm-tray-2 then connects from the desktop and reconnects after a suspend
                """
            method manual
        }
    }
    depends_on [
        @legeos.decision.live-iso-runs-the-provisioner,
        @legeos.decision.three-package-tiers,
        @legeos.work.reference-machine-provisioning
    ]
    derived_from [
        @legeos.observation.this-machines-partition-table-cannot-hold-legeos-as-it-stands
    ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.session-lock-client/1 : work {
    title "Drive the compositor's ext-session-lock-v1 so Lifecycle1.Lock stops returning NotSupported"
    state active
    scope [
        path "compositor/lege-comp/src/session_lock.rs",
        path "crates/lege-types/src/provider.rs",
        path "services/lege-sessiond/src/apis/lifecycle.rs"
    ]
    intent """
        Make locking the session actually lock it. The compositor implements ext-session-lock-v1 in full (compositor/lege-comp/src/session_lock.rs) and ADR-0010 makes the lock screen compositor-owned, "one provider by construction". What has never existed is anything that drives it: no client calls lock(), so there is no lock surface and no lock. Lifecycle1.Lock is declared with the interface shape settled and returns NotSupported rather than reporting a success it did not achieve.
        """
    note """
        2026-09-07, implemented — but in **lege-shell**, not in sessiond. The original note assumed sessiond would become the Wayland lock-manager client; it does not, and should not. Only the shell holds the compositor's trusted connection, and sessiond speaks no Wayland at all. So Lifecycle1.Lock emits an additive LockRequested signal (interfaces/dbus/org.legeos.Session.Lifecycle1.xml, baseline re-frozen) and the shell listens for it with a raw zbus match rule — lege-client's LifecycleProxy declares methods only, and the shell has no business growing its own copy of the interface.

        Both limitations the record named are now resolved rather than carried:

        1. Input isolation is no longer partial. Lane 1 landed K2: while locked, keyboard focus goes to the lock surface and LegeCompState::surface_under — the single hit-test motion, buttons, axis and drags all route through — resolves only lock surfaces. On unlock the keyboard returns to the topmost visible window, or Home. One caveat remains, recorded by Lane 1: lock() still confirms immediately rather than waiting for a cleared frame on every output, so a client recording the exact transition could catch one already-in-flight unlocked frame. Not a bypass; the lock state and every guard are in effect before it returns.

        2. ProviderRole::LockScreen is **vacuous**, deliberately. The lock screen is compositor-owned per ADR-0010, so the role is one-provider-by-construction and no application will ever declare it. It stays in the enum because removing it would change a shipped D-Bus signature; it is a permanently unfilled role, and that is now a recorded fact rather than an open question.

        Authentication is a separate process, `lege-unlock`, a second [[bin]] of the lege-shell crate. PAM loads arbitrary modules out of /etc/pam.d into whatever calls it, and that must not be a long-lived process holding a Wayland connection, a tokio runtime and a font stack. The password reaches it on stdin, never as an argument (/proc/<pid>/cmdline is world-readable), and its exit status is the whole answer. It runs unprivileged as the person whose session is locked, so nothing here is setuid. /etc/pam.d/lege-unlock is shipped by the same package and delegates to common-auth and common-account, so a machine with fingerprint or a directory server configured for every other login has it here too.

        No LEGE_LOCK_INSECURE escape hatch was added. An environment variable that unlocks a lock screen is not a thing to ship even behind a flag; nested testing installs the PAM file instead (one command, RUNBOOK-lane-2.md).

        **None of the Wayland half has ever run.** It compiles, is clippy-pedantic clean, and its two pure halves — keysym decoding and the password state machine — are unit-tested, but no lock surface has been created: scripts/nested-session.sh refuses to start over a live session. `locks-a-real-session` is the first time this code executes.

        Deferred with reason: idle → lock wiring (Lane 1 is recording the idle.rs lock_after → lege_shell_v1 event deferral on its own side), and fingerprint / multi-seat unlock — both need work outside this slice, and neither is required for a session that can be locked and unlocked by password.
        """
    acceptance {
        check key-decoding {
            statement """
                A lock surface decodes text, Enter, Backspace and Escape from xkb keysyms and produces nothing for modifiers and function keys.
                """
            method command
            command "cargo test -p lege-shell a_lock_surface_decodes_text_enter_backspace_and_escape_and_ignores_the_rest"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
        check lock-is-driven {
            statement """
                Lifecycle1.Lock no longer returns NotSupported: it emits LockRequested, the trusted shell drives ext-session-lock-v1, and the interface declares the signal.
                """
            method command
            command "cargo test -p lege-sessiond lock_asks_for_a_lock_through_a_signal_rather_than_refusing && cargo run -q -p xtask -- check-interface-signatures"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
        check locks-a-real-session {
            statement """
                On the installed session, `lege session lock` covers every output, a wrong password is refused and the right one unlocks, no window behind the lock can be pointed at, and killing the shell while locked leaves the session locked.
                """
            method manual
        }
        check password-handling {
            statement """
                The lock screen's password state machine hands a password over exactly once per Enter, clears the field on rejection, refuses a second attempt while one is in flight, and keeps nothing after either outcome.
                """
            method command
            command "cargo test -p lege-shell lock_screen"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
        check unlock-fails-closed {
            statement """
                A missing or unrunnable lege-unlock refuses rather than unlocking, and only a zero exit status from it unlocks.
                """
            method command
            command "cargo test -p lege-shell a_missing_helper_refuses_rather_than_unlocking the_helpers_exit_status_is_the_whole_answer"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
    }
    depends_on [ @legeos.decision.compositor-on-smithay ]
    part_of [ @legeos.work.home-widgets ]
}

record legeos.work.sessiond-persistence-and-launch/1 : work {
    title "The session daemon: one state store, StartTransientUnit launching, desktop-entry import, the full domain surface"
    state completed
    scope [
        path "crates/lege-appd/**",
        path "crates/lege-associationd/**",
        path "crates/lege-session-core/**",
        path "crates/lege-state/src/migrations/session.rs",
        path "services/lege-sessiond/**"
    ]
    intent """
        Wire lege-sessiond to the one state store so every domain survives a restart (associations, provider selections and declarations, autostart approvals, settings values and their change log, projects, history, live instances re-derived from ListUnitsByPatterns app-legeos-*); replace the systemd-run launcher with a direct StartTransientUnit D-Bus transaction so launch and unit registration are one step and the documented registration race disappears; derive manifests from installed desktop entries with Exec field codes parsed into an argument vector; detect MIME types from shared-mime-info globs and bounded content sniffing so a detected type genuinely beats an extension; and serve the remaining domains — the full Associations surface with Explain, Settings, History with Undo, Providers, Projects, Power, Location, and org.freedesktop.Notifications recorded as history events — plus the autostart runner, the checkpoint relay and coredump ingestion.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.shared-incremental-file-index/1 : work {
    title "One persistent incremental file index shared by LegeOS, FSearch and Silvaview-rs"
    state completed
    scope [
        path "apps/lege-files/**",
        path "cli/lege/**",
        path "crates/**",
        path "distro/forks/**",
        path "docs/architecture/files.md",
        path "docs/planning/**",
        path "interfaces/dbus/**",
        path "services/lege-filed/**",
        path "session/units/user/lege-filed.service",
        path "shell/lege-shell/**"
    ]
    intent """
        Replace the interim independent lege-filed and FSearch databases with one per-user derived file index owned by lege-filed. Extract a pure Rust index core; store rebuildable entries separately from authoritative session state; add lossless paths, stable best-effort filesystem identity, atomic generations, honest root freshness, Linux monitoring, direct file-operation mutations, downtime/overflow reconciliation, indexed substring search, paging, a sealed bulk snapshot, a bounded change stream, diagnostics and CLI access. Keep Files.Search1 as a compatibility facade while adding org.legeos.Files.Index1.
        """
    note """
        Plan of record: docs/planning/shared-incremental-file-index.md. It is based on the current LegeOS search implementation, the sibling Silvaview-rs scanner/tree boundary, installed FSearch 0.2.3, and upstream FSearch inspected at 05ed650ab101ee3d61795fa5eeeb5c32e1e366c3.

        2026-09-07: the `consumers-share-the-index` check was split out into @legeos.work.silvaview-and-fsearch-share-the-index, because it is the one part of this record that cannot be verified from this repository — Silvaview-rs lives in a sibling repository, which this record's own note already said cannot be represented by its path scope, and the FSearch fork is a manifest entry rather than source in this tree. Leaving it here would have kept the whole index campaign open on work in two other repositories.

        What remains here is proven: the core, its maintenance, incremental freshness, one owner, warm start, and a two-million-entry fixture that is complete rather than capped at 62,727 entries/s with warm search at p50 0.25ms (@legeos.evidence.index-scale-two-million-20260907).
        """
    acceptance {
        check incremental-and-honest-freshness {
            statement """
                Filesystem and lege-filed operation changes appear incrementally; downtime, overflow, offline roots and partial scans reconcile without discarding the prior committed generation, and every response exposes generation and freshness.
                """
            method command
            command "cargo test -p lege-file-index -p lege-filed"
            verified_by [
                @legeos.evidence.btrfs-delta-transport-and-backend-20260907,
                @legeos.evidence.btrfs-delta-transport-and-backend-20260907/1,
                @legeos.evidence.de01-integrated-gate-20260904
            ]
        }
        check one-owner-and-warm-start {
            statement """
                Exactly one per-user LegeOS process owns filesystem watches and the derived database, and restarting any search client or Silvaview does not synchronously rescan a previously indexed root before useful results appear.
                """
            method command
            command "cargo test -p lege-file-index -p lege-filed"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.service-inventory-and-pressure-wakeups-20260907,
                @legeos.evidence.service-inventory-and-pressure-wakeups-20260907/1
            ]
        }
        check scale-and-lossless-paths {
            statement """
                A two-million-entry fixture is complete rather than capped, warm searches meet the recorded latency target, bulk snapshot transfer is bounded, and non-UTF-8 Unix paths survive search, snapshot and file action round trips.
                """
            method command
            command "cargo run -q -p xtask --release -- index-bench workloads --allow-two-million && cargo test -p lege-file-index --release"
            verified_by [
                @legeos.evidence.index-scale-two-million-20260907,
                @legeos.evidence.index-scale-two-million-20260907/1
            ]
        }
    }
    part_of [ @legeos.work.application-integration-interim ]
}

record legeos.work.silvaview-and-fsearch-share-the-index/1 : work {
    title "The FSearch fork and Silvaview service mode consume the LegeOS index generation instead of scanning"
    state proposed
    scope [ path "distro/forks/**", path "interfaces/dbus/org.legeos.Files.Index1.xml" ]
    intent """
        Make the two external consumers read the shared index rather than build their own: the LegeOS FSearch fork ships with no scanner, no watches and no fsearch.db, and Silvaview service mode obtains a consistent snapshot through Files.Index1.OpenSnapshot and projects it through its existing tree builder, keeping its direct MFT/jwalk scanners only as an explicit fallback and as future non-LegeOS ingestion backends.
        """
    note """
        Split out of @legeos.work.shared-incremental-file-index on 2026-09-07 because it is the one part of that record this repository cannot verify: Silvaview-rs lives in a sibling repository, so no path scope here covers it, and the FSearch fork is a `distro/forks/manifest.toml` entry rather than source in this tree. Everything the parent could prove — the index core, its maintenance, incremental freshness, one owner, warm start, and two-million-entry scale — is proven and completed there.

        The LegeOS side of the contract is finished and is what this work consumes: `org.legeos.Files.Index1` serves sealed snapshots with a manifest that now carries the change-log position they are consistent with (@legeos.observation.a-snapshot-did-not-say-which-change-position-it-was-consistent-with), `ChangesSince(sequence)` with `SnapshotRequired` below the retained floor, and the consumer sequence is covered end to end by `crates/lege-file-index/tests/consumer_contract.rs`. What remains is work in two other repositories plus a build that ships them.
        """
    acceptance {
        check consumers-share-the-index {
            statement """
                LegeOS Files search, the LegeOS FSearch fork and Silvaview service mode consume the same index generation; the FSearch build owns no watches or fsearch.db and Silvaview service mode performs no recursive filesystem enumeration.
                """
            method manual
        }
    }
    depends_on [ @legeos.work.file-index-core, @legeos.work.file-index-maintenance ]
    part_of [ @legeos.work.application-integration-interim ]
}

record legeos.work.standalone-file-manager/1 : work {
    title "Standalone Files — service-backed browsing, operations and properties in an installable manager"
    state superseded
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "apps/lege-files/**",
        path "crates/lege-client/**",
        path "debian/**",
        path "distro/**",
        path "docs/architecture/files.md",
        path "interfaces/dbus/org.legeos.Files.*",
        path "scripts/**",
        path "services/lege-filed/**",
        path "session/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Build `lege-files` as a first-party Pixelkit application and Debian package. It opens a real XDG folder, shows service-provided places and mounted drives with space state, lists immediate children in the filed-owned folder-first natural order, supports mouse and keyboard selection/navigation/history, and opens files only through Associations1 and Launcher1. Selection workflows provide rename, copy/cut/paste, trash, undo and a persistent properties/storage inspector; filesystem mutations run only through journalled Files.Operations1. Add any bounded Browse1 metadata/root methods needed by both Home and the standalone manager, validate unsafe operation requests in the service, wire the desktop file, app manifest, source package, seeds, cargo-deb build and reinstall helper, and cover the state/contract/package paths with tests.
        """
    acceptance {
        check brokered-open {
            statement """
                Opening a non-directory resolves it through Associations1 and launches it through Launcher1; the manager never executes an association or file path itself.
                """
            method command
            command "cargo test -p lege-files brokered_open"
        }
        check installable-manager {
            statement """
                The workspace and source-package metadata install /usr/bin/lege-files and its desktop entry, all packaging checks pass, and cargo-deb produces the package included by the desktop seed and reinstall helper.
                """
            method command
            command "cargo run -q -p xtask -- check-packaging && cargo deb -q -p lege-files"
        }
        check keyboard-pointer-parity {
            statement """
                Every primary row/toolbar operation is reachable by pointer and by keyboard accelerators, with safe modal confirmation for name-changing actions and trash remaining undoable.
                """
            method command
            command "cargo test -p lege-files interaction"
        }
        check operations-and-properties {
            statement """
                Rename, copy, cut/move, paste, trash and undo serialize to the journalled Operations1 contract, unsafe path/name requests are refused by filed, operation progress is visible, and selection properties include filesystem metadata plus containing-volume state.
                """
            method command
            command "cargo test -p lege-files -p lege-filed operation"
        }
        check real-browsing {
            statement """
                The standalone manager renders service-backed XDG places, relevant mounted drives with capacity state, and real bounded directory entries; navigation, history, hidden-file toggle, selection and stale-response handling are covered.
                """
            method command
            command "cargo test -p lege-files browser"
        }
        check workspace-quality {
            statement """
                Formatting, warnings-denied clippy, the full workspace tests and interface/proxy/asset/packaging structural checks pass.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && cargo run -q -p xtask -- tree-check deps-check check-interfaces check-proxies check-packaging check-assets"
        }
    }
    depends_on [ @legeos.decision.forks-by-manifest ]
    implements [
        @legeos.constraint.identity-and-launch-safety,
        @legeos.constraint.one-provider-per-role,
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
    acknowledged true
}

record legeos.work.standalone-file-manager/2 : work {
    title "Standalone Files — service-backed browsing, operations and properties in an installable manager"
    state superseded
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "apps/lege-files/**",
        path "crates/lege-client/**",
        path "debian/**",
        path "distro/**",
        path "docs/architecture/files.md",
        path "interfaces/dbus/org.legeos.Files.*",
        path "scripts/**",
        path "services/lege-filed/**",
        path "session/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Build `lege-files` as a first-party Pixelkit application and Debian package. It opens a real XDG folder, shows service-provided places and mounted drives with space state, lists immediate children in the filed-owned folder-first natural order, supports mouse and keyboard selection/navigation/history, and opens files only through Associations1 and Launcher1. Selection workflows provide rename, copy/cut/paste, trash, undo and a persistent properties/storage inspector; filesystem mutations run only through journalled Files.Operations1. Add any bounded Browse1 metadata/root methods needed by both Home and the standalone manager, validate unsafe operation requests in the service, wire the desktop file, app manifest, source package, seeds, cargo-deb build and reinstall helper, and cover the state/contract/package paths with tests.
        """
    acceptance {
        check brokered-open {
            statement """
                Opening a file goes through Associations1, Launcher1 and Recents rather than spawning an application directly.
                """
            method command
            command "cargo test -p lege-files brokered_open"
        }
        check installable-manager {
            statement """
                The first-party manager has a valid desktop entry, application manifest, source package, Debian package and reinstall path.
                """
            method command
            command "cargo run -q -p xtask -- check-packaging && cargo deb -q -p lege-files"
        }
        check keyboard-pointer-parity {
            statement """
                Every visible file-manager action is reachable by both pointer and keyboard, including navigation, selection and dialogs.
                """
            method command
            command "cargo test -p lege-files interaction"
        }
        check operations-and-properties {
            statement """
                Rename, copy/cut/paste, trash, undo, progress and the persistent properties/storage view use the filed-owned service contracts.
                """
            method command
            command "cargo test -p lege-files -p lege-filed operation"
        }
        check real-browsing {
            statement """
                The standalone manager renders a real service-provided folder listing, XDG places and mounted drives, with pointer selection and folder-first natural ordering.
                """
            method command
            command "cargo test -p lege-files browser"
        }
        check workspace-quality {
            statement """
                Formatting, strict linting, the full workspace tests and structural interface/dependency checks all pass.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && just tree-check && just deps-check && just check-interfaces"
        }
    }
    depends_on [ @legeos.decision.forks-by-manifest ]
    implements [
        @legeos.constraint.identity-and-launch-safety,
        @legeos.constraint.one-provider-per-role,
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
    supersedes [ @legeos.work.standalone-file-manager/1 ]
    acknowledged true
}

