record legeos.work.memory-polling-indexing-effectiveness-20260909/1 : work {
    title "Memory governor, watcher host and file-index effectiveness — the Astra-ranked fix set"
    state superseded
    scope [
        path "crates/lege-file-index/**",
        path "services/lege-filed/src/delta_catchup.rs",
        path "services/lege-filed/src/index_host.rs",
        path "services/lege-filed/src/observer.rs",
        path "services/lege-filed/src/watcher.rs",
        path "services/lege-resourced/**"
    ]
    intent """
        Land the four must-fix findings from the 2026-09-09 Astra review as small, test-backed changes, then the two P2 bounds and the explicit critical-grace policy change, and leave the two redesigns as scoped follow-ups. Order: governor wake reliability, subtree repair truth, watcher recovery ordering, bounded handoff and repair supersession; then the snapshot read transaction; then resourced bounds and the victim-bound grace delay; the btrfs baseline protocol and the children lookup contract wait for those. Every child names the exact code it changes and the regression test that fails without it; no live desktop or session service is touched, cargo tests and headless checks only.
        """
    note """
        Governor changes stay observe-safe under @legeos.constraint.identity-and-launch-safety: the victim-bound grace delay is a policy behaviour change and is filed as its own child so it is accepted explicitly, not folded into a polling fix. Astra's uncertainties carry over: no workload timing, privileged PSI trigger, D-Bus saturation or btrfs fault injection has been measured, so each child's acceptance is a deterministic test, not a benchmark.
        """
    acceptance {
        check replay-fidelity {
            statement """
                The resourced replay fixtures still reproduce their recorded decisions after the governor changes.
                """
            method command
            command "cargo test -p lege-resourced --test replay_fixtures --test fixture_report"
        }
        check scoped-lint {
            statement """
                Scoped clippy with warnings denied is clean across all targets.
                """
            method command
            command "cargo clippy -p lege-resourced -p lege-file-index -p lege-filed --all-targets -- -D warnings"
        }
        check scoped-tests {
            statement """
                The three scoped crates pass their tests including every new regression test named by the children.
                """
            method command
            command "cargo test -p lege-resourced -p lege-file-index -p lege-filed"
        }
        check signatures-frozen {
            statement """
                No shipped D-Bus signature changed; the Resources1 and Files.Index1 interfaces are byte-identical to the baseline.
                """
            method command
            command "cargo run -q -p xtask -- check-interface-signatures"
        }
    }
    depends_on [
        @legeos.constraint.native-lubuntu-is-the-development-environment,
        @legeos.decision.inotify-remains-the-index-event-backend,
        @legeos.decision.resourced-separate-process
    ]
    derived_from [ @legeos.assessment.astra-memory-polling-indexing-review-20260909 ]
    implements [ @legeos.decision.event-driven-service-authorities ]
    part_of [ @legeos.work.event-driven-service-audit ]
}

