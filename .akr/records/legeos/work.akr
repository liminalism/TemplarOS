record legeos.work.index-wp13-diagnostics-20261008/1 : work {
    title "WP13 typed index diagnostics, WAL maintenance and health surfaces"
    state superseded
    scope [
        path "apps/templar-settings/src/files.rs",
        path "cli/templar/src/doctor/checks.rs",
        path "cli/templar/src/files.rs",
        path "crates/templar-client/src/file_index.rs",
        path "crates/templar-file-index/src/arrays.rs",
        path "crates/templar-file-index/src/diagnostics.rs",
        path "crates/templar-file-index/src/generation.rs",
        path "crates/templar-file-index/src/lib.rs",
        path "crates/templar-file-index/src/mutation.rs",
        path "crates/templar-file-index/src/query.rs",
        path "docs/indexing-dev/continuation-2026-10-08.md",
        path "docs/measurements/**",
        path "services/templar-filed/src/index_host.rs",
        path "services/templar-filed/src/index_lanes.rs",
        path "services/templar-filed/src/index_metrics.rs",
        path "services/templar-filed/src/lib.rs"
    ]
    intent """
        Implement WP13 from docs/indexing-dev/implementation-plan.md. Publish typed runtime diagnostics for lanes, root shards/overlays, snapshot exports, cursors, readers, WAL, watches and volume identity; perform PASSIVE checkpoints after scan commits and each64mutation batches, with guarded TRUNCATE above64MiB and no reader older30s, solely on maintenance. Extend read-only doctor/CLI and Files Settings with storage/runtime health, freshness, ownership/volume and accelerator status; keep unavailable/offline states honest. Qualify the complete field rendering against an owned private daemon and a headless offline-volume Settings fixture. No installed services, live-session changes or private SQLite consumer access.
        """
    acceptance {
        check maintenance-and-counters {
            statement """
                Native tests cover WAL/SHM storage, maintenance-only checkpoint scheduling/truncation reader-age guards, typed lane/shard/snapshot/cursor/reader metrics and process-local lifetime accounting.
                """
            method command
            command "cargo test -p templar-file-index -p templar-filed"
        }
        check private-doctor {
            statement """
                templar doctor --check file-index against an owned private daemon prints every WP13 runtime/storage/watch/volume field and gives unavailable, WAL, reader-age and low-hit-rate warnings; read-only disk fallback remains usable.
                """
            method command
            command "templar doctor --check file-index"
        }
        check settings-freshness {
            statement """
                CLI rendering tests and headless Settings Files rendering show split freshness, cache availability/retry, watch coverage, nesting, accelerator bytes/hit rate and a different-volume root with identity confidence and explicit action.
                """
            method command
            command "cargo test -p templar; templar-settings --print --page index"
        }
    }
    depends_on [
        @legeos.work.index-wp11-shards-20261008/2,
        @legeos.work.index-wp12-overlay-20261008/2,
        @legeos.work.index-wp7-wp8-20261008/1
    ]
    part_of [ @legeos.work.file-index-core/3 ]
    author "dk"
}

