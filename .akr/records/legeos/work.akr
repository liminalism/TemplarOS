record legeos.work.index-shared-sealed-snapshots/1 : work {
    title "Measured follow-up: share immutable sealed snapshots"
    state proposed
    scope [
        path "crates/templar-file-index/src/snapshot.rs",
        path "services/templar-filed/src/index_host.rs"
    ]
    intent """
        Evaluate sharing immutable sealed snapshots across equivalent generation/scope/mask/detail requests only after WP6 memory step (c) shows a measured need. WP8 deliberately retains one newly written memfd per request; any cache must respect snapshot_seq, caller cancellation, quotas, ownership and bounded retention. No implementation or acceptance is claimed here.
        """
    part_of [ @legeos.work.file-index-core/3 ]
    author "dk"
}

record legeos.work.index-signal-coalescing-20261009/1 : work {
    title "Latest-wins coalescing for index change signals"
    state proposed
    intent """
        Coalesce GenerationAdvanced/change emissions latest-wins: replace the per-commit tokio::spawn in Index1Signals with one long-lived emitter task fed by a channel, so a burst of commits emits one signal carrying the newest generation instead of N tasks. ChangesSince already tolerates skipped generations, so consumers stay correct.
        """
    note """
        Deferred from the 2026-10-09 resource batch: changes signal timing semantics (per-generation → coalesced) for FSearch/Silvaview consumers; needs explicit consumer-impact review. Commit volume already collapsed ~500x by OperationSink batching, which proportionally reduced the spawns.
        """
    part_of [ @legeos.work.file-index-maintenance ]
    author "dk"
}

record legeos.work.index-summary-directory-aggregates/1 : work {
    title "Summary follow-up: cached totals for materialized directories"
    state proposed
    scope [
        path "crates/templar-client/src/tree_source.rs",
        path "crates/templar-file-index/src/aggregate.rs",
        path "crates/templar-file-index/src/generation.rs",
        path "crates/templar-file-index/src/mutation.rs"
    ]
    intent """
        Populate generation-consistent cached recursive totals for Detailed and Inventory directories so summary-first treemaps cover ordinary files as well as existing Opaque aggregates. Maintain bounded updates and honest stale/unreadable status through scan and mutation publication, without a reader-triggered filesystem walk. WP8 uses existing aggregates and explicitly marks missing totals partial; this proposal does not claim current summaries are complete.
        """
    part_of [ @legeos.work.file-index-core/3 ]
    author "dk"
}

record legeos.work.index-volume-identity-cache-20261009/1 : work {
    title "Cache volume identity across apply batches"
    state proposed
    intent """
        Cache the observed VolumeIdentity per root across apply batches so ensure_present stops re-running mountinfo parse + statx/statfs + by-uuid readdir scan on every commit. Design: Index holds Mutex<HashMap<RootId, VolumeIdentity>>; presence() revalidates cheaply (stat st_dev vs cached dev_id) and only re-identifies on mismatch; cache invalidates on MountMonitor change events, provider identify errors, and root offline/accept transitions.
        """
    note """
        Deferred from the 2026-10-09 resource batch: the fence is WP9 safety-critical and wrong caching could mask a volume swap (e.g. mount --move keeps st_dev). Needs the MountMonitor invalidation path designed against mounts.rs plus real-mount acceptance, which is still open. Per-commit cost already reduced ~500x by OperationSink batching.
        """
    part_of [ @legeos.work.file-index-maintenance ]
    author "dk"
}

record legeos.work.index-wp0-baseline-20261008/1 : work {
    title "WP0 baseline"
    state proposed
    scope [
        path "crates/templar-client/**",
        path "crates/templar-file-index/**",
        path "docs/indexing-dev/**",
        path "docs/measurements/**",
        path "services/templar-filed/**"
    ]
    intent "Record the pre-fix baseline, reproductions, contract freeze and canonical ledger kickoff from WP0."
    note "Before-fix logs prove generation and nested-scope failures plus a busy second cache owner. The original chmod000 before-fix failure is not present; the new exact current regression does not recreate that missing baseline. The baseline2M attempt hit Btrfs ENOSPC. Do not call these missing observations passes."
    acceptance {
        check baseline {
            statement """
                Baseline native/private report and100k/2M workload observations exist, with exit codes and failures stated.
                """
            method command
            command "retained index-wp0 baseline/workload logs and owned scale report"
            verified_by [ @legeos.evidence.index-wp0-baseline-logs-20261008/1 ]
        }
        check contract-gates {
            statement """
                Additive JSON/error/AcceptVolume and frozen interface gates pass.
                """
            method command
            command "just check-interfaces"
            verified_by [ @legeos.evidence.index-wp17-interface-reconciled-20261008/1 ]
        }
        check ledger-valid {
            statement """
                Registered scoping sources and a parent with one child per WP exist; the ledger validates.
                """
            method command
            command "akr build; akr validate"
            verified_by [ @legeos.evidence.index-wp17-acceptance-ledger-20261008/1 ]
        }
        check reproductions {
            statement """
                The three original reproductions (generation, nested within, chmod000 cache parent) fail before the fixes for their stated reasons.
                """
            method command
            command "retained index-wp0 repro-before.log"
        }
    }
    part_of [ @legeos.work.shared-index-completion-20261008/1 ]
    author "dk"
}

