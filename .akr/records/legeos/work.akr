record legeos.work.display-manager-session-startup-reliability/4 : work {
    title "Make the installed LegeOS display-manager session start deterministically and fail back cleanly"
    state completed
    scope [
        path "compositor/lege-comp/**",
        path "docs/testing/README.md",
        path "services/lege-filed/**",
        path "services/lege-resourced/**",
        path "session/**",
        path "tests/**"
    ]
    intent """
        Repair the installed-session contract exposed by the 2026-08-22 SDDM attempts: eliminate inherited-display backend selection, make compositor readiness real, start the graphical shell on its trusted socket, end the session when the compositor cannot run, and prevent auxiliary services from exhausting resources during login.
        """
    note """
        The 2026-08-23 installed-package retest reached the hardware compositor on both attempts: udev was forced, deterministic public/private sockets opened, the 2560x1600 eDP-2 output lit, resourced stayed healthy, and filed reused its existing index. The black screen remained because the udev backend never flushed queued Wayland replies, so lege-shell blocked in its initial registry/configure round trips and emitted no application-stage logs; it also never sent hardware frame callbacks. Readiness was additionally emitted before DRM/output/XWayland setup and before calloop began dispatching. The work tree now flushes clients after every graphical-backend dispatch, sends udev frame callbacks after output rendering, emits READY from inside calloop after the initial render path, imposes TimeoutStartSec=15s, and logs the shell connection stages. A live Type=notify nested smoke reduced the shell handshake from 5.4 seconds to 11 milliseconds and reached both Home Surface and dock declarations. Targeted tests (167), clippy, integration smoke, systemd verification, package checks, and rebuilt package-content inspection pass; corrected .debs are in target/debian. Installed-login remains open for one more SDDM retest with these rebuilt packages.
        """
    acceptance {
        check aux-services-bounded {
            statement """
                The resource governor no longer self-aborts after mlockall and the file service's default startup indexing has an explicit finite admission bound exercised by tests.
                """
            method command
            command "cargo test -p lege-resourced -p lege-filed"
            verified_by [ @legeos.evidence.refinement-checks-20260824/1 ]
        }
        check installed-login {
            statement """
                After rebuilding and installing the packages, selecting LegeOS in SDDM reaches the graphical Home Surface instead of freezing the greeter or leaving a black screen.
                """
            method manual
            verified_by [ @legeos.evidence.installed-home-visible-20260824/1 ]
        }
        check startup-contract {
            statement """
                Automated session/unit tests prove the installed entry forces the hardware backend, publishes deterministic public and trusted-shell sockets, waits for actual compositor readiness, starts lege-shell --surface, and tears down the target if the compositor exits.
                """
            method command
            command "cargo test -p lege-session -p lege-comp && cargo run -q -p xtask -- check-packaging"
            verified_by [ @legeos.evidence.refinement-integration-smoke-20260824/1 ]
        }
    }
    implements [ @legeos.decision.session-greeter-lock/2 ]
    part_of [ @legeos.milestone.m2-session-runs/1 ]
    supersedes [ @legeos.work.display-manager-session-startup-reliability/3 ]
}

record legeos.work.file-index-core/1 : work {
    title "F1 — the lege-file-index core crate, the cache database with generations, and the org.legeos.Files.Index1 contract"
    state proposed
    scope [
        path "Cargo.toml",
        path "cli/lege/src/files.rs",
        path "crates/lege-client/src/proxies/files.rs",
        path "crates/lege-file-index/**",
        path "interfaces/dbus/org.legeos.Files.Index1.xml",
        path "services/lege-filed/Cargo.toml",
        path "services/lege-filed/src/dbus.rs",
        path "services/lege-filed/src/index_host.rs",
        path "services/lege-filed/src/main.rs",
        path "services/lege-filed/src/search.rs",
        path "session/units/user/lege-filed.service"
    ]
    intent """
        Phase 0 and 1 of docs/planning/shared-incremental-file-index.md: a pure crates/lege-file-index (schema v1 with generations, native-byte paths plus display text, object keys, root freshness states, one writer with WAL readers, atomic generation commit that preserves the last good generation, uncapped streaming scan under configured budgets yielding an explicit incomplete state, FTS5-trigram substring search behind a QueryPlanner trait, paged cursors bound to a generation, sealed snapshot framing, Mutation and Change types for the maintenance lane); lege-filed opens $XDG_CACHE_HOME/legeos/file-index-v1.sqlite3, Search1 delegates to the core, Index1 (Roots, Search, FetchPage, OpenSnapshot, ChangesSince, signals) is hosted, proxied in lege-client and reachable as `lege files index status|search|reconcile`.
        """
    note """
        Plan of record: docs/planning/shared-incremental-file-index.md via the parent @legeos.work.shared-incremental-file-index. HEAD reconciliation 2026-09-03: search.rs is a delete-then-insert, 50k-capped LIKE index inside the shared state mutex; FTS5 trigram is available from the bundled SQLite 3.53.2 without a feature change; Index1 exists nowhere. The two-million-entry release fixture is an ignored test whose command is recorded; the coordinator runs it at the integrated gate.
        """
    acceptance {
        check generations-and-lossless-paths {
            statement """
                A killed rebuild leaves the previous committed generation readable, a non-UTF-8 path round-trips through index, search and snapshot, and a cursor stays pinned to the generation it was opened on.
                """
            method command
            command "cargo test -p lege-file-index"
            verified_by [ @legeos.evidence.de01-integrated-gate-20260904 ]
        }
        check index1-gates {
            statement """
                org.legeos.Files.Index1 passes check-interfaces, check-proxies and check-interface-signatures after the baseline is re-frozen.
                """
            method command
            command "cargo run -q -p xtask -- check-interfaces && cargo run -q -p xtask -- check-proxies && cargo run -q -p xtask -- check-interface-signatures"
            verified_by [ @legeos.evidence.de01-integrated-gate-20260904 ]
        }
        check warm-start-and-compat {
            statement """
                A warm lege-filed start serves the prior generation without walking a root, Search1 clients keep working, and a budget-limited scan reports incomplete rather than complete.
                """
            method command
            command "cargo test -p lege-filed search"
            verified_by [ @legeos.evidence.de01-integrated-gate-20260904 ]
        }
    }
    part_of [
        @legeos.milestone.developer-edition-0-1,
        @legeos.work.shared-incremental-file-index
    ]
}

record legeos.work.file-index-maintenance/1 : work {
    title "F2 — one watcher owner keeps the index current, operations mutate it directly, and freshness degrades honestly"
    state proposed
    scope [
        path "crates/lege-file-index/src/coalesce.rs",
        path "crates/lege-file-index/src/reconcile.rs",
        path "crates/lege-file-index/src/watch.rs",
        path "crates/lege-file-index/tests/**",
        path "services/lege-filed/src/execute.rs",
        path "services/lege-filed/src/operations.rs",
        path "services/lege-filed/src/watcher.rs"
    ]
    intent """
        Phase 2 of docs/planning/shared-incremental-file-index.md against the frozen core contract: a Linux watcher backend chosen from measured inotify/fanotify needs, normalized and coalesced events committed one generation per batch, direct mutation from successful lege-filed operations with the later watch event deduplicated, overflow/rename-ambiguity/mount-disappearance handling, downtime and offline-root reconciliation through observable current→stale→reconciling→current transitions that never discard the prior generation, and a startup that never scans synchronously. The fixture rule from the trash incident is mechanized: test code cannot construct TrashMounts::System or watch a non-temporary root.
        """
    note """
        Start gate: the coordinator's C5 freeze message. Before it, only fixtures and the backend decision. HEAD reconciliation 2026-09-03: no watcher dependency anywhere; operations.rs and execute.rs never touch the index.
        """
    acceptance {
        check events-become-queryable {
            statement """
                A create, move, rename or delete becomes queryable within the agreed bound under a fake clock, and a filed operation's direct mutation deduplicates the later watch event.
                """
            method command
            command "cargo test -p lege-file-index watch"
            verified_by [ @legeos.evidence.de01-integrated-gate-20260904 ]
        }
        check honest-freshness {
            statement """
                Forced overflow and daemon downtime drive current→stale→reconciling→current while the prior generation stays visible, and starting the daemon returns existing results before reconciliation.
                """
            method command
            command "cargo test -p lege-file-index reconcile && cargo test -p lege-filed watcher"
            verified_by [ @legeos.evidence.de01-integrated-gate-20260904 ]
        }
    }
    depends_on [ @legeos.work.file-index-core ]
    part_of [
        @legeos.milestone.developer-edition-0-1,
        @legeos.work.shared-incremental-file-index
    ]
}

record legeos.work.file-operations-from-home/1 : work {
    title "Copy, cut, paste, drag/drop, trash and ordinary file actions inside Home folder surfaces"
    state completed
    scope [
        path "apps/lege-files/**",
        path "crates/lege-client/**",
        path "interfaces/dbus/org.legeos.Files.Operations1.xml",
        path "services/lege-filed/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Complete ordinary file manipulation inside expanded Home folders and shortcut panes, using the multi-selection model that now exists. Ctrl+C/Ctrl+X/Ctrl+V copy or move every selected item through Files.Operations1; the clipboard advertises and accepts standard URI-list data where possible so Files and other desktop applications interoperate. Delete moves real files to Trash through the journalled service and reports an undo route. Rename, New Folder, Properties and Copy Path remain part of the same coherent action surface.

        Implement drag and drop with typed destinations. Dropping onto a real folder copies or moves according to the declared gesture/modifier; dropping onto a shortcut pane adds references unless the user explicitly chooses a file operation; dropping onto an application resolves an Open With/application action; dragging out exports URI-list data. Bare Home never accepts an individual file as a loose tile and instead routes it to a shortcut pane per the governing object model.

        All bulk operations are one journalled operation with one progress/error surface and one undo. The Home field-layout undo and file-operation undo remain distinct internally, but the focused surface routes Ctrl+Z to the most recent applicable action and says which action will be undone. Conflict, permission, partial-failure and cross-device cases are answered by the file service rather than guessed by the shell.
        """
    note """
        Rank 3 of the audit's daily-work gaps. Selection and folders/panes both landed, unblocking this. Acceptance command for trash-delete-and-undo corrected to pass both libtest filters after --; cargo takes only one TESTNAME positionally.
        """
    acceptance {
        check clipboard-bulk-operations {
            statement """
                Copy, cut and paste operate on the complete selected path set as one journalled service operation, support standard URI-list clipboard interchange, and never duplicate a cut source after success.
                """
            method command
            command "cargo test -p lege-filed -p lege-shell -p lege-files clipboard"
            verified_by [ @legeos.evidence.file-operations-from-home-20260831/1 ]
        }
        check ordinary-file-verbs {
            statement """
                Rename, New Folder, Properties and Copy Path are available by keyboard and pointer in Home folder surfaces with the same service semantics as the standalone Files app.
                """
            method command
            command "cargo test -p lege-shell file_actions && cargo run -q -p xtask -- check-actions"
            verified_by [ @legeos.evidence.file-operations-from-home-20260831/1 ]
        }
        check progress-and-failure {
            statement """
                Bulk copy/move/trash exposes bounded progress, cancellation and item-specific failures without reporting a partially failed operation as wholly successful.
                """
            method command
            command "cargo test -p lege-filed operations"
            verified_by [ @legeos.evidence.file-operations-from-home-20260831/1 ]
        }
        check trash-delete-and-undo {
            statement """
                Delete moves selected real items to Trash as one operation, Remove from Pane only removes references, and one undo restores every successfully trashed item exactly.
                """
            method command
            command "cargo test -p lege-filed -- trash undo"
            verified_by [ @legeos.evidence.file-operations-from-home-20260831/1 ]
        }
        check typed-drag-drop {
            statement """
                Drag/drop distinguishes real folders, shortcut panes, applications and external URI-list targets; every target advertises the exact operation before release and bare Home never creates a loose file tile.
                """
            method command
            command "cargo test -p lege-shell drag_drop"
            verified_by [ @legeos.evidence.file-operations-from-home-20260831/1 ]
        }
    }
    depends_on [
        @legeos.work.home-field-selection-and-bulk-action,
        @legeos.work.home-folders-and-shortcut-panes
    ]
    derived_from [ @legeos.assessment.home-field-usability-gaps-20260831 ]
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.file-previews-copy-path-and-folder-properties/1 : work {
    title "Files follow-up — advanced previews, real Copy Path, and recursive folder properties"
    state superseded
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "apps/lege-files/**",
        path "crates/lege-client/**",
        path "debian/**",
        path "docs/architecture/files.md",
        path "interfaces/dbus/org.legeos.Files.*",
        path "services/lege-filed/**",
        path "session/units/user/lege-filed.service"
    ]
    intent """
        Extend the completed first-party Files manager with selected-file previews for HEIC/HEIF, JPEG XL and the first page of PDF documents, plus ordinary raster formats. Preview decoding is service-owned, bounded by dimensions/source/output/timeout limits, runs off the D-Bus executor, prefers the user's installed JPXL helper when available, and uses packaged helper fallbacks so LegeOS keeps its Rust 1.93 MSRV and independent source packaging. Add a visible Copy Path action that obtains the as-shown path from Files.Actions1 and places it on the real Wayland clipboard without a shell. Make Properties an explicit visible action and have filed compute symlink-safe recursive folder file count and total logical/allocated size, reporting partial scans honestly.
        """
    acceptance {
        check advanced-previews {
            statement """
                HEIC/HEIF, JPEG XL, PDF first-page and ordinary raster paths route through bounded service-owned preview helpers and valid bounded PNG output is accepted.
                """
            method command
            command "cargo test -p lege-filed preview"
        }
        check copy-path {
            statement """
                A visible Copy Path button and Ctrl+Shift+C route obtain the as-shown selection path from Files.Actions1 and write it to a real clipboard sink without shell interpolation.
                """
            method command
            command "cargo test -p lege-files copy_path"
        }
        check folder-properties {
            statement """
                Properties is a visible explicit action and a selected folder reports recursive regular-file count plus logical and allocated totals without following symlinks, marking unreadable subtrees incomplete.
                """
            method command
            command "cargo test -p lege-filed folder_properties && cargo test -p lege-files properties"
        }
        check installable {
            statement """
                The helper and clipboard runtime dependencies remain synchronized between cargo-deb and the Debian source package, and the refreshed package builds.
                """
            method command
            command "cargo run -q -p xtask -- check-packaging && cargo deb -q -p lege-files && cargo deb -q -p lege-filed"
        }
        check preview-surface {
            statement """
                The standalone manager requests previews stale-safely and paints the selected file's decoded thumbnail in the properties rail without blocking rendering.
                """
            method command
            command "cargo test -p lege-files preview"
        }
        check workspace-quality {
            statement """
                Formatting, strict workspace Clippy, the complete test suite, integration smoke and structural checks remain green.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && tests/integration/run.sh && just tree-check && just deps-check && just check-interfaces"
        }
    }
    depends_on [ @legeos.work.standalone-file-manager/3 ]
    implements [
        @legeos.constraint.packaging-and-render-thread/1,
        @legeos.constraint.services-not-indicators/1
    ]
    part_of [ @legeos.milestone.m2-session-runs/1 ]
    acknowledged true
}

record legeos.work.file-previews-copy-path-and-folder-properties/2 : work {
