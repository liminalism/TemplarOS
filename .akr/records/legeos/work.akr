        """
    acceptance {
        check latest {
            statement """
                Latest verified upstream LXQt components and a window manager are packaged and installed in the offline TemplarOS target with matching session entry.
                """
            method observation
            verified_by [
                @legeos.evidence.lxqt-final-defaults-and-install-20261014,
                @legeos.evidence.lxqt-installed-owned-desktop-20261014
            ]
        }
