    supersedes [ @legeos.work.hands-on-run-3-fixes/1 ]
}

record legeos.work.hands-on-run-3-fixes/3 : work {
    title "Act on the third hands-on run: a usable Files object, a real window frame with controls, and resizable windows"
    state active
    scope [
        path "apps/templar-files/**",
        path "compositor/templar-comp/**",
        path "crates/templar-window/**",
        path "debian/control",
        path "shell/templar-shell/**"
    ]
    intent """
        Fix every deficiency in @legeos.observation.hands-on-run-3-findings-20260903 and hand the user a build set they can hot-swap in place. Shell (hot-swappable): (1) a row's first press selects and the second opens, so the selection-gated file verbs have something to act on; (2) Copy path puts the Files.Actions1-rendered text on the clipboard through wl-copy, as the Files app does; (3) a change of reveal state in either direction collapses the expanded Files object; (4) the rail drops PLACE/DRIVE captions, the crumb reads Home ▸ Files, breadcrumb segments are measured not guessed. Files app: the rail names its places once. Compositor (needs a new session): (5) a client window's geometry is its frame and the surface is mapped at and configured to the client area under the band (WindowService::client_area, subtracted in space_sync alone), so the band no longer covers client pixels; (6) the band carries park, maximize and close controls hit-tested against the rectangles chrome draws; (7) a press within RESIZE_MARGIN outside a framed window's edge starts an edge resize, corners included, the window on top first; (8) xdg-decoration is answered ServerSide unless the client insists; (9) a client that commits a size of its own choosing after acking the last configure gets its frame re-fitted, on xdg and X11 alike. Packaging: legeos-shell depends on wl-clipboard.
        """
    note """
        The compositor half cannot be hot-swapped by design (lege-comp.service is Restart=no; lege dev reports it as needs-session). The user must log out and back in for the frame, the controls and the edge resize to appear; the shell and Files app changes take effect on `sudo lege dev deploy`.
        """
    acceptance {
        check band-controls {
            statement """
                Band buttons pack against the right edge in park/maximize/close order, hit-test where they are drawn, and a narrow band keeps close and gives up the rest.
                """
            method command
            command "cargo test -p lege-comp -- band_buttons_pack_against_the_right_edge_close_last a_narrow_band_keeps_close_and_gives_up_the_rest"
            verified_by [ @legeos.evidence.hands-on-3-band-controls-20260903 ]
        }
        check frame-geometry {
            statement """
                client_area sits under the band and frame_around inverts it; resize_edges_at grabs edges only outside the frame, corners included.
                """
            method command
            command "cargo test -p lege-window -- the_client_area_sits_under_the_band edges_are_grabbed_just_outside_the_frame"
            verified_by [ @legeos.evidence.hands-on-3-frame-geometry-20260903 ]
        }
        check gates-green {
            statement """
                The full repository gate passes with all of the above merged.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.hands-on-3-gate-20260903 ]
        }
        check hands-on-confirmation {
            statement """
                At a real seat after logout/login: a terminal's first line is visible under its band; the band's close, park and maximize buttons work; a window resizes from its corner grip and from just outside its edges; in the Files object a click selects and the verbs act on the selection; Copy path pastes into a terminal; a bare Super press closes the expanded Files object.
                """
            method manual
        }
        check select-then-open {
            statement """
                In the expanded Files object a row's first press selects it, a second press on the selected row opens it, and search results take the same two presses.
                """
            method command
            command "cargo test -p lege-shell -- file_browser_pointer_activates_folders_and_files file_browser_search_results_use_the_same_clickable_rows"
            verified_by [ @legeos.evidence.hands-on-3-select-then-open-20260903 ]
        }
    }
    derived_from [ @legeos.observation.hands-on-run-3-findings-20260903 ]
    part_of [ @legeos.work.home-surface-usability-next ]
    supersedes [ @legeos.work.hands-on-run-3-fixes/2 ]
    author "dk"
}

record legeos.work.hands-on-run-4-fixes/1 : work {
    title "Act on the fourth hands-on run: a deploy that finishes, snap browsers that connect, per-window compositing, a screen timeout, and a launcher that finds applications"
    state superseded
    scope [
        path "apps/lege-settings/**",
        path "cli/lege/src/dev/**",
        path "compositor/lege-comp/**",
        path "crates/lege-session-core/**",
        path "distro/deploy/**",
        path "interfaces/**",
        path "services/lege-hostd/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Fix what the fourth hands-on run found: (1) lege-hostd's EACCES on the system bus socket, and lege dev deploy stopping activation at the first failed unit although every package was installed; (2) snap Chromium and Firefox refused by AppArmor because the public Wayland socket is named legeos-0 rather than wayland-N; (3) every band and grip rendered above every window so titles bleed through a translucent window, plus the reported focus fighting; (4) no screen timeout: a compositor idle timer, outputs off and back on, the timeout from Power1's stored idle policy, and a Settings control; (5) the launcher: sessiond never scanned the snap desktop directory so snap browsers were not in the registry, and the Home field federated files with applications.
        """
    note """
        Landed at 8880b9b. (1) hostd: root cause established by elimination as the ProtectHome=yes mount namespace (the unit had never started; AppArmor in complain mode with zero denials, DAC and bus limits ruled out); ProtectHome dropped, the daemon connects to /run/dbus directly and its failure line now prints uid, socket mode/owner, confinement label and mount namespace; the user can confirm with sudo strace or two systemd-run probes named in the agent report. Deploy runs every activation step and lists every failure. (2) Public socket wayland-0 (new_auto elsewhere); trusted-shell socket legeos-shell-wayland-0, a prefix on purpose because AppArmor's * does not stop at a dash; verified nested with snap Chromium. (3) src/scene.rs builds the frame per window in stacking order, band and grip directly above their own surface; press_target_at is the one hit test and a press on band/grip/edge now activates the window (that was the focus fight). (4) src/idle.rs plus lege_shell_v1 v4 set_idle_timeout, DrmCompositor::clear for DPMS off, Settings System page control from Never to 30 minutes, Power1 documents which field is enforced. (5) d391fc1, dfa1fda. Compositor, hostd and socket changes need a logout; hostd needs the deploy's system-unit restart.
        """
    acceptance {
        check gates-green {
            statement """
                just check exits 0 at the merged branch
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.hands-on-4-gate-20260903 ]
        }
        check hostd-starts {
            statement """
                After deploy, lege-hostd.service is active and lege dev deploy activates every component
                """
            method manual
        }
        check launcher-finds-snap-apps {
            statement """
                The registry scans the snap desktop directory and the Home field offers applications only
                """
            method command
            command "cargo test -p lege-sessiond && cargo test -p lege-shell"
            verified_by [ @legeos.evidence.hands-on-4-launcher-20260903 ]
        }
        check per-window-compositing {
            statement """
                A window behind a translucent Kitty shows through at Kitty's opacity, and a click on any band or grip focuses that window
                """
            method manual
        }
        check screen-timeout {
            statement """
                Settings › System shows Screen turns off after; the screen turns off after the chosen idle time and back on at the next input
                """
            method manual
        }
        check snap-browsers-connect {
            statement """
                After logout and login, snap Chromium and Firefox open on the Wayland display
                """
            method manual
        }
    }
    after [ @legeos.work.hands-on-run-3-fixes ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

