record legeos.work.home-navigation-manipulation-20260907/1 : work {
    title "Home and Files interaction refinement from the original Home Field plan"
    state completed
    scope [ path "shell/lege-shell/**" ]
    intent """
        Refine the existing Home container model: preserve inside clicks in expanded Files; make navigation and selection predictable across list/grid; reserve breadcrumb space; cycle Home focus and cancel pointer manipulation. User requested an uncommitted improvement pass; no deployment or live-session interaction.
        """
