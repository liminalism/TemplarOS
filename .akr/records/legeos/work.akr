        """
    note "Scope includes benchmark overlay-hit accounting and sampled overlay bytes. Public directory change markers are expanded with the existing indexed written/deleted row-generation ranges in the maintenance read view; raw change history alone omits descendants. The row bound counts distinct affected identities; a base identity with an upsert counts once. Rescans or a pruned feed require a new base."
    acceptance {
        check bounded-overlay {
            statement """
                Overlay publication is one committed root generation/change sequence; bounds and delayed compaction apply, memory is reported and retired views remain immutable.
                """
            method command
            command "cargo test -p templar-file-index overlay"
            verified_by [ @legeos.evidence.index-wp12-native-regressions-20261008/1 ]
        }
        check churn-latency {
            statement """
                Owned paired 100k churn report has churning-root initial-page p95 below150ms, arrays+overlay hit rate and memory reported, while quiet-root performance remains qualified.
                """
            method command
            command "xtask index-bench churn --edit-build"
            verified_by [ @legeos.evidence.index-wp12-final-churn-20261008/1 ]
        }
        check mutation-parity {
            statement """
                Base+overlay matches SQL after random create/delete/file rename/directory rename/metadata batches, including native paths, counts, ranks, sort order and reused entry IDs. A directory move beyond the overlay bound uses SQL.
                """
            method command
            command "cargo test -p templar-file-index --test search_parity"
            verified_by [ @legeos.evidence.index-wp12-native-regressions-20261008/1 ]
        }
    }
    depends_on [ @legeos.work.index-wp11-shards-20261008/2 ]
