    note "Owner instruction 2026-10-08: defer the original nested-generation comparison; neither the retired native Files search notice nor PCManFM Find is the final consumer route. Preserve the actual working FSearch Index1 fork/package evidence as a prototype. A future integrated Index1 search GUI is separate work; WP16 shipping/default adoption remains deferred pending that consumer decision."
    acceptance {
        check nested-generation {
            statement """
                DEFERRED BY OWNER 2026-10-08: actual owned nested session displays FSearch info and native shell notice at the same generation for the same query, with retained screenshots and native actions.
                """
            method manual
        }
        check private-shared-index {
            statement """
                Owned private filed+GTK/Xvfb5000entry/nonUTF8 fixture exercises query/sort/pages/native paths/selection/freshness and typed errors; FSearch holds zero inotify/fanotify FDs, creates no fsearch.db and performs no recursive fixture enumeration (GTK theme/icon allowlist retained).
                """
            method command
            command "distro/forks/fsearch/tests/remote-index.sh"
            verified_by [ @legeos.evidence.index-wp14-private-20261008/1 ]
        }
        check query-and-build {
            statement """
                Pinned GPL source with reproducible index-mode patch and Meson pure query translation tests builds the actual TemplarOS FSearch Debian package through scripts/build-fork-deb.sh; scanner/database-file/watch implementations are absent from the index-mode object graph.
                """
            method command
            command "scripts/build-fork-deb.sh fsearch"
            verified_by [ @legeos.evidence.index-wp14-package-20261008/1 ]
        }
    }
    depends_on [
        @legeos.work.index-wp13-diagnostics-20261008/4,
        @legeos.work.index-wp7-wp8-20261008/1
    ]
    part_of [ @legeos.work.shared-index-completion-20261008/1 ]
