record legeos.work.critical-grace-bound-to-victim-20260909/1 : work {
    title "Policy change — the critical-pressure kill delay belongs to the selected victim, not to the pressure episode"
    state superseded
    scope [
        path "services/lege-resourced/src/policy.rs",
        path "services/lege-resourced/tests/**",
        path "tests/fixtures/resources/**"
    ]
    intent """
        services/lege-resourced/src/policy.rs critical_steps (~725-774) keeps one critical_since for the whole Critical episode. If victim A exits or the ranking changes after the emergency_kill_delay has elapsed, the newly selected victim B receives SetMemoryHigh, RequestCheckpoint and KillCgroup on its first selected tick, with no grace period of its own. Associate the grace period with the victim's instance identity: reset it when the selected victim changes or there is no target, so every victim gets the full checkpoint deadline before a kill. Test: persistent Critical with an A-to-B transition after the delay; B is contained and asked to checkpoint but not killed until its own delay has elapsed. Existing critical-delay tests keep one victim and do not cover this.
        """
    note """
        Astra flagged this as P1 before active termination is enabled, and as a policy behaviour change to accept explicitly rather than bury in a polling fix. @legeos.constraint.identity-and-launch-safety keeps the governor observe-only until traces are reviewed, so this lands as a replay-checked policy change with its own fixture, and the user accepts it as such.
        """
    acceptance {
        check replay-fixture {
            statement """
                A recorded fixture covering the A-to-B transition replays to the new decisions and the existing fixtures are unchanged.
                """
            method command
            command "cargo test -p lege-resourced --test replay_fixtures"
            verified_by [ @legeos.evidence.critical-grace-replay-20260909/1 ]
        }
        check user-accepts-policy {
            statement """
                The user has read the behaviour change and accepted it before the record completes.
                """
            method manual
            verified_by [ @legeos.evidence.critical-grace-policy-accepted-20260909/1 ]
        }
        check victim-transition {
            statement """
                A test with persistent Critical pressure and a victim change after the delay shows the new victim is not killed until its own delay has elapsed.
                """
            method command
            command "cargo test -p lege-resourced policy"
            verified_by [ @legeos.evidence.critical-grace-victim-transition-20260909/1 ]
        }
    }
    after [ @legeos.work.governor-wake-reliability-20260909 ]
    derived_from [
        @legeos.assessment.astra-memory-polling-indexing-review-20260909#critical-grace
    ]
    implements [ @legeos.constraint.identity-and-launch-safety ]
    part_of [ @legeos.work.memory-polling-indexing-effectiveness-20260909 ]
}

