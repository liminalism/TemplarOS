    author "dk"
}

record legeos.work.index-wp15-silvaview-20261008/1 : work {
    title "WP15 Silvaview shared-index source and native projection"
    state superseded
    scope [
        path "distro/forks/silvaview/**",
        path "docs/indexing-dev/continuation-2026-10-08.md",
        path "docs/measurements/**"
    ]
    intent """
        Implement WP15 in the owning ../Silvaview-rs repository, preserving the person's existing Cargo.toml local-Vello change and screenshot. Add optional Linux templaros feature with store-free snapshot reader and minimal Index1 proxies; auto/service/scan modes with fallback only for absent/incompatible/uncovered initial service. Summary depth4, expansion on zoom, native-byte actions, honest indexed logical size/generation/freshness, and event-driven one-second generation debounce. Qualify policy parity and zero recursive enumeration using an owned private bus and native fixture; run the real service-mode binary in an owned nested session. G7 compact tree is optional and must be measured before adoption. No live desktop, daemon, mount or deployment changes.
        """
    note "Implementation belongs to sibling Silvaview and its own commits. LegeOS scope covers retained measurements/packaging; sibling source freshness must be recorded by its actual commit and source hashes, not inferred from a LegeOS path watch. Existing user modifications remain uncommitted."
    acceptance {
        check nested-service-binary {
            statement """
                The actual Silvaview binary runs in service mode on the owned nested session and visibly displays source, generation, freshness and indexed logical size.
                """
            method manual
        }
        check private-policy-parity {
            statement """
                Owned private filed fixture launches service mode without recursive fixture enumeration and matches direct-scan totals under explicitly declared symlink/mount/exclude/hardlink policy; generation refresh and stale/failure truth are exercised.
                """
            method command
            command "scripts/test-templaros-index.sh"
        }
        check service-policy-and-snapshots {
            statement """
                Native Silvaview tests cover service never scanning, auto fallback only for absent/incompatible/uncovered service, bounded validated snapshots, native paths and summary aggregates without double counting.
                """
            method command
            command "cargo test --features templaros"
        }
    }
    depends_on [ @legeos.work.index-wp7-wp8-20261008/1 ]
    part_of [ @legeos.work.silvaview-and-fsearch-share-the-index/1 ]
    author "dk"
}

