record legeos.work.home-navigation-manipulation-20260907/1 : work {
    title "Home and Files interaction refinement from the original Home Field plan"
    state superseded
    scope [ path "shell/lege-shell/**" ]
    intent """
        Refine the existing Home container model: preserve inside clicks in expanded Files; make navigation and selection predictable across list/grid; reserve breadcrumb space; cycle Home focus and cancel pointer manipulation. User requested an uncommitted improvement pass; no deployment or live-session interaction.
        """
    acceptance {
        check lint-and-actions {
            statement """
                Shell clippy with warnings denied, formatting, and action-manifest validation pass.
                """
            method command
            command "cargo clippy -p lege-shell --all-targets -- -D warnings; cargo fmt --all -- --check; cargo run -q -p xtask -- check-actions"
            verified_by [ @legeos.evidence.home-navigation-lint-20260907/1 ]
        }
        check shell-regressions {
            statement """
                Shell tests cover inside/outside Files clicks, reversible Tab traversal, pointer gesture cancellation, grid selection/context menus, navigation accelerators and focus scrolling.
                """
            method command
            command "cargo test -p lege-shell"
            verified_by [ @legeos.evidence.home-navigation-tests-20260907/1 ]
        }
    }
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

