record legeos.work.standalone-file-manager/5 : work {
    title "Standalone Files — service-backed browsing, operations and properties in an installable manager"
    state active
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "apps/templar-files/**",
        path "crates/templar-client/**",
        path "debian/**",
        path "distro/**",
        path "docs/architecture/files.md",
        path "interfaces/dbus/org.templaros.Files.*",
        path "scripts/**",
        path "services/templar-filed/**",
        path "session/**",
        path "shell/templar-shell/**"
    ]
    intent """
        Build `lege-files` as a first-party Pixelkit application and Debian package. It opens a real XDG folder, shows service-provided places and mounted drives with space state, lists immediate children in the filed-owned folder-first natural order, supports mouse and keyboard selection/navigation/history, and opens files only through Associations1 and Launcher1. Selection workflows provide rename, copy/cut/paste, trash, undo and a persistent properties/storage inspector; filesystem mutations run only through journalled Files.Operations1. Add any bounded Browse1 metadata/root methods needed by both Home and the standalone manager, validate unsafe operation requests in the service, wire the desktop file, app manifest, source package, seeds, cargo-deb build and reinstall helper, and cover the state/contract/package paths with tests.
        """
    note "\nThe committed supported legacy scope migration changed this planning head after its older completion evidence. Historical observations remain intact; this head is active for fresh acceptance evidence, not because a new code regression was observed. Live authority relations follow current heads rather than retired revisions."
    acceptance {
        check brokered-open {
            statement """
                Opening a file goes through Associations1, Launcher1 and Recents rather than spawning an application directly.
                """
            method command
            command "cargo test -p lege-files brokered_open"
            verified_by [ @legeos.evidence.standalone-files-brokered-open-20260824/1 ]
        }
        check installable-manager {
            statement """
                The first-party manager has a valid desktop entry, application manifest, source package, Debian package and reinstall path.
                """
            method command
            command "cargo run -q -p xtask -- check-packaging && cargo deb -q -p lege-files"
            verified_by [ @legeos.evidence.standalone-files-packaging-20260824/1 ]
        }
        check keyboard-pointer-parity {
            statement """
                Every visible file-manager action is reachable by both pointer and keyboard, including navigation, selection and dialogs.
                """
            method command
            command "cargo test -p lege-files interaction"
            verified_by [ @legeos.evidence.standalone-files-interaction-20260824/1 ]
        }
        check operations-and-properties {
            statement """
                Rename, copy/cut/paste, trash, undo, progress and the persistent properties/storage view use the filed-owned service contracts.
                """
            method command
            command "cargo test -p lege-files -p lege-filed operation && cargo test -p lege-filed properties"
            verified_by [ @legeos.evidence.standalone-files-ops-properties-20260824/1 ]
        }
        check real-browsing {
            statement """
                The standalone manager renders a real service-provided folder listing, XDG places and mounted drives, with pointer selection and folder-first natural ordering.
                """
            method command
            command "cargo test -p lege-files browser"
            verified_by [ @legeos.evidence.standalone-files-browser-20260824/1 ]
        }
        check workspace-quality {
            statement """
                Formatting, strict linting, the full workspace tests and structural interface/dependency checks all pass.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && just tree-check && just deps-check && just check-interfaces"
            verified_by [ @legeos.evidence.standalone-files-workspace-20260824/1 ]
        }
    }
    depends_on [ @legeos.decision.forks-by-manifest ]
    implements [
        @legeos.constraint.identity-and-launch-safety,
        @legeos.constraint.one-provider-per-role,
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
    supersedes [ @legeos.work.standalone-file-manager/4 ]
    acknowledged true
    author "dk"
}

record legeos.work.subtree-repair-preserves-root-truth-20260909/1 : work {
    title "P1 — a complete subtree pass never upgrades a root to Current or clears its whole-root stale reason"
    state superseded
    scope [
        path "crates/lege-file-index/src/generation.rs",
        path "crates/lege-file-index/tests/**"
    ]
    intent """
        crates/lege-file-index/src/generation.rs derives the root's state and complete flag from the scoped pass alone (committed_state at ~441-445, the commit at ~530-555). A successful subtree scan therefore clears an unrelated whole-root overflow, watcher-exhaustion or incomplete-namespace state. The metadata axis already refuses this upgrade for ScanScope::Subtree; give the namespace axis the same rule: a subtree commit may downgrade the root or leave it as it was, and only a ScanScope::Root pass may set Current/complete or replace a whole-root stale reason. Tests: a root marked Stale{overflow} and a root left incomplete by a budget, each followed by a successful disjoint subtree scan, stay stale/incomplete with their original reason; a subsequent root pass restores Current/complete.
        """
    note """
        Astra rank P1, implement first. The consumer contract tests in crates/lege-file-index/tests/consumer_contract.rs already encode what Current means to a reader; extend them rather than adding a parallel suite.
        """
    acceptance {
        check subtree-no-upgrade {
            statement """
                Regression tests: stale-overflow and budget-incomplete roots stay so after a successful disjoint subtree scan; only a following root pass restores Current/complete.
                """
            method command
            command "cargo test -p lege-file-index subtree"
            verified_by [ @legeos.evidence.effectiveness-1-scoped-tests-20260909/1 ]
        }
    }
    depends_on [ @legeos.observation.home-tree-exceeds-the-inotify-watch-budget ]
    derived_from [
        @legeos.assessment.astra-memory-polling-indexing-review-20260909#subtree-upgrade
    ]
    part_of [ @legeos.work.memory-polling-indexing-effectiveness-20260909 ]
}

