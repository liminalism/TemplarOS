akr 0.1
project legeos

record legeos.work.action-manifest-one-declaration-three-surfaces/1 : work {
    title "Declare every user-facing action once, and generate the menu, the cheat sheet and the CLI verb from it"
    state proposed
    scope [
        path "cli/lege/**",
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-types/**",
        path "shell/**"
    ]
    intent """
        LegeOS already commits to every capability being reachable from the CLI, the portal, the shell and Settings (M1 evidence m1-clients-reachable; docs/architecture/accessibility.md: "everything the shell shows is available through lege too"). Today that is a discipline maintained by hand across four implementations, and nothing prevents them drifting. Omarchy demonstrates the mechanism that makes it structural: one declaration — `o.bind(chord, human_label, action)` — is simultaneously the keybinding, the row in a mouse-navigable menu tree, and the entry in a cheat sheet generated from the same table, so the documentation cannot fall out of date with the behaviour because it is not a separate artefact. Adopt the pattern: an action manifest (id, human label, optional chord, CLI verb, availability predicate) living in a service crate rather than the shell, with the shell's menu, the discoverability surface and `lege`'s subcommand table all rendered from it. The manifest belonging to a service rather than the shell is what keeps it consistent with services-not-indicators: the shell renders the manifest, it does not own it.
        """
    note """
        Not M2. What can happen during M2 is that the Home Surface and its information/action rows are built to read rows from a declaration rather than hard-coding them, because retrofitting that later is much more expensive than designing it in — so the cost of deferring the manifest is low only if M2's shell surfaces are written data-driven from the start.

        The keyboard layer is strictly additive, and this is a decision, not an accident of scheduling. Every action must have a mouse or menu path that is not second-class — not a smaller target, not fewer capabilities, not discoverable only by first reading a shortcut list. A chord is an accelerator recorded alongside the menu entry in the same manifest, never the only route to a capability. Omarchy's own navigation manual claims "EVERYTHING happens via the keyboard", and its top-bar manual, documenting full click-and-scroll parity on every widget, contradicts it: read carefully, Omarchy is keyboard-primary with first-class mouse parity, which is the position worth copying rather than the slogan. This is consistent with LegeOS's existing accessibility invariants rather than a change to them.

        See docs/research/omarchy-review.md §3.1 and §5.
        """
    depends_on [ @legeos.constraint.services-not-indicators ]
    source {
        kind internal
        role rationale
        path "docs/research/omarchy-review.md"
        use """
            The study this came from, including the verification pass that corrects three of its own claims against source.
            """
    }
}

record legeos.work.compositor-window-authority/1 : work {
    title "The compositor's window authority: typed layers, one scene, explicit minimisation, recovery without the shell"
    state completed
    scope [ path "compositor/**", path "crates/lege-window/**", path "interfaces/wayland/**" ]
    intent """
        Make lege-window the thing that decides stacking and geometry rather than a set of helpers: typed overlay layers as a total order with rules about which client may claim which layer; the one-workspace invariant as a type-level property, with deterministic migration when an output is removed and validation of restored geometry against the current topology; explicit minimisation to a Window Shelf that is always restorable to a recoverable geometry; a compositor-owned recovery band, a show-all-windows scatter and an escape route out of fullscreen that all work when the shell is dead; drag anchors held in one global logical coordinate space across mixed-scale outputs; window commands gated on activation grants with recent-input evidence; and property tests over generated multi-output topologies. lege-comp-integration keeps the render thread off D-Bus, hardens the identity cache against PID reuse, and tells the governor which instance the user is looking at.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.consumers-cli-portal-shell/1 : work {
    title "The clients: the CLI over the whole OS, one portal backend, the Home Surface model, Settings"
    state completed
    scope [
        path "apps/lege-settings/**",
        path "cli/lege/**",
        path "crates/lege-client/src/sdk.rs",
        path "portals/**",
        path "shell/**"
    ]
    intent """
        Make the services reachable: lege as one command line over identity, launching, associations with an explanation, files and operations, resources, history with undo, providers, settings, projects, power and updates; xdg-desktop-portal-lege as the single backend implementing FileChooser over the shared last-directory answer, OpenURI and AppChooser over the association broker, Settings and Background over providers and autostart, so a sandboxed application and a normal one behave the same; the Home Surface as a data model over the services (drawers, dock grouping by canonical AppId, the window shelf, the operations drawer) rendered without a toolkit for now; and lege-settings as pages that map one-to-one onto D-Bus interfaces, with nothing a private implementation detail. Everything the shell shows must be available through lege as well.
        """
    after [
        @legeos.work.compositor-window-authority,
        @legeos.work.governor-containment,
        @legeos.work.host-update-transaction,
        @legeos.work.sessiond-persistence-and-launch
    ]
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.desktop-validation-foundations/1 : work {
    title "Desktop validation foundations — honest hardware, composed-session, installation and visual gates"
    state active
    scope [
        path ".github/**",
        path "apps/lege-greeter/**",
        path "ci/**",
        path "cli/lege/**",
        path "compositor/**",
        path "scripts/**",
        path "services/lege-boot-health/**",
        path "services/lege-hostd/**",
        path "services/lege-sessiond/**",
        path "shell/**",
        path "tests/**"
    ]
    intent """
        Turn the audit's false-green and manual-only desktop checks into executable gates before treating M2 as a usable session: run the hardware matrix honestly, isolate runtime smoke state, prove compositor/session readiness, automate a nested composed-session journey, exercise the greeter protocol end to end, install every desktop package in a clean root, and compare deterministic Home renders.
        """
    note """
        User-set order on 2026-08-27: complete validation foundations first, then finish the ordinary desktop surfaces; real-hardware execution and its detailed matrix are deliberately deferred to a later Plan-mode session.
        """
    acceptance {
        check clean-install {
            statement """
                CI builds every Debian package and installs the complete desktop set into a clean disposable root or VM, then checks unit binaries, session entries and package coherence.
                """
            method command
            command "tests/integration/package-install.sh"
        }
        check greeter-integration {
            statement """
                A fake greetd server and the real greeter protocol/client exercise success, authentication failure, retry, cancellation, selected session command, and compositor --exec exit propagation.
                """
            method command
            command "cargo test -p lege-greeter && tests/integration/greeter.sh"
        }
        check hardware-runner {
            statement """
                lege doctor --hardware parses the TOML matrix, filters by detected/requested profile and optional check ID, reports each step/expectation without executing destructive actions implicitly, and differs structurally from ordinary doctor.
                """
            method command
            command "cargo test -p lege doctor::hardware"
        }
        check isolated-smoke {
            statement """
                The integration smoke uses isolated HOME/XDG directories and a private session bus, starts real session services where applicable, and cannot import developer-host desktop state.
                """
            method command
            command "tests/integration/run.sh"
        }
        check nested-session-journey {
            statement """
                An automated nested journey starts compositor, services and shell, observes their readiness, launches a client, exercises input/window/Home recovery including shell restart, and leaves no processes or sockets behind.
                """
            method command
            command "tests/integration/nested-session.sh"
        }
        check readiness-is-honest {
            statement """
                Boot-health cannot report a healthy session unless compositor-active and session-healthy have both been reported; the smoke asserts expected health outcomes instead of accepting any report-only output.
                """
            method command
            command "cargo test -p lege-boot-health -p lege-hostd -p lege-sessiond"
        }
        check visual-regression {
            statement """
                Deterministic Home renders at representative sizes and scale/layout states are compared semantically or pixel-wise against reviewed baselines, with an explicit baseline-update command.
                """
            method command
            command "cargo test -p lege-shell visual_regression"
        }
    }
    derived_from [ @legeos.assessment.desktop-test-readiness-20260827/1 ]
    part_of [ @legeos.milestone.m2-session-runs/1 ]
}

record legeos.work.display-manager-session-startup-reliability/1 : work {
    title "Make the installed LegeOS display-manager session start deterministically and fail back cleanly"
    state superseded
    scope [
        path "compositor/lege-comp/**",
        path "docs/testing/README.md",
        path "services/lege-filed/**",
        path "services/lege-resourced/**",
        path "session/**",
        path "tests/**"
    ]
    intent """
        Repair the installed-session contract exposed by the 2026-08-22 SDDM attempts: eliminate inherited-display backend selection, make compositor readiness real, start the graphical shell on its trusted socket, end the session when the compositor cannot run, and prevent auxiliary services from exhausting resources during login.
        """
    acceptance {
        check aux-services-bounded {
            statement """
                The resource governor no longer self-aborts after mlockall and the file service's default startup indexing has an explicit finite admission bound exercised by tests.
                """
            method command
            command "cargo test -p lege-resourced -p lege-filed"
        }
        check installed-login {
            statement """
                After rebuilding and installing the packages, selecting LegeOS in SDDM reaches the graphical Home Surface instead of freezing the greeter or leaving a black screen.
                """
            method manual
        }
        check startup-contract {
            statement """
                Automated session/unit tests prove the installed entry forces the hardware backend, publishes deterministic public and trusted-shell sockets, waits for actual compositor readiness, starts lege-shell --surface, and tears down the target if the compositor exits.
                """
            method command
            command "cargo test -p lege-session -p lege-comp && cargo run -q -p xtask -- check-packaging"
        }
    }
    implements [ @legeos.decision.session-greeter-lock/2 ]
    part_of [ @legeos.milestone.m2-session-runs/1 ]
}

