            verified_by [
                @legeos.evidence.archive-verification-checks-rerun-20260907/1,
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-version-authority-20260904,
                @legeos.evidence.de01-version-authority-20260904/1
            ]
        }
    }
    implements [ @legeos.decision.debian-packaging ]
    part_of [
        @legeos.milestone.developer-edition-0-1,
        @legeos.work.deployment-activation-and-resourced
    ]
    supersedes [ @legeos.work.build-set-archive-verification/1 ]
    author "dk"
}

record legeos.work.build-set-archive-verification/3 : work {
    title "D2 — BuildSetId feeds debian/changelog, the local archive verifies whole sets, and the image can consume a published set"
    state active
    scope [
        path "ci/**",
        path "cli/templar/src/dev/repo.rs",
        path "crates/templar-build/**",
        path "debian/changelog",
        path "debian/rules",
        path "distro/apt/**",
        path "tools/xtask/src/archive.rs",
        path "tools/xtask/src/build_set.rs",
        path "tools/xtask/src/signatures.rs"
    ]
    intent """
        Make the BuildSetId the one version authority (generate the debian/changelog head entry from it for source builds), add `lege dev repo verify` (one id across the set, no missing component against components.toml, valid InRelease/Release.gpg, previous set still installable), give the archive a staged/candidate marker distinct from the boot-deployment candidate vocabulary, record provenance (toolchain, host, Ubuntu index time), add a disposable Ubuntu 26.04 source-build lane under ci/ that reports not-executed when mmdebstrap/podman are absent, and provide the mkosi drop-in that points the image at a named published set.
        """
    note "HEAD reconciliation 2026-09-03: BuildSetId, keep-3 pruning, signing and mixed-set rejection already exist (crates/lege-build, cli/lege/src/dev/repo.rs); debian/changelog carries an independent 0.1.0~dev1; no verify command, no clean-root lane, no local-snapshot consumption by just image.\n\n2026-09-07: `image-drop-in` was already satisfied and nobody had said so. `distro/image/compose.sh:22` writes `mkosi.conf.d/40-local-archive.conf` from `$LEGEOS_BUILD_SET` or the archive's `current` marker, and writes nothing when neither exists (@legeos.observation.the-image-drop-in-for-a-named-build-set-already-exists). It has never been *run*, because mkosi is not installed on this host — which is the alternative the check's own wording allows, and is why its method is now observation rather than manual. `just image summary` is a user gate in RUNBOOK-L3.md.\nThe committed supported legacy scope migration changed this planning head after its older completion evidence. Historical observations remain intact; this head is active for fresh acceptance evidence, not because a new code regression was observed."
    acceptance {
        check archive-verify {
            statement """
                `lege dev repo verify` detects a mixed set, a missing component and a bad signature in fixtures, and reports the current and previous sets as installable.
                """
            method command
            command "cargo test -p lege repo"
            verified_by [
                @legeos.evidence.archive-verification-checks-rerun-20260907/1,
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-integrated-gate-20260904/1
            ]
        }
        check image-drop-in {
            statement """
                A documented mkosi drop-in makes `just image` consume a named published set from the local archive, or the drop-in is documented as not exercised because mkosi is absent.
                """
            method observation
            verified_by [
                @legeos.evidence.de01-image-summary-mkosi-absent-20260904,
                @legeos.evidence.image-drop-in-exists-unexercised-20260907/1,
                @legeos.observation.the-image-drop-in-for-a-named-build-set-already-exists
            ]
        }
        check one-version-authority {
            statement """
                The debian/changelog head entry used by the source build is derived from the BuildSetId; a test proves the derivation and `just deb-plan` prints the same id.
                """
            method command
            command "cargo test -p lege-build && just deb-plan"
            verified_by [
                @legeos.evidence.archive-verification-checks-rerun-20260907/1,
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-version-authority-20260904,
                @legeos.evidence.de01-version-authority-20260904/1
            ]
        }
    }
    implements [ @legeos.decision.debian-packaging ]
    part_of [
        @legeos.milestone.developer-edition-0-1,
        @legeos.work.deployment-activation-and-resourced
    ]
    supersedes [ @legeos.work.build-set-archive-verification/2 ]
    author "dk"
}

record legeos.work.clipboard-consumers-shell-portal/1 : work {
    title "Clipboard consumers: shell inputs, wl-copy replacement, portal backend"
    state blocked
    intent """
        Finish clipboard end-to-end: the three consumers of crates/templar-clipboard that are still
        unwritten. (1) Shell text inputs: Ctrl+C/V/X handling plus seat-selection integration in
        templar-shell/templar-field, so select/copy/paste works inside OS surfaces. (2) In-process
        replacement for the `wl-copy` shell-out (shell/templar-shell/src/surface/app.rs "Copy path"
        path) using the new crate's data-source model. (3) Clipboard portal backend in
        portals/xdg-desktop-portal-templar (org.freedesktop.portal.Clipboard), so sandboxed apps get
        clipboard through the portal instead of raw data-control.

        Already landed underneath this: crates/templar-clipboard (MIME offer model, 6/6 tests),
        compositor zwlr_data_control_manager_v1 wiring with primary-selection support, and
        XWayland selection bridging flipped on (allow_selection_access -> true), all with
        regression tests (148/148 comp suite green).

        BLOCKED on a lane conflict, not on design: shell/settings/taskbar files are owned by another
        agent's lane (per the lane map and OptMem #0, which also reserves file-index work to claude),
        so this work must not cut shell-side code until the lanes are re-coordinated. When resuming:
        confirm lane ownership first, then implement consumers in the order above, each with its
        maintained tests; the portal backend additionally needs a decision on which backend (if any)
        gates clipboard access for sandboxed clients.
        """
}

record legeos.work.compositor-clipboard-wiring/1 : work {
    title "Data-control global and XWayland selection bridging"
    state superseded
    scope [
        path "compositor/templar-comp/src/backend/check.rs",
        path "compositor/templar-comp/src/handlers.rs",
        path "compositor/templar-comp/src/state.rs",
        path "compositor/templar-comp/src/xwayland.rs"
    ]
    intent """
        One session clipboard: wire zwlr_data_control_manager_v1 (with primary-selection support,
        visible to ordinary clients like the session lock manager) and flip XWayland selection
        bridging on (allow_selection_access answers true). X11 programs share the session clipboard
        instead of a private X11-only one, and clipboard tools can drive selections without keyboard
        focus. The advertisement self-check now requires the data-control global.
        """
    acceptance {
        check comp-suite-green {
            statement """
                The full compositor binary suite passes, including the XWayland bridge regression test
                and the advertisement self-check covering the new global, with clippy and fmt clean.
                """
            method command
            command "cargo test -p templar-comp --bin templar-comp"
            verified_by [ @legeos.evidence.comp-clipboard-tests-20261001/1 ]
        }
    }
}

