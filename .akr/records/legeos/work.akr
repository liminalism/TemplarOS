record legeos.work.desktop-polish-and-test-infrastructure-backlog-20261004/1 : work {
    title "Backlog to work natively on TemplarOS: one visual language for windows, clustered cards with shape and memory, a shell-drawn switcher, and the test, logging, freeze and ledger infrastructure that lets it be verified"
    state superseded
    scope [
        path "compositor/templar-comp/**",
        path "crates/templar-window/**",
        path "docs/architecture/**",
        path "interfaces/wayland/**",
        path "scripts/nested-session.sh",
        path "services/templar-filed/**",
        path "shell/templar-shell/**"
    ]
    intent """
        The user accepted the full list of suggestions made at the end of the 2026-10-04 Lubuntu session (Alt+Tab rework, chip icons, centred folder-clustered Home cards, compositor-known card rects with park motion) and chose to do them natively from TemplarOS, where the composed session can be exercised directly. Each acceptance check below is one item; split any into its own work record when starting it (knowledge.propose with part_of this key). Suggested order: t1, t2, t3 first (they make everything else testable and safe), then a1 and a3. Items marked as inference were not confirmed before this record was written.
        """
    note """
        Written from Lubuntu without code changes. Context records: @legeos.work.alt-tab-and-task-rail-icons-20261004, @legeos.work.home-work-centred-folder-clusters-20261004, @legeos.work.compositor-knows-home-cards-park-motion-20261004 (all uncommitted over 2bc8f74 at the time). a8 and t5 are suspicions to confirm first, not known defects.
        """
    acceptance {
        check a1-one-window-language {
            statement """
                A window is drawn the same way on every surface that lists it: the bar, both rails, the Alt+Tab switcher and the Home work cards show the application icon plus the existing activity stripe and parked dimming; the Home card state strip no longer spells out kind and state words ('terminal · active · /path'); names appear on hover or focus.
                """
            method manual
        }
        check a2-folder-cluster-plates {
            statement """
                Each Home work cluster (shell/templar-shell/src/work_layout.rs) is drawn on one faint shared backdrop naming its folder once; cards no longer repeat the folder path in their state strip; unfiled clusters have no plate.
                """
            method manual
        }
        check a3-card-geometry {
            statement """
                Home work cards in one cluster share a row baseline (no half-row offsets from stretched grid cells), and each card's preview is letterboxed to its window's aspect instead of stretched (bar_screen/field_screen preview blits).
                """
            method manual
        }
        check a4-shell-drawn-switcher {
            statement """
                Alt+Tab shows icons and live thumbnails drawn by the shell over Layer::Presentation from compositor-sent switcher state, as Taskfield labels already are; with the shell dead the compositor's text HUD (chrome::SwitcherState) still works unchanged.
                """
            method manual
        }
        check a5-system-rail-icons {
            statement """
                The System rail and the bottom-right cluster (cluster_screen.rs) show symbolic icons with hover tooltips for Settings, Network and the account; the clock stays text; the rail reads as visually consistent with the Apps rail.
                """
            method manual
        }
        check a6-group-chip-stack {
            statement """
                A window-group chip on the bar and Apps rail shows two or three overlapping member icons beside its accent stripe instead of one member's icon.
                """
            method manual
        }
        check a7-motion-polish-reduced-motion {
            statement """
                A reduced-motion preference exists in Settings and is honoured by every animation (park/unpark motion in compositor/templar-comp/src/motion.rs, rail reveals, fans); with it off, the park motion uses a refined curve (scale ease with slight aspect morph toward the card) judged smooth on the DRM backend.
                """
            method manual
        }
        check a8-bar-black-band {
            statement """
                Inference to confirm first: the nested session showed a black band along the bottom of the output, possibly an unpainted bar-surface row. On TemplarOS the bottom edge shows no unpainted strip in any bar presence (open, hint, revealed, gesture mode with no rail), or the cause is recorded.
                """
            method manual
        }
        check t1-per-os-target-dir {
            statement """
                Builds from TemplarOS and from Lubuntu no longer share a target directory (per-OS CARGO_TARGET_DIR via .cargo/config.toml or the justfile), so `cargo build -p templar-shell` links on both without the /tmp workaround; documented in the handoff capsule.
                """
            method command
            command "cargo build -p templar-shell"
        }
        check t10-ledger-rename-debt {
            statement """
                The ~530 pre-rename AKR-G022/G023 warnings (lege-* paths and package names) are resolved by a batch revision so `akr validate` reports only genuine diagnostics.
                """
            method command
            command "akr validate"
        }
        check t11-commit-in-slices {
            statement """
                The uncommitted tree over 2bc8f74 is committed as per-feature slices (archive, calendar/clipboard/focus WIP, Alt+Tab, chip icons, Home card placement, card targets and motion), each passing `just check`, and the 20261004 evidence records are re-observed at those commits.
                """
            method command
            command "just check"
        }
        check t12-predeploy-checklist {
            statement """
                A generated pre-deploy checklist lists every open manual acceptance check across active work records, grouped by what to try after logging in, so a TemplarOS test session is one pass.
                """
            method manual
        }
        check t2-nested-session-and-input-injector {
            statement """
                scripts/nested-session.sh runs on an X11 host as well as a Wayland one and accepts a binary-directory override; a test-only input injector (private protocol or CLI on the nested compositor) lets scripts click, type and hold modifiers inside the nested session without touching host input, and at least the Alt+Tab release-commit and click-card-to-restore checks are automated with it.
                """
            method command
            command "scripts/nested-session.sh start && scripts/nested-session.sh stop"
        }
        check t3-flip-recovery {
            statement """
                The vblank-driven render chain (compositor/templar-comp/src/backend/udev.rs) recovers from a lost page-flip completion: the watchdog's overdue-flip detection re-arms or re-queues rendering instead of only reporting, verified by a fault-injection test or a recorded hardware observation; continuous motion frames cannot wedge the cursor.
                """
            method manual
        }
        check t4-journal-readable-logs {
            statement """
                Shell and compositor tracing output disables ANSI colour when stdout is not a TTY, so `journalctl --user -t templar-shell` shows text, not byte arrays; 'no icon resolved for an application' is logged once per app id at info level.
                """
            method command
            command "journalctl --user -t templar-shell -n 20 -o cat"
        }
        check t5-structured-recent-feed {
            statement """
                Inference to confirm first: the production Recent feed (shell/templar-shell/src/drawers/recent.rs) fills only text lines and leaves row_targets empty, so recent rows in the Files object may not open on click. The Recent feed carries structured rows (path, app, time, mime) used by the Files object, the Recent drawer and the work-card folder lookup alike, and clicking a recent row opens it.
                """
            method manual
        }
        check t6-terminal-cwd-osc7 {
            statement """
                A terminal's working directory reaches Homegarden on every directory change (OSC 7 from the shell, or the garden prompt hook reporting per instance), so a terminal's Home card moves to the right folder cluster after `cd` without relaunching.
                """
            method manual
        }
        check t7-card-position-memory {
            statement """
                Home work card placement keeps a soft per-folder position hint across output changes, project zoom and session restarts (stored without making cards persistent tiles), so the same project's cards return to the same area the next day; the persistent field document stays untouched by work presentation.
                """
            method manual
        }
        check t8-unverified-window-icons {
            statement """
                A recorded decision on unverified windows: whether a window whose identity did not resolve may show its claimed app icon for display only, marked as unverified, never merging into a trusted chip (ARCHITECTURE.md identity invariant); implemented if accepted.
                """
            method observation
        }
        check t9-protocol-version-gate {
            statement """
                The Wayland version check (xtask check-wayland-versions) enforces that templar_shell_toplevel_list_v1 and templar_shell_toplevel_v1 versions equal templar_shell_manager_v1's and that every new per-toplevel request's since= equals a manager version, since toplevel objects inherit the manager's version.
                """
            method command
            command "cargo run -q -p xtask -- check-wayland-versions"
        }
    }
    derived_from [
        @legeos.work.alt-tab-and-task-rail-icons-20261004,
        @legeos.work.compositor-knows-home-cards-park-motion-20261004,
        @legeos.work.home-work-centred-folder-clusters-20261004
    ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    author "dk"
}

record legeos.work.desktop-polish-and-test-infrastructure-backlog-20261004/2 : work {
    title "Backlog to work natively on TemplarOS: one visual language for windows, clustered cards with shape and memory, a shell-drawn switcher, and the test, logging, freeze and ledger infrastructure that lets it be verified"
    state active
    scope [
        path "compositor/templar-comp/**",
        path "crates/templar-window/**",
        path "docs/architecture/**",
        path "interfaces/wayland/**",
        path "scripts/nested-session.sh",
        path "services/templar-filed/**",
        path "shell/templar-shell/**"
    ]
    intent """
        The user accepted the full list of suggestions made at the end of the 2026-10-04 Lubuntu session (Alt+Tab rework, chip icons, centred folder-clustered Home cards, compositor-known card rects with park motion) and chose to do them natively from TemplarOS, where the composed session can be exercised directly. Each acceptance check below is one item; split any into its own work record when starting it (knowledge.propose with part_of this key). Suggested order: t1, t2, t3 first (they make everything else testable and safe), then a1 and a3. Items marked as inference were not confirmed before this record was written.
        """
    note "Written from Lubuntu without code changes. Context records: @legeos.work.alt-tab-and-task-rail-icons-20261004, @legeos.work.home-work-centred-folder-clusters-20261004, @legeos.work.compositor-knows-home-cards-park-motion-20261004 (all uncommitted over 2bc8f74 at the time). a8 and t5 are suspicions to confirm first, not known defects.\n2026-10-05: the user explicitly selected Keep atomic desktop cutover; archive, login and infrastructure stay separate. No behavior or acceptance checks were dropped."
    acceptance {
        check a1-one-window-language {
            statement """
                A window is drawn the same way on every surface that lists it: the bar, both rails, the Alt+Tab switcher and the Home work cards show the application icon plus the existing activity stripe and parked dimming; the Home card state strip no longer spells out kind and state words ('terminal · active · /path'); names appear on hover or focus.
                """
            method manual
        }
        check a2-folder-cluster-plates {
            statement """
                Each Home work cluster (shell/templar-shell/src/work_layout.rs) is drawn on one faint shared backdrop naming its folder once; cards no longer repeat the folder path in their state strip; unfiled clusters have no plate.
                """
            method manual
        }
        check a3-card-geometry {
            statement """
                Home work cards in one cluster share a row baseline (no half-row offsets from stretched grid cells), and each card's preview is letterboxed to its window's aspect instead of stretched (bar_screen/field_screen preview blits).
                """
            method manual
        }
        check a4-shell-drawn-switcher {
            statement """
                Alt+Tab shows icons and live thumbnails drawn by the shell over Layer::Presentation from compositor-sent switcher state, as Taskfield labels already are; with the shell dead the compositor's text HUD (chrome::SwitcherState) still works unchanged.
                """
            method manual
        }
        check a5-system-rail-icons {
            statement """
                The System rail and the bottom-right cluster (cluster_screen.rs) show symbolic icons with hover tooltips for Settings, Network and the account; the clock stays text; the rail reads as visually consistent with the Apps rail.
                """
            method manual
        }
        check a6-group-chip-stack {
            statement """
                A window-group chip on the bar and Apps rail shows two or three overlapping member icons beside its accent stripe instead of one member's icon.
                """
            method manual
        }
        check a7-motion-polish-reduced-motion {
            statement """
                A reduced-motion preference exists in Settings and is honoured by every animation (park/unpark motion in compositor/templar-comp/src/motion.rs, rail reveals, fans); with it off, the park motion uses a refined curve (scale ease with slight aspect morph toward the card) judged smooth on the DRM backend.
                """
            method manual
        }
        check a8-bar-black-band {
            statement """
                Inference to confirm first: the nested session showed a black band along the bottom of the output, possibly an unpainted bar-surface row. On TemplarOS the bottom edge shows no unpainted strip in any bar presence (open, hint, revealed, gesture mode with no rail), or the cause is recorded.
                """
            method manual
        }
        check t1-per-os-target-dir {
            statement """
                Builds from TemplarOS and from Lubuntu no longer share a target directory (per-OS CARGO_TARGET_DIR via .cargo/config.toml or the justfile), so `cargo build -p templar-shell` links on both without the /tmp workaround; documented in the handoff capsule.
                """
            method command
            command "cargo build -p templar-shell"
        }
        check t10-ledger-rename-debt {
            statement """
                The ~530 pre-rename AKR-G022/G023 warnings (lege-* paths and package names) are resolved by a batch revision so `akr validate` reports only genuine diagnostics.
                """
            method command
            command "akr validate"
        }
        check t11-commit-in-slices {
            statement """
                The uncommitted tree over 2bc8f74 is committed as separate archive, login and infrastructure slices plus the user-approved atomic desktop cutover covering calendar/clipboard/focus WIP, Alt+Tab, chip icons, Home card placement, card targets and motion; each source prefix passes `just check`, and the 20261004 evidence is freshly re-observed against the committed implementation.
                """
            method command
            command "just check"
        }
        check t12-predeploy-checklist {
            statement """
                A generated pre-deploy checklist lists every open manual acceptance check across active work records, grouped by what to try after logging in, so a TemplarOS test session is one pass.
                """
            method manual
        }
        check t2-nested-session-and-input-injector {
            statement """
                scripts/nested-session.sh runs on an X11 host as well as a Wayland one and accepts a binary-directory override; a test-only input injector (private protocol or CLI on the nested compositor) lets scripts click, type and hold modifiers inside the nested session without touching host input, and at least the Alt+Tab release-commit and click-card-to-restore checks are automated with it.
                """
            method command
            command "scripts/nested-session.sh start && scripts/nested-session.sh stop"
        }
        check t3-flip-recovery {
            statement """
                The vblank-driven render chain (compositor/templar-comp/src/backend/udev.rs) recovers from a lost page-flip completion: the watchdog's overdue-flip detection re-arms or re-queues rendering instead of only reporting, verified by a fault-injection test or a recorded hardware observation; continuous motion frames cannot wedge the cursor.
                """
            method manual
        }
        check t4-journal-readable-logs {
            statement """
                Shell and compositor tracing output disables ANSI colour when stdout is not a TTY, so `journalctl --user -t templar-shell` shows text, not byte arrays; 'no icon resolved for an application' is logged once per app id at info level.
                """
            method command
            command "journalctl --user -t templar-shell -n 20 -o cat"
        }
        check t5-structured-recent-feed {
            statement """
                Inference to confirm first: the production Recent feed (shell/templar-shell/src/drawers/recent.rs) fills only text lines and leaves row_targets empty, so recent rows in the Files object may not open on click. The Recent feed carries structured rows (path, app, time, mime) used by the Files object, the Recent drawer and the work-card folder lookup alike, and clicking a recent row opens it.
                """
            method manual
        }
        check t6-terminal-cwd-osc7 {
            statement """
                A terminal's working directory reaches Homegarden on every directory change (OSC 7 from the shell, or the garden prompt hook reporting per instance), so a terminal's Home card moves to the right folder cluster after `cd` without relaunching.
                """
            method manual
        }
        check t7-card-position-memory {
            statement """
                Home work card placement keeps a soft per-folder position hint across output changes, project zoom and session restarts (stored without making cards persistent tiles), so the same project's cards return to the same area the next day; the persistent field document stays untouched by work presentation.
                """
            method manual
        }
        check t8-unverified-window-icons {
            statement """
                A recorded decision on unverified windows: whether a window whose identity did not resolve may show its claimed app icon for display only, marked as unverified, never merging into a trusted chip (ARCHITECTURE.md identity invariant); implemented if accepted.
                """
            method observation
        }
        check t9-protocol-version-gate {
            statement """
                The Wayland version check (xtask check-wayland-versions) enforces that templar_shell_toplevel_list_v1 and templar_shell_toplevel_v1 versions equal templar_shell_manager_v1's and that every new per-toplevel request's since= equals a manager version, since toplevel objects inherit the manager's version.
                """
            method command
            command "cargo run -q -p xtask -- check-wayland-versions"
        }
    }
    derived_from [
        @legeos.work.alt-tab-and-task-rail-icons-20261004,
        @legeos.work.compositor-knows-home-cards-park-motion-20261004,
        @legeos.work.home-work-centred-folder-clusters-20261004
    ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    supersedes [ @legeos.work.desktop-polish-and-test-infrastructure-backlog-20261004/1 ]
    author "dk"
}

