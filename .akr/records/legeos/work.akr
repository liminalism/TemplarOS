        path "services/templar-filed/tests/**"
    ]
    intent """
        WP17 qualification and closure of docs/indexing-dev/implementation-plan.md. Exercise precise owned process death at the scan commit and partial snapshot write of the unmodified native filed; observe SQLite head/rows/change sequence integrity, surviving sealed descriptors, and client SnapshotRequired/resnapshot after a private restart. Exercise the production Btrfs delta apply/fence code with the owned fake-checkpoint test fixture; label real Btrfs mount support separately. Retain actual source/binary hashes and commands, refresh architecture/plan/CHANGELOG, and gather final native interface/packaging gates. The installed developer day uses one build-set, real Home/project/churn/download/PCMan renames/NTFS unplug-return/logout-login/FSearch/Silvaview and doctor. It is owner-run, with no agent live-session changes. Never delete the WP8 oracle or claim installed/physical closure without those observations.
        """
    note "The original WP14 shell notice acceptance refers to a retired ordinary native Files route. Clarification is pending; WP16 still depends on its acceptance. Owned software/nested observations do not satisfy installed or physical HDMI gates."
    acceptance {
        check closure-gates-and-docs {
            statement """
                Final native regressions, interface and packaging gates pass, with current architecture/plan/CHANGELOG and an auditable coherent package set prepared for owner validation.
                """
            method command
        }
        check owned-crash-journeys {
            statement """
                Owned scan commit, partial snapshot and Btrfs delta process-crash journeys retain whole committed generations; private restarted clients resnapshot instead of accepting old cursors. Any fake filesystem/checkpoint boundaries are stated explicitly.
                """
            method command
            command "scripts/test-index-crashes.sh"
        }
        check owner-installed-developer-day {
            statement """
                The owner records one coherent installed build-set developer day over real Home/project, cargo churn, downloads, external PCManFM renames, second NTFS volume unplug-return, logout-login/filed restart and shared FSearch/Silvaview warm launch with doctor/churn output.
                """
            method manual
        }
    }
    part_of [ @legeos.work.shared-incremental-file-index/3 ]
    author "dk"
}

