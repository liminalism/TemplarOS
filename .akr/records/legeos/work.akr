akr 0.1
project legeos

record legeos.work.action-manifest-one-declaration-three-surfaces/1 : work {
    title "Declare every user-facing action once, and generate the menu, the cheat sheet and the CLI verb from it"
    state proposed
    scope [
        path "cli/lege/**",
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-types/**",
        path "shell/**"
    ]
    intent """
        LegeOS already commits to every capability being reachable from the CLI, the portal, the shell and Settings (M1 evidence m1-clients-reachable; docs/architecture/accessibility.md: "everything the shell shows is available through lege too"). Today that is a discipline maintained by hand across four implementations, and nothing prevents them drifting. Omarchy demonstrates the mechanism that makes it structural: one declaration — `o.bind(chord, human_label, action)` — is simultaneously the keybinding, the row in a mouse-navigable menu tree, and the entry in a cheat sheet generated from the same table, so the documentation cannot fall out of date with the behaviour because it is not a separate artefact. Adopt the pattern: an action manifest (id, human label, optional chord, CLI verb, availability predicate) living in a service crate rather than the shell, with the shell's menu, the discoverability surface and `lege`'s subcommand table all rendered from it. The manifest belonging to a service rather than the shell is what keeps it consistent with services-not-indicators: the shell renders the manifest, it does not own it.
        """
    note """
        Not M2. What can happen during M2 is that the dock and Home Surface are built to read rows from a declaration rather than hard-coding them, because retrofitting that later is much more expensive than designing it in — so the cost of deferring the manifest is low only if M2's shell surfaces are written data-driven from the start.

        The keyboard layer is strictly additive, and this is a decision, not an accident of scheduling. Every action must have a mouse or menu path that is not second-class — not a smaller target, not fewer capabilities, not discoverable only by first reading a shortcut list. A chord is an accelerator recorded alongside the menu entry in the same manifest, never the only route to a capability. Omarchy's own navigation manual claims "EVERYTHING happens via the keyboard", and its top-bar manual, documenting full click-and-scroll parity on every widget, contradicts it: read carefully, Omarchy is keyboard-primary with first-class mouse parity, which is the position worth copying rather than the slogan. This is consistent with LegeOS's existing accessibility invariants rather than a change to them.

        See docs/research/omarchy-review.md §3.1 and §5.
        """
    depends_on [ @legeos.constraint.services-not-indicators ]
    source {
        kind internal
        role rationale
        path "docs/research/omarchy-review.md"
        use """
            The study this came from, including the verification pass that corrects three of its own claims against source.
            """
    }
}

record legeos.work.compositor-window-authority/1 : work {
    title "The compositor's window authority: typed layers, one scene, explicit minimisation, recovery without the shell"
    state completed
    scope [ path "compositor/**", path "crates/lege-window/**", path "interfaces/wayland/**" ]
    intent """
        Make lege-window the thing that decides stacking and geometry rather than a set of helpers: typed overlay layers as a total order with rules about which client may claim which layer; the one-workspace invariant as a type-level property, with deterministic migration when an output is removed and validation of restored geometry against the current topology; explicit minimisation to a Window Shelf that is always restorable to a recoverable geometry; a compositor-owned recovery band, a show-all-windows scatter and an escape route out of fullscreen that all work when the shell is dead; drag anchors held in one global logical coordinate space across mixed-scale outputs; window commands gated on activation grants with recent-input evidence; and property tests over generated multi-output topologies. lege-comp-integration keeps the render thread off D-Bus, hardens the identity cache against PID reuse, and tells the governor which instance the user is looking at.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.consumers-cli-portal-shell/1 : work {
    title "The clients: the CLI over the whole OS, one portal backend, the Home Surface model, Settings"
    state completed
    scope [
        path "apps/lege-settings/**",
        path "cli/lege/**",
        path "crates/lege-client/src/sdk.rs",
        path "portals/**",
        path "shell/**"
    ]
    intent """
        Make the services reachable: lege as one command line over identity, launching, associations with an explanation, files and operations, resources, history with undo, providers, settings, projects, power and updates; xdg-desktop-portal-lege as the single backend implementing FileChooser over the shared last-directory answer, OpenURI and AppChooser over the association broker, Settings and Background over providers and autostart, so a sandboxed application and a normal one behave the same; the Home Surface as a data model over the services (drawers, dock grouping by canonical AppId, the window shelf, the operations drawer) rendered without a toolkit for now; and lege-settings as pages that map one-to-one onto D-Bus interfaces, with nothing a private implementation detail. Everything the shell shows must be available through lege as well.
        """
    after [
        @legeos.work.compositor-window-authority,
        @legeos.work.governor-containment,
        @legeos.work.host-update-transaction,
        @legeos.work.sessiond-persistence-and-launch
    ]
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.filed-transactions/1 : work {
    title "The file service: journalled transactions, trash, storage reserve, recents, search"
    state completed
    scope [
        path "crates/lege-client/src/proxies/files.rs",
        path "crates/lege-state/src/migrations/files.rs",
        path "interfaces/dbus/org.legeos.Files.*.xml",
        path "services/lege-filed/**"
    ]
    intent """
        Make lege-filed the owner of file state rather than the file manager: survey/plan split so conflict and ordering rules are testable without a filesystem; idempotent journalled steps (copy to a temporary in the destination directory, flush file and directory entry, verify by size or CRC-32 read-back, expose atomically, delete the source last) with resume-after-crash; same-device moves as one rename; conflict policy decided once at plan time; undo planned at commit time for rename, move and trash while delete stays irreversible; the freedesktop trash with the per-volume fallback; volumes, the mount table and the reserve kept for logging in, updating and recovering; recents and the one shared last-directory answer; a name-and-metadata search index with saved queries; and the path actions that are otherwise a service menu.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.governor-containment/1 : work {
    title "The resource governor: a served interface, applied protection, a staged containment ladder and recorded traces"
    state completed
    scope [
        path "distro/policy/**",
        path "interfaces/dbus/org.legeos.Resources1.xml",
        path "services/lege-resourced/**"
    ]
    intent """
        Give lege-resourced everything it needs to act without giving it the ability to act prematurely: serve org.legeos.Resources1 on a task separate from the sampling loop; populate the managed-instance map from the app.slice scan so an action can reach a real cgroup at all; apply memory.oom.group to application cgroups and a modest memory.low to session-critical units (never memory.min, whose hard protection can itself force OOM); implement the observe-only → trim → throttle → checkpoint → terminate ladder, defaulting to observe-only, with an action above the current stage decided, logged and signalled as unapplied; record bounded JSONL traces complete enough for a human to review a decision before enabling enforcement; return a victim-score breakdown so the choice is explainable; distinguish storage, GPU-reset and kernel-lockup stalls from application memory pressure rather than blaming an application; and keep SQLite and fsync off the loop entirely.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.home-field/1 : work {
    title "Home Field — the desktop surface: tiles, parked sessions, go-home, stable grid, projects, trays, previews"
    state proposed
    scope [
        path "compositor/**",
        path "crates/lege-field/**",
        path "crates/lege-session-core/**",
        path "crates/lege-treemap/**",
        path "crates/lege-window/**",
        path "interfaces/**",
        path "services/lege-sessiond/**",
        path "shell/**"
    ]
    intent """
        Replace the drawer-list Home Surface with the Home Field: a bounded field of rectangular tiles (projects, apps / parked sessions, file trays, widgets, system) on the shell's Layer::HomeSurface backdrop. Windows collapse into tiles instead of minimising and expand back out; Super+D / Ctrl+Alt+H / a dock Home button reveal the field temporarily without changing any window's state; dragging a tile onto a target performs a typed, previewed, undoable operation; layout is a stable local grid that never reflows globally, persisted per output by sessiond (org.legeos.HomeField1). Phases: 1 compositor truths (shelved windows actually hidden and not hit-tested, maximize, reveal-home command + keybindings + protocol v2 with identifier/geometry), 2 the pure crates/lege-field model (document, ops with inverses, local reflow, representation ladder, drag/throw state machine), 3 FieldScreen in lege-shell with --print field and full keyboard reach — the named Windows-8 fallback checkpoint — then 4 HomeField1 persistence, 5 projects/trays/zoom, 6 previews over ext-image-copy-capture, 7 lege-treemap (lifted from Silvaview-rs) and budgeted widgets, 8 the throw spike with a keep/delete rule. Plan of record: ~/.claude/plans/for-this-project-i-crispy-shannon.md (author's machine).
        """
    note """
        Decisions taken with the author on 2026-08-22: Super+D is a temporary reveal, not park-all; one field document per output, primary output first; LegeOS and Silvaview-rs relicensed AGPL-3.0-only (D13) so lege-treemap can be lifted. Reveal state is a view flag in WindowService; one lege-field crate is the single model for shell and sessiond, Ctrl+Z is HomeField1.Undo.
        """
    acceptance {
        check field-in-text {
            statement """
                lege-shell --print field lists exactly the tiles the graphical field draws, one line per tile.
                """
            method command
            command "cargo test -p lege-shell print_field"
        }
        check field-is-keyboard-complete {
            statement """
                Every Home Field action reachable by pointer is reachable by keyboard alone (arrows, Enter, Space, Escape, Ctrl+Z).
                """
            method command
            command "cargo test -p lege-shell field_keyboard"
        }
        check home-is-always-reachable {
            statement """
                Ctrl+Alt+H, Super+D and the dock's Home cell each reveal the Home Surface with every client window hidden; Escape, pressing again, or activating a window brings the exact prior stack back.
                """
            method manual
        }
        check layout-is-stable {
            statement """
                Content, title, state or count changes move zero tiles; an insert displaces only tiles in the affected row, column or container; every field op's inverse restores the document exactly.
                """
            method command
            command "cargo test -p lege-field"
        }
        check maximize-fills-work-area {
            statement """
                Maximizing fills exactly one output's usable area (never the dock's exclusive zone) and is recoverable for any topology; unmaximize restores the floating geometry.
                """
            method command
            command "cargo test -p lege-window maximize"
        }
        check no-new-toolkit-api {
            statement """
                just check passes with ../pixelkit unmodified; the Home Field needed no pixelkit API change.
                """
            method command
            command "just check"
        }
        check reveal-survives-shell-death {
            statement """
                Killing lege-shell while a reveal is in effect ends the reveal: every window reappears without user action.
                """
            method manual
        }
        check shelved-is-hidden {
            statement """
                A shelved (minimised) window is unmapped from the compositor's Space: it neither renders nor receives pointer input, and its recovery band is not painted; unshelving restores it at its repaired geometry.
                """
            method command
            command "cargo test -p lege-window -p lege-comp shelving_hides_and_unshelving_shows"
        }
        check windows-cannot-be-lost {
            statement """
                No sequence of shelve, reveal-home, activate or maximize leaves a window neither visible nor unshelvable; show-every-window unshelves everything; a reveal changes no window record.
                """
            method command
            command "cargo test -p lege-window hidden_windows_are_explained_by_shelf_or_reveal_alone show_all_windows_unshelves_everything_and_ends_a_reveal a_reveal_changes_no_window_and_ends_on_activate"
        }
    }
    depends_on [ @legeos.decision.agplv3-own-code, @legeos.decision.compositor-on-smithay ]
    implements [
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
}

record legeos.work.host-update-transaction/1 : work {
    title "The host daemon: kernel and driver as one resumable transaction, two boot backends, enforced polkit"
    state completed
    scope [
        path "crates/lege-hwdetect/**",
        path "distro/deploy/**",
        path "interfaces/dbus/org.legeos.Host.*.xml",
        path "packaging/**",
        path "services/lege-boot-health/**",
        path "services/lege-hostd/**"
    ]
    intent """
        Make lege-hostd able to promote or roll back a kernel and its NVIDIA modules as a pair: the Planned → Downloading → Staging → Verifying → AwaitingReboot → Trial → Promoted|RolledBack|Failed state machine over a durable journal that resumes mid-apt after a restart, with apt run as a child transient unit; a BootManager trait with working systemd-boot and grub backends so ADR-0004's undecided Secure-Boot posture stays a configuration choice rather than a hardcoding; one driver authority that selects a single flavour from detected hardware, verifies the version lock and detects support violations; the storage reserve and its trim order; polkit authorisation checked in the daemon on every privileged method, with the policy and an AppArmor profile shipped; and a lege-boot-health that can actually fail, since it gates boot-complete.target with FailureAction=reboot-force.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.sessiond-persistence-and-launch/1 : work {
    title "The session daemon: one state store, StartTransientUnit launching, desktop-entry import, the full domain surface"
    state completed
    scope [
        path "crates/lege-appd/**",
        path "crates/lege-associationd/**",
        path "crates/lege-session-core/**",
        path "crates/lege-state/src/migrations/session.rs",
        path "services/lege-sessiond/**"
    ]
    intent """
        Wire lege-sessiond to the one state store so every domain survives a restart (associations, provider selections and declarations, autostart approvals, settings values and their change log, projects, history, live instances re-derived from ListUnitsByPatterns app-legeos-*); replace the systemd-run launcher with a direct StartTransientUnit D-Bus transaction so launch and unit registration are one step and the documented registration race disappears; derive manifests from installed desktop entries with Exec field codes parsed into an argument vector; detect MIME types from shared-mime-info globs and bounded content sniffing so a detected type genuinely beats an extension; and serve the remaining domains — the full Associations surface with Explain, Settings, History with Undo, Providers, Projects, Power, Location, and org.freedesktop.Notifications recorded as history events — plus the autostart runner, the checkpoint relay and coredump ingestion.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}
