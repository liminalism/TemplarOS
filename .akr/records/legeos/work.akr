record legeos.work.super-press-hold-home-reveal/1 : work {
    title "Super reveals Home on press, stays momentary while held, and keeps chords fast"
    state completed
    scope [
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-types/src/action.rs",
        path "crates/lege-window/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Refine the existing release-only bare-Super toggle into two compatible modes. Super key-down reveals Home immediately. While either Super key remains held, Home stays visible as a momentary surface. Releasing after a hold returns to the exact prior application/Home state; a short unmodified tap retains the convenient latched toggle. Pressing another key while Super is held performs the declared accelerator and resolves the momentary reveal without also toggling Home on release. Two Super keys behave as one logical hold.

        This remains compositor-owned so Home is reachable and the gesture terminates safely if the shell dies. Ctrl+Alt+H and Super+D remain fallbacks. The interaction changes no window geometry, activation, shelving or arrangement state.
        """
    acceptance {
        check chord-does-not-toggle {
            statement """
                Every declared Super chord performs only its action; release never additionally latches Home, and chord handling safely ends the momentary reveal.
                """
            method command
            command "cargo test -p lege-comp keybindings::tests::super_chord"
            verified_by [ @legeos.evidence.super-press-hold-20260831/1 ]
        }
        check no-window-mutation {
            statement """
                Momentary and latched Home reveal change no window geometry, activation, fullscreen, maximize or shelf state.
                """
            method command
            command "cargo test -p lege-window commands::tests::a_reveal_changes_no_window"
            verified_by [ @legeos.evidence.super-press-hold-20260831/1 ]
        }
        check press-and-hold {
            statement """
                Home becomes revealed on Super key-down, remains revealed while either Super key is held, and a held release restores the exact preceding reveal state.
                """
            method command
            command "cargo test -p lege-comp keybindings::tests::super"
            verified_by [ @legeos.evidence.super-press-hold-20260831/1 ]
        }
        check tap-still-latches {
            statement """
                A short bare-Super tap toggles the latched Home state without a second toggle on key release.
                """
            method command
            command "cargo test -p lege-comp keybindings::tests::bare_super"
            verified_by [ @legeos.evidence.super-press-hold-20260831/1 ]
        }
    }
    derived_from [ @legeos.work.home-input-and-refinement ]
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.trash-that-can-be-seen-and-emptied/1 : work {
    title "Files.Trash1 — see what is in the trash, put an item back, and empty it"
    state completed
    scope [
        path "apps/lege-files/**",
        path "cli/lege/**",
        path "crates/lege-client/**",
        path "interfaces/dbus/**",
        path "services/lege-filed/**",
        path "shell/lege-shell/**"
    ]
    intent """
        The trash cannot be looked at. trash::list is implemented and freedesktop-correct — it parses .trashinfo, handles the per-volume .Trash-$uid, sorts newest first (services/lege-filed/src/trash.rs:198) — and is called from exactly one place in the repository: a test. No D-Bus interface exposes it, so the shell's Trash drawer renders the operations journal filtered to trash and restore, and says so honestly in its own empty state; its header comment names Files.Trash1 as the interface it wants (shell/lege-shell/src/drawers/trash.rs:1-15). There is no empty-trash anywhere — no method, no verb, no control — and no explicit restore action in the Files app, which has Trash and Undo but no Restore. Permanent delete is modelled and executable and no UI ever constructs it.

        Design settled by the audit. Trash1 gets one read method, List, which is the thing Operations1 genuinely cannot answer and which must sweep every trash this user has — the home trash and each mounted volume's — not just the one. Restore, DeletePermanently and Empty are thin validating wrappers over the same FileService::start that Operations1.Start uses, so a large empty keeps its progress, its journal and its crash-resume, and a restore keeps its undo, instead of growing a second execution path with a different story. Empty sweeps server-side rather than making a client list-then-delete, which would race. A Changed signal, emitted from the single place operations complete, keeps the drawer and the Files app live whichever client did the mutating.

        Order: interface, service and proxy together (check-interfaces and check-proxies only go green as a set), then the CLI verbs, then the shell drawer's real listing, then the Files app's trash place last — that one is the largest piece, because it means teaching a directory browser to render a listing that is not a directory, with different columns, different actions and a confirmation rule of its own. The Files app is the cut line if budget runs short; the CLI gives a working path meanwhile.

        The undo defect this area also carried is already fixed at git:464e069b7b2769bc5e0ab34e8191b65f9101e7db and is not part of this item.
        """
    note """
        Rank 4. The backend capability already exists and is spec-correct; what is missing is the wire and the three surfaces over it.
        """
    derived_from [
        @legeos.assessment.home-field-usability-gaps-20260831,
        @legeos.observation.trash-undo-reported-a-restore-it-did-not-perform
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
}

record legeos.work.wayland-clipboard-and-dnd-transport/1 : work {
    title "Bind wl_data_device so Home's clipboard and drags reach other applications"
    state completed
    scope [ path "shell/lege-shell/**" ]
    intent """
        The file-operations work left everything above the transport complete and tested: lege_types::uri_list encodes and decodes RFC 2483 text/uri-list (CRLF, reserved characters, non-UTF-8 names, foreign hosts skipped), and shell/lege-shell/src/clipboard.rs produces both text/uri-list and x-special/gnome-copied-files so a cut survives the trip, reading a bare uri-list as a copy and never a cut. What is missing is the handover: the shell's compositor connection is the private lege_shell_v1 protocol with no wl_data_device_manager bound and no seat to own a selection on, so a copy in Home pastes in Home and not yet in another application, and a drag cannot leave the shell. Both stopping points are documented in code (ShellApp::publish_clipboard, FieldScreen::dragged_uri_list). Bind the ordinary Wayland globals beside the private protocol (the shell is a normal client of the public socket too), own the seat selection with the two prepared payloads, accept offers on paste, and wire drag-out as a data source carrying the exported uri-list.
        """
    note """
        Split out of @legeos.work.file-operations-from-home at completion so the boundary is a recorded plan rather than a silent gap. Also open from that work: Home's Rename verb points at the Files app because the Home surface has no name-entry dialogue yet.
        """
    derived_from [ @legeos.work.file-operations-from-home ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.window-controls-and-mouse-parity/1 : work {
    title "Window close and resize, and a pointer path for every action that today has only a chord"
    state completed
    scope [
        path "compositor/lege-comp/src/input.rs",
        path "compositor/lege-comp/src/xdg_shell.rs",
        path "crates/lege-window/**",
        path "shell/lege-shell/src/surface/field_screen.rs",
        path "shell/lege-shell/src/wayland_bridge.rs"
    ]
    intent """
        Give the user a way to close and resize a window, and give every declared action a mouse route. `window.close` is declared in the action manifest and reachable from nothing: lege_shell_toplevel_v1.close exists in the protocol and ShellBridge::close exists in the shell with zero callers, so a window with no client-side decorations — most XWayland clients, xterm, SDL applications — cannot be closed by the user at all. Interactive resize is a deliberate no-op in xdg_shell.rs::resize_request, and decoration mode is forced to ClientSide unconditionally, so such a window can never be resized either. Separately, thirteen declared actions are reachable only by keyboard; the action manifest's own rule is that a chord is an accelerator recorded alongside a menu entry and never the only route to a capability, so those need a pointer or menu path.
        """
    note """
        STATUS FOR A HANDOFF: implemented, tested and lint-clean; see @legeos.evidence.window-controls-20260825. All four steps landed, including interactive resize. check-actions now enforces the pointer-route rule: a declared action with a chord and no pointer route in shell/lege-shell/src (needles: FieldAction::RunAction, WidgetRegion::new, MenuItem::new; test modules excluded) fails the build; exemptions are (id, reason) pairs that self-expire when stale, and the list is empty. window.close goes through a new secondary-click context menu with a two-step confirm per its confirm:true. Interactive resize works on both routes: xdg_toplevel.resize / X11 _NET_WM_MOVERESIZE for clients with frames, and a painted compositor-owned bottom-right grip for no-CSD windows; minimum window size is derived so a minimum-size window still has both a grabbable band and a grip. Decoration forcing is untouched — no server-side decorations were built; band+grip is what makes a no-CSD window manageable. A latent grab bug was fixed along the way: band grabs are now primary-button-only (a right-press previously installed a grab only a left release could end).

        The one outstanding check is hands-on at a real desktop, same as the foundations record; complete this after that run.

        FOR A SUCCESSOR: (1) window.maximize is not in the manifest and ShellBridge::set_maximized is still uncalled — closing that is one declaration, one MenuScope::Window row and one perform_on_window arm. (2) The close confirm UI lives in the shell by design, so a no-CSD window cannot be closed while the shell is dead — only moved, resized and escaped. (3) begin_resize refuses maximized windows (their geometry is re-derived on every topology change); unmaximize first. (4) The shell's cycle order is window_id, the compositor's is stacking order — same set, different order, only one route in use at a time. (5) Menu cycle/group entries are computed shell-side reusing lege_window::geometry::contiguous_window, so the group rule has one implementation.
        """
    part_of [ @legeos.work.home-widgets ]
    verified_by [ @legeos.evidence.window-controls-20260825 ]
}

record legeos.work.window-groups/1 : work {
    title "Window groups — one unit of work: grouped windows park, return, stack and drag together, placed beside and outlined; Alt+Tab inside, Super+Tab across"
    state superseded
    scope [
        path "compositor/lege-comp/**",
        path "crates/lege-client/**",
        path "crates/lege-field/**",
        path "crates/lege-window/**",
        path "interfaces/wayland/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Implement @legeos.decision.window-groups-are-explicit-and-compositor-owned in four steps then a hands-on: WG1 the model in lege-window (GroupId, membership on WindowRecord, group/ungroup/dissolve, raise_many and group-contiguous activate, shelve/unshelve/move_group, place_beside, group_outline, accent palette, cycle_within_group and cycle_groups, group on ShellToplevel, new WindowCommands, property tests; the Super+Left/Right step renamed window.step-right/left); WG2 the compositor (Alt+Tab within group, Super+Tab across groups, Super+G group-with-previous placing beside, Super+Shift+G ungroup, HUDs, band accent stripe and name, group outline as per-window chrome, band-on-band drop groups and places beside with a drop highlight, band drag moves the group and Shift+drag one member, COMPOSITOR.md rows); WG3 lege_shell_v1 toplevel v3 / manager v5 (declared at 9d8e3f6; compositor and shell each raise SHELL_PROTOCOL_VERSION to 5; group event into ShellToplevel.group; join/leave/activate/shelve/unshelve/name requests); WG4 the Home tile (TileKind::WindowGroup container of ParkedSession tiles, merge_sessions placement and sweep, drop-to-group and drag-out gestures, container drag as one, title press activates the group, Park shelves the group, ladder rungs, accent edge, visual baseline); WG5 the user's hands-on acceptance.
        """
    note """
        Plan text: docs/planning/window-groups-and-application-integration.md §2–3, revised 2026-09-03 at ea9810e after the user's reading. Implementation started 2026-09-03 in two parallel lanes: model+compositor (WG1, WG3 compositor half, WG2, and the terminal chord's compositor half) and shell+Home tile (WG3 shell half, WG4). No Ctrl+Tab binding exists.
        """
    after [ @legeos.work.hands-on-run-4-fixes ]
    implements [ @legeos.decision.window-groups-are-explicit-and-compositor-owned ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.window-groups/2 : work {
    title "Window groups — one unit of work: grouped windows park, return, stack and drag together, placed beside and outlined; Alt+Tab inside, Super+Tab across"
    state active
    scope [
        path "compositor/lege-comp/**",
        path "crates/lege-client/**",
        path "crates/lege-field/**",
        path "crates/lege-window/**",
        path "interfaces/wayland/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Implement @legeos.decision.window-groups-are-explicit-and-compositor-owned in four steps then a hands-on: WG1 the model in lege-window (GroupId, membership on WindowRecord, group/ungroup/dissolve, raise_many and group-contiguous activate, shelve/unshelve/move_group, place_beside, group_outline, accent palette, cycle_within_group and cycle_groups, group on ShellToplevel, new WindowCommands, property tests; the Super+Left/Right step renamed window.step-right/left); WG2 the compositor (Alt+Tab within group, Super+Tab across groups, Super+G group-with-previous placing beside, Super+Shift+G ungroup, HUDs, band accent stripe and name, group outline as per-window chrome, band-on-band drop groups and places beside with a drop highlight, band drag moves the group and Shift+drag one member, COMPOSITOR.md rows); WG3 lege_shell_v1 toplevel v3 / manager v5 (both ends at SHELL_PROTOCOL_VERSION 5; group event into ShellToplevel.group; join/leave/activate/shelve/unshelve/name requests); WG4 the Home tile (TileKind::WindowGroup container of ParkedSession tiles, merge_sessions placement and sweep, drop-to-group and drag-out gestures, container drag as one, title press activates the group, Park shelves the group, ladder rungs, accent edge, visual baseline); WG5 the user's hands-on acceptance.
        """
    note """
        Plan text: docs/planning/window-groups-and-application-integration.md §2–3 (ea9810e). WG1–WG4 landed 2026-09-03 and merged at 6b354c5 (two lanes: model+compositor, shell+Home tile). Known deviations recorded there: place_beside picks the side by direction with the plan's order as tie-break and can overlap only when no side has room; group(a,b) with only b grouped joins a to b's group; join_group/leave_group are compositor-only from Home, the tile follows on the next sync; rename is a small panel. Still owed: a pointer route for moving between groups (check-actions exemptions window.group-cycle-forward/backward). Everything on screen and under the pointer awaits WG5.
        """
    acceptance {
        check gates-green {
            statement """
                The full repository gate passes at the merged integration branch with WG1–WG4 in.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.window-groups-gate-20260903/1 ]
        }
        check hands-on-groups {
            statement """
                At the installed desktop: dropping one band on another lands the dropped window beside the target with one outline around both; Alt+Tab stays inside and Super+Tab crosses; a band drag moves both and Shift+drag one; the group parks and returns from Home as one tile; closing one of two dissolves it; Ctrl+Tab still reaches the browser's tabs.
                """
            method manual
        }
        check home-tile {
            statement """
                A grouped window's session tile lives inside its group tile, a leaving window's tile moves out, an empty group tile is swept, and the drop, drag-out, title, Park and rename gestures send the matching group requests.
                """
            method command
            command "cargo test -p lege-shell -p lege-field"
            verified_by [ @legeos.evidence.window-groups-home-tile-20260903/1 ]
        }
        check model-properties {
            statement """
                Raising never changes geometry; membership survives shelve, maximize, arrangement and output change; no window is in two groups; a live group has two or more members; every member stays recoverable after place_beside and move_group; place_beside never overlaps the target when a side has room.
                """
            method command
            command "cargo test -p lege-window"
            verified_by [ @legeos.evidence.window-groups-model-and-compositor-20260903/1 ]
        }
    }
    after [ @legeos.work.hands-on-run-4-fixes ]
    implements [ @legeos.decision.window-groups-are-explicit-and-compositor-owned ]
    part_of [ @legeos.work.home-surface-usability-next ]
    supersedes [ @legeos.work.window-groups/1 ]
}

record legeos.work.window-groups-compositor/1 : work {
    title "WG2 — the compositor: Alt+Tab inside, Super+Tab across, Super+G places beside, band-on-band drop, group outline and stripe, group drag, HUDs, the Super+grave terminal toggle"
    state completed
    scope [ path "compositor/lege-comp/**", path "crates/lege-types/src/action.rs" ]
    intent """
        CycleFocusForward/Backward become within-group; new GroupCycleForward/Backward on Super+Tab and Super+Shift+Tab (no Ctrl+Tab, no setting); Super+G groups the focused window with the previously focused one and places it beside, Super+Shift+G ungroups; the switcher HUD lists the group's members under its name and the group HUD lists groups with counts and the loose set as Other windows; grouped bands carry a 4 px accent stripe and the group name; the compositor draws a 2 px accent outline around the union of the members' rectangles as per-window chrome in stacking order; releasing a band drag over another window's band groups them and places the dropped window beside the target, with the hovered band highlighted; a band drag moves the whole group and Shift+drag moves one member; the existing Super+Left/Right spatial step is renamed window.step-right/left; COMPOSITOR.md rows. Also the compositor half of the drop-down terminal: Super+grave toggles the most recently activated window of the app id received by set_terminal (unshelve/activate, or shelve and refocus the previous window when it is focused; never close), and sends terminal_requested when none exists.
        """
    depends_on [ @legeos.work.window-groups-model ]
    implements [ @legeos.decision.window-groups-are-explicit-and-compositor-owned ]
    part_of [ @legeos.work.window-groups ]
}

record legeos.work.window-groups-home-tile/1 : work {
    title "WG4 — the Home tile: TileKind::WindowGroup container of session tiles with the group's accent edge, dragged as one, drop-to-group and drag-out, ladder rungs, cheat-sheet rows"
    state completed
    scope [ path "crates/lege-field/**", path "shell/lege-shell/**" ]
    intent """
        lege-field: TileKind::WindowGroup { identifier } as a top-level container of ParkedSession tiles, every existing invariant property unmodified. Shell field model: a grouped window's session tile lives inside its group tile, created at the first member's place; a leaving window's tile moves out to the nearest free cell; an empty group tile is swept like an orphaned session tile; the tile's hairline edge is the group's accent. Gestures: session tile dropped on a session tile joins; dragged out of the group tile onto the field leaves; the group tile drags as one container; its title press activates the group; Park shelves the group; rename names it. Rungs: Micro count badge, Small name and count, Wide name and member titles, Large member previews, Full the project zoom. Cheat sheet rows for Alt+Tab, Super+Tab, Super+G, Super+Shift+G and band-on-band drop. Visual baseline gains a two-member group tile.
        """
    depends_on [ @legeos.work.window-groups-protocol ]
    implements [ @legeos.decision.window-groups-are-explicit-and-compositor-owned ]
    part_of [ @legeos.work.window-groups ]
}

record legeos.work.window-groups-model/1 : work {
    title "WG1 — the group model in lege-window: membership, contiguous raise, group shelve/move, place_beside, outline, accent palette, within-group and across-group cycling, commands"
    state completed
    scope [ path "crates/lege-window/**" ]
    intent """
        GroupId, WindowRecord.group, GroupRecord {name, accent, last_active}; group(a,b) joining/creating/merging with a's identity surviving, ungroup, dissolution below two members and on destroy; activate raises the whole group contiguously (raise_many), geometry never changes; shelve_group/unshelve_group with one shelf_rank; move_group by the anchor's displacement repaired per member; place_beside(window, target) choosing the nearest free side (right, left, below, above) edge to edge, repaired; group_outline as the union of unshelved members' rectangles; accent from a six-entry palette by group id; cycle_within_group and cycle_groups (last_active member per group, the loose set as one group); ShellToplevel.group filled; WindowCommands Group, Ungroup, ActivateGroup, ShelveGroup, UnshelveGroup, SetGroupName; RecoveryAction GroupNext/Previous and manifest ids window.group-next/previous renamed StepRight/Left and window.step-right/left. Properties: raising never changes geometry; membership survives shelve, maximize, arrangement and output change; no window in two groups; a live group has two or more members; is_recoverable holds after place_beside and move_group; place_beside never overlaps the target.
        """
    implements [ @legeos.decision.window-groups-are-explicit-and-compositor-owned ]
    part_of [ @legeos.work.window-groups ]
}

record legeos.work.window-groups-protocol/1 : work {
    title "WG3 — lege_shell_v1 toplevel v3 and manager v5: the group event and the join/leave/activate/shelve/unshelve/name requests; set_terminal, terminal_requested, group_cycle_binding; both ends raised to 5"
    state completed
    scope [
        path "compositor/lege-comp/src/protocols_shell.rs",
        path "crates/lege-client/**",
        path "interfaces/baseline.json",
        path "interfaces/wayland/**",
        path "shell/lege-shell/src/wayland_bridge.rs"
    ]
    intent """
        Declared at 9d8e3f6 in interfaces/wayland/lege-shell-v1.xml, additions only: lege_shell_toplevel_v1 version 3 gains the group event (group_id 0 = none, name, accent 0x00RRGGBB) and join_group(other), leave_group, activate_group(token), shelve_group, unshelve_group, set_group_name; lege_shell_manager_v1 version 5 gains set_terminal(app_id), terminal_requested and group_cycle_binding. lege_window::GroupInfo and ShellToplevel.group exist (2919925). Remaining: the compositor raises SHELL_PROTOCOL_VERSION to 5, sends group after identity and on change, implements the requests; the shell raises its constant to 5, maps the event into ShellToplevel.group and exposes the requests guarded by the bound version; the greeter is unaffected (it speaks the manager only).
        """
    depends_on [ @legeos.work.window-groups-model ]
    implements [ @legeos.decision.window-groups-are-explicit-and-compositor-owned ]
    part_of [ @legeos.work.window-groups ]
}
