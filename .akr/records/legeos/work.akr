akr 0.1
project legeos

record legeos.work.accessibility-claimed-but-not-built/1 : work {
    title "Either build the AT-SPI bridge and the high-contrast variant, or stop documenting them as shipped"
    state completed
    scope [
        path "distro/seeds/**",
        path "docs/architecture/accessibility.md",
        path "shell/lege-shell/**"
    ]
    intent """
        docs/architecture/accessibility.md states that AT-SPI and Orca ship, and that every shell surface has a high-contrast variant. Neither is true in code. No Cargo.toml in the workspace depends on atspi; no accessible-object tree is registered and no a11y bus is spoken anywhere in shell/lege-shell or crates/. No high-contrast token, theme or setting exists in the shell. distro/seeds/a11y.seed really does install orca, at-spi2-core and speech-dispatcher — which is what makes this worse than a plain omission: a blind user can install LegeOS, start Orca, and meet a desktop that says nothing, because the shell paints itself with a custom rasterizer and exposes no name, role or state for any tile, drawer row or widget region. A toolkit would have carried the bridge; painting everything means owning it.

        What is real: the focus ring is a genuine distinct indicator, reduced motion is a respected setting, and the field is deliberately keyboard-complete with pointer parity enforced by a gate. Those are the foundations; they are not a screen reader.

        Two defensible outcomes and one indefensible one. Build the bridge; or correct the documentation and the seed to say plainly that assistive-technology support is not yet implemented. What must not persist is the current state, where the docs assert a capability a user could depend on and be stranded by. Correcting the documentation costs almost nothing and should not wait for the implementation — that part is separable and worth doing first, whatever is decided about the rest.
        """
    note """
        Ranked fifth for daily-work cost, but the false documentation is a defect independent of that ranking and is cheap to fix on its own.
        """
    derived_from [ @legeos.assessment.home-field-usability-gaps-20260831 ]
    part_of [ @legeos.milestone.m2-session-runs ]
}

record legeos.work.action-manifest-one-declaration-three-surfaces/1 : work {
    title "Declare every user-facing action once, and generate the menu, the cheat sheet and the CLI verb from it"
    state completed
    scope [
        path "cli/lege/**",
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-types/**",
        path "shell/**"
    ]
    intent """
        LegeOS already commits to every capability being reachable from the CLI, the portal, the shell and Settings (M1 evidence m1-clients-reachable; docs/architecture/accessibility.md: "everything the shell shows is available through lege too"). Today that is a discipline maintained by hand across four implementations, and nothing prevents them drifting. Omarchy demonstrates the mechanism that makes it structural: one declaration — `o.bind(chord, human_label, action)` — is simultaneously the keybinding, the row in a mouse-navigable menu tree, and the entry in a cheat sheet generated from the same table, so the documentation cannot fall out of date with the behaviour because it is not a separate artefact. Adopt the pattern: an action manifest (id, human label, optional chord, CLI verb, availability predicate) living in a service crate rather than the shell, with the shell's menu, the discoverability surface and `lege`'s subcommand table all rendered from it. The manifest belonging to a service rather than the shell is what keeps it consistent with services-not-indicators: the shell renders the manifest, it does not own it.
        """
    note """
        Not M2. What can happen during M2 is that the Home Surface and its information/action rows are built to read rows from a declaration rather than hard-coding them, because retrofitting that later is much more expensive than designing it in — so the cost of deferring the manifest is low only if M2's shell surfaces are written data-driven from the start.

        The keyboard layer is strictly additive, and this is a decision, not an accident of scheduling. Every action must have a mouse or menu path that is not second-class — not a smaller target, not fewer capabilities, not discoverable only by first reading a shortcut list. A chord is an accelerator recorded alongside the menu entry in the same manifest, never the only route to a capability. Omarchy's own navigation manual claims "EVERYTHING happens via the keyboard", and its top-bar manual, documenting full click-and-scroll parity on every widget, contradicts it: read carefully, Omarchy is keyboard-primary with first-class mouse parity, which is the position worth copying rather than the slogan. This is consistent with LegeOS's existing accessibility invariants rather than a change to them.

        See docs/research/omarchy-review.md §3.1 and §5.
        """
    depends_on [ @legeos.constraint.services-not-indicators ]
    source {
        kind internal
        role rationale
        path "docs/research/omarchy-review.md"
        use """
            The study this came from, including the verification pass that corrects three of its own claims against source.
            """
    }
}

record legeos.work.adaptive-files-and-omnibox/1 : work {
    title "WS2 — adaptive Files surface with persistent state, and the federated omnibox"
    state completed
    scope [ path "shell/lege-shell/**" ]
    intent """
        Shell phases 3-4. Phase 3: delete surface/home_screen.rs entirely (the embedded rail and second search field); new pure files_surface.rs with FilesLocation (Directory, Recent, Drives, Trash, Operations, Search; Projects/Network/WindowShelf die as locations) and FilesSurfaceState (location, back/forward stacks, selection, focus, anchor, sort, view, show_hidden, query, scroll) consumed by every rung — navigation and selection semantics ported from apps/lege-files BrowserModel (accepted duplication, papercut it); FileBrowserScreen becomes FilesBrowseView holding no per-screen state, its places sidebar drawn at Full only; draw_expanded becomes breadcrumb band plus files_screen at Representation::Full — one nesting level instead of three; app.rs browse/search state re-keys from Drawer to FilesLocation. Phase 4: new pure omnibox.rs federating apps, projects, files (last completed Files.Search1 result with its query; mismatch renders as still-searching) and declared actions; app_search::MatchKind as the universal strength, source order Project > App > Directory > File > Action, per-source caps before merge, 180ms debounce, stale results dropped, visible rows never reorder on late arrival; scope derived from context (Everything on bare Home, current location inside Files with a permanent Search-everything escape row); delete the launcher widget and its system tile via migrate_launcher_tile (no successor object); launcher.* chords keep working.
        """
    note """
        Verify Tab as the scope-escape key against pixelkit_ui focus traversal before committing; Ctrl-Space is the fallback. Until WS4 lands, the omnibox's project source is Projects1.List; switch to ListDetailed when available.
        """
    acceptance {
        check omnibox-unit-tests {
            statement """
                federate() unit tests pass: cross-source ordering at equal strength, per-source caps before merge, staleness gate, escape row present exactly once under Files scope, empty query lists all offerable apps.
                """
            method command
            command "cargo test -p lege-shell omnibox"
            verified_by [ @legeos.evidence.ws2-omnibox-unit-tests-20260901/1 ]
        }
        check one-search-control {
            statement """
                Exactly one search field exists in every Home state; typing on bare Home yields federated app, project and file results in deterministic order; late file results never reorder visible rows.
                """
            method manual
            verified_by [ @legeos.evidence.ws2-one-search-control-20260901/1 ]
        }
        check state-continuity {
            statement """
                Expanding Files, navigating three directories deep, selecting entries, collapsing and re-expanding lands in the same directory with the same selection and scroll.
                """
            method manual
            verified_by [ @legeos.evidence.ws2-state-continuity-20260901/1 ]
        }
    }
    depends_on [ @legeos.work.home-presentation-subtraction ]
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.adaptive-index-maintenance/1 : work {
    title "Adaptive persistent index maintenance — coverage tiers, split freshness, a watcher that sleeps, and a measured backend choice"
    state completed
    scope [
        path "cli/lege/**",
        path "crates/lege-file-index/**",
        path "docs/measurements/**",
        path "interfaces/dbus/**",
        path "scripts/**",
        path "services/lege-filed/**",
        path "services/lege-hostd/**",
        path "tools/xtask/**"
    ]
    intent """
        Keep the shared file index persistent while making its maintenance adaptive: direct write-through when lege-filed performs the operation, kernel events while a consumer is observing, and filesystem metadata deltas to bridge dormant periods, with no recurring crawler in normal operation. Separate acquisition coverage (what the OS knows exists) from client visibility (what a search returns), so a drive visualiser can size target/ while filename search never returns build artefacts. Split namespace freshness from metadata freshness so a filename query stops paying for a per-child stat. Remove the 500ms idle wake and wire the Index1 change signals, which never fire in the current build. Choose the live event backend (inotify, unprivileged fanotify, privileged filesystem-wide fanotify) and the dormant-period bridge (Btrfs send delta vs recursive reconciliation) on measurements taken on the reference machine, not on assumption.
        """
    note """
        Plan of record for this campaign: ~/.claude/plans/implement-a-plan-based-fizzy-journal.md, which extends docs/planning/shared-incremental-file-index.md rather than replacing it. Measured premise: $HOME holds 230,323 directories (189,089 after the current skip list) against a WatchBudget of 125,037, so recursive inotify cannot reach the intended steady state on the machine the design was written for. The development host is ext4 end-to-end and LegeOS is not yet installed, so all Btrfs work is validated against loopback images with @/@home/@snapshots subvolumes; agents have no sudo, so privileged steps are collected into scripts the user runs.

        2026-09-07: this record had no acceptance block, so there was nothing it could be completed against. It has one now, written from what the intent actually promised, and each check cites the evidence that already existed for it. Both backend choices are settled and each is a decision citing its measurements: inotify stays the event backend (@legeos.decision.inotify-remains-the-index-event-backend, @legeos.evidence.fanotify-against-inotify-20260904), and the btrfs delta is now the default for a downtime repair where the root is btrfs and a checkpoint survives (@legeos.decision.btrfs-delta-is-an-opt-in-catch-up-backend-not-the-default, revised from opt-in this day).

        What is still unmeasured is the same thing it always was: none of the btrfs work has run on a real Btrfs root, a real @home or across a reboot. The fixture gate is a user gate in RUNBOOK-L3.md, and the decision that depends on it says so in its own context.
        """
    acceptance {
        check coverage-tiers-and-split-freshness {
            statement """
                Acquisition coverage is separate from client visibility, so a drive visualiser can size a build directory while a filename search never returns its artefacts, and namespace freshness is separate from metadata freshness so a filename query does not pay for a per-child stat.
                """
            method command
            command "cargo test -p lege-file-index coverage"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.index-scale-two-million-20260907,
                @legeos.evidence.index-scale-two-million-20260907/1
            ]
        }
        check measured-backend-choices {
            statement """
                The live event backend and the dormant-period bridge are each chosen on measurements rather than assumption, and each choice is a decision record citing them.
                """
            method command
            command "cargo test -p lege-hostd -p lege-file-index -p lege-filed"
            verified_by [
                @legeos.evidence.btrfs-delta-correctness-gate-passes,
                @legeos.evidence.btrfs-delta-transport-and-backend-20260907,
                @legeos.evidence.btrfs-delta-transport-and-backend-20260907/1,
                @legeos.evidence.fanotify-against-inotify-20260904
            ]
        }
        check no-idle-crawler {
            statement """
                An idle index costs no recurring wakeups: the 500ms idle wake is gone, the watcher blocks on an explicit waker, and the Index1 change signals fire instead of being implemented and never wired.
                """
            method command
            command "cargo test -p lege-filed watcher && cargo test -p lege-file-index watch"
            verified_by [
                @legeos.evidence.idle-index-wakeups-eliminated-20260904,
                @legeos.evidence.idle-index-wakeups-eliminated-20260904/1,
                @legeos.evidence.service-inventory-and-pressure-wakeups-20260907
            ]
        }
    }
    depends_on [ @legeos.work.file-index-core, @legeos.work.file-index-maintenance ]
    part_of [ @legeos.work.shared-incremental-file-index ]
}

record legeos.work.application-integration-interim/1 : work {
    title "Interim application integration — the Terminal role and the Super+grave drop-down terminal, the Files context menu, the search panel with FSearch as the FileSearch provider, Kitty defaults"
    state superseded
    scope [
        path "apps/lege-files/**",
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-appd/**",
        path "crates/lege-session-core/**",
        path "crates/lege-types/src/action.rs",
        path "crates/lege-types/src/provider.rs",
        path "debian/**",
        path "distro/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Integration choices the user made on 2026-09-03, revised the same day. (a) Terminal: ProviderRole::Terminal, exclusive, candidates from TerminalEmulator desktop entries, default kitty; the shell relays the selection with lege_shell_manager_v1.set_terminal and answers terminal_requested by launching the provider through the launch chain; Super+grave (compositor chord; a bare ~ or ` is a typed character and cannot be a global chord) toggles the terminal: launch when none, unshelve/activate when shelved or unfocused, shelve and refocus the previous window when focused, never close. No Ctrl+Alt+T. 'Open terminal here' in the Files context menu launches it with --directory. /etc/xdg/kitty/kitty.conf shipped by legeos-shell with the LegeOS palette, background_opacity 0.85, remember_window_size no, wayland_titlebar_color system, overridable by ~/.config/kitty. (b) Files object: secondary-click menu on rows and empty space reusing surface/context_menu.rs and the declared files.* verbs (Open, Open with…, Open terminal here, Copy path, Rename, Move to trash, Properties; New folder, Paste, Select all, Sort by…, Show hidden), then multi-select, keyboard verbs, drag-and-drop and properties-as-pane. (c) Search: the top field on Home stays the application launcher only (COSMIC's launcher shape); real search is the Files object's search field expanded into a partial-screen panel (about two thirds of the field, centred, hairline edge) over lege-filed's scoped index with path, size and modified time per row and keyboard navigation, whose last row is 'Search everywhere with FSearch'; ProviderRole::FileSearch, exclusive, default FSearch, launched with --search <query>; 'Search here…' in the context menu; lege-filed keeps its index; later sessiond feeds fsearch's include list from Files.Search1.Roots.
        """
    note """
        Plan text: docs/planning/window-groups-and-application-integration.md §4.2–4.6 (ea9810e). Implementation started 2026-09-03 in one lane: Terminal role → set_terminal/terminal_requested relay → Files context menu → search panel + FileSearch role → kitty.conf → multi-select if time. Terminal=true desktop-entry wrapping and Super+F are deferred. Not planned: reading fsearch's database or replacing Files.Search1.
        """
    depends_on [ @legeos.work.wayland-clipboard-and-dnd-transport ]
    implements [ @legeos.decision.the-home-field-is-a-launcher-not-a-search ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.application-integration-interim/2 : work {
    title "Interim application integration — the Terminal role and the Super+grave drop-down terminal, the Files context menu, the search panel with FSearch as the FileSearch provider, Kitty defaults"
    state active
    scope [
        path "apps/lege-files/**",
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-appd/**",
        path "crates/lege-session-core/**",
        path "crates/lege-types/src/action.rs",
        path "crates/lege-types/src/provider.rs",
        path "debian/**",
        path "distro/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Integration choices the user made on 2026-09-03, revised later the same day. (a) Terminal: ProviderRole::Terminal, exclusive, candidates from TerminalEmulator desktop entries, default kitty; the shell relays the selection with lege_shell_manager_v1.set_terminal and answers terminal_requested by launching the provider through the launch chain; Super+grave (compositor chord; a bare ~ or ` is a typed character and cannot be a global chord) toggles the terminal: launch when none, unshelve/activate when shelved or unfocused, shelve and refocus the previous window when focused, never close. No Ctrl+Alt+T. 'Open terminal here' in the Files context menu launches it with --directory. /etc/xdg/kitty/kitty.conf shipped by legeos-shell with the LegeOS palette, background_opacity 0.85, remember_window_size no, wayland_titlebar_color system, overridable by ~/.config/kitty. (b) Files object: secondary-click menu on rows and empty space reusing surface/context_menu.rs and the declared files.* verbs (Open, Open with…, Open terminal here, Copy path, Rename, Move to trash, Properties; New folder, Paste, Select all, Sort by…, Show hidden), then multi-select, keyboard verbs, drag-and-drop and properties-as-pane. (c) Search: the top field on Home stays the application launcher only (COSMIC's launcher shape); real search is the Files object's search field expanded into a partial-screen panel (about two thirds of the field, centred, hairline edge) over lege-filed's scoped index with path, size and modified time per row and keyboard navigation, whose last row is 'Search everywhere with FSearch'; ProviderRole::FileSearch, exclusive, launched with --search <query>; 'Search here…' in the context menu. The later indexing direction replaces the interim two-database arrangement: lege-filed owns one persistent, incrementally maintained derived file index used by integrated Files search, a remote-index FSearch fork, Silvaview-rs, the CLI and future clients.
        """
    note """
        The application-integration plan remains docs/planning/window-groups-and-application-integration.md for terminal, Files UI and provider work. Its section 4.2 statements that fsearch keeps a second database and Files.Search1 is not replaced are superseded by the user's later 2026-09-03 direction and docs/planning/shared-incremental-file-index.md. The detailed implementation is tracked by @legeos.work.shared-incremental-file-index.
        """
    depends_on [ @legeos.work.wayland-clipboard-and-dnd-transport ]
    implements [ @legeos.decision.the-home-field-is-a-launcher-not-a-search ]
    part_of [ @legeos.work.home-surface-usability-next ]
    supersedes [ @legeos.work.application-integration-interim/1 ]
}

record legeos.work.bar-cluster-clickable-20260908/1 : work {
    title "Lane B — every chip in the bar's machine cluster does one named thing, and Settings reaches Home's garden"
    state active
    scope [
        path "apps/lege-settings/src/**",
        path "crates/lege-types/src/action.rs",
        path "distro/metapackages/legeos-desktop/control.in",
        path "distro/seeds/selection.toml",
        path "shell/lege-shell/src/surface/app.rs",
        path "shell/lege-shell/src/surface/bar_screen.rs",
        path "shell/lege-shell/src/surface/offscreen.rs"
    ]
    intent """
        The user's report on the installed session at gfbe4480 was that the bar's bottom-right buttons are not clickable, that network should open nm-tray-2, that the separate power/battery bar should become a full OS Settings button, that date/time should open an existing calendar rather than a new one, and that the furthest bottom-right button was unlabelled and frightening. Finding 6 of the Homegarden usability review adds that Settings excludes every `shell.home-garden.*` key, so default-on automation has no graphical settings.

        Three of those were literal: the readings chip and the clock had no click handler at all, so a click on either fell through to the bar's own ground and merely re-activated the window. The fourth was worse than literal: the network chip *was* wired, but `app.rs::network_control_app` resolved the control by desktop-file name (`*nm-tray.desktop`) while the action `network.open-control` has always declared `Requires::Provider(ProviderRole::NetworkStatusUi)`. On this host `lege providers` prints `network-status-ui  no application declares this role` and the registry nonetheless holds `desktop-import.nm-tray.desktop` for Ubuntu's stock nm-tray 0.5.1 — which ignores `--popup`, only ever draws a tray icon, and had no tray to draw into. The chip lit up and launched something invisible.

        The work: the cluster becomes account · clock · network · Settings, right to left, with the readings moved into the account popover's first line and their 112 pixels spent on a Settings chip; the account chip wears the account's name beside its mark; the confirm rows read "Click again to log out"; the clock gains `clock.open-calendar`, which resolves the first application declaring `Categories=Calendar` (gsimplecal preferred, and now in the desktop seed); the network chip resolves the provider role and nothing else; and Settings gains a Homegarden tab with the typed `shell.home-garden.*` keys, an editable ignore list and the hidden places from `HomeGarden1.Contexts`, each with an Unhide that calls `Hide(path, false)`.
        """
    target 2026-09-08
    note """
        Lane B of campaign 4. The two package installs are the user's (RUNBOOK-lane-B.md); until they are run, the clock and network chips are drawn dimmed and take no click, which is the intended failure mode.
        """
    acceptance {
        check cluster-clears-the-window-controls {
            statement """
                The widened cluster still sits entirely left of a maximized window's three controls and does not overlap itself.
                """
            method command
            command "cargo test -p lege-shell --lib bar_screen::tests::the_cluster_never_overlaps_the_maximized_window_controls"
            verified_by [ @legeos.evidence.bar-cluster-clears-window-controls-20260908 ]
        }
        check every-chip-acts {
            statement """
                Each of the four chips in the machine cluster performs its own declared action on one click at the rectangle the paint used, and a chip whose target is not installed takes no click.
                """
            method command
            command "cargo test -p lege-shell --lib bar_screen"
            verified_by [ @legeos.evidence.bar-cluster-chips-act-20260908 ]
        }
        check garden-keys-reach-settings {
            statement """
                Every `shell.home-garden.*` schema key routes to the Homegarden page, and the ignore key it draws by hand is a string list.
                """
            method command
            command "cargo test -p lege-settings"
            verified_by [ @legeos.evidence.home-garden-keys-reach-settings-20260908 ]
        }
        check gates-green {
            statement """
                check-actions, check-packaging and check-interfaces pass with the new action id and the new seed package.
                """
            method command
            command "cargo run -q -p xtask -- check-actions && cargo run -q -p xtask -- check-packaging && cargo run -q -p xtask -- check-interfaces"
            verified_by [ @legeos.evidence.bar-cluster-gates-green-20260908 ]
        }
        check installed-session {
            statement """
                On the installed session after RUNBOOK-lane-B.md steps 1-3, each of the four chips opens its named thing, and the Homegarden tab lists the ignore entries and the hidden places.
                """
            method manual
        }
        check network-resolves-the-role {
            statement """
                The network control is resolved through the `network-status-ui` provider role rather than by desktop-file name, so stock nm-tray can no longer be launched invisibly.
                """
            method observation
            verified_by [ @legeos.evidence.network-status-ui-role-unfilled-20260908 ]
        }
        check the-cluster-is-visible {
            statement """
                The rendered bar shows the four chips in order and the popover shows the readings line above the ten action rows.
                """
            method observation
            verified_by [ @legeos.evidence.bar-cluster-rendered-20260908 ]
        }
        check the-fork-packages {
            statement """
                `legeos-nm-tray` builds into a .deb from the fork working tree, preflight included.
                """
            method command
            command "scripts/build-fork-deb.sh nm-tray-2 --source ../not-rust-projects/nm-tray-2"
            verified_by [ @legeos.evidence.legeos-nm-tray-packaged-20260908 ]
        }
    }
    derived_from [ @legeos.assessment.homegarden-usability-review-20260908 ]
    implements [
        @legeos.decision.homegarden-activity-grown-places,
        @legeos.decision.one-persistent-bottom-bar-tags-not-bands
    ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.bar-home-chip-cluster-and-fullscreen-peek/1 : work {
    title "Lane 2 — the bar gains a Home chip, parked entries and the machine cluster; fullscreen fills the output and a bottom-edge dwell peeks the bar"
    state superseded
    scope [
        path "compositor/lege-comp/**",
        path "crates/lege-window/**",
        path "interfaces/wayland/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Make the bar the machine and fullscreen genuinely full screen. The bar takes the output's width and carries a Home chip at the left, the taskbar (parked windows included, dimmed, restored by a click), and one machine cluster at the right: readings, network, clock and an account chip whose popover holds Settings, the volume and brightness controls and the session actions. WindowService::set_fullscreen gives a fullscreen window the output's logical rectangle, stores it in a restore slot of its own, and stacking_order sorts it above ShellOverlay and Notification on its own output — never above SystemModal, Recovery or SecureLock. The shell stops destroying its bar for fullscreen; the compositor peeks it back with a bottom-edge dwell (set_peek_output suspends the exception).
        """
    target 2026-09-08
    note """
        Deliberate deferrals, with reasons: (1) scroll-to-adjust on the volume and brightness chips — the popover already carries volume.increase/decrease/mute and brightness.increase/decrease as rows, so a wheel handler on a read-only indicator would be a second route to the same five actions and a second set of hit-tests; add it when someone asks for it. (2) Peek on more than one output at a time — peek_output is a single Option<String> because there is one pointer; a second fullscreen output keeps its window on top. (3) PEEK_BAND is 4 logical px rather than the 2 the plan named: one or two pixels is under a pixel of slack at a fractional scale and a real mouse has to be able to land on it. Both the band and the dwell are named constants so the hands-on run can tune them. (4) XWayland override-redirect fullscreen (a game that maps a bare full-output window without asking) is out of scope; this covers the fullscreen_request path on both shells.
        """
    acceptance {
        check actions-have-a-pointer-route {
            statement """
                xtask check-actions passes: every action the bar names is declared, and no action with a chord is left keyboard-only now that Home carries no system widgets.
                """
            method command
            command "cargo run -q -p xtask -- check-actions"
            verified_by [ @legeos.evidence.bar-lane-2-check-actions/1 ]
        }
        check bar-composition {
            statement """
                lege-shell: the bar is the output's width and grows upward for a row or the popover; the Home chip reveals Home; a parked entry is dimmed and a click restores then activates it; every account-popover row is a declared action and the session-ending ones take a second click; a refused control takes no click.
                """
            method command
            command "cargo test -p lege-shell --lib bar_screen"
            verified_by [ @legeos.evidence.bar-lane-2-shell-tests/1 ]
        }
        check compositor-configures-and-peeks {
            statement """
                lege-comp: the fullscreen configure carries the output's size on both shells and on the escape route, and the bottom-edge band opens on the last few pixels and holds across the shell's reserved strip.
                """
            method command
            command "cargo test -p lege-comp"
            verified_by [ @legeos.evidence.bar-lane-2-compositor-tests/1 ]
        }
        check fullscreen-covers-the-bar-on-hardware {
            statement """
                In a session, a fullscreen client fills the whole output including the bar's zone, the bar surface is never destroyed, and leaving fullscreen returns the window and the bar with no reflow.
                """
            method observation
            verified_by [ @legeos.evidence.bar-lane-2-nested-fullscreen/1 ]
        }
        check peek-on-hardware {
            statement """
                Resting the pointer on the bottom edge of an output with a fullscreen window raises the bar over it after the dwell, and leaving the reserved strip hides it again.
                """
            method manual
        }
        check window-fullscreen-and-stacking {
            statement """
                lege-window: a fullscreen window takes the output's logical rectangle (not usable()), restores through a slot maximize never touches, is never repaired by an output change, and sorts above ShellOverlay and Notification but below SystemModal, Recovery and SecureLock until a peek suspends it.
                """
            method command
            command "cargo test -p lege-window"
            verified_by [ @legeos.evidence.bar-lane-2-window-tests/1 ]
        }
    }
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.bottom-bar-taskbar/1 : work {
    title "Lane B — shell: the persistent bottom bar with indicators, the taskbar with its hover row, and the maximized window's controls"
    state superseded
    scope [
        path "compositor/lege-comp/src/backend/mod.rs",
        path "compositor/lege-comp/src/xdg_shell.rs",
        path "crates/lege-window/src/geometry.rs",
        path "interfaces/wayland/lege-shell-v1.xml",
        path "shell/lege-shell/**"
    ]
    intent """
        shell/lege-shell: taskbar.rs (pure entries: window groups first in group-id order, then one entry per application through dock::group ByApplication; a one-window application is that window; active marks the activated toplevel) and surface/bar_screen.rs (BarScreen with one layout read by paint and hit-test: network and clock left, cells centred with the active entry wearing icon+title, park/maximize/close right when the activated window is maximized; hover dwell 400 ms opens a multi-window entry's row, 200 ms grace after leaving closes it; row items activate). app.rs hosts it as a third winit window on Layer::ShellOverlay with a bottom exclusive zone of BAR_HEIGHT (48), created after the bridge connects, dropped while a window is fullscreen, pointer-only; Home insets its field by BAR_HEIGHT; a BridgeState generation counter redraws Home and the bar the moment the window list changes; hover deadlines join the control-flow chain; a press on empty bar ground re-activates the activated window. Home's information row keeps only the live/parked summary; network and clock moved to the bar. Compositor: shell_surface_placement treats the exclusive zone as a floor on the surface's thickness and adopt_client_size re-places a zone-holding shell surface at its committed size, so the row grows the surface without reflowing windows (lege-shell-v1.xml prose only, no version bump). Dead dock_screen.rs and settings::dock_grouping deleted; dock.rs declared as a module and reused.
        """
    note """
        Behaviour ported from cosmic-app-list (GPL-3, libcosmic); no code copied. The compositor registers an exclusive zone against the first output only, so a second monitor gets no bar (compositor ceiling, follow-up). B4's compositor edits need a logout; the bar itself is hot-swappable.
        """
    acceptance {
        check bar-interaction {
            statement """
                A one-window cell activates; a multi-window cell opens its row and a row item activates; hover opens after the dwell and closes after the grace; controls exist only for a maximized activated window; the network indicator runs its declared action.
                """
            method command
            command "cargo test -p lege-shell bar_screen"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check gate-green {
            statement """
                just check passes, including check-actions (network.open-control keeps a pointer route) and the re-reviewed Home baseline hash.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check hands-on-confirmation {
            statement """
                At the desktop: the bar is visible over kitty and on Home with network and clock at the left; each open application is one icon, groups first; hovering an application with two windows shows a row above the bar and clicking a row item activates it; a maximized window's park/maximize/close sit at the bar's right and act.
                """
            method manual
        }
        check taskbar-model {
            statement """
                Groups before applications, one entry per application, a single-window application carries the window, grouped windows never double as application entries, order stable under reordering.
                """
            method command
            command "cargo test -p lege-shell taskbar"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check zone-is-a-floor {
            statement """
                An exclusive surface thicker than its zone stays edge-anchored and the work area is unchanged.
                """
            method command
            command "cargo test -p lege-window an_exclusive_surface_may_be_thicker_than_its_zone"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
    }
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.bottom-bar-taskbar/2 : work {
    title "Lane B — shell: the persistent bottom bar with indicators, the taskbar with its hover row, and the maximized window's controls"
    state superseded
    scope [
        path "compositor/lege-comp/src/backend/mod.rs",
        path "compositor/lege-comp/src/xdg_shell.rs",
        path "crates/lege-window/src/geometry.rs",
        path "interfaces/wayland/lege-shell-v1.xml",
        path "shell/lege-shell/**"
    ]
    intent """
        shell/lege-shell: taskbar.rs (pure entries: window groups first in group-id order, then one entry per application through dock::group ByApplication; a one-window application is that window; active marks the activated toplevel) and surface/bar_screen.rs (BarScreen with one layout read by paint and hit-test: network and clock left, cells centred with the active entry wearing icon+title, park/maximize/close right when the activated window is maximized; hover dwell 400 ms opens a multi-window entry's row, 200 ms grace after leaving closes it; row items activate). app.rs hosts it as a third winit window on Layer::ShellOverlay with a bottom exclusive zone of BAR_HEIGHT (48), created after the bridge connects, dropped while a window is fullscreen, pointer-only; Home insets its field by BAR_HEIGHT; a BridgeState generation counter redraws Home and the bar the moment the window list changes; hover deadlines join the control-flow chain; a press on empty bar ground re-activates the activated window. Home's information row keeps only the live/parked summary; network and clock moved to the bar. Compositor: shell_surface_placement treats the exclusive zone as a floor on the surface's thickness and adopt_client_size re-places a zone-holding shell surface at its committed size, so the row grows the surface without reflowing windows (lege-shell-v1.xml prose only, no version bump). Dead dock_screen.rs and settings::dock_grouping deleted; dock.rs declared as a module and reused.
        """
    note """
        Behaviour ported from cosmic-app-list (GPL-3, libcosmic); no code copied. The compositor registers an exclusive zone against the first output only, so a second monitor gets no bar (compositor ceiling, follow-up). B4's compositor edits need a logout; the bar itself is hot-swappable.

        The compositor half named in the intent has since changed shape, and the shell side must follow. The zone is now a floor on the surface's thickness *and nothing at all* about its extent along the edge: shell_surface_placement gives a zone-holding surface its own committed width (or height), clamped to the output and anchored at the edge's start, so a chip strip narrower than the screen reserves exactly what a full-width row reserves and toggling between them reflows no window. The compositor therefore no longer stretches the bar to the output, which means it also never configures it to the output width — the shell must supply the width it wants, taking it from the Home Surface, which is still placed at the full output and configured to it in the same process.

        And adopt_client_size is not where the re-placement loop was fixed. Comparing the committed size against the placement re-configures a client with a size the placement will never grant (floored by the zone, clamped to the output), once per frame, forever. apply_surface_claims now simply does nothing when the placement has not moved, which fixes every caller at once and rests on shell_surface_placement being idempotent — asserted by a proptest. adopt_client_size itself is untouched.
        """
    acceptance {
        check bar-interaction {
            statement """
                A one-window cell activates; a multi-window cell opens its row and a row item activates; hover opens after the dwell and closes after the grace; controls exist only for a maximized activated window; the network indicator runs its declared action.
                """
            method command
            command "cargo test -p lege-shell bar_screen"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check gate-green {
            statement """
                just check passes, including check-actions (network.open-control keeps a pointer route) and the re-reviewed Home baseline hash.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check hands-on-confirmation {
            statement """
                At the desktop: the bar is visible over kitty and on Home with network and clock at the left; each open application is one icon, groups first; hovering an application with two windows shows a row above the bar and clicking a row item activates it; a maximized window's park/maximize/close sit at the bar's right and act.
                """
            method manual
        }
        check taskbar-model {
            statement """
                Groups before applications, one entry per application, a single-window application carries the window, grouped windows never double as application entries, order stable under reordering.
                """
            method command
            command "cargo test -p lege-shell taskbar"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check zone-is-a-floor {
            statement """
                An exclusive surface thicker than its zone stays edge-anchored and the work area is unchanged.
                """
            method command
            command "cargo test -p lege-window an_exclusive_surface_may_be_thicker_than_its_zone"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
    }
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.work.home-surface-usability-next ]
    supersedes [ @legeos.work.bottom-bar-taskbar/1 ]
}

record legeos.work.bottom-bar-taskbar/3 : work {
    title "Lane B — shell: the persistent bottom bar with indicators, the taskbar with its hover row, and the maximized window's controls"
    state superseded
    scope [
        path "compositor/lege-comp/src/backend/mod.rs",
        path "compositor/lege-comp/src/xdg_shell.rs",
        path "crates/lege-window/src/geometry.rs",
        path "interfaces/wayland/lege-shell-v1.xml",
        path "shell/lege-shell/**"
    ]
    intent """
        shell/lege-shell: taskbar.rs (pure entries: window groups first in group-id order, then one entry per application through dock::group ByApplication; a one-window application is that window; active marks the activated toplevel) and surface/bar_screen.rs (BarScreen with one layout read by both paint and hit-test). app.rs hosts it as a third winit window on Layer::ShellOverlay with a bottom exclusive zone of BAR_HEIGHT (48), created after the bridge connects, dropped while a window is fullscreen, pointer-only; Home insets its field by BAR_HEIGHT; a BridgeState generation counter redraws Home and the bar the moment the window list changes; hover deadlines join the control-flow chain.
        """
    note """
        Behaviour ported from cosmic-app-list (GPL-3, libcosmic); no code copied. The compositor registers an exclusive zone against the first output only, so a second monitor gets no bar (compositor ceiling, follow-up). The compositor edits need a logout; the bar itself is hot-swappable.

        **2026-09-07, revised to the user's own decision:** "I do not want there to be a taskbar visible if there is nothing to show on it. Should just be tabs for the time/date/network status, like the tabs for windows. It can become a full row when there is something more to show."

        The bar is now a strip of chips — CHIP_H = lege_window::geometry::TAG_HEIGHT, on the compositor's own name-tag colours (design::TAG_FILL / TAG_INK, copied per contract K3, not shared — the shell does not link the compositor) — and the surface is exactly as wide as the chips are. There is no full-width shell ground at rest. Two things claim the width: a maximized window's controls, which belong at the right-hand end of the screen rather than beside the clock, and an open hover row, which needs somewhere to open into. `bar_screen::wanted_size(entries, activated, row_open, full_width)` is the single pure answer to which of those is true, and app.rs sizes the surface to it.

        This rests on the K1 zone contract: the compositor no longer stretches a zone-holding surface to the output, so it also never configures the bar to the output width. The shell supplies that number from Home's own configured logical width — Home is Layer::HomeSurface with no zone, so it is still placed at the full output, and it is in the same process. The exclusive zone stays BAR_HEIGHT along the whole bottom edge whatever the surface's own extent is, so toggling between chips and full width moves no window.

        Why the surface has to actually shrink rather than the paint just drawing less: HostedWindow::prepare never clears the buffer and the bar window is not created with_transparent, so a chip strip on a full-width surface would show stale pixels wherever nothing painted. The narrow surface is what makes dropping the ground safe.

        A press on empty bar ground still re-activates the activated window, but only where there is ground — with the strip at chip width the pixels between chips are padding, not a band to click on.

        Also fixed here, found while sizing the field: Home's inset subtracted a *logical* BAR_HEIGHT from a *physical* buffer height (app.rs redraw_home), so on a scaled output the field painted into the strip the bar covers.
        """
    acceptance {
        check bar-interaction {
            statement """
                A one-window cell activates; a multi-window cell opens its row and a row item activates; hover opens after the dwell and closes after the grace; controls exist only for a maximized activated window; the network indicator runs its declared action.
                """
            method command
            command "cargo test -p lege-shell bar_screen"
            verified_by [
                @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1,
                @legeos.evidence.home-chips-projects-appearance-lock-20260907/1
            ]
        }
        check gate-green {
            statement """
                just check passes, including check-actions (network.open-control keeps a pointer route) and the re-reviewed Home baseline hash.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check hands-on-confirmation {
            statement """
                At the desktop: with nothing open the bottom of the screen shows only the network and clock chips, not a band across the screen; each open application is one chip, groups first; hovering an application with two windows opens a row above the bar; a maximized window's park/maximize/close sit at the bar's right and act.
                """
            method manual
        }
        check no-bar-with-nothing-on-it {
            statement """
                The bar is the chip strip's own width normally, and the full output width only for a maximized window's controls or an open hover row; wanted_size is pure and the host sizes the surface to it.
                """
            method command
            command "cargo test -p lege-shell wanted_size_is_the_chips_alone_until_a_row_or_controls_need_the_width"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
    }
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.work.home-surface-usability-next ]
    supersedes [ @legeos.work.bottom-bar-taskbar/2 ]
}

record legeos.work.bottom-bar-taskbar/4 : work {
    title "Lane B — shell: the persistent bottom bar with indicators, the taskbar with its hover row, and the maximized window's controls"
    state superseded
    scope [
        path "compositor/lege-comp/src/backend/mod.rs",
        path "compositor/lege-comp/src/xdg_shell.rs",
        path "crates/lege-window/src/geometry.rs",
        path "interfaces/wayland/lege-shell-v1.xml",
        path "shell/lege-shell/**"
    ]
    intent """
        shell/lege-shell: taskbar.rs (pure entries: window groups first in group-id order, then one entry per application through dock::group ByApplication; a one-window application is that window; active marks the activated toplevel) and surface/bar_screen.rs (BarScreen with one layout read by both paint and hit-test). app.rs hosts it as a third winit window on Layer::ShellOverlay with a bottom exclusive zone of BAR_HEIGHT (48), created after the bridge connects, dropped while a window is fullscreen, pointer-only; Home insets its field by BAR_HEIGHT; a BridgeState generation counter redraws Home and the bar the moment the window list changes; hover deadlines join the control-flow chain.
        """
    note """
        Behaviour ported from cosmic-app-list (GPL-3, libcosmic); no code copied. The compositor registers an exclusive zone against the first output only, so a second monitor gets no bar (compositor ceiling, follow-up). The compositor edits need a logout; the bar itself is hot-swappable.

        **2026-09-07, revised to the user's own decision:** "I do not want there to be a taskbar visible if there is nothing to show on it. Should just be tabs for the time/date/network status, like the tabs for windows. It can become a full row when there is something more to show."

        The bar is now a strip of chips — CHIP_H = lege_window::geometry::TAG_HEIGHT, on the compositor's own name-tag colours (design::TAG_FILL / TAG_INK, copied per contract K3, not shared — the shell does not link the compositor) — and the surface is exactly as wide as the chips are. There is no full-width shell ground at rest. Two things claim the width: a maximized window's controls, which belong at the right-hand end of the screen rather than beside the clock, and an open hover row, which needs somewhere to open into. `bar_screen::wanted_size(entries, activated, row_open, full_width)` is the single pure answer to which of those is true, and app.rs sizes the surface to it.

        This rests on the K1 zone contract: the compositor no longer stretches a zone-holding surface to the output, so it also never configures the bar to the output width. The shell supplies that number from Home's own configured logical width — Home is Layer::HomeSurface with no zone, so it is still placed at the full output, and it is in the same process. The exclusive zone stays BAR_HEIGHT along the whole bottom edge whatever the surface's own extent is, so toggling between chips and full width moves no window.

        Also fixed here, found while sizing the field: Home's inset subtracted a *logical* BAR_HEIGHT from a *physical* buffer height (app.rs redraw_home), so on a scaled output the field painted into the strip the bar covers.

        **2026-09-07, second revision — the user reported "the bottom left is a mess", and this is what it was.** The paragraph above that said "the narrow surface is what makes dropping the ground safe" was wrong, and the reasoning inverted. `softbuffer`'s Wayland backend attaches a `wl_shm::Format::Xrgb8888` buffer (softbuffer 0.4.8, `src/backends/wayland/buffer.rs:102,142`): **this surface has no alpha channel and can never be transparent.** `HostedWindow::prepare` never clears the buffer either. A strip that painted only its chips was therefore an opaque *black* rectangle 280x48 in the bottom-left corner of the screen, growing to 336/392/564 as windows opened, with the chips sitting on it — and full width, black, whenever a row opened or a window was maximized. Narrow does not mean invisible; it only meant the black block was small.

        `BarScreen::draw` now fills its whole extent with `design::ground()` — Home's own ground colour — before anything else, and `every_pixel_of_the_surface_is_painted` fails if any state ever leaves a pixel unwritten again. That is visually identical to transparency today, because nothing but Home is ever behind the bar: the compositor reserves BAR_HEIGHT along the bottom edge so no client reaches it, Home is placed at the full output, and Home paints a flat `ui.theme.background`.

        **Deferred, with its trigger and its route, so nobody re-derives it:** real per-pixel transparency needs an `Argb8888` surface instead of softbuffer's `Xrgb8888`. The cheap route is *not* a bridge-owned surface with wl_pointer routing — winit already owns the bar's `wl_surface` and already delivers its pointer events. It is: an alpha-preserving variant of `previews::ShmBuffer::write` (~10 lines, the existing `Argb8888` path `session_lock::paint` already uses), a bridge `attach_argb` reaching the surface through the raw window handle the way `set_layer` does (~70 lines with a cached buffer and `set_buffer_scale`), and skipping `HostedWindow::present` for the bar (~20 lines), plus tests — about 150 lines. **The trigger is a wallpaper or any non-flat Home ground.** `shell.wallpaper.enabled` is in the settings schema (`lege-session-core/src/settings.rs:136`) and nothing implements it; the day something does, the opaque ground stops matching what is behind it and this becomes required. Note also that pixelkit colours are `0x00RRGGBB` with no alpha, so alpha would have to be reconstructed by keying on the ground colour — which leaves antialiased chip edges opaque and ground-coloured.

        One thing deliberately *not* changed: `wanted_size` stays computed after the paint in `redraw_bar`. `WindowEvent::Resized` already re-requests a redraw, so the one frame in which a chip is clipped by an out-of-date surface size self-corrects; moving the call before the paint would compute `row_open()` from the previous frame, and a row opened by the hover deadline would then get no room until some later redraw.
        """
    acceptance {
        check bar-interaction {
            statement """
                A one-window cell activates; a multi-window cell opens its row and a row item activates; hover opens after the dwell and closes after the grace; controls exist only for a maximized activated window; the network indicator runs its declared action.
                """
            method command
            command "cargo test -p lege-shell bar_screen"
            verified_by [
                @legeos.evidence.bar-ground-and-pcmanfm-role-20260907/1,
                @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1,
                @legeos.evidence.home-chips-projects-appearance-lock-20260907/1
            ]
        }
        check gate-green {
            statement """
                just check passes, including check-actions (network.open-control keeps a pointer route) and the re-reviewed Home baseline hash.
                """
            method command
            command "just check"
        }
        check hands-on-confirmation {
            statement """
                At the desktop: with nothing open the bottom of the screen shows only the network and clock chips, not a band across the screen and not a black block in the corner; each open application is one chip, groups first; hovering an application with two windows opens a row above the bar; a maximized window's park/maximize/close sit at the bar's right and act.
                """
            method manual
        }
        check no-bar-with-nothing-on-it {
            statement """
                The bar is the chip strip's own width normally, and the full output width only for a maximized window's controls or an open hover row; wanted_size is pure and the host sizes the surface to it.
                """
            method command
            command "cargo test -p lege-shell wanted_size_is_the_chips_alone_until_a_row_or_controls_need_the_width"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
        check the-bar-is-not-a-black-block {
            statement """
                The bar surface writes every one of its own pixels in every state, so a surface that cannot be transparent (softbuffer attaches Xrgb8888) never shows as black behind the chips; the resting strip is chips on Home's own ground.
                """
            method command
            command "cargo test -p lege-shell every_pixel_of_the_surface_is_painted"
            verified_by [ @legeos.evidence.bar-ground-and-pcmanfm-role-20260907/1 ]
        }
    }
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.work.home-surface-usability-next ]
    supersedes [ @legeos.work.bottom-bar-taskbar/3 ]
}

record legeos.work.bottom-bar-taskbar/5 : work {
    title "Lane B — shell: the persistent bottom bar with indicators, the taskbar with its hover row, and the maximized window's controls"
    state superseded
    scope [
        path "compositor/lege-comp/src/backend/mod.rs",
        path "compositor/lege-comp/src/xdg_shell.rs",
        path "crates/lege-window/src/geometry.rs",
        path "interfaces/wayland/lege-shell-v1.xml",
