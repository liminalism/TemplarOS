record legeos.work.home-panel-and-dock-layouts/1 : work {
    title "Adjustable Home panels and docks with automatic arrangements for each output shape"
    state completed
    scope [
        path "crates/lege-field/**",
        path "crates/lege-session-core/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Turn the fixed drawer block and system shelf into user-adjustable Home-only containers. A panel/rail/dock is a layout group for folders, shortcut panes, widgets or sessions: it can be moved, resized, oriented as a row/column/edge rail, or assigned an automatic arrangement that fits the current output. Automatic choices include balanced rows/columns, edge rails and a cushion-map-like composition where area follows the importance or content measure the object declares.

        Preset buttons on Home switch arrangements immediately without rebuilding or losing the contained objects. A custom layout is retained as the restore target; selecting another preset replaces the current preset in one action rather than building an undo stack of intermediate movements. Layout persists per output identity and safely reflows when scale, resolution or topology changes. These docks never map as ShellOverlay, never reserve an exclusive zone outside Home, and disappear completely behind application work.
        """
    acceptance {
        check adjustable-home-groups {
            statement """
                Home panels/rails can be created or configured, moved, resized and oriented without changing the identity or contents of their objects.
                """
            method command
            command "cargo test -p lege-field -p lege-shell panel_layout"
            verified_by [ @legeos.evidence.home-panels-20260831/1 ]
        }
        check automatic-layouts-fit {
            statement """
                Balanced, edge-rail and cushion-style automatic arrangements are deterministic, non-overlapping and bounded across supported output sizes and scales.
                """
            method command
            command "cargo test -p lege-field panel_layout -- --include-ignored"
            verified_by [ @legeos.evidence.home-panels-20260831/1 ]
        }
        check home-only-no-exclusive-zone {
            statement """
                With an application fullscreen or maximized, no Home panel/dock is visible and no panel/dock reduces the application work area.
                """
            method observation
            verified_by [ @legeos.evidence.home-panels-no-exclusive-zone-20260831/1 ]
        }
        check preset-switch-is-reversible {
            statement """
                Switching directly between any two presets is one operation, preserves the saved custom arrangement, and Restore Custom returns every group to its exact prior placement.
                """
            method command
            command "cargo test -p lege-field panel_presets"
            verified_by [ @legeos.evidence.home-panels-20260831/1 ]
        }
    }
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.home-presentation-subtraction/1 : work {
    title "WS1 — Home subtraction: shape-aware floors, one Files object, pinned-only App tiles"
    state completed
    scope [ path "crates/lege-field/**", path "shell/lege-shell/**" ]
    intent """
        Shell phases 0-2 of the consolidation plan. Phase 0: replace Representation::for_span's cell-count match with a declared RungFloor/RungLadder (cols, rows, cells floors per rung; highest admitted rung wins; monotone by construction), values chosen so no span reachable in today's default layout changes rung (System Large keeps rows floor 2 for the 7x2 Settings tile); reflow's aspect_distortion untouched; the --render baseline must not change in this phase. Phase 1: delete DRAWER_TILES, drawer_grid, drawer_reserved_cols, merge_drawers and the drawers panel group; add files_tile_id, merge_files (TileKind::Widget widget="files", span 2x2 floor / 4x3 preferred / widget-class ceiling) and migrate_drawer_tiles (all ten legacy drawer tiles kind-checked, first cell and largest span inherited, panel removed, idempotent, exact-inverse FieldOps); new surface/files_screen.rs renders Small and Wide from existing DrawerFeeds with conditional Downloads/Trash/Operations rows; DOCUMENT_VERSION stays 1. Phase 2: delete merge_apps; narrow the gone sweep to ParkedSession only (commented as load-bearing); add pin_app, FieldAction::PinApp, a Keep-on-Home session context row and the declared home.pin-app action; LIVE/PARKED hidden when every non-shelved toplevel has a located session tile.
        """
    note """
        Settled: the default Desktop folder tile stays (per the placeable-objects decision); all ten --print drawer slugs stay as diagnostics. Risk watched: WidgetRegion::from_rung reachability asserted for every widget so no control silently vanishes at a new rung boundary.
        """
    acceptance {
        check drawer-migration {
            statement """
                A saved layout with the legacy drawer block loads with one Files tile at the first drawer's cell, the drawers panel removed, and the migration idempotent with exact inverses.
                """
            method command
            command "cargo test -p lege-shell field_model"
            verified_by [ @legeos.evidence.ws1-drawer-migration-20260901/1 ]
        }
        check field-ladder-tests {
            statement """
                lege-field passes the new ladder property tests: rung monotone in both axes, ladders well-formed, every rung reachable within its kind's ceiling, and the cells-only ladder reproduced for aspect within 1:3.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.ws1-field-ladder-tests-20260901/1 ]
        }
        check no-auto-app-tiles {
            statement """
                A running session produces a session tile and no App tile; a pinned App tile survives a shell restart; a field refresh never removes a placed tile other than a closed window's session tile.
                """
            method manual
            verified_by [ @legeos.evidence.ws1-no-auto-app-tiles-20260901/1 ]
        }
    }
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.home-project-development-status/1 : work {
    title "Proposal: opt-in development status inside project tiles"
    state proposed
    intent """
        For later consideration, give explicitly selected project tiles a compact development status view: last requested build/test result and observed source revision, with freshness and unavailable states. At larger representations, provide an explicit route to the corresponding log. Keep collection and process execution behind a typed service; the shell only renders and forwards. Do not run repository commands or hooks on discovery, continuously crawl projects, create permanent status chrome, or resize/reorder tiles on status changes. Settle service ownership, trust/consent, bounded output storage and refresh budget before implementation.
        """
    note """
        Extrapolated from Home as working memory and the user's day-to-day development objective; not authorization to add background build or git polling.

        **Deferred 2026-09-07.** The blocker is the one the record already names, and nothing in this slice moved it: there is no service that owns build, test or repository status, and no owner for one. @legeos.constraint.services-not-indicators means the shell renders and forwards — policy lives behind a D-Bus interface — so the tile cannot exist before the service does.

        What makes this a deferral rather than a small piece of work is that implementing the tile *without* that service has exactly one shape: the shell running `git status` and a build command on a timer. That is the background polling this record explicitly forbids, so a partial implementation would not be a step towards the intended design, it would be the thing the design rules out. Trust and consent, bounded output storage and a refresh budget are all still unspecified as well. Revisit when a service owns it.
        """
    acceptance {
        check honest-status {
            statement """
                The tile identifies the command/result revision and age, and distinguishes stale, running, failed, unavailable and never-run states.
                """
            method manual
        }
        check opt-in-and-bounded {
            statement """
                Opening Home performs no repository command; service fixtures enforce bounded output, no automatic repository hooks, and unchanged tile geometry when status updates.
                """
            method command
        }
    }
    implements [ @legeos.constraint.services-not-indicators ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.home-project-tool-actions/1 : work {
    title "Add semantic project actions across Home, Projects1 and native Files"
    state active
    scope [
        path "apps/lege-files/**",
        path "crates/lege-field/**",
        path "interfaces/dbus/org.legeos.Projects1.xml",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Make Enter Project, Launch Tool and Restore Workspace distinct actions; add native Files project creation from the selected real directory; resolve Terminal and FileManager through providers; settle an additive CodeEditor role before implementing Editor; and migrate ordinary automatic running-window selection to the taskbar while preserving explicit project/session relationships.
        """
    note """
        Reuse Projects1.SetCurrent for Enter and Projects1.Open for Restore. Do not route selected-directory creation through generic grouping that invents ~/Projects/<id>. Home summaries open full native Files windows instead of embedding a second browser.

        2026-09-07, implemented. ProviderRole::CodeEditor is additive; the capability JSON schema's role enum was also missing `terminal` and `file-search`, so a manifest declaring the terminal role had been failing validation against a role the code accepted — fixed, and now held by a test that compares the enum to ProviderRole::ALL rather than trusting the two to be edited together. The shell's two per-role Option<AppId> fields became one BTreeMap<ProviderRole, AppId> fed by the existing Providers1.Report loop, so `open this at the project root` is one code path for all three tools.

        The sessiond half of enter-restore-separation is recorded as structural rather than tested: `set_current` contains no launch path at all and `open` is the only method that iterates project.apps, and no sessiond test can construct a ProjectsApi (it needs a live zbus::Connection, a LaunchBackend, a CheckpointTransport and a SqliteHistory, and none exists in that crate's test module). The wiring that could actually go wrong is in the shell — mapping Enter onto Open opens eight windows at somebody who asked to change context — so that is a pure function with a test.

        `project.create-here` is a native Files row only. It was briefly added to the shell browse pane's FILES_MENU as well, and removed: that pane has no handler for it, so the row would have done nothing. A test now asserts it is absent from FILES_MENU.
        """
    acceptance {
        check enter-restore-separation {
            statement """
                Enter changes current project without launching applications, while Restore launches only remembered applications and supported checkpoints.
                """
            method command
            command "cargo test -p lege-shell set_current_launches_nothing_and_open_launches_only_remembered_apps"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
        check files-create-project {
            statement """
                Native Files creates a project using the selected directory's real root, and project creation remains distinct from pinning it on Home.
                """
            method command
            command "cargo test -p lege-files a_project_takes_its_name_from_the_folder_and_a_usable_id_from_that"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
        check home-taskbar-migration {
            statement """
                A nested session shows stable Home project/folder placement, separate Files windows, ordinary taskbar switching and preserved explicit park/group/restore relationships.
                """
            method manual
        }
        check provider-scoped-tools {
            statement """
                Terminal, FileManager and the accepted CodeEditor role resolve through providers with typed arguments and the project root as working context; missing providers are explicit.
                """
            method command
            command "cargo test -p lege-shell each_project_tool_resolves_its_role_and_opens_at_the_root && cargo test -p lege-types every_role_is_in_the_capability_schema"
            verified_by [ @legeos.evidence.home-chips-projects-appearance-lock-20260907/1 ]
        }
    }
    depends_on [ @legeos.work.files-windows-bookmarks-home-objects-20260907/1 ]
    implements [ @legeos.decision.home-projects-and-tool-actions ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.home-purity-20260908/1 : work {
    title "Home holds only your own things — the file manager works, running windows and the machine's instruments leave Home"
    state proposed
    scope [
        path "apps/lege-settings/**",
        path "crates/lege-appd/**",
        path "shell/lege-shell/**"
    ]
    intent """
        A hands-on run of the installed session on 2026-09-08 found the file manager doing nothing from Home, unselectable in Settings, and absent from the launcher under its own name; and found Home crowded with things that are not the user's own — a tile per running window, a container tile per window group, a Session, a Notifications and a Settings tile, a plate labelled "Home" standing on Home, and a permanent Help button. docs/garden/garden.md draws the line this work applies: Home deals with your stuff, the bar deals with the machine.

        Four root causes, all read off the source rather than guessed. (1) The shell fetched only the `terminal` and `file-search` provider roles, so `providers[FileManager]` was never filled and every folder press took `open_in_file_manager`'s "no file manager is selected" branch on a session that had one selected. (2) The Files object's tile still launched `org.legeos.Files` by name — an application this desktop no longer ships — instead of routing through the role. (3) `derive_manifest` parsed `OnlyShowIn`/`NotShowIn` and threw them away, so `/etc/xdg/autostart/lxqt-desktop.desktop` (`OnlyShowIn=LXQt`, running `pcmanfm-qt --desktop`) won the default-variant election and the launcher's only row for PCManFM-Qt was named "Desktop" and painted a desktop. (4) The provider chooser's label was "name (import id) · priority N" in a 300px field, which elided inside the parenthesis and told the reader neither which application it was nor what its priority was.

        And the subtraction: `merge_sessions` and `merge_window_groups` placed a tile for every running window and every group; `merge_system` placed the three machine widgets and `merge_panels` grouped them into a shelf. All are deleted. The merge's existing sweep removes what a saved field still carries, with no migration of its own — `wanted` never names a window tile — and one `migrate_system_tiles` takes off all seven retired system probes as ordinary invertible `Remove` ops.
        """
    target 2026-09-08
    note """
        Lane 1 of campaign 3, alongside Lane 2 (the bar: Home chip, taskbar with parked entries, machine cluster, real fullscreen) and Lane 3 (session edges and the launch observer).

        Two things this deliberately did NOT do, both recorded so a later session does not re-derive them. First, the three `WidgetDescriptor`s in `surface/widgets/mod.rs` are kept even though nothing places a `TileKind::System` tile any more: nothing but `merge_system` ever created one, so they are inert data, and deleting them would empty `WIDGETS`, strand `descriptor`/`regions_at`/the `field_screen` draw arm as dead code under `-D warnings`, and remove the `WidgetRegion` pointer routes `xtask check-actions` reads. Second, `FieldScreen`'s `ParkedSession`/`WindowGroup` drawing and interaction arms are kept and still tested, through a `#[cfg(test)]` `field_model::place_window_tiles` seeder, because the bar's taskbar and its hover row are the successor consumer of exactly that code; both carry a `// ponytail:` comment naming the cleanup.

        No new transient notification card was needed: `surface/app.rs::ensure_toast` already creates a real `Layer::Notification` surface for each new arrival, painted by `redraw_toast` and watermarked by `last_toasted_id`. The tile left with the rest of the shelf; the toast is what remains, which is what "absence by default" asked for.

        One finding that loosened the campaign's ordering: `xtask::check_actions` only requires a pointer route for actions that carry a chord, and none of `session.*`, `settings.open`, `volume.*`, `brightness.*` or `notifications.clear` does. So Home could shed the machine widgets before the bar's cluster landed without breaking the gate. `field.help` and `home.reveal` keep both their chord and their `context_menu.rs` row.
        """
    depends_on [ @legeos.work.bottom-bar-taskbar ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.home-review-usability-20260905/1 : work {
    title "Home review: reachable context menus and current-directory terminals"
    state completed
    intent """
        Repair existing Home interaction routes: keep long context menus within the output with pointer paging, wheel and keyboard access to every row; expose existing Copy/Cut file verbs; allow Open terminal here on directory ground independently of selection. Keep Help text readable with scrolling and a fixed close route. Folder windows report failed reads rather than remaining in reading state, reset scrolling on upward navigation, and reserve space for truncation notices. Preserve manifest actions, service ownership, saved geometry and the application-only Home launcher.
        """
    note """
        Continued at the user's request in branch home-review-20260905 in ../LegeOS-home-review from 94c2954, carrying the four shell source files already modified by this review; the folder error-state change in app.rs was added only in the isolated worktree. Earlier partial edits remain in the active tree; subsequent edits and validation are isolated. Extrapolated ideas remain proposals under @legeos.work.home-developer-setup-preview and @legeos.work.home-project-development-status. The full folder interaction parity gap is recorded in the audit rather than treated as a new default layout decision.
        """
    acceptance {
        check lint {
            statement """
                Changed shell code passes strict clippy.
                """
            method command
            command "cargo clippy -p lege-shell --all-targets -- -D warnings"
            verified_by [ @legeos.evidence.home-review-lint-20260905 ]
        }
        check regressions {
            statement """
                Small-screen menu navigation keeps visible hit targets inside the menu and reaches the last row; directory terminal requests work without selection and row requests preserve their target; shell regressions pass.
                """
            method command
            command "cargo test -p lege-shell"
            verified_by [ @legeos.evidence.home-review-tests-20260905 ]
        }
    }
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.home-shelf-and-representation-ladder/1 : work {
    title "A route back off the shelf, a way to reset the field, and the representation ladder for drawer tiles"
    state completed
    scope [
        path "crates/lege-field/**",
        path "crates/lege-types/src/action.rs",
        path "shell/lege-shell/**"
    ]
    intent """
        Close the three gaps the reshape work exposed, all of them about showing and hiding information deliberately rather than by accident.

        One: a tile on the shelf is unreachable (@legeos.observation.shelved-tiles-have-no-route-back). Needs the shelf enumerated somewhere a person can see it and a `field.restore` action to bring a tile back, declared in the manifest like every other action so it reaches the menu, the cheat sheet and the CLI at once.

        Two: nothing resets a field to its defaults. `merge` is add-only by design — it never moves a tile the user placed — so every layout improvement is invisible to anyone with a saved field, and a field that has drifted into a mess can only be repaired tile by tile. `lege_field::reflow::tidy` exists as the packing primitive and has no command above it.

        Three: drawer tiles do not climb the representation ladder that `docs/homefield.md` describes and the system widgets already implement. A drawer clips its raw text lines to whatever height it has, so a short tile shows a truncated path rather than the 'name, count, content-colour band' the design calls for at the compact rung. The data is unstructured text today, so this likely needs the drawer feed to carry a count and a headline separately from its lines.
        """
    note """
        Opened from the reshape work rather than planned: the first two were only visible once `--print field` stopped describing a hypothetical field, and the third once tiles were drawn at their true size.
        """
    acceptance {
        check drawers-climb-the-ladder {
            statement """
                A drawer tile too small for its listing shows a headline figure or count rather than the listing clipped, and reveals the listing once it reaches Representation::Wide.
                """
            method command
            command "cargo test -p lege-shell --lib drawers::"
            verified_by [ @legeos.evidence.shelf-reset-and-drawer-ladder-20260831 ]
        }
        check field-can-be-reset {
            statement """
                The stored layout and its undo log can be discarded so the current default layout is adopted, and the action confirms first because it is not undoable.
                """
            method command
            command "busctl --user call org.legeos.Session /org/legeos/Session/HomeField org.legeos.HomeField1 Reset sqq <output> <cols> <rows>"
            verified_by [ @legeos.evidence.shelf-reset-and-drawer-ladder-20260831 ]
        }
        check gates-green {
            statement """
                Workspace tests, clippy with warnings denied, rustfmt and all seven xtask gates pass.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
            verified_by [ @legeos.evidence.shelf-reset-and-drawer-ladder-20260831 ]
        }
        check shelf-has-a-route-back {
            statement """
                A stashed tile can be brought back onto the field from a surface, not only by an immediate undo, and the route is offered only when the shelf is occupied.
                """
            method command
            command "cargo test -p lege-shell --lib restoring_brings_every_shelved_tile_back a_row_is_offered_only_where_it_could_be_performed"
            verified_by [ @legeos.evidence.shelf-reset-and-drawer-ladder-20260831 ]
        }
    }
    derived_from [ @legeos.observation.shelved-tiles-have-no-route-back ]
    part_of [ @legeos.work.home-widgets ]
}

record legeos.work.home-surface-usability-next/1 : work {
    title "Next Home usability sequence — adaptable Home, complete folder surfaces, then common Settings"
    state active
    scope [
        path "apps/lege-files/**",
        path "apps/lege-settings/**",
        path "compositor/lege-comp/**",
        path "crates/lege-field/**",
        path "crates/lege-window/**",
        path "services/lege-filed/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Carry the Home surface from a fixed demonstration layout to an ordinary daily desktop in the order set by the user on 2026-08-31.

        First, make Home itself adaptable: configurable Home-only panels/rails/docks, automatic panel layouts for different output shapes, user-invoked arrangements for all open windows, and immediate reversible switching among those arrangements. Preserve truly chrome-free fullscreen application work and refine bare Super from release-only toggling into immediate press/hold Home reveal with shortcut-safe semantics.

        Second, make folders and composite shortcut panes the Home file objects. Build copy/cut/paste, drag and drop, delete/trash and the remaining ordinary file verbs on the multi-selection foundation; then add deterministic sorting and list-versus-thumbnail presentation. Loose individual file tiles are explicitly not part of this model.

        Third, make the graphical Settings app adjust the common controls a person expects: resolution/refresh/rotation/scale, mouse and trackpad behaviour, and appearance/theme/material choices. Accessibility remains deferred behind these product-completeness items per the user's standing priority.
        """
    note """
        Progress 2026-08-31: steps one and two are complete — Super press/hold reveal, Home panels with Balanced/Rail/Cushion arrangements, reversible window arrangement presets, placeable folders and shortcut panes, ordinary file operations with typed drag/drop and one journalled undo, deterministic sorting plus list/thumbnail modes, and the wl_data_device transport all landed with their records completed. The one remaining child is @legeos.work.home-field-settings-gui, whose two pre-implementation design questions (the compositor configuration channel, and making design.rs palette-driven) are surveyed on that record.
        """
    depends_on [ @legeos.work.home-field-selection-and-bulk-action ]
    derived_from [ @legeos.assessment.home-field-usability-gaps-20260831 ]
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-field ]
}

record legeos.work.home-visible-and-output-screenshot/1 : work {
    title "Lane 1 — Home visible unless covered, and a whole-output screenshot the trusted shell can take"
    state active
    scope [
        path "compositor/**",
        path "crates/lege-window/**",
        path "interfaces/wayland/lege-shell-v1.xml",
        path "shell/lege-shell/src/main.rs",
        path "shell/lege-shell/src/screenshot.rs"
    ]
    intent """
        Fix the black screen at login (Home hidden unless revealed) and give the project a way to see its own desktop: an `ext-image-capture-source-v1` output source filtered to the trusted shell, plus `lege-shell --screenshot PATH.png`.
        """
    note """
        A `lege-comp` integration test that a maximized toplevel unmaps Home was deliberately not written. The crate has no harness that can build a `LegeCompState` with mapped surfaces — every test module in it is pure, and `Space` mapping needs real `wl_surface`s from a real client — so the fixture would cost far more than the fact is worth, given `WindowService::is_visible` owns that decision exclusively and `space_sync` consults nothing else. The predicate table test in `lege-window` is the authority; the nested-session run (compositor log plus screenshots) is the end-to-end evidence. Coordinator accepted this deferral on 2026-09-07.
        """
    acceptance {
        check capture-globals-are-shell-only {
            statement """
                A client on the ordinary Wayland socket is not offered the output, toplevel or copy-capture globals, and a client on the trusted-shell socket is.
                """
            method command
            command "cargo test -p lege-comp"
            verified_by [ @legeos.evidence.capture-globals-stay-shell-only ]
        }
        check crates-green {
            statement """
                lege-window, lege-comp and lege-shell build clean under pedantic clippy, their tests pass, and the interface gates are unchanged.
                """
            method command
            command "cargo test -p lege-shell && cargo clippy -p lege-window -p lege-comp -p lege-shell --all-targets"
            verified_by [ @legeos.evidence.lane-1-crates-clean ]
        }
        check home-predicate-table {
            statement """
                lege-window proves Home is visible with no windows and with a floating window, hidden by a maximized or fullscreen client, unaffected by a shelved one or by a maximized window on another output, and always visible during a reveal.
                """
            method command
            command "cargo test -p lege-window"
            verified_by [ @legeos.evidence.home-visibility-predicate-table ]
        }
        check installed-session-logs-in-to-home {
            statement """
                After a logout and log back in, the installed LegeOS session shows the Home Field immediately, with no Super press, and hides it only when a window is maximized or fullscreen.
                """
            method manual
        }
        check nested-session-behaviour {
            statement """
                In a nested session the compositor log shows the Home surface mapped at start with no reveal, still mapped with a floating window, unmapped only while a maximized client is up, and mapped again when it closes; lege-shell --screenshot writes a correctly oriented PNG of each of those three states.
                """
            method observation
            verified_by [ @legeos.evidence.nested-home-visibility-and-screenshot ]
        }
    }
    implements [ @legeos.decision.home-surface-visible-unless-covered ]
    part_of [ @legeos.work.files-windows-bookmarks-home-objects-20260907 ]
}

record legeos.work.home-widget-foundations/1 : work {
    title "Home Field widget foundations — neighbour-yielding resize, the widget contract, the action manifest, and Lifecycle1 as the service pattern"
    state superseded
    scope [
        path "cli/lege/src/lifecycle.rs",
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-field/**",
        path "crates/lege-types/src/action.rs",
        path "crates/lege-window/src/geometry.rs",
        path "interfaces/dbus/org.legeos.Session.Lifecycle1.xml",
        path "services/lege-sessiond/src/apis/lifecycle.rs",
        path "shell/lege-shell/**"
    ]
    intent """
        The Home Field was a dead end for a desktop tester: no way to launch anything, no logout/restart/shutdown, no way to close a window, and a search bar that does nothing outside an expanded drawer. The decision is that every missing capability arrives as a widget on the one screen rather than as a panel or tray, consistent with M2's taskbar-free commitment. This item builds only the foundation those widgets stand on, in four parts. (1) A resize that lets adjacent tiles give up span instead of being evicted: reflow::find_resize, where a yielding neighbour keeps its far edge and the request is clamped to the largest span every neighbour can absorb. (2) The widget contract over TileKind::System, which was a designed-for slot nothing constructed: a descriptor declares what shows at each representation rung and which regions are clickable, and each region names an action rather than coding a behaviour. (3) An action manifest in lege-types, so one declaration drives the shell's labels, the keyboard accelerator and the lege verb. (4) org.legeos.Session.Lifecycle1 on sessiond forwarding to logind, built as the one worked example of the service-interface pattern every future widget follows.
        """
    note """
        The individual widgets — launcher, volume, brightness, battery, notifications, tray — are deliberately out of scope and planned separately against this foundation.

        Three findings worth carrying forward. First, no new op or inverse machinery was needed for neighbour yielding: Placement already carries a span, Located wraps it, and Layout restores it, so moved_back captures a neighbour's prior size for free and the document format is unchanged. Second, the default drawer block is packed at the 2x2 widget floor, so no drawer on the default field can grow — correct under the clamp rule the user chose, but it makes the resize gesture look inert on first use and is a defaults decision still to be made. Third, Super+Left/Right was implemented in the compositor over window geometry (lege_window::geometry::contiguous_window) rather than over the shell's tile layout as first planned: it needs no wire-protocol bump, keeps working with the shell dead like every other reserved chord, and stays inside the compositor's own remit since it reasons only about windows.

        Lock is declared in Lifecycle1 and returns NotSupported. The compositor implements ext-session-lock-v1 in full but nothing drives it; making Lock real means giving sessiond a Wayland lock-manager client, which is its own work item.
        """
    depends_on [
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
}

record legeos.work.home-widget-foundations/2 : work {
    title "Home Field widget foundations — neighbour-yielding resize, the widget contract, the action manifest, and Lifecycle1 as the service pattern"
    state superseded
    scope [
        path "cli/lege/src/lifecycle.rs",
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-field/**",
        path "crates/lege-types/src/action.rs",
        path "crates/lege-window/src/geometry.rs",
        path "interfaces/dbus/org.legeos.Session.Lifecycle1.xml",
        path "services/lege-sessiond/src/apis/lifecycle.rs",
        path "shell/lege-shell/**"
    ]
    intent """
        The Home Field was a dead end for a desktop tester: no way to launch anything, no logout/restart/shutdown, no way to close a window, and a search bar that does nothing outside an expanded drawer. The decision is that every missing capability arrives as a widget on the one screen rather than as a panel or tray, consistent with M2's taskbar-free commitment. This item builds only the foundation those widgets stand on, in four parts. (1) A resize that lets adjacent tiles give up span instead of being evicted: reflow::find_resize, where a yielding neighbour keeps its far edge and the request is clamped to the largest span every neighbour can absorb. (2) The widget contract over TileKind::System, which was a designed-for slot nothing constructed: a descriptor declares what shows at each representation rung and which regions are clickable, and each region names an action rather than coding a behaviour. (3) An action manifest in lege-types, so one declaration drives the shell's labels, the keyboard accelerator and the lege verb. (4) org.legeos.Session.Lifecycle1 on sessiond forwarding to logind, built as the one worked example of the service-interface pattern every future widget follows.
        """
    note """
        STATUS FOR A HANDOFF: all four parts are implemented, tested and lint-clean, and the ledger's evidence covers everything except `hands-on-at-a-real-desktop`, which is the one outstanding check. Nothing here needs rewriting; the next step is to run it on a real desktop and then complete this record. Follow-on work is @legeos.work.home-widgets and its children.

        The individual widgets — launcher, volume, brightness, battery, notifications, tray — are deliberately out of scope here and planned separately against this foundation.

        Decisions the user made that shaped the design, and that a successor should not quietly reverse. Contiguity is navigation-only: it scopes which window a chord moves to, is recomputed per keypress and never persisted, which is what keeps it compatible with homefield.md's rule that adjacency must not imply a relationship. A resize that outruns its neighbours clamps rather than evicting or cascading. Session power actuation lives in sessiond over logind, not in lege-hostd, so shutting down your own laptop needs no administrator prompt and ADR-0003's scope for the privileged daemon is untouched.

        Three findings worth carrying forward. First, no new op or inverse machinery was needed for neighbour yielding: Placement already carries a span, Located wraps it, and Layout restores it, so moved_back captures a neighbour's prior size for free and the document format is unchanged — this is why the change is as small as it is. Second, the default drawer block is packed at the 2x2 widget floor, so no drawer on the default field can grow; correct under the clamp rule, but it makes the gesture look inert on first use — see @legeos.question.home-field-default-density. Third, Super+Left/Right was implemented in the compositor over window geometry (lege_window::geometry::contiguous_window) rather than over the shell's tile layout as first planned: it needs no wire-protocol bump, keeps working with the shell dead like every other reserved chord, and stays inside the compositor's remit since it reasons only about windows.

        Lock is declared in Lifecycle1 and returns NotSupported. The compositor implements ext-session-lock-v1 in full but nothing drives it; see @legeos.work.session-lock-client.
        """
    acceptance {
        check hands-on-at-a-real-desktop {
            statement """
                At a real desktop: drag a tile's corner into free space and nothing else moves; drag it into a neighbour and the neighbour narrows in place without jumping; keep dragging and the ghost visibly stops while the pointer runs on; Ctrl+Z restores both sizes. The Session widget's Shut down arms on the first click and fires on the second. Super+Left/Right steps between windows, and still cycles by stacking order with lege-shell killed.
                """
            method manual
        }
        check invariants-unmodified {
            statement """
                lege-field's four pre-existing properties — ops_keep_invariants_and_invert_exactly, placing_moves_only_band_mates, placement_is_deterministic, content_changes_move_nothing — still pass with no edit to them. Editing one to accommodate the resize would mean the design is wrong.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check no-maximize-in-the-widget-system {
            statement """
                No non-container tile can be resized to cover its whole grid; widgets can nonetheless grow, which before this work they could not do at all.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check one-declaration-three-surfaces {
            statement """
                Every action a shell surface performs is declared in lege_types::action, every declared CLI verb reaches a real lege subcommand, and the compositor's fixed recovery chords agree with what the manifest says they do without the compositor reading the manifest at run time.
                """
            method command
            command "cargo run -q -p xtask -- check-actions && cargo test -p lege-comp"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check resize-inverts-exactly {
            statement """
                Undo restores every affected tile's size as well as its position, with no new op and no change to DOCUMENT_VERSION.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check resize-yields-not-evicts {
            statement """
                Growing a tile into a neighbour narrows that neighbour against its own far edge; nothing is relocated, and a request past what neighbours can give is clamped to the largest achievable span rather than refused or paid for by an eviction.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check session-can-be-ended {
            statement """
                org.legeos.Session.Lifecycle1 forwards logout/reboot/poweroff/suspend to logind behind a testable seam, the Session widget offers them with a confirm step, `lege session` reaches the same verbs, and the interface XML ships in legeos-sessiond.
                """
            method command
            command "cargo test -p lege-sessiond -p lege && cargo run -q -p xtask -- check-interfaces"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check shell-still-runs {
            statement """
                Nested, the shell connects to lege_shell_v1, declares Layer::HomeSurface and renders the new draw paths without error or panic.
                """
            method manual
            verified_by [ @legeos.evidence.widget-foundations-nested-run-20260825 ]
        }
        check widget-contract-is-data-driven {
            statement """
                A TileKind::System tile renders through a declared descriptor: what it shows per representation rung, and which regions are clickable. Region hit-testing is generic, with no per-widget arm in the painter.
                """
            method command
            command "cargo test -p lege-shell"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
    }
    depends_on [
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
    supersedes [ @legeos.work.home-widget-foundations/1 ]
}

record legeos.work.home-widget-foundations/3 : work {
    title "Home Field widget foundations — neighbour-yielding resize, the widget contract, the action manifest, and Lifecycle1 as the service pattern"
    state active
    scope [
        path "cli/lege/src/lifecycle.rs",
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-field/**",
        path "crates/lege-types/src/action.rs",
        path "crates/lege-window/src/geometry.rs",
        path "interfaces/dbus/org.legeos.Session.Lifecycle1.xml",
        path "services/lege-sessiond/src/apis/lifecycle.rs",
        path "shell/lege-shell/**"
    ]
    intent """
        The Home Field was a dead end for a desktop tester: no way to launch anything, no logout/restart/shutdown, no way to close a window, and a search bar that does nothing outside an expanded drawer. The decision is that every missing capability arrives as a widget on the one screen rather than as a panel or tray, consistent with M2's taskbar-free commitment. This item builds only the foundation those widgets stand on, in four parts. (1) A resize that lets adjacent tiles give up span instead of being evicted: reflow::find_resize, where a yielding neighbour keeps its far edge and the request is clamped to the largest span every neighbour can absorb. (2) The widget contract over TileKind::System, which was a designed-for slot nothing constructed: a descriptor declares what shows at each representation rung and which regions are clickable, and each region names an action rather than coding a behaviour. (3) An action manifest in lege-types, so one declaration drives the shell's labels, the keyboard accelerator and the lege verb. (4) org.legeos.Session.Lifecycle1 on sessiond forwarding to logind, built as the one worked example of the service-interface pattern every future widget follows.
        """
    note """
        2026-09-08, campaign 3: part (2) of this work - the widget contract over TileKind::System - is
        retired as a thing Home places. merge_system places no system widget, and a migration removes
        the tiles from existing fields. The WidgetDescriptors stay in the shell's widgets module,
        inert and marked as such, because they are the only written record of the contract. Parts (1)
        neighbour-yielding resize, (3) the action manifest and (4) Lifecycle1 as the service pattern
        all stand, and (4) grew this session: Lifecycle1 now also carries the session's own edges
        (see legeos.observation.session-time-enters-sessiond-at-four-edges). Successor for the widgets
        themselves: the bar's machine cluster - see @legeos.observation.home-chrome-retired-to-the-bar-and-the-garden.
        """
    acceptance {
        check hands-on-at-a-real-desktop {
            statement """
                At a real desktop: drag a tile's corner into free space and nothing else moves; drag it into a neighbour and the neighbour narrows in place without jumping; keep dragging and the ghost visibly stops while the pointer runs on; Ctrl+Z restores both sizes. The Session widget's Shut down arms on the first click and fires on the second. Super+Left/Right steps between windows, and still cycles by stacking order with lege-shell killed.
                """
            method manual
        }
        check invariants-unmodified {
            statement """
                lege-field's four pre-existing properties — ops_keep_invariants_and_invert_exactly, placing_moves_only_band_mates, placement_is_deterministic, content_changes_move_nothing — still pass with no edit to them. Editing one to accommodate the resize would mean the design is wrong.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check no-maximize-in-the-widget-system {
            statement """
                No non-container tile can be resized to cover its whole grid; widgets can nonetheless grow, which before this work they could not do at all.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check one-declaration-three-surfaces {
            statement """
                Every action a shell surface performs is declared in lege_types::action, every declared CLI verb reaches a real lege subcommand, and the compositor's fixed recovery chords agree with what the manifest says they do without the compositor reading the manifest at run time.
                """
            method command
            command "cargo run -q -p xtask -- check-actions && cargo test -p lege-comp"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check resize-inverts-exactly {
            statement """
                Undo restores every affected tile's size as well as its position, with no new op and no change to DOCUMENT_VERSION.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check resize-yields-not-evicts {
            statement """
                Growing a tile into a neighbour narrows that neighbour against its own far edge; nothing is relocated, and a request past what neighbours can give is clamped to the largest achievable span rather than refused or paid for by an eviction.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check session-can-be-ended {
            statement """
                org.legeos.Session.Lifecycle1 forwards logout/reboot/poweroff/suspend to logind behind a testable seam, the Session widget offers them with a confirm step, `lege session` reaches the same verbs, and the interface XML ships in legeos-sessiond.
                """
            method command
            command "cargo test -p lege-sessiond -p lege && cargo run -q -p xtask -- check-interfaces"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check shell-still-runs {
            statement """
                Nested, the shell connects to lege_shell_v1, declares Layer::HomeSurface and renders the new draw paths without error or panic.
                """
            method manual
            verified_by [ @legeos.evidence.widget-foundations-nested-run-20260825 ]
        }
        check widget-contract-is-data-driven {
            statement """
                A TileKind::System tile renders through a declared descriptor: what it shows per representation rung, and which regions are clickable. Region hit-testing is generic, with no per-widget arm in the painter.
                """
            method command
            command "cargo test -p lege-shell"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
    }
    depends_on [
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
    supersedes [ @legeos.work.home-widget-foundations/2 ]
    supported_by [ @legeos.observation.home-chrome-retired-to-the-bar-and-the-garden ]
}

record legeos.work.home-widget-launcher/1 : work {
    title "Launcher widget — make a cold session able to open its first application"
    state superseded
    scope [
        path "crates/lege-appd/src/dbus.rs",
        path "crates/lege-appd/src/desktop_entry.rs",
        path "crates/lege-types/src/app.rs",
        path "shell/lege-shell/src/icons.rs",
        path "shell/lege-shell/src/surface/widgets/**"
    ]
    intent """
        A launcher widget that lists installed applications, filters as the user types, and launches through Launcher1. This is the single most load-bearing gap: without it a freshly booted session cannot open anything at all, because application tiles are derived from windows that already exist (field_model::merge_apps) and are removed when the last one closes. The inventory is already in the shell — AppIdentity1.ListApps is fetched every three seconds into ShellApp::apps and its only consumer today is a grep for nm-tray — and Launcher1.Launch already works and is already called for the network control and for opening files. The widget itself is small; the prerequisites below are not.
        """
    note """
        STATUS FOR A HANDOFF: implemented, tested and lint-clean; see @legeos.evidence.home-widget-launcher-20260825. All three prerequisites landed: AppManifest carries icon/categories/keywords/NoDisplay with serde defaults so pre-upgrade manifests still parse; NoDisplay is recorded not filtered (the entry must import so MIME associations resolve, listings exclude it client-side); a new AppIdentity1.ListApplications returns the full rows. icons.rs now reverses the desktop-import namespacing via IconHints{icon, desktop_file_ids} and rasterizes SVG through resvg 0.45 (default-features off — no font stack, licences checked against deny.toml's allow-list by reading cargo metadata since cargo-deny is not installed here). app_search is a pure module with a total sort key so redraws cannot reshuffle. The launcher is the second WidgetDescriptor over TileKind::System; system_landing now places the two system widgets in opposite bottom corners. The field search bar is live on the home screen: typing filters the launcher, Enter launches the best match.

        The one outstanding check is hands-on at a real desktop, same as the foundations record; complete this after that run.

        FOR A SUCCESSOR: (1) `lege app list` still uses ListApps and shows bare ids — ListApplications is there if the CLI wants names and NoDisplay filtering. (2) SVG icons that are pure typography render shapes only (resvg font stack is off). (3) desktop_file_candidates cannot reverse derive_app_id's sanitiser for ids with characters outside [A-Za-z0-9.-_]; the shell always passes IconHints from the registry so this only bites a caller that does not. (4) No index.theme parsing or theme inheritance yet — only hicolor and /usr/share/pixmaps are walked. (5) The zoom test now stashes system tiles first; the real signal underneath is that eight drawers plus two system widgets crowd a small field — see @legeos.question.home-field-default-density.
        """
    part_of [ @legeos.work.home-widgets ]
    verified_by [ @legeos.evidence.home-widget-launcher-20260825 ]
}

record legeos.work.home-widget-launcher/2 : work {
    title "Launcher widget — make a cold session able to open its first application"
    state active
    scope [
        path "crates/lege-appd/src/dbus.rs",
        path "crates/lege-appd/src/desktop_entry.rs",
        path "crates/lege-types/src/app.rs",
        path "shell/lege-shell/src/icons.rs",
        path "shell/lege-shell/src/surface/widgets/**"
    ]
    intent """
        A launcher widget that lists installed applications, filters as the user types, and launches through Launcher1. This is the single most load-bearing gap: without it a freshly booted session cannot open anything at all, because application tiles are derived from windows that already exist (field_model::merge_apps) and are removed when the last one closes. The inventory is already in the shell — AppIdentity1.ListApps is fetched every three seconds into ShellApp::apps and its only consumer today is a grep for nm-tray — and Launcher1.Launch already works and is already called for the network control and for opening files. The widget itself is small; the prerequisites below are not.
        """
    note """
        2026-09-08, campaign 3: the launcher survives on Home unchanged - finding an application is
        "your stuff", not the machine - but two of the things this record leaned on were wrong.
        derive_manifest parsed OnlyShowIn/NotShowIn and threw them away, so
        /etc/xdg/autostart/lxqt-desktop.desktop (OnlyShowIn=LXQt, first_seen_ms=0) won the
        default-variant election for pcmanfm-qt and the only row a search for "pcman" found was named
        "Desktop" and launched pcmanfm-qt --desktop. And the shell fetched only the terminal and
        file-search roles, so providers[FileManager] was always None and every folder press took the
        "no file manager is selected" branch on a session that had one selected. Both are fixed;
        SHELL_ROLES is now the one list. The "launcher" probe name is in the retirement migration's
        sweep because an old field may still carry a tile for it - see @legeos.observation.home-chrome-retired-to-the-bar-and-the-garden.
        """
    part_of [ @legeos.work.home-widgets ]
    supersedes [ @legeos.work.home-widget-launcher/1 ]
    supported_by [ @legeos.observation.home-chrome-retired-to-the-bar-and-the-garden ]
    verified_by [ @legeos.evidence.home-widget-launcher-20260825 ]
}

record legeos.work.home-widget-notifications/1 : work {
    title "Notification widget — the tile and the read-back path shipped; per-notification dismiss, actions and any push remain"
    state completed
    scope [
        path "cli/lege/**",
        path "crates/lege-state/src/migrations/session.rs",
        path "services/lege-sessiond/src/apis/notifications.rs",
        path "shell/lege-shell/src/surface/widgets/**"
    ]
    intent """
        Superseded in part by what shipped on 2026-08-30. Revision 1's premise — that the shell contains no notification rendering whatsoever, and that sessiond offers no read-back — no longer holds. org.legeos.Notifications1 serves ListActive, Dismiss, ClearAll and a Changed signal alongside the full org.freedesktop.Notifications implementation, and the shell has a notifications system widget (shell/lege-shell/src/surface/widgets/mod.rs:144) showing a headline count and up to three app — summary lines, with a clear-all region wired to ClearAll.

        What remains is most of what makes notifications useful. There is no per-notification dismiss, only bulk clear. A notification's actions cannot be invoked from the shell — ActionInvoked is served but never emitted by any surface — so a notification offering Reply or Open is decorative. Nothing is pushed: no toast, no OSD, nothing appears unprompted, so a notification is seen only if the user happens to look at the tile, which for a message or a finished job is close to not being notified at all. The three-line cap does not grow with the tile.

        History is readable through Settings — History or lege settings --page history, so nothing is lost; it is just not surfaced where a user would look.
        """
    note """
        Revised 2026-08-31 by the Home Field usability audit, which found revision 1's no-rendering premise stale. The remaining gap is push and per-item action, not rendering.
        """
    derived_from [ @legeos.assessment.home-field-usability-gaps-20260831 ]
    part_of [ @legeos.work.home-widgets ]
}

record legeos.work.home-widget-status-instruments/1 : work {
    title "Volume, brightness and battery widgets, and the services they need — none of which exist yet"
    state completed
    scope [
        path "cli/lege/**",
        path "interfaces/dbus/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/src/surface/widgets/**"
    ]
    intent """
        Volume, brightness and battery as widgets, each backed by a service interface following the Lifecycle1 pattern. All three are absent from the whole repository, not merely from the shell: there is no audio client of any kind (no PipeWire, PulseAudio or ALSA code — the only mentions are cgroup protections naming the pipewire and wireplumber units so the resource governor never kills them), no backlight code, and no battery reading. crates/lege-hwdetect is GPU detection only. So each of these is a service to write first and a widget second, which is the order services-not-indicators requires anyway.
        """
    note """
        org.legeos.Power1's module doc claims the domain is "idle, lid, brightness and battery via logind/upower", and none of that integration exists: Power1 is eighty-five lines of get/set/reset over a stored PowerProfile, and nothing anywhere reads its dim_after, screen_off_after, lock_after or suspend_after durations and acts on them. There is no idle watcher, no ext-idle-notify-v1, no lid handling. So a second, honest piece of scope sits next to the widgets: either make Power1's policy real or narrow its documentation to what it does. A battery widget that reports charge while the machine never dims or suspends would be a strange thing to ship.

        ProviderRole::PowerManager exists and no application fills it. Related risk already flagged during the foundations work: the shell's power routing calls org.legeos.Session directly, so if a third-party power manager is ever selected through Providers1 the one-provider-per-role model is silently bypassed. Decide the routing rule before, not after, more power surfaces exist.
        """
    depends_on [ @legeos.constraint.services-not-indicators ]
    part_of [ @legeos.work.home-widgets ]
}

record legeos.work.home-widgets/1 : work {
    title "Home Field widgets — every missing desktop capability as a tile on the one screen"
    state proposed
    scope [
        path "cli/lege/**",
        path "crates/lege-appd/**",
        path "crates/lege-types/**",
        path "interfaces/dbus/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        A gap review of the Home Field against what any desktop of the last twenty years offers found that a cold session gives the user eight drawer tiles and the message "open an application and it will appear", with no way to open one. Application tiles are derived only from windows that are already running and are removed when the last one closes, so the launcher route is circular. There is no logout, restart, shutdown, suspend or lock; no way to close a window; no volume, brightness or battery; no notification rendering despite sessiond hosting the notification server; no context menus; and the field's own search bar does nothing outside an expanded drawer. The decision is that each of these arrives as a widget on the single screen — information first, sub-clickable, opening a window only as a deliberate second step — rather than as a panel, a dock or a tray, which is consistent with M2's taskbar-free commitment and with homefield.md's rule that the launcher is inventory and the home screen is working memory. @legeos.work.home-widget-foundations built the framework; this item is the umbrella for the widgets themselves and for the window controls that are still missing.
        """
    note """
        Each child is independently landable against the finished foundation. Read @legeos.work.home-widget-foundations' note first: it records the constraints the user set (clamp rather than evict, navigation-only contiguity, session power over logind) which apply to every child here.

        Two rules from the foundation govern all of this work. The shell renders and forwards; policy lives in a service behind a D-Bus interface, so each widget needs a backing interface before it needs pixels — Lifecycle1 is the worked example to copy. And every capability must be declared once in lege_types::action, which is what puts it in the widget's regions, the cheat sheet and `lege` together; `cargo run -p xtask -- check-actions` fails the build when a surface performs an action nobody declared.

        Amended 2026-09-08 (@legeos.work.home-purity-20260908). The widget contract stands and so does the capability review that produced this umbrella: every gap named in the intent is still a gap that must be filled, and the shell-renders/service-decides and declare-once-in-the-manifest rules are unchanged. What changes is *where* three of them are shown. Session, Notifications and Settings are the machine's business, and docs/garden/garden.md puts the machine on the bar and the user's own things on Home, so those three leave Home for the bar's cluster (@legeos.work.bottom-bar-taskbar) and Home places no `TileKind::System` tile at all. Notifications keep no surface of their own on Home: a new arrival is the transient `Layer::Notification` toast `surface/app.rs::ensure_toast` already creates, and the history is behind the bar's cluster. The three `WidgetDescriptor`s remain declared but inert — nothing places them — and are the bar cluster's contract to draw against.
        """
    depends_on [
        @legeos.constraint.services-not-indicators,
        @legeos.work.home-widget-foundations
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
}

record legeos.work.homegarden-phases-0-3/1 : work {
    title "Homegarden Phases 0–3: the activity ledger and Garden Clock, the tender, tending at reveal and session start, and the rung-aware Place tile"
    state active
    scope [
        path "cli/lege/src/main.rs",
        path "crates/lege-field/src/garden.rs",
        path "crates/lege-session-core/src/homegarden.rs",
        path "crates/lege-session-core/src/settings.rs",
        path "crates/lege-state/src/migrations/session.rs",
        path "crates/lege-types/src/action.rs",
        path "interfaces/dbus/org.legeos.HomeGarden1.xml",
        path "services/lege-sessiond/src/apis/homegarden.rs",
        path "shell/lege-shell/src/garden.rs",
        path "shell/lege-shell/src/surface/field_screen.rs"
    ]
    intent """
        Build the Homegarden model far enough to judge it in a day's use (@legeos.decision.homegarden-activity-grown-places, docs/garden/*.md): (1) a pure ledger in lege-session-core with HomeActivity/HomeContext, weights bucketed per (kind, role, session) so breadth beats count, root attribution behind a RootProbe (project root, existing context, workspace marker, mount point, XDG user dir; never $HOME), an ignore list as a setting, a bounded activity tree (depth 3, 32 nodes), stages Dormant/Trace/Tile/Expanded with promotion by relevance+sessions+breadth and demotion only when later sessions AND garden-hours both pass, and a Garden Clock that advances at Lifecycle1's session edges and never on wall-clock; (2) a pure tender in lege-field (garden::tend) emitting Place/Resize/Remove with a reason each, never Move, a Place only on free cells, a Resize only when nothing but an unpinned un-user-sized garden tile yields, property-tested; (3) org.legeos.HomeGarden1 on sessiond (Observe/Tend/Contexts/Describe/Pin/Hide/Forget/ForgetAll/Clock, signal Tended) applying each tending as one HomeField1 batch, recorded in History1, with sources: the launch channel (directory arguments -> LaunchedHere with the app's role), the shell's brokered open (FileOpened), the session-edge channel (the clock); (4) the shell tends at session start and on every Home reveal edge, draws a grown Folder tile by rung (Small: name + state; Wide: + roles row of text-led tools; Large: + the branch body of used structure, heavier branches thicker, falling back to the listing), and offers place.open-* and garden.* through the one action manifest (context menu, cheat sheet, lege garden CLI). Settings shell.home-garden.* hold the levers; default on.
        """
    note """
        Deferred with reasons, to be built only if Phase 4 (a day's hands-on) judges the model right: growth forms/facets (Hierarchy/Media/Documents/Gallery), blooms (new/unwatched), material identity, sibling groups, a Wide-vs-Tall geometry axis (needs a Representation::for_span rewrite), the index change log and portal sources, the Settings app's Hidden-places list (lege garden unhide covers it), and PlacedOnHome/ProjectEntered observations inside sessiond's HomeField1.PlaceFolder and Projects1.SetCurrent (the launch and open sources are wired; those two are one call each in the next pass). Known limit: the shell observes folder navigation only through the file manager launch it causes (LaunchedHere), not the in-Home folder window's crumb.
        """
    acceptance {
        check a-place-grows-on-the-installed-session {
            statement """
                After opening two folders and a terminal in one directory and pressing Super, a 2x2 place for that directory appears at Home's bottom-left; lege garden why names the opens and the launch; nothing else moved.
                """
            method manual
        }
        check garden-matches-the-day {
            statement """
                After a working day with the garden on, Home shows the three to five directories actually worked in, sized by how much, nothing untouched, and no tile moved that the user did not move.
                """
            method manual
        }
        check host-and-sources {
            statement """
                The HomeGarden1 host parses launch directory arguments and XDG user dirs; the interface, proxy and signature gates pass with the new additive interface.
                """
            method command
            command "cargo test -p lege-sessiond homegarden && cargo run -q -p xtask -- check-interfaces && cargo run -q -p xtask -- check-proxies && cargo run -q -p xtask -- check-interface-signatures"
            verified_by [ @legeos.evidence.homegarden-phases-0-3-tests-20260908/1 ]
        }
        check ledger-is-pure-and-breadth-beats-count {
            statement """
                300 saves in one session score below three opens and a launch across two sessions; a 14-hour single session promotes less than several short sessions; 40,000 target/ writes create no context; the ledger stays within max-contexts; a pinned place never recedes and a hidden one never grows; a place recedes only when later sessions and garden-hours both pass.
                """
            method command
            command "cargo test -p lege-session-core homegarden"
            verified_by [ @legeos.evidence.homegarden-phases-0-3-tests-20260908/1 ]
        }
        check one-declaration-three-surfaces {
            statement """
                place.* and garden.* are declared once and reach the context menu, the cheat sheet and lege garden.
                """
            method command
            command "cargo run -q -p xtask -- check-actions"
            verified_by [ @legeos.evidence.campaign3-integrated-gate-20260908/1 ]
        }
        check shell-branch-body {
            statement """
                branch_rows orders the heaviest branch first and stops at the limit; the Contexts payload parses with unknown fields.
                """
            method command
            command "cargo test -p lege-shell garden::"
            verified_by [ @legeos.evidence.homegarden-phases-0-3-tests-20260908/1 ]
        }
        check tender-never-moves {
            statement """
                The tender emits no Move, leaves every user tile's cell and span untouched, keeps every surviving tile's cell, is idempotent at the same wants, never removes a pinned place and never places a dormant one.
                """
            method command
            command "cargo test -p lege-field garden"
            verified_by [ @legeos.evidence.homegarden-phases-0-3-tests-20260908/1 ]
        }
    }
    depends_on [ @legeos.work.home-project-tool-actions ]
    implements [ @legeos.decision.homegarden-activity-grown-places ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    verified_by [
        @legeos.evidence.campaign3-integrated-gate-20260908/1,
        @legeos.evidence.homegarden-phases-0-3-tests-20260908/1
    ]
}

record legeos.work.homegarden-review-fixes-20260908/1 : work {
    title "Act on the Homegarden usability review: the view takes every remote change, the user's tiles are the user's, growth never shifts a neighbour, the garden verbs do what they say, a corner landing leaves room to grow"
    state active
    scope [
        path "crates/lege-field/src/garden.rs",
        path "crates/lege-session-core/src/homefield.rs",
        path "crates/lege-session-core/src/homegarden.rs",
        path "interfaces/dbus/org.legeos.HomeGarden1.xml",
        path "services/lege-sessiond/src/apis/homegarden.rs",
        path "shell/lege-shell/src/field_model.rs",
        path "shell/lege-shell/src/garden.rs",
        path "shell/lege-shell/src/surface/context_menu.rs"
    ]
    intent """
        The six findings of @legeos.assessment.homegarden-usability-review-20260908, five here and the sixth (a Settings Homegarden page) in @legeos.work.bar-cluster-clickable-20260908. (1) The shell reconciles the daemon's field on HomeField1.Changed: adopt, resize in place, remove folder tiles (field_model::reconcile_remote). (2) A folder tile the tender never placed is the user's outright: at the next tending it is pinned and kept (user_span = its span), so recession neither resizes nor removes it. (3) The tender rejects any resize whose yields shift a neighbour's cell, trying each axis alone before emitting nothing (lege-field::garden::plan_resize). (4) garden.keep is HomeGarden1.Keep (pin + freeze the size); Hide unpins and removes the tile from every Home now, undoably; Forget drops the record and removes the tile likewise; the context menu offers Pin or Unpin by the place's state and Keep only until kept. (5) A first landing takes the home corner as a 4x3 would sit in it (GROWTH_ROOM), so a Trace can become Expanded in place.
        """
    note """
        HomeGarden1 gained the additive method Keep(path); baseline re-frozen. The garden design document's verb table (garden.keep = pinned + user_span) is now the implementation.
        """
    acceptance {
        check hands-on-user-tile-survives {
            statement """
                On the installed session: place a folder on Home by hand, resize it to 3x3, open two other folders across a lock/unlock, reveal Home: the hand-placed tile is still 3x3 and its menu reads Unpin; Hide removes it and Ctrl+Z brings it back
                """
            method manual
        }
        check interfaces-additive {
            statement """
                Keep is additive: check-interfaces, check-interface-signatures and check-proxies pass
                """
            method command
            command "cargo run -q -p xtask -- check-interfaces && cargo run -q -p xtask -- check-interface-signatures && cargo run -q -p xtask -- check-proxies"
            verified_by [ @legeos.evidence.campaign4-integrated-gate-20260908 ]
        }
        check tender-never-shifts-a-neighbour {
            statement """
                growth_never_shifts_a_neighbours_cell and a_corner_landing_leaves_room_to_reach_the_expanded_span pass with the garden proptests
                """
            method command
            command "cargo test -p lege-field garden"
            verified_by [ @legeos.evidence.campaign4-integrated-gate-20260908 ]
        }
        check verbs-do-what-they-say {
            statement """
                keep freezes the size, hide outranks a pin, unpin lets go of both (ledger); the menu offers pin or unpin by state (shell)
                """
            method command
            command "cargo test -p lege-session-core homegarden && cargo test -p lege-shell context_menu"
            verified_by [ @legeos.evidence.campaign4-integrated-gate-20260908 ]
        }
        check view-takes-remote-changes {
            statement """
                reconcile_remote adopts, resizes in place and removes folder tiles, never moves, and leaves a non-folder tile missing remotely alone
                """
            method command
            command "cargo test -p lege-shell reconcile"
            verified_by [ @legeos.evidence.campaign4-integrated-gate-20260908 ]
        }
    }
    after [ @legeos.work.homegarden-phases-0-3 ]
    derived_from [ @legeos.assessment.homegarden-usability-review-20260908 ]
    implements [ @legeos.decision.homegarden-activity-grown-places ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    supported_by [ @legeos.evidence.campaign4-integrated-gate-20260908 ]
}

record legeos.work.homegarden-semantic-sources-and-observation-depolling-20260908/1 : work {
    title "Make Homegarden notice real work and remove false polling/activation claims"
    state superseded
    scope [
        path "cli/lege/src/main.rs",
        path "distro/deploy/components.toml",
        path "distro/policy/**",
        path "services/lege-sessiond/src/apis/homefield.rs",
        path "services/lege-sessiond/src/apis/homegarden.rs",
        path "services/lege-sessiond/src/apis/projects.rs",
        path "services/lege-sessiond/src/main.rs",
        path "session/units/**",
        path "shell/lege-shell/src/data.rs",
        path "shell/lege-shell/src/garden.rs",
        path "shell/lege-shell/src/surface/app.rs",
        path "tools/xtask/src/main.rs"
    ]
    intent """
        Implement the Astra-reviewed first response to the one-hour empty Homegarden report. Wire explicit semantic sources (project entry, Add to Home, successful directory navigation and terminal cwd integration), preserve reveal/start/explicit tending, make shell snapshots subscribe-before-read instead of sweeping local state every three seconds, and make the service inventory distinguish Type=dbus readiness from actual activation. True information blooms remain a separate projection inside established Places and index writes never create a Place.
        """
    note """
        Advisor result rs-38981fd40ef0 rejected index-write-to-Place promotion and background tending. The repo is outside filed's default $HOME root. A Trace appears at the next tending moment once direct evidence reaches the threshold; actual temporary blooms are not present in the current data model.
        """
    acceptance {
        check installed-latency {
            statement """
                After deployment/logout, two shell prompts in a project or one project-entry plus Home reveal grows a Trace; it appears on that reveal, never during an uninterrupted look at Home.
                """
            method manual
        }
        check lifetime-truth {
            statement """
                Packaging checks distinguish Type=dbus readiness from D-Bus activation, require actual descriptors for dbus-activated services, and accept filed as a justified persistent index owner.
                """
            method command
            command "cargo test -p xtask && cargo run -q -p xtask -- check-packaging"
        }
        check no-index-growth {
            statement """
                Filesystem/index content changes cannot create, resize or move a Place; tending remains session-start, Home-reveal or explicit only.
                """
            method command
            command "cargo test -p lege-session-core homegarden && cargo test -p lege-field garden"
        }
        check semantic-sources {
            statement """
                Successful ProjectEntered, PlacedOnHome, FileOpened and DirectoryOpened paths reach HomeGarden exactly once; failed/no-op paths do not invent activity.
                """
            method command
            command "cargo test -p lege-sessiond homegarden && cargo test -p lege-shell garden"
        }
        check shell-depolled {
            statement """
                Home takes an initial state snapshot after subscribing and refreshes signalled domains on events; the unconditional three-second world sweep is gone and every remaining timer is declared.
                """
            method command
            command "cargo test -p lege-shell && cargo run -q -p xtask -- check-packaging"
        }
        check terminal-development {
            statement """
                The LegeOS terminal integration reports bounded prompt/cwd events through the typed HomeGarden1 API so ordinary command-line project work can earn a Trace without filesystem-write inference.
                """
            method command
            command "cargo test -p lege -- garden"
        }
    }
    after [ @legeos.work.homegarden-review-fixes-20260908 ]
    derived_from [
        @legeos.observation.homegarden-produced-no-visible-place-or-bloom-during-an-hour-of-development-20260908
    ]
    implements [
        @legeos.decision.event-driven-service-authorities,
        @legeos.decision.homegarden-activity-grown-places
    ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.homegarden-semantic-sources-and-observation-depolling-20260908/2 : work {
    title "Make Homegarden notice real work and remove false polling/activation claims"
    state superseded
    scope [
        path "cli/lege/Cargo.toml",
        path "cli/lege/src/main.rs",
        path "crates/lege-session-core/src/homegarden.rs",
        path "distro/deploy/components.toml",
        path "distro/policy/**",
        path "services/lege-hostd/Cargo.toml",
        path "services/lege-sessiond/src/apis/homefield.rs",
        path "services/lege-sessiond/src/apis/homegarden.rs",
        path "services/lege-sessiond/src/apis/projects.rs",
        path "services/lege-sessiond/src/main.rs",
        path "session/profile.d/**",
        path "session/units/**",
        path "shell/lege-shell/src/data.rs",
        path "shell/lege-shell/src/data_device.rs",
        path "shell/lege-shell/src/garden.rs",
        path "shell/lege-shell/src/surface/app.rs",
        path "tools/xtask/src/main.rs"
    ]
    intent """
        Implement the Astra-reviewed first response to the one-hour empty Homegarden report. Wire explicit semantic sources (project entry, Add to Home, successful directory navigation and terminal cwd integration), preserve reveal/start/explicit tending, make shell snapshots subscribe-before-read instead of sweeping local state every three seconds, and make the service inventory distinguish Type=dbus readiness from actual activation. True information blooms remain a separate projection inside established Places and index writes never create a Place.
        """
    note """
        Advisor result rs-38981fd40ef0 rejected index-write-to-Place promotion and background tending. The repo is outside filed's default $HOME root. A Trace appears at the next tending moment once direct evidence reaches the threshold; actual temporary blooms are not present in the current data model.

        Revision 2 corrects one acceptance check that named a command which could not prove its own statement, and records what the call sites can and cannot be tested for without a bus harness. Two behavioural consequences of dropping the folder poll are known and accepted: a folder window reopened on a directory outside filed's indexed roots shows its cached listing until the next generation signal or the five-minute reconciliation, and `directory-opened` is recorded once per navigation to a directory the shell has no listing for rather than on every repeat visit.
        """
    acceptance {
        check installed-latency {
            statement """
                After deployment/logout, two shell prompts in a project or one project-entry plus Home reveal grows a Trace; it appears on that reveal, never during an uninterrupted look at Home.
                """
            method manual
        }
        check lifetime-truth {
            statement """
                Packaging checks distinguish Type=dbus readiness from D-Bus activation, require actual descriptors for dbus-activated services, and accept filed as a justified persistent index owner.
                """
            method command
            command "cargo test -p xtask && cargo run -q -p xtask -- check-packaging"
        }
        check no-index-growth {
            statement """
                Filesystem/index content changes cannot create, resize or move a Place; tending remains session-start, Home-reveal or explicit only.
                """
            method command
            command "cargo test -p lege-session-core homegarden && cargo test -p lege-field garden"
        }
        check semantic-sources {
            statement """
                The ledger behind the semantic sources holds: a launch directory is read from the argument shapes and a file argument is not one; repeats within a session saturate their bucket rather than inflating a place; and the shell's garden projection parses and orders what the daemon reports.
                """
            method command
            command "cargo test -p lege-sessiond homegarden && cargo test -p lege-shell garden"
        }
        check semantic-sources-observed {
            statement """
                Each direct semantic API records exactly once on success and nothing on a failed, refused or no-op path: a refused PlaceFolder, a SetCurrent naming the current project, and the reconciliation refetch of an open folder window all leave the ledger unchanged. Not testable without a bus harness; read on the deployed session with `lege garden why <path>`.
                """
            method manual
        }
        check shell-depolled {
            statement """
                Home takes an initial state snapshot after subscribing and refreshes signalled domains on events; the unconditional three-second world sweep is gone and every remaining timer is declared.
                """
            method command
            command "cargo test -p lege-shell && cargo run -q -p xtask -- check-packaging"
        }
        check terminal-development {
            statement """
                The LegeOS terminal integration reports bounded prompt/cwd events through the typed HomeGarden1 API so ordinary command-line project work can earn a Trace without filesystem-write inference: the verb parses as the shipped hook calls it, and the hook speaks once per directory entered and stays silent in a non-LegeOS, non-interactive or non-Bash shell.
                """
            method command
            command "cargo test -p lege -- garden"
        }
    }
    after [ @legeos.work.homegarden-review-fixes-20260908 ]
    derived_from [
        @legeos.observation.homegarden-produced-no-visible-place-or-bloom-during-an-hour-of-development-20260908
    ]
    implements [
        @legeos.decision.event-driven-service-authorities,
        @legeos.decision.homegarden-activity-grown-places
    ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    supersedes [ @legeos.work.homegarden-semantic-sources-and-observation-depolling-20260908/1 ]
}

