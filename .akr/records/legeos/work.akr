record legeos.work.index-wp7-wp8-20261008/1 : work {
    title "Index WP7/WP8: lanes and bounded streaming snapshots"
    state completed
    scope [
        path "crates/templar-client/**",
        path "crates/templar-file-index/**",
        path "crates/templar-treemap/**",
        path "docs/indexing-dev/**",
        path "docs/measurements/**",
        path "services/templar-filed/**",
        path "shell/templar-shell/**",
        path "tools/xtask/**"
    ]
    intent """
        Continue the interrupted WP7 and WP8 implementation from docs/indexing-dev/implementation-plan.md: bounded execution lanes and readers, caller cancellation, streaming seekable snapshots, borrowed entries, sealed mmap consumption, summary-first treemap and bounded expansion. Preserve the preceding WP0-WP6 working tree. Record native regression, private runtime, idle/churn and synthetic 100k/1M snapshot measurements. This slice does not complete WP9-WP17 or installed hardware qualification. Missing Detailed directory aggregates remain explicit partial summaries; cached summary rollups and shared immutable snapshots are separate proposals.
        """
    acceptance {
        check contract-gates {
            statement """
                Frozen interfaces, proxies and interface signatures still pass after the internal API cutover.
                """
            method command
            command "xtask check-interfaces; xtask check-proxies; xtask check-interface-signatures"
            verified_by [ @legeos.evidence.index-wp7-wp8-contract-gates-20261008/1 ]
        }
        check memory-bound {
            statement """
                Synthetic 100k/1M snapshot writer RSS deltas differ by less than 8 MiB; sealed payload and mmap-plus-final-vector memory are reported with methodology limits.
                """
            method command
            command "xtask index-bench memory --entries 100000 --scales 100000,1000000"
            verified_by [ @legeos.evidence.index-wp8-memory-20261008/1 ]
        }
        check native-regressions {
            statement """
                Core, filed, client, treemap, shell and compositor regressions pass on native Linux, including cancellation, reader limits, writer byte parity, CRC, quotas, sealed snapshots and treemap totals.
                """
            method command
            command "cargo test --offline -p templar-file-index -p templar-filed -p templar-client -p templar-treemap -p templar-shell -p templar-comp -- --test-threads=2"
            verified_by [ @legeos.evidence.index-wp7-wp8-native-regressions-20261008/1 ]
        }
        check owned-runtime {
            statement """
                Eight private typing clients complete 160 queries with success or Busy/Cancelled while Browse answers within 100 ms; private sealed snapshot checks and the production snapshot consumer pass.
                """
            method command
            command "cargo test --offline -p templar-filed --test private_runtime --test snapshot_consumer"
            verified_by [ @legeos.evidence.index-wp7-owned-browse-20261008/1 ]
        }
        check scheduling-measurement {
            statement """
                Owned churn reports search latency, queue wait, Browse responsiveness and bounded thread counts, and the owned settled idle measurement records zero watcher wakeups.
                """
            method command
            command "xtask index-bench churn; xtask index-bench idle"
            verified_by [ @legeos.evidence.index-wp7-scheduling-measurement-20261008/1 ]
        }
    }
    part_of [ @legeos.work.file-index-core/3 ]
