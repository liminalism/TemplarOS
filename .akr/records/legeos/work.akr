            verified_by [ @legeos.evidence.file-copy-path-20260824/1 ]
        }
        check folder-properties {
            statement """
                Explicit Properties reports recursive file count and total folder size without following symlinks, and the UI labels partial results.
                """
            method command
            command "cargo test -p lege-filed folder_properties && cargo test -p lege-files properties"
            verified_by [ @legeos.evidence.file-folder-properties-20260824/1 ]
        }
        check installable {
            statement """
                The native preview companion is reproducibly staged and both Files packages retain valid install metadata and runtime dependencies.
                """
            method command
            command "just preview-codecs && cargo run -q -p xtask -- check-packaging && cargo deb -q -p lege-files && cargo deb -q -p lege-filed"
            verified_by [ @legeos.evidence.file-preview-packaging-20260824/1 ]
        }
        check preview-surface {
            statement """
                The standalone manager requests previews without blocking and paints stale-safe results in its selected-item inspector.
                """
            method command
            command "cargo test -p lege-files preview"
            verified_by [ @legeos.evidence.file-preview-surface-20260824/1 ]
        }
        check video-previews {
            statement """
                Common video files are rendered by ffmpeg at 3 percent of their ffprobe-reported duration and produce bounded previews.
                """
            method command
            command "cargo test -p lege-filed video_preview"
            verified_by [ @legeos.evidence.file-video-preview-three-percent-20260824/1 ]
        }
        check workspace-quality {
            statement """
                Formatting, linting, workspace tests, integration checks, interfaces, dependencies, MSRV, and structural checks pass.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && cargo test -p lege-comp-integration && cargo run -q -p xtask -- tree-check && cargo run -q -p xtask -- deps-check && cargo run -q -p xtask -- check-interfaces && cargo +1.93 check --workspace"
            verified_by [ @legeos.evidence.file-preview-workspace-quality-20260824/1 ]
        }
    }
    depends_on [ @legeos.work.standalone-file-manager/3 ]
    implements [
