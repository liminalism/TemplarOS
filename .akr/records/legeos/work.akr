record legeos.work.external-window-tabs-20261002/1 : work {
    title "Corner-following horizontal titles and hover controls: four sides, same-corner right angles, opposite-corner option"
    state proposed
    scope [
        path "apps/templar-settings/**",
        path "compositor/COMPOSITOR.md",
        path "compositor/templar-comp/src/**",
        path "crates/templar-session-core/src/settings.rs",
        path "crates/templar-window/**",
        path "docs/planning/homegarden-previews-notifications-window-tabs.md",
        path "interfaces/wayland/templar-shell-v2.xml",
        path "shell/templar-shell/src/settings.rs"
    ]
    intent """
        Implement the October7 corner-following title/control proposal in docs/planning/homegarden-previews-notifications-window-tabs.md section3, revising the October2 fixed-side design. Four existing children retain their ordering: (1) window-corner-hit-geometry: exact visible-corner resize safety and reachable control route; (2) window-tab-layout-model: client-space authoritative four-corner layout with same-corner right-angle and opposite-corner arrangements, migrating every consumer; (3) window-tab-hover-reveal: always-visible horizontal title, hover controls, nearest-corner selection/hysteresis and aiming/grab latches, keyboard and occlusion rules; (4) window-tab-side-choice: Settings/protocol integration for arrangement/follow-pointer/fixed fallback/visibility/default corner and real nested interactions. No title text on vertical strips. Every corner supports move/resize/park/maximize/close. Keep input, client size, damage/recovery and shell-absent keyboard safety in scope.
        """
    note """
        Scope-only revision requested October7. Final always-visible wording interpreted as title visible and controls hover; exact opposite arrangement/fullscreen policy and dwell feel remain prototype-review points. No deployed feature or completed child is claimed. Legacy external advisor remains provenance only; user direction replaces its stationary-anchor policy. Plan: docs/planning/homegarden-previews-notifications-window-tabs.md.
        """
    acceptance {
        check owner-day {
            statement """
                After owner-run deployment, using all four corners and both arrangement options remains comfortable: title horizontal/visible, controls discoverable, closest-corner follow stops while aiming/pressing, no accidental close, all move/resize/park/maximize/close routes reachable. Owner confirms wording/fullscreen/opposite-arrangement choices or records the agreed revision.
                """
            method manual
        }
        check steps-complete {
            statement """
                All four revised children complete with source-specific behavior evidence and an actual owned nested Wayland/XWayland interaction gate, not merely compiling a layout model.
                """
            method observation
        }
    }
    derived_from [ @legeos.assessment.desktop-preview-notification-tab-scope-20261007 ]
    implements [ @legeos.decision.window-tabs-are-external-revealed-and-stationary ]
    author "dk"
    source {
        kind external
        role origin
        document "external-window-tabs-advice-20261001"
        use """
            Order of work: corner geometry first and independently, then the layout refactor, then anchored hover reveal.
            """
    }
}

record legeos.work.file-index-core/1 : work {
    title "F1 — the lege-file-index core crate, the cache database with generations, and the org.legeos.Files.Index1 contract"
    state superseded
    scope [
        path "Cargo.toml",
        path "cli/lege/src/files.rs",
        path "crates/lege-client/src/proxies/files.rs",
        path "crates/lege-file-index/**",
        path "interfaces/dbus/org.legeos.Files.Index1.xml",
        path "services/lege-filed/Cargo.toml",
        path "services/lege-filed/src/dbus.rs",
        path "services/lege-filed/src/index_host.rs",
        path "services/lege-filed/src/main.rs",
        path "services/lege-filed/src/search.rs",
        path "session/units/user/lege-filed.service"
    ]
    intent """
        Phase 0 and 1 of docs/planning/shared-incremental-file-index.md: a pure crates/lege-file-index (schema v1 with generations, native-byte paths plus display text, object keys, root freshness states, one writer with WAL readers, atomic generation commit that preserves the last good generation, uncapped streaming scan under configured budgets yielding an explicit incomplete state, FTS5-trigram substring search behind a QueryPlanner trait, paged cursors bound to a generation, sealed snapshot framing, Mutation and Change types for the maintenance lane); lege-filed opens $XDG_CACHE_HOME/legeos/file-index-v1.sqlite3, Search1 delegates to the core, Index1 (Roots, Search, FetchPage, OpenSnapshot, ChangesSince, signals) is hosted, proxied in lege-client and reachable as `lege files index status|search|reconcile`.
        """
    note """
        Plan of record: docs/planning/shared-incremental-file-index.md via the parent @legeos.work.shared-incremental-file-index. HEAD reconciliation 2026-09-03: search.rs is a delete-then-insert, 50k-capped LIKE index inside the shared state mutex; FTS5 trigram is available from the bundled SQLite 3.53.2 without a feature change; Index1 exists nowhere. The two-million-entry release fixture is an ignored test whose command is recorded; the coordinator runs it at the integrated gate.
        """
    acceptance {
        check generations-and-lossless-paths {
            statement """
                A killed rebuild leaves the previous committed generation readable, a non-UTF-8 path round-trips through index, search and snapshot, and a cursor stays pinned to the generation it was opened on.
                """
            method command
            command "cargo test -p lege-file-index"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-integrated-gate-20260904/1
            ]
        }
        check index1-gates {
            statement """
                org.legeos.Files.Index1 passes check-interfaces, check-proxies and check-interface-signatures after the baseline is re-frozen.
                """
            method command
            command "cargo run -q -p xtask -- check-interfaces && cargo run -q -p xtask -- check-proxies && cargo run -q -p xtask -- check-interface-signatures"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-integrated-gate-20260904/1
            ]
        }
        check warm-start-and-compat {
            statement """
                A warm lege-filed start serves the prior generation without walking a root, Search1 clients keep working, and a budget-limited scan reports incomplete rather than complete.
                """
            method command
            command "cargo test -p lege-filed search"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-integrated-gate-20260904/1
            ]
        }
    }
    part_of [
        @legeos.milestone.developer-edition-0-1,
        @legeos.work.shared-incremental-file-index
    ]
}

