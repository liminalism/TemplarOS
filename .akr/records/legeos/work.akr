record legeos.work.homegarden-active-work-calendar-20261003/1 : work {
    title "Homegarden current work and an integrated clock/calendar"
    state completed
    scope [
        path "compositor/templar-comp/src/input.rs",
        path "compositor/templar-comp/src/protocols_shell.rs",
        path "interfaces/wayland/templar-shell-v1.xml",
        path "shell/README.md",
        path "shell/templar-shell/**"
    ]
    intent """
        Make Homegarden the presentation layer for current work as requested on 2026-10-03: open and minimized windows have same-instance restore/activate entries, terminals and file-manager folders form one contiguous Tools area, and closing a window leaves existing recent file/folder and Place behavior unchanged. The task switcher popup and Alt-Tab remain unchanged. Add an in-shell clock/calendar opened by the bottom-right time button, using an established library for local time and calendar arithmetic after dedicated research. Preserve persistent user layout and service-owned garden policy; exercise safely without touching the installed desktop.
        """
    note """
        This user-directed change reverses the historical removal of running-window presentations recorded by legeos.observation.home-chrome-retired-to-the-bar-and-the-garden. The garden remains service-owned, tending and recents behavior remain unchanged, and presentation grouping does not create compositor window groups.
        """
    acceptance {
        check clock-calendar {
            statement """
                The bottom-right clock opens a calendar independent of external calendar installation, with month browsing, Today, local date/time, keyboard navigation and dismissal. Existing machine controls remain functional.
                """
            method observation
            verified_by [ @legeos.evidence.homegarden-active-work-calendar-ui-20261003/1 ]
        }
        check current-work {
            statement """
                Live and minimized windows are reachable on Home with same-instance actions; terminal and file-manager windows share a contiguous area; closure removes the live presentation without changing saved user objects or recents.
                """
            method observation
            verified_by [ @legeos.evidence.homegarden-active-work-calendar-ui-20261003/1 ]
        }
        check verification {
            statement """
                Changed shell behavior and compositor focus paths build and pass their relevant behavioral checks; actual offscreen UI flows are exercised and inspected, with live-hardware limits stated.
                """
            method command
            command "cargo test -p templar-shell -p templar-comp"
            verified_by [ @legeos.evidence.homegarden-active-work-calendar-checks-20261003/1 ]
        }
    }
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    author "dk"
}

record legeos.work.homegarden-aged-evidence-and-drawn-structures-20260929/1 : work {
    title "Homegarden: aged evidence, dwelled stages, repository Places, idle-aware clock, and themed drawn structures"
    state active
    intent """
        Act on the 2026-09-29 Homegarden technical review, which the owner signed off in full.
        Ledger: evidence ages at every act (a returning place comes back at what the time since left,
        not its lifetime total); promotion's session floor counts recent sessions; each stage has a
        dwell before the next, because every Home reveal is a tending moment; tree nodes are capped per
        session and aged, five deep and 96 nodes, served aged to now; the nearest real repository is
        the Place, outranking a build marker or an existing context above it; observed acts are
        written in batches from a writer thread and flushed on SIGTERM; the Garden Clock stops while
        the compositor has the screen off for want of input (Lifecycle1.NotifyIdle, templar-comp only).
        View: a pure layout stage in templar_treemap::garden (Strip, Squarified with cushions, Voronoi,
        CirclePack, Sunburst, Icicle, space-colonization Branches with pipe-model widths, Fractal,
        Folio) with stable sibling order and previous-layout seeding; a theme registry in the shell
        (mineral default, orchard, cushion, stone, radial; shell.home-garden.theme) that maps each form
        to a layout, palette and seeded grain; one cached bitmap per tile rebuilt only when the tree,
        size, scale or theme changes; the folio form drawn; `templar-shell --garden-gallery <dir>`.
        """
    note """
        Gallery renders: .agent/scratch/homegarden-styles/ (gallery.png contact sheet). Judged natural:
        stone, mineral, orchard; acceptable: cushion; radial improved after label and icicle fixes but
        remains the plainest. Thresholds are unchanged numbers under a new (aged) economy: question 5 of
        @legeos.question.homegarden-open-choices stays open until the installed clock has run.
        """
    acceptance {
        check a-day-on-the-installed-session {
            statement """
                On the installed TemplarOS, a day of ordinary work grows Places for the repositories and folders actually used, the clock advances only while the screen is on and unlocked, and the drawn structures read at a glance in the chosen theme.
                """
            method observation
        }
        check gallery-renders-every-theme {
            statement """
                The gallery renders every theme for a code project, a photo folder, a manuscript folder and a sparse place at Wide and Dominant without a display or D-Bus.
                """
            method command
            command "templar-shell --garden-gallery .agent/scratch/homegarden-styles"
            verified_by [ @legeos.evidence.garden-gallery-every-theme-20260929/1 ]
        }
        check layouts-hold-their-invariants {
            statement """
                Every layout kind stays in bounds, is deterministic, keeps sibling order under reweighting, keeps area proportional to weight, keeps pipe-model widths and respects the node budget.
                """
            method command
            command "cargo test -p templar-treemap"
            verified_by [ @legeos.evidence.garden-layout-invariants-20260929/1 ]
        }
        check ledger-and-clock-tests {
            statement """
                The ledger, host and lifecycle tests cover aged return, per-dwell promotion, per-session node caps, the nearest repository, the writer's newest-snapshot flush, idle clock and the NotifyIdle caller guard.
                """
            method command
            command "cargo test -p templar-session-core -p templar-sessiond"
            verified_by [ @legeos.evidence.homegarden-ledger-and-clock-tests-20260929/1 ]
        }
    }
}

record legeos.work.homegarden-blooms-20260909/1 : work {
    title "Lane C — blooms: an earned Place says what arrived in it, and forgets when you open it"
    state active
    intent """
        Phase 5 rewritten on the user's rule that content changes may alter what an earned Place shows but never create, resize, move or promote one. At each tending moment the daemon reads the shared index once through Files.Index1.ChangesSince from a persisted change cursor (never a subscription; SnapshotRequired below the retained floor resets the cursor and shows nothing; a cursor of 0 takes the position and shows nothing), reduces the page to Arrived/Moved/Gone, attributes each through the existing root walk and ignore list, and looks it up against existing contexts of stage Tile or above, never inserting. A Bloom {kind: Arrived, since: GardenMoment, items (8), total (99)} on the context appears as `N new ·` on the state line, as a mark in the body, and in `lege garden why`; it resolves through the file-opened Observe, which the Files app now calls beside Recents; an unanswered bloom drops after five later sessions. A move whose old_path is a context root rewrites the root and keeps material_seed and buckets. Docs: the seven-day Make-this-a-project row and the 30-day mount retention are deleted, the remaining calendar prose and Appendix A are restated in sessions and garden-hours, §5.4's struct and threshold table match the shipped model, the idle_hours JSON key is idle_garden_hours. Not here: media consumption (no media role, VLC is the player, MPRIS cannot give progress without polling); Phase 6 material rendering.
        """
    note """
        Landed on developer-edition-0-1 at fb99230: 07e97a9 00dd244 e50ef5f 490f07f 8f6c73b ab5218f, merged at 0957725. Names off the wire come from the lossy display string and a name with U+FFFD is skipped; a bloom over the 8-item cap clears when its tracked items are opened (both ponytail: comments in the code).
        """
    acceptance {
        check bloom-resolves-on-open {
            statement """
                A file-opened Observe on a bloomed item removes it from the bloom, and opening the last one clears the bloom; the state line goes from `2 new` to `1 new` to nothing.
                """
            method command
            command "cargo test -p lege-session-core homegarden"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check blooms-on-the-desktop {
            statement """
                After deploy and logout, two files copied into a folder that is already a Place read `2 new` at the next reveal and clear as they are opened; a hundred files copied into a folder that is not a Place put nothing on Home.
                """
            method manual
        }
        check content-never-grows-a-place {
            statement """
                A burst of index changes under a directory that is not a context yields no context, no Place, no Resize; the same burst under an Expanded context yields a bloom and no field op.
                """
            method command
            command "cargo test -p lege-session-core homegarden && cargo test -p lege-field garden"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check files-app-observes {
            statement """
                A brokered open from the Files application reaches HomeGarden1.Observe as file-opened beside its Recents record.
                """
            method command
            command "cargo test -p lege-files"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check no-calendar-left {
            statement """
                The plan, the architecture doc and the code contain no day-based garden rule.
                """
            method command
            command "! grep -nE '(seven|30)[- ]day' docs/garden/homegarden-activity-grown-home.md"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check one-read-per-tending {
            statement """
                Tending performs exactly one ChangesSince call and no subscription; sessiond has no generation_advanced reference.
                """
            method command
            command "cargo test -p lege-sessiond homegarden && ! grep -rq generation_advanced services/lege-sessiond/src"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check root-survives-rename {
            statement """
                A move change whose old_path is a context root rewrites the root and keeps material_seed and every bucket.
                """
            method command
            command "cargo test -p lege-session-core homegarden"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
    }
    depends_on [ @legeos.work.homegarden-phases-0-3 ]
    implements [ @legeos.decision.a-place-is-a-drawn-structure-not-a-richer-rectangle ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.homegarden-day-reaches-the-garden-20260909/1 : work {
    title "Lane A — a day at the terminal reaches the garden: the clock accumulates, the hook loads in kitty, Home stops feeding on itself, Desktop is an ordinary pinned Place, and the bar's chips get their icons"
    state active
    intent """
        Fix the four defects the half day exposed (@legeos.observation.homegarden-half-day-grew-only-the-desktop-tray-20260909) so a day of real work registers. (1) GardenClock folds its open interval into active_ms at every persist (a checkpoint), so a session that ends without a lock edge still ages the garden and last-used moments no longer include an unpersisted interval. (2) The terminal prompt hook is delivered through /etc/bash.bashrc by the legeos-cli maintainer scripts, the file a non-login interactive bash reads, with a check that can fail. (3) Drawing an open folder window at its own anchor records nothing; only navigation away from the anchor is directory-opened. (4) The user's decision on open choice (1): the permanent Desktop tray goes; the first run records one placed-on-home for the XDG Desktop directory so it starts pinned; a saved tray tile is migrated away; unpin, hide and recession then apply to it like any Place. Attribution is left as it is: the user chose that a folder of projects may be the Place and the tree beneath it carries the repositories (no VCS-root heuristic). (5) The bar's all-initials chips: the offline resolver finds every icon on this host and the bar reads the key the loader writes, so the two silent failure paths (an identity that fails AppId parsing; a lookup miss never retried) now log; the cause is read from one session's journal. Not here: created-or-renamed from filed, media roles, threshold retuning.
        """
    note """
        Landed on developer-edition-0-1 at fb99230: eba386c 09c0574 bd1954c 6d1bedc 0a65a8c 4eaec83, merged at ee54fea, plus fb99230 (the tray migration). Scoping in .agent/scratch/homegarden-5/A-result.md; user gates in RUNBOOK.md there.
        """
    acceptance {
        check bar-chips-wear-icons {
            statement """
                In the installed session the bar's chips show the application's icon for every application whose desktop file names one; the cause of the all-initials bar is recorded in the ledger whether or not the fix landed here.
                """
            method manual
        }
        check clock-accumulates {
            statement """
                A session that ends without a lock or sleep edge still adds its active time: after a persist and reload, the clock's active_ms includes the interval that was open, and a context's last-used moment never exceeds the persisted clock.
                """
            method command
            command "cargo test -p lege-session-core homegarden && cargo test -p lege-sessiond homegarden"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check desktop-is-an-ordinary-place {
            statement """
                No permanent Desktop tile is merged into the field; a saved tray tile at folder:desktop is removed once; a first run with no Desktop context records placed-on-home for the XDG Desktop directory (pinned); garden.unpin and garden.hide then work on it.
                """
            method command
            command "cargo test -p lege-shell field_model && cargo test -p lege-sessiond homegarden"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check home-does-not-feed-itself {
            statement """
                Painting an already-open folder window at its anchor records no directory-opened; a test drives the BrowseFolder path at the anchor and asserts no Observe call.
                """
            method command
            command "cargo test -p lege-shell garden"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check hook-loads-in-kitty {
            statement """
                On an installed host, `bash -ic 'declare -F __legeos_garden_prompt'` inside the LegeOS session finds the hook; the packaging check proves the hook is delivered through a file a non-login interactive bash reads, not only /etc/profile.d.
                """
            method command
            command "cargo test -p lege garden && cargo run -q -p xtask -- check-packaging"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check installed-day {
            statement """
                After deploy and logout, a session of terminal work in a repository grows a Place for it at the next reveal, `lege garden why` on it names the terminal sessions, and `lege garden clock` shows garden-hours growing across a lock and a logout.
                """
            method manual
        }
    }
    depends_on [ @legeos.work.homegarden-phases-0-3 ]
    derived_from [ @legeos.observation.homegarden-half-day-grew-only-the-desktop-tray-20260909 ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.homegarden-growth-forms-20260909/1 : work {
    title "Lane B — a Place draws the form its use earned: branch, shelf or plain, a lightly used place is a line, and the roles row goes"
    state active
    intent """
        First cut of @legeos.decision.a-place-is-a-drawn-structure-not-a-richer-rectangle, simple before beautiful. (1) A headless garden fixture (LEGE_BASELINE_GARDEN=branch|shelf|plain) grows two Places into the baseline field through the real tender, so each form renders and hashes without a compositor. (2) A `form` on each context (Plain, Branch, Shelf, Folio), derived at tending moments by folding the activity tree (directories weighted by depth and by a Terminal or CodeEditor role; leaves classified by extension) with a 2.0 floor, a 1.5x margin and a two-session dwell; only form, form_candidate and form_candidate_since persist, in the free-form Contexts JSON. (3) A forms painter (surface/place_forms.rs), one fn per form: a 2D branch with the Place root as trunk and the used descendants as branches, thicker by share; a shelf of item cells under a rule; plain falls back to the folder body. PLACE_ROLES and the indented branch list are deleted; the place.open-* actions stay in the context menu. Bloomed items are drawn in the accent (post-merge, eed1bc2). (4) The span ladder: Trace 2x1, Tile 2x2, Expanded 4x3, a new top stage Dominant 6x4; the Folder floor is 2x1 and GROWTH_ROOM 6x4. (5) A warm mineral substrate. Deferred: the folio drawing, shelf thumbnails, and any stylised vector or fractal tree, which is the later pass the user asked for.
        """
    note """
        Landed on developer-edition-0-1 at fb99230: d2325e6 302f3d4 b5c9661 05533de ecb20bd, merged at 796f457. Renders: .agent/scratch/homegarden-5/{branch,shelf,plain}.png. Lowering the Folder floor had two silent consumers (the Desktop tray's opening span and the folder window's collapse floor), both kept at their previous pixels.
        """
    acceptance {
        check a-line-and-a-block {
            statement """
                Stage::Trace asks 2x1 and the top stage 6x4; growth still never shifts a neighbour's cell and every garden invariant property test passes at the new spans.
                """
            method command
            command "cargo test -p lege-field garden"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check form-is-earned {
            statement """
                A context whose file-opened leaves are predominantly media reaches the shelf form only at a tending moment two sessions after that facet started leading by at least 1.5x, and a single document open does not flip it back.
                """
            method command
            command "cargo test -p lege-session-core homegarden"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check glance-test {
            statement """
                On the installed desktop, the user can tell from two metres which Place is a branch and which is a shelf, and no Place looks like a card of links.
                """
            method manual
        }
        check no-roles-row {
            statement """
                PLACE_ROLES is gone from field_screen.rs and the three place.open-* rows still appear in the Place context menu.
                """
            method command
            command "cargo test -p lege-shell && ! grep -q PLACE_ROLES shell/lege-shell/src/surface/field_screen.rs"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
        check three-forms-render {
            statement """
                The baseline render with LEGE_BASELINE_GARDEN set to branch, shelf and plain writes a readable PNG of each form, and the resting baseline hash passes after one rebless.
                """
            method command
            command "cargo test -p lege-shell visual_regression_home_field_baseline"
            verified_by [ @legeos.evidence.homegarden-5-gate-20260909/1 ]
        }
    }
    depends_on [ @legeos.work.homegarden-phases-0-3 ]
    implements [ @legeos.decision.a-place-is-a-drawn-structure-not-a-richer-rectangle ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.homegarden-phases-0-3/1 : work {
    title "Homegarden Phases 0–3: the activity ledger and Garden Clock, the tender, tending at reveal and session start, and the rung-aware Place tile"
    state superseded
    scope [
        path "cli/lege/src/main.rs",
        path "crates/lege-field/src/garden.rs",
        path "crates/lege-session-core/src/homegarden.rs",
        path "crates/lege-session-core/src/settings.rs",
        path "crates/lege-state/src/migrations/session.rs",
        path "crates/lege-types/src/action.rs",
        path "interfaces/dbus/org.legeos.HomeGarden1.xml",
        path "services/lege-sessiond/src/apis/homegarden.rs",
        path "shell/lege-shell/src/garden.rs",
        path "shell/lege-shell/src/surface/field_screen.rs"
    ]
    intent """
        Build the Homegarden model far enough to judge it in a day's use (@legeos.decision.homegarden-activity-grown-places, docs/garden/*.md): (1) a pure ledger in lege-session-core with HomeActivity/HomeContext, weights bucketed per (kind, role, session) so breadth beats count, root attribution behind a RootProbe (project root, existing context, workspace marker, mount point, XDG user dir; never $HOME), an ignore list as a setting, a bounded activity tree (depth 3, 32 nodes), stages Dormant/Trace/Tile/Expanded with promotion by relevance+sessions+breadth and demotion only when later sessions AND garden-hours both pass, and a Garden Clock that advances at Lifecycle1's session edges and never on wall-clock; (2) a pure tender in lege-field (garden::tend) emitting Place/Resize/Remove with a reason each, never Move, a Place only on free cells, a Resize only when nothing but an unpinned un-user-sized garden tile yields, property-tested; (3) org.legeos.HomeGarden1 on sessiond (Observe/Tend/Contexts/Describe/Pin/Hide/Forget/ForgetAll/Clock, signal Tended) applying each tending as one HomeField1 batch, recorded in History1, with sources: the launch channel (directory arguments -> LaunchedHere with the app's role), the shell's brokered open (FileOpened), the session-edge channel (the clock); (4) the shell tends at session start and on every Home reveal edge, draws a grown Folder tile by rung (Small: name + state; Wide: + roles row of text-led tools; Large: + the branch body of used structure, heavier branches thicker, falling back to the listing), and offers place.open-* and garden.* through the one action manifest (context menu, cheat sheet, lege garden CLI). Settings shell.home-garden.* hold the levers; default on.
        """
    note """
        Deferred with reasons, to be built only if Phase 4 (a day's hands-on) judges the model right: growth forms/facets (Hierarchy/Media/Documents/Gallery), blooms (new/unwatched), material identity, sibling groups, a Wide-vs-Tall geometry axis (needs a Representation::for_span rewrite), the index change log and portal sources, the Settings app's Hidden-places list (lege garden unhide covers it), and PlacedOnHome/ProjectEntered observations inside sessiond's HomeField1.PlaceFolder and Projects1.SetCurrent (the launch and open sources are wired; those two are one call each in the next pass). Known limit: the shell observes folder navigation only through the file manager launch it causes (LaunchedHere), not the in-Home folder window's crumb.
        """
    acceptance {
        check a-place-grows-on-the-installed-session {
            statement """
                After opening two folders and a terminal in one directory and pressing Super, a 2x2 place for that directory appears at Home's bottom-left; lege garden why names the opens and the launch; nothing else moved.
                """
            method manual
        }
        check garden-matches-the-day {
            statement """
                After a working day with the garden on, Home shows the three to five directories actually worked in, sized by how much, nothing untouched, and no tile moved that the user did not move.
                """
            method manual
        }
        check host-and-sources {
            statement """
                The HomeGarden1 host parses launch directory arguments and XDG user dirs; the interface, proxy and signature gates pass with the new additive interface.
                """
            method command
            command "cargo test -p lege-sessiond homegarden && cargo run -q -p xtask -- check-interfaces && cargo run -q -p xtask -- check-proxies && cargo run -q -p xtask -- check-interface-signatures"
            verified_by [ @legeos.evidence.homegarden-phases-0-3-tests-20260908/1 ]
        }
        check ledger-is-pure-and-breadth-beats-count {
            statement """
                300 saves in one session score below three opens and a launch across two sessions; a 14-hour single session promotes less than several short sessions; 40,000 target/ writes create no context; the ledger stays within max-contexts; a pinned place never recedes and a hidden one never grows; a place recedes only when later sessions and garden-hours both pass.
                """
            method command
            command "cargo test -p lege-session-core homegarden"
            verified_by [ @legeos.evidence.homegarden-phases-0-3-tests-20260908/1 ]
        }
        check one-declaration-three-surfaces {
            statement """
                place.* and garden.* are declared once and reach the context menu, the cheat sheet and lege garden.
                """
            method command
            command "cargo run -q -p xtask -- check-actions"
            verified_by [ @legeos.evidence.campaign3-integrated-gate-20260908/1 ]
        }
        check shell-branch-body {
            statement """
                branch_rows orders the heaviest branch first and stops at the limit; the Contexts payload parses with unknown fields.
                """
            method command
            command "cargo test -p lege-shell garden::"
            verified_by [ @legeos.evidence.homegarden-phases-0-3-tests-20260908/1 ]
        }
        check tender-never-moves {
            statement """
                The tender emits no Move, leaves every user tile's cell and span untouched, keeps every surviving tile's cell, is idempotent at the same wants, never removes a pinned place and never places a dormant one.
                """
            method command
            command "cargo test -p lege-field garden"
            verified_by [ @legeos.evidence.homegarden-phases-0-3-tests-20260908/1 ]
        }
    }
    depends_on [ @legeos.work.home-project-tool-actions ]
    implements [ @legeos.decision.homegarden-activity-grown-places ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    verified_by [
        @legeos.evidence.campaign3-integrated-gate-20260908/1,
        @legeos.evidence.homegarden-phases-0-3-tests-20260908/1
    ]
}

