            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.service-inventory-and-pressure-wakeups-20260907,
                @legeos.evidence.service-inventory-and-pressure-wakeups-20260907/1
            ]
        }
        check scale-and-lossless-paths {
            statement """
                A two-million-entry fixture is complete rather than capped, warm searches meet the recorded latency target, bulk snapshot transfer is bounded, and non-UTF-8 Unix paths survive search, snapshot and file action round trips.
                """
            method command
            command "cargo run -q -p xtask --release -- index-bench workloads --allow-two-million && cargo test -p lege-file-index --release"
            verified_by [
                @legeos.evidence.index-scale-two-million-20260907,
                @legeos.evidence.index-scale-two-million-20260907/1
            ]
        }
    }
    part_of [ @legeos.work.application-integration-interim ]
    supersedes [ @legeos.work.shared-incremental-file-index/2 ]
    author "dk"
}

record legeos.work.shared-index-completion-20261008/1 : work {
    title "Shared file index completion WP0-WP17"
    state active
    scope [
        path "apps/templar-settings/**",
        path "crates/templar-client/**",
        path "crates/templar-file-index/**",
        path "distro/forks/**",
        path "docs/indexing-dev/**",
        path "docs/measurements/**",
        path "services/templar-filed/**",
        path "shell/templar-shell/**",
        path "tools/xtask/**"
    ]
    intent "Finish WP0-WP17 of docs/indexing-dev/implementation-plan.md under the shared incremental file-index campaign. Preserve each acceptance and original observations, record native/private software and package results separately from installed and physical qualification, and retain the WP8 oracle until installed closure. The owner deferred the legacy WP14 comparison and WP16 FSearch adoption in favor of a future own integrated Index1 search GUI."
    acceptance {
        check installed-closure {
            statement """
                The owner-run installed developer day and real consumer/volume journeys establish the deployed cohort; the one-shared-index milestone is closed only from those observations.
                """
            method manual
        }
        check ledger-valid {
            statement """
                The complete work/evidence ledger validates, preserving warnings and original failed/inconclusive results.
                """
            method command
            command "akr build; akr validate"
        }
        check wp-acceptance {
            statement """
                Every non-deferred WP child has evidence for every acceptance check, with remaining historical, nested, real-mount and installed gaps explicit.
                """
            method command
            command "akr get per-WP heads"
        }
    }
    part_of [ @legeos.work.shared-incremental-file-index/3 ]
    author "dk"
}

record legeos.work.silvaview-and-fsearch-share-the-index/1 : work {
    title "First-party launcher and Silvaview consume Index1; installed sharing qualification"
    state proposed
    scope [ path "distro/forks/**", path "interfaces/dbus/org.templaros.Files.Index1.xml" ]
    intent """
        The 2026-10-09 owner direction replaces the external FSearch adoption path with the shell's global Apps/Files launcher using SearchSession directly. Silvaview retains its Index1 service-mode integration and explicit direct-scan fallback. Preserve the historical FSearch prototype measurements and source snapshots without a live fork/package/provider route. Installed first-party and Silvaview same-index-generation sharing remains an explicit qualification task; the launcher implementation is legeos.work.unified-launcher-homegarden-20261009.
        """
    note """
        Split out of @legeos.work.shared-incremental-file-index on 2026-09-07 because it is the one part of that record this repository cannot verify: Silvaview-rs lives in a sibling repository, so no path scope here covers it, and the FSearch fork is a `distro/forks/manifest.toml` entry rather than source in this tree. Everything the parent could prove — the index core, its maintenance, incremental freshness, one owner, warm start, and two-million-entry scale — is proven and completed there.

        The LegeOS side of the contract is finished and is what this work consumes: `org.legeos.Files.Index1` serves sealed snapshots with a manifest that now carries the change-log position they are consistent with (@legeos.observation.a-snapshot-did-not-say-which-change-position-it-was-consistent-with), `ChangesSince(sequence)` with `SnapshotRequired` below the retained floor, and the consumer sequence is covered end to end by `crates/lege-file-index/tests/consumer_contract.rs`. What remains is work in two other repositories plus a build that ships them.
        """
    acceptance {
        check consumers-share-the-index {
            statement """
                An owner-run installed session observes the first-party launcher Files mode and Silvaview service mode using the same Index1 generation, with no parallel service-mode recursive index and native-path activation preserved. Historical FSearch prototype results do not satisfy this installed check.
                """
            method manual
        }
    }
    depends_on [ @legeos.work.file-index-core, @legeos.work.file-index-maintenance ]
    part_of [ @legeos.work.application-integration-interim ]
}

record legeos.work.snapshot-single-read-transaction-20260909/1 : work {
    title "P1/P2 — a snapshot frame is one SQLite read transaction, with its change cursor taken from the same view"
    state superseded
    scope [
        path "crates/lege-file-index/src/snapshot.rs",
        path "crates/lege-file-index/tests/consumer_contract.rs"
    ]
    intent """
        crates/lege-file-index/src/snapshot.rs write_snapshot (~124-164) documents one read transaction but reads generation, latest change sequence, roots and then each root's entries (write_entries_section ~225-239) through separate pooled connections, so a concurrent writer can yield a frame whose header and rows never coexisted. Hold one read transaction (BEGIN DEFERRED on one connection, WAL snapshot isolation) for the whole frame and read generation, change sequence, roots and entries inside it. Test: a writer committing between sections while a reader snapshots, with row-generation or an equivalent correlated marker proving the frame is one view. The full-payload Vec and services/lege-filed/src/index_host.rs (~292-307) serialising synchronously inside an async D-Bus method give O(index size) peak RAM and block the runtime; that streamed writer plus bounded blocking execution is a separate follow-up, not part of this change.
        """
    note """
        Astra rank P1/P2, snapshot correctness. @legeos.observation.a-snapshot-did-not-say-which-change-position-it-was-consistent-with is the prior fix this completes: the cursor exists, it is just not read from the same view.
        """
    acceptance {
        check one-view {
            statement """
                A concurrent writer/reader test proves every section of a frame, and its change cursor, come from one committed view.
                """
            method command
            command "cargo test -p lege-file-index snapshot"
            verified_by [ @legeos.evidence.effectiveness-1-scoped-tests-20260909/1 ]
        }
    }
    depends_on [
        @legeos.observation.a-snapshot-did-not-say-which-change-position-it-was-consistent-with
    ]
    derived_from [
        @legeos.assessment.astra-memory-polling-indexing-review-20260909#snapshot-frame
    ]
    part_of [ @legeos.work.memory-polling-indexing-effectiveness-20260909 ]
}

