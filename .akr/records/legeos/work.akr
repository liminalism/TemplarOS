record legeos.work.host-update-transaction/1 : work {
    title "The host daemon: kernel and driver as one resumable transaction, two boot backends, enforced polkit"
    state completed
    scope [
        path "crates/lege-hwdetect/**",
        path "distro/deploy/**",
        path "interfaces/dbus/org.legeos.Host.*.xml",
        path "packaging/**",
        path "services/lege-boot-health/**",
        path "services/lege-hostd/**"
    ]
    intent """
        Make lege-hostd able to promote or roll back a kernel and its NVIDIA modules as a pair: the Planned → Downloading → Staging → Verifying → AwaitingReboot → Trial → Promoted|RolledBack|Failed state machine over a durable journal that resumes mid-apt after a restart, with apt run as a child transient unit; a BootManager trait with working systemd-boot and grub backends so ADR-0004's undecided Secure-Boot posture stays a configuration choice rather than a hardcoding; one driver authority that selects a single flavour from detected hardware, verifies the version lock and detects support violations; the storage reserve and its trim order; polkit authorisation checked in the daemon on every privileged method, with the policy and an AppArmor profile shipped; and a lege-boot-health that can actually fail, since it gates boot-complete.target with FailureAction=reboot-force.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.hot-corner-fullscreen-reveal-and-a-centred-island-20260908/1 : work {
    title "The bottom-left corner is Home, fullscreen gets the switcher back on a dwell, and the island stops sitting in the corner"
    state proposed
    scope [
        path "compositor/COMPOSITOR.md",
        path "compositor/lege-comp/src/input.rs",
        path "compositor/lege-comp/src/protocols_shell.rs",
        path "compositor/lege-comp/src/state.rs",
        path "crates/lege-window/src/geometry.rs",
        path "crates/lege-window/src/service.rs",
        path "interfaces/wayland/lege-shell-v1.xml",
        path "shell/lege-shell/src/surface/app.rs",
        path "shell/lege-shell/src/wayland_bridge.rs"
    ]
    intent """
        Three things the user asked for on 2026-09-08 that the shell cannot do alone, because while a window owns the pointer the shell never learns where the pointer is.

        1. A bottom-left hot corner reveals Home. "I would prefer a bottom left hot corner for showing the home screen, not a button" — this replaces the Home chip removed in @legeos.decision.one-persistent-bottom-bar-tags-not-bands/6, whose only surviving pointer route is the Field's own context menu, which a covering window hides.

        2. Fullscreen auto show/hide. "auto show/hide in full screen, and always there on the home screen itself." This reverses rev 5's deletion of the bottom-edge peek: a visible fullscreen window sorts above the shell overlay, so the compositor has to raise the overlay on a dwell. The deleted machinery is recoverable verbatim from commit 0b6d8fc (update_bar_peek / finish_bar_peek / peek_output_at / in_peek_band, WindowService::{peek_output,set_peek_output,is_peeking}).

        3. The island moves off the corner. The island now sits at the bottom-left because a zero-size zone claim anchors a surface at the start of its edge, which is exactly where the hot corner has to be — the two would fight over the same pixels. The fix is an additive alignment on the shell protocol (start / centre / end along the anchored edge) so the island can be centred the way the user's cosmic dock is, with the corner left to Home.
        """
    note """
        One dwell mechanism, two intents, both hung off the single place the compositor already sees the pointer in global logical coordinates (`update_perimeter_cursor`'s call sites in both motion paths). Item 3 adds a Wayland request, so the interface version bumps and the baseline is re-frozen; items 1 and 2 need no protocol change. All three need a logout: lege-comp is Restart=no.
        """
    acceptance {
        check corner-and-island-do-not-fight {
            statement """
                On hardware after a logout: the hot corner reveals Home without revealing the island, and reaching the island does not reveal Home.
                """
            method manual
        }
        check fullscreen-reveal {
            statement """
                A dwell on the bottom edge of an output carrying a visible fullscreen window raises the shell overlay above it, and leaving the edge lowers it again; nothing reflows either way because no zone changes.
                """
            method command
            command "cargo test -p lege-comp -p lege-window"
        }
        check hot-corner {
            statement """
                Resting the pointer in the bottom-left corner reveals Home, from a bare desktop and from under a maximized window alike; sweeping through the corner does not.
                """
            method command
            command "cargo test -p lege-comp -p lege-window"
        }
        check island-placement {
            statement """
                A bottom-anchored shell surface can ask to be centred along its edge; the zero-size claim still reserves nothing, and check-interfaces, check-interface-signatures and the re-frozen baseline all pass.
                """
            method command
            command "cargo run -q -p xtask -- check-interfaces && cargo run -q -p xtask -- check-interface-signatures"
        }
    }
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.iso-hardware-safety/1 : work {
    title "The installation medium does not strand its owner — hardware inventory, seeds that cover it, a live preflight, rescue boot entries and the first ISO build"
    state superseded
    scope [
        path "cli/lege/src/doctor/**",
        path "distro/iso/**",
        path "distro/seeds/selection.toml",
        path "docs/measurements/hardware-inventory-*",
        path "installer/provision.sh",
        path "scripts/hardware-closure.sh",
        path "scripts/hardware-inventory.sh",
        path "tests/integration/iso-qemu.sh"
    ]
    intent """
        Answer "will the ISO leave me without video or networking" before a USB stick is written, not after. Four parts: an inventory of the reference laptop joined to the package that provides each module and each firmware file on the base the medium is built from; the seeds carrying the hardware packages that only a Recommends would otherwise pull in; a live preflight (lege doctor --preflight) that the medium runs at boot and that legeos-install refuses to write over; and two rescue boot entries on the medium for the two ways a machine fails to reach a session.
        """
    note """
        Lane 3 of campaign 2, integrated at 9b9ac2b (commits e066091, 8644461, 914acf7, db617e4). The closure route is one fetch of the pinned snapshot's Contents-amd64.gz, cached; the check itself is offline. Found on the first build attempt: a set published from the Ubuntu 25.10 host cannot install in resolute (legeos-comp depends on libdisplay-info2; resolute ships 3), so native packages are built in a resolute chroot by scripts/build-in-resolute.sh; the live rootfs drops legeos-nvidia-open (its postinst runs update-initramfs in an unshared chroot and fails the transaction). The unprivileged ISO build with the resolute-built set was in progress when the lane was stopped; its outcome is recorded on the iso-builds-and-boots check. laptop-boots-the-medium is the user's gate (RUNBOOK-L3.md).
        """
    acceptance {
        check installer-refuses-a-failed-preflight {
            statement """
                legeos-install writes nothing when the medium's preflight report contains a failure, unless --ignore-preflight is passed.
                """
            method command
            command "PREFLIGHT_REPORT=<a report with a fail line> installer/provision.sh --image /tmp/t.img --apply"
            verified_by [ @legeos.evidence.installer-refuses-failed-preflight-20260907/1 ]
        }
        check inventory-and-closure {
            statement """
                The reference laptop's loaded modules and the firmware they use are joined to the resolute package that provides each, and no firmware in use is unprovided.
                """
            method command
            command "scripts/hardware-inventory.sh docs/measurements/hardware-inventory-dk-82y3-20260907.json && scripts/hardware-closure.sh --inventory docs/measurements/hardware-inventory-dk-82y3-20260907.json"
            verified_by [ @legeos.evidence.hardware-inventory-closure-rerun-20260907/1 ]
        }
        check iso-builds-and-boots {
            statement """
                distro/iso/build.sh produces an ISO from a resolute-built set, and tests/integration/iso-qemu.sh boots it under Secure-Boot OVMF and reads a passing preflight network line off the serial console.
                """
            method command
            command "distro/iso/build.sh --work /var/tmp/legeos-build/@build --out /var/tmp/legeos-build && tests/integration/iso-qemu.sh"
        }
        check laptop-boots-the-medium {
            statement """
                The owner boots the written USB stick on the reference laptop with Secure Boot on, and the preflight report on the live session shows every line passing (or names exactly what did not).
                """
            method manual
        }
        check preflight-is-honest {
            statement """
                The live preflight passes a working machine, fails a machine with no bound driver and no input, calls a radio whose firmware did not load a failure rather than a skip, and skips a machine with no Wi-Fi at all — all against fixture trees, never the host.
                """
            method command
            command "cargo test -p lege preflight"
            verified_by [ @legeos.evidence.preflight-fixture-tests-20260907/1 ]
        }
        check seeds-regenerate {
            statement """
                The hardware layer's additions generate cleanly and name only packages that exist in the declared base.
                """
            method command
            command "cargo run -q -p xtask -- seeds --check && cargo run -q -p xtask -- check-packaging"
            verified_by [ @legeos.evidence.campaign2-merged-gate-20260907/1 ]
        }
    }
    implements [ @legeos.decision.base-ubuntu-2604-kernel-70 ]
    part_of [ @legeos.work.self-hosting-legeos ]
}

record legeos.work.iso-hardware-safety/2 : work {
    title "The installation medium does not strand its owner — hardware inventory, seeds that cover it, a live preflight, rescue boot entries and the first ISO build"
    state active
    scope [
        path "cli/lege/src/doctor/**",
