record legeos.work.index-wp11-shards-20261008/1 : work {
    title "WP11 root-local compact search shards"
    state superseded
    scope [
        path "crates/templar-file-index/src/arrays.rs",
        path "crates/templar-file-index/src/lib.rs",
        path "crates/templar-file-index/src/query.rs",
        path "crates/templar-file-index/tests/search_parity.rs",
        path "docs/measurements/**",
        path "tools/xtask/src/index_bench.rs"
    ]
    intent "Implement WP11 of docs/indexing-dev/implementation-plan.md: root-local immutable shards valid only at each committed root generation, per-root maintenance build admission, SQL fallback for mixed validity, deterministic multi-root ordering, compact names/boxed exact-capacity columns/base-relative IDs, 512MiB retained-array budget, and before/after layout and churn evidence. WP12 starts only from the measured gate."
    acceptance {
        check churn {
            statement """
                Owned 100k quiet-root churn report has at least 95% arrays hits, quiet first-page p95 below 50ms, no greater than 10% quiet-index p95 regression, and churning-root measurements for the WP12 gate.
                """
            method command
            command "xtask index-bench churn"
        }
        check compact-layout {
            statement """
                Layout reports quantify per-row bytes and build RSS before/after; compact IDs/names/boxed columns are retained only with correct parity and measured savings.
                """
            method command
            command "xtask index-bench layout"
        }
        check parity-and-identity {
            statement """
                SQL/array parity passes for all scopes, multiple roots and interleaved mutations; a dirty root does not disable another root's shard; entry-ID reuse cannot alias stale shard rows.
                """
            method command
            command "cargo test -p templar-file-index --test search_parity"
        }
    }
    part_of [ @legeos.work.file-index-core/3 ]
    author "dk"
}

