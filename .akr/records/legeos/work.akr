record legeos.work.index-wp12-overlay-20261008/1 : work {
    title "WP12 bounded generation-pinned search overlay"
    state superseded
    scope [
        path "crates/templar-file-index/src/arrays.rs",
        path "crates/templar-file-index/src/lib.rs",
        path "crates/templar-file-index/src/mutation.rs",
        path "crates/templar-file-index/src/overlay.rs",
        path "crates/templar-file-index/src/query.rs",
        path "crates/templar-file-index/tests/search_parity.rs",
        path "docs/indexing-dev/continuation-2026-10-08.md",
        path "docs/measurements/**"
    ]
    intent """
        Implement WP12 from docs/indexing-dev/implementation-plan.md. The owned WP11 edit-build workload observed churning-root p95 1641.50ms and arrays hit rate 22.48%, meeting both gate conditions. Retain an immutable base plus bounded committed-change copy-on-write overlay at one root generation/change sequence, generation-safe row identity, exact SQL parity and native scope/sort semantics; declare path-sort and over-bound fallbacks, throttle compaction, and measure the resulting churn latency and overlay memory. No stale-base query or unbounded per-keystroke rebuild is permitted.
        """
    acceptance {
        check bounded-overlay {
            statement """
                Overlay publication is one committed root generation/change sequence; bounds and delayed compaction apply, memory is reported and retired views remain immutable.
                """
            method command
            command "cargo test -p templar-file-index overlay"
        }
        check churn-latency {
            statement """
                Owned paired 100k churn report has churning-root initial-page p95 below150ms, arrays+overlay hit rate and memory reported, while quiet-root performance remains qualified.
                """
            method command
            command "xtask index-bench churn --edit-build"
        }
        check mutation-parity {
            statement """
                Base+overlay matches SQL after random create/delete/file rename/directory rename/metadata batches, including native paths, counts, ranks, sort order and reused entry IDs. A directory move beyond the overlay bound uses SQL.
                """
            method command
            command "cargo test -p templar-file-index --test search_parity"
        }
    }
    depends_on [ @legeos.work.index-wp11-shards-20261008/2 ]
    part_of [ @legeos.work.file-index-core/3 ]
    supported_by [ @legeos.evidence.index-wp11-churn-20261008/1 ]
    author "dk"
}

