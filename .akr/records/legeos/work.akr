record legeos.work.compositor-forced-server-side-decorations/1 : work {
    title "Compositor answers every decoration request server-side"
    state superseded
    scope [ path "compositor/COMPOSITOR.md", path "compositor/templar-comp/src/xdg_shell.rs" ]
    intent """
        The compositor draws every window frame: decoration negotiation always answers ServerSide,
        including when a client explicitly requests ClientSide. No application themes its own chrome
        on this system, so windows never show two sets of controls and the compositor's tags are
        always the single authority for move, resize, park, maximize and close. Implemented as a
        pure granted_mode() policy resolved in both request_mode and apply_decoration, with the
        COMPOSITOR.md contract row updated to match.
        """
    acceptance {
        check decoration-negotiation-tests {
            statement """
                The decoration regression test passes: client-side requests are granted server-side.
                """
            method command
            command "cargo test -p templar-comp --bin templar-comp xdg_shell"
            verified_by [ @legeos.evidence.comp-forced-ssd-tests-20261001/1 ]
        }
    }
}

