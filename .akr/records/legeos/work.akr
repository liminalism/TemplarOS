record legeos.work.task-system/1 : work {
    title "The Task System campaign — TaskModel, Taskfield, Task Island fan, Peek, launcher and HomeGarden bridges, and the machine cluster's two sliders"
    state active
    scope [
        path "compositor/COMPOSITOR.md",
        path "compositor/templar-comp-integration/**",
        path "compositor/templar-comp/**",
        path "crates/templar-types/src/action.rs",
        path "crates/templar-window/**",
        path "docs/architecture/task-system.md",
        path "interfaces/dbus/org.templaros.Backlight1.xml",
        path "interfaces/dbus/org.templaros.HomeGarden1.xml",
        path "interfaces/wayland/**",
        path "services/templar-sessiond/src/apis/backlight.rs",
        path "shell/templar-shell/**",
        path "tests/integration/task-system.sh",
        path "tools/xtask/**"
    ]
    intent """
        Implement @legeos.decision.task-system-four-scales-one-model in three lanes on the tree at 2983371. Lane A (templar-window, interfaces, actions, xtask): task::units as the one grouping, taskfield::layout as the pure per-output sectioned layout, Presentation on WindowService with the fullscreen-only-while-Normal rule, Layer::Presentation, manager v8 (open_taskfield, taskfield_state, launcher_focus), the chord swap (Super+Tab opens Taskfield, Alt+` within unit, group-cycle retired), check-wayland-versions. Lane B (compositor): surfaces drawn at presentation rects with no configure, collect_taskfield chrome, in-mode input and keys, Peek at the bottom-left corner with Home's corner moved top-left, Layer::Presentation placement, drag-to-group, tests/integration/task-system.sh. Lane C (shell, sessiond): the account popover's volume slider on wpctl's cubic dB scale with a -60 dB cutoff and mute zone and its brightness slider over a 10% service floor, replacing the five stepper rows; chips without titles with counts and shelved dimming; a four-card fan replacing the hover row; taskfield_screen.rs on Layer::Presentation; launcher running counts with Enter/Ctrl+Enter/arrow; HomeGarden instance association and the 'N windows active' line.
        """
    note """
        Landed 2026-09-10 as 36 commits 7f01f89..3703344 on developer-edition-0-1; every command check green, hands-on open (RUNBOOK: .agent/scratch/task-system-1/RUNBOOK.md, first gate: the cluster takes the pointer nested with nothing else driving the mouse). Deviations, each with its reason in the lane result files: the compositor's right-click card menu, query dimming of non-matching cards, and the pull-back tween are deferred (no compositor menu widget; the widget cache carries no per-element alpha; the tween needs a damage story only a logout can test); adopting a window into a place is the place's context-menu row, not a chip drop (no cross-surface drag exists); HomeGarden1.Observe did not gain instance_id (a bus caller cannot know the instance its request produced) - the broker associates through LaunchObserver and Contexts carries an instances array; AdoptWindow was added instead, baseline refrozen. Follow-ups found along the way and fixed: the compositor now re-sends pointer motion when the surface under a resting pointer moves (6d7943f), the shell declares its input region on every present (186ae89), and the shell's cursor-shift guess is deleted (3703344). Not built, by design: TaskModel/TaskWindow structs, mapped_seq/urgent/transient_for/output fields, Zoom, the weighted packer and layout generation, settings keys, the one-model grep gate, and Phase 6 preview re-send (screencopy is client-pull).
        """
    acceptance {
        check backlight-floor {
            statement """
                Backlight1 clamps every caller to 10..=100 while a one-step panel still gets its one raw step.
                """
            method command
            command "cargo test -p templar-sessiond backlight"
            verified_by [ @legeos.evidence.task-system-backlight-floor-20260910/1 ]
        }
        check fan-and-chips {
            statement """
                The fan caps at four cards and chip order is stable under activation.
                """
            method command
            command "cargo test -p templar-shell fan_caps_at_four && cargo test -p templar-shell chip_order_stable_under_activation"
            verified_by [ @legeos.evidence.task-system-fan-and-chips-20260910/1 ]
        }
        check fullscreen-only-while-normal {
            statement """
                A fullscreen window covers passive chrome only while Presentation::Normal.
                """
            method command
            command "cargo test -p templar-window fullscreen_covers_chrome_only_while_normal"
            verified_by [ @legeos.evidence.task-system-fullscreen-only-while-normal-20260910/1 ]
        }
        check gate {
            statement """
                The full repository gate is green on the merged tree.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.task-system-gate-20260910/1 ]
        }
        check hands-on {
            statement """
                After the user's deploy and logout: the cluster takes the pointer, the sliders are usable, the island shows chips with counts and a fan, Super+Tab shows every window from fullscreen and a click returns, the bottom-left corner peeks and promotes, Alt+Tab is recent.
                """
            method manual
        }
        check layout-is-a-view {
            statement """
                Every Taskfield card lies inside its output, never exceeds its window, never falls below the floor, and a query change never moves a card.
                """
            method command
            command "cargo test -p templar-window taskfield::"
            verified_by [ @legeos.evidence.task-system-layout-is-a-view-20260910/1 ]
        }
        check no-row-anywhere {
            statement """
                The hover row is gone; the fan replaced it.
                """
            method command
            command "! grep -rn ROW_BAND shell/templar-shell/src"
            verified_by [ @legeos.evidence.task-system-no-row-anywhere-20260910/1 ]
        }
        check one-model {
            statement """
                task::units is the only grouping of windows: groups first in id order, then applications first-seen, stable under activation; unverified identity never merges; chip_action hands over above four.
                """
            method command
            command "cargo test -p templar-window task::"
            verified_by [ @legeos.evidence.task-system-one-model-20260910/1 ]
        }
        check protocol-in-step {
            statement """
                Every versioned member of the Wayland XML has its version guard on both ends.
                """
            method command
            command "cargo run -q -p xtask -- check-wayland-versions"
            verified_by [ @legeos.evidence.task-system-protocol-in-step-20260910/1 ]
        }
        check recency-not-stacking {
            statement """
                Alt+Tab's order survives raises, pins and fullscreen; it is activation recency capped at seven, never stacking.
                """
            method command
            command "cargo test -p templar-window switching_uses_semantic_mru_not_visual_stacking && cargo test -p templar-window recent_is_the_switch_order_capped"
            verified_by [ @legeos.evidence.task-system-recency-not-stacking-20260910/1 ]
        }
        check sliders {
            statement """
                The volume slider maps its track to dB with a -60 dB cutoff and a mute zone and round-trips percent; the brightness slider never reaches below the floor.
                """
            method command
            command "cargo test -p templar-shell cluster_screen"
            verified_by [ @legeos.evidence.task-system-sliders-20260910/1 ]
        }
        check taskfield-acceptances {
            statement """
                Entering and leaving Taskfield over a fullscreen Wayland and an XWayland window restores the scene, sends no xdg_toplevel.configure, and survives the shell dying mid-mode.
                """
            method command
            command "TEMPLAR_TASKFIELD_ACCEPT_FOCUS=1 tests/integration/task-system.sh"
            verified_by [ @legeos.evidence.task-system-acceptance-harness-20260910/1 ]
        }
    }
    depends_on [ @legeos.work.semantic-window-registry-20260909 ]
    implements [ @legeos.decision.task-system-four-scales-one-model ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.taskbar-windowing-ownership-fixes-20260910/1 : work {
    title "Taskbar/windowing ownership-boundary fixes from the architecture advisor"
    state proposed
    intent """
        Fix the Task System ownership-boundary faults from advisor ad-ef8f413647fa: compositor move/resize grabs that swallow their own release; Taskfield cancelling itself when its overlay maps; scene membership that is not card-based; motionless-pointer refresh comparing a scene to itself; Peek promotion unreachable; governor last-write-wins per sibling; group-drag repair dropping followers; semantic WindowId vs Wayland object id; masked-buffer leak; compositor-owned frozen layout vs shell reconstruction.
        """
    note """
        P1 ownership-boundary fixes landed uncommitted on developer-edition-0-1 (grab release, overlay map, card-only scene, last-applied pointer scene, semantic window_id since=5, frozen shell layout, masked-buffer teardown, peek promotion, governor OR-aggregate, group-drag repair).

        P2 follow-ups on the same tree: compositor-owned Taskfield paging (frozen cells, PageDown / overflowing header click, Unit filter reaches every window at 1366x768); query matching dims cards (alpha 0.35) and steers selection without moving layout; island overflow chip instead of zero-width chips (BarAction::Overview). In-process acceptances: templar-window paging_ / a_query_dims / enter_and_leave, templar-comp overflow header click. tests/integration/task-system.sh is nested smoke only — it is not proof the mode ran.

        Still follow-up: taskfield_card events for output-local physical coordinates (HiDPI / second output / negative origin). Hands-on after deploy/logout.
        """
    depends_on [ @legeos.work.task-system/1 ]
    part_of [ @legeos.milestone.developer-edition-0-1/1 ]
}

record legeos.work.terminal-workload-identity-20261002/1 : work {
    title "Work started from a terminal runs in its own unit with an identity that names the application that spawned it, and resourced sees workloads and Flatpak scopes"
    state proposed
    scope [
        path "crates/templar-appd/**",
        path "crates/templar-types/src/app.rs",
        path "crates/templar-types/src/unit.rs",
        path "distro/policy/systemd/user/background.slice.d/**",
        path "docs/architecture/**",
        path "interfaces/dbus/**",
        path "services/templar-resourced/**",
        path "services/templar-sessiond/**",
        path "session/profile.d/**"
    ]
    intent """
        Fix @legeos.observation.terminal-workloads-inherit-the-terminal-identity without guessing from process names.
        - A Workload identity alongside the application identity: WorkloadId, spawned_by (the parent application instance), a command summary and a class (interactive, background compute). Unit naming joins app-templaros-<AppId>@<uuid>.service: workload-templaros-<parent-instance>-<n>.scope in background.slice, parsed by templar-types::unit the same way.
        - The route, per the decision's open choice (c). Starting candidate, cheapest that keeps @legeos.constraint.identity-and-launch-safety (no shell for Exec=, identity from the launch cgroup): an opt-in command `templar run -- <cmd>` that asks sessiond to start a transient scope for the caller's own child, and the garden's bash hook offering it automatically for commands the person lists (cargo, make, ninja). Interactive shells stay kitty's. Measure before choosing the automatic form: the extra latency per command and what happens to job control and Ctrl-C in a scope.
        - AppIdentity1 resolves a PID in a workload scope to the workload, with its parent application; windows a workload opens still resolve by the existing rules.
        - resourced discovers workload scopes and app-flatpak-*.scope units as well as Templar launch units, classifies a workload as background so it is reclaimed before the interactive terminal that started it, and never kills the parent for its workload's memory.
        - Interface changes go through check-interface-signatures as additions; nothing shipped changes signature.
        """
    note """
        No live-session effects while testing: transient-unit behaviour is exercised against the systemd fixture the appd tests already use, and a nested session for the end-to-end look.
        """
    acceptance {
        check governor-sees-workloads {
            statement """
                resourced discovers workload and Flatpak scopes, a replay fixture with a build workload under pressure reclaims the workload before its terminal, and existing replay fixtures still reproduce their decisions.
                """
            method command
            command "cargo test -p templar-resourced && cargo test -p templar-resourced --test replay_fixtures --test fixture_report"
        }
        check route-measured-and-chosen {
            statement """
                A short note under docs/architecture/ownership-tiers.md records the measured per-command latency and the job-control/Ctrl-C behaviour of the candidate routes, and the owner's choice for (c).
                """
            method manual
        }
        check signatures-only-grow {
            statement """
                No shipped D-Bus member changed signature.
                """
            method command
            command "cargo run -q -p xtask -- check-interface-signatures"
        }
        check workload-resolves-to-itself {
            statement """
                A PID in a workload scope resolves to its WorkloadId with spawned_by naming the terminal's instance; the terminal's own PIDs still resolve to the terminal; unit-name parsing round-trips.
                """
            method command
            command "cargo test -p templar-appd workload && cargo test -p templar-types unit"
        }
    }
    depends_on [ @legeos.constraint.identity-and-launch-safety ]
    derived_from [ @legeos.observation.terminal-workloads-inherit-the-terminal-identity ]
    implements [ @legeos.decision.three-ownership-tiers ]
    part_of [ @legeos.work.ownership-tiers-20261002 ]
}

record legeos.work.the-bar-floats-an-argb-surface-with-a-coverage-mask-20260908/1 : work {
    title "The island floats: an Argb8888 buffer on the bar's surface, its alpha from a coverage mask, with the opaque present as the fallback"
    state proposed
    scope [
        path "shell/templar-shell/src/previews.rs",
        path "shell/templar-shell/src/surface/app.rs",
        path "shell/templar-shell/src/surface/bar_screen.rs",
        path "shell/templar-shell/src/surface/window.rs",
        path "shell/templar-shell/src/wayland_bridge.rs"
    ]
    intent """
        The user asked for "a collection of icons floating", not a bar. The island is content-width since this morning, but it is still an opaque square plate: the bar is a winit window over softbuffer, which attaches an `Xrgb8888` buffer, so every pixel the frame does not write is black and nothing can be rounded or gapped.

        Attach an `Argb8888` wl_shm buffer to winit's own `wl_surface` instead, through the bridge — winit keeps the xdg role and all the input, and only the pixels come from us. This is the upgrade the draw code's own `ponytail:` note names.
        """
    note """
        Two findings that shaped this.

        **A bare `wl_surface` will not do.** `lege_shell_v1.set_layer_surface` only tags a surface with a layer (`protocols_shell.rs`: `layer_surfaces: HashMap<ObjectId, (WlSurface, Layer)>`); it grants no role, and its own XML says a window's layer is otherwise set "through xdg-shell, not this request". So the shell's overlay surfaces are xdg toplevels that the compositor treats specially, and creating a role-less surface on the bridge's connection would never map. Painting winit's existing surface sidesteps that entirely.

        **pixelkit cannot produce alpha.** `pixelkit_raster::WindowBuffer` holds `0x00RRGGBB`; `blend_channels` uses alpha as a weight and stores none. So the alpha channel has to be built beside the colour buffer: render the island's shapes a second time, white on black, with the same `fill_rounded_rect_aa` primitive, and take a channel of that as the coverage — which also gets anti-aliased corners rather than jagged ones.

        **It cannot be validated here.** The nested session refuses while the user is logged in, so nothing about the attach path can be exercised. It is therefore built as a fallback: if anything in the ARGB present fails, the frame falls back to softbuffer's opaque present, which is exactly today's behaviour. The worst case is the bar we already have.
        """
    acceptance {
        check fallback-is-today {
            statement """
                A failure anywhere in the ARGB present falls back to the opaque softbuffer present, so a bar that cannot float is still a bar.
                """
            method command
            command "cargo test -p lege-shell bar"
        }
        check floats-on-hardware {
            statement """
                After deployment: the island's corners are rounded, the desktop shows through beside and between its chips, and the chips do not leave a black plate behind them.
                """
            method manual
        }
        check mask-is-the-shape {
            statement """
                The coverage mask is opaque exactly where the island, an open hover row and an open account popover are, and transparent everywhere else, at every presence and every scale.
                """
            method command
            command "cargo test -p lege-shell bar"
        }
    }
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.the-bottom-edge-belongs-to-the-window-20260908/1 : work {
    title "A window that fills the screen owns the bottom edge: no tag strip, chrome on a dwell, the cluster gone, the switcher on a peek, and a tag that pins"
    state superseded
    scope [
        path "compositor/COMPOSITOR.md",
        path "compositor/lege-comp/src/**",
        path "crates/lege-window/src/**",
        path "interfaces/wayland/lege-shell-v1.xml",
        path "shell/lege-shell/src/**"
    ]
    intent """
        The user reported that a screen-filling window stops short of the bottom of the display, leaving a black row that its own tag and controls sit in, with the shell's four machine chips drawn on top of the controls; that the switcher felt like click-to-appear rather than hover-to-appear; and that clicking a name tag should pin the window and draw its name in italic. Their "full screen" is a maximized window and the black row is that window's compositor-drawn tag strip, which `client_area` subtracts from the bottom of its geometry.

        One predicate carries the change: `WindowRecord::covers_screen()` = unshelved and (fullscreen or maximized), justified by the bar reserving a zone of 0 so a maximized window's work area is the whole output. `has_frame` is false for such a window, so the black row is gone; its name tag and controls are shown over it on a dwell in the bottom-right corner (`covering_chrome`, generalised from `fullscreen_chrome`); the shell's machine cluster is not drawn while one is up; and the switcher waits under it until the pointer rests on the bottom edge.

        That last one needed a protocol addition. `outranks_overlay` stays fullscreen-only on purpose — promoting a maximized window over `ShellOverlay` would put the launcher, the switcher and every context menu behind the window the user is working in — so the peek could no longer be a pure stacking change: `lege_shell_manager_v1.bar_peeked` (version 7) tells the shell the edge was asked for. It enters the shell's own reveal (`BarData::peeked`) rather than bypassing `covered`, so one gesture has one way out; and the machine cluster comes back on it, so those four readings are not unreachable for as long as anything is maximized.

        Three regions divide the bottom edge, each meaning one thing: the left square is Home whatever is on screen, the right square is the covering window's chrome, the band between is the peek. While that chrome is showing none of the three asks for anything — the strip is under the pointer and the strip is what is being reached for.

        A click on a name tag pins the window above the others; a press that moves is the drag it always was. A pin is a sort key that borrows the `AppOnTop` slot in `stack_key` without assigning the layer, so `layer_of` still reads a pinned window as the ordinary window it is. A pinned name is drawn in a separately discovered italic face, because `pixelkit-text` has no synthetic oblique.

        The strip being drawn *over* the client rather than beside it is what the whole review turned on: the gap between the tags belongs to that window rather than falling through, and a press the compositor takes is not also delivered to the client underneath.
        """
    note """
        Landed at 38b16d5 in eight commits from 5c685b2. Reviewed by a Fable advisor (@legeos.evidence.the-bottom-edge-reviewed-and-its-seven-findings): seven findings, all fixed, plus two judgement calls taken from the same review. One judgement call was deliberately left literal and flagged to the user: every click on a name tag pins or unpins, including the click made only to focus a window. Nothing here was validated with a pointer — scripts/nested-session.sh refuses while the installed session is running, and the compositor half needs a logout.
        """
    acceptance {
        check gate-green {
            statement """
                The whole gate passes at the merged head.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.bottom-edge-gates-20260908/1 ]
        }
        check hands-on-bottom-edge {
            statement """
                On the installed session after a logout: a maximized window reaches the bottom of the display with no black row and no chips over it; resting in the bottom-right corner shows its tag and controls over it; resting on the bottom edge brings the switcher up; the bottom-left corner still goes Home.
                """
            method manual
        }
        check hands-on-pin {
            statement """
                On the installed session: clicking a window's name tag pins it above the others and draws its name in italic; clicking again unpins it; dragging the tag still moves the window.
                """
            method manual
        }
        check no-black-row {
            statement """
                A window filling the screen wears no frame at any bar zone, and a parked one gets its tags back.
                """
            method command
            command "cargo test -p lege-window a_window_that_fills_the_screen_has_no_frame"
            verified_by [ @legeos.evidence.bottom-edge-gates-20260908/1 ]
        }
        check pin-sorts-without-changing-layer {
            statement """
                A pinned window sorts above the others and still reports Layer::Normal.
                """
            method command
            command "cargo test -p lege-window a_pinned_window_sorts_above_the_others_without_changing_layer"
            verified_by [ @legeos.evidence.bottom-edge-gates-20260908/1 ]
        }
        check switcher-waits-and-returns {
            statement """
                The switcher is covered by a filling window, uncovered by the peek and by a reveal, and untouched by an ordinary floating window.
                """
            method command
            command "cargo test -p lege-shell the_switcher_hides_only_under_a_window_that_fills_the_screen"
            verified_by [ @legeos.evidence.bottom-edge-gates-20260908/1 ]
        }
    }
    depends_on [ @legeos.work.window-manager-popup-and-functional-edge-tabs ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    supported_by [ @legeos.evidence.the-bottom-edge-reviewed-and-its-seven-findings ]
}

