    ]
    intent """
        Extend the completed first-party Files manager with selected-file previews for BPG, HEIC/HEIF, JPEG XL, the first page of PDF documents, and ordinary raster formats. Use the user's pure-Rust bpg-rs decoder, JPXL codec, image-viewer decode/downscale design, and Lege PDF renderer; do not route through ImageMagick, ffmpeg, or Poppler. Preview work remains service-owned, bounded by dimensions/source/output/timeout limits, and off the D-Bus executor. Keep JPXL and the Lege renderer behind bounded companion-process seams because those sibling workspaces declare Rust 1.97 while LegeOS's archive MSRV remains 1.93; package their binaries for the installed service rather than weakening that platform constraint. Add a visible Copy Path action that obtains the as-shown path from Files.Actions1 and places it on the real Wayland clipboard without a shell. Make Properties an explicit visible action and have filed compute symlink-safe recursive folder file count and total logical/allocated size, reporting partial scans honestly.
        """
    acceptance {
        check advanced-previews {
            statement """
                BPG and HEIC/HEIF use bpg-rs, JPEG XL uses JPXL, PDF first pages use the Lege renderer, and ordinary rasters use the adapted image-viewer path; every result is bounded and no ImageMagick, ffmpeg, or Poppler route remains.
                """
            method command
            command "cargo test -p lege-filed preview"
        }
        check copy-path {
            statement """
                A visible Copy Path button and Ctrl+Shift+C route obtain the as-shown selection path from Files.Actions1 and write it to a real clipboard sink without shell interpolation.
                """
            method command
            command "cargo test -p lege-files copy_path"
        }
        check folder-properties {
            statement """
                Properties is a visible explicit action and a selected folder reports recursive regular-file count plus logical and allocated totals without following symlinks, marking unreadable subtrees incomplete.
                """
            method command
            command "cargo test -p lege-filed folder_properties && cargo test -p lege-files properties"
        }
        check installable {
            statement """
                The installed legeos-filed package carries the pinned JPXL and Lege PDF companion renderers, has no ImageMagick/ffmpeg/Poppler runtime dependency, and the refreshed Files packages build.
                """
            method command
            command "just preview-codecs && cargo run -q -p xtask -- check-packaging && cargo deb -q -p lege-files && cargo deb -q -p lege-filed"
        }
        check preview-surface {
            statement """
                The standalone manager requests previews stale-safely and paints the selected file's decoded thumbnail in the properties rail without blocking rendering.
                """
            method command
            command "cargo test -p lege-files preview"
        }
        check workspace-quality {
            statement """
                Formatting, strict workspace Clippy, the complete test suite, integration smoke and structural checks remain green.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && tests/integration/run.sh && just tree-check && just deps-check && just check-interfaces"
        }
    }
    depends_on [ @legeos.work.standalone-file-manager/3 ]
    implements [
        @legeos.constraint.packaging-and-render-thread/1,
        @legeos.constraint.services-not-indicators/1
    ]
    part_of [ @legeos.milestone.m2-session-runs/1 ]
    supersedes [ @legeos.work.file-previews-copy-path-and-folder-properties/1 ]
    acknowledged true
}

record legeos.work.file-previews-copy-path-and-folder-properties/3 : work {
    title "Files follow-up — native-codec still/PDF previews, 3%-seek video previews, Copy Path, and recursive properties"
    state completed
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "apps/lege-files/**",
        path "crates/lege-client/**",
        path "debian/**",
        path "docs/architecture/files.md",
        path "interfaces/dbus/org.legeos.Files.*",
        path "justfile",
        path "scripts/**",
        path "services/lege-filed/**",
        path "session/units/user/lege-filed.service"
    ]
    intent """
        Extend the completed first-party Files manager with selected-file previews for BPG, HEIC/HEIF, JPEG XL, the first page of PDF documents, ordinary raster formats, and common videos. Use the user's pure-Rust bpg-rs decoder, JPXL codec, image-viewer decode/downscale design, and Lege PDF renderer for still/PDF content; do not route those formats through ImageMagick or Poppler. Use ffprobe plus ffmpeg only for video and select the frame at 3 percent of the media duration. Preview work remains service-owned, bounded by dimensions/source/output/timeout limits, and off the D-Bus executor. Keep JPXL and the Lege renderer behind a bounded companion-process seam because those sibling workspaces declare Rust 1.97 while LegeOS's archive MSRV remains 1.93; package that binary for the installed service rather than weakening the platform constraint. Add a visible Copy Path action that obtains the as-shown path from Files.Actions1 and places it on the real Wayland clipboard without a shell. Make Properties an explicit visible action and have filed compute symlink-safe recursive folder file count and total logical/allocated size, reporting partial scans honestly.
        """
    acceptance {
        check advanced-previews {
            statement """
                BPG and HEIC use bpg-rs, JPEG XL uses JPXL, PDFs use the Lege renderer, and ordinary rasters use image-rs without ImageMagick or Poppler routes.
                """
            method command
            command "cargo test -p lege-filed preview"
            verified_by [ @legeos.evidence.file-preview-live-fixtures-20260824/1 ]
        }
        check copy-path {
            statement """
                The visible Copy Path action requests the as-shown service path and writes it to the real Wayland clipboard.
