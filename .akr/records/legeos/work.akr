record legeos.work.index-wp14-fsearch-20261008/1 : work {
    title "WP14 FSearch remote shared-index fork and native package"
    state superseded
    scope [
        path "distro/forks/fsearch/**",
        path "distro/forks/manifest.toml",
        path "docs/indexing-dev/continuation-2026-10-08.md",
        path "docs/measurements/**"
    ]
    intent """
        Implement WP14 at the exact upstream FSearch pin05ed650ab101ee3d61795fa5eeeb5c32e1e366c3, preserving GPL-2.0-or-later provenance and reproducible downstream packaging patches. Index-mode builds replace every local database/scanner/watch source with a worker-backed Index1 implementation of the existing database API. Support typed query translation, bounded remote pages and native-byte actions, stable entry-ID selection, generation refresh and typed error handling, honest unsupported modes and roots/preferences owned by Settings. Build the actual DEB and observe owned private GTK integration with5000entries/nonUTF8names/no private database/watches/tree enumeration, then retain same-generation nested shell/FSearch evidence. Default provider switch belongs WP16; physical/install/HDMI gates stay explicit.
        """
    acceptance {
        check nested-generation {
            statement """
                Actual owned nested session displays FSearch info and native shell notice at the same generation for the same query, with retained screenshots and native actions.
                """
            method manual
        }
        check private-shared-index {
            statement """
                Owned private filed+GTK/Xvfb5000entry/nonUTF8 fixture exercises query/sort/pages/native paths/selection/freshness and typed errors; FSearch holds zero inotify/fanotify FDs, creates no fsearch.db and performs no recursive fixture enumeration (GTK theme/icon allowlist retained).
                """
            method command
            command "distro/forks/fsearch/tests/remote-index.sh"
        }
        check query-and-build {
            statement """
                Pinned GPL source with reproducible index-mode patch and Meson pure query translation tests builds the actual TemplarOS FSearch Debian package through scripts/build-fork-deb.sh; scanner/database-file/watch implementations are absent from the index-mode object graph.
                """
            method command
            command "scripts/build-fork-deb.sh fsearch"
        }
    }
    depends_on [
        @legeos.work.index-wp13-diagnostics-20261008/3,
        @legeos.work.index-wp7-wp8-20261008/1
    ]
    part_of [ @legeos.work.silvaview-and-fsearch-share-the-index/1 ]
    author "dk"
}

