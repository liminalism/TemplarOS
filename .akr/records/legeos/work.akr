record legeos.work.display-manager-session-startup-reliability/4 : work {
    title "Make the installed LegeOS display-manager session start deterministically and fail back cleanly"
    state completed
    scope [
        path "compositor/lege-comp/**",
        path "docs/testing/README.md",
        path "services/lege-filed/**",
        path "services/lege-resourced/**",
        path "session/**",
        path "tests/**"
    ]
    intent """
        Repair the installed-session contract exposed by the 2026-08-22 SDDM attempts: eliminate inherited-display backend selection, make compositor readiness real, start the graphical shell on its trusted socket, end the session when the compositor cannot run, and prevent auxiliary services from exhausting resources during login.
        """
    note """
        The 2026-08-23 installed-package retest reached the hardware compositor on both attempts: udev was forced, deterministic public/private sockets opened, the 2560x1600 eDP-2 output lit, resourced stayed healthy, and filed reused its existing index. The black screen remained because the udev backend never flushed queued Wayland replies, so lege-shell blocked in its initial registry/configure round trips and emitted no application-stage logs; it also never sent hardware frame callbacks. Readiness was additionally emitted before DRM/output/XWayland setup and before calloop began dispatching. The work tree now flushes clients after every graphical-backend dispatch, sends udev frame callbacks after output rendering, emits READY from inside calloop after the initial render path, imposes TimeoutStartSec=15s, and logs the shell connection stages. A live Type=notify nested smoke reduced the shell handshake from 5.4 seconds to 11 milliseconds and reached both Home Surface and dock declarations. Targeted tests (167), clippy, integration smoke, systemd verification, package checks, and rebuilt package-content inspection pass; corrected .debs are in target/debian. Installed-login remains open for one more SDDM retest with these rebuilt packages.
        """
    acceptance {
        check aux-services-bounded {
            statement """
                The resource governor no longer self-aborts after mlockall and the file service's default startup indexing has an explicit finite admission bound exercised by tests.
                """
            method command
            command "cargo test -p lege-resourced -p lege-filed"
            verified_by [ @legeos.evidence.refinement-checks-20260824/1 ]
        }
        check installed-login {
            statement """
                After rebuilding and installing the packages, selecting LegeOS in SDDM reaches the graphical Home Surface instead of freezing the greeter or leaving a black screen.
                """
            method manual
            verified_by [ @legeos.evidence.installed-home-visible-20260824/1 ]
        }
        check startup-contract {
            statement """
                Automated session/unit tests prove the installed entry forces the hardware backend, publishes deterministic public and trusted-shell sockets, waits for actual compositor readiness, starts lege-shell --surface, and tears down the target if the compositor exits.
                """
            method command
            command "cargo test -p lege-session -p lege-comp && cargo run -q -p xtask -- check-packaging"
            verified_by [ @legeos.evidence.refinement-integration-smoke-20260824/1 ]
        }
    }
    implements [ @legeos.decision.session-greeter-lock/2 ]
    part_of [ @legeos.milestone.m2-session-runs/1 ]
    supersedes [ @legeos.work.display-manager-session-startup-reliability/3 ]
}

record legeos.work.event-driven-service-audit/1 : work {
    title "Inventory service authorities, activation, recovery and bounded polling exceptions"
    state active
    scope [
        path "crates/lege-file-index/**",
        path "distro/**",
        path "interfaces/**",
        path "services/**"
    ]
    intent """
        Derive one inventory from existing component and unit metadata where possible; declare each service's authoritative domain, lifetime, activation, typed consumer boundary, reconnect procedure, recovery path, deadlines and justified timer or polling exceptions. Reuse filed's sequence/snapshot model. Investigate PSI threshold wakeups for resourced while retaining bounded sampling during active pressure, the replay harness, governor stages and recovery behavior.
        """
    note """
        P1 perimeter resize and this audit may proceed independently. Removing a timer is not completion unless correctness and pressure recovery remain intact.

        2026-09-07. Three notes on how this landed.

        The inventory is data checked by the build, not a document: `distro/deploy/components.toml` gained `authority`, `lifetime`, `consumer_interfaces`, `recovery`, `deadlines` and `timer_exceptions`, and `check-packaging` fails when a component with a unit leaves one blank or declares a lifetime its unit's `Type=` contradicts. The brief's '~48 sleep/interval sites' counted every `Duration::from_*` constant; the number that actually blocks is twelve, four of them test-only, so eight are declared exceptions and one (the governor loop) was fixed.

        `cargo tree -p lege-client -i rusqlite` was scoped as the evidence for `file-index-contract`'s no-shared-store half. It *succeeds* at HEAD, so it could not be reported as failing (@legeos.observation.lege-client-links-rusqlite-through-the-shared-index-types). The check now rests on `consumer_contract.rs`, which drives every read through snapshot and `changes_since`; the dependency split is deferred because it needs four manifests outside this lane.

        Writing that contract as one consumer-shaped sequence found a real hole every separate unit test had passed over: a snapshot did not say which change-log position it was consistent with (@legeos.observation.a-snapshot-did-not-say-which-change-position-it-was-consistent-with). Fixed by `SnapshotManifest.snapshot_seq`. `interfaces/dbus/org.legeos.Files.Index1.xml` still needs a line of prose describing that field — the file is outside this lane's writable set.
        """
    acceptance {
        check file-index-contract {
            statement """
                Index consumers synchronize snapshots and sequence-based changes without a read/subscribe gap, handle SnapshotRequired by resnapshotting, and drive every read through the typed boundary rather than the owner's SQLite store.
                """
            method command
            command "cargo test -p lege-file-index --test consumer_contract && cargo test -p lege-file-index -p lege-filed"
            verified_by [ @legeos.evidence.service-inventory-and-pressure-wakeups-20260907 ]
        }
        check idle-activity {
            statement """
                Idle wakeups per daemon are measurable from /proc without touching the session, and the measurement is either taken or reported as not executed with its reason.
                """
            method observation
            verified_by [ @legeos.evidence.idle-daemon-wakeups-not-executed-20260907 ]
        }
        check resourced-policy {
            statement """
                The governor waits on the delegated cgroup's memory.pressure with a bounded active interval and an idle heartbeat, records why each tick woke, and reaches identical decisions whether or not a trigger was available.
                """
            method command
            command "cargo test -p lege-resourced"
            verified_by [ @legeos.evidence.service-inventory-and-pressure-wakeups-20260907 ]
        }
        check service-inventory {
            statement """
                Every owned service declares an authority, lifetime, consumer interfaces, recovery, deadlines and every timer exception in distro/deploy/components.toml, the declared lifetime agrees with the unit's Type=, and check-packaging fails when one is missing.
                """
            method command
            command "cargo run -q -p xtask -- check-packaging && cargo test -p xtask"
            verified_by [ @legeos.evidence.service-inventory-and-pressure-wakeups-20260907 ]
        }
    }
    depends_on [ @legeos.constraint.native-lubuntu-is-the-development-environment/1 ]
    implements [ @legeos.decision.event-driven-service-authorities ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.file-index-core/1 : work {
    title "F1 — the lege-file-index core crate, the cache database with generations, and the org.legeos.Files.Index1 contract"
    state completed
    scope [
        path "Cargo.toml",
        path "cli/lege/src/files.rs",
        path "crates/lege-client/src/proxies/files.rs",
        path "crates/lege-file-index/**",
        path "interfaces/dbus/org.legeos.Files.Index1.xml",
        path "services/lege-filed/Cargo.toml",
        path "services/lege-filed/src/dbus.rs",
        path "services/lege-filed/src/index_host.rs",
        path "services/lege-filed/src/main.rs",
        path "services/lege-filed/src/search.rs",
        path "session/units/user/lege-filed.service"
    ]
    intent """
        Phase 0 and 1 of docs/planning/shared-incremental-file-index.md: a pure crates/lege-file-index (schema v1 with generations, native-byte paths plus display text, object keys, root freshness states, one writer with WAL readers, atomic generation commit that preserves the last good generation, uncapped streaming scan under configured budgets yielding an explicit incomplete state, FTS5-trigram substring search behind a QueryPlanner trait, paged cursors bound to a generation, sealed snapshot framing, Mutation and Change types for the maintenance lane); lege-filed opens $XDG_CACHE_HOME/legeos/file-index-v1.sqlite3, Search1 delegates to the core, Index1 (Roots, Search, FetchPage, OpenSnapshot, ChangesSince, signals) is hosted, proxied in lege-client and reachable as `lege files index status|search|reconcile`.
        """
    note """
        Plan of record: docs/planning/shared-incremental-file-index.md via the parent @legeos.work.shared-incremental-file-index. HEAD reconciliation 2026-09-03: search.rs is a delete-then-insert, 50k-capped LIKE index inside the shared state mutex; FTS5 trigram is available from the bundled SQLite 3.53.2 without a feature change; Index1 exists nowhere. The two-million-entry release fixture is an ignored test whose command is recorded; the coordinator runs it at the integrated gate.
        """
    acceptance {
        check generations-and-lossless-paths {
            statement """
                A killed rebuild leaves the previous committed generation readable, a non-UTF-8 path round-trips through index, search and snapshot, and a cursor stays pinned to the generation it was opened on.
                """
            method command
            command "cargo test -p lege-file-index"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-integrated-gate-20260904/1
            ]
        }
        check index1-gates {
            statement """
                org.legeos.Files.Index1 passes check-interfaces, check-proxies and check-interface-signatures after the baseline is re-frozen.
                """
            method command
            command "cargo run -q -p xtask -- check-interfaces && cargo run -q -p xtask -- check-proxies && cargo run -q -p xtask -- check-interface-signatures"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-integrated-gate-20260904/1
            ]
        }
        check warm-start-and-compat {
            statement """
                A warm lege-filed start serves the prior generation without walking a root, Search1 clients keep working, and a budget-limited scan reports incomplete rather than complete.
                """
            method command
            command "cargo test -p lege-filed search"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-integrated-gate-20260904/1
            ]
        }
    }
    part_of [
        @legeos.milestone.developer-edition-0-1,
        @legeos.work.shared-incremental-file-index
    ]
}

record legeos.work.file-index-maintenance/1 : work {
    title "F2 — one watcher owner keeps the index current, operations mutate it directly, and freshness degrades honestly"
    state completed
    scope [
        path "crates/lege-file-index/src/coalesce.rs",
        path "crates/lege-file-index/src/reconcile.rs",
        path "crates/lege-file-index/src/watch.rs",
        path "crates/lege-file-index/tests/**",
        path "services/lege-filed/src/execute.rs",
        path "services/lege-filed/src/operations.rs",
        path "services/lege-filed/src/watcher.rs"
    ]
    intent """
        Phase 2 of docs/planning/shared-incremental-file-index.md against the frozen core contract: a Linux watcher backend chosen from measured inotify/fanotify needs, normalized and coalesced events committed one generation per batch, direct mutation from successful lege-filed operations with the later watch event deduplicated, overflow/rename-ambiguity/mount-disappearance handling, downtime and offline-root reconciliation through observable current→stale→reconciling→current transitions that never discard the prior generation, and a startup that never scans synchronously. The fixture rule from the trash incident is mechanized: test code cannot construct TrashMounts::System or watch a non-temporary root.
        """
    note """
        Start gate: the coordinator's C5 freeze message. Before it, only fixtures and the backend decision. HEAD reconciliation 2026-09-03: no watcher dependency anywhere; operations.rs and execute.rs never touch the index.
        """
    acceptance {
        check events-become-queryable {
            statement """
                A create, move, rename or delete becomes queryable within the agreed bound under a fake clock, and a filed operation's direct mutation deduplicates the later watch event.
                """
            method command
            command "cargo test -p lege-file-index watch"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-integrated-gate-20260904/1
            ]
        }
        check honest-freshness {
            statement """
                Forced overflow and daemon downtime drive current→stale→reconciling→current while the prior generation stays visible, and starting the daemon returns existing results before reconciliation.
                """
            method command
            command "cargo test -p lege-file-index reconcile && cargo test -p lege-filed watcher"
            verified_by [
                @legeos.evidence.de01-integrated-gate-20260904,
                @legeos.evidence.de01-integrated-gate-20260904/1
            ]
        }
    }
    depends_on [ @legeos.work.file-index-core ]
    part_of [
        @legeos.milestone.developer-edition-0-1,
        @legeos.work.shared-incremental-file-index
    ]
}

record legeos.work.file-operations-from-home/1 : work {
    title "Copy, cut, paste, drag/drop, trash and ordinary file actions inside Home folder surfaces"
    state completed
    scope [
        path "apps/lege-files/**",
        path "crates/lege-client/**",
        path "interfaces/dbus/org.legeos.Files.Operations1.xml",
        path "services/lege-filed/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Complete ordinary file manipulation inside expanded Home folders and shortcut panes, using the multi-selection model that now exists. Ctrl+C/Ctrl+X/Ctrl+V copy or move every selected item through Files.Operations1; the clipboard advertises and accepts standard URI-list data where possible so Files and other desktop applications interoperate. Delete moves real files to Trash through the journalled service and reports an undo route. Rename, New Folder, Properties and Copy Path remain part of the same coherent action surface.

        Implement drag and drop with typed destinations. Dropping onto a real folder copies or moves according to the declared gesture/modifier; dropping onto a shortcut pane adds references unless the user explicitly chooses a file operation; dropping onto an application resolves an Open With/application action; dragging out exports URI-list data. Bare Home never accepts an individual file as a loose tile and instead routes it to a shortcut pane per the governing object model.

        All bulk operations are one journalled operation with one progress/error surface and one undo. The Home field-layout undo and file-operation undo remain distinct internally, but the focused surface routes Ctrl+Z to the most recent applicable action and says which action will be undone. Conflict, permission, partial-failure and cross-device cases are answered by the file service rather than guessed by the shell.
        """
    note """
        Rank 3 of the audit's daily-work gaps. Selection and folders/panes both landed, unblocking this. Acceptance command for trash-delete-and-undo corrected to pass both libtest filters after --; cargo takes only one TESTNAME positionally.
        """
    acceptance {
        check clipboard-bulk-operations {
            statement """
                Copy, cut and paste operate on the complete selected path set as one journalled service operation, support standard URI-list clipboard interchange, and never duplicate a cut source after success.
                """
            method command
            command "cargo test -p lege-filed -p lege-shell -p lege-files clipboard"
            verified_by [ @legeos.evidence.file-operations-from-home-20260831/1 ]
        }
        check ordinary-file-verbs {
            statement """
                Rename, New Folder, Properties and Copy Path are available by keyboard and pointer in Home folder surfaces with the same service semantics as the standalone Files app.
                """
            method command
            command "cargo test -p lege-shell file_actions && cargo run -q -p xtask -- check-actions"
            verified_by [ @legeos.evidence.file-operations-from-home-20260831/1 ]
        }
        check progress-and-failure {
            statement """
                Bulk copy/move/trash exposes bounded progress, cancellation and item-specific failures without reporting a partially failed operation as wholly successful.
                """
            method command
            command "cargo test -p lege-filed operations"
            verified_by [ @legeos.evidence.file-operations-from-home-20260831/1 ]
        }
        check trash-delete-and-undo {
            statement """
                Delete moves selected real items to Trash as one operation, Remove from Pane only removes references, and one undo restores every successfully trashed item exactly.
                """
            method command
            command "cargo test -p lege-filed -- trash undo"
            verified_by [ @legeos.evidence.file-operations-from-home-20260831/1 ]
        }
        check typed-drag-drop {
            statement """
                Drag/drop distinguishes real folders, shortcut panes, applications and external URI-list targets; every target advertises the exact operation before release and bare Home never creates a loose file tile.
                """
            method command
            command "cargo test -p lege-shell drag_drop"
            verified_by [ @legeos.evidence.file-operations-from-home-20260831/1 ]
        }
    }
    depends_on [
        @legeos.work.home-field-selection-and-bulk-action,
        @legeos.work.home-folders-and-shortcut-panes
    ]
    derived_from [ @legeos.assessment.home-field-usability-gaps-20260831 ]
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.file-previews-copy-path-and-folder-properties/1 : work {
    title "Files follow-up — advanced previews, real Copy Path, and recursive folder properties"
    state superseded
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "apps/lege-files/**",
        path "crates/lege-client/**",
        path "debian/**",
        path "docs/architecture/files.md",
        path "interfaces/dbus/org.legeos.Files.*",
        path "services/lege-filed/**",
        path "session/units/user/lege-filed.service"
    ]
    intent """
        Extend the completed first-party Files manager with selected-file previews for HEIC/HEIF, JPEG XL and the first page of PDF documents, plus ordinary raster formats. Preview decoding is service-owned, bounded by dimensions/source/output/timeout limits, runs off the D-Bus executor, prefers the user's installed JPXL helper when available, and uses packaged helper fallbacks so LegeOS keeps its Rust 1.93 MSRV and independent source packaging. Add a visible Copy Path action that obtains the as-shown path from Files.Actions1 and places it on the real Wayland clipboard without a shell. Make Properties an explicit visible action and have filed compute symlink-safe recursive folder file count and total logical/allocated size, reporting partial scans honestly.
        """
    acceptance {
        check advanced-previews {
            statement """
                HEIC/HEIF, JPEG XL, PDF first-page and ordinary raster paths route through bounded service-owned preview helpers and valid bounded PNG output is accepted.
                """
            method command
            command "cargo test -p lege-filed preview"
        }
        check copy-path {
            statement """
                A visible Copy Path button and Ctrl+Shift+C route obtain the as-shown selection path from Files.Actions1 and write it to a real clipboard sink without shell interpolation.
                """
            method command
            command "cargo test -p lege-files copy_path"
        }
        check folder-properties {
            statement """
                Properties is a visible explicit action and a selected folder reports recursive regular-file count plus logical and allocated totals without following symlinks, marking unreadable subtrees incomplete.
                """
            method command
            command "cargo test -p lege-filed folder_properties && cargo test -p lege-files properties"
        }
        check installable {
            statement """
                The helper and clipboard runtime dependencies remain synchronized between cargo-deb and the Debian source package, and the refreshed package builds.
                """
            method command
            command "cargo run -q -p xtask -- check-packaging && cargo deb -q -p lege-files && cargo deb -q -p lege-filed"
        }
        check preview-surface {
            statement """
                The standalone manager requests previews stale-safely and paints the selected file's decoded thumbnail in the properties rail without blocking rendering.
                """
            method command
            command "cargo test -p lege-files preview"
        }
        check workspace-quality {
            statement """
                Formatting, strict workspace Clippy, the complete test suite, integration smoke and structural checks remain green.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && tests/integration/run.sh && just tree-check && just deps-check && just check-interfaces"
        }
    }
    depends_on [ @legeos.work.standalone-file-manager/3 ]
    implements [
        @legeos.constraint.packaging-and-render-thread/1,
        @legeos.constraint.services-not-indicators/1
    ]
    part_of [ @legeos.milestone.m2-session-runs/1 ]
    acknowledged true
}

record legeos.work.file-previews-copy-path-and-folder-properties/2 : work {
    title "Files follow-up — native-codec previews, real Copy Path, and recursive folder properties"
    state superseded
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "apps/lege-files/**",
        path "crates/lege-client/**",
        path "debian/**",
        path "docs/architecture/files.md",
        path "interfaces/dbus/org.legeos.Files.*",
        path "justfile",
        path "scripts/**",
        path "services/lege-filed/**",
        path "session/units/user/lege-filed.service"
    ]
    intent """
        Extend the completed first-party Files manager with selected-file previews for BPG, HEIC/HEIF, JPEG XL, the first page of PDF documents, and ordinary raster formats. Use the user's pure-Rust bpg-rs decoder, JPXL codec, image-viewer decode/downscale design, and Lege PDF renderer; do not route through ImageMagick, ffmpeg, or Poppler. Preview work remains service-owned, bounded by dimensions/source/output/timeout limits, and off the D-Bus executor. Keep JPXL and the Lege renderer behind bounded companion-process seams because those sibling workspaces declare Rust 1.97 while LegeOS's archive MSRV remains 1.93; package their binaries for the installed service rather than weakening that platform constraint. Add a visible Copy Path action that obtains the as-shown path from Files.Actions1 and places it on the real Wayland clipboard without a shell. Make Properties an explicit visible action and have filed compute symlink-safe recursive folder file count and total logical/allocated size, reporting partial scans honestly.
        """
    acceptance {
        check advanced-previews {
            statement """
                BPG and HEIC/HEIF use bpg-rs, JPEG XL uses JPXL, PDF first pages use the Lege renderer, and ordinary rasters use the adapted image-viewer path; every result is bounded and no ImageMagick, ffmpeg, or Poppler route remains.
                """
            method command
            command "cargo test -p lege-filed preview"
        }
        check copy-path {
            statement """
                A visible Copy Path button and Ctrl+Shift+C route obtain the as-shown selection path from Files.Actions1 and write it to a real clipboard sink without shell interpolation.
                """
            method command
            command "cargo test -p lege-files copy_path"
        }
        check folder-properties {
            statement """
                Properties is a visible explicit action and a selected folder reports recursive regular-file count plus logical and allocated totals without following symlinks, marking unreadable subtrees incomplete.
                """
            method command
            command "cargo test -p lege-filed folder_properties && cargo test -p lege-files properties"
        }
        check installable {
            statement """
                The installed legeos-filed package carries the pinned JPXL and Lege PDF companion renderers, has no ImageMagick/ffmpeg/Poppler runtime dependency, and the refreshed Files packages build.
                """
            method command
            command "just preview-codecs && cargo run -q -p xtask -- check-packaging && cargo deb -q -p lege-files && cargo deb -q -p lege-filed"
        }
        check preview-surface {
            statement """
                The standalone manager requests previews stale-safely and paints the selected file's decoded thumbnail in the properties rail without blocking rendering.
                """
            method command
            command "cargo test -p lege-files preview"
        }
        check workspace-quality {
            statement """
                Formatting, strict workspace Clippy, the complete test suite, integration smoke and structural checks remain green.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && tests/integration/run.sh && just tree-check && just deps-check && just check-interfaces"
        }
    }
    depends_on [ @legeos.work.standalone-file-manager/3 ]
    implements [
        @legeos.constraint.packaging-and-render-thread/1,
        @legeos.constraint.services-not-indicators/1
    ]
    part_of [ @legeos.milestone.m2-session-runs/1 ]
    supersedes [ @legeos.work.file-previews-copy-path-and-folder-properties/1 ]
    acknowledged true
}

record legeos.work.file-previews-copy-path-and-folder-properties/3 : work {
    title "Files follow-up — native-codec still/PDF previews, 3%-seek video previews, Copy Path, and recursive properties"
    state completed
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "apps/lege-files/**",
        path "crates/lege-client/**",
        path "debian/**",
        path "docs/architecture/files.md",
        path "interfaces/dbus/org.legeos.Files.*",
        path "justfile",
        path "scripts/**",
        path "services/lege-filed/**",
        path "session/units/user/lege-filed.service"
    ]
    intent """
        Extend the completed first-party Files manager with selected-file previews for BPG, HEIC/HEIF, JPEG XL, the first page of PDF documents, ordinary raster formats, and common videos. Use the user's pure-Rust bpg-rs decoder, JPXL codec, image-viewer decode/downscale design, and Lege PDF renderer for still/PDF content; do not route those formats through ImageMagick or Poppler. Use ffprobe plus ffmpeg only for video and select the frame at 3 percent of the media duration. Preview work remains service-owned, bounded by dimensions/source/output/timeout limits, and off the D-Bus executor. Keep JPXL and the Lege renderer behind a bounded companion-process seam because those sibling workspaces declare Rust 1.97 while LegeOS's archive MSRV remains 1.93; package that binary for the installed service rather than weakening the platform constraint. Add a visible Copy Path action that obtains the as-shown path from Files.Actions1 and places it on the real Wayland clipboard without a shell. Make Properties an explicit visible action and have filed compute symlink-safe recursive folder file count and total logical/allocated size, reporting partial scans honestly.
        """
    acceptance {
        check advanced-previews {
            statement """
                BPG and HEIC use bpg-rs, JPEG XL uses JPXL, PDFs use the Lege renderer, and ordinary rasters use image-rs without ImageMagick or Poppler routes.
                """
            method command
            command "cargo test -p lege-filed preview"
            verified_by [ @legeos.evidence.file-preview-live-fixtures-20260824/1 ]
        }
        check copy-path {
            statement """
                The visible Copy Path action requests the as-shown service path and writes it to the real Wayland clipboard.
                """
            method command
            command "cargo test -p lege-files copy_path"
            verified_by [ @legeos.evidence.file-copy-path-20260824/1 ]
        }
        check folder-properties {
            statement """
                Explicit Properties reports recursive file count and total folder size without following symlinks, and the UI labels partial results.
                """
            method command
            command "cargo test -p lege-filed folder_properties && cargo test -p lege-files properties"
            verified_by [ @legeos.evidence.file-folder-properties-20260824/1 ]
        }
        check installable {
            statement """
                The native preview companion is reproducibly staged and both Files packages retain valid install metadata and runtime dependencies.
                """
            method command
            command "just preview-codecs && cargo run -q -p xtask -- check-packaging && cargo deb -q -p lege-files && cargo deb -q -p lege-filed"
            verified_by [ @legeos.evidence.file-preview-packaging-20260824/1 ]
        }
        check preview-surface {
            statement """
                The standalone manager requests previews without blocking and paints stale-safe results in its selected-item inspector.
                """
            method command
            command "cargo test -p lege-files preview"
            verified_by [ @legeos.evidence.file-preview-surface-20260824/1 ]
        }
        check video-previews {
            statement """
                Common video files are rendered by ffmpeg at 3 percent of their ffprobe-reported duration and produce bounded previews.
                """
            method command
            command "cargo test -p lege-filed video_preview"
            verified_by [ @legeos.evidence.file-video-preview-three-percent-20260824/1 ]
        }
        check workspace-quality {
            statement """
                Formatting, linting, workspace tests, integration checks, interfaces, dependencies, MSRV, and structural checks pass.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && cargo test -p lege-comp-integration && cargo run -q -p xtask -- tree-check && cargo run -q -p xtask -- deps-check && cargo run -q -p xtask -- check-interfaces && cargo +1.93 check --workspace"
            verified_by [ @legeos.evidence.file-preview-workspace-quality-20260824/1 ]
        }
    }
    depends_on [ @legeos.work.standalone-file-manager/3 ]
    implements [
        @legeos.constraint.packaging-and-render-thread/1,
        @legeos.constraint.services-not-indicators/1
    ]
    part_of [ @legeos.milestone.m2-session-runs/1 ]
    supersedes [ @legeos.work.file-previews-copy-path-and-folder-properties/2 ]
    acknowledged true
}

record legeos.work.filed-transactions/1 : work {
    title "The file service: journalled transactions, trash, storage reserve, recents, search"
    state completed
    scope [
        path "crates/lege-client/src/proxies/files.rs",
        path "crates/lege-state/src/migrations/files.rs",
        path "interfaces/dbus/org.legeos.Files.*.xml",
        path "services/lege-filed/**"
    ]
    intent """
        Make lege-filed the owner of file state rather than the file manager: survey/plan split so conflict and ordering rules are testable without a filesystem; idempotent journalled steps (copy to a temporary in the destination directory, flush file and directory entry, verify by size or CRC-32 read-back, expose atomically, delete the source last) with resume-after-crash; same-device moves as one rename; conflict policy decided once at plan time; undo planned at commit time for rename, move and trash while delete stays irreversible; the freedesktop trash with the per-volume fallback; volumes, the mount table and the reserve kept for logging in, updating and recovering; recents and the one shared last-directory answer; a name-and-metadata search index with saved queries; and the path actions that are otherwise a service menu.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.files-windows-bookmarks-home-objects-20260907/1 : work {
    title "Home hidden behind translucent windows, Files as its own windows, folder icons and menus with bookmarks, folders added to Home from a Files window"
    state active
    scope [
        path "apps/lege-files/**",
        path "compositor/lege-comp/src/scene.rs",
        path "crates/lege-field/**",
        path "crates/lege-window/**",
        path "interfaces/dbus/org.legeos.Files.Browse1.xml",
        path "interfaces/dbus/org.legeos.HomeField1.xml",
        path "services/lege-filed/**",
        path "services/lege-sessiond/src/apis/homefield.rs",
        path "shell/lege-shell/**"
    ]
    intent """
        User request (2026-09-07): 'making sure that the homescreen does not bleed through transparent windows like kitty windows. it should only be visible when expressly switching to it with the super key or similar. then the file manager doesnt seem to open instances of its own, they should be their own instances so that they can be alt tabbed to. on the left side of the file manager, there are labels for files or folders, those should be folder icons, justified to the left of the text, not word labels. there should be a right click menu for folders in the file manager for actions like copy, paste, properties (with file size), and bookmark. it should also be possible to remove bookmarks from the left side. i should also be able to drag folders to the home screen and create clickable objects out of them.' Implemented uncommitted: lege-window hides Layer::HomeSurface unless home_revealed and the compositor scene skips invisible windows entirely; the Home Files object, folder tiles and folder rows in the Files widget launch org.legeos.Files through Launcher1 so each folder is a switcher-listed window; the Files app rail draws a folder or drive glyph left of the label; a right-click menu on entries, ground and bookmark rows (Open, Open in new window, Copy, Cut, Paste into folder, Bookmark, Add to Home, Rename, Trash, Properties) with bookmarks persisted by lege-filed (Files.Browse1.SetBookmark, folder_bookmarks table, bookmark: roots) and removable from the rail; folders reach Home through HomeField1.PlaceFolder (lege_field::place_folder_op shared with the shell's folder_tile_id derivation) and the shell adopts tiles other clients placed by watching HomeField1.Changed.
        """
    note """
        Dragging a folder out of a Files window onto Home is served by the 'Add to Home' menu row, not by a cross-client wl_data_device drop: the Files app has no drag source and Home is hidden while a client window has the pointer, which makes a pointer drop onto Home unreachable by design. A drop target in the shell belongs to @legeos.work.wayland-clipboard-and-dnd-transport. Desktop added via PlaceFolder derives folder:<path> while the shell's own Desktop object uses folder:desktop; the shell's merge places Desktop itself, so this only matters if a user adds ~/Desktop by hand.
        """
    acceptance {
        check files-is-a-window {
            statement """
                A press on the Home Files object's ground yields FieldAction::Launch(org.legeos.Files) and does not expand the shell into a file manager; the shell-only views still expand in place.
                """
            method command
            command "cargo test -p lege-shell expanding_grows_out_of_the_tile"
            verified_by [
                @legeos.evidence.files-windows-bookmarks-home-objects-gate-20260907/1
            ]
        }
        check gate-green {
            statement """
                just check passes: fmt, clippy -D warnings, workspace tests, MSRV, interface/proxy/baseline/action checks, with HomeField1.PlaceFolder and Files.Browse1.SetBookmark frozen as additions.
                """
            method command
            command "just check"
            verified_by [
                @legeos.evidence.files-windows-bookmarks-home-objects-gate-20260907/1
            ]
        }
        check hands-on-confirmation {
            statement """
                At the installed desktop: nothing of Home shows through a translucent kitty window; each folder opens its own Alt+Tab-able Files window; the rail shows glyphs left of names; the right-click menu adds and removes bookmarks; Add to Home puts a clickable folder object on Home.
                """
            method manual
        }
        check home-hidden-unless-revealed {
            statement """
                lege-window: a Layer::HomeSurface window is not visible until home_revealed, and visible again once it is; the compositor scene draws no invisible window.
                """
            method command
            command "cargo test -p lege-window -p lege-comp"
            verified_by [
                @legeos.evidence.files-windows-bookmarks-home-objects-gate-20260907/1
            ]
        }
    }
    derived_from [ @legeos.work.home-navigation-manipulation-20260907 ]
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.hands-on-run-5-fixes ]
}

record legeos.work.focus-and-switching-20260908/1 : work {
    title "A new window takes the keyboard at map, and Alt+Tab walks every window on a list frozen for the hold"
    state active
    scope [
        path "compositor/COMPOSITOR.md",
        path "compositor/lege-comp/**",
        path "crates/lege-window/**",
        path "shell/lege-shell/src/taskbar.rs"
    ]
    intent """
        Lane A of campaign 4, from the user's session at gfbe4480: an application opened from the Home search bar maps unfocused under a Home surface that still holds the keyboard, and Alt+Tab cannot reach a window buried under two others. Three parts. (1) WindowService::should_activate_on_map — a client window, and no visible activated fullscreen client window on the same output — is called from both map paths (xdg_shell::handle_toplevel_commit after apply_surface_claims, xwayland::map_window_request) so a newly mapped window takes the keyboard; nothing else in the map sequence activates one and a launch through Launcher1 carries no xdg-activation token. (2) The switcher walks a list frozen at the first press (lege_window::SwitchRing) until the modifier is released: every step activates, activation raises, and the list is the stacking order, so a list rebuilt per press only ever swaps the top two windows and a third window was unreachable however many times Tab was pressed. Alt+Tab now walks every unshelved client window in most-recently-activated order — which the stacking order already is, LayerStack's rank being a monotonic counter bumped on every raise, so there is deliberately no recency stamp on WindowRecord. Within-group cycling is dropped: scoping Alt+Tab to the focused window's group made a group a place Alt+Tab could not leave. Super+Tab is unchanged in meaning and gains the same frozen list. cycle_focus, cycle_within_group and cycle_groups are deleted. (3) taskbar::entries was found to lose no window; the remaining bar gap is that a multi-window application chip shows no count, sent to the coordinator as a bar_screen.rs hunk (Lane B's file).
        """
    note """
        Base 1c56b77 on developer-edition-0-1. Compositor and lege-window changes need a logout on the installed session (lege-comp.service is Restart=no): see RUNBOOK-lane-A.md. The switcher activates at each step rather than committing on release; the ceiling is marked with a ponytail: comment in keybindings.rs::step_switcher.
        """
    acceptance {
        check compositor-green {
            statement """
                The compositor builds and its tests pass with the switcher rewritten onto the frozen ring and both map paths activating.
                """
            method command
            command "cargo test -p lege-comp"
            verified_by [ @legeos.evidence.focus-and-switching-compositor-20260908 ]
        }
        check focus-at-map-observed {
            statement """
                In a running compositor, a newly mapped client window reports activated=true on its 'toplevel mapped' line.
                """
            method observation
            verified_by [ @legeos.evidence.a-new-window-takes-the-keyboard-nested-20260908 ]
        }
        check hands-on {
            statement """
                At the installed desktop after a logout: an application opened from the Home search bar has the keyboard and can be typed into immediately; Alt+Tab held with two Tab presses reaches a third window; every open window is accounted for on the bar.
                """
            method manual
        }
        check taskbar-complete {
            statement """
                Every unshelved client window of a mixed snapshot — unresolved identities, a parked loose window, a group with one member parked, an XWayland-shaped window — appears in exactly one taskbar entry.
                """
            method command
            command "cargo test -p lege-shell --lib taskbar::"
            verified_by [ @legeos.evidence.taskbar-accounts-for-every-window-20260908 ]
        }
        check window-model {
            statement """
                should_activate_on_map holds for a client window, is false for a shell-layer surface and for a window mapping beside an activated fullscreen window on the same output but true on another output; SwitchRing's first forward step is the previously activated window, it wraps, and a frozen list reaches a third window where a rebuilt one only oscillates; switch_order skips shelved and non-client windows.
                """
            method command
            command "cargo test -p lege-window"
            verified_by [ @legeos.evidence.focus-and-switching-window-model-20260908 ]
        }
    }
    derived_from [ @legeos.work.window-groups ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.full-distribution-roadmap/1 : work {
    title "Ubuntu-derived full distribution and latest-stable kernel roadmap"
    state proposed
    intent """
        Turn the LegeOS desktop/session and existing distro scaffold into a supportable amd64 Ubuntu 26.04
        binary derivative: clean source builds, signed overlay archive, reproducible image and live installer,
        safe in-series updates, recovery, security operations, hardware qualification, and a LegeOS-owned
        latest-qualified-stable kernel lane. Linux release candidates remain experimental and Ubuntu's signed
        GA kernel remains a rescue path until the independent kernel/driver/signing pipeline is proven.
        """
    note """
        DEFERRED 2026-09-07 by the user's decision during the pre-ISO campaign: this roadmap (own kernel lane, rebuilt package tier) starts only after LegeOS self-hosts from the ISO route in ISO-PLAN.md (@legeos.work.self-hosting-legeos) and the machine has been lived in. The planning baseline and estimates remain in docs/planning/ubuntu-derived-full-distribution-roadmap.md. It proposes replacing the current ADR-0007 kernel posture; a normative superseding ADR and a resolved Secure Boot decision are explicit Phase 0 prerequisites, not silently implied here.
        """
}

record legeos.work.governor-containment/1 : work {
    title "The resource governor: a served interface, applied protection, a staged containment ladder and recorded traces"
    state completed
    scope [
        path "distro/policy/**",
        path "interfaces/dbus/org.legeos.Resources1.xml",
        path "services/lege-resourced/**"
    ]
    intent """
        Give lege-resourced everything it needs to act without giving it the ability to act prematurely: serve org.legeos.Resources1 on a task separate from the sampling loop; populate the managed-instance map from the app.slice scan so an action can reach a real cgroup at all; apply memory.oom.group to application cgroups and a modest memory.low to session-critical units (never memory.min, whose hard protection can itself force OOM); implement the observe-only → trim → throttle → checkpoint → terminate ladder, defaulting to observe-only, with an action above the current stage decided, logged and signalled as unapplied; record bounded JSONL traces complete enough for a human to review a decision before enabling enforcement; return a victim-score breakdown so the choice is explainable; distinguish storage, GPU-reset and kernel-lockup stalls from application memory pressure rather than blaming an application; and keep SQLite and fsync off the loop entirely.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.hands-on-run-2-fixes/1 : work {
    title "Act on the second hands-on run: adjustable windows, visible tiling, body-drag tiles, concise labels, a route to drives, one Settings widget"
    state superseded
    scope [
        path "apps/lege-files/**",
        path "apps/lege-settings/**",
        path "compositor/lege-comp/**",
        path "crates/lege-types/**",
        path "crates/lege-window/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Fix every deficiency in @legeos.observation.hands-on-run-20260831-findings. (1) Windows are adjustable: the compositor's recovery-band move and corner-grip resize actually start their grabs (they previously demanded an implicit grab that cannot exist yet at band-press time, so both affordances were dead on real hardware). (2) New windows are placed — centred in the usable area, cascaded, size-clamped — instead of honouring a meaningless (0,0) request flush into the corner. (3) Arranging from the Home menu ends the reveal so the result is visible, and arranging with no windows open says so on the field. (4) Object-like tiles (file, folder, pane, app) drag-move from anywhere in their body; instrument tiles keep the band. (5) Browse rows and grids drop the FOLDER/FILE caption noise: the name leads, '/' marks a folder, extensions name files once, folders read as the folder material. (6) The browse toolbar's path is a clickable breadcrumb and a Files button hands the folder to org.legeos.Files with its drives sidebar. (7) The battery/volume/brightness widgets consolidate into ONE Settings widget whose click opens the Settings app, per the user's direct instruction.
        """
    note """
        All seven items are implemented and merged at ad3460b (my commits d79602f..49d999f plus the agent's bf75959..c5a4a0b); every command check passes there and the live nested session confirmed centred placement and oversize clamping. The one open check is #hands-on-confirmation — the user's next login at a real seat: window opens centred, band-move and grip-resize work, tiling menu visibly arranges, tiles drag-move, the Settings widget opens Settings. The packages must be rebuilt and reinstalled first (scripts/reinstall-legeos-desktop.sh, interactive sudo).
        """
    acceptance {
        check body-drag {
            statement """
                Object-like tiles arm a drag from anywhere in their body while widget tiles only grab by their band, and an unmoved press stays a click.
                """
            method command
            command "cargo test -p lege-shell object_tiles_drag_by_their_whole_body_and_instruments_do_not"
            verified_by [ @legeos.evidence.hands-on-2-body-drag-20260831 ]
        }
        check browse-navigation {
            statement """
                The toolbar breadcrumb browses to an ancestor and the Files button hands the open folder to the standalone manager.
                """
            method command
            command "cargo test -p lege-shell -- toolbar_breadcrumb toolbar_files"
            verified_by [ @legeos.evidence.hands-on-2-browse-navigation-20260831 ]
        }
        check gates-green {
            statement """
                The full repository gate passes with all of the above merged.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.hands-on-2-gate-20260831 ]
        }
        check hands-on-confirmation {
            statement """
                At a real seat: a new window opens centred and can be moved by its top band and resized by its corner grip; the tiling menu visibly arranges; tiles drag-move; the Settings widget opens Settings.
                """
            method manual
        }
        check placement-policy {
            statement """
                An origin-located map request is centred and cascaded wholly inside the usable area; an oversized one is clamped; a positioned request is honoured and repaired.
                """
            method command
            command "cargo test -p lege-window -- centred cascade clamped honoured"
            verified_by [ @legeos.evidence.hands-on-2-placement-20260831 ]
        }
        check settings-widget {
            statement """
                One Settings widget replaces the battery/volume/brightness tiles, shows their state, and its open action launches the Settings app; saved layouts migrate.
                """
            method command
            command "cargo test -p lege-shell settings"
            verified_by [ @legeos.evidence.settings-widget-consolidation-20260831 ]
        }
    }
    derived_from [ @legeos.observation.hands-on-run-20260831-findings ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

