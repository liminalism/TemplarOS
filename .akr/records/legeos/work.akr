record legeos.work.hands-on-run-4-fixes/1 : work {
    title "Act on the fourth hands-on run: a deploy that finishes, snap browsers that connect, per-window compositing, a screen timeout, and a launcher that finds applications"
    state active
    scope [
        path "apps/lege-settings/**",
        path "cli/lege/src/dev/**",
        path "compositor/lege-comp/**",
        path "crates/lege-session-core/**",
        path "distro/deploy/**",
        path "interfaces/**",
        path "services/lege-hostd/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Fix what the fourth hands-on run found: (1) lege-hostd's EACCES on the system bus socket, and lege dev deploy stopping activation at the first failed unit although every package was installed; (2) snap Chromium and Firefox refused by AppArmor because the public Wayland socket is named legeos-0 rather than wayland-N; (3) every band and grip rendered above every window so titles bleed through a translucent window, plus the reported focus fighting; (4) no screen timeout: a compositor idle timer, outputs off and back on, the timeout from Power1's stored idle policy, and a Settings control; (5) the launcher: sessiond never scanned the snap desktop directory so snap browsers were not in the registry, and the Home field federated files with applications.
        """
    note """
        Landed at 8880b9b. (1) hostd: root cause established by elimination as the ProtectHome=yes mount namespace (the unit had never started; AppArmor in complain mode with zero denials, DAC and bus limits ruled out); ProtectHome dropped, the daemon connects to /run/dbus directly and its failure line now prints uid, socket mode/owner, confinement label and mount namespace; the user can confirm with sudo strace or two systemd-run probes named in the agent report. Deploy runs every activation step and lists every failure. (2) Public socket wayland-0 (new_auto elsewhere); trusted-shell socket legeos-shell-wayland-0, a prefix on purpose because AppArmor's * does not stop at a dash; verified nested with snap Chromium. (3) src/scene.rs builds the frame per window in stacking order, band and grip directly above their own surface; press_target_at is the one hit test and a press on band/grip/edge now activates the window (that was the focus fight). (4) src/idle.rs plus lege_shell_v1 v4 set_idle_timeout, DrmCompositor::clear for DPMS off, Settings System page control from Never to 30 minutes, Power1 documents which field is enforced. (5) d391fc1, dfa1fda. Compositor, hostd and socket changes need a logout; hostd needs the deploy's system-unit restart.
        """
    acceptance {
        check gates-green {
            statement """
                just check exits 0 at the merged branch
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.hands-on-4-gate-20260903 ]
        }
        check hostd-starts {
            statement """
                After deploy, lege-hostd.service is active and lege dev deploy activates every component
                """
            method manual
        }
        check launcher-finds-snap-apps {
            statement """
                The registry scans the snap desktop directory and the Home field offers applications only
                """
            method command
            command "cargo test -p lege-sessiond && cargo test -p lege-shell"
            verified_by [ @legeos.evidence.hands-on-4-launcher-20260903 ]
        }
        check per-window-compositing {
            statement """
                A window behind a translucent Kitty shows through at Kitty's opacity, and a click on any band or grip focuses that window
                """
            method manual
        }
        check screen-timeout {
            statement """
                Settings › System shows Screen turns off after; the screen turns off after the chosen idle time and back on at the next input
                """
            method manual
        }
        check snap-browsers-connect {
            statement """
                After logout and login, snap Chromium and Firefox open on the Wayland display
                """
            method manual
        }
    }
    after [ @legeos.work.hands-on-run-3-fixes ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.hands-on-run-5-fixes/1 : work {
    title "Act on the fifth hands-on run: folder windows instead of one full-screen file manager, Home not drawn under windows, a finer grid and icons where words repeated"
    state active
    scope [ path "shell/lege-shell/**" ]
    intent """
        Turn the fifth hands-on run's findings into Home Field behaviour, reusing the tile system rather than adding a second windowing system inside the shell. A folder tile becomes a window that lists its directory and can be moved, resized, grouped and reopened like any tile; typing a path opens one; the XDG Desktop folder opens as a small tray that a press expands; the Files object becomes a window over Home rather than Home becoming a file manager; the field paints flat ground over every window's rectangle so nothing of Home shows through a translucent client; the grid cell drops from 104 to 88 logical pixels; and the Files rail draws theme icons instead of repeating the word 'folder' under every folder name.
        """
    note """
        The empty-space finding is only partly addressed: folder tiles now carry content instead of a dim path, but no whole-field layout policy was written, and a default Home is still mostly ground. That is a separate decision about what Home is for when it is empty.
        """
    acceptance {
        check desktop-tray {
            statement """
                The XDG Desktop folder is placed at the folder kind's floor and a press is what grows it
                """
            method command
            command "cargo test -p lege-shell --lib desktop_folder_opens"
            verified_by [ @legeos.evidence.hands-on-5-gate-20260904 ]
        }
        check folder-windows {
            statement """
                A folder tile lists its directory, opens once per path, and is an ordinary placeable tile
                """
            method command
            command "cargo test -p lege-shell --lib folder_window_opens"
            verified_by [ @legeos.evidence.hands-on-5-gate-20260904 ]
        }
        check hands-on-confirmation {
            statement """
                On the installed desktop: two folder windows open at once, a translucent kitty shows no trace of Home through it, the Desktop tray expands and collapses, and the Files rail shows icons rather than the word 'folder' twice
                """
            method manual
        }
        check no-home-under-windows {
            statement """
                Nothing of Home is drawn where an un-shelved window is, and Home in the gaps between windows is untouched
                """
            method command
            command "cargo test -p lege-shell --lib a_windows_rectangle"
            verified_by [ @legeos.evidence.hands-on-5-gate-20260904 ]
        }
        check preview-capture-stops {
            statement """
                Preview capture stops while a fullscreen or maximized window covers the field and resumes on reveal, park or un-maximize, with the cache kept
                """
            method command
            command "cargo test -p lege-shell --lib a_window_covering"
            verified_by [ @legeos.evidence.hands-on-5-gate-20260904 ]
        }
        check shell-gate {
            statement """
                The shell crate is green: rustfmt, clippy pedantic with warnings denied, and every test
                """
            method command
            command "cargo test -p lege-shell && cargo clippy -p lege-shell --all-targets"
            verified_by [ @legeos.evidence.hands-on-5-gate-20260904 ]
        }
        check typed-path-opens-a-window {
            statement """
                A typed absolute or ~-relative path is read as a path and offered as the first omnibox row
                """
            method command
            command "cargo test -p lege-shell --lib a_typed_path"
            verified_by [ @legeos.evidence.hands-on-5-gate-20260904 ]
        }
    }
    derived_from [ @legeos.observation.hands-on-run-5-findings-20260904 ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.home-app-drag-and-app-groups/1 : work {
    title "Lane C — Home: drag an application out of the search results onto the field, and app-on-app makes an app group"
    state superseded
    scope [
        path "crates/lege-field/**",
        path "docs/homefield.md",
        path "shell/lege-shell/src/field_model.rs",
        path "shell/lege-shell/src/surface/field_screen.rs",
        path "shell/lege-shell/src/surface/omnibox_screen.rs"
    ]
    intent """
        lege-field: TileKind::AppGroup { group_id } is a container of App tiles (2x2 preferred, 4x4 interior, 6x4 max) created by the existing FieldOp::CreateProject, whose label now reads NEW GROUP FROM THESE for a non-Project container; grammar: App on App is GroupIntoAppGroup (before the GroupIntoNewProject fall-through, which stays for other pairs), App on AppGroup is AddToAppGroup, an AppGroup never groups into a tile; folder_tile shared with the shell; property test Step::GroupApps. Shell: op_for builds the group tile ('Apps', tile_id_for app-group:N); the body is a grid of the members' icons, each a Launch, claimed before the body's zoom click; move_out_op dissolves an AppGroup its last member leaves (Batch[Move, Remove]) from both a drag out and Backspace; the host's Projects1.Create interception is untouched because it matches TileKind::Project only. Drag from results: FieldScreen.pending holds the tile a row stands for (app_tile, or folder_tile for a typed path); result rows become release-clicks (pixelkit registers a click at the press) so a press can arm a drag; the lift closes the dropdown; source_kind and as_new_tile make the ordinary drop path place the pending tile (Move->Place at the landing, CreateProject->Batch[Place, CreateProject]); an already-pinned application drags the tile that is there; Escape or a release inside the list leaves nothing.
        """
    note """
        Requested drag-only; no menu alternative. docs/homefield.md gained the App group term and two grammar rows.
        """
    acceptance {
        check field-grammar {
            statement """
                Two applications make an app group and a third joins it; a group never groups into a tile; nothing but an application joins one; the container op inverts exactly under the property test.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check gate-green {
            statement """
                just check passes.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check hands-on-confirmation {
            statement """
                On Home: type an application, drag its row onto the field, a tile appears where it is dropped; drop it on another app tile and an Apps group appears whose icons launch.
                """
            method manual
        }
        check shell-gestures {
            statement """
                Drag from a result row places the tile at the drop cell and launches nothing; press-and-release on a row still launches; Escape leaves no tile; an already-pinned application moves its tile; app-on-app makes an app group titled Apps, not a project; a group icon launches; a third app joins; emptying dissolves.
                """
            method command
            command "cargo test -p lege-shell field_screen"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
    }
    implements [
        @legeos.decision.home-is-momentary-and-placeable-objects-are-containers,
        @legeos.decision.one-persistent-bottom-bar-tags-not-bands
    ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

