record legeos.work.window-manager-popup-and-functional-edge-tabs/1 : work {
    title "The bar is the switcher and gets out of the way: no reservation, visible over Home, a hint and a mouseover reveal under windows, nothing in fullscreen; the popup manager deferred"
    state active
    intent """
        Rev 2 (2026-09-08, the user's decision after reading rev 1's recommendation): the reviewer's redundancy principle is kept — a window's name and controls live on the window as its tag, and the bottom edge must not repeat what has an owner — but the bar stays the pointer switcher; it is not replaced by a Windows entry and a popup. What changes is presence. The bar reserves no exclusive zone (a zero-size claim keeps it bottom-anchored). Over Home it is simply visible, full height, drawn over the garden. When a window is under its strip (any unshelved, non-fullscreen toplevel whose geometry meets the bottom BAR_HEIGHT strip while Home is not revealed) it collapses to a thin hint at the very bottom — a small ^ chevron on the bar's ground — and a pointer resting on the hint reveals the whole bar; the pointer leaving it collapses the bar again after the same short dwell, closing any open row or popover, so it hides as easily as it appears (the user's cosmic fork was slow to hide). Chip hover still opens the per-application window row after its dwell; a click on a row activates. In fullscreen nothing of the bar shows and no edge dwell reveals it: the compositor's bottom-edge peek is deleted; a visible fullscreen window stays stacked above the shell overlay on its output; Alt+Tab (MRU, campaign 4) is the switch route there. With no bottom zone a maximized window fills the output and wears its own tags (WindowService::has_frame already does this), so the bar's copies of the maximized window's controls are removed rather than kept in a shared seam; the 32px seam and the permanent Home/Windows edge entries of rev 1 are dropped. DEFERRED, not rejected: the COSMIC-derived popup window manager (Super+W, Super+secondary-click, previews) — its keyboard role is covered by Alt+Tab and its pointer-in-fullscreen role is the one open question for the trial; rev 1's popup, source-reuse and fullscreen-switching sections remain the plan for it if the trial wants a pointer route in fullscreen. Compositor changes need one logout.
        """
    note """
        Rev 1's text stays in history as the reviewer's recommendation. Implementation: campaign 5, packets under .agent/scratch/bar-5 (Lane A compositor/lege-window, Lane B shell). The trial settles: hint height and dwell constants, whether a pointer route in fullscreen is wanted (then the popup), and whether the bar wants the reviewer's title-first density.
        """
    acceptance {
        check bar-over-home {
            statement """
                With nothing under its strip the bar is visible at full height over Home; the Home field ends above it; no window is displaced by its presence or absence.
                """
            method observation
        }
        check fullscreen-is-uninterrupted {
            statement """
                On Wayland and XWayland, opaque and translucent fullscreen show no bar pixels or bar hit targets; a dwell at the bottom edge shows nothing; Alt+Tab switches away and back with the window still fullscreen.
                """
            method observation
        }
        check hint-and-reveal {
            statement """
                A window under the strip collapses the bar to a thin hint with a ^ at the very bottom; a pointer resting on the hint reveals the whole bar; chip hover opens the window row; a click on the hint reveals immediately.
                """
            method observation
        }
        check mouse-away-hides {
            statement """
                The pointer leaving the revealed bar collapses it to the hint within the close dwell, closing any open row or popover; no stuck-open bar after sweeping the pointer across it.
                """
            method observation
        }
        check tags-not-duplicated {
            statement """
                A maximized window's name and controls appear once, on its tag; the bar carries no copy.
                """
            method observation
        }
        check user-design-trial {
            statement """
                The user judges the open/hint/revealed presence over a working day, settles the hint height and dwells, and decides whether a pointer route in fullscreen (the deferred popup) is wanted.
                """
            method manual
        }
        check zero-zone-anchors {
            statement """
                set_exclusive_zone(bottom, 0) keeps the bar surface bottom-anchored at any committed height while Output::usable() is the whole output and reserves_bottom() is false; a maximized window fills the output and wears its own tags.
                """
            method command
            command "cargo test -p lege-window -p lege-comp"
        }
    }
    derived_from [ @legeos.work.bar-home-chip-cluster-and-fullscreen-peek ]
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    supersedes [ @legeos.work.bar-home-chip-cluster-and-fullscreen-peek/1 ]
    source {
        kind external
        role rationale
        url "https://github.com/pop-os/cosmic-applets/tree/1aa03111c5cd92051c9af28b43cb1ee9f43dbb25/cosmic-app-list"
        use """
            Actual code donor for popup window list, lifecycle, requests and previews.
            """
    }
    source {
        kind external
        role rationale
        url "https://github.com/pop-os/cosmic-applets/tree/1aa03111c5cd92051c9af28b43cb1ee9f43dbb25/cosmic-applet-minimize"
        use """
            Supplementary parked-window preview and overflow code.
            """
    }
    source {
        kind external
        role example
        url "https://support.apple.com/guide/mac-help/use-apps-in-full-screen-mchl9c21d2be/mac"
        use """
            Fullscreen focus/return reference; macOS Spaces and visual chrome are not adopted.
            """
    }
}

record legeos.work.window-perimeter-two-axis-resize/1 : work {
    title "Implement full-side two-axis perimeter resize and diagonal cursor presentation"
    state superseded
    scope [ path "compositor/lege-comp/**", path "crates/lege-window/**" ]
    intent """
        Replace the remaining corner-threshold selector with deterministic side-half two-axis selection, carry the latched edge pair through compositor input, render the matching diagonal cursor in nested and DRM backends, and preserve conventional client-protocol resize behavior.
        """
    note """
        This extends the current tag-era exterior margin. It does not repeat the already completed grip removal or change the current numerical minimum size.

        Implemented on branch developer-edition-0-1 as four commits: resize_edges_at's side-half selection plus ResizeEdges::cursor (RESIZE_CORNER deleted); the compositor's hover and gesture cursor (press_candidates extracted so hover and press share one hit-test; cursor_before_perimeter saves and restores the client's cursor, and SeatHandler::cursor_image writes into that slot while the compositor owns the pointer); five built-in DRM cursor shapes replacing the Named(_) => arrow fallthrough; and the nested backend setting the host window's cursor. The nested backend needed no new dependency: smithay::reexports::winit is already the exact winit smithay uses.

        The two command checks are satisfied. cursor-backends is NOT: the code is written for both backends, but no one has looked at a resize cursor on screen. The nested half needs a running nested session and a human eye, the DRM half additionally needs a logout, and both are steps in .agent/scratch/pre-iso/RUNBOOK-lane-1.md along with nested-perimeter-gesture. Left active for that reason.
        """
    acceptance {
        check cursor-backends {
            statement """
                Nested and DRM cursor paths render the intended diagonal during each compositor gesture and restore client cursor ownership afterward.
                """
            method observation
        }
        check eight-side-halves {
            statement """
                Geometry coverage proves all eight side halves, exact midpoint ownership, very small windows, negative coordinates and scaled outputs select the intended edge pair.
                """
            method command
            command "cargo test -p lege-window"
            verified_by [ @legeos.evidence.perimeter-two-axis-resize-geometry-20260907 ]
        }
        check latched-origin-resize {
            statement """
                Drag coverage proves edges latch at press, opposite edges remain anchored, minimum clamping does not invert, and client-requested single-axis edges retain their protocol meaning.
                """
            method command
            command "cargo test -p lege-window -p lege-comp"
            verified_by [ @legeos.evidence.perimeter-resize-latched-edges-20260907 ]
        }
        check nested-perimeter-gesture {
            statement """
                A nested session demonstrates two-axis resize from every side half, correct cursor feedback, covered-window precedence, screen-boundary recovery and maximized/fullscreen exclusions.
                """
            method manual
        }
    }
    depends_on [ @legeos.work.window-tags-replace-the-band/3 ]
    implements [ @legeos.decision.perimeter-resize-selects-two-axes-by-side-half ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.window-perimeter-two-axis-resize/2 : work {
    title "Implement full-side two-axis perimeter resize and diagonal cursor presentation"
    state active
    scope [ path "compositor/templar-comp/**", path "crates/templar-window/**" ]
    intent """
        Replace the remaining corner-threshold selector with deterministic side-half two-axis selection, carry the latched edge pair through compositor input, render the matching diagonal cursor in nested and DRM backends, and preserve conventional client-protocol resize behavior.
        """
    note """
        This extends the current tag-era exterior margin. It does not repeat the already completed grip removal or change the current numerical minimum size.

        Implemented on branch developer-edition-0-1 as four commits: resize_edges_at's side-half selection plus ResizeEdges::cursor (RESIZE_CORNER deleted); the compositor's hover and gesture cursor (press_candidates extracted so hover and press share one hit-test; cursor_before_perimeter saves and restores the client's cursor, and SeatHandler::cursor_image writes into that slot while the compositor owns the pointer); five built-in DRM cursor shapes replacing the Named(_) => arrow fallthrough; and the nested backend setting the host window's cursor. The nested backend needed no new dependency: smithay::reexports::winit is already the exact winit smithay uses.

        The two command checks are satisfied. cursor-backends is NOT: the code is written for both backends, but no one has looked at a resize cursor on screen. The nested half needs a running nested session and a human eye, the DRM half additionally needs a logout, and both are steps in .agent/scratch/pre-iso/RUNBOOK-lane-1.md along with nested-perimeter-gesture. Left active for that reason.
        """
    acceptance {
        check cursor-backends {
            statement """
                Nested and DRM cursor paths render the intended diagonal during each compositor gesture and restore client cursor ownership afterward.
                """
            method observation
        }
        check eight-side-halves {
            statement """
                Geometry coverage proves all eight side halves, exact midpoint ownership, very small windows, negative coordinates and scaled outputs select the intended edge pair.
                """
            method command
            command "cargo test -p lege-window"
            verified_by [ @legeos.evidence.perimeter-two-axis-resize-geometry-20260907 ]
        }
        check latched-origin-resize {
            statement """
                Drag coverage proves edges latch at press, opposite edges remain anchored, minimum clamping does not invert, and client-requested single-axis edges retain their protocol meaning.
                """
            method command
            command "cargo test -p lege-window -p lege-comp"
            verified_by [ @legeos.evidence.perimeter-resize-latched-edges-20260907 ]
        }
        check nested-perimeter-gesture {
            statement """
                A nested session demonstrates two-axis resize from every side half, correct cursor feedback, covered-window precedence, screen-boundary recovery and maximized/fullscreen exclusions.
                """
            method manual
        }
    }
    depends_on [ @legeos.work.window-tags-replace-the-band/4 ]
    implements [ @legeos.decision.perimeter-resize-selects-two-axes-by-side-half ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
    supersedes [ @legeos.work.window-perimeter-two-axis-resize/1 ]
    author "dk"
}

record legeos.work.window-tab-hover-reveal-20261002/1 : work {
    title "Always-visible title follows the nearest corner; hover controls latch while aimed at or grabbed"
    state proposed
    scope [
        path "apps/templar-settings/**",
        path "compositor/COMPOSITOR.md",
        path "compositor/templar-comp/src/**",
        path "crates/templar-session-core/src/settings.rs",
        path "crates/templar-window/**",
        path "docs/planning/homegarden-previews-notifications-window-tabs.md",
        path "interfaces/wayland/templar-shell-v2.xml",
        path "shell/templar-shell/src/settings.rs"
    ]
    intent """
        Implement nearest-corner mouseover selection and hover control reveal over the shared four-corner WindowLayout. The title remains visible while its window is visible; controls default hover. Approach can come from any of four sides, with topmost-point ownership checks. Use deterministic corner ties, hysteresis near boundaries, short reveal/exit grace and retain last corner on leave. Latch position/visibility while pointer aims at a visible title/control, and across press/release, menu, drag and resize; release the latch from the actual grab termination path. No synchronous PointerHandle reentry from grabs.
        Reveal changes no focus/raise/action; Close requires a fresh press/release on a drawn stationary target. Hidden controls take no input; higher windows/secure surfaces and gesture/peek bands win. Same-corner overlay shares the same state for output edges/maximized/fullscreen; always-visible title policy remains explicit. Keep keyboard reveal/control route and fixed/always fallback, and damage only old/new regions. Use one pending timer per purpose, no motion-created timer pile or hidden polling. Plan: docs/planning/homegarden-previews-notifications-window-tabs.md section3.
        """
    note """
        This intentionally changes the old hidden-all-tabs and stationary-anchor proposal. It is not a free-running pointer chase: nearest-corner changes stop once the person is aiming at a revealed target. Visibility wording/dwell/fullscreen feel is reviewed with the actual prototype; proposed default follows the owner's final always-visible title wording.
        """
    acceptance {
        check follow-and-latch {
            statement """
                Actual pointer approaches all four sides/corners and selects the nearest corner with stable ties/hysteresis. Crossing midpoints does not jitter, and aiming/pressing/menu/move/resize freezes the target until exit/end; Close does not flee the pointer.
                """
            method observation
        }
        check hidden-controls-take-nothing {
            statement """
                Hidden controls intercept no click/cursor/focus; always-visible title remains actionable; underlying Home and higher overlapping windows get their expected input. Reveal itself fires nothing and does not raise/focus.
                """
            method observation
        }
        check nested-look {
            statement """
                Observe actual native Wayland and XWayland decorations under rapid pointer crossing, small windows, overlaps, groups and fullscreen: visible horizontal title, correct control reveal, no accidental close and no client reconfigure.
                """
            method observation
        }
        check transition-and-timer-safety {
            statement """
                Leaving hides controls after grace but retains visible title and last corner. Grab cancellation/unmap/lock/output removal cannot strand latches/timers. Reduced motion, keyboard controls, edge overlays and bottom gesture/peek precedence work without pointer-mutex reentry.
                """
            method observation
        }
    }
    after [ @legeos.work.window-tab-layout-model-20261002 ]
    implements [ @legeos.decision.window-tabs-are-external-revealed-and-stationary ]
    part_of [ @legeos.work.external-window-tabs-20261002 ]
    author "dk"
}

record legeos.work.window-tab-layout-model-20261002/1 : work {
    title "One client-space layout for all four corners, horizontal titles and right-angle or opposite controls"
    state proposed
    scope [
        path "apps/templar-settings/**",
        path "compositor/COMPOSITOR.md",
        path "compositor/templar-comp/src/**",
        path "crates/templar-session-core/src/settings.rs",
        path "crates/templar-window/**",
        path "docs/planning/homegarden-previews-notifications-window-tabs.md",
        path "interfaces/wayland/templar-shell-v2.xml",
        path "shell/templar-shell/src/settings.rs"
    ]
    intent """
        Replace bottom-strip geometry with one WindowLayout owned by templar-window. Client rect is authoritative; preserve existing client dimensions on migration. Include Corner{TopLeft,TopRight,BottomLeft,BottomRight}, horizontal title rectangle, fixed-size control geometry, four edge activation regions, resize zones, visible input/damage/recovery bounds and exterior/overlay placement. Same-corner default: title on top/bottom, vertical controls on left/right at a right angle; opposite option: name and horizontal controls at opposite ends of the same top/bottom edge pending prototype confirmation. All four corners are real layouts, never Left/Right aliases to Top.
        Migrate chrome paint, pointer hover/press, move/resize, groups, xdg_shell/XWayland configure, space sync, output repair and recovery to the same rectangles. Delete obsolete client_area/frame_around/tag_strip relationships and separate covering_chrome policy once replaced. Tabs do not resize the client; geometry transitions only damage old/new decoration regions. No unnecessary per-frame heap collection for three fixed controls. Tiny/output-edge/fullscreen windows retain all controls through bounded overlay/overflow without sacrificing corner resize. Detailed plan: docs/planning/homegarden-previews-notifications-window-tabs.md section3.
        """
    note """
        Replaces the old Top/Bottom-first plan and the accidental32px client-height increase. Changing decoration geometry must preserve client dimensions. Four-side activation and same-corner right angles are required, not a later alias implementation. Titles remain horizontal. This step supplies geometry; following/reveal state is the next child.
        """
    acceptance {
        check four-corner-shared-layout {
            statement """
                For all four corners and both arrangements, exterior/overlay, small/large/scaled/negative-coordinate windows, actual painted controls/title and pointer targets agree; resize corners stay separate and every control remains reachable.
                """
            method observation
        }
        check nested-look {
            statement """
                In an owned nested compositor, native and XWayland windows show horizontal titles plus correct same-corner vertical or opposite-end horizontal controls; all four corners perform move/resize/park/maximize/close.
                """
            method observation
        }
        check no-client-reconfigure {
            statement """
                Instrument actual Wayland configure and XWayland resize paths: pure tab relocation/reveal/arrangement changes preserve client rectangle and emit no client resize. The migration preserves existing content dimensions.
                """
            method observation
        }
        check recovery-and-consumers {
            statement """
                Move, resize, group, park/restore, maximize/fullscreen and output removal use the common layout; no obsolete strip helper or covering-chrome authority remains. Shell-absent keyboard recovery still works.
                """
            method observation
        }
    }
    after [ @legeos.work.window-corner-hit-geometry-20261002 ]
    implements [ @legeos.decision.window-tabs-are-external-revealed-and-stationary ]
    part_of [ @legeos.work.external-window-tabs-20261002 ]
    author "dk"
}

record legeos.work.window-tab-side-choice-20261002/1 : work {
    title "Settings for same/opposite corners, pointer following and fixed-anchor accessibility fallback"
    state proposed
    scope [
        path "apps/templar-settings/**",
        path "compositor/COMPOSITOR.md",
        path "compositor/templar-comp/src/**",
        path "crates/templar-session-core/src/settings.rs",
        path "crates/templar-window/**",
        path "docs/planning/homegarden-previews-notifications-window-tabs.md",
        path "interfaces/wayland/templar-shell-v2.xml",
        path "shell/templar-shell/src/settings.rs"
    ]
    intent """
        Expose the October7 options through Settings, committed settings observation and the current interfaces/wayland/templar-shell-v2.xml contract, versioned as needed. Proposed settings: windows.tabs.placement=same-corner|opposite-corners; follow-pointer=true with fixed-corner accessibility fallback; controls=hover|always; default corner proposed top-right; title visibility independently defaults always. Same-corner right-angle layout is default; names never rotate. Define opposite placement precisely (proposed other end of same horizontal edge; diagonal remains prototype choice). Remove the old proposed follow-resize-only owner instead of retaining competing corner selectors.
        Settings Set/Reset/undo and shell/compositor restart converge on the same policy. Per-window fixed anchor choices survive park/restore/maximize/fullscreen/grouping; output loss reclamps safely. Exercise all four corners and both arrangements with real native/XWayland windows and keyboard recovery. Plan: docs/planning/homegarden-previews-notifications-window-tabs.md section3.
        """
    note """
        Historical key side-choice now names arrangement/follow/default-corner options. Four real corners are implemented by the shared-layout child, not deferred to here. Owner review remains for final visibility wording, fullscreen title, exact opposite-corner arrangement and dwell/hysteresis feel; no prior mock choice counts as implementation evidence.
        """
    acceptance {
        check options-and-transitions {
            statement """
                Same-corner right-angle and opposite arrangement both work from every corner. Title stays horizontal and controls accessible through park/restore, maximize/fullscreen, regrouping, scale/output changes and tiny layouts; fixed anchor option stays fixed.
                """
            method observation
        }
        check owner-prototype-choices {
            statement """
                Owner reviews actual nested prototype and confirms or revises title-always/controls-hover, fullscreen title, opposite-end versus diagonal opposite-corner geometry and dwell/hysteresis defaults before implementation is marked complete.
                """
            method manual
        }
        check settings-converge {
            statement """
                Real Settings changes, reset, undo and service/shell/compositor restart produce the same committed arrangement/follow/visibility/default policy. Version skew is explicit; no stale follow-resize anchor logic remains.
                """
            method observation
        }
    }
    after [ @legeos.work.window-tab-hover-reveal-20261002 ]
    implements [ @legeos.decision.window-tabs-are-external-revealed-and-stationary ]
    part_of [ @legeos.work.external-window-tabs-20261002 ]
    author "dk"
}

record legeos.work.window-tags-replace-the-band/1 : work {
    title "Lane A — compositor: bottom tags replace the title band, the corner grip goes, a maximized window under the bar has no frame"
    state superseded
    scope [
        path "compositor/COMPOSITOR.md",
        path "compositor/lege-comp/**",
        path "crates/lege-window/**"
    ]
    intent """
        lege-window: RECOVERY_BAND_HEIGHT becomes TAG_HEIGHT and recovery_band becomes tag_strip, the full-width strip at a window's bottom edge; client_area/frame_around keep the origin and differ by one strip height; repair_window clamps so the bottom strip stays on an output (a tall window hangs off the top); move_into_view sets a too-tall window flush with the bottom edge; resize_grip and RESIZE_GRIP_SIZE are deleted and MIN_WINDOW_HEIGHT is two tag heights; Output::reserves_bottom derives 'a bar holds this edge' from the usable area; WindowService::has_frame is false for fullscreen and for a maximized window on an output that reserves its bottom, so the shell's bar carries those controls and the compositor draws the tags again when no zone is claimed. Compositor chrome: layout::control_tags/control_tag_at (the former band_buttons, verbatim) and layout::name_tag (left end, up to TAG_GAP before the first control, capped at NAME_TAG_MAX_WIDTH); collect_name_tag and collect_control_tags replace collect_band and collect_grip and bail when !has_frame. Input: Affordance::Tag replaces Band, Grip is gone, the gap between the tags falls through to the window beneath, edges and corners resize as before. window_groups::tag_drop_target hit-tests the name tag only. COMPOSITOR.md's band rows describe tags. Also: on_outputs_changed's repairs now configure every repaired window through space_sync::apply_resized_geometry, not X11 alone, so a maximized Wayland client is re-sent its size when the bar appears.
        """
    note """
        Needs a logout to take effect (lege-comp is Restart=no). Accepted: windows flush with the bottom jump up by the bar height when the bar first appears; XWayland self-placed windows grow downward; group outlines enclose the strip.
        """
    acceptance {
        check chrome-and-input {
            statement """
                A name-tag press moves and focuses, a control-tag press acts, a press in the gap falls through to the window beneath, a frameless window offers no tags, hidden windows draw nothing.
                """
            method command
            command "cargo test -p lege-comp"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check gate-green {
            statement """
                just check passes with the compositor change.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check geometry-and-service {
            statement """
                tag_strip is the bottom strip; client_area sits above it and frame_around inverts it; repair keeps the strip on an output; has_frame is false for a maximized window only while a bottom zone is claimed; every corner resizes.
                """
            method command
            command "cargo test -p lege-window"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check hands-on-confirmation {
            statement """
                After logout: a sized kitty shows its name tag bottom-left and park/maximize/close bottom-right, moves by the name tag, resizes from every edge and corner; a maximized kitty shows no tags while the bar is up and shows them when the shell is killed.
                """
            method manual
        }
    }
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.window-tags-replace-the-band/2 : work {
    title "Lane A — compositor: bottom tags replace the title band, the corner grip goes, a maximized window under the bar has no frame"
    state superseded
    scope [
        path "compositor/COMPOSITOR.md",
        path "compositor/lege-comp/**",
        path "crates/lege-window/**"
    ]
    intent """
        lege-window: RECOVERY_BAND_HEIGHT becomes TAG_HEIGHT and recovery_band becomes tag_strip, the full-width strip at a window's bottom edge; client_area/frame_around keep the origin and differ by one strip height; repair_window clamps so the bottom strip stays on an output (a tall window hangs off the top); move_into_view sets a too-tall window flush with the bottom edge; resize_grip and RESIZE_GRIP_SIZE are deleted and MIN_WINDOW_HEIGHT is two tag heights; Output::reserves_bottom derives 'a bar holds this edge' from the usable area; WindowService::has_frame is false for fullscreen and for a maximized window on an output that reserves its bottom, so the shell's bar carries those controls and the compositor draws the tags again when no zone is claimed. Compositor chrome: layout::control_tags/control_tag_at (the former band_buttons, verbatim) and layout::name_tag (left end, up to TAG_GAP before the first control, capped at NAME_TAG_MAX_WIDTH); collect_name_tag and collect_control_tags replace collect_band and collect_grip and bail when !has_frame. Input: Affordance::Tag replaces Band, Grip is gone, the gap between the tags falls through to the window beneath, edges and corners resize as before. window_groups::tag_drop_target hit-tests the name tag only. COMPOSITOR.md's band rows describe tags. Also: on_outputs_changed's repairs now configure every repaired window through space_sync::apply_resized_geometry, not X11 alone, so a maximized Wayland client is re-sent its size when the bar appears.
        """
    note """
        Needs a logout to take effect (lege-comp is Restart=no). Accepted: windows flush with the bottom jump up by the bar height when the bar first appears; XWayland self-placed windows grow downward; group outlines enclose the strip.

        Two later corrections to the last clause of the intent. First, on_outputs_changed no longer repairs shell surfaces at all: a surface holding an exclusive zone can never satisfy the usable area its own zone creates, so repairing it pushed it a zone-height off its edge while apply_surface_claims put it back — two writers alternating on one rectangle, which is what the bar flicker was. Configuring every repaired window made that record shift visible. A shell surface now follows a topology change by being re-placed (protocols_shell::reapply_surface_claims from backend::recompute_outputs), which is what repair was wrongly standing in for; the repair loop and its configure still apply to client windows, maximized ones included.

        Second, the chip contract: shell_surface_placement now gives a zone-holding surface its own committed extent *along* its edge, clamped to the output and anchored at the edge's start, as well as its own thickness. The exclusive zone stays the only input to work_area_for, Output::usable, reserves_bottom and has_frame, so a bar narrower than the screen reserves exactly what a full-width one does and toggling between them reflows nothing. Nothing about the tags, the frame or the maximized-window rule changes.

        Also: resize_edges_at now takes a corner from every perimeter point by side half (@legeos.decision.perimeter-resize-selects-two-axes-by-side-half), so "edges and corners resize as before" means every perimeter press resizes two axes rather than one; RESIZE_CORNER is gone with the grip.
        """
    acceptance {
        check chrome-and-input {
            statement """
                A name-tag press moves and focuses, a control-tag press acts, a press in the gap falls through to the window beneath, a frameless window offers no tags, hidden windows draw nothing.
                """
            method command
            command "cargo test -p lege-comp"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check gate-green {
            statement """
                just check passes with the compositor change.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check geometry-and-service {
            statement """
                tag_strip is the bottom strip; client_area sits above it and frame_around inverts it; repair keeps the strip on an output; has_frame is false for a maximized window only while a bottom zone is claimed; every corner resizes.
                """
            method command
            command "cargo test -p lege-window"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check hands-on-confirmation {
            statement """
                After logout: a sized kitty shows its name tag bottom-left and park/maximize/close bottom-right, moves by the name tag, resizes from every edge and corner; a maximized kitty shows no tags while the bar is up and shows them when the shell is killed.
                """
            method manual
        }
    }
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.work.home-surface-usability-next ]
    supersedes [ @legeos.work.window-tags-replace-the-band/1 ]
}

