record legeos.work.home-folders-and-shortcut-panes/1 : work {
    title "Placeable folders and composite shortcut panes replace loose desktop file icons"
    state completed
    scope [
        path "apps/lege-files/**",
        path "crates/lege-field/**",
        path "services/lege-filed/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Make folders and shortcut panes first-class placeable Home objects. A folder object points to one real directory and opens or expands into its live contents. A shortcut pane is a named, ordered collection of references to files and folders from multiple locations; it never relocates the referenced item merely by adding it. Both participate in the Home representation ladder, resize/yield rules, panel layouts, persistence and multi-selection.

        Import the user's XDG Desktop directory as the default large Home folder/shortcut pane so software that still writes desktop launchers or files has a visible destination without recreating scattered desktop icons. Provide pointer, keyboard and Files-app routes to pin a folder, create/rename a pane, add references, reorder them and remove references. Removing from a shortcut pane is distinct from Move to Trash and never deletes the underlying item.

        Dragging an individual file to bare Home does not create a loose file tile: it offers or uses a shortcut pane. Existing serialized TileKind::File entries remain readable and migrate to references or the shelf without data loss. Folder, pane, widget and session shells get distinct tint/material roles (optionally glass-, stone- or paper-like) while remaining rectangular, legible and theme-controlled.
        """
    note """
        Acceptance command for folder-and-pane-model corrected to pass both libtest filters after --; cargo takes only one TESTNAME positionally. Rich pane management UI (rename, reorder) and the Files-app pin route ride with the file-operations item, which owns the interactive file surfaces.
        """
    acceptance {
        check desktop-directory-default {
            statement """
                The XDG Desktop directory appears as a default Home folder/pane when available, degrades readably when absent, and does not explode its children into loose Home tiles.
                """
            method command
            command "cargo test -p lege-shell desktop_folder"
            verified_by [ @legeos.evidence.home-folders-and-panes-20260831/1 ]
        }
        check folder-and-pane-model {
            statement """
                A folder binds one directory; a shortcut pane stores deterministic references from multiple directories without moving or copying their targets, and both round-trip through Home persistence.
                """
            method command
            command "cargo test -p lege-field -- folder shortcut_pane"
            verified_by [ @legeos.evidence.home-folders-and-panes-20260831/1 ]
        }
        check material-roles {
            statement """
                A reviewed Home render distinguishes folder, shortcut-pane, widget and session object types by theme-owned tint/material treatment without changing tile geometry or reducing text legibility.
                """
            method observation
            verified_by [ @legeos.evidence.home-material-roles-20260831/1 ]
        }
        check no-new-loose-files {
            statement """
                No Home pointer, keyboard, drag/drop or service path creates a new loose file tile; dropping a file on bare Home routes it to a shortcut pane.
                """
            method command
            command "cargo test -p lege-shell no_loose_file_tiles"
            verified_by [ @legeos.evidence.home-folders-and-panes-20260831/1 ]
        }
        check reference-removal-is-safe {
            statement """
                Remove from Pane deletes only the reference; trashing the target is a separate explicitly labelled file-service operation with its own undo.
                """
            method command
            command "cargo test -p lege-filed -p lege-shell shortcut_pane_remove"
            verified_by [ @legeos.evidence.home-folders-and-panes-20260831/1 ]
        }
    }
    depends_on [ @legeos.work.home-panel-and-dock-layouts ]
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.home-input-and-refinement/1 : work {
    title "Home refinement — hardware input and cursor, bare-Super toggle, no taskbar, clean tiles and information row"
    state active
    scope [
        path "compositor/lege-comp/**",
        path "docs/testing/README.md",
        path "shell/lege-shell/**"
    ]
    intent """
        Make the installed Home session directly usable on hardware: process libinput relative pointer motion, render a visible DRM cursor, focus the initial Home surface for keyboard input, and use a bare Super tap as the primary taskbar-free Home toggle. Remove the graphical dock and its exclusive bottom zone, limit automatic app tiles to active applications, preserve meaningful imported desktop names, and add a standard Home information row with local clock, live/parked counts, and nm-tray2 network control.
        """
    note """
        The 2026-08-23 installed journal proved the session did not crash and libinput enumerated the machine's event devices; the omissions were in compositor dispatch/rendering. The user's nm-tray2 source at /mnt/Samsung980_1TB/Rust-projects/not-rust-projects/nm-tray-2 now exposes --popup and a session-bus forwarding slot, but that external build must be installed alongside the refreshed LegeOS packages. All automated and nested visual checks pass; real-hardware mouse, cursor and keyboard validation remains open for the next installed-session retest.
        """
    acceptance {
        check bare-super-toggle {
            statement """
                A lone Super press toggles Home on release, a Super chord cancels the tap, and holding both Super keys never double-toggles.
                """
            method command
            command "cargo test -p lege-comp keybindings::tests"
            verified_by [ @legeos.evidence.refinement-checks-20260824/1 ]
        }
        check clean-home-tiles {
            statement """
                Installed-but-idle desktop files do not auto-fill Home, imported IDs never render every title as 'desktop', and active application/session tiles remain.
                """
            method command
            command "cargo test -p lege-shell field_model"
            verified_by [
                @legeos.evidence.refinement-checks-20260824/1,
                @legeos.evidence.taskbar-free-home-visual-20260824/1
            ]
        }
        check hardware-input {
            statement """
                With the refreshed packages installed on the laptop, moving the mouse/touchpad moves a visible cursor, clicks reach Home controls, and keyboard navigation reaches the focused Home surface.
                """
            method manual
        }
        check information-row {
            statement """
                Home shows a standard top information row with local date/time, live/parked counts, and a network control state.
                """
            method observation
            verified_by [ @legeos.evidence.taskbar-free-home-visual-20260824/1 ]
        }
        check installable-packages {
            statement """
                Fresh Debian packages contain the refined compositor and shell and the complete 12-package set builds.
                """
            method command
            command "just deb"
            verified_by [ @legeos.evidence.refinement-debian-packages-20260824/1 ]
        }
        check nm-tray2-control {
            statement """
                When nm-tray2 is installed, the Home network control launches it with --popup; an already-running instance receives the popup request over the session bus instead of duplicating.
                """
            method command
            command "cargo test -p lege-shell network_control && cmake --build /mnt/Samsung980_1TB/Rust-projects/not-rust-projects/nm-tray-2/build --parallel 2"
            verified_by [
                @legeos.evidence.nm-tray2-popup-build-20260824/1,
                @legeos.evidence.refinement-checks-20260824/1
            ]
        }
        check taskbar-free-home {
            statement """
                The shell maps one full-screen Home surface and no graphical dock/ShellOverlay or exclusive bottom zone.
                """
            method observation
            verified_by [ @legeos.evidence.taskbar-free-home-visual-20260824/1 ]
        }
    }
    part_of [ @legeos.work.home-field ]
}

record legeos.work.home-panel-and-dock-layouts/1 : work {
    title "Adjustable Home panels and docks with automatic arrangements for each output shape"
    state completed
    scope [
        path "crates/lege-field/**",
        path "crates/lege-session-core/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Turn the fixed drawer block and system shelf into user-adjustable Home-only containers. A panel/rail/dock is a layout group for folders, shortcut panes, widgets or sessions: it can be moved, resized, oriented as a row/column/edge rail, or assigned an automatic arrangement that fits the current output. Automatic choices include balanced rows/columns, edge rails and a cushion-map-like composition where area follows the importance or content measure the object declares.

        Preset buttons on Home switch arrangements immediately without rebuilding or losing the contained objects. A custom layout is retained as the restore target; selecting another preset replaces the current preset in one action rather than building an undo stack of intermediate movements. Layout persists per output identity and safely reflows when scale, resolution or topology changes. These docks never map as ShellOverlay, never reserve an exclusive zone outside Home, and disappear completely behind application work.
        """
    acceptance {
        check adjustable-home-groups {
            statement """
                Home panels/rails can be created or configured, moved, resized and oriented without changing the identity or contents of their objects.
                """
            method command
            command "cargo test -p lege-field -p lege-shell panel_layout"
            verified_by [ @legeos.evidence.home-panels-20260831/1 ]
        }
        check automatic-layouts-fit {
            statement """
                Balanced, edge-rail and cushion-style automatic arrangements are deterministic, non-overlapping and bounded across supported output sizes and scales.
                """
            method command
            command "cargo test -p lege-field panel_layout -- --include-ignored"
            verified_by [ @legeos.evidence.home-panels-20260831/1 ]
        }
        check home-only-no-exclusive-zone {
            statement """
                With an application fullscreen or maximized, no Home panel/dock is visible and no panel/dock reduces the application work area.
                """
            method observation
            verified_by [ @legeos.evidence.home-panels-no-exclusive-zone-20260831/1 ]
        }
        check preset-switch-is-reversible {
            statement """
                Switching directly between any two presets is one operation, preserves the saved custom arrangement, and Restore Custom returns every group to its exact prior placement.
                """
            method command
            command "cargo test -p lege-field panel_presets"
            verified_by [ @legeos.evidence.home-panels-20260831/1 ]
        }
    }
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.home-presentation-subtraction/1 : work {
    title "WS1 — Home subtraction: shape-aware floors, one Files object, pinned-only App tiles"
    state completed
    scope [ path "crates/lege-field/**", path "shell/lege-shell/**" ]
    intent """
        Shell phases 0-2 of the consolidation plan. Phase 0: replace Representation::for_span's cell-count match with a declared RungFloor/RungLadder (cols, rows, cells floors per rung; highest admitted rung wins; monotone by construction), values chosen so no span reachable in today's default layout changes rung (System Large keeps rows floor 2 for the 7x2 Settings tile); reflow's aspect_distortion untouched; the --render baseline must not change in this phase. Phase 1: delete DRAWER_TILES, drawer_grid, drawer_reserved_cols, merge_drawers and the drawers panel group; add files_tile_id, merge_files (TileKind::Widget widget="files", span 2x2 floor / 4x3 preferred / widget-class ceiling) and migrate_drawer_tiles (all ten legacy drawer tiles kind-checked, first cell and largest span inherited, panel removed, idempotent, exact-inverse FieldOps); new surface/files_screen.rs renders Small and Wide from existing DrawerFeeds with conditional Downloads/Trash/Operations rows; DOCUMENT_VERSION stays 1. Phase 2: delete merge_apps; narrow the gone sweep to ParkedSession only (commented as load-bearing); add pin_app, FieldAction::PinApp, a Keep-on-Home session context row and the declared home.pin-app action; LIVE/PARKED hidden when every non-shelved toplevel has a located session tile.
        """
    note """
        Settled: the default Desktop folder tile stays (per the placeable-objects decision); all ten --print drawer slugs stay as diagnostics. Risk watched: WidgetRegion::from_rung reachability asserted for every widget so no control silently vanishes at a new rung boundary.
        """
    acceptance {
        check drawer-migration {
            statement """
                A saved layout with the legacy drawer block loads with one Files tile at the first drawer's cell, the drawers panel removed, and the migration idempotent with exact inverses.
                """
            method command
            command "cargo test -p lege-shell field_model"
            verified_by [ @legeos.evidence.ws1-drawer-migration-20260901/1 ]
        }
        check field-ladder-tests {
            statement """
                lege-field passes the new ladder property tests: rung monotone in both axes, ladders well-formed, every rung reachable within its kind's ceiling, and the cells-only ladder reproduced for aspect within 1:3.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.ws1-field-ladder-tests-20260901/1 ]
        }
        check no-auto-app-tiles {
            statement """
                A running session produces a session tile and no App tile; a pinned App tile survives a shell restart; a field refresh never removes a placed tile other than a closed window's session tile.
                """
            method manual
            verified_by [ @legeos.evidence.ws1-no-auto-app-tiles-20260901/1 ]
        }
    }
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.home-project-development-status/1 : work {
    title "Proposal: opt-in development status inside project tiles"
    state proposed
    intent """
        For later consideration, give explicitly selected project tiles a compact development status view: last requested build/test result and observed source revision, with freshness and unavailable states. At larger representations, provide an explicit route to the corresponding log. Keep collection and process execution behind a typed service; the shell only renders and forwards. Do not run repository commands or hooks on discovery, continuously crawl projects, create permanent status chrome, or resize/reorder tiles on status changes. Settle service ownership, trust/consent, bounded output storage and refresh budget before implementation.
        """
    note """
        Extrapolated from Home as working memory and the user's day-to-day development objective; not authorization to add background build or git polling.
        """
    acceptance {
        check honest-status {
            statement """
                The tile identifies the command/result revision and age, and distinguishes stale, running, failed, unavailable and never-run states.
                """
            method manual
        }
        check opt-in-and-bounded {
            statement """
                Opening Home performs no repository command; service fixtures enforce bounded output, no automatic repository hooks, and unchanged tile geometry when status updates.
                """
            method command
        }
    }
    implements [ @legeos.constraint.services-not-indicators ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.home-review-usability-20260905/1 : work {
    title "Home review: reachable context menus and current-directory terminals"
    state completed
    intent """
        Repair existing Home interaction routes: keep long context menus within the output with pointer paging, wheel and keyboard access to every row; expose existing Copy/Cut file verbs; allow Open terminal here on directory ground independently of selection. Keep Help text readable with scrolling and a fixed close route. Folder windows report failed reads rather than remaining in reading state, reset scrolling on upward navigation, and reserve space for truncation notices. Preserve manifest actions, service ownership, saved geometry and the application-only Home launcher.
        """
    note """
        Continued at the user's request in branch home-review-20260905 in ../LegeOS-home-review from 94c2954, carrying the four shell source files already modified by this review; the folder error-state change in app.rs was added only in the isolated worktree. Earlier partial edits remain in the active tree; subsequent edits and validation are isolated. Extrapolated ideas remain proposals under @legeos.work.home-developer-setup-preview and @legeos.work.home-project-development-status. The full folder interaction parity gap is recorded in the audit rather than treated as a new default layout decision.
        """
    acceptance {
        check lint {
            statement """
                Changed shell code passes strict clippy.
                """
            method command
            command "cargo clippy -p lege-shell --all-targets -- -D warnings"
            verified_by [ @legeos.evidence.home-review-lint-20260905 ]
        }
        check regressions {
            statement """
                Small-screen menu navigation keeps visible hit targets inside the menu and reaches the last row; directory terminal requests work without selection and row requests preserve their target; shell regressions pass.
                """
            method command
            command "cargo test -p lege-shell"
            verified_by [ @legeos.evidence.home-review-tests-20260905 ]
        }
    }
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.home-shelf-and-representation-ladder/1 : work {
    title "A route back off the shelf, a way to reset the field, and the representation ladder for drawer tiles"
    state completed
    scope [
        path "crates/lege-field/**",
        path "crates/lege-types/src/action.rs",
        path "shell/lege-shell/**"
    ]
    intent """
        Close the three gaps the reshape work exposed, all of them about showing and hiding information deliberately rather than by accident.

        One: a tile on the shelf is unreachable (@legeos.observation.shelved-tiles-have-no-route-back). Needs the shelf enumerated somewhere a person can see it and a `field.restore` action to bring a tile back, declared in the manifest like every other action so it reaches the menu, the cheat sheet and the CLI at once.

        Two: nothing resets a field to its defaults. `merge` is add-only by design — it never moves a tile the user placed — so every layout improvement is invisible to anyone with a saved field, and a field that has drifted into a mess can only be repaired tile by tile. `lege_field::reflow::tidy` exists as the packing primitive and has no command above it.

        Three: drawer tiles do not climb the representation ladder that `docs/homefield.md` describes and the system widgets already implement. A drawer clips its raw text lines to whatever height it has, so a short tile shows a truncated path rather than the 'name, count, content-colour band' the design calls for at the compact rung. The data is unstructured text today, so this likely needs the drawer feed to carry a count and a headline separately from its lines.
        """
    note """
        Opened from the reshape work rather than planned: the first two were only visible once `--print field` stopped describing a hypothetical field, and the third once tiles were drawn at their true size.
        """
    acceptance {
        check drawers-climb-the-ladder {
            statement """
                A drawer tile too small for its listing shows a headline figure or count rather than the listing clipped, and reveals the listing once it reaches Representation::Wide.
                """
            method command
            command "cargo test -p lege-shell --lib drawers::"
            verified_by [ @legeos.evidence.shelf-reset-and-drawer-ladder-20260831 ]
        }
        check field-can-be-reset {
            statement """
                The stored layout and its undo log can be discarded so the current default layout is adopted, and the action confirms first because it is not undoable.
                """
            method command
            command "busctl --user call org.legeos.Session /org/legeos/Session/HomeField org.legeos.HomeField1 Reset sqq <output> <cols> <rows>"
            verified_by [ @legeos.evidence.shelf-reset-and-drawer-ladder-20260831 ]
        }
        check gates-green {
            statement """
                Workspace tests, clippy with warnings denied, rustfmt and all seven xtask gates pass.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
            verified_by [ @legeos.evidence.shelf-reset-and-drawer-ladder-20260831 ]
        }
        check shelf-has-a-route-back {
            statement """
                A stashed tile can be brought back onto the field from a surface, not only by an immediate undo, and the route is offered only when the shelf is occupied.
                """
            method command
            command "cargo test -p lege-shell --lib restoring_brings_every_shelved_tile_back a_row_is_offered_only_where_it_could_be_performed"
            verified_by [ @legeos.evidence.shelf-reset-and-drawer-ladder-20260831 ]
        }
    }
    derived_from [ @legeos.observation.shelved-tiles-have-no-route-back ]
    part_of [ @legeos.work.home-widgets ]
}

record legeos.work.home-surface-usability-next/1 : work {
    title "Next Home usability sequence — adaptable Home, complete folder surfaces, then common Settings"
    state active
    scope [
        path "apps/lege-files/**",
        path "apps/lege-settings/**",
        path "compositor/lege-comp/**",
        path "crates/lege-field/**",
        path "crates/lege-window/**",
        path "services/lege-filed/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Carry the Home surface from a fixed demonstration layout to an ordinary daily desktop in the order set by the user on 2026-08-31.

        First, make Home itself adaptable: configurable Home-only panels/rails/docks, automatic panel layouts for different output shapes, user-invoked arrangements for all open windows, and immediate reversible switching among those arrangements. Preserve truly chrome-free fullscreen application work and refine bare Super from release-only toggling into immediate press/hold Home reveal with shortcut-safe semantics.

        Second, make folders and composite shortcut panes the Home file objects. Build copy/cut/paste, drag and drop, delete/trash and the remaining ordinary file verbs on the multi-selection foundation; then add deterministic sorting and list-versus-thumbnail presentation. Loose individual file tiles are explicitly not part of this model.

        Third, make the graphical Settings app adjust the common controls a person expects: resolution/refresh/rotation/scale, mouse and trackpad behaviour, and appearance/theme/material choices. Accessibility remains deferred behind these product-completeness items per the user's standing priority.
        """
    note """
        Progress 2026-08-31: steps one and two are complete — Super press/hold reveal, Home panels with Balanced/Rail/Cushion arrangements, reversible window arrangement presets, placeable folders and shortcut panes, ordinary file operations with typed drag/drop and one journalled undo, deterministic sorting plus list/thumbnail modes, and the wl_data_device transport all landed with their records completed. The one remaining child is @legeos.work.home-field-settings-gui, whose two pre-implementation design questions (the compositor configuration channel, and making design.rs palette-driven) are surveyed on that record.
        """
    depends_on [ @legeos.work.home-field-selection-and-bulk-action ]
    derived_from [ @legeos.assessment.home-field-usability-gaps-20260831 ]
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-field ]
}

record legeos.work.home-widget-foundations/1 : work {
    title "Home Field widget foundations — neighbour-yielding resize, the widget contract, the action manifest, and Lifecycle1 as the service pattern"
    state superseded
    scope [
        path "cli/lege/src/lifecycle.rs",
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-field/**",
        path "crates/lege-types/src/action.rs",
        path "crates/lege-window/src/geometry.rs",
        path "interfaces/dbus/org.legeos.Session.Lifecycle1.xml",
        path "services/lege-sessiond/src/apis/lifecycle.rs",
        path "shell/lege-shell/**"
    ]
    intent """
        The Home Field was a dead end for a desktop tester: no way to launch anything, no logout/restart/shutdown, no way to close a window, and a search bar that does nothing outside an expanded drawer. The decision is that every missing capability arrives as a widget on the one screen rather than as a panel or tray, consistent with M2's taskbar-free commitment. This item builds only the foundation those widgets stand on, in four parts. (1) A resize that lets adjacent tiles give up span instead of being evicted: reflow::find_resize, where a yielding neighbour keeps its far edge and the request is clamped to the largest span every neighbour can absorb. (2) The widget contract over TileKind::System, which was a designed-for slot nothing constructed: a descriptor declares what shows at each representation rung and which regions are clickable, and each region names an action rather than coding a behaviour. (3) An action manifest in lege-types, so one declaration drives the shell's labels, the keyboard accelerator and the lege verb. (4) org.legeos.Session.Lifecycle1 on sessiond forwarding to logind, built as the one worked example of the service-interface pattern every future widget follows.
        """
    note """
        The individual widgets — launcher, volume, brightness, battery, notifications, tray — are deliberately out of scope and planned separately against this foundation.

        Three findings worth carrying forward. First, no new op or inverse machinery was needed for neighbour yielding: Placement already carries a span, Located wraps it, and Layout restores it, so moved_back captures a neighbour's prior size for free and the document format is unchanged. Second, the default drawer block is packed at the 2x2 widget floor, so no drawer on the default field can grow — correct under the clamp rule the user chose, but it makes the resize gesture look inert on first use and is a defaults decision still to be made. Third, Super+Left/Right was implemented in the compositor over window geometry (lege_window::geometry::contiguous_window) rather than over the shell's tile layout as first planned: it needs no wire-protocol bump, keeps working with the shell dead like every other reserved chord, and stays inside the compositor's own remit since it reasons only about windows.

        Lock is declared in Lifecycle1 and returns NotSupported. The compositor implements ext-session-lock-v1 in full but nothing drives it; making Lock real means giving sessiond a Wayland lock-manager client, which is its own work item.
        """
    depends_on [
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
}

record legeos.work.home-widget-foundations/2 : work {
    title "Home Field widget foundations — neighbour-yielding resize, the widget contract, the action manifest, and Lifecycle1 as the service pattern"
    state active
    scope [
        path "cli/lege/src/lifecycle.rs",
        path "compositor/lege-comp/src/keybindings.rs",
        path "crates/lege-field/**",
        path "crates/lege-types/src/action.rs",
        path "crates/lege-window/src/geometry.rs",
        path "interfaces/dbus/org.legeos.Session.Lifecycle1.xml",
        path "services/lege-sessiond/src/apis/lifecycle.rs",
        path "shell/lege-shell/**"
    ]
    intent """
        The Home Field was a dead end for a desktop tester: no way to launch anything, no logout/restart/shutdown, no way to close a window, and a search bar that does nothing outside an expanded drawer. The decision is that every missing capability arrives as a widget on the one screen rather than as a panel or tray, consistent with M2's taskbar-free commitment. This item builds only the foundation those widgets stand on, in four parts. (1) A resize that lets adjacent tiles give up span instead of being evicted: reflow::find_resize, where a yielding neighbour keeps its far edge and the request is clamped to the largest span every neighbour can absorb. (2) The widget contract over TileKind::System, which was a designed-for slot nothing constructed: a descriptor declares what shows at each representation rung and which regions are clickable, and each region names an action rather than coding a behaviour. (3) An action manifest in lege-types, so one declaration drives the shell's labels, the keyboard accelerator and the lege verb. (4) org.legeos.Session.Lifecycle1 on sessiond forwarding to logind, built as the one worked example of the service-interface pattern every future widget follows.
        """
    note """
        STATUS FOR A HANDOFF: all four parts are implemented, tested and lint-clean, and the ledger's evidence covers everything except `hands-on-at-a-real-desktop`, which is the one outstanding check. Nothing here needs rewriting; the next step is to run it on a real desktop and then complete this record. Follow-on work is @legeos.work.home-widgets and its children.

        The individual widgets — launcher, volume, brightness, battery, notifications, tray — are deliberately out of scope here and planned separately against this foundation.

        Decisions the user made that shaped the design, and that a successor should not quietly reverse. Contiguity is navigation-only: it scopes which window a chord moves to, is recomputed per keypress and never persisted, which is what keeps it compatible with homefield.md's rule that adjacency must not imply a relationship. A resize that outruns its neighbours clamps rather than evicting or cascading. Session power actuation lives in sessiond over logind, not in lege-hostd, so shutting down your own laptop needs no administrator prompt and ADR-0003's scope for the privileged daemon is untouched.

        Three findings worth carrying forward. First, no new op or inverse machinery was needed for neighbour yielding: Placement already carries a span, Located wraps it, and Layout restores it, so moved_back captures a neighbour's prior size for free and the document format is unchanged — this is why the change is as small as it is. Second, the default drawer block is packed at the 2x2 widget floor, so no drawer on the default field can grow; correct under the clamp rule, but it makes the gesture look inert on first use — see @legeos.question.home-field-default-density. Third, Super+Left/Right was implemented in the compositor over window geometry (lege_window::geometry::contiguous_window) rather than over the shell's tile layout as first planned: it needs no wire-protocol bump, keeps working with the shell dead like every other reserved chord, and stays inside the compositor's remit since it reasons only about windows.

        Lock is declared in Lifecycle1 and returns NotSupported. The compositor implements ext-session-lock-v1 in full but nothing drives it; see @legeos.work.session-lock-client.
        """
    acceptance {
        check hands-on-at-a-real-desktop {
            statement """
                At a real desktop: drag a tile's corner into free space and nothing else moves; drag it into a neighbour and the neighbour narrows in place without jumping; keep dragging and the ghost visibly stops while the pointer runs on; Ctrl+Z restores both sizes. The Session widget's Shut down arms on the first click and fires on the second. Super+Left/Right steps between windows, and still cycles by stacking order with lege-shell killed.
                """
            method manual
        }
        check invariants-unmodified {
            statement """
                lege-field's four pre-existing properties — ops_keep_invariants_and_invert_exactly, placing_moves_only_band_mates, placement_is_deterministic, content_changes_move_nothing — still pass with no edit to them. Editing one to accommodate the resize would mean the design is wrong.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check no-maximize-in-the-widget-system {
            statement """
                No non-container tile can be resized to cover its whole grid; widgets can nonetheless grow, which before this work they could not do at all.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check one-declaration-three-surfaces {
            statement """
                Every action a shell surface performs is declared in lege_types::action, every declared CLI verb reaches a real lege subcommand, and the compositor's fixed recovery chords agree with what the manifest says they do without the compositor reading the manifest at run time.
                """
            method command
            command "cargo run -q -p xtask -- check-actions && cargo test -p lege-comp"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check resize-inverts-exactly {
            statement """
                Undo restores every affected tile's size as well as its position, with no new op and no change to DOCUMENT_VERSION.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check resize-yields-not-evicts {
            statement """
                Growing a tile into a neighbour narrows that neighbour against its own far edge; nothing is relocated, and a request past what neighbours can give is clamped to the largest achievable span rather than refused or paid for by an eviction.
                """
            method command
            command "cargo test -p lege-field"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check session-can-be-ended {
            statement """
                org.legeos.Session.Lifecycle1 forwards logout/reboot/poweroff/suspend to logind behind a testable seam, the Session widget offers them with a confirm step, `lege session` reaches the same verbs, and the interface XML ships in legeos-sessiond.
                """
            method command
            command "cargo test -p lege-sessiond -p lege && cargo run -q -p xtask -- check-interfaces"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
        check shell-still-runs {
            statement """
                Nested, the shell connects to lege_shell_v1, declares Layer::HomeSurface and renders the new draw paths without error or panic.
                """
            method manual
            verified_by [ @legeos.evidence.widget-foundations-nested-run-20260825 ]
        }
        check widget-contract-is-data-driven {
            statement """
                A TileKind::System tile renders through a declared descriptor: what it shows per representation rung, and which regions are clickable. Region hit-testing is generic, with no per-widget arm in the painter.
                """
            method command
            command "cargo test -p lege-shell"
            verified_by [ @legeos.evidence.widget-foundations-workspace-20260825 ]
        }
    }
    depends_on [
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
    supersedes [ @legeos.work.home-widget-foundations/1 ]
}

record legeos.work.home-widget-launcher/1 : work {
    title "Launcher widget — make a cold session able to open its first application"
    state active
    scope [
        path "crates/lege-appd/src/dbus.rs",
        path "crates/lege-appd/src/desktop_entry.rs",
        path "crates/lege-types/src/app.rs",
        path "shell/lege-shell/src/icons.rs",
        path "shell/lege-shell/src/surface/widgets/**"
    ]
    intent """
        A launcher widget that lists installed applications, filters as the user types, and launches through Launcher1. This is the single most load-bearing gap: without it a freshly booted session cannot open anything at all, because application tiles are derived from windows that already exist (field_model::merge_apps) and are removed when the last one closes. The inventory is already in the shell — AppIdentity1.ListApps is fetched every three seconds into ShellApp::apps and its only consumer today is a grep for nm-tray — and Launcher1.Launch already works and is already called for the network control and for opening files. The widget itself is small; the prerequisites below are not.
        """
    note """
        STATUS FOR A HANDOFF: implemented, tested and lint-clean; see @legeos.evidence.home-widget-launcher-20260825. All three prerequisites landed: AppManifest carries icon/categories/keywords/NoDisplay with serde defaults so pre-upgrade manifests still parse; NoDisplay is recorded not filtered (the entry must import so MIME associations resolve, listings exclude it client-side); a new AppIdentity1.ListApplications returns the full rows. icons.rs now reverses the desktop-import namespacing via IconHints{icon, desktop_file_ids} and rasterizes SVG through resvg 0.45 (default-features off — no font stack, licences checked against deny.toml's allow-list by reading cargo metadata since cargo-deny is not installed here). app_search is a pure module with a total sort key so redraws cannot reshuffle. The launcher is the second WidgetDescriptor over TileKind::System; system_landing now places the two system widgets in opposite bottom corners. The field search bar is live on the home screen: typing filters the launcher, Enter launches the best match.

        The one outstanding check is hands-on at a real desktop, same as the foundations record; complete this after that run.

        FOR A SUCCESSOR: (1) `lege app list` still uses ListApps and shows bare ids — ListApplications is there if the CLI wants names and NoDisplay filtering. (2) SVG icons that are pure typography render shapes only (resvg font stack is off). (3) desktop_file_candidates cannot reverse derive_app_id's sanitiser for ids with characters outside [A-Za-z0-9.-_]; the shell always passes IconHints from the registry so this only bites a caller that does not. (4) No index.theme parsing or theme inheritance yet — only hicolor and /usr/share/pixmaps are walked. (5) The zoom test now stashes system tiles first; the real signal underneath is that eight drawers plus two system widgets crowd a small field — see @legeos.question.home-field-default-density.
        """
    part_of [ @legeos.work.home-widgets ]
    verified_by [ @legeos.evidence.home-widget-launcher-20260825 ]
}

record legeos.work.home-widget-notifications/1 : work {
    title "Notification widget — the tile and the read-back path shipped; per-notification dismiss, actions and any push remain"
    state completed
    scope [
        path "cli/lege/**",
        path "crates/lege-state/src/migrations/session.rs",
        path "services/lege-sessiond/src/apis/notifications.rs",
        path "shell/lege-shell/src/surface/widgets/**"
    ]
    intent """
        Superseded in part by what shipped on 2026-08-30. Revision 1's premise — that the shell contains no notification rendering whatsoever, and that sessiond offers no read-back — no longer holds. org.legeos.Notifications1 serves ListActive, Dismiss, ClearAll and a Changed signal alongside the full org.freedesktop.Notifications implementation, and the shell has a notifications system widget (shell/lege-shell/src/surface/widgets/mod.rs:144) showing a headline count and up to three app — summary lines, with a clear-all region wired to ClearAll.

        What remains is most of what makes notifications useful. There is no per-notification dismiss, only bulk clear. A notification's actions cannot be invoked from the shell — ActionInvoked is served but never emitted by any surface — so a notification offering Reply or Open is decorative. Nothing is pushed: no toast, no OSD, nothing appears unprompted, so a notification is seen only if the user happens to look at the tile, which for a message or a finished job is close to not being notified at all. The three-line cap does not grow with the tile.

        History is readable through Settings — History or lege settings --page history, so nothing is lost; it is just not surfaced where a user would look.
        """
    note """
        Revised 2026-08-31 by the Home Field usability audit, which found revision 1's no-rendering premise stale. The remaining gap is push and per-item action, not rendering.
        """
    derived_from [ @legeos.assessment.home-field-usability-gaps-20260831 ]
    part_of [ @legeos.work.home-widgets ]
}

record legeos.work.home-widget-status-instruments/1 : work {
    title "Volume, brightness and battery widgets, and the services they need — none of which exist yet"
    state completed
    scope [
        path "cli/lege/**",
        path "interfaces/dbus/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/src/surface/widgets/**"
    ]
    intent """
        Volume, brightness and battery as widgets, each backed by a service interface following the Lifecycle1 pattern. All three are absent from the whole repository, not merely from the shell: there is no audio client of any kind (no PipeWire, PulseAudio or ALSA code — the only mentions are cgroup protections naming the pipewire and wireplumber units so the resource governor never kills them), no backlight code, and no battery reading. crates/lege-hwdetect is GPU detection only. So each of these is a service to write first and a widget second, which is the order services-not-indicators requires anyway.
        """
    note """
        org.legeos.Power1's module doc claims the domain is "idle, lid, brightness and battery via logind/upower", and none of that integration exists: Power1 is eighty-five lines of get/set/reset over a stored PowerProfile, and nothing anywhere reads its dim_after, screen_off_after, lock_after or suspend_after durations and acts on them. There is no idle watcher, no ext-idle-notify-v1, no lid handling. So a second, honest piece of scope sits next to the widgets: either make Power1's policy real or narrow its documentation to what it does. A battery widget that reports charge while the machine never dims or suspends would be a strange thing to ship.

        ProviderRole::PowerManager exists and no application fills it. Related risk already flagged during the foundations work: the shell's power routing calls org.legeos.Session directly, so if a third-party power manager is ever selected through Providers1 the one-provider-per-role model is silently bypassed. Decide the routing rule before, not after, more power surfaces exist.
        """
    depends_on [ @legeos.constraint.services-not-indicators ]
    part_of [ @legeos.work.home-widgets ]
}

record legeos.work.home-widgets/1 : work {
    title "Home Field widgets — every missing desktop capability as a tile on the one screen"
    state proposed
    scope [
        path "cli/lege/**",
        path "crates/lege-appd/**",
        path "crates/lege-types/**",
        path "interfaces/dbus/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        A gap review of the Home Field against what any desktop of the last twenty years offers found that a cold session gives the user eight drawer tiles and the message "open an application and it will appear", with no way to open one. Application tiles are derived only from windows that are already running and are removed when the last one closes, so the launcher route is circular. There is no logout, restart, shutdown, suspend or lock; no way to close a window; no volume, brightness or battery; no notification rendering despite sessiond hosting the notification server; no context menus; and the field's own search bar does nothing outside an expanded drawer. The decision is that each of these arrives as a widget on the single screen — information first, sub-clickable, opening a window only as a deliberate second step — rather than as a panel, a dock or a tray, which is consistent with M2's taskbar-free commitment and with homefield.md's rule that the launcher is inventory and the home screen is working memory. @legeos.work.home-widget-foundations built the framework; this item is the umbrella for the widgets themselves and for the window controls that are still missing.
        """
    note """
        Each child is independently landable against the finished foundation. Read @legeos.work.home-widget-foundations' note first: it records the constraints the user set (clamp rather than evict, navigation-only contiguity, session power over logind) which apply to every child here.

        Two rules from the foundation govern all of this work. The shell renders and forwards; policy lives in a service behind a D-Bus interface, so each widget needs a backing interface before it needs pixels — Lifecycle1 is the worked example to copy. And every capability must be declared once in lege_types::action, which is what puts it in the widget's regions, the cheat sheet and `lege` together; `cargo run -p xtask -- check-actions` fails the build when a surface performs an action nobody declared.
        """
    depends_on [
        @legeos.constraint.services-not-indicators,
        @legeos.work.home-widget-foundations
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
}

record legeos.work.host-update-transaction/1 : work {
    title "The host daemon: kernel and driver as one resumable transaction, two boot backends, enforced polkit"
    state completed
    scope [
        path "crates/lege-hwdetect/**",
        path "distro/deploy/**",
        path "interfaces/dbus/org.legeos.Host.*.xml",
        path "packaging/**",
        path "services/lege-boot-health/**",
        path "services/lege-hostd/**"
    ]
    intent """
        Make lege-hostd able to promote or roll back a kernel and its NVIDIA modules as a pair: the Planned → Downloading → Staging → Verifying → AwaitingReboot → Trial → Promoted|RolledBack|Failed state machine over a durable journal that resumes mid-apt after a restart, with apt run as a child transient unit; a BootManager trait with working systemd-boot and grub backends so ADR-0004's undecided Secure-Boot posture stays a configuration choice rather than a hardcoding; one driver authority that selects a single flavour from detected hardware, verifies the version lock and detects support violations; the storage reserve and its trim order; polkit authorisation checked in the daemon on every privileged method, with the policy and an AppArmor profile shipped; and a lege-boot-health that can actually fail, since it gates boot-complete.target with FailureAction=reboot-force.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.logical-app-and-variant-identity/1 : work {
    title "WS5 — logical app + variant identity: provenance, trust tiers, variant-keyed rights"
    state completed
    scope [
        path "crates/lege-appd/**",
        path "crates/lege-associationd/**",
        path "crates/lege-client/**",
        path "crates/lege-state/**",
        path "crates/lege-types/**",
        path "interfaces/**",
        path "services/lege-sessiond/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Identity phases 0-4 and 8. Today's AppId is the variant id (pub type AppVariantId = AppId); LogicalAppId is a new newtype sharing the validator; the cgroup/unit name keeps naming the variant. AppProvenance (origin kind, trust tier derived never declared, source path, package ref, version, desktop entry, launch mechanism, executable, sandboxed, update owner, declared privileges and provider claims as inert claims) attaches to every manifest. Import keys candidates on (origin_namespace, desktop_id) — the XDG chain keeps freedesktop shadowing, flatpak exports become their own namespace with ids flatpak.<X-Flatpak id>, fixing the live bug where a flatpak export and a distro package sharing a desktop id collapse and the distro app silently vanishes. Old flatpak ids migrate by resolve-through-alias (app_variant_aliases), never by rewriting stored rows, so rollback stays safe. Logical grouping joins variants only on five explicit rules (declared logical app, shared desktop-entry id across origins, flatpak alias, StartupWMClass+Name, shared executable minus multiplexers); minted logical ids persist. AppIdentity1/Projects1/Launcher1 extended additively (ListLogicalApps, ListVariants, LogicalAppOf, ListInstancesDetailed, LaunchLogical); ResolveWindow unchanged. Phase 4 closes two live security gaps: Providers1.Declare verifies the caller's own variant via peer PID to cgroup; a User-trust variant may not declare an exclusive provider role; and a desktop id whose provenance moves System to User trust has its provider declarations and autostart approvals dropped with a history event. Associationd records logical_app_id beside app_id and substitutes sibling variants with reason variant-substituted.
        """
    note """
        Settled: AppVariantId stays an alias (rename separable); the Declare credential check lands here because it is what makes variant-keyed rights enforceable; migration 0006 is additive with the explicit review step that no column-less INSERT exists anywhere. A wrong logical merge is cosmetic by design because rights key on the variant.
        """
    acceptance {
        check collision-regression {
            statement """
                A distro org.mozilla.firefox.desktop and a flatpak export of the same desktop id import as two distinct variants grouped under one logical app; today's silent disappearance is gone.
                """
            method command
            command "cargo test -p lege-appd"
            verified_by [ @legeos.evidence.ws5-collision-regression-20260901/1 ]
        }
        check migration-fixture {
            statement """
                A database seeded with pre-0006 association, provider and desktop-import rows returns identical values for every pre-existing read after migration 0006 applies.
                """
            method command
            command "cargo test -p lege-state"
            verified_by [ @legeos.evidence.ws5-migration-fixture-20260901/1 ]
        }
        check one-firefox {
            statement """
                With two variants installed the shell search shows one application whose details offer the variant choice, and an association whose stored variant was uninstalled resolves to a sibling with reason variant-substituted.
                """
            method manual
            verified_by [ @legeos.evidence.ws5-one-firefox-20260901/1 ]
        }
        check trust-gates {
            statement """
                A user-writable .desktop cannot take an exclusive provider role; a user entry shadowing a system entry does not inherit its grants; Declare from a caller whose cgroup does not own the declared variant is refused.
                """
            method command
            command "cargo test -p lege-sessiond providers"
            verified_by [ @legeos.evidence.ws5-trust-gates-20260901/1 ]
        }
    }
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.project-semantic-service/1 : work {
    title "WS4 — projects as authoritative semantic objects; priority_boost becomes ProjectImportance"
    state completed
    scope [
        path "cli/lege/**",
        path "crates/lege-client/**",
        path "crates/lege-session-core/**",
        path "interfaces/**",
        path "services/lege-filed/**",
        path "services/lege-sessiond/**"
    ]
    intent """
        Identity phases 5-7. Projects1 is extended additively — no Projects2: Describe(id) returning project_json against interfaces/schemas/project.schema.json, ListDetailed, Update with an explicit key allowlist (unknown key refused, nothing stored), GetCurrent/SetCurrent (stored in settings_values under _internal.projects.current), SetState(active|archived) with archived projects still searchable and openable, AddLogicalApp(logical id + optional preferred variant), and Changed/CurrentChanged signals. The Project struct gains importance, state, created/last-opened/last-active timestamps and references, and loses the inert priority_boost — replaced by ProjectImportance { Normal, Important }; the JSON blob is serde-additive in both directions so no schema migration is needed. Open/close call Files.Recents1.SetProject/ClearProject, waking the dead Suggestion::CurrentProject in lege-filed. ProjectApp gains logical_app and last_variant; opening resolves preferred variant, then the logical default, then warn-and-skip, recording what launched. Importance reaches the governor without touching lege-resourced: an Important open project sets protected=true through the existing Resources1.SetInstanceHints on the instances it launched, restored on close or demotion. HomeField stores only presentation (this project is here, this size); the project service is the record of membership.
        """
    note """
        A graded importance channel is deliberately not built until resourced has a weight to multiply it by — the priority_boost lesson. CLI: lege project show / set --importance --state / current.
        """
    acceptance {
        check blob-compat {
            statement """
                An old project blob still carrying priority_boost loads with the value ignored; a new blob read by the previous binary round-trips without loss; apply_changes refuses an unknown key.
                """
            method command
            command "cargo test -p lege-session-core projects"
            verified_by [ @legeos.evidence.ws4-blob-compat-20260901/1 ]
        }
        check update-roundtrip {
            statement """
                Update followed by Describe round-trips every allowlisted field through the D-Bus API, and SetCurrent reaches lege-filed's recents suggestion.
                """
            method command
            command "cargo test -p lege-sessiond projects"
            verified_by [ @legeos.evidence.ws4-update-roundtrip-20260901/1 ]
        }
        check variant-reopen {
            statement """
                A project whose pinned flatpak variant was uninstalled reopens on the sibling variant and says so in history.
                """
            method manual
            verified_by [ @legeos.evidence.ws4-variant-reopen-20260901/1 ]
        }
    }
    depends_on [ @legeos.work.logical-app-and-variant-identity ]
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.reference-hardware-qualification/1 : work {
    title "D4 — lege doctor --hardware executes bounded read-only probes and emits one qualification report with four outcomes"
    state proposed
    scope [
        path "cli/lege/src/doctor/hardware.rs",
        path "cli/lege/src/doctor/mod.rs",
        path "crates/lege-hwdetect/**",
        path "distro/hardware/**",
        path "services/lege-boot-health/src/main.rs",
        path "tests/hardware/**"
    ]
    intent """
        Add crates/lege-hwdetect probes (timeout-bounded, read-only: kernel and module versions, module signer, nvidia-smi, vulkaninfo, PRIME offload, CUDA deviceQuery where present, VA-API), have lege-boot-health delegate its existing four probes to them, add a NotExecuted outcome distinct from Skipped, and make `lege doctor --hardware` run the safe subset and print or JSON-emit one qualification report in which manual cases stay NotExecuted with their steps. Send the exact NVIDIA/CUDA package list to the package-selection lane.
        """
    note """
        HEAD reconciliation 2026-09-03: the runner exists and is honest (cases compiled in, all emitted as Skipped) but executes no probes; boot-health already has bounded probes; Outcome has Pass/Fail/Skipped only.
        """
    acceptance {
        check four-outcome-report {
            statement """
                `lege doctor --hardware --json` on the reference profile emits a report distinguishing pass, fail, skipped and not-executed, with manual cases not-executed.
                """
            method command
            command "cargo test -p lege doctor::hardware"
            verified_by [
                @legeos.evidence.de01-hardware-report-20260904,
                @legeos.evidence.de01-integrated-gate-20260904
            ]
        }
        check manual-matrix-user-run {
            statement """
                Suspend/resume, output hotplug, GPU-mode transitions and Secure Boot checks are executed by the user on the reference laptop and recorded as evidence.
                """
            method manual
        }
        check probes-are-bounded-and-honest {
            statement """
                A hung probe becomes NotExecuted, a missing binary becomes Skipped, and neither is reported as Pass or Fail.
                """
            method command
            command "cargo test -p lege-hwdetect probes"
            verified_by [ @legeos.evidence.de01-integrated-gate-20260904 ]
        }
    }
    implements [
        @legeos.decision.base-ubuntu-2604-kernel-70,
        @legeos.decision.one-privileged-host-daemon
    ]
    part_of [
        @legeos.milestone.developer-edition-0-1,
        @legeos.work.desktop-validation-foundations
    ]
}

record legeos.work.reference-machine-provisioning/1 : work {
    title "D3 — one storage/deployment layout declaration, a narrow target-machine provisioner, and GRUB entries that carry legeos.deployment="
    state proposed
    scope [
        path "distro/deploy/README.md",
        path "distro/deploy/layout.toml",
        path "distro/image/mkosi.extra/**",
        path "distro/image/mkosi.postinst",
        path "distro/image/mkosi.repart/**",
        path "docs/adr/0004-boot-deploy-secure-boot.md",
        path "installer/**",
        path "services/lege-hostd/src/boot_entries.rs",
        path "services/lege-hostd/src/deploy.rs",
        path "tests/integration/provision-qemu.sh"
    ]
    intent """
        Declare the GPT/UEFI and Btrfs layout once (distro/deploy/layout.toml: @, @home, @var, @snapshots, @deployments, deployment id, the legeos.deployment= command-line key) and have both the mkosi repart configuration and a declarative provisioner (installer/provision.sh, every destructive step parameterised by a disk-image path) consume it. Provision from an Ubuntu 26.04 base: subvolumes, canonical sources plus the local LegeOS archive, the legeos-* metapackages, the Ubuntu-signed kernel with its matching NVIDIA LRM while retaining the previous kernel, OS identity, user, units and `lege doctor --root`. With ADR-0004 resolved to Canonical shim + GRUB, a GRUB entry writer (services/lege-hostd/src/boot_entries.rs, called from the Grub backend) generates entries that carry the deployment id and a known-good entry. Move dev-image credentials to a dev-only drop-in, document the recovery-shell route, and add a QEMU provisioning test that prints not-executed when qemu is absent.
        """
    note """
        HEAD reconciliation 2026-09-03: repart declares @ @home @var @snapshots while the engine stages @deployments/<id>; systemd-boot entries carry the id but the Grub backend writes no entry; installer/ is a README; mkosi.conf sets RootPassword=legeos and Autologin=yes; no QEMU test.
        """
    acceptance {
        check disposable-provisioning {
            statement """
                A disposable image file is provisioned and booted under QEMU, or the script reports not-executed because qemu is absent; the real target disk is a user-run gate with a checklist.
                """
            method observation
        }
        check grub-entries-carry-id {
            statement """
                The GRUB entry writer produces entries whose command line carries legeos.deployment=<id> for the candidate and the known-good deployment, and a test proves it.
                """
            method command
            command "cargo test -p lege-hostd boot_entries"
            verified_by [ @legeos.evidence.de01-integrated-gate-20260904 ]
        }
        check one-layout-declaration {
            statement """
                The repart configuration and the provisioner both derive from distro/deploy/layout.toml, which declares @deployments alongside the existing subvolumes; `just image summary` still validates.
                """
            method command
            command "cargo test -p lege-hostd layout && just image summary"
            verified_by [
                @legeos.evidence.de01-image-summary-mkosi-absent-20260904,
                @legeos.evidence.de01-integrated-gate-20260904
            ]
        }
    }
    implements [
        @legeos.decision.base-ubuntu-2604-kernel-70,
        @legeos.decision.boot-deploy-secure-boot,
        @legeos.decision.mkosi-images
    ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
    resolves [ @legeos.question.grub-entries-must-carry-the-deployment-id ]
}

record legeos.work.representation-chrome-and-continuity/1 : work {
    title "WS3 — per-rung chrome and spatially continuous expansion"
    state proposed
    scope [ path "shell/lege-shell/**" ]
    intent """
        Shell phases 5-6. Phase 5: retire the unconditional 34px GRAB_BAND_HEIGHT; add HEADING_HEIGHT=30, EDGE_GRAB_HEIGHT=10, REVEAL_HEIGHT=20; FieldScreen::band becomes grab_strip(doc, id, rect, ui) consulting representation_of so painting and hit-testing share one function — Micro/Small get a 10px grabbable edge not reserved from content with a hover-or-focus reveal strip carrying the manipulation controls and the title drawn inside the body (identity always visible, only manipulation revealed); Wide and above keep a 30px heading. Phase 6: Expansion { from, started_ms, collapsing } with EXPAND_MS=140 eased, reduced_motion forcing zero duration; the Files body draws into the interpolated rect under clip with the rung ladder itself providing the cross-fade; collapse targets the Files tile's rect recomputed per frame.
        """
    note """
        Re-baseline --render at the end of phases 5 and 6 only, never mid-phase, so every baseline diff has one explanation.
        """
    acceptance {
        check expansion-interpolation {
            statement """
                Expansion interpolation is monotone, terminates, equals the tile rect at t=0 and the full area at t=1, and reduced_motion yields no intermediate frames.
                """
            method command
            command "cargo test -p lege-shell"
        }
        check grip-overlap-all-rungs {
            statement """
                the_grip_never_overlaps_the_move_band holds at every representation rung, including a 1x1 App tile.
                """
            method command
            command "cargo test -p lege-shell field_screen"
        }
        check hands-on-chrome {
            statement """
                In a nested session, small tiles show content with no permanent band, hover and keyboard focus both reveal manipulation controls, and expansion visibly grows from and collapses back to the tile's place.
                """
            method manual
        }
    }
    depends_on [ @legeos.work.adaptive-files-and-omnibox ]
    implements [ @legeos.decision.representation-ladder-is-the-organizing-principle ]
    part_of [ @legeos.work.design-consolidation-roadmap ]
}

record legeos.work.reversible-window-arrangement-presets/1 : work {
    title "One-press reversible arrangements for all open windows"
    state completed
    scope [
        path "compositor/lege-comp/**",
        path "crates/lege-types/src/action.rs",
        path "crates/lege-window/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Add a Home control made of manifest-declared buttons that arranges the eligible open windows on an output into useful shapes: one-window focus/full-output, halves, thirds, quarters/grid, a large-focus-plus-side-stack layout, and a cushion/treemap-style packing inspired by Silvaview. The compositor owns window geometry and recoverability; the shell only requests a named preset and renders its preview/button.

        The first preset request snapshots every affected window's prior geometry and state. Choosing a different preset recomputes directly from that baseline and the current eligible window set, so a person can audition arrangements by pressing buttons without walking an undo history. Restore returns surviving windows exactly to the saved baseline, repaired only when output topology makes an old rectangle unreachable. Closed windows disappear cleanly; newly opened windows join on the next explicit preset press rather than causing surprise background retiling. The feature is user-invoked arrangement, not a permanently enforced tiling window manager.

        Arrangement controls live on Home. An application can still be fullscreen with no Home chrome visible, and the compositor's shell-independent recovery routes remain available.
        """
    acceptance {
        check buttons-and-accelerators {
            statement """
                Every arrangement and Restore has a visible Home button/menu route and may additionally have a Super accelerator declared by the same action manifest.
                """
            method command
            command "cargo run -q -p xtask -- check-actions"
            verified_by [ @legeos.evidence.window-arrangements-20260831/1 ]
        }
        check dynamic-window-set {
            statement """
                Closed windows are ignored, newly opened windows join only on the next explicit arrangement request, and output removal repairs without losing any surviving window.
                """
            method command
            command "cargo test -p lege-comp arrangement"
            verified_by [ @legeos.evidence.window-arrangements-20260831/1 ]
        }
        check fullscreen-remains-clean {
            statement """
                A fullscreen application occupies the output with no Home panel, dock, arrangement control or reserved strip visible.
                """
            method observation
            verified_by [ @legeos.evidence.arrangements-fullscreen-clean-20260831/1 ]
        }
        check preset-geometry {
            statement """
                Every declared preset produces deterministic, bounded, non-overlapping recoverable rectangles for one through a practical upper bound of windows on mixed-scale outputs.
                """
            method command
            command "cargo test -p lege-window arrangement"
            verified_by [ @legeos.evidence.window-arrangements-20260831/1 ]
        }
        check switch-from-baseline {
            statement """
                A→B preset switching is computed from one retained baseline rather than from A's geometry, and Restore returns the exact baseline when the output still permits it.
                """
            method command
            command "cargo test -p lege-window arrangement_presets_are_reversible"
            verified_by [ @legeos.evidence.window-arrangements-20260831/1 ]
        }
    }
    depends_on [ @legeos.work.home-panel-and-dock-layouts ]
    implements [ @legeos.decision.home-is-momentary-and-placeable-objects-are-containers ]
    part_of [ @legeos.work.home-surface-usability-next ]
}

record legeos.work.self-hosting-legeos/1 : work {
    title "Make LegeOS bootable on the reference laptop and able to build itself, so Lubuntu can be deleted"
    state proposed
    scope [
        path "Cargo.toml",
        path "ISO-PLAN.md",
        path "distro/**",
        path "installer/**",
        path "tests/integration/iso-qemu.sh",
        path "tests/integration/provision-qemu.sh"
    ]
    intent """
        Get from the Developer Edition 0.1 lanes to a LegeOS that boots on the reference laptop, joins WiFi through NetworkManager and nm-tray-2, and builds its own source tree — after which Lubuntu is deletable rather than load-bearing. Route (ISO-PLAN.md): resolve the closure and complete the package set (metapackages in the build set); teach the provisioner to consume the free tail beside existing partitions and ship it in legeos-cli; build a live ISO from the seeds that carries the set and runs the provisioner; prove its Secure-Boot chain under OVMF; install into the 55.9 GiB tail of nvme1n1 with a second ESP, leaving Lubuntu bootable; pin the sibling path dependencies so the installation can rebuild the workspace and its own ISO; then retire Lubuntu against the checklist.
        """
    note """
        Plan of record: ISO-PLAN.md (supersedes docs/planning/self-hosting-legeos.md as the order of work). Done in the tree as of 2026-09-05: closure resolved, metapackages built into the set, provisioner --free-space/--esp --root/--archive, ISO build script and Secure-Boot QEMU test. Not yet run anywhere: an ISO build (needs a published set with metapackages and the btrfs build volume), the OVMF boot, the laptop. Blocked on the user: pushing pixelkit (no remote), bpg-rs and Lege-ecosystem (unpushed commits) before the sibling deps can be pinned; the nm-tray-2 commits.
        """
    acceptance {
        check boots-with-secure-boot {
            statement """
                The target boots with Secure Boot on, with no MOK prompt, and /proc/cmdline carries legeos.deployment=<id> matching a directory on the ESP
                """
            method manual
        }
        check closure-resolved {
            statement """
                cargo xtask seeds closure resolves every inherited name against Ubuntu 26.04 at the pinned snapshot with zero missing
                """
            method command
            command "cargo run -q -p xtask -- seeds closure"
            verified_by [ @legeos.evidence.de01-package-closure-resolved-20260905 ]
        }
        check iso-boots-secure-boot-vm {
            statement """
                The ISO boots under OVMF with Secure Boot enforcing through shim, GRUB and the Ubuntu kernel into the live userspace
                """
            method command
            command "tests/integration/iso-qemu.sh"
        }
        check iso-builds {
            statement """
                just iso produces legeos-<set>.iso with its sha256 and TIERS.manifest from a published set
                """
            method command
            command "just iso"
        }
        check metapackages-built {
            statement """
                The eight metapackages are built and published beside the Rust packages as one coherent build set
                """
            method command
            command "cargo run -p lege -- dev repo verify"
            verified_by [ @legeos.evidence.metapackages-build-with-dpkg-deb-20260905 ]
        }
        check nm-tray-2-packaged {
            statement """
                nm-tray-2 is pinned in distro/forks/manifest.toml at a commit that carries --popup, built as legeos-nm-tray, and named in the session layer with the network-control role
                """
            method command
            command "cargo run -q -p xtask -- seeds --check && cargo run -q -p xtask -- check-packaging && scripts/build-fork-deb.sh nm-tray-2"
        }
        check provisioner-takes-free-space {
            statement """
                provision.sh --free-space plans an ESP and a root in a disk's free tail, names every partition it keeps, and changes nothing without --apply
                """
            method command
            command "tests/integration/provision-qemu.sh"
            verified_by [ @legeos.evidence.provisioner-free-space-plan-20260905 ]
        }
        check reinstall-route-exists {
            statement """
                A LegeOS installation medium exists on a USB stick that does not depend on this disk, so deleting Lubuntu is reversible
                """
            method manual
        }
        check rollback-exercised {
            statement """
                A lege dev deploy has been deliberately rolled back on the target and the machine came back
                """
            method manual
        }
        check self-hosts {
            statement """
                just check, just deb and just iso all run green inside LegeOS from a checkout with no sibling repositories present
                """
            method manual
        }
        check wifi-works {
            statement """
                nmcli connects to WiFi from a TTY, and nm-tray-2 then connects from the desktop and reconnects after a suspend
                """
            method manual
        }
    }
    depends_on [
        @legeos.decision.live-iso-runs-the-provisioner,
        @legeos.decision.three-package-tiers,
        @legeos.work.reference-machine-provisioning
    ]
    derived_from [
        @legeos.observation.this-machines-partition-table-cannot-hold-legeos-as-it-stands
    ]
    part_of [ @legeos.milestone.developer-edition-0-1 ]
}

record legeos.work.session-lock-client/1 : work {
    title "Drive the compositor's ext-session-lock-v1 so Lifecycle1.Lock stops returning NotSupported"
    state proposed
    scope [
        path "compositor/lege-comp/src/session_lock.rs",
        path "crates/lege-types/src/provider.rs",
        path "services/lege-sessiond/src/apis/lifecycle.rs"
    ]
    intent """
        Make locking the session actually lock it. The compositor implements ext-session-lock-v1 in full (compositor/lege-comp/src/session_lock.rs) and ADR-0010 makes the lock screen compositor-owned, "one provider by construction". What has never existed is anything that drives it: no client calls lock(), so there is no lock surface and no lock. Lifecycle1.Lock is declared with the interface shape settled and returns NotSupported rather than reporting a success it did not achieve. Making it real means giving lege-sessiond a Wayland lock-manager client, which is a substantial piece of work and was scoped out of the foundations deliberately rather than overlooked.
        """
    note """
        Two known limitations to resolve or record while doing this. The compositor's own module doc states that input isolation while locked is only partial: src/input.rs refuses recovery keybindings and window drags while locked, but ordinary pointer and keyboard events are still routed by Smithay's normal focus resolution, which does not yet exclude ordinary windows. A hostile client cannot unlock the session through that gap — only unlock() clears the flag — but a sighted user could in principle still interact with content behind the lock surface. Tightening hit-testing to resolve only lock surfaces while locked is named there as the follow-up and belongs with this work.

        Second, ProviderRole::LockScreen exists in the exclusive-role enum and no application declares it. Decide whether sessiond claims that role or whether the compositor-owned lock makes the role vacuous, because one-provider-per-role is a live constraint and leaving a role permanently unfilled is a fact worth recording either way.
        """
    depends_on [ @legeos.decision.compositor-on-smithay ]
    part_of [ @legeos.work.home-widgets ]
}

record legeos.work.sessiond-persistence-and-launch/1 : work {
    title "The session daemon: one state store, StartTransientUnit launching, desktop-entry import, the full domain surface"
    state completed
    scope [
        path "crates/lege-appd/**",
        path "crates/lege-associationd/**",
        path "crates/lege-session-core/**",
        path "crates/lege-state/src/migrations/session.rs",
        path "services/lege-sessiond/**"
    ]
    intent """
        Wire lege-sessiond to the one state store so every domain survives a restart (associations, provider selections and declarations, autostart approvals, settings values and their change log, projects, history, live instances re-derived from ListUnitsByPatterns app-legeos-*); replace the systemd-run launcher with a direct StartTransientUnit D-Bus transaction so launch and unit registration are one step and the documented registration race disappears; derive manifests from installed desktop entries with Exec field codes parsed into an argument vector; detect MIME types from shared-mime-info globs and bounded content sniffing so a detected type genuinely beats an extension; and serve the remaining domains — the full Associations surface with Explain, Settings, History with Undo, Providers, Projects, Power, Location, and org.freedesktop.Notifications recorded as history events — plus the autostart runner, the checkpoint relay and coredump ingestion.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

record legeos.work.shared-incremental-file-index/1 : work {
    title "One persistent incremental file index shared by LegeOS, FSearch and Silvaview-rs"
    state proposed
    scope [
        path "apps/lege-files/**",
        path "cli/lege/**",
        path "crates/**",
        path "distro/forks/**",
        path "docs/architecture/files.md",
        path "docs/planning/**",
        path "interfaces/dbus/**",
        path "services/lege-filed/**",
        path "session/units/user/lege-filed.service",
        path "shell/lege-shell/**"
    ]
    intent """
        Replace the interim independent lege-filed and FSearch databases with one per-user derived file index owned by lege-filed. Extract a pure Rust index core; store rebuildable entries separately from authoritative session state; add lossless paths, stable best-effort filesystem identity, atomic generations, honest root freshness, Linux monitoring, direct file-operation mutations, downtime/overflow reconciliation, indexed substring search, paging, a sealed bulk snapshot, a bounded change stream, diagnostics and CLI access. Keep Files.Search1 as a compatibility facade while adding org.legeos.Files.Index1. Fork FSearch as a remote-index UI with no scanner, watches or fsearch.db in the LegeOS build. Adapt Silvaview-rs to obtain a consistent snapshot and project it through its existing tree builder, retaining its direct MFT/jwalk scanners only as explicit fallback and future non-LegeOS ingestion backends.
        """
    note """
        Plan of record: docs/planning/shared-incremental-file-index.md. It is based on the current LegeOS search implementation, the sibling Silvaview-rs scanner/tree boundary, installed FSearch 0.2.3, and upstream FSearch inspected at 05ed650ab101ee3d61795fa5eeeb5c32e1e366c3. Silvaview-rs changes live in the sibling repository and therefore cannot be represented by this repository's path scope.
        """
    acceptance {
        check consumers-share-the-index {
            statement """
                LegeOS Files search, the LegeOS FSearch fork and Silvaview service mode consume the same index generation; the FSearch build owns no watches or fsearch.db and Silvaview service mode performs no recursive filesystem enumeration.
                """
            method manual
        }
        check incremental-and-honest-freshness {
            statement """
                Filesystem and lege-filed operation changes appear incrementally; downtime, overflow, offline roots and partial scans reconcile without discarding the prior committed generation, and every response exposes generation and freshness.
                """
            method command
            command "cargo test -p lege-file-index -p lege-filed"
        }
        check one-owner-and-warm-start {
            statement """
                Exactly one per-user LegeOS process owns filesystem watches and the derived database, and restarting any search client or Silvaview does not synchronously rescan a previously indexed root before useful results appear.
                """
            method command
            command "cargo test -p lege-file-index -p lege-filed"
        }
        check scale-and-lossless-paths {
            statement """
                A two-million-entry fixture is complete rather than capped, warm searches meet the recorded latency target, bulk snapshot transfer is bounded, and non-UTF-8 Unix paths survive search, snapshot and file action round trips.
                """
            method command
            command "cargo test -p lege-file-index --release"
        }
    }
    part_of [ @legeos.work.application-integration-interim ]
}

record legeos.work.standalone-file-manager/1 : work {
    title "Standalone Files — service-backed browsing, operations and properties in an installable manager"
    state superseded
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "apps/lege-files/**",
        path "crates/lege-client/**",
        path "debian/**",
        path "distro/**",
        path "docs/architecture/files.md",
        path "interfaces/dbus/org.legeos.Files.*",
        path "scripts/**",
        path "services/lege-filed/**",
        path "session/**",
        path "shell/lege-shell/**"
    ]
    intent """
        Build `lege-files` as a first-party Pixelkit application and Debian package. It opens a real XDG folder, shows service-provided places and mounted drives with space state, lists immediate children in the filed-owned folder-first natural order, supports mouse and keyboard selection/navigation/history, and opens files only through Associations1 and Launcher1. Selection workflows provide rename, copy/cut/paste, trash, undo and a persistent properties/storage inspector; filesystem mutations run only through journalled Files.Operations1. Add any bounded Browse1 metadata/root methods needed by both Home and the standalone manager, validate unsafe operation requests in the service, wire the desktop file, app manifest, source package, seeds, cargo-deb build and reinstall helper, and cover the state/contract/package paths with tests.
        """
    acceptance {
        check brokered-open {
            statement """
                Opening a non-directory resolves it through Associations1 and launches it through Launcher1; the manager never executes an association or file path itself.
                """
            method command
            command "cargo test -p lege-files brokered_open"
        }
        check installable-manager {
            statement """
                The workspace and source-package metadata install /usr/bin/lege-files and its desktop entry, all packaging checks pass, and cargo-deb produces the package included by the desktop seed and reinstall helper.
                """
            method command
            command "cargo run -q -p xtask -- check-packaging && cargo deb -q -p lege-files"
        }
        check keyboard-pointer-parity {
            statement """
                Every primary row/toolbar operation is reachable by pointer and by keyboard accelerators, with safe modal confirmation for name-changing actions and trash remaining undoable.
                """
            method command
            command "cargo test -p lege-files interaction"
        }
        check operations-and-properties {
            statement """
                Rename, copy, cut/move, paste, trash and undo serialize to the journalled Operations1 contract, unsafe path/name requests are refused by filed, operation progress is visible, and selection properties include filesystem metadata plus containing-volume state.
                """
            method command
            command "cargo test -p lege-files -p lege-filed operation"
        }
        check real-browsing {
            statement """
                The standalone manager renders service-backed XDG places, relevant mounted drives with capacity state, and real bounded directory entries; navigation, history, hidden-file toggle, selection and stale-response handling are covered.
                """
            method command
            command "cargo test -p lege-files browser"
        }
        check workspace-quality {
            statement """
                Formatting, warnings-denied clippy, the full workspace tests and interface/proxy/asset/packaging structural checks pass.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && cargo run -q -p xtask -- tree-check deps-check check-interfaces check-proxies check-packaging check-assets"
        }
    }
    depends_on [ @legeos.decision.forks-by-manifest ]
    implements [
        @legeos.constraint.identity-and-launch-safety,
        @legeos.constraint.one-provider-per-role,
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
    part_of [ @legeos.milestone.m2-session-runs ]
    acknowledged true
}

