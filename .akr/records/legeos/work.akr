record legeos.work.wallpaper-rust-implementation/1 : work {
    title "Rust wallpaper implementation and isolated runtime evidence"
    state completed
    scope [
        path "apps/templar-settings/**",
        path "cli/templar/**",
        path "compositor/templar-comp/**",
        path "crates/templar-wallpaper/**",
        path "docs/measurements/wallpaper-rust-20261006.json",
        path "docs/planning/low-memory-wallpaper-switcher.md",
        path "services/templar-sessiond/**",
        path "shell/templar-shell/**"
    ]
    intent """
        Deliver the Rust implementation and isolated runtime proof under the low-memory-wallpaper-switcher plan. This child covers implemented Rust policy/decoder/WuDP, native indexed pixels and settings surfaces, observed lifecycle boundaries and compatibility contracts. It does not complete the parent physical-display, matched-Variety or full quantizer-comparison release gates.
        """
    acceptance {
        check compatibility {
            statement """
                Real X11 MIT-SHM and RGB565 PutImage fallback display pixels and owned replacements reclaim prior resources. A private real layer-shell owner displays sizing/reduced sources and release starvation stays bounded. Real portal inspection reports owner limitations honestly, and an observed stalled initialization now exits at the declared finite deadline rather than hanging; no owner acceptance is reported as verified presentation.
                """
            method observation
            verified_by [ @legeos.evidence.wallpaper-compat-runtime/1 ]
        }
        check controls {
            statement """
                Real startup/restart, non-UTF-8 sources, manual controls, opt-in 300-second automatic rotation and actual Appearance controls/readback operate through shared desired/applied policy state on an owned private bus.
                """
            method observation
            verified_by [ @legeos.evidence.wallpaper-native-runtime/1 ]
        }
        check lifecycle {
            statement """
                Across 100 isolated native changes workers are reaped, source mappings return to zero and descriptor counts remain unchanged; malformed/stale/disconnected or impossible-overlap candidates cannot replace last good pixels. Real protected-session protocol preserves protected pixels, releases explicitly disabled textures and publishes unlock activity without unrelated polling or input.
                """
            method observation
            verified_by [ @legeos.evidence.wallpaper-native-runtime/1 ]
        }
        check native-pixels {
            statement """
                An isolated native renderer visibly presents RGBA and R8-plus-palette without a full RGBA indexed mirror, all six sizing modes and original geometry on an explicitly reduced texture. Home reveals the applied wallpaper and restores solid theme ground when unavailable/disabled.
                """
            method observation
            verified_by [ @legeos.evidence.wallpaper-native-runtime/1 ]
        }
        check rust-core {
            statement """
                Substantive recovered WuDP pipeline is implemented in bounded deterministic Rust with direct indexed output; quantization remains opt-in. Actual Rust PNG/JPEG/WebP workers, all eight JPEG orientations in RGBA/indexed form, inadequate budgets and malformed input exercise the real sealed-FD process path.
                """
            method observation
            verified_by [ @legeos.evidence.wallpaper-rust-core/1 ]
        }
    }
    part_of [ @legeos.work.low-memory-wallpaper-switcher ]
    author "dk"
    source {
        kind internal
        path "docs/planning/low-memory-wallpaper-switcher.md"
        excerpt """
            Rust implementation and isolated observations; full release gates remain proposed.
            """
    }
}

record legeos.work.watcher-recovery-durable-and-ordered-20260909/1 : work {
    title "P1 — a failed apply queues a repair, and a repair does not run until the invalidation it answers has settled"
    state superseded
    scope [
        path "crates/lege-file-index/src/coalesce.rs",
        path "services/lege-filed/src/watcher.rs"
    ]
    intent """
        services/lege-filed/src/watcher.rs step (~287-295) takes a coalesced batch, and if Index::apply fails it logs a warning and the batch is gone: no repair is queued, and the root can claim Current forever. The same step pops a repair immediately, so an overflow repair can run while its Invalidate mutation is still below the coalescer deadline; applying that older invalidation after the repair re-stales the root with nothing queued. Changes: on a failed apply, mark the affected roots stale and queue a root repair, with no tight retry on a permanent failure; before running a repair, either flush the coalescer's pending mutations for that root or drop invalidations the repair supersedes, so recovery is complete when it says it is. Tests: real WatchLoop tests with the fake clock covering overflow then settle, and an injected apply failure, rather than core tests that apply the invalidation by hand before repairing.
        """
    note """
        Astra rank P1, implement first. Coalescer semantics live in crates/lege-file-index/src/coalesce.rs; a take-for-root or supersede helper there is smaller than special-casing in the loop.
        """
    acceptance {
        check apply-failure-repairs {
            statement """
                A WatchLoop test with an injected apply failure ends with the root stale and a repair queued, and does not spin when the failure persists.
                """
            method command
            command "cargo test -p lege-filed watcher"
            verified_by [ @legeos.evidence.effectiveness-1-scoped-tests-20260909/1 ]
        }
        check overflow-then-settle {
            statement """
                A fake-clock WatchLoop test: overflow, repair, then the coalescer deadline passes; the root is Current afterwards and no stale invalidation lands late.
                """
            method command
            command "cargo test -p lege-filed watcher"
            verified_by [ @legeos.evidence.effectiveness-1-scoped-tests-20260909/1 ]
        }
    }
    derived_from [
        @legeos.assessment.astra-memory-polling-indexing-review-20260909#watcher-ordering
    ]
    part_of [ @legeos.work.memory-polling-indexing-effectiveness-20260909 ]
}

