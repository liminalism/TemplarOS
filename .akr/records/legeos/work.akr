        made the bar claim a zone of zero, and @legeos.work.the-bottom-edge-belongs-to-the-window-20260908
        replaced the conditional with WindowRecord::covers_screen() (crates/lege-window/src/service.rs:119,
        used by has_frame at :770-776), so a maximized window is frameless unconditionally rather than
        conditionally. The recorded acceptance commands still pass against current code and nothing here
        is broken — only the narrative is two records behind the architecture.
        """
    acceptance {
        check chrome-and-input {
            statement """
                A name-tag press moves and focuses, a control-tag press acts, a press in the gap falls through to the window beneath, a frameless window offers no tags, hidden windows draw nothing.
                """
            method command
            command "cargo test -p lege-comp"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check gate-green {
            statement """
                just check passes with the compositor change.
                """
            method command
            command "just check"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check geometry-and-service {
            statement """
                tag_strip is the bottom strip; client_area sits above it and frame_around inverts it; repair keeps the strip on an output; has_frame is false for a maximized window only while a bottom zone is claimed; every corner resizes.
                """
            method command
            command "cargo test -p lege-window"
            verified_by [ @legeos.evidence.bottom-bar-tags-app-groups-gate-20260907/1 ]
        }
        check hands-on-confirmation {
            statement """
                After logout: a sized kitty shows its name tag bottom-left and park/maximize/close bottom-right, moves by the name tag, resizes from every edge and corner; a maximized kitty shows no tags while the bar is up and shows them when the shell is killed.
                """
            method manual
        }
    }
    implements [ @legeos.decision.one-persistent-bottom-bar-tags-not-bands ]
    part_of [ @legeos.work.home-surface-usability-next ]
    supersedes [ @legeos.work.window-tags-replace-the-band/3 ]
    author "dk"
}

