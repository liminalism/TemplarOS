record legeos.work.homegarden-visible-previews-and-tab-counts-20261007/1 : work {
    title "Home-only visible window previews and truthful per-window application tab counts"
    state proposed
    scope [
        path "compositor/templar-comp/src/backend/**",
        path "compositor/templar-comp/src/screencopy.rs",
        path "compositor/templar-comp/src/space_sync.rs",
        path "crates/templar-client/**",
        path "crates/templar-session-core/**",
        path "crates/templar-window/**",
        path "distro/policy/**",
        path "docs/planning/homegarden-previews-notifications-window-tabs.md",
        path "interfaces/**",
        path "services/templar-sessiond/**",
        path "shell/templar-shell/**"
    ]
    intent """
        Implement Homegarden current-work window previews only where their card wells are visible, and accurate per-OS-window application-tab badges. Plan: docs/planning/homegarden-previews-notifications-window-tabs.md section1. Reuse trusted-shell standard capture; retain existing work-card identity, positions and actions. Default live1fps with off/static options and existing max4fps/512px bounds. Derive demand per output from visible clipped card wells, not all toplevels; stop hidden requests, offscreen rendering/readback and preview deadlines; generation-fence pending work at visibility changes and lock. Add a bounded aggregate memory/work policy, resource reuse, fair visible updates and unchanged-content suppression. Remove preview request and bitmap painting from bar/Alt-Tab/Taskfield while preserving icon/title switching. Do not stop normal application work or misreport previewed parked windows as foreground.
        Tab counts are separate event-driven metadata, not captured pixels or process/window counts. Bind count/provenance/generation to the exact compositor toplevel using a credential-checked adapter registration. Deliver Kitty and browser candidate integrations only after proving internal-window to compositor-window mapping with identical-title multiple windows. Keep unsupported counts unknown; no fabricated zero/one, unrestricted remote control, URL/terminal-text export, or title heuristics. The interoperability goal includes other terminals/tabbed applications via their actual APIs, not an unsupported claim of universal introspection. Make the badge available on the Home card and horizontal title tab. Native Wayland/XWayland, VLC video and Photoshop-in-Wine/VM compatibility require separate observations; protected content remains protected.
        """
    note """
        Proposed scope, not implemented. Browser extension windowId alone does not identify a Wayland toplevel; reliable per-window binding is a prerequisite, not deferred acceptance. Home-only removes existing preview pixels from other switcher surfaces by user request; switching functionality remains. The proposed16MiB aggregate budget must count all CPU/GPU/SHM copies and be measured. No claim of video-rate thumbnails or Photoshop availability.
        """
    acceptance {
        check hidden-zero-work {
            statement """
                After a visibility-generation boundary, Home hide, ordinary-window card occlusion, overflow/zoom/offscreen, lock and output disable cause zero new thumbnail captures/renders/readbacks or preview-only wakeups. Queued stale work is retired without rendering; a running frame cannot reschedule or repaint. Close/reveal races release buffers correctly.
                """
            method observation
        }
        check home-only-and-bounded {
            statement """
                Bar, Alt-Tab and Taskfield retain switching/actions but no preview pixels or captures. Measure steady content and20 changing windows: aggregate bounds include every copy, unchanged pixels are not recaptured, visible cards progress fairly, hidden idle has no recurring preview timer.
                """
            method observation
        }
        check tab-identity {
            statement """
                For two same-app windows with equal titles and different tab counts, each badge remains correct through tab creation/close/detach, split-pane changes, park/restore, window destruction and adapter restart. Prove each supported producer binding; unsupported or disconnected metadata is unknown rather than a made-up count. No URLs/terminal text or excess control privileges are needed.
                """
            method observation
        }
        check visible-content {
            statement """
                Real terminal output and browser content update the correct exposed Home work cards, including parked windows with fresh submitted buffers, without raising them or changing MRU/card placement. Document separate native Wayland, XWayland and media results.
                """
            method observation
        }
    }
    derived_from [ @legeos.assessment.desktop-preview-notification-tab-scope-20261007 ]
    author "dk"
}

record legeos.work.host-update-transaction/1 : work {
    title "The host daemon: kernel and driver as one resumable transaction, two boot backends, enforced polkit"
    state superseded
    scope [
        path "crates/lege-hwdetect/**",
        path "distro/deploy/**",
        path "interfaces/dbus/org.legeos.Host.*.xml",
        path "packaging/**",
        path "services/lege-boot-health/**",
        path "services/lege-hostd/**"
    ]
    intent """
        Make lege-hostd able to promote or roll back a kernel and its NVIDIA modules as a pair: the Planned → Downloading → Staging → Verifying → AwaitingReboot → Trial → Promoted|RolledBack|Failed state machine over a durable journal that resumes mid-apt after a restart, with apt run as a child transient unit; a BootManager trait with working systemd-boot and grub backends so ADR-0004's undecided Secure-Boot posture stays a configuration choice rather than a hardcoding; one driver authority that selects a single flavour from detected hardware, verifies the version lock and detects support violations; the storage reserve and its trim order; polkit authorisation checked in the daemon on every privileged method, with the policy and an AppArmor profile shipped; and a lege-boot-health that can actually fail, since it gates boot-complete.target with FailureAction=reboot-force.
        """
    part_of [ @legeos.milestone.m1-session-runtime ]
}

