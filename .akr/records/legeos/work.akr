record legeos.work.desktop-feature-scoping-20261007/1 : work {
    title "Scope Homegarden previews and tab counts, PixelKit notifications, and corner-following decorations"
    state completed
    scope [ path "docs/planning/homegarden-previews-notifications-window-tabs.md" ]
    intent """
        Scope the owner's October7 ideas without implementation or subagents: Homegarden-only visible current-work previews and application tab counts; bottom-right timed notifications using PixelKit and terminal completion producers; four-side nearest-corner title/control tabs with same-corner right angles and opposite-corner options. Record source findings, runtime evidence where reachable, implementation boundaries and acceptance gates in Markdown and AKR. Reconcile the older proposed decoration decision/children instead of leaving contradictory plans. No live-session changes.
        """
    acceptance {
        check corners-scoped {
            statement """
                Record the final-title-visible/controls-hover interpretation, all four sides/corners, horizontal title/right-angle default/opposite option, safe following/latching and layout migration. Reconcile the old proposed decision and four child acceptance contracts through AKR and retain unresolved prototype choices explicitly.
                """
            method observation
            verified_by [ @legeos.evidence.desktop-feature-scope-recorded-20261007/1 ]
        }
        check notifications-scoped {
            statement """
                Record current producer/renderer behavior, an isolated service observation, bottom-right3-5-second policy, PixelKit ownership boundary, terminal job producers and proposed acceptance without claiming visual implementation.
                """
            method observation
            verified_by [ @legeos.evidence.desktop-feature-scope-recorded-20261007/1 ]
        }
        check previews-scoped {
            statement """
                Record existing capture/scheduling paths, strict visible-only/Home-only lifecycle, application tab-count producer/binding prerequisites, compatibility limits and observable acceptance criteria in a Markdown plan and a proposed work record.
                """
            method observation
            verified_by [ @legeos.evidence.desktop-feature-scope-recorded-20261007/1 ]
        }
    }
    author "dk"
}

record legeos.work.desktop-interaction-fixes-20261007/1 : work {
    title "Reliable task clicks, native system-menu controls and name-tab stacking"
    state proposed
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "apps/templar-settings/**",
        path "compositor/COMPOSITOR.md",
        path "compositor/templar-comp/**",
        path "crates/templar-types/**",
        path "crates/templar-window/**",
        path "distro/forks/**",
        path "scripts/build-fork-deb.sh",
        path "shell/templar-shell/**"
    ]
    intent """
        Owner reports 2026-10-07: HomeGarden open tasks need 3rd/4th click; right-swipe Network does nothing; calendar has no date/time editor; name tabs lack the three ordinary stacking choices. Repair single-click event/capture root cause without coarse delay tuning; open the intended nm-tray-2 menu through its provider; reach a fully implemented native date/time/timezone/locale editor from the clock; add explicit Always on top, Normal, Always on bottom to the initial name-tab right-click menu and authoritative window ordering. Retain existing primary title gestures, task/drag/file distinctions, calendar and security layering.
        """
    note """
        Parent integrates three independently owned slices. Shared PixelKit input is a sibling checkout dependency and must be included in native regression/runtime evidence. No live desktop restart/deployment, NetworkManager mutations, clock/timezone/locale change or user service management. Actual privileged date/time writes are only allowed inside an owned OS guest/private filesystem authority; unexercised host permissions remain explicitly reported.
        """
    acceptance {
        check date-time-editor {
            statement """
                Clock widget opens native editable Date & Time settings; real IANA zone database and installed locale/date formats used; manual date/time, zone and automatic-time policies apply through authorized system owners with honest validation/error states. Actual surface and safe system-service interaction observed, with host mutations prohibited.
                """
            method observation
        }
        check home-task-click {
            statement """
                Single click activates the named running HomeGarden task; coalesced release/new press, alternating tasks, drag and focus cancellation do not lose or inherit an activation. Actual owned native UI journey and deterministic behavioral regression observed.
                """
            method observation
        }
        check name-tab-stacking {
            statement """
                Initial name-tab right-click menu exposes all three mutually exclusive stacking modes and changes actual scene order; Normal reverses either, target remains stable and disappearing windows/dismissal do not trigger unrelated drag or focus authority. Native private UI observed and behavioral regressions pass.
                """
            method observation
        }
        check network-menu {
            statement """
                Right-swipe Network opens the actual nm-tray-2 native menu through the intended installed provider, including repeated invocation. No source-only wiring or ignored --popup flag proof.
                """
            method observation
        }
    }
    part_of [ @legeos.work.developer-edition-daily-driver ]
    author "dk"
}

record legeos.work.desktop-polish-20261011/1 : work {
    title "Fullscreen video idle, window tabs, launcher icon, bottom gestures and indexing interference"
    state superseded
    scope [
        path "compositor/COMPOSITOR.md",
        path "compositor/templar-comp-integration/**",
        path "compositor/templar-comp/**",
        path "crates/templar-file-index/**",
        path "crates/templar-session-core/src/settings.rs",
        path "crates/templar-types/src/dbus.rs",
        path "crates/templar-window/src/**",
        path "docs/architecture/compositor-shell.md",
        path "docs/launcher.md",
        path "interfaces/**",
        path "services/templar-filed/**",
        path "shell/templar-shell/src/settings.rs",
        path "shell/templar-shell/src/surface/**"
    ]
    intent """
        Apply the owner's five installed-desktop corrections: monitor sleep is inhibited for fullscreen video playback rather than arbitrary fullscreen applications, paused playback should release inhibition when observable; hide window popup tabs in fullscreen and restore bottom-right corner placement; draw a generic search icon on the launcher button; measure current filed CPU and determine initial indexing versus faulty maintenance, correcting interference; allow a horizontal left swipe along the bottom row to open running windows and right swipe to open System while preserving downward diagonal gestures and keeping launcher activation deliberate. Preserve existing doctor work and the live session; parent alone runs tests, no deployment or logout.
        """
    acceptance {
        check bottom-gestures {
            statement """
                Horizontal bottom-row left/right swipes choose running windows/System, existing diagonal approach works, close rearm and exceptions remain safe; native gate tests pass.
                """
            method command
            command "cargo test -p templar-comp gesture_gate"
        }
        check fullscreen-tabs {
            statement """
                Fullscreen suppresses corner popup tabs and normal windows use bottom-right placement, with native geometry/input tests passing.
                """
            method command
            command "cargo test -p templar-window"
        }
        check index-interference {
            statement """
                Read-only installed CPU/index measurements identify whether initial scanning or maintenance is responsible; implementation fixes and private regressions are recorded without live-session changes.
                """
            method command
            command "cargo test -p templar-filed -p templar-file-index"
        }
        check launcher-icon {
            statement """
                Launcher button uses a visible font-independent search symbol and shell render succeeds.
                """
            method command
            command "templar-shell --render-bar"
        }
        check video-idle {
            statement """
                Fullscreen video playback honors activity inhibition without blanketing fullscreen apps, with paused behavior and protocol limits recorded; native relevant tests pass.
                """
            method command
            command "cargo test -p templar-comp idle"
        }
    }
    author "dk"
}

record legeos.work.desktop-polish-20261011/2 : work {
    title "Desktop video idle, tabs, launcher gestures, indexing and notification activation"
    state superseded
    scope [
        path "compositor/COMPOSITOR.md",
        path "compositor/templar-comp-integration/**",
        path "compositor/templar-comp/**",
        path "crates/templar-file-index/**",
        path "crates/templar-session-core/src/notifications.rs",
        path "crates/templar-session-core/src/settings.rs",
        path "crates/templar-types/src/dbus.rs",
        path "crates/templar-types/src/launcher.rs",
        path "crates/templar-window/src/**",
        path "docs/architecture/compositor-shell.md",
        path "docs/architecture/files.md",
        path "docs/launcher.md",
        path "docs/measurements/desktop-polish-2026-10-11.json",
        path "docs/measurements/desktop-polish-20261011/**",
        path "interfaces/**",
        path "services/templar-filed/**",
        path "services/templar-sessiond/src/apis/notifications*",
        path "services/templar-sessiond/src/background/notification_provider.rs",
        path "shell/templar-shell/src/settings.rs",
        path "shell/templar-shell/src/surface/**"
    ]
    intent """
        Apply the owner's desktop corrections: monitor sleep is inhibited for fullscreen video playback rather than arbitrary fullscreen applications, paused playback should release inhibition when observable; hide window popup tabs in fullscreen and restore bottom-right corner placement; draw a generic search icon on the launcher button; measure current filed CPU and determine initial indexing versus faulty maintenance, correcting interference; allow a horizontal left swipe along the bottom row to open running windows and right swipe to open System while preserving downward diagonal gestures and keeping launcher activation deliberate; make notification bodies clickable so a terminal notification brings its terminal window forward while preserving declared notification actions. Preserve existing doctor work and the live session; parent alone runs tests, no deployment or logout.
        """
    acceptance {
        check bottom-gestures {
            statement """
                Horizontal bottom-row left/right swipes choose running windows/System, existing diagonal approach works, close rearm and exceptions remain safe; native gate tests pass.
                """
            method command
            command "cargo test -p templar-comp gesture_gate"
        }
        check fullscreen-tabs {
            statement """
                Fullscreen suppresses corner popup tabs and normal windows use bottom-right placement, with native geometry/input tests passing.
                """
            method command
            command "cargo test -p templar-window"
        }
        check index-interference {
            statement """
                Read-only installed CPU/index measurements identify whether initial scanning or maintenance is responsible; implementation fixes and private regressions are recorded without live-session changes.
                """
            method command
            command "cargo test -p templar-filed -p templar-file-index"
        }
        check launcher-icon {
            statement """
                Launcher button uses a visible font-independent search symbol and shell render succeeds.
                """
            method command
            command "templar-shell --render-bar"
        }
        check notification-activation {
            statement """
                Clicking a notification invokes the declared default action or activates its existing source application window, including a terminal, with native regressions for ownership and click dispatch.
                """
            method command
            command "cargo test -p templar-shell -p templar-session-core -p templar-sessiond"
        }
        check video-idle {
            statement """
                Fullscreen video playback honors activity inhibition without blanketing fullscreen apps, with paused behavior and protocol limits recorded; native relevant tests pass.
                """
            method command
            command "cargo test -p templar-comp idle"
        }
    }
    supersedes [ @legeos.work.desktop-polish-20261011/1 ]
    author "dk"
}

