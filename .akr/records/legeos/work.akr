record legeos.work.unified-launcher-homegarden-20261009/1 : work {
    title "Unify global launcher, Homegarden, gesture rail favorites and Essence window transitions"
    state superseded
    scope [
        path "apps/templar-settings/**",
        path "compositor/templar-comp/**",
        path "crates/templar-effects/**",
        path "crates/templar-session-core/**",
        path "crates/templar-types/**",
        path "distro/**",
        path "services/templar-sessiond/**",
        path "shell/templar-shell/**"
    ]
    intent """
        Implement the owner's 2026-10-09 pasted entry, TemplarOS: unifying the launcher, gesture bars, and Homegarden. Homegarden represents working environments, bottom gesture rails navigate them, and one independently focused PixelKit ShellOverlay discovers and opens apps/files. Preserve the shared AppIdentity1/TaskKey/window groups, Index1 native paths and brokered Associations1 opening. Opening never creates a shortcut implicitly. Super+Space, rail search and Home launch shortcut share one popup without revealing Home or disturbing client activation. Apps opens focused with deduplicated favorites/recents, existing ranked search, direct click/Enter, Ctrl+Enter new instance, Tab retains text and toggles Files, Right opens app windows, Escape/outside focus dismiss, fixed size and scrolling. Files uses cancellable generation-fenced SearchSession across all roots by default (explicit Search Here scope), honest paging/freshness, recent blank mode, native file metadata. Context menus explicitly create Home/rail shortcuts, edit metadata aliases, show info and hide results without deleting files; hidden entries restore in Settings. Persistent app and terminal cwd/argv favorites deduplicate running tasks on both bar/gesture rail while preserving first-seen ordering and groups, directory launches use LaunchInDirectoryV1. Retire FSearch routing/provider defaults/fork packaging after replacement exists, keep Index1 and historical evidence. Prune unsupported dock grouping/resources mode, move real Homegarden/rail tuning to Advanced, simplify Settings destinations/duplicate controls and expose only consumed controls. Integrate Essence window transitions into existing compositor GLES scene path with shared plan/reverse, larger 6px grain adjusted through uniforms, tested simple/off/reduced-motion and shader-failure fallbacks; exclude material treatments and preserve rail animation feel.
        """
    note """
        Baseline f8b45b7 preserves all existing uncommitted work. Three exploration agents scoped actual source and jointly read the full broad context, including contradictions/staleness. Planning agent delivered a complete A-D mid-level plan before implementation: immutable source templaros-unified-launcher-implementation-plan-20261009. Root owns host/bridge/search/activation/CLI/ledger/tests, UI agent owns model/screen/Home removal, config agent owns atomic metadata/Settings/rail/retirement, compositor agent owns focus/scene/production GLES Essence. Plan preserves native paths, shared authority and fallback behavior. Current OS is TemplarOS; Lubuntu is recovery only. No live-session deployment/restart/logout. Existing historical physical/installed qualification remains open separately.
        """
    acceptance {
        check favorites {
            statement """
                Persistent app and named terminal-directory profiles appear in launcher and both rails, reconcile running app chips without duplicate launch targets and preserve TaskKey/groups ordering.
                """
            method command
            command "cargo test -p templar-shell; cargo test -p templar-session-core"
        }
        check files-context {
            statement """
                Index1 search is cancellable and generation-fenced with native-path brokered opening, explicit scoped Search Here, context metadata/hide/restore and no FSearch runtime/packaging route.
                """
            method command
            command "cargo test -p templar-shell; cargo xtask check-actions; cargo xtask check-packaging"
        }
        check global-launcher {
            statement """
                One true overlay opens over other/maximized apps without Home reveal; Apps/Files text-preserving Tab, direct click/Enter, explicit new-instance, Escape/outside dismissal and no implicit Home tiles.
                """
            method command
            command "cargo test -p templar-shell; cargo test -p templar-comp"
        }
        check native-gates {
            statement """
                Native targeted regressions, offscreen renders, compositor --check, action/protocol/packaging consistency and AKR validation run with results recorded; installed physical qualification remains explicit.
                """
            method command
            command "cargo fmt --all --check; cargo xtask check-actions; cargo xtask check-interface-signatures; akr validate"
        }
        check settings-effects {
            statement """
                Useful launcher/hidden/favorites controls and Advanced pruning consume typed settings; compositor Essence GLES rendering uses one reversible plan, cheap grain updates and simple/off/reduced-motion/init-failure fallbacks.
                """
            method command
            command "cargo test -p templar-effects -p templar-comp -p templar-session-core -p templar-settings"
        }
    }
    depends_on [
        @legeos.constraint.native-lubuntu-is-the-development-environment,
        @legeos.requirement.unified-launcher-homegarden-20261009
    ]
    implements [ @legeos.decision.the-home-field-is-a-launcher-not-a-search ]
    supersedes [ @legeos.work.index-wp16-provider-adoption-20261008/1 ]
    author "dk"
    source {
        kind internal
        role rationale
        document "templaros-unified-launcher-implementation-plan-20261009"
        use """
            Concrete mid-level implementation plan after all source exploration. Implementation follows its shared APIs, ownership lanes and parent-only validation.
            """
    }
}

