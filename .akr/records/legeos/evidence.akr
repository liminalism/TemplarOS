record legeos.evidence.m1-smoke/1 : evidence {
    title "M1: the integration smoke test passes, and can no longer pass on a broken build"
    state verified
    result pass
    method command
    observed_at git:3a28503b901e356aa341c1d0381bb13be3018ffa
    command "tests/integration/run.sh"
