record legeos.evidence.field-stays-above-the-bar-strip-20260907/1 : evidence {
    title "The field stays above the bar's strip, and a chip's letter is never a slash"
    state verified
    result pass
    method command
    observed_at git:cd2e8621d21088d8517c9bf7d4e342066aac4120
    command "cargo test -p lege-shell the_field_paints_nothing_in_the_bar_strip && cargo test -p lege-shell a_chip_takes_its_letter_from_the_application_and_never_from_punctuation && cargo test -p lege-shell"
    artifact ".agent/scratch/pre-iso-2/bar.png"
    summary """
        Home paints nothing in the bar's 48-pixel strip, and a chip's letter never comes from punctuation. Measured from Lane 1's nested screenshot: three boxes at y 752-782, x 463-725/732-994/1001-1262, each the bottom 31 pixels of a widget tile (body fill, region strip, bottom edge) — tiles placed a row below the document's own grid, which lege_field::cell_rect extrapolates instead of clamping. The new test fails without the clamp with `Rect { x: 196, y: 789, w: 355, h: 155 } in Rect { x: 10, y: 62, w: 1180, h: 728 }`, and 354 lege-shell tests pass with it.
        """
}

