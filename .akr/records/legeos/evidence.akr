record legeos.evidence.d2-archive-verify-20260903/1 : evidence {
    title "D2: archive verification catches mixed sets, missing components, tampered pool files and an unfinished publish"
    state verified
    result pass
    method command
    observed_at git:8b284c9147b70b4f03bb7c48ec993647e2e4df31
    command "cargo test -p lege repo && cargo run -q -p lege -- dev --repo <tmp>/archive repo init && ... repo publish --build-set target/debian/build-set.json && ... repo verify"
    summary """
        `lege dev repo verify` detects the failures it exists for. 31 lege tests pass under the `repo` filter (all pre-existing archive tests plus verify-detects-mixed-set and verify-detects-missing-component, the latter verifying from Matrix::embedded() with no source checkout). End to end in a tempdir archive with real gpg and apt-ftparchive: a real 13-package set published, sets/<id>/debs created with all 13 hard links, verify reported current ok with 13 pins; appending 8 bytes to a pool .deb produced "is 8578088 bytes, but the manifest recorded 8578080" plus "the pool no longer matches Packages" and exit 1; deleting a pool file produced "is gone from the pool"; a hand-written staged marker produced "staged but never became current". Nothing outside the tempdir was touched.
        """
}

record legeos.evidence.d2-source-build-not-executed-20260903/1 : evidence {
