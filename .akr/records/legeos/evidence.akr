record legeos.evidence.index-scale-two-million-20260907/1 : evidence {
    title "The index is complete at two million entries, and warm search stays under a millisecond"
    state verified
    result pass
    method command
    observed_at git:eb00239b41cfcb615f01b34bdb2903ed16f4f51f
    command "cargo run -q -p xtask --release -- index-bench workloads --allow-two-million && cargo test -p lege-file-index --release"
    artifact "docs/measurements/workloads-2m-20260907.json"
    summary """
        A two-million-entry fixture indexed to 2,000,001 entries with complete=true in 31.9s (62,727 entries/s) — complete, not capped. Warm search over the 100k tree is p50 0.25ms, p95 0.30ms, max 0.49ms across 200 samples; a bulk snapshot is 12.2 MB for 90,152 entries in 103ms, so transfer stays bounded. Non-UTF-8 path round trips pass in the release build alongside them.
        """
}

