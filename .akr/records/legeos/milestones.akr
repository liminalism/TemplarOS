record legeos.milestone.m0-initial-structure/1 : milestone {
    title "M0 — Initial project structure of the LegeOS distribution"
    state completed
    scope [ all ]
    intent """
        Create the complete initial repository structure of LegeOS — a tightly integrated desktop OS on an Ubuntu 26.04 LTS core: every component home (crates, services, session, compositor integration, shell, apps, portal, CLI, installer, interfaces, distro/image/packaging, debian, tests, docs, ci), a compiling and tested Rust workspace seeded with the planning-document scaffold code (identity, associations, governor, window geometry), declarative distro configuration pinned to Ubuntu 26.04 'resolute' / kernel 7.0, ADRs for every structural decision, and this ledger.
        """
    target 2026-08-17
    note """
        Stages after M0 (planning doc 01): S1 replacement session on Lubuntu 26.04, S2 own archive + image, S3 hardware/update policy, S4 transactional deployment.
        """
    acceptance {
        check adrs-present {
            statement """
                docs/adr/0001–0011 exist and each structural decision (D1–D11 in the plan) has an ADR and an AKR decision record.
                """
            method observation
            verified_by [ @legeos.evidence.m0-adrs-present/1 ]
        }
        check check-interfaces {
            statement """
                Every org.legeos.* zbus interface in the code has an XML contract in interfaces/dbus/.
                """
            method command
            command "cargo run -q -p xtask -- check-interfaces"
            verified_by [ @legeos.evidence.m0-check-interfaces/1 ]
        }
        check deb-builds {
            statement """
                cargo deb produces a Debian package for lege-sessiond containing the binary, its user unit and the app manifest.
                """
            method command
            command "cargo deb -p lege-sessiond"
            verified_by [ @legeos.evidence.m0-deb-builds/1 ]
        }
        check deps-check {
            statement """
                lege-window has no async runtime or D-Bus in its dependency graph (compositor render-thread rule).
                """
            method command
            command "cargo run -q -p xtask -- deps-check"
            verified_by [ @legeos.evidence.m0-deps-check/1 ]
        }
        check smoke {
            statement """
                Daemons start in dry-run/once mode and lege doctor runs against a fixture root (tests/integration/run.sh).
                """
            method command
            command "tests/integration/run.sh"
            verified_by [ @legeos.evidence.m0-smoke/1 ]
        }
        check tree-check {
            statement """
                Every component home in ARCHITECTURE.md exists and has a README (cargo xtask tree-check).
                """
            method command
            command "cargo run -q -p xtask -- tree-check"
            verified_by [ @legeos.evidence.m0-tree-check/1 ]
        }
        check workspace-builds-and-tests {
            statement """
                cargo fmt --check, cargo clippy --workspace --all-targets -D warnings and cargo test --workspace all pass (unit tests, association/PSI/governor tests, geometry proptests).
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
            verified_by [ @legeos.evidence.m0-workspace-builds-and-tests/1 ]
        }
    }
    source {
        kind external
        role origin
        document "planning-initial-shape"
        use """
            Architecture, stages, and the five claims the first release must prove.
            """
    }
    source {
        kind external
        role origin
        document "planning-subsequent-shape"
        use """
            Workspace layout and the scaffold code for os-types, appd, associationd, resourced and window-service.
            """
    }
}

record legeos.milestone.m1-session-runtime/1 : milestone {
    title "M1 — The session runs: persistent policy, real containment, journalled files, recoverable windows, transactional host"
    state completed
    scope [ all ]
    intent """
        Turn the M0 scaffold into working code: lege-sessiond persists every domain in the one state store and launches applications through systemd StartTransientUnit with desktop-entry import and real MIME detection; lege-resourced serves Resources1, applies protection and containment through a staged ladder with recorded traces; lege-filed runs file operations as resumable journalled transactions with trash, recents, the shared last-directory answer and search; lege-window enforces typed layers, the one-workspace invariant, explicit minimisation and recovery that works without the shell; lege-hostd runs kernel/driver updates as one resumable transaction over two boot backends with polkit enforcement. Stage 1 of planning doc 01: a replacement session, packaged, on an Ubuntu 26.04 base.
        """
    note """
        Scope is what the founding documents specify and what can be verified without NVIDIA hardware, a real compositor or root. Hardware validation (the test matrix), the cosmic-comp fork itself and the shell's toolkit surfaces stay for M2.
        """
    acceptance {
        check check-interfaces {
            statement """
                every org.legeos.* interface implemented in code has an XML contract in interfaces/dbus/ and a client proxy
                """
            method command
            command "cargo run -q -p xtask -- check-interfaces"
            verified_by [ @legeos.evidence.m1-repository-checks/1 ]
        }
        check deps-check {
            statement """
                lege-window still carries no async runtime and no D-Bus dependency, so it can run on the compositor render thread
                """
            method command
            command "cargo run -q -p xtask -- deps-check"
            verified_by [ @legeos.evidence.m1-deps-check/1 ]
        }
        check governor-staged {
            statement """
                the governor defaults to observe-only, records traces sufficient to review a decision, and performs no action above its configured containment stage
                """
            method observation
            verified_by [ @legeos.evidence.m1-governor-staged/1 ]
        }
        check operations-resume {
            statement """
                a file operation interrupted mid-way resumes from its journal without redoing completed work, and never removes a source before the destination is written and verified
                """
            method observation
            verified_by [ @legeos.evidence.m1-operations-resume/1 ]
        }
        check session-persists {
            statement """
                session state survives a restart: associations, provider selections, autostart approvals, settings, projects and history are reloaded from the one state store, and live instances are re-derived from systemd
                """
            method observation
            verified_by [ @legeos.evidence.m1-session-persists/1 ]
        }
        check smoke {
            statement """
                every daemon starts in its dry-run/once mode on a machine with no LegeOS session, and lege doctor runs against a fixture image root
                """
            method command
            command "tests/integration/run.sh"
            verified_by [ @legeos.evidence.m1-smoke/1 ]
        }
        check update-transaction-resumes {
            statement """
                the host update transaction resumes correctly after an interruption in each phase, and promotes or rolls back kernel and driver as a pair, against both boot backends
                """
            method observation
            verified_by [ @legeos.evidence.m1-update-transaction-resumes/1 ]
        }
        check windows-recoverable {
            statement """
                property tests over generated multi-output topologies show every window stays recoverable across drag, hotplug, scale change and session restore
                """
            method observation
            verified_by [ @legeos.evidence.m1-windows-recoverable/1 ]
        }
        check workspace-builds-and-tests {
            statement """
                cargo fmt, clippy -D warnings (pedantic subset) and the full test suite pass across the workspace, with substantially more tests than M0's 55
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
            verified_by [ @legeos.evidence.m1-final-gate/1 ]
        }
    }
    after [ @legeos.milestone.m0-initial-structure ]
    depends_on [
        @legeos.constraint.first-release-scope,
        @legeos.constraint.identity-and-launch-safety,
        @legeos.constraint.one-provider-per-role,
        @legeos.constraint.packaging-and-render-thread,
        @legeos.constraint.services-not-indicators
    ]
}

record legeos.milestone.m2-session-runs/1 : milestone {
    title "M2 — the session runs: lege-comp on Smithay, graphical greeter and taskbar-free Home Surface"
    state proposed
    scope [
        path "apps/templar-greeter/**",
        path "compositor/**",
        path "crates/templar-window/**",
        path "debian/**",
        path "session/**",
        path "shell/**"
    ]
    intent """
        Make LegeOS reachable by a human. M1 finished the services but nothing drew a pixel, so there was no way to log in. M2 delivers the compositor (lege-comp, built directly on Smithay per ADR-0012 rather than forking cosmic-comp), the greeter (lege-greeter over greetd's JSON IPC, so greetd owns PAM), and a taskbar-free Home Surface on pixelkit. A bare Super tap is the primary route between windows and Home, backed by Home's window/session tiles rather than a permanent dock. The measure of done is a session a person can log into and use, including when the shell is dead: the compositor's recovery band, show-all-windows, fullscreen-escape and the fallback switcher are all reachable from compositor keybindings with no shell running at all.
        """
    note """
        Two things are knowingly not met, named here rather than discovered later. (1) Accessibility: docs/architecture/accessibility.md requires AT-SPI/orca, and pixelkit has no accessibility code or dependency of any kind, so the shell is invisible to a screen reader. Partially mitigated in that compositor recovery is keyboard-reachable without the shell and `lege` exposes everything the shell shows — both of which that document also requires — but the invariant is not met, and an AccessKit adapter (it has an AT-SPI backend) should be a named M3 item. (2) The pixelkit crates are path dependencies to a sibling working tree that has no git remote, so the workspace builds only on a machine with that tree beside it; this must become a pinned git dependency before any release build, and blocks reproducible packaging rather than local development.
        """
    acceptance {
        check greeter-login {
            statement """
                A person types their password into lege-greeter and reaches a Home Surface, with greetd performing the authentication and the greeter linking no authentication code.
                """
            method manual
        }
        check hardware-both-paths {
            statement """
                The session comes up on the real laptop on both the Intel and the NVIDIA path, and tests/hardware/*.toml runs — the matrix M1 wrote but could not execute.
                """
            method manual
        }
        check integration-smoke {
            statement """
                The integration smoke passes, including lege-comp --check constructing every protocol global and binding both its sockets on a machine with no seat and no host compositor.
                """
            method command
            command "tests/integration/run.sh"
        }
        check lints {
            statement """
                Clippy at pedantic with warnings denied, and rustfmt, are clean across the workspace.
                """
            method command
            command "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all -- --check"
        }
        check protocol-surface {
            statement """
                A real Wayland client connecting over the compositor's socket sees every protocol LegeOS's documents promise, and the private lege_shell_v1/lege_recovery_v1 globals are visible only to a client that connected on the trusted-shell socket.
                """
            method command
            command "cargo test -p lege-comp a_client_connects_and_sees_every_advertised_protocol"
        }
        check recovery-without-shell {
            statement """
                With lege-shell killed, show-all-windows, fullscreen-escape and the fallback switcher all still work from compositor keybindings, and every window still carries its recovery band.
                """
            method manual
        }
        check session-installs {
            statement """
                The Debian packages install onto an Ubuntu host and produce a LegeOS entry in the display manager's session list, with every unit's ExecStart binary present — lege doctor reports unit-binaries and compositor-usable passing against the installed root.
                """
            method manual
        }
        check structural-checks {
            statement """
                Every xtask structural check passes; in particular deps-check still shows lege-window free of async runtimes and D-Bus, which is the invariant most at risk once a compositor links it, and check-packaging now ties every unit's ExecStart to a binary some package installs.
                """
            method command
            command "cargo run -q -p xtask -- tree-check deps-check check-interfaces check-proxies check-packaging check-assets"
        }
        check windows-cannot-be-lost {
            statement """
                Dragging a window off-screen and changing the output topology (hotplug, resolution, scale) always leaves every window recoverable, exercised by hand on real hardware in addition to the property tests.
                """
            method manual
        }
        check workspace-tests {
            statement """
                The whole workspace's tests pass, including lege-comp's own and lege-window's eight 2000-case geometry property tests now running against work areas rather than raw output bounds.
                """
            method command
            command "cargo test --workspace"
        }
    }
    after [ @legeos.milestone.m1-session-runtime ]
    depends_on [ @legeos.decision.compositor-on-smithay ]
}
