+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "fsearch_database_preferences_widget.h"
+#include "fsearch.h"
+struct _FsearchDatabasePreferencesWidget { GtkBox parent_instance; };
+G_DEFINE_TYPE(FsearchDatabasePreferencesWidget, fsearch_database_preferences_widget, GTK_TYPE_BOX)
+static void open_settings(GtkButton *button, gpointer data) {
+    const char *argv[] = { "templar-settings", "--page", "index", NULL };
+    g_autoptr(GError) error = NULL;
+    g_autoptr(GSubprocess) process = g_subprocess_newv(argv, G_SUBPROCESS_FLAGS_NONE, &error);
+    if (!process) {
+        GtkWidget *dialog = gtk_message_dialog_new(GTK_WINDOW(gtk_widget_get_toplevel(GTK_WIDGET(button))),
+            GTK_DIALOG_DESTROY_WITH_PARENT, GTK_MESSAGE_ERROR, GTK_BUTTONS_CLOSE, "%s", error->message);
+        gtk_dialog_run(GTK_DIALOG(dialog)); gtk_widget_destroy(dialog);
+    }
+}
+static void fsearch_database_preferences_widget_class_init(FsearchDatabasePreferencesWidgetClass *klass) {}
+static void fsearch_database_preferences_widget_init(FsearchDatabasePreferencesWidget *self) {
+    gtk_orientable_set_orientation(GTK_ORIENTABLE(self), GTK_ORIENTATION_VERTICAL);
+    gtk_box_set_spacing(GTK_BOX(self), 12);
+    GtkWidget *label = gtk_label_new("FSearch uses the shared TemplarOS index. Manage folders and exclusions in Settings → Files.");
+    gtk_label_set_line_wrap(GTK_LABEL(label), TRUE); gtk_label_set_xalign(GTK_LABEL(label), 0);
+    gtk_box_pack_start(GTK_BOX(self), label, FALSE, FALSE, 0);
+    g_autoptr(FsearchDatabaseInfo) info = NULL;
+    g_autoptr(FsearchDatabase) db = fsearch_application_get_db(FSEARCH_APPLICATION_DEFAULT);
+    if (fsearch_database_try_get_database_info(db, &info) == FSEARCH_RESULT_SUCCESS) {
+        g_autoptr(FsearchDatabaseIncludeManager) includes = fsearch_database_info_get_include_manager(info);
+        g_autoptr(GPtrArray) roots = fsearch_database_include_manager_get_includes(includes);
+        for (guint i = 0; i < roots->len; i++) {
+            g_autofree char *path = g_filename_display_name(fsearch_database_include_get_path(g_ptr_array_index(roots, i)));
+            GtkWidget *root = gtk_label_new(path); gtk_label_set_xalign(GTK_LABEL(root), 0);
+            gtk_label_set_selectable(GTK_LABEL(root), TRUE); gtk_box_pack_start(GTK_BOX(self), root, FALSE, FALSE, 0);
+        }
+    }
+    else gtk_box_pack_start(GTK_BOX(self), gtk_label_new("Index folder status is unavailable."), FALSE, FALSE, 0);
+    GtkWidget *button = gtk_button_new_with_label("Open Settings → Files");
+    g_signal_connect(button, "clicked", G_CALLBACK(open_settings), NULL);
+    gtk_box_pack_start(GTK_BOX(self), button, FALSE, FALSE, 0); gtk_widget_show_all(GTK_WIDGET(self));
+}
+FsearchDatabasePreferencesWidget *fsearch_database_preferences_widget_new(FsearchDatabaseIncludeManager *includes,
+    FsearchDatabaseExcludeManager *excludes) { return g_object_new(FSEARCH_DATABASE_PREFERENCES_WIDGET_TYPE, NULL); }
+FsearchDatabaseIncludeManager *fsearch_database_preferences_widget_get_include_manager(FsearchDatabasePreferencesWidget *self) {
+    return fsearch_database_include_manager_new();
+}
+FsearchDatabaseExcludeManager *fsearch_database_preferences_widget_get_exclude_manager(FsearchDatabasePreferencesWidget *self) {
+    return fsearch_database_exclude_manager_new();
+}
+void fsearch_database_preferences_widget_setup_help(FsearchDatabasePreferencesWidget *self, FsearchPreferencesDialog *dialog) {}
diff --git a/src/fsearch_database_remote.c b/src/fsearch_database_remote.c
new file mode 100644
index 0000000..50bad00
--- /dev/null
+++ b/src/fsearch_database_remote.c
@@ -0,0 +1,1199 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Remote distribution backend for upstream FSearch's database API.
+ * Signal/property scaffolding retains upstream Christian Boxdoerfer's implementation.
+ */
+#define G_LOG_DOMAIN "fsearch-database-remote"
+#include <config.h>
+#include "fsearch_database.h"
+#include "fsearch_remote_query.h"
+#include "fsearch_database_include.h"
+#include <json-glib/json-glib.h>
+#include <string.h>
+
+#define INDEX_DEST "org.templaros.Files"
+#define INDEX_PATH "/org/templaros/Files"
+#define INDEX_IFACE "org.templaros.Files.Index1"
+#define PAGE_ROWS 100
+#define MAX_PAGES 32
+
+typedef struct {
+    guint64 entry_id;
+    char *path;
+    gint64 size, mtime;
+    gboolean folder, present;
+} RemoteRow;
+typedef struct {
+    guint offset;
+    GPtrArray *rows;
+    guint64 used;
+} RemotePage;
+typedef struct {
+    guint id, retained, files, folders, shown;
+    guint64 generation, total, tick;
+    gboolean truncated;
+    char *cursor, *freshness;
+    FsearchQuery *query;
+    FsearchRemoteQuery *translation;
+    FsearchDatabaseIndexProperty order;
+    GtkSortType direction;
+    GHashTable *pages, *selected;
+    /* Only a retained-row offset projection for AND; native rows remain in the bounded LRU. */
+    GArray *filtered;
+} RemoteView;
+struct _FsearchDatabase {
+    GObject parent_instance;
+    GFile *file;
+    FsearchDatabaseIncludeManager *include_manager;
+    FsearchDatabaseExcludeManager *exclude_manager;
+    GThread *worker_thread;
+    GMainContext *worker_ctx;
+    GMainLoop *worker_loop;
+    GCancellable *cancellable, *scan_cancellable;
+    GMutex mutex, scan_mutex;
+    GDBusProxy *proxy;
+    GHashTable *views;
+    FsearchDatabaseInfo *info;
+    char *cache_identity, *root_description;
+    GSource *refresh;
+    gint queued;
+    bool disposed, observed;
+};
+G_DEFINE_TYPE(FsearchDatabase, fsearch_database, G_TYPE_OBJECT)
+
+enum { PROP_0, PROP_FILE, PROP_INCLUDE_MANAGER, PROP_EXCLUDE_MANAGER, NUM_PROPERTIES };
+
+static GParamSpec *properties[NUM_PROPERTIES];
+
+typedef enum FsearchDatabaseSignalType {
+    SIGNAL_LOAD_STARTED,
+    SIGNAL_LOAD_FINISHED,
+    SIGNAL_ITEM_INFO_READY,
+    SIGNAL_SAVE_STARTED,
+    SIGNAL_SAVE_FINISHED,
+    SIGNAL_SCAN_STARTED,
+    SIGNAL_SCAN_FINISHED,
+    SIGNAL_SEARCH_STARTED,
+    SIGNAL_SEARCH_FINISHED,
+    SIGNAL_SORT_STARTED,
+    SIGNAL_SORT_FINISHED,
+    SIGNAL_SELECTION_CHANGED,
+    SIGNAL_DATABASE_CHANGED,
+    SIGNAL_DATABASE_PROGRESS,
+    SIGNAL_APPLY_STARTED,
+    SIGNAL_APPLY_FINISHED,
+    SIGNAL_REMOTE_STATUS,
+    NUM_DATABASE_SIGNALS,
+} FsearchDatabaseSignalType;
+
+static guint signals[NUM_DATABASE_SIGNALS];
+
+// region Signaling
+typedef struct FsearchSignalEmitContext {
+    // Weak, so queued emissions can't resurrect a database that's already being disposed
+    GWeakRef db;
+    FsearchDatabaseSignalType type;
+    gpointer arg1;
+    gpointer arg2;
+    gpointer arg3;
+    GDestroyNotify arg1_free_func;
+    GDestroyNotify arg2_free_func;
+    GDestroyNotify arg3_free_func;
+    guint n_args;
+} FsearchSignalEmitContext;
+
+static void
+signal_emit_context_free(FsearchSignalEmitContext *ctx) {
+    if (ctx->arg1_free_func) {
+        g_clear_pointer(&ctx->arg1, ctx->arg1_free_func);
+    }
+    if (ctx->arg2_free_func) {
+        g_clear_pointer(&ctx->arg2, ctx->arg2_free_func);
+    }
+    if (ctx->arg3_free_func) {
+        g_clear_pointer(&ctx->arg3, ctx->arg3_free_func);
+    }
+    g_weak_ref_clear(&ctx->db);
+    g_clear_pointer(&ctx, free);
+}
+
+static FsearchSignalEmitContext *
+signal_emit_context_new(FsearchDatabase *db,
+                        FsearchDatabaseSignalType type,
+                        gpointer arg1,
+                        gpointer arg2,
+                        gpointer arg3,
+                        guint n_args,
+                        GDestroyNotify arg1_free_func,
+                        GDestroyNotify arg2_free_func,
+                        GDestroyNotify arg3_free_func) {
+    FsearchSignalEmitContext *ctx = calloc(1, sizeof(FsearchSignalEmitContext));
+    g_assert(ctx != NULL);
+
+    g_weak_ref_init(&ctx->db, db);
+    ctx->type = type;
+    ctx->arg1 = arg1;
+    ctx->arg2 = arg2;
+    ctx->arg3 = arg3;
+    ctx->n_args = n_args;
+    ctx->arg1_free_func = arg1_free_func;
+    ctx->arg2_free_func = arg2_free_func;
+    ctx->arg3_free_func = arg3_free_func;
+    return ctx;
+}
+
+const char *
+signal_type_to_name(FsearchDatabaseSignalType type) {
+    switch (type) {
+    case SIGNAL_LOAD_STARTED:
+        return "SIGNAL_LOAD_STARTED";
+    case SIGNAL_LOAD_FINISHED:
+        return "SIGNAL_LOAD_FINISHED";
+    case SIGNAL_ITEM_INFO_READY:
+        return "SIGNAL_ITEM_INFO_READY";
+    case SIGNAL_SAVE_STARTED:
+        return "SIGNAL_SAVE_STARTED";
+    case SIGNAL_SAVE_FINISHED:
+        return "SIGNAL_SAVE_FINISHED";
+    case SIGNAL_SCAN_STARTED:
+        return "SIGNAL_SCAN_STARTED";
+    case SIGNAL_SCAN_FINISHED:
+        return "SIGNAL_SCAN_FINISHED";
+    case SIGNAL_SEARCH_STARTED:
+        return "SIGNAL_SEARCH_STARTED";
+    case SIGNAL_SEARCH_FINISHED:
+        return "SIGNAL_SEARCH_FINISHED";
+    case SIGNAL_SORT_STARTED:
+        return "SIGNAL_SORT_STARTED";
+    case SIGNAL_SORT_FINISHED:
+        return "SIGNAL_SORT_FINISHED";
+    case SIGNAL_SELECTION_CHANGED:
+        return "SIGNAL_SELECTION_CHANGED";
+    case SIGNAL_DATABASE_CHANGED:
+        return "SIGNAL_DATABASE_CHANGED";
+    case SIGNAL_DATABASE_PROGRESS:
+        return "SIGNAL_DATABASE_PROGRESS";
+    case SIGNAL_APPLY_STARTED:
+        return "SIGNAL_APPLY_STARTED";
+    case SIGNAL_APPLY_FINISHED:
+        return "SIGNAL_APPLY_FINISHED";
+    case SIGNAL_REMOTE_STATUS:
+        return "SIGNAL_REMOTE_STATUS";
+    case NUM_DATABASE_SIGNALS:
+        return "UNKNOWN";
+    default:
+        g_assert_not_reached();
+    }
+}
