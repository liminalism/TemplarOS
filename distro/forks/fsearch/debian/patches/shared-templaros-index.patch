+/* This fragment is appended to the owned fork, then retained in its Debian patch. */
+static void row_free(RemoteRow *row) { if (row) { g_free(row->path); g_free(row); } }
+static void page_free(RemotePage *page) { if (page) { g_ptr_array_unref(page->rows); g_free(page); } }
+static void view_free(RemoteView *view) {
+    g_free(view->cursor); g_free(view->freshness);
+    g_clear_pointer(&view->query, fsearch_query_unref);
+    g_clear_pointer(&view->translation, fsearch_remote_query_free);
+    g_hash_table_unref(view->pages); g_hash_table_unref(view->selected);
+    g_clear_pointer(&view->filtered, g_array_unref); g_free(view);
+}
+static RemoteView *view_get(FsearchDatabase *self, guint id, gboolean create) {
+    RemoteView *view = g_hash_table_lookup(self->views, GUINT_TO_POINTER(id));
+    if (!view && create) {
+        view = g_new0(RemoteView, 1); view->id = id;
+        view->pages = g_hash_table_new_full(g_direct_hash, g_direct_equal, NULL, (GDestroyNotify)page_free);
+        view->selected = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, (GDestroyNotify)row_free);
+        g_hash_table_insert(self->views, GUINT_TO_POINTER(id), view);
+    }
+    return view;
+}
+static void status(FsearchDatabase *self, guint id, const char *text) {
+    signal_emit(self, SIGNAL_REMOTE_STATUS, GUINT_TO_POINTER(id), g_strdup(text), 2, NULL, g_free);
+    g_debug("view %u: %s", id, text);
+}
+static gboolean named_error(GError *error, const char *name) {
+    if (!error) return FALSE;
+    g_autofree char *remote = g_dbus_error_get_remote_error(error);
+    g_autofree char *suffix = g_strconcat(".", name, NULL);
+    return remote && g_str_has_suffix(remote, suffix);
+}
+static GVariant *index_call(FsearchDatabase *self, const char *method, GVariant *parameters,
+    GCancellable *cancel, GError **error) {
+    if (!self->proxy) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED, "TemplarOS index service is unavailable");
+        return NULL;
+    }
+    /* Sink the arguments once: an RPC may retry, and floating arguments are consumed. */
+    g_autoptr(GVariant) args = parameters ? g_variant_ref_sink(parameters) : NULL;
+    for (guint attempt = 0; attempt < 2; attempt++) {
+        GVariant *reply = g_dbus_proxy_call_sync(self->proxy, method, args,
+            G_DBUS_CALL_FLAGS_NO_AUTO_START, 5000, cancel, error);
+        if (reply || attempt || !named_error(*error, "Busy")) return reply;
+        g_clear_error(error); g_usleep(50000);
+        if (cancel && g_cancellable_set_error_if_cancelled(cancel, error)) return NULL;
+    }
+    return NULL;
+}
+static JsonParser *parse_json(const char *json, GError **error) {
+    JsonParser *parser = json_parser_new();
+    if (!json_parser_load_from_data(parser, json, -1, error)
+        || !JSON_NODE_HOLDS_OBJECT(json_parser_get_root(parser))) {
+        if (!*error) g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Index returned an invalid JSON object");
+        g_object_unref(parser); return NULL;
+    }
+    return parser;
+}
+static char *native_path(JsonObject *wire, GError **error) {
+    const char *encoded = json_object_get_string_member(wire, "bytes_b64");
+    gsize size = 0;
+    g_autofree guchar *bytes = encoded ? g_base64_decode(encoded, &size) : NULL;
+    g_autofree char *canonical = bytes ? g_base64_encode(bytes, size) : NULL;
+    if (!bytes || !size || bytes[0] != '/' || memchr(bytes, 0, size)
+        || g_strcmp0(encoded, canonical)) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Index returned an invalid native path");
+        return NULL;
+    }
+    return g_strndup((char *)bytes, size);
+}
+static RemotePage *decode_page(JsonObject *object, guint offset, GError **error) {
+    if (!json_object_has_member(object, "hits")) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Index page has no rows"); return NULL;
+    }
+    JsonArray *hits = json_object_get_array_member(object, "hits");
+    if (!hits || json_array_get_length(hits) > PAGE_ROWS) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Index page exceeds the requested row bound"); return NULL;
+    }
+    RemotePage *page = g_new0(RemotePage, 1); page->offset = offset;
+    page->rows = g_ptr_array_new_with_free_func((GDestroyNotify)row_free);
+    for (guint i = 0; i < json_array_get_length(hits); i++) {
+        JsonObject *hit = json_array_get_object_element(hits, i);
+        JsonObject *wire = json_object_get_object_member(hit, "row");
+        JsonObject *path = wire ? json_object_get_object_member(wire, "path") : NULL;
+        if (!path) { g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Index row has no native path"); page_free(page); return NULL; }
+        RemoteRow *row = g_new0(RemoteRow, 1);
+        row->path = native_path(path, error);
+        if (!row->path) { row_free(row); page_free(page); return NULL; }
+        row->entry_id = json_object_get_int_member(wire, "entry_id");
+        row->folder = json_object_get_int_member(wire, "kind") == 1;
+        JsonNode *size_node = json_object_get_member(wire, "size_bytes");
+        JsonNode *time_node = json_object_get_member(wire, "mtime_ns");
+        row->size = size_node && JSON_NODE_HOLDS_VALUE(size_node) ? json_node_get_int(size_node) : 0;
+        row->mtime = time_node && JSON_NODE_HOLDS_VALUE(time_node) ? json_node_get_int(time_node) / 1000000000 : 0;
+        row->present = json_object_get_boolean_member(hit, "present");
+        g_ptr_array_add(page->rows, row);
+    }
+    return page;
+}
+static void cache_page(RemoteView *view, RemotePage *page) {
+    page->used = ++view->tick;
+    g_hash_table_replace(view->pages, GUINT_TO_POINTER(page->offset / PAGE_ROWS), page);
+    if (g_hash_table_size(view->pages) > MAX_PAGES) {
+        GHashTableIter iter; gpointer key, value, victim = NULL; guint64 oldest = G_MAXUINT64;
+        g_hash_table_iter_init(&iter, view->pages);
+        while (g_hash_table_iter_next(&iter, &key, &value)) {
+            RemotePage *candidate = value;
+            if (candidate->used < oldest) { oldest = candidate->used; victim = key; }
+        }
+        g_hash_table_remove(view->pages, victim);
+    }
+}
+static RemoteRow *row_get(FsearchDatabase *self, RemoteView *view, guint index,
+    gboolean fetch, GCancellable *cancel, GError **error) {
+    if (!view->cursor || index >= view->retained) return NULL;
+    guint offset = index - index % PAGE_ROWS;
+    RemotePage *page = g_hash_table_lookup(view->pages, GUINT_TO_POINTER(offset / PAGE_ROWS));
+    if (!page && fetch) {
+        g_autoptr(GVariant) reply = index_call(self, "FetchPage", g_variant_new("(suu)", view->cursor, offset, PAGE_ROWS), cancel, error);
+        if (!reply) return NULL;
+        const char *text; g_variant_get(reply, "(&s)", &text);
+        g_autoptr(JsonParser) parser = parse_json(text, error);
+        if (!parser) return NULL;
+        JsonObject *object = json_node_get_object(json_parser_get_root(parser));
+        if ((guint64)json_object_get_int_member(object, "generation") != view->generation
+            || g_strcmp0(json_object_get_string_member(object, "cursor"), view->cursor)
+            || json_object_get_int_member(object, "offset") != offset) {
+            g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Index cursor/page generation mismatch"); return NULL;
+        }
+        if (json_object_get_int_member(object, "dropped") > 0) {
+            g_dbus_error_set_dbus_error(error, INDEX_IFACE ".Error.SnapshotRequired", "Pinned rows changed", NULL);
+            return NULL;
+        }
+        page = decode_page(object, offset, error);
+        if (!page) return NULL;
+        cache_page(view, page);
+    }
+    if (!page || index - offset >= page->rows->len) return NULL;
+    page->used = ++view->tick;
+    return g_ptr_array_index(page->rows, index - offset);
+}
+static guint remote_index(RemoteView *view, guint index) {
+    return view->filtered ? g_array_index(view->filtered, guint, index) : index;
+}
+static FsearchDatabaseEntry *entry_from_row(RemoteRow *row) {
+    g_autofree char *directory = g_path_get_dirname(row->path);
+    g_autofree char *name = g_path_get_basename(row->path);
+    if (!strcmp(row->path, "/")) {
+        FsearchDatabaseEntry *root = db_entry_new(DATABASE_INDEX_PROPERTY_FLAG_DEFAULT, "/", NULL,
+            DATABASE_ENTRY_TYPE_FOLDER);
+        db_entry_set_size(root, row->size); db_entry_set_mtime(root, row->mtime);
+        return root;
+    }
+    FsearchDatabaseEntry *parent = db_entry_new(DATABASE_INDEX_PROPERTY_FLAG_NAME, directory, NULL, DATABASE_ENTRY_TYPE_FOLDER);
+    FsearchDatabaseEntry *entry = db_entry_new(DATABASE_INDEX_PROPERTY_FLAG_DEFAULT, name, parent,
+        row->folder ? DATABASE_ENTRY_TYPE_FOLDER : DATABASE_ENTRY_TYPE_FILE);
+    db_entry_set_size(entry, row->size); db_entry_set_mtime(entry, row->mtime);
+    return entry;
+}
+static FsearchDatabaseEntryInfo *row_info(RemoteView *view, RemoteRow *row, guint index,
+    FsearchDatabaseEntryInfoFlags flags) {
+    FsearchDatabaseEntry *entry = entry_from_row(row);
+    /* Highlights are display-only. Native action paths are copied before freeing the entry. */
+    FsearchDatabaseEntryInfo *info = fsearch_database_entry_info_new(entry, NULL, index,
+        g_hash_table_contains(view->selected, &row->entry_id), flags);
+    db_entry_free_full(entry); return info;
+}
+static FsearchDatabaseSearchInfo *search_info(RemoteView *view) {
+    if (!view->query) return NULL;
+    guint files = 0, folders = 0; GHashTableIter iter; gpointer value;
+    g_hash_table_iter_init(&iter, view->selected);
+    while (g_hash_table_iter_next(&iter, NULL, &value)) { RemoteRow *row = value; if (row->folder) folders++; else files++; }
+    FsearchDatabaseSearchInfo *info = fsearch_database_search_info_new(view->id, view->query,
+        view->files, view->folders, files, folders, view->order, view->direction, !view->truncated);
+    fsearch_database_search_info_set_remote_count(info, view->shown);
+    return info;
+}
+static void close_cursor(FsearchDatabase *self, const char *cursor) {
+    if (!cursor || !self->proxy) return;
+    g_autoptr(GError) error = NULL;
+    g_autoptr(GVariant) reply = g_dbus_proxy_call_sync(self->proxy, "CloseCursor", g_variant_new("(s)", cursor),
+        G_DBUS_CALL_FLAGS_NO_AUTO_START, 250, NULL, &error);
+}
+
+static RemoteRow *row_copy(RemoteRow *row) {
+    RemoteRow *copy = g_memdup2(row, sizeof *row); copy->path = g_strdup(row->path); return copy;
+}
+static void select_row(RemoteView *view, RemoteRow *row) {
+    if (!row->present) return;
+    guint64 *key = g_new(guint64, 1); *key = row->entry_id;
+    g_hash_table_replace(view->selected, key, row_copy(row));
+}
+static gboolean refresh_cb(gpointer data);
+static void schedule_refresh(FsearchDatabase *self) {
+    if (self->refresh || g_cancellable_is_cancelled(self->cancellable)) return;
+    self->refresh = g_timeout_source_new(250);
+    g_source_set_callback(self->refresh, refresh_cb, self, NULL);
+    g_source_attach(self->refresh, self->worker_ctx);
+}
+static void proxy_signal(GDBusProxy *proxy, const char *sender, const char *signal, GVariant *args, gpointer data) {
+    FsearchDatabase *self = data;
+    if (!strcmp(signal, "GenerationAdvanced") || !strcmp(signal, "RootStateChanged")) schedule_refresh(self);
+}
+static void proxy_owner(GObject *proxy, GParamSpec *property, gpointer data) {
+    FsearchDatabase *self = data; self->observed = FALSE; schedule_refresh(self);
+}
+static gboolean ensure_proxy(FsearchDatabase *self, GError **error) {
+    if (self->proxy && self->observed) return TRUE;
+    if (!self->proxy) {
+    self->proxy = g_dbus_proxy_new_for_bus_sync(G_BUS_TYPE_SESSION,
+        G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START | G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES,
+        NULL, INDEX_DEST, INDEX_PATH, INDEX_IFACE, self->cancellable, error);
+    if (!self->proxy) return FALSE;
+    g_signal_connect(self->proxy, "g-signal", G_CALLBACK(proxy_signal), self);
+    g_signal_connect(self->proxy, "notify::g-name-owner", G_CALLBACK(proxy_owner), self);
+    }
+    g_autoptr(GVariant) reply = index_call(self, "Observe", g_variant_new("(bt)", TRUE, (guint64)1), self->cancellable, error);
+    /* Keep the proxy on an unavailable owner: its owner notification drives recovery. */
+    self->observed = reply != NULL;
+    return self->observed;
+}
+static guint count_member(JsonObject *object, const char *name) {
+    JsonNode *node = json_object_get_member(object, name);
+    if (!node || !JSON_NODE_HOLDS_VALUE(node)) return 0;
+    gint64 value = json_node_get_int(node);
+    return value < 0 ? 0 : MIN((guint64)value, G_MAXUINT32);
+}
+static gboolean load_roots(FsearchDatabase *self, GCancellable *cancel, GError **error) {
+    if (!ensure_proxy(self, error)) return FALSE;
+    g_autoptr(GVariant) reply = index_call(self, "Roots", NULL, cancel, error);
+    if (!reply) return FALSE;
+    const char *text; g_variant_get(reply, "(&s)", &text);
+    g_autoptr(JsonParser) parser = parse_json(text, error);
+    if (!parser) return FALSE;
+    JsonObject *object = json_node_get_object(json_parser_get_root(parser));
+    g_free(self->cache_identity);
+    self->cache_identity = g_strdup(json_object_get_string_member(object, "cache_identity"));
+    g_autoptr(GString) description = g_string_new("Shared TemplarOS index");
+    g_autoptr(FsearchDatabaseIncludeManager) includes = fsearch_database_include_manager_new();
+    JsonArray *roots = json_object_get_array_member(object, "roots");
+    guint64 entries = 0;
+    for (guint i = 0; roots && i < json_array_get_length(roots); i++) {
+        JsonObject *root = json_array_get_object_element(roots, i);
+        entries = MIN(entries + count_member(root, "entry_count"), G_MAXUINT32);
+        const char *encoded = json_object_get_string_member(root, "path_b64");
+        gsize len; g_autofree guchar *bytes = g_base64_decode(encoded ? encoded : "", &len);
+        if (!len || bytes[0] != '/' || memchr(bytes, 0, len)) continue;
+        g_autofree char *path = g_strndup((char *)bytes, len);
+        g_autofree char *display = g_filename_display_name(path);
+        const char *state = json_object_get_string_member(root, "state");
+        JsonNode *offline_node = json_object_get_member(root, "offline_reason");
+        JsonObject *offline_obj = offline_node && JSON_NODE_HOLDS_OBJECT(offline_node) ? json_node_get_object(offline_node) : NULL;
+        const char *offline = offline_obj ? json_object_get_string_member_with_default(offline_obj, "kind", "") : "";
+        g_string_append_printf(description, " · %s: %s%s%s", display, state ? state : "unknown",
+            offline && *offline ? " / " : "", offline ? offline : "");
+        g_autoptr(FsearchDatabaseInclude) include = fsearch_database_include_new(path, TRUE, TRUE, FALSE, FALSE, 0);
+        fsearch_database_include_manager_add(includes, include);
+    }
+    g_free(self->root_description); self->root_description = g_string_free(g_steal_pointer(&description), FALSE);
+    g_set_object(&self->include_manager, includes);
+    g_clear_pointer(&self->info, fsearch_database_info_unref);
+    /* Empty Search intentionally returns no matches. Roots owns the global count;
+       its absent per-kind split must not be invented as all files or all folders. */
+    self->info = fsearch_database_info_new(includes, self->exclude_manager, 0, 0);
+    fsearch_database_info_set_num_entries(self->info, entries);
+    return TRUE;
+}
+static void announce_view(FsearchDatabase *self, RemoteView *view) {
+    g_autofree char *counts = view->translation && view->translation->filtered
+        ? g_strdup_printf("%u retained of %" G_GUINT64_FORMAT " needle matches · AND filtered within first %u: %u matches",
+            view->retained, view->total, view->retained, view->shown)
+        : g_strdup_printf("%u retained of %" G_GUINT64_FORMAT " matches", view->retained, view->total);
+    g_autofree char *message = g_strdup_printf("Generation %" G_GUINT64_FORMAT " · %s · %s",
+        view->generation, counts, view->freshness ? view->freshness : "Shared TemplarOS index");
+    status(self, view->id, message);
+}
+static RemoteView *view_new(guint id) {
+    RemoteView *view = g_new0(RemoteView, 1); view->id = id;
+    view->pages = g_hash_table_new_full(g_direct_hash, g_direct_equal, NULL, (GDestroyNotify)page_free);
+    view->selected = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, (GDestroyNotify)row_free);
+    return view;
+}
+static gboolean run_search_once(FsearchDatabase *self, guint id, FsearchQuery *query,
+    FsearchDatabaseIndexProperty order, GtkSortType direction, GCancellable *cancel, gboolean preserve, gboolean retry) {
+    RemoteView *old = view_get(self, id, FALSE);
+    RemoteView *next = view_new(id);
+    next->query = fsearch_query_ref(query); next->order = order; next->direction = direction;
+    g_autoptr(GError) error = NULL;
+    g_autoptr(GVariant) reply = NULL;
+    g_autoptr(JsonParser) parser = NULL;
+    g_autoptr(GString) freshness = NULL;
+    next->translation = fsearch_remote_query_translate(query, order, direction, id, &error);
+    if (!next->translation || !ensure_proxy(self, &error)) goto failed;
+    reply = index_call(self, "Search", g_variant_new("(s)", next->translation->json), cancel, &error);
+    if (!reply) goto failed;
+    const char *text, *cursor; guint64 generation;
+    g_variant_get(reply, "(&st&s)", &cursor, &generation, &text);
+    next->cursor = g_strdup(cursor); next->generation = generation;
+    parser = parse_json(text, &error);
+    if (!parser) goto failed;
+    JsonObject *object = json_node_get_object(json_parser_get_root(parser));
+    if (generation != (guint64)json_object_get_int_member(object, "generation")
+        || strcmp(cursor, json_object_get_string_member(object, "cursor"))) {
+        g_set_error_literal(&error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Index Search identity mismatch"); goto failed;
+    }
+    next->total = json_object_get_int_member(object, "total");
+    next->retained = count_member(object, "retained"); next->shown = next->retained;
+    next->files = count_member(object, "total_files"); next->folders = count_member(object, "total_folders");
+    JsonArray *result_roots = json_object_get_array_member(object, "roots");
+    freshness = g_string_new("Shared TemplarOS index");
+    for (guint r = 0; result_roots && r < json_array_get_length(result_roots); r++) {
+        JsonObject *root = json_array_get_object_element(result_roots, r);
+        const char *display = json_object_get_string_member(root, "display");
+        const char *state = json_object_get_string_member(root, "state");
+        const char *metadata = json_object_get_string_member(root, "metadata");
+        g_string_append_printf(freshness, " · %s: %s / metadata %s", display ? display : "folder",
+            state ? state : "unknown", metadata ? metadata : "unknown");
+        JsonNode *offline = json_object_get_member(root, "offline_reason");
+        if (offline && JSON_NODE_HOLDS_OBJECT(offline)) {
+            const char *reason = json_object_get_string_member_with_default(json_node_get_object(offline), "kind", "unknown");
+            g_string_append_printf(freshness, " / %s", reason);
+        }
+    }
+    next->freshness = g_string_free(g_steal_pointer(&freshness), FALSE);
+    next->truncated = json_object_get_boolean_member(object, "truncated");
+    RemotePage *first = decode_page(object, 0, &error);
+    if (!first) goto failed;
+    cache_page(next, first);
+    if (next->translation->filtered) {
+        next->filtered = g_array_sized_new(FALSE, FALSE, sizeof(guint), next->retained);
+        next->files = next->folders = 0;
+    }
+    gboolean has_selection = preserve && old && g_hash_table_size(old->selected);
+    if (next->filtered || has_selection) {
+        for (guint i = 0; i < next->retained; i++) {
+            if (g_cancellable_set_error_if_cancelled(cancel, &error)) goto failed;
+            RemoteRow *row = row_get(self, next, i, TRUE, cancel, &error);
+            if (!row) {
+                if (!error) g_set_error_literal(&error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Retained index row is missing");
+                goto failed;
+            }
+            if (next->filtered) {
+                if (!fsearch_remote_query_accepts(next->translation, row->path)) continue;
+                g_array_append_val(next->filtered, i);
+                if (row->folder) next->folders++; else next->files++;
+            }
+            if (has_selection && g_hash_table_contains(old->selected, &row->entry_id)) select_row(next, row);
+        }
+        if (next->filtered) next->shown = next->filtered->len;
+    }
+    if (g_cancellable_set_error_if_cancelled(cancel, &error)) goto failed;
+    if (old) close_cursor(self, old->cursor);
+    g_hash_table_replace(self->views, GUINT_TO_POINTER(id), next);
+    announce_view(self, next);
+    return TRUE;
+failed:
+    close_cursor(self, next->cursor); g_clear_pointer(&next->cursor, g_free);
+    if (error && (g_error_matches(error, G_IO_ERROR, G_IO_ERROR_CANCELLED) || named_error(error, "Cancelled"))) { view_free(next); return FALSE; }
+    if (retry && named_error(error, "SnapshotRequired")) {
+        view_free(next);
+        return run_search_once(self, id, query, order, direction, cancel, preserve, FALSE);
+    }
+    g_autofree char *message = g_strdup_printf("TemplarOS index: %s%s", error ? error->message : "query failed",
+        preserve && old ? " · previous results are stale" : "");
+    status(self, id, message);
+    if (preserve && old) { g_hash_table_remove_all(old->selected); view_free(next); }
+    else {
+        if (old) close_cursor(self, old->cursor);
+        g_hash_table_replace(self->views, GUINT_TO_POINTER(id), next);
+    }
+    return TRUE; /* publish the empty/error state, so the UI ends its pending search */
+}
+static gboolean run_search(FsearchDatabase *self, guint id, FsearchQuery *query,
+    FsearchDatabaseIndexProperty order, GtkSortType direction, GCancellable *cancel, gboolean preserve) {
+    return run_search_once(self, id, query, order, direction, cancel, preserve, TRUE);
+}
+static gboolean refresh_cb(gpointer data) {
+    FsearchDatabase *self = data;
+    g_clear_pointer(&self->refresh, g_source_unref);
+    g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->mutex);
+    g_autoptr(GError) error = NULL;
+    if (load_roots(self, self->cancellable, &error)) signal_emit_database_changed(self, fsearch_database_info_ref(self->info));
+    /* A search replaces its value, so collect ids rather than invalidating a hash iterator. */
+    g_autoptr(GArray) ids = g_array_new(FALSE, FALSE, sizeof(guint));
+    GHashTableIter iter; gpointer value;
+    g_hash_table_iter_init(&iter, self->views);
+    while (g_hash_table_iter_next(&iter, NULL, &value)) { guint id = ((RemoteView *)value)->id; g_array_append_val(ids, id); }
+    for (guint i = 0; i < ids->len && !g_cancellable_is_cancelled(self->cancellable); i++) {
+        guint id = g_array_index(ids, guint, i); RemoteView *view = view_get(self, id, FALSE);
+        if (!view->query) continue;
+        g_autoptr(FsearchQuery) query = fsearch_query_ref(view->query);
+        if (run_search(self, id, query, view->order, view->direction, self->cancellable, TRUE))
+            signal_emit_search_finished(self, id, search_info(view_get(self, id, FALSE)));
+    }
+    return G_SOURCE_REMOVE;
+}
+static void modify_selection(FsearchDatabase *self, FsearchDatabaseWork *work, GCancellable *cancel) {
+    guint id = fsearch_database_work_get_view_id(work); RemoteView *view = view_get(self, id, FALSE);
+    if (!view || !view->query) return;
+    FsearchSelectionType type = fsearch_database_work_modify_selection_get_type(work);
+    gint64 begin = fsearch_database_work_modify_selection_get_start_idx(work);
+    gint64 end = fsearch_database_work_modify_selection_get_end_idx(work);
+    if (type == FSEARCH_SELECTION_TYPE_CLEAR || type == FSEARCH_SELECTION_TYPE_ALL || type == FSEARCH_SELECTION_TYPE_SELECT
+        || type == FSEARCH_SELECTION_TYPE_SELECT_RANGE) g_hash_table_remove_all(view->selected);
+    if (type == FSEARCH_SELECTION_TYPE_ALL || type == FSEARCH_SELECTION_TYPE_INVERT) { begin = 0; end = (gint64)view->shown - 1; }
+    else if (type == FSEARCH_SELECTION_TYPE_SELECT || type == FSEARCH_SELECTION_TYPE_TOGGLE) end = begin;
+    if (begin > end) { gint64 tmp = begin; begin = end; end = tmp; }
+    if (type != FSEARCH_SELECTION_TYPE_CLEAR) {
+        begin = MAX(begin, 0); end = MIN(end, (gint64)view->shown - 1);
+        for (gint64 i = begin; i <= end; i++) {
+            g_autoptr(GError) error = NULL;
+            RemoteRow *row = row_get(self, view, remote_index(view, i), TRUE, cancel, &error);
+            if (!row) {
+                /* An incomplete selection must never expose a partial native action set. */
+                g_hash_table_remove_all(view->selected);
+                if (named_error(error, "SnapshotRequired")) schedule_refresh(self);
+                if (error && !g_error_matches(error, G_IO_ERROR, G_IO_ERROR_CANCELLED)
+                    && !named_error(error, "Cancelled")) status(self, id, error->message);
+                break;
+            }
+            if (type == FSEARCH_SELECTION_TYPE_INVERT || type == FSEARCH_SELECTION_TYPE_TOGGLE
+                || type == FSEARCH_SELECTION_TYPE_TOGGLE_RANGE) {
+                if (g_hash_table_remove(view->selected, &row->entry_id)) continue;
+            }
+            select_row(view, row);
+        }
+    }
+    signal_emit_selection_changed(self, search_info(view));
+}
+static void cancel_forward(GCancellable *source, gpointer data) { g_cancellable_cancel(data); }
+typedef struct { FsearchDatabase *self; FsearchDatabaseWork *work; } WorkWrapper;
+static void wrapper_free(WorkWrapper *wrapper) {
+    g_atomic_int_add(&wrapper->self->queued, -1); fsearch_database_work_unref(wrapper->work); g_free(wrapper);
+}
+static gboolean handle_work(gpointer data) {
+    WorkWrapper *wrapper = data; FsearchDatabase *self = wrapper->self; FsearchDatabaseWork *work = wrapper->work;
+    FsearchDatabaseWorkKind kind = fsearch_database_work_get_kind(work);
+    if (kind == FSEARCH_DATABASE_WORK_QUIT) { g_main_loop_quit(self->worker_loop); return G_SOURCE_REMOVE; }
+    g_autoptr(GCancellable) cancel = fsearch_database_work_get_cancellable(work);
+    if (g_cancellable_is_cancelled(cancel) || g_cancellable_is_cancelled(self->cancellable)) return G_SOURCE_REMOVE;
+    gulong hook = g_cancellable_connect(self->cancellable, G_CALLBACK(cancel_forward), g_object_ref(cancel), g_object_unref);
+    g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->mutex);
+    guint id = kind == FSEARCH_DATABASE_WORK_SEARCH || kind == FSEARCH_DATABASE_WORK_SORT
+        || kind == FSEARCH_DATABASE_WORK_GET_ITEM_INFO || kind == FSEARCH_DATABASE_WORK_MODIFY_SELECTION
+        ? fsearch_database_work_get_view_id(work) : 0;
+    switch (kind) {
+    case FSEARCH_DATABASE_WORK_LOAD_FROM_FILE:
+    case FSEARCH_DATABASE_WORK_SCAN:
+    case FSEARCH_DATABASE_WORK_RESCAN:
+    case FSEARCH_DATABASE_WORK_RESCAN_INDEX: {
+        signal_emit0(self, SIGNAL_LOAD_STARTED);
+        gboolean scan = kind != FSEARCH_DATABASE_WORK_LOAD_FROM_FILE;
+        if (scan) signal_emit0(self, SIGNAL_SCAN_STARTED);
+        g_autoptr(GError) error = NULL;
+        gboolean loaded = load_roots(self, cancel, &error);
+        if (loaded && scan && self->cache_identity && *self->cache_identity) {
+            g_autofree char *request = g_strdup_printf("{\"cache_identity\":\"%s\",\"roots\":[]}", self->cache_identity);
+            g_autoptr(GVariant) reply = index_call(self, "Reconcile", g_variant_new("(s)", request), cancel, &error);
+            loaded = reply != NULL;
+        }
+        if (!loaded) status(self, 0, error ? error->message : "Index unavailable");
+        if (!self->info) self->info = fsearch_database_info_new(self->include_manager, self->exclude_manager, 0, 0);
+        signal_emit(self, SIGNAL_LOAD_FINISHED, fsearch_database_info_ref(self->info), NULL, 1,
+            (GDestroyNotify)fsearch_database_info_unref, NULL);
+        if (scan) signal_emit(self, SIGNAL_SCAN_FINISHED, fsearch_database_info_ref(self->info), NULL, 1,
+            (GDestroyNotify)fsearch_database_info_unref, NULL);
+        break;
+    }
+    case FSEARCH_DATABASE_WORK_SEARCH: {
+        g_autoptr(FsearchQuery) query = fsearch_database_work_search_get_query(work);
+        signal_emit(self, SIGNAL_SEARCH_STARTED, GUINT_TO_POINTER(id), NULL, 1, NULL, NULL);
+        if (run_search(self, id, query, fsearch_database_work_search_get_sort_order(work),
+            fsearch_database_work_search_get_sort_type(work), cancel, FALSE))
+            signal_emit_search_finished(self, id, search_info(view_get(self, id, FALSE)));
+        break;
+    }
+    case FSEARCH_DATABASE_WORK_SORT: {
+        RemoteView *view = view_get(self, id, FALSE);
+        if (!view || !view->query) break;
+        g_autoptr(FsearchQuery) query = fsearch_query_ref(view->query);
+        signal_emit(self, SIGNAL_SORT_STARTED, GUINT_TO_POINTER(id), NULL, 1, NULL, NULL);
+        if (run_search(self, id, query, fsearch_database_work_sort_get_sort_order(work),
+            fsearch_database_work_sort_get_sort_type(work), cancel, TRUE))
+            signal_emit_sort_finished(self, id, search_info(view_get(self, id, FALSE)));
+        break;
+    }
+    case FSEARCH_DATABASE_WORK_GET_ITEM_INFO: {
+        guint index = fsearch_database_work_item_info_get_index(work);
+        RemoteView *view = view_get(self, id, FALSE); FsearchDatabaseEntryInfo *info = NULL;
+        g_autoptr(GError) error = NULL;
+        if (view && index < view->shown) {
+            RemoteRow *row = row_get(self, view, remote_index(view, index), TRUE, cancel, &error);
+            if (row) info = row_info(view, row, index, fsearch_database_work_item_info_get_flags(work));
+            else if (named_error(error, "SnapshotRequired")) schedule_refresh(self);
+            else if (error) status(self, id, error->message);
+        }
+        signal_emit_item_info_ready(self, id, index, info);
+        break;
+    }
+    case FSEARCH_DATABASE_WORK_MODIFY_SELECTION: modify_selection(self, work, cancel); break;
+    case FSEARCH_DATABASE_WORK_NOTIFY_ITEMS_REMOVED: schedule_refresh(self); break;
+    case FSEARCH_DATABASE_WORK_SAVE_TO_FILE:
+        signal_emit0(self, SIGNAL_SAVE_STARTED); signal_emit0(self, SIGNAL_SAVE_FINISHED); break;
+    case FSEARCH_DATABASE_WORK_SCAN_FINISHED:
+    case FSEARCH_DATABASE_WORK_RESCAN_INDEX_FINISHED: break; /* no local scan producers are built */
+    default: break;
+    }
+    g_cancellable_disconnect(self->cancellable, hook);
+    return G_SOURCE_REMOVE;
+}
+static gpointer database_worker_thread(gpointer data) {
+    FsearchDatabase *self = data;
+    g_main_context_push_thread_default(self->worker_ctx);
+    g_main_loop_run(self->worker_loop);
+    if (self->refresh) { g_source_destroy(self->refresh); g_clear_pointer(&self->refresh, g_source_unref); }
+    /* Bounded teardown even when there are many windows. Service disconnect also releases cursors. */
+    gint64 deadline = g_get_monotonic_time() + 2000000;
+    GHashTableIter iter; gpointer value; g_hash_table_iter_init(&iter, self->views);
+    while (g_get_monotonic_time() < deadline && g_hash_table_iter_next(&iter, NULL, &value))
+        close_cursor(self, ((RemoteView *)value)->cursor);
+    if (self->proxy) {
+        g_autoptr(GError) error = NULL;
+        g_autoptr(GVariant) reply = g_dbus_proxy_call_sync(self->proxy, "Observe", g_variant_new("(bt)", FALSE, (guint64)1),
+            G_DBUS_CALL_FLAGS_NO_AUTO_START, 250, NULL, &error);
+    }
+    g_main_context_pop_thread_default(self->worker_ctx); return NULL;
+}
+static void fsearch_database_constructed(GObject *object) {
+    FsearchDatabase *self = FSEARCH_DATABASE(object);
+    G_OBJECT_CLASS(fsearch_database_parent_class)->constructed(object);
+    if (!self->include_manager) self->include_manager = fsearch_database_include_manager_new();
+    if (!self->exclude_manager) self->exclude_manager = fsearch_database_exclude_manager_new();
+    self->worker_thread = g_thread_new("FSearchIndex", database_worker_thread, self);
+}
+static void fsearch_database_dispose(GObject *object) {
+    FsearchDatabase *self = FSEARCH_DATABASE(object);
+    if (!self->disposed) {
+        self->disposed = TRUE; g_cancellable_cancel(self->cancellable);
+        fsearch_database_cancel_scan(self);
+        g_autoptr(FsearchDatabaseWork) quit = fsearch_database_work_new_quit();
+        fsearch_database_queue_work(self, quit);
+        if (self->worker_thread) g_thread_join(g_steal_pointer(&self->worker_thread));
+        g_clear_pointer(&self->worker_loop, g_main_loop_unref);
+        g_clear_pointer(&self->worker_ctx, g_main_context_unref);
+        g_clear_object(&self->proxy);
+    }
+    G_OBJECT_CLASS(fsearch_database_parent_class)->dispose(object);
+}
+static void fsearch_database_finalize(GObject *object) {
+    FsearchDatabase *self = FSEARCH_DATABASE(object);
+    g_clear_pointer(&self->views, g_hash_table_unref);
+    g_clear_pointer(&self->info, fsearch_database_info_unref);
+    g_clear_object(&self->file); g_clear_object(&self->include_manager); g_clear_object(&self->exclude_manager);
+    g_clear_object(&self->cancellable); g_clear_object(&self->scan_cancellable);
+    g_free(self->cache_identity); g_free(self->root_description);
+    g_mutex_clear(&self->mutex); g_mutex_clear(&self->scan_mutex);
+    G_OBJECT_CLASS(fsearch_database_parent_class)->finalize(object);
+}
+
+static void
+fsearch_database_get_property(GObject *object, guint prop_id, GValue *value, GParamSpec *pspec) {
+    FsearchDatabase *self = FSEARCH_DATABASE(object);
+
+    switch (prop_id) {
+    case PROP_FILE:
+        g_value_set_object(value, self->file);
+        break;
+    case PROP_INCLUDE_MANAGER:
+        g_value_set_object(value, self->include_manager);
+        break;
+    case PROP_EXCLUDE_MANAGER:
+        g_value_set_object(value, self->exclude_manager);
+        break;
+    default:
+        G_OBJECT_WARN_INVALID_PROPERTY_ID(object, prop_id, pspec);
+        break;
+    }
+}
+
+static void
+fsearch_database_set_property(GObject *object, guint prop_id, const GValue *value, GParamSpec *pspec) {
+    FsearchDatabase *self = FSEARCH_DATABASE(object);
+
+    switch (prop_id) {
+    case PROP_FILE:
+        self->file = g_value_dup_object(value);
+        break;
+    case PROP_INCLUDE_MANAGER:
+        self->include_manager = g_value_dup_object(value);
+        break;
+    case PROP_EXCLUDE_MANAGER:
+        self->exclude_manager = g_value_dup_object(value);
+        break;
+    default:
+        G_OBJECT_WARN_INVALID_PROPERTY_ID(object, prop_id, pspec);
+        break;
+    }
+}
+
+static void
+fsearch_database_class_init(FsearchDatabaseClass *klass) {
+    GObjectClass *object_class = G_OBJECT_CLASS(klass);
+
+    object_class->constructed = fsearch_database_constructed;
+    object_class->dispose = fsearch_database_dispose;
+    object_class->finalize = fsearch_database_finalize;
+    object_class->set_property = fsearch_database_set_property;
+    object_class->get_property = fsearch_database_get_property;
+
+    properties[PROP_FILE] = g_param_spec_object("file",
+                                                "File",
+                                                "The file where the database will be loaded from or saved to by "
+                                                "default",
+                                                G_TYPE_FILE,
+                                                G_PARAM_READWRITE | G_PARAM_CONSTRUCT_ONLY | G_PARAM_STATIC_STRINGS);
+    properties[PROP_INCLUDE_MANAGER] = g_param_spec_object("include-manager",
+                                                           "Include Manager",
+                                                           "The list of includes this database is initialized with",
+                                                           FSEARCH_TYPE_DATABASE_INCLUDE_MANAGER,
+                                                           G_PARAM_READWRITE | G_PARAM_CONSTRUCT_ONLY
+                                                               | G_PARAM_STATIC_STRINGS);
+    properties[PROP_EXCLUDE_MANAGER] = g_param_spec_object("exclude-manager",
+                                                           "Exclude Manager",
+                                                           "The list of excludes this database is initialized with",
+                                                           FSEARCH_TYPE_DATABASE_EXCLUDE_MANAGER,
+                                                           G_PARAM_READWRITE | G_PARAM_CONSTRUCT_ONLY
+                                                               | G_PARAM_STATIC_STRINGS);
+
+    g_object_class_install_properties(object_class, NUM_PROPERTIES, properties);
+
+    signals[SIGNAL_LOAD_STARTED] =
+        g_signal_new("load-started", G_TYPE_FROM_CLASS(klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+    signals[SIGNAL_LOAD_FINISHED] = g_signal_new("load-finished",
+                                                 G_TYPE_FROM_CLASS(klass),
+                                                 G_SIGNAL_RUN_LAST,
+                                                 0,
+                                                 NULL,
+                                                 NULL,
+                                                 NULL,
+                                                 G_TYPE_NONE,
+                                                 1,
+                                                 FSEARCH_TYPE_DATABASE_INFO);
+    signals[SIGNAL_SAVE_STARTED] =
+        g_signal_new("save-started", G_TYPE_FROM_CLASS(klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+    signals[SIGNAL_SAVE_FINISHED] =
+        g_signal_new("save-finished", G_TYPE_FROM_CLASS(klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+    signals[SIGNAL_SCAN_STARTED] =
+        g_signal_new("scan-started", G_TYPE_FROM_CLASS(klass), G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+    signals[SIGNAL_SCAN_FINISHED] = g_signal_new("scan-finished",
+                                                 G_TYPE_FROM_CLASS(klass),
+                                                 G_SIGNAL_RUN_LAST,
+                                                 0,
+                                                 NULL,
+                                                 NULL,
+                                                 NULL,
+                                                 G_TYPE_NONE,
+                                                 1,
+                                                 FSEARCH_TYPE_DATABASE_INFO);
+    signals[SIGNAL_SEARCH_STARTED] = g_signal_new("search-started",
+                                                  G_TYPE_FROM_CLASS(klass),
+                                                  G_SIGNAL_RUN_LAST,
+                                                  0,
+                                                  NULL,
+                                                  NULL,
+                                                  NULL,
+                                                  G_TYPE_NONE,
+                                                  1,
+                                                  G_TYPE_UINT);
+    signals[SIGNAL_SEARCH_FINISHED] = g_signal_new("search-finished",
+                                                   G_TYPE_FROM_CLASS(klass),
+                                                   G_SIGNAL_RUN_LAST,
+                                                   0,
+                                                   NULL,
+                                                   NULL,
+                                                   NULL,
+                                                   G_TYPE_NONE,
+                                                   2,
+                                                   G_TYPE_UINT,
+                                                   FSEARCH_TYPE_DATABASE_SEARCH_INFO);
+    signals[SIGNAL_SORT_STARTED] = g_signal_new("sort-started",
+                                                G_TYPE_FROM_CLASS(klass),
+                                                G_SIGNAL_RUN_LAST,
+                                                0,
+                                                NULL,
+                                                NULL,
+                                                NULL,
+                                                G_TYPE_NONE,
+                                                1,
+                                                G_TYPE_UINT);
+    signals[SIGNAL_SORT_FINISHED] = g_signal_new("sort-finished",
+                                                 G_TYPE_FROM_CLASS(klass),
+                                                 G_SIGNAL_RUN_LAST,
+                                                 0,
+                                                 NULL,
+                                                 NULL,
+                                                 NULL,
+                                                 G_TYPE_NONE,
+                                                 2,
+                                                 G_TYPE_UINT,
+                                                 FSEARCH_TYPE_DATABASE_SEARCH_INFO);
+    signals[SIGNAL_DATABASE_PROGRESS] = g_signal_new("database-progress",
+                                                     G_TYPE_FROM_CLASS(klass),
+                                                     G_SIGNAL_RUN_LAST,
+                                                     0,
+                                                     NULL,
+                                                     NULL,
+                                                     NULL,
+                                                     G_TYPE_NONE,
+                                                     1,
+                                                     G_TYPE_STRING);
+    signals[SIGNAL_DATABASE_CHANGED] = g_signal_new("database-changed",
+                                                    G_TYPE_FROM_CLASS(klass),
+                                                    G_SIGNAL_RUN_LAST,
+                                                    0,
+                                                    NULL,
+                                                    NULL,
+                                                    NULL,
+                                                    G_TYPE_NONE,
+                                                    1,
+                                                    FSEARCH_TYPE_DATABASE_INFO);
+    signals[SIGNAL_SELECTION_CHANGED] = g_signal_new("selection-changed",
+                                                     G_TYPE_FROM_CLASS(klass),
+                                                     G_SIGNAL_RUN_LAST,
+                                                     0,
+                                                     NULL,
+                                                     NULL,
+                                                     NULL,
+                                                     G_TYPE_NONE,
+                                                     2,
+                                                     G_TYPE_UINT,
+                                                     FSEARCH_TYPE_DATABASE_SEARCH_INFO);
+    signals[SIGNAL_ITEM_INFO_READY] = g_signal_new("item-info-ready",
+                                                   G_TYPE_FROM_CLASS(klass),
+                                                   G_SIGNAL_RUN_LAST,
+                                                   0,
+                                                   NULL,
+                                                   NULL,
+                                                   NULL,
+                                                   G_TYPE_NONE,
+                                                   3,
+                                                   G_TYPE_UINT,
+                                                   G_TYPE_UINT,
+                                                   FSEARCH_TYPE_DATABASE_ENTRY_INFO);
+    signals[SIGNAL_APPLY_STARTED] = g_signal_new("apply-started",
+                                                 G_TYPE_FROM_CLASS(klass),
+                                                 G_SIGNAL_RUN_LAST,
+                                                 0,
+                                                 NULL,
+                                                 NULL,
+                                                 NULL,
+                                                 G_TYPE_NONE,
+                                                 0);
+    signals[SIGNAL_APPLY_FINISHED] = g_signal_new("apply-finished",
+                                                  G_TYPE_FROM_CLASS(klass),
+                                                  G_SIGNAL_RUN_LAST,
+                                                  0,
+                                                  NULL,
+                                                  NULL,
+                                                  NULL,
+                                                  G_TYPE_NONE,
+                                                  0);
+    signals[SIGNAL_REMOTE_STATUS] = g_signal_new("remote-status", G_TYPE_FROM_CLASS(klass),
+        G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 2, G_TYPE_UINT, G_TYPE_STRING);
+}
+
+static void fsearch_database_init(FsearchDatabase *self) {
+    g_mutex_init(&self->mutex); g_mutex_init(&self->scan_mutex);
+    self->cancellable = g_cancellable_new();
+    self->views = g_hash_table_new_full(g_direct_hash, g_direct_equal, NULL, (GDestroyNotify)view_free);
+    self->worker_ctx = g_main_context_new(); self->worker_loop = g_main_loop_new(self->worker_ctx, FALSE);
+}
+FsearchDatabase *fsearch_database_new(GFile *file, FsearchDatabaseIncludeManager *includes,
+    FsearchDatabaseExcludeManager *excludes) {
+    return g_object_new(FSEARCH_TYPE_DATABASE, "file", file, "include-manager", includes,
+        "exclude-manager", excludes, NULL);
+}
+void fsearch_database_queue_work(FsearchDatabase *self, FsearchDatabaseWork *work) {
+    g_return_if_fail(FSEARCH_IS_DATABASE(self)); g_return_if_fail(work);
+    FsearchDatabaseWorkKind kind = fsearch_database_work_get_kind(work);
+    if (kind != FSEARCH_DATABASE_WORK_QUIT && (g_cancellable_is_cancelled(self->cancellable)
+        || g_atomic_int_get(&self->queued) >= 1024)) {
+        if (!g_cancellable_is_cancelled(self->cancellable)) status(self, fsearch_database_work_get_view_id(work), "Index request queue is busy");
+        if (kind == FSEARCH_DATABASE_WORK_GET_ITEM_INFO) signal_emit_item_info_ready(self,
+            fsearch_database_work_get_view_id(work), fsearch_database_work_item_info_get_index(work), NULL);
+        return;
+    }
+    if (kind == FSEARCH_DATABASE_WORK_SCAN || kind == FSEARCH_DATABASE_WORK_RESCAN || kind == FSEARCH_DATABASE_WORK_RESCAN_INDEX) {
+        g_autoptr(GCancellable) cancel = fsearch_database_work_get_cancellable(work);
+        g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->scan_mutex); g_set_object(&self->scan_cancellable, cancel);
+    }
+    WorkWrapper *wrapper = g_new0(WorkWrapper, 1); wrapper->self = self; wrapper->work = fsearch_database_work_ref(work);
+    g_atomic_int_inc(&self->queued);
+    g_autoptr(GSource) source = g_idle_source_new();
+    g_source_set_priority(source, kind == FSEARCH_DATABASE_WORK_QUIT ? G_PRIORITY_HIGH : G_PRIORITY_DEFAULT);
+    g_source_set_callback(source, handle_work, wrapper, (GDestroyNotify)wrapper_free);
+    g_source_attach(source, self->worker_ctx);
+}
+void fsearch_database_cancel_scan(FsearchDatabase *self) {
+    g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->scan_mutex);
+    if (self->scan_cancellable) g_cancellable_cancel(self->scan_cancellable);
+}
+FsearchResult fsearch_database_try_get_search_info(FsearchDatabase *self, guint id, FsearchDatabaseSearchInfo **out) {
+    *out = NULL;
+    if (!g_mutex_trylock(&self->mutex)) return FSEARCH_RESULT_DB_BUSY;
+    RemoteView *view = view_get(self, id, FALSE);
+    if (view) *out = search_info(view);
+    g_mutex_unlock(&self->mutex);
+    return *out ? FSEARCH_RESULT_SUCCESS : FSEARCH_RESULT_DB_UNKNOWN_SEARCH_VIEW;
+}
+FsearchResult fsearch_database_try_get_database_info(FsearchDatabase *self, FsearchDatabaseInfo **out) {
+    *out = NULL;
+    if (!g_mutex_trylock(&self->mutex)) return FSEARCH_RESULT_DB_BUSY;
+    if (self->info) *out = fsearch_database_info_ref(self->info);
+    g_mutex_unlock(&self->mutex); return *out ? FSEARCH_RESULT_SUCCESS : FSEARCH_RESULT_FAILED;
+}
+FsearchResult fsearch_database_try_get_item_info(FsearchDatabase *self, guint id, guint index,
+    FsearchDatabaseEntryInfoFlags flags, FsearchDatabaseEntryInfo **out) {
+    *out = NULL;
+    if (!g_mutex_trylock(&self->mutex)) return FSEARCH_RESULT_DB_BUSY;
+    RemoteView *view = view_get(self, id, FALSE); FsearchResult result = FSEARCH_RESULT_DB_ENTRY_NOT_FOUND;
+    if (view && index < view->shown) {
+        RemoteRow *row = row_get(self, view, remote_index(view, index), FALSE, NULL, NULL);
+        if (row) { *out = row_info(view, row, index, flags); result = FSEARCH_RESULT_SUCCESS; }
+        else result = FSEARCH_RESULT_DB_BUSY; /* the result view queues GET_ITEM_INFO */
+    }
+    g_mutex_unlock(&self->mutex); return result;
+}
+typedef struct {
+    FsearchDatabase *self;
+    GMutex mutex;
+    GCond condition;
+    gboolean done;
+    FsearchResult result;
+} ReconcileRequest;
+static gboolean reconcile_request(gpointer data) {
+    ReconcileRequest *request = data; FsearchDatabase *self = request->self;
+    FsearchResult result = FSEARCH_RESULT_FAILED;
+    {
+        g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->mutex);
+        g_autoptr(GError) error = NULL;
+        if (load_roots(self, self->cancellable, &error) && self->cache_identity && *self->cache_identity) {
+            g_autofree char *json = g_strdup_printf("{\"cache_identity\":\"%s\",\"roots\":[]}", self->cache_identity);
+            g_autoptr(GVariant) reply = index_call(self, "Reconcile", g_variant_new("(s)", json), self->cancellable, &error);
+            if (reply) result = FSEARCH_RESULT_SUCCESS;
+        }
+    }
+    g_mutex_lock(&request->mutex); request->result = result; request->done = TRUE;
+    g_cond_signal(&request->condition); g_mutex_unlock(&request->mutex);
+    return G_SOURCE_REMOVE;
+}
+FsearchResult fsearch_database_rescan_blocking(FsearchDatabase *self) {
+    /* The explicit CLI blocking API waits, but all Index1 calls remain on the worker. */
+    ReconcileRequest request = { .self = g_object_ref(self), .result = FSEARCH_RESULT_FAILED };
+    g_mutex_init(&request.mutex); g_cond_init(&request.condition);
+    g_autoptr(GSource) source = g_idle_source_new();
+    g_source_set_callback(source, reconcile_request, &request, NULL);
+    g_source_set_priority(source, G_PRIORITY_DEFAULT); g_source_attach(source, self->worker_ctx);
+    g_mutex_lock(&request.mutex);
+    while (!request.done) g_cond_wait(&request.condition, &request.mutex);
+    g_mutex_unlock(&request.mutex);
+    g_mutex_clear(&request.mutex); g_cond_clear(&request.condition); g_object_unref(request.self);
+    return request.result;
+}
+void fsearch_database_selection_foreach(FsearchDatabase *self, guint id, FsearchDatabaseForeachFunc func, gpointer data) {
+    g_return_if_fail(func);
+    /* Selection jobs already fetch every selected retained row on the worker. Copy a coherent
+     * native-path snapshot under the lock, then invoke callbacks without holding database locks. */
+    g_autoptr(GPtrArray) rows = g_ptr_array_new_with_free_func((GDestroyNotify)row_free);
+    g_mutex_lock(&self->mutex); RemoteView *view = view_get(self, id, FALSE);
+    if (view) {
+        GHashTableIter iter; gpointer value; g_hash_table_iter_init(&iter, view->selected);
+        while (g_hash_table_iter_next(&iter, NULL, &value)) g_ptr_array_add(rows, row_copy(value));
+    }
+    g_mutex_unlock(&self->mutex);
+    for (guint i = 0; i < rows->len; i++) {
+        FsearchDatabaseEntry *entry = entry_from_row(g_ptr_array_index(rows, i)); func(entry, data); db_entry_free_full(entry);
+    }
+}
diff --git a/src/fsearch_remote_query.c b/src/fsearch_remote_query.c
new file mode 100644
index 0000000..c1da710
--- /dev/null
+++ b/src/fsearch_remote_query.c
@@ -0,0 +1,223 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * TemplarOS distribution patch: pure Index1 query translation; no filesystem calls.
+ */
+#include "fsearch_remote_query.h"
+#include <errno.h>
+#include <math.h>
+#include <string.h>
+
+static gboolean unsupported(GError **error, const char *feature) {
+    g_set_error(error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+        "%s is not supported in TemplarOS index mode", feature);
+    return FALSE;
+}
+
+static void number(JsonBuilder *builder, const char *name, gint64 value) {
+    json_builder_set_member_name(builder, name);
+    json_builder_add_int_value(builder, value);
+}
+
+/* Returns strictness and leaves value at the first digit. */
+static char comparison(const char **value) {
+    char op = '=';
+    if (**value == '>' || **value == '<' || **value == '=') {
+        op = *(*value)++;
+        if (**value == '=') { (*value)++; if (op == '>') op = 'G'; if (op == '<') op = 'L'; }
+    }
+    return op;
+}
+
+typedef struct { gboolean has_min, has_max; gint64 min, max; } Range;
+static void lower(Range *range, gint64 value) {
+    range->min = range->has_min ? MAX(range->min, value) : value; range->has_min = TRUE;
+}
+static void upper(Range *range, gint64 value) {
+    range->max = range->has_max ? MIN(range->max, value) : value; range->has_max = TRUE;
+}
+static gboolean size_filter(Range *range, const char *value, GError **error) {
+    char op = comparison(&value), *end = NULL;
+    errno = 0;
+    double size = g_ascii_strtod(value, &end);
+    if (value == end || errno || !isfinite(size) || size < 0) goto invalid;
+    double unit = 1;
+    if (*end && g_ascii_strcasecmp(end, "b")) {
+        const char *units[] = {"k", "m", "g", "t"};
+        gboolean matched = FALSE;
+        for (guint i = 0; i < G_N_ELEMENTS(units); i++) {
+            g_autofree char *decimal = g_strconcat(units[i], "b", NULL);
+            g_autofree char *binary = g_strconcat(units[i], "ib", NULL);
+            if (!g_ascii_strcasecmp(end, binary) || !g_ascii_strcasecmp(end, units[i])) {
+                unit = pow(1024.0, i + 1); matched = TRUE; break;
+            }
+            if (!g_ascii_strcasecmp(end, decimal)) {
+                unit = pow(1000.0, i + 1); matched = TRUE; break;
+            }
+        }
+        if (!matched) goto invalid;
+    }
+    size *= unit;
+    if (!isfinite(size) || size >= (double)G_MAXINT64) goto invalid;
+    gint64 bytes = (gint64)floor(size);
+    gint64 ceiling = (gint64)ceil(size);
+    switch (op) {
+        case '>': lower(range, bytes + 1); break;
+        case 'G': lower(range, ceiling); break;
+        case '<':
+            if (!ceiling) lower(range, 1);
+            upper(range, ceiling ? ceiling - 1 : 0); break;
+        case 'L': upper(range, bytes); break;
+        default: lower(range, ceiling); upper(range, bytes); break;
+    }
+    return TRUE;
+invalid:
+    g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid size comparison in TemplarOS index query");
+    return FALSE;
+}
+
+static gboolean date_filter(Range *range, const char *value, GError **error) {
+    char op = comparison(&value);
+    gboolean day = strlen(value) == 10;
+    g_autofree char *iso = day ? g_strconcat(value, "T00:00:00", NULL) : g_strdup(value);
+    g_autoptr(GTimeZone) timezone = g_time_zone_new_local();
+    g_autoptr(GDateTime) date = g_date_time_new_from_iso8601(iso, timezone);
+    if (!date) goto invalid;
+    gint64 seconds = g_date_time_to_unix(date);
+    if (seconds > G_MAXINT64 / 1000000000 || seconds < G_MININT64 / 1000000000) goto invalid;
+    gint64 start = seconds * 1000000000;
+    gint64 micros = g_date_time_get_microsecond(date) * 1000LL;
+    if (start > G_MAXINT64 - micros) goto invalid;
+    start += micros;
+    gint64 end = start;
+    if (day) {
+        g_autoptr(GDateTime) next = g_date_time_add_days(date, 1);
+        gint64 after = g_date_time_to_unix(next);
+        if (after > G_MAXINT64 / 1000000000) goto invalid;
+        end = after * 1000000000 - 1;
+    }
+    switch (op) {
+        case '>': if (end == G_MAXINT64) goto invalid; lower(range, end + 1); break;
+        case 'G': lower(range, start); break;
+        case '<': if (start == G_MININT64) goto invalid; upper(range, start - 1); break;
+        case 'L': upper(range, end); break;
+        default: lower(range, start); upper(range, end); break;
+    }
+    return TRUE;
+invalid:
+    g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Invalid modified-date comparison in TemplarOS index query (use ISO8601)");
+    return FALSE;
+}
+
+FsearchRemoteQuery *fsearch_remote_query_translate(FsearchQuery *query,
+    FsearchDatabaseIndexProperty order, GtkSortType direction, guint view, GError **error) {
+    FsearchQueryFlags flags = query->flags | (query->filter ? query->filter->flags : 0);
+    if ((flags & QUERY_FLAG_REGEX) || (flags & QUERY_FLAG_MATCH_CASE) || query->triggers_auto_match_case) {
+        unsupported(error, "Regex or case-sensitive search"); return NULL;
+    }
+    if (flags & QUERY_FLAG_EXACT_MATCH) { unsupported(error, "Exact-only search"); return NULL; }
+    if (flags & QUERY_FLAG_SEARCH_IN_PATH) {
+        unsupported(error, "Search-in-path mode (use a term containing /)"); return NULL;
+    }
+    const char *sort;
+    switch (order) {
+        case DATABASE_INDEX_PROPERTY_NAME: case DATABASE_INDEX_PROPERTY_NONE: sort = "name"; break;
+        case DATABASE_INDEX_PROPERTY_PATH: case DATABASE_INDEX_PROPERTY_PATH_FULL: sort = "path"; break;
+        case DATABASE_INDEX_PROPERTY_SIZE: sort = "size"; break;
+        case DATABASE_INDEX_PROPERTY_MODIFICATION_TIME: sort = "mtime"; break;
+        default: unsupported(error, "This sort order"); return NULL;
+    }
+    g_autofree char *input = g_strjoin(" ", query->search_term ? query->search_term : "",
+        query->filter && query->filter->query ? query->filter->query : "", NULL);
+    if (strlen(input) > 4096) { unsupported(error, "A query above 4096 bytes"); return NULL; }
+    g_auto(GStrv) argv = NULL;
+    gint argc = 0;
+    if (*g_strstrip(input) && !g_shell_parse_argv(input, &argc, &argv, error)) return NULL;
+    if (argc > 64) { unsupported(error, "More than 64 terms"); return NULL; }
+    g_autoptr(FsearchRemoteQuery) result = g_new0(FsearchRemoteQuery, 1);
+    result->terms = g_ptr_array_new_with_free_func(g_free);
+    g_autoptr(JsonBuilder) builder = json_builder_new();
+    json_builder_begin_object(builder);
+    gboolean files = flags & QUERY_FLAG_FILES_ONLY, folders = flags & QUERY_FLAG_FOLDERS_ONLY;
+    gboolean metadata = order == DATABASE_INDEX_PROPERTY_SIZE || order == DATABASE_INDEX_PROPERTY_MODIFICATION_TIME;
+    Range size = {0}, modified = {0};
+    for (gint i = 0; i < argc; i++) {
+        const char *term = argv[i];
+        if (!g_ascii_strcasecmp(term, "AND")) continue;
+        if (!g_ascii_strcasecmp(term, "OR") || !g_ascii_strcasecmp(term, "NOT") || term[0] == '!' || term[0] == '-') {
+            unsupported(error, "Boolean alternatives or exclusions"); return NULL;
+        }
+        if (strpbrk(term, "*?()")) { unsupported(error, "Wildcards or grouping"); return NULL; }
+        if (g_str_has_prefix(term, "file:")) { files = TRUE; term += 5; }
+        else if (g_str_has_prefix(term, "folder:")) { folders = TRUE; term += 7; }
+        else if (g_str_has_prefix(term, "size:")) {
+            if (!size_filter(&size, term + 5, error)) return NULL;
+            metadata = TRUE;
+            continue;
+        }
+        else if (g_str_has_prefix(term, "dm:") || g_str_has_prefix(term, "datemodified:")) {
+            if (!date_filter(&modified, strchr(term, ':') + 1, error)) return NULL;
+            metadata = TRUE;
+            continue;
+        }
+        else if (strchr(term, ':') && !strchr(term, '/')) {
+            unsupported(error, "This query field"); return NULL;
+        }
+        if (*term) {
+            if (result->terms->len && strlen(term) > strlen(g_ptr_array_index(result->terms, result->needle_index)))
+                result->needle_index = result->terms->len;
+            g_ptr_array_add(result->terms, g_strdup(term));
+        }
+    }
+    if (files && folders) { unsupported(error, "Conflicting file/folder filters"); return NULL; }
+    if (files || folders) {
+        json_builder_set_member_name(builder, "kinds"); json_builder_begin_array(builder);
+        if (folders) json_builder_add_string_value(builder, "directory");
+        else { json_builder_add_string_value(builder, "regular"); json_builder_add_string_value(builder, "symlink"); json_builder_add_string_value(builder, "other"); }
+        json_builder_end_array(builder);
+    }
+    if (size.has_min) number(builder, "min_size", size.min);
+    if (size.has_max) number(builder, "max_size", size.max);
+    if (modified.has_min) number(builder, "min_mtime_ns", modified.min);
+    if (modified.has_max) number(builder, "max_mtime_ns", modified.max);
+    json_builder_set_member_name(builder, "text");
+    json_builder_add_string_value(builder, result->terms->len ? g_ptr_array_index(result->terms, result->needle_index) : "");
+    json_builder_set_member_name(builder, "sort"); json_builder_add_string_value(builder, sort);
+    json_builder_set_member_name(builder, "descending"); json_builder_add_boolean_value(builder, direction == GTK_SORT_DESCENDING);
+    json_builder_set_member_name(builder, "include_hidden"); json_builder_add_boolean_value(builder, TRUE);
+    json_builder_set_member_name(builder, "require_metadata");
+    json_builder_add_boolean_value(builder, metadata);
+    g_autofree char *tag = g_strdup_printf("view-%u", view);
+    json_builder_set_member_name(builder, "client_tag"); json_builder_add_string_value(builder, tag);
+    number(builder, "page_size", 100); number(builder, "fields", 255);
+    json_builder_end_object(builder);
+    g_autoptr(JsonNode) root = json_builder_get_root(builder);
+    g_autoptr(JsonGenerator) generator = json_generator_new();
+    json_generator_set_root(generator, root);
+    result->json = json_generator_to_data(generator, NULL);
+    result->filtered = result->terms->len > 1;
+    return g_steal_pointer(&result);
+}
+
+void fsearch_remote_query_free(FsearchRemoteQuery *query) {
+    if (!query) return;
+    g_free(query->json);
+    g_clear_pointer(&query->terms, g_ptr_array_unref);
+    g_free(query);
+}
+
+static char *fold(const char *native) {
+    if (g_utf8_validate(native, -1, NULL)) return g_utf8_casefold(native, -1);
+    return g_ascii_strdown(native, -1);
+}
+
+bool fsearch_remote_query_accepts(FsearchRemoteQuery *query, const char *native_path) {
+    if (!query->filtered) return TRUE;
+    const char *name = strrchr(native_path, '/'); name = name ? name + 1 : native_path;
+    g_autofree char *folded_path = fold(native_path), *folded_name = fold(name);
+    for (guint i = 0; i < query->terms->len; i++) {
+        if (i == query->needle_index) continue;
+        const char *term = g_ptr_array_index(query->terms, i);
+        g_autofree char *needle = fold(term);
+        if (!strstr(strchr(term, '/') ? folded_path : folded_name, needle)) return FALSE;
+    }
+    return TRUE;
+}
diff --git a/src/fsearch_remote_query.h b/src/fsearch_remote_query.h
new file mode 100644
index 0000000..becca2f
--- /dev/null
+++ b/src/fsearch_remote_query.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <json-glib/json-glib.h>
+#include "fsearch_query.h"
+#include "fsearch_database_index_properties.h"
+
+typedef struct {
+    char *json;
+    GPtrArray *terms;
+    guint needle_index;
+    bool filtered;
+} FsearchRemoteQuery;
+
+FsearchRemoteQuery *fsearch_remote_query_translate(FsearchQuery *query,
+    FsearchDatabaseIndexProperty order, GtkSortType direction, guint view, GError **error);
+void fsearch_remote_query_free(FsearchRemoteQuery *query);
+bool fsearch_remote_query_accepts(FsearchRemoteQuery *query, const char *native_path);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC(FsearchRemoteQuery, fsearch_remote_query_free)
diff --git a/src/tests/remote_index_probe.c b/src/tests/remote_index_probe.c
new file mode 100644
index 0000000..2c9e99b
--- /dev/null
+++ b/src/tests/remote_index_probe.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Invoked only by the owned private-daemon integration fixture. */
+#include "fsearch_database.h"
+#include <glib/gstdio.h>
+#include <string.h>
+static FsearchDatabaseSearchInfo *last;
+static FsearchDatabaseEntryInfo *item;
+static char *notice, *selected_path;
+static guint selection_count, native_count, finished_serial;
+static guint loaded_entries;
+static gboolean loaded;
+static void load_finished(FsearchDatabase *db, FsearchDatabaseInfo *info, gpointer data) {
+    loaded_entries = fsearch_database_info_get_num_entries(info); loaded = TRUE;
+}
+static void finished(FsearchDatabase *db, guint id, FsearchDatabaseSearchInfo *info, gpointer data) {
+    finished_serial++;
+    g_clear_pointer(&last, fsearch_database_search_info_unref);
+    if (info) last = fsearch_database_search_info_ref(info);
+}
+static void selected(FsearchDatabase *db, guint id, FsearchDatabaseSearchInfo *info, gpointer data) { finished(db, id, info, data); }
+static void ready(FsearchDatabase *db, guint id, guint index, FsearchDatabaseEntryInfo *info, gpointer data) {
+    g_clear_pointer(&item, fsearch_database_entry_info_unref);
+    if (info) item = fsearch_database_entry_info_ref(info);
+}
+static void status(FsearchDatabase *db, guint id, const char *text, gpointer data) {
+    g_free(notice); notice = g_strdup(text); g_print("status: %s\n", text);
+}
+static void pump(gint64 deadline) {
+    while (g_main_context_iteration(NULL, FALSE));
+    g_assert_cmpint(g_get_monotonic_time(), <, deadline); g_usleep(10000);
+}
+static void wait_info(void) {
+    gint64 deadline = g_get_monotonic_time()+30000000;
+    while (!last) pump(deadline);
+}
+static void search(FsearchDatabase *db, const char *text) {
+    g_clear_pointer(&last, fsearch_database_search_info_unref);
+    g_autoptr(FsearchQuery) query = fsearch_query_new(text, NULL, NULL, 0, "private-probe");
+    g_autoptr(FsearchDatabaseWork) work = fsearch_database_work_new_search(1, query, DATABASE_INDEX_PROPERTY_NAME, GTK_SORT_ASCENDING);
+    fsearch_database_queue_work(db, work); wait_info();
+}
+static void select_work(FsearchDatabase *db, FsearchSelectionType type, guint index) {
+    g_clear_pointer(&last, fsearch_database_search_info_unref);
+    g_autoptr(FsearchDatabaseWork) work = fsearch_database_work_new_modify_selection(1, type, index, index);
+    fsearch_database_queue_work(db, work); wait_info();
+}
+static void each(FsearchDatabaseEntry *entry, gpointer data) {
+    g_autoptr(GString) path = db_entry_get_path_full(entry);
+    selection_count++; if (strchr(path->str, (char)0xff)) native_count++;
+    g_free(selected_path); selected_path = g_strdup(path->str);
+}
+static void page_work(FsearchDatabase *db, guint index) {
+    g_clear_pointer(&item, fsearch_database_entry_info_unref);
+    g_autoptr(FsearchDatabaseWork) work = fsearch_database_work_new_get_item_info(1, index, FSEARCH_DATABASE_ENTRY_INFO_FLAG_ALL);
+    fsearch_database_queue_work(db, work);
+}
+static void fault_tests(FsearchDatabase *db) {
+    search(db, "fault_busy");
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries(last), ==, 201);
+    search(db, "fault_busy_exhaust");
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries(last), ==, 0);
+    g_assert_nonnull(strstr(notice, "Busy"));
+    search(db, "fault_snapshot_search");
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries(last), ==, 201);
+    search(db, "fault_page");
+    guint previous = finished_serial;
+    page_work(db, 200);
+    gint64 deadline = g_get_monotonic_time()+10000000;
+    while (finished_serial == previous) pump(deadline);
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries(last), ==, 201);
+    page_work(db, 200);
+    while (!item) pump(deadline);
+    search(db, "fault_selection");
+    select_work(db, FSEARCH_SELECTION_TYPE_ALL, 0);
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries_selected(last), ==, 0);
+    /* Finish the selection's debounced recovery before isolating cancellation. */
+    deadline = g_get_monotonic_time()+400000;
+    while (g_get_monotonic_time()<deadline) { while (g_main_context_iteration(NULL,FALSE)); g_usleep(1000); }
+    search(db, "fault_unavailable");
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries(last), ==, 0);
+    g_assert_nonnull(strstr(notice, "fixture-offline"));
+    search(db, "fault_normal");
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries(last), ==, 201);
+    g_autofree char *before_cancel = g_strdup(notice);
+    g_autoptr(FsearchQuery) query = fsearch_query_new("fault_cancelled", NULL, NULL, 0, "private-probe");
+    g_autoptr(FsearchDatabaseWork) cancelled = fsearch_database_work_new_search(1, query, DATABASE_INDEX_PROPERTY_NAME, GTK_SORT_ASCENDING);
+    fsearch_database_queue_work(db, cancelled);
+    deadline = g_get_monotonic_time()+200000;
+    while (g_get_monotonic_time()<deadline) { while (g_main_context_iteration(NULL,FALSE)); g_usleep(1000); }
+    g_assert_cmpstr(notice, ==, before_cancel);
+    g_autoptr(FsearchQuery) pre_query = fsearch_query_new("fault_pre_cancelled", NULL, NULL, 0, "private-probe");
+    g_autoptr(FsearchDatabaseWork) pre = fsearch_database_work_new_search(1, pre_query, DATABASE_INDEX_PROPERTY_NAME, GTK_SORT_ASCENDING);
+    fsearch_database_work_cancel(pre); fsearch_database_queue_work(db, pre);
+    search(db, "fault_normal");
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries(last), ==, 201);
+    g_print("PASS typed errors: Busy retry/exhaustion, Search/page SnapshotRequired, atomic selection, Unavailable/recovery, typed and prequeued cancellation\n");
+}
+int main(int argc, char **argv) {
+    g_assert_cmpint(argc, ==, 2);
+    g_autoptr(FsearchDatabaseIncludeManager) includes = fsearch_database_include_manager_new();
+    g_autoptr(FsearchDatabaseExcludeManager) excludes = fsearch_database_exclude_manager_new();
+    g_autoptr(FsearchDatabase) db = fsearch_database_new(NULL, includes, excludes);
+    g_signal_connect(db, "search-finished", G_CALLBACK(finished), NULL);
+    g_signal_connect(db, "sort-finished", G_CALLBACK(finished), NULL);
+    g_signal_connect(db, "selection-changed", G_CALLBACK(selected), NULL);
+    g_signal_connect(db, "item-info-ready", G_CALLBACK(ready), NULL);
+    g_signal_connect(db, "remote-status", G_CALLBACK(status), NULL);
+    g_signal_connect(db, "load-finished", G_CALLBACK(load_finished), NULL);
+    if (!strcmp(argv[1], "--faults")) {
+        fault_tests(db);
+        g_clear_pointer(&last, fsearch_database_search_info_unref);
+        g_clear_pointer(&item, fsearch_database_entry_info_unref);
+        g_free(notice); return 0;
+    }
+    g_autoptr(FsearchDatabaseWork) load = fsearch_database_work_new_load();
+    fsearch_database_queue_work(db, load);
+    gint64 load_deadline = g_get_monotonic_time()+10000000;
+    while (!loaded) pump(load_deadline);
+    g_assert_cmpuint(loaded_entries, >=, 5001);
+    search(db, "file:f");
+    guint rows = fsearch_database_search_info_get_num_entries(last);
+    g_assert_cmpuint(rows, ==, 5001); g_assert_cmpuint(fsearch_database_search_info_get_num_folders(last), ==, 0);
+    g_assert_cmpuint(fsearch_database_search_info_get_num_files(last), ==, 5001);
+    g_clear_pointer(&item, fsearch_database_entry_info_unref);
+    g_autoptr(FsearchDatabaseWork) page = fsearch_database_work_new_get_item_info(1, rows-1, FSEARCH_DATABASE_ENTRY_INFO_FLAG_ALL);
+    fsearch_database_queue_work(db, page);
+    gint64 deadline = g_get_monotonic_time()+10000000; while (!item) pump(deadline);
+    g_assert_true(g_utf8_validate(fsearch_database_entry_info_get_name(item)->str, -1, NULL));
+    select_work(db, FSEARCH_SELECTION_TYPE_ALL, 0);
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries_selected(last), ==, 5001);
+    fsearch_database_selection_foreach(db, 1, each, NULL);
+    g_assert_cmpuint(selection_count, ==, 5001); g_assert_cmpuint(native_count, ==, 1);
+    search(db, "f12-"); g_assert_cmpuint(fsearch_database_search_info_get_num_entries(last), ==, 1);
+    select_work(db, FSEARCH_SELECTION_TYPE_SELECT, 0);
+    g_clear_pointer(&last, fsearch_database_search_info_unref);
+    g_autoptr(FsearchDatabaseWork) sort = fsearch_database_work_new_sort(1, DATABASE_INDEX_PROPERTY_PATH, GTK_SORT_DESCENDING);
+    fsearch_database_queue_work(db, sort); wait_info();
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries_selected(last), ==, 1);
+    selection_count = native_count = 0; fsearch_database_selection_foreach(db, 1, each, NULL);
+    g_assert_cmpuint(native_count, ==, 1);
+    g_autofree char *old_notice = g_strdup(notice);
+    g_autofree char *new_path = g_strconcat(argv[1], "/f12-renamed-\xff.txt", NULL);
+    g_assert_cmpint(g_rename(selected_path, new_path), ==, 0);
+    deadline = g_get_monotonic_time()+15000000;
+    while (!g_strcmp0(notice, old_notice)) pump(deadline);
+    /* Notice and finished are separate main-loop emissions. */
+    while (g_main_context_iteration(NULL, FALSE));
+    g_assert_cmpuint(fsearch_database_search_info_get_num_entries_selected(last), ==, 1);
+    fsearch_database_selection_foreach(db, 1, each, NULL); g_assert_cmpstr(selected_path, ==, new_path);
+    search(db, "f12 renamed"); g_assert_cmpuint(fsearch_database_search_info_get_num_entries(last), ==, 1);
+    g_assert_nonnull(strstr(notice, "AND filtered"));
+    search(db, "content:secret"); g_assert_cmpuint(fsearch_database_search_info_get_num_entries(last), ==, 0);
+    g_assert_nonnull(strstr(notice, "not supported in TemplarOS index mode"));
+    g_print("PASS remote backend: 5001 rows, final page, all selection, native bytes, stable sorted/renamed selection, generation refresh, AND and explicit unsupported query\n");
+    g_clear_pointer(&last, fsearch_database_search_info_unref); g_clear_pointer(&item, fsearch_database_entry_info_unref);
+    g_free(selected_path); g_free(notice); return 0;
+}
diff --git a/src/tests/test_remote_query_translation.c b/src/tests/test_remote_query_translation.c
new file mode 100644
index 0000000..ce86d39
--- /dev/null
+++ b/src/tests/test_remote_query_translation.c
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "fsearch_remote_query.h"
+
+static JsonObject *translate(const char *text, FsearchQueryFlags flags,
+    FsearchDatabaseIndexProperty sort, GtkSortType direction, FsearchRemoteQuery **out, JsonParser **parser) {
+    FsearchQuery query = { .search_term = (char *)text, .flags = flags };
+    GError *error = NULL;
+    *out = fsearch_remote_query_translate(&query, sort, direction, 17, &error);
+    g_assert_no_error(error); g_assert_nonnull(*out);
+    *parser = json_parser_new();
+    g_assert_true(json_parser_load_from_data(*parser, (*out)->json, -1, &error));
+    g_assert_no_error(error);
+    return json_node_get_object(json_parser_get_root(*parser));
+}
+
+static void quoted_and_paths(void) {
+    g_autoptr(FsearchRemoteQuery) result = NULL;
+    g_autoptr(JsonParser) parser = NULL;
+    JsonObject *json = translate("folder: /foo AND \"annual report\"", 0,
+        DATABASE_INDEX_PROPERTY_NAME, GTK_SORT_ASCENDING, &result, &parser);
+    g_assert_cmpstr(json_object_get_string_member(json, "text"), ==, "annual report");
+    g_assert_cmpstr(json_object_get_string_member(json, "client_tag"), ==, "view-17");
+    g_assert_cmpint(json_object_get_int_member(json, "page_size"), ==, 100);
+    g_assert_true(result->filtered);
+    g_assert_true(fsearch_remote_query_accepts(result, "/foo/annual report"));
+    g_assert_false(fsearch_remote_query_accepts(result, "/bar/annual report"));
+    JsonArray *kinds = json_object_get_array_member(json, "kinds");
+    g_assert_cmpstr(json_array_get_string_element(kinds, 0), ==, "directory");
+}
+
+static void size_intersection(void) {
+    g_autoptr(FsearchRemoteQuery) result = NULL;
+    g_autoptr(JsonParser) parser = NULL;
+    JsonObject *json = translate("file:report size:>10kb size:>=1kb size:<=16kib", 0,
+        DATABASE_INDEX_PROPERTY_SIZE, GTK_SORT_DESCENDING, &result, &parser);
+    g_assert_cmpint(json_object_get_int_member(json, "min_size"), ==, 10001);
+    g_assert_cmpint(json_object_get_int_member(json, "max_size"), ==, 16384);
+    g_assert_true(json_object_get_boolean_member(json, "descending"));
+    g_assert_true(json_object_get_boolean_member(json, "require_metadata"));
+    g_assert_cmpstr(json_object_get_string_member(json, "sort"), ==, "size");
+    g_assert_cmpuint(json_array_get_length(json_object_get_array_member(json, "kinds")), ==, 3);
+}
+
+static void modified_day(void) {
+    g_autoptr(FsearchRemoteQuery) result = NULL;
+    g_autoptr(JsonParser) parser = NULL;
+    JsonObject *json = translate("report dm:2026-08-27 datemodified:>=2026-08-26", 0,
+        DATABASE_INDEX_PROPERTY_MODIFICATION_TIME, GTK_SORT_ASCENDING, &result, &parser);
+    g_autoptr(GDateTime) date = g_date_time_new_utc(2026, 8, 27, 0, 0, 0);
+    gint64 ns = g_date_time_to_unix(date) * 1000000000;
+    g_assert_cmpint(json_object_get_int_member(json, "min_mtime_ns"), ==, ns);
+    g_assert_cmpint(json_object_get_int_member(json, "max_mtime_ns"), ==, ns + 86400000000000LL - 1);
+}
+
+static void empty_and_native(void) {
+    g_autoptr(FsearchRemoteQuery) result = NULL;
+    g_autoptr(JsonParser) parser = NULL;
+    JsonObject *json = translate("  ", QUERY_FLAG_FOLDERS_ONLY, DATABASE_INDEX_PROPERTY_PATH,
+        GTK_SORT_ASCENDING, &result, &parser);
+    g_assert_cmpstr(json_object_get_string_member(json, "text"), ==, "");
+    g_clear_pointer(&result, fsearch_remote_query_free); g_clear_object(&parser);
+    translate("file note", 0, DATABASE_INDEX_PROPERTY_NAME, GTK_SORT_ASCENDING, &result, &parser);
+    g_assert_true(fsearch_remote_query_accepts(result, "/tmp/\xff-file-note.txt"));
+    g_assert_false(fsearch_remote_query_accepts(result, "/tmp/\xff-file-other.txt"));
+}
+
+static void unsupported_modes(void) {
+    const char *terms[] = {"*.rs", "name OR other", "content:secret", "!name", "name (other)"};
+    for (guint i = 0; i < G_N_ELEMENTS(terms); i++) {
+        FsearchQuery query = { .search_term = (char *)terms[i] };
+        g_autoptr(GError) error = NULL;
+        g_assert_null(fsearch_remote_query_translate(&query, DATABASE_INDEX_PROPERTY_NAME,
+            GTK_SORT_ASCENDING, 1, &error));
+        g_assert_error(error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED);
+        g_assert_nonnull(strstr(error->message, "not supported in TemplarOS index mode"));
+    }
+    FsearchQueryFlags flags[] = { QUERY_FLAG_REGEX, QUERY_FLAG_MATCH_CASE, QUERY_FLAG_EXACT_MATCH, QUERY_FLAG_SEARCH_IN_PATH };
+    for (guint i = 0; i < G_N_ELEMENTS(flags); i++) {
+        FsearchQuery query = { .search_term = "name", .flags = flags[i] };
+        g_autoptr(GError) error = NULL;
+        g_assert_null(fsearch_remote_query_translate(&query, DATABASE_INDEX_PROPERTY_NAME,
+            GTK_SORT_ASCENDING, 1, &error));
+        g_assert_error(error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED);
+    }
+    FsearchQuery query = { .search_term = "name" };
+    g_autoptr(GError) error = NULL;
+    g_assert_null(fsearch_remote_query_translate(&query, DATABASE_INDEX_PROPERTY_FILETYPE,
+        GTK_SORT_ASCENDING, 1, &error));
+    g_assert_error(error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED);
+}
+
+static void invalid_filters(void) {
+    const char *terms[] = {"size:huge", "size:-1", "dm:invalid", "dm:2500-01-01"};
+    for (guint i = 0; i < G_N_ELEMENTS(terms); i++) {
+        FsearchQuery query = { .search_term = (char *)terms[i] };
+        g_autoptr(GError) error = NULL;
+        g_assert_null(fsearch_remote_query_translate(&query, DATABASE_INDEX_PROPERTY_NAME,
+            GTK_SORT_ASCENDING, 1, &error));
+        g_assert_error(error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+    }
+}
+
+int main(int argc, char **argv) {
+    g_setenv("TZ", "UTC", TRUE);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/remote-query/quoted-and-paths", quoted_and_paths);
+    g_test_add_func("/remote-query/size-intersection", size_intersection);
+    g_test_add_func("/remote-query/modified-day", modified_day);
+    g_test_add_func("/remote-query/empty-and-native", empty_and_native);
+    g_test_add_func("/remote-query/unsupported", unsupported_modes);
+    g_test_add_func("/remote-query/invalid-filters", invalid_filters);
+    return g_test_run();
+}
