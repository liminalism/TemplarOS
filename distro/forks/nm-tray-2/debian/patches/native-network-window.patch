@@ -532,10 +533,19 @@ void Tray::onActivated(const QSystemTrayIcon::ActivationReason reason)
 
 void Tray::showNetworkMenu()
 {
-    auto * menu = new WindowMenu(&d->mNmModel, &d->mConnectivity);
+    if (d->mNetworkMenu) {
+        d->mNetworkMenu->close();
+    }
+    auto *menu = new WindowMenu(&d->mNmModel, &d->mConnectivity);
+    d->mNetworkMenu = menu;
     menu->setAttribute(Qt::WA_DeleteOnClose);
     connect(menu, &WindowMenu::requestConnectionInfo, this, &Tray::showConnectionInfo);
-    menu->popup(QCursor::pos());
+    // A brokered --popup/D-Bus request has no Qt parent surface or Wayland input serial.
+    // Show the genuine menu as a normal native window instead of an invalid xdg_popup grab.
+    // The same actions/models remain in WindowMenu; no tray host or fabricated parent is needed.
+    menu->setWindowFlags(Qt::Window | Qt::WindowCloseButtonHint);
+    menu->setWindowTitle(tr("Network"));
+    menu->show();
 }
 
 void Tray::setActionsStates()
