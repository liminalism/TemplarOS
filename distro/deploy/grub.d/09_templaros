#!/bin/sh
# TemplarOS deployment entries (ADR-0004, contract C3).
#
# Installed as /etc/grub.d/09_templaros by installer/provision.sh. It runs at grub-mkconfig time and
# emits ONE line into grub.cfg: a `source` of the file templar-hostd generates.
#
# The indirection is the point. templar-hostd rewrites its entries on every stage, promotion and
# rollback; if those entries lived directly in grub.cfg, each rewrite would mean running
# grub-mkconfig, which reruns Ubuntu's own generators and would put a privileged daemon in the
# business of owning the whole boot menu. Sourcing one generated file leaves Ubuntu's entries
# exactly as they are, and a rewrite takes effect at the next boot with no regeneration at all.
#
# 09_ places these before Ubuntu's own 10_linux entries, so the TemplarOS known-good deployment is
# what GRUB_DEFAULT=saved resolves against first. Ubuntu's entries stay in the menu underneath as
# the last-resort route into a working kernel.
set -e
cat <<'EOF'
if [ -f ${prefix}/templaros-entries.cfg ]; then
    source ${prefix}/templaros-entries.cfg
fi
EOF
