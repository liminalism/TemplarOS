#!/bin/sh
# TemplarOS owns only its generated entries. Ubuntu's generators remain unchanged.
# Sealed roots keep the mutable GRUB environment and entries in the owned ESP namespace.
set -e
esp_uuid=$(/usr/bin/python3 -I -c '
import pathlib,re,tomllib
path=pathlib.Path("/etc/templaros/install.toml")
if path.exists():
    data=tomllib.loads(path.read_text())
    mode=data.get("read_only",False)
    if not isinstance(mode,bool): raise RuntimeError("invalid root policy")
    if mode:
        uuid=data.get("esp_uuid","")
        if not re.fullmatch(r"[0-9A-Fa-f-]+",uuid): raise RuntimeError("sealed root requires ESP UUID")
        print(uuid)
')
if [ -n "$esp_uuid" ]; then
    printf 'search --no-floppy --fs-uuid --set=templaros_esp %s\n' "$esp_uuid"
    cat <<'EOF'
if [ -f ($templaros_esp)/EFI/templaros/grub/grubenv ]; then
    load_env -f ($templaros_esp)/EFI/templaros/grub/grubenv next_entry saved_entry
    if [ "${next_entry}" ]; then
        set default="${next_entry}"
        set next_entry=
        save_env -f ($templaros_esp)/EFI/templaros/grub/grubenv next_entry
        set boot_once=true
    elif [ "${saved_entry}" ]; then
        set default="${saved_entry}"
    fi
fi
if [ -f ($templaros_esp)/EFI/templaros/grub/templaros-entries.cfg ]; then
    source ($templaros_esp)/EFI/templaros/grub/templaros-entries.cfg
fi
EOF
else
    cat <<'EOF'
if [ -f ${prefix}/templaros-entries.cfg ]; then
    source ${prefix}/templaros-entries.cfg
fi
EOF
fi
