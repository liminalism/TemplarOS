# AppArmor profile for lege-hostd (complain mode until the update path is exercised on real
# hardware — see the enforcement plan in's enforcement plan). Runs as root and drives
# apt, btrfs and the boot loader through child processes (crates/lege-hostd/src/cmd.rs); this
# profile confines what lege-hostd may touch *directly*, not what those children can do — apt runs
# as its own `systemd-run --collect` transient unit precisely so its own confinement can be
# tightened independently later.
abi <abi/4.0>,
include <tunables/global>

/usr/libexec/lege-hostd flags=(complain) {
  include <abstractions/base>
  include <abstractions/dbus-strict>

  /usr/libexec/lege-hostd mr,

  # Journal, transaction journal, deployment registry, candidate snapshots.
  /var/lib/legeos/hostd/ rw,
  /var/lib/legeos/hostd/** rwk,
  /run/legeos/ rw,
  /run/legeos/** rw,

  # Declarative config this daemon owns (gpu-mode, version-lock.toml) — nothing else writes here.
  /etc/legeos/hardware/ rw,
  /etc/legeos/hardware/** rwk,

  # Hardware detection (lege-hwdetect) and driver-authority/support-violation reads.
  /sys/bus/pci/devices/** r,
  /sys/class/drm/** r,
  /sys/module/nvidia/ r,
  /sys/firmware/efi/ r,
  /sys/firmware/efi/efivars/SecureBoot-* r,
  /var/lib/dpkg/status r,
  /etc/apt/sources.list.d/ r,
  /etc/apt/sources.list.d/*.list r,
  /etc/apt/sources.list.d/*.sources r,

  # Nothing under /usr/local may exist (ARCHITECTURE.md invariant); reads only, to detect the
  # violation, never to create anything there.
  /usr/local/ r,
  /usr/local/** r,

  # ESP: hostd-owned boot entries and kernel/initrd copies (systemd-boot); GRUB's own counter file
  # lives under the state dir above, not here.
  /boot/efi/ rw,
  /boot/efi/** rw,
  /efi/ rw,
  /efi/** rw,

  # Storage-reserve trim targets.
  /var/cache/apt/archives/ rw,
  /var/cache/apt/archives/*.deb w,
  /var/cache/legeos/thumbnails/ rw,
  /var/cache/legeos/thumbnails/** w,
  /var/lib/systemd/coredump/ rw,
  /var/lib/systemd/coredump/** w,
  /var/log/journal/ r,
  /var/log/journal/** r,

  /usr/share/legeos/** r,

  # Child processes hostd drives directly (rule 4: real CommandRunner only, never in-process apt).
  /usr/bin/systemd-run PUx,
  /usr/bin/systemctl PUx,
  /usr/bin/bootctl PUx,
  /usr/bin/btrfs PUx,
  /usr/bin/journalctl PUx,
  /usr/lib/systemd/systemd-bless-boot PUx,
  /usr/sbin/grub-reboot PUx,
  /usr/sbin/grub-set-default PUx,
}
